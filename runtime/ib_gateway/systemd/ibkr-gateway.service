[Unit]
Description=IBKR Gateway via IBC
After=network-online.target ibkr-display.service
Wants=network-online.target ibkr-display.service

[Service]
Type=simple
EnvironmentFile=-/opt/ibkr_compute/.env
WorkingDirectory=/opt/ibkr_compute
ExecStart=/opt/ibkr_compute/src/ibkr_compute/broker/launch_ib_gateway.sh
Restart=always
RestartSec=20
TimeoutStartSec=180
TimeoutStopSec=30
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
