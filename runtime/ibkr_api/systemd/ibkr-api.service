[Unit]
Description=IBKR Control-Plane API Service
After=network-online.target pocketbase.service ibkr-compute.service ibkr-runtime.service
Wants=network-online.target pocketbase.service ibkr-compute.service ibkr-runtime.service

[Service]
Type=simple
WorkingDirectory=/opt/ibkr_api
ExecStartPre=/bin/sh -lc 'for i in $(seq 1 ${IBKR_WAIT_PB_ATTEMPTS:-90}); do /usr/bin/curl -fsS --max-time 5 http://127.0.0.1:8090/api/health >/dev/null 2>&1 && exit 0; sleep 2; done; echo "PocketBase health endpoint not ready" >&2; exit 1'
ExecStart=/opt/ibkr_compute/venv/bin/python -m ibkr_api.api_server
EnvironmentFile=-/opt/ibkr_api/.env
Environment=PYTHONPATH=/opt/ibkr_api/src:/opt/ibkr_scheduler/src:/opt/ibkr_compute/src
Environment=FLASK_SKIP_DOTENV=1
Environment=IBKR_API_PORT=5102
Environment=PORT=5102
Environment=IBKR_SERVICE_PROFILE=api
Environment=IBKR_RUNTIME_MODE=remote
Environment=IBKR_COMPUTE_INTERNAL_URL=http://127.0.0.1:5100
Environment=IBKR_BACKTEST_INTERNAL_URL=http://127.0.0.1:5105
Environment=IBKR_RUNTIME_INTERNAL_URL=http://127.0.0.1:5101
Environment=IBKR_SCHEDULER_INTERNAL_URL=http://127.0.0.1:5103
Environment=IBKR_API_ORDER_WRITE_PROXY_TIMEOUT_SEC=1800
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
