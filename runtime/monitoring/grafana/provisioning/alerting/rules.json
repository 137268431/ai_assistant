{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "quant-monitor-alerts",
      "folder": "Quant Monitoring",
      "interval": "1m",
      "rules": [
        {
          "uid": "ibkr_service_down",
          "title": "IBKRServiceTargetDown",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "editorMode": "code",
                "expr": "up{stack=\"ibkr\"} == 0",
                "hide": false,
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0.5
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "hide": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "B",
                "type": "classic_conditions"
              }
            }
          ],
          "dashboardUid": "quant-monitoring-overview",
          "noDataState": "Alerting",
          "execErrState": "Error",
          "for": "2m",
          "annotations": {
            "summary": "IBKR 服务不可采集",
            "description": "Prometheus 持续无法采集 IBKR 服务；来源标签包含 service/job/instance。"
          },
          "labels": {
            "severity": "critical",
            "alert_source": "grafana"
          },
          "isPaused": false
        },
        {
          "uid": "gateway_socket_down",
          "title": "GatewaySocketNotListening",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "editorMode": "code",
                "expr": "ibkr_gateway_socket_listening == 0",
                "hide": false,
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "range": false,
