[Unit]
Description=IBKR Runtime Service
After=network-online.target pocketbase.service ibkr-gateway.service
Wants=network-online.target pocketbase.service ibkr-gateway.service

[Service]
Type=simple
WorkingDirectory=/opt/ibkr_runtime
ExecStartPre=/bin/sh -lc 'for i in $(seq 1 ${IBKR_WAIT_PB_ATTEMPTS:-90}); do /usr/bin/curl -fsS --max-time 5 http://127.0.0.1:8090/api/health >/dev/null 2>&1 && exit 0; sleep 2; done; echo "PocketBase health endpoint not ready" >&2; exit 1'
ExecStart=/opt/ibkr_runtime/venv/bin/python -m ibkr_runtime.server
EnvironmentFile=-/opt/ibkr_runtime/.env
Environment=PYTHONPATH=/opt/ibkr_runtime/src:/opt/ibkr_compute/src
Environment=PORT=5101
Environment=IBKR_SERVICE_PROFILE=runtime
Environment=IBKR_RUNTIME_MODE=remote
Environment=IBKR_API_INTERNAL_URL=http://127.0.0.1:5102
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
