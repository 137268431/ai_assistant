# Managed by ai_assistant/ops/deploy/deploy_ibkr_public_proxy.sh
pb.lzw-glory.top {
    route {
        # PocketBase stays the canonical auth/data/admin origin.
        @pb_allowed path / /index.html /api/* /_/ /_/* /favicon.ico
        reverse_proxy @pb_allowed 127.0.0.1:8090 {
            flush_interval -1
            header_up X-Real-IP {remote_host}
            transport http {
                read_timeout 300s
                write_timeout 300s
                dial_timeout 30s
            }
        }

        respond "Not Found" 404
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        -Server
    }
}
