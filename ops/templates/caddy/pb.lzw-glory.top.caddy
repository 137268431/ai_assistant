# Managed by ai_assistant/ops/deploy/deploy_ibkr_public_proxy.sh
pb.lzw-glory.top {
    route {
        # PocketBase stays the canonical auth/data origin.
        @pb_api path /api/* /_/ /_/*
        reverse_proxy @pb_api 127.0.0.1:8090 {
            flush_interval -1
            header_up X-Real-IP {remote_host}
            transport http {
                read_timeout 300s
                write_timeout 300s
                dial_timeout 30s
            }
        }

        # The trading UI now lives on quant.lzw-glory.top instead of the PocketBase host.
        redir https://quant.lzw-glory.top{uri} 308
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        -Server
    }
}
