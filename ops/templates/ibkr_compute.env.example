# IBKR Gateway + IB Gateway API configuration
# Copy this file to /opt/ibkr_compute/.env, /opt/ibkr_api/.env, /opt/ibkr_scheduler/.env,
# and /opt/ibkr_runtime/.env, then fill in real values.
# Do not commit the real .env file.

IBKR_USERNAME=your_username
IBKR_PASSWORD=your_password
IBKR_ACCOUNT_ID=your_live_account_id
IBKR_PAPER_ACCOUNT_ID=your_paper_account_id
# Broker/account/order execution mode.
IBKR_BROKER_MODE=paper
# Shared bars / indicators / signals / targets use live as canonical data.
IBKR_MARKET_DATA_MODE=live
# Gateway follows broker mode unless explicitly overridden.
IBKR_GATEWAY_MODE=paper
IBKR_LOGIN_TIMEOUT=180
IBKR_2FA_WAIT=180
IBKR_EOD_KEEP_SYMBOLS=BOXX,IBKR

# IB Gateway socket API
IBGW_HOST=127.0.0.1
IBGW_PORT=4001
IBGW_CLIENT_ID=31
IBKR_GATEWAY_SYSTEMD_SERVICE=ibkr-gateway
IBKR_DISPLAY_SYSTEMD_SERVICE=ibkr-display
IBKR_GATEWAY_COOKIE_FILE=/tmp/ibkr_gateway_cookies.json

# IBC + IB Gateway runtime
IBKR_DISPLAY=:1
IBKR_DISPLAY_SCREEN=1280x800x24
IBKR_IBC_HOME=/opt/ibc
IBKR_IBC_INI=/opt/ibc/config.ini
IBKR_IBG_HOME=/opt
IBKR_IBG_USER_DIR=/opt/ibgateway/userdir
IBKR_TWS_SETTINGS_PATH=/opt/ibgateway/userdir
IBKR_TWS_MAJOR_VERSION=
IBKR_GATEWAY_TZ=America/New_York
IBKR_AUTO_RESTART_TIME=02:35 AM
IBKR_2FA_TIMEOUT_ACTION=restart
IBKR_2FA_AUTO_REPAIR_ENABLED=true
IBKR_2FA_AUTO_REPAIR_COOLDOWN_SECONDS=900
IBKR_2FA_AUTO_REPAIR_MAX_ATTEMPTS=2
IBKR_GATEWAY_JAVA_HOME=
IBKR_GATEWAY_LOG_DIR=/opt/ibkr_runtime/logs/ibgateway

# PocketBase
PB_BASE_URL=http://localhost:8090
PB_PUBLIC_URL=http://localhost:8090
CONSOLE_BASE_URL=http://localhost:5104

# Service
# systemd overrides PORT / IBKR_SERVICE_PROFILE per service. Keep the shared
# URLs aligned so compute can proxy runtime and runtime can report its peer.
PORT=5100
IBKR_COMPUTE_INTERNAL_URL=http://127.0.0.1:5100
IBKR_RUNTIME_INTERNAL_URL=http://127.0.0.1:5101
IBKR_API_INTERNAL_URL=http://127.0.0.1:5102
IBKR_SCHEDULER_INTERNAL_URL=http://127.0.0.1:5103
IBKR_RUNTIME_MODE=remote

# Buying-power refresh
# Dedicated buying-power fallback is paced and request-gated; leave enabled so
# NetLiq/BuyingPower can recover automatically even when orders_fast stays light.
IBKR_BUYING_POWER_SUMMARY_REFRESH_ENABLED=true
