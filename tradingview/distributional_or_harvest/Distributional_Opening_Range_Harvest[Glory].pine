//@version=6
strategy(title="Distributional Opening Range Harvest[Glory]", overlay=true, pyramiding=0, initial_capital=20000, default_qty_type=strategy.fixed, default_qty_value=1, process_orders_on_close=false, calc_on_every_tick=false, dynamic_requests=true, max_labels_count=500, max_lines_count=100, commission_type=strategy.commission.cash_per_order, commission_value=0.35, slippage=1)

// Distributional Opening Range Harvest v3.4.
// Trade one liquid ETF at a time. Preferred test order: QQQ -> SPY -> IWM -> SMH -> XLK.
// Avoid individual stocks, 3x ETFs, options, low-liquidity ETFs, and pre/post-market for v1 deployment.
string STRATEGY_VERSION = "DORH_v3_4_20260708_lunch_reclaim"
string SCRIPT_TAG = "Distributional_Opening_Range_Harvest[Glory]"
string TRADE_MODEL = "filter_first_distributional_or_mean_reversion_v3"
string RISK_MODEL = "fixed_risk_raw_or_death_line_v2"
string TP_SL_MODEL = "orm_70pct_opposite_dynamic_edge_v2"
string TZ = "America/New_York"
string LONG_ID = "DORH-L"
string SHORT_ID = "DORH-S"

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
rthSession = input.session("0930-1600", "RTH session", group="01 Time")
entryCutoffHour = input.int(15, "Last entry hour ET", minval=0, maxval=23, group="01 Time")
entryCutoffMinute = input.int(30, "Last entry minute ET", minval=0, maxval=59, group="01 Time")
lunchBlockStartHour = input.int(12, "Lunch no-entry start hour ET", minval=0, maxval=23, group="01 Time")
lunchBlockStartMinute = input.int(0, "Lunch no-entry start minute ET", minval=0, maxval=59, group="01 Time")
lunchBlockEndHour = input.int(13, "Lunch no-entry end hour ET", minval=0, maxval=23, group="01 Time")
lunchBlockEndMinute = input.int(30, "Lunch no-entry end minute ET", minval=0, maxval=59, group="01 Time")
lunchPolicy = input.string("Reclaim only", "Lunch entry policy", options=["Block all", "Reclaim only", "Allow all"], group="01 Time")
forceFlatHour = input.int(15, "Force flat hour ET", minval=0, maxval=23, group="01 Time")
forceFlatMinute = input.int(45, "Force flat minute ET", minval=0, maxval=59, group="01 Time")
manualEventBlock = input.bool(false, "Manual event block", group="01 Time")

restrictSymbol = input.bool(false, "Restrict to preferred ETF list", group="02 Universe")
showSymbolWarning = input.bool(false, "Show liquid-ETF warning", group="02 Universe")
qqqSymbol = input.symbol("NASDAQ:QQQ", "QQQ confirmation symbol", group="02 Universe")
smhSymbol = input.symbol("NASDAQ:SMH", "SMH confirmation symbol", group="02 Universe")
xlkSymbol = input.symbol("AMEX:XLK", "XLK confirmation symbol", group="02 Universe")
nvdaSymbol = input.symbol("NASDAQ:NVDA", "NVDA core weight", group="02 Universe")
msftSymbol = input.symbol("NASDAQ:MSFT", "MSFT core weight", group="02 Universe")
aaplSymbol = input.symbol("NASDAQ:AAPL", "AAPL core weight", group="02 Universe")

orAtrLen = input.int(14, "OR width ATR length (5m)", minval=1, group="03 Range/Distribution")
dailyAtrLen = input.int(20, "Daily ATR length", minval=1, group="03 Range/Distribution")
minOrAtrMult = input.float(0.40, "Minimum OR width / ATR", step=0.05, minval=0.0, group="03 Range/Distribution")
maxOrAtrMult = input.float(1.50, "Wide OR warning / ATR", step=0.05, minval=0.05, group="03 Range/Distribution")
hardMaxOrAtrMult = input.float(4.00, "Hard chaos OR width / ATR", step=0.10, minval=0.50, group="03 Range/Distribution")
upperAtrThreshold = input.float(0.45, "Upper distribution ATR threshold", step=0.05, minval=0.0, group="03 Range/Distribution")
lowerAtrThreshold = input.float(0.45, "Lower distribution ATR threshold", step=0.05, minval=0.0, group="03 Range/Distribution")
entryMoveAtrMin = input.float(0.40, "Entry move ATR min", step=0.05, minval=0.0, group="03 Range/Distribution")
nearEdgeDailyAtrMult = input.float(0.05, "Near-edge distance / daily ATR", step=0.01, minval=0.0, group="03 Range/Distribution")
entryBreakBufferTicks = input.int(1, "Confirm break buffer (ticks)", minval=0, maxval=20, group="03 Range/Distribution")

trendKillAtr = input.float(1.20, "Trend kill abs(today move / daily ATR)", step=0.05, minval=0.1, group="04 Hard Filter")
vwapSlopeDailyAtrMult = input.float(0.03, "VWAP 3-bar slope / daily ATR", step=0.01, minval=0.0, group="04 Hard Filter")
emaSideBars = input.int(6, "EMA20 same-side bars", minval=2, maxval=20, group="04 Hard Filter")
outsideRawCloseBars = input.int(2, "Raw OR outside closes starts watch", minval=1, maxval=10, group="04 Hard Filter")
reclaimWatchMaxBars = input.int(6, "Max raw-OR outside closes before invalidation", minval=1, maxval=12, group="04 Hard Filter")
maxVwapCrossesForRange = input.int(5, "Max VWAP crosses for range day", minval=0, maxval=20, group="04 Hard Filter")

requireDailyLongEnhancement = input.bool(false, "Require long daily down-streak/cum filter", group="05 Setup Quality")
longDownStreakMin = input.int(2, "Long down streak min", minval=0, maxval=10, group="05 Setup Quality")
longDownCumPctMax = input.float(-2.0, "Long down cumulative pct max", step=0.25, group="05 Setup Quality")
strongLongDownStreak = input.int(3, "Strong long down streak", minval=0, maxval=10, group="05 Setup Quality")
strongLongDownCumPct = input.float(-4.0, "Strong long down cumulative pct", step=0.25, group="05 Setup Quality")
requireDailyShortEnhancement = input.bool(true, "Require short daily up-streak/cum filter", group="05 Setup Quality")
shortUpStreakMin = input.int(3, "Short up streak min", minval=0, maxval=10, group="05 Setup Quality")
shortUpCumPctMin = input.float(5.0, "Short up cumulative pct min", step=0.25, group="05 Setup Quality")
strongShortUpStreak = input.int(4, "Strong short up streak", minval=0, maxval=10, group="05 Setup Quality")
strongShortUpCumPct = input.float(8.0, "Strong short up cumulative pct", step=0.25, group="05 Setup Quality")
wickReversalMin = input.float(0.35, "Reversal wick min ratio", step=0.05, minval=0.0, maxval=1.0, group="05 Setup Quality")
relativeDivergencePct = input.float(0.20, "Relative divergence pct", step=0.05, minval=0.0, group="05 Setup Quality")
sectorSyncStrongPct = input.float(0.35, "SMH/XLK sync strong pct", step=0.05, minval=0.0, group="05 Setup Quality")
coreSyncStrongPct = input.float(0.40, "Core weight sync strong pct", step=0.05, minval=0.0, group="05 Setup Quality")
coreSyncStrongCountMin = input.int(2, "Core strong count min", minval=1, maxval=3, group="05 Setup Quality")

accountSize = input.float(20000.0, "Account size ($)", step=500.0, minval=100.0, group="06 Risk")
maxNotionalPct = input.float(100.0, "Max notional pct of account", step=5.0, minval=10.0, maxval=150.0, group="06 Risk")
riskDollars = input.float(60.0, "Risk per trade ($)", step=5.0, minval=1.0, group="06 Risk")
maxDailyLossDollars = input.float(180.0, "Max daily loss ($)", step=10.0, minval=1.0, group="06 Risk")
maxTradesPerDay = input.int(3, "Max trades per day", minval=1, maxval=10, group="06 Risk")
stopBufferPct = input.float(0.12, "Raw OR stop/break buffer %", step=0.01, minval=0.0, group="06 Risk")
tp1ExitPct = input.int(70, "TP1 ORM exit pct", minval=1, maxval=99, group="06 Risk")
breakevenAtR = input.float(0.80, "Move stop to breakeven after MFE R", step=0.05, minval=0.1, group="06 Risk")
timeStopBars = input.int(6, "Time stop bars", minval=1, maxval=60, group="06 Risk")
timeStopMinMfeR = input.float(0.50, "Time stop minimum MFE R", step=0.05, minval=0.0, group="06 Risk")
minQty = input.float(1.0, "Minimum shares", step=1.0, minval=1.0, group="06 Risk")
enableStrategyOrders = input.bool(true, "Enable strategy orders", group="06 Risk")

enableAlerts = input.bool(true, "Emit alert() JSON", group="07 Alerts/Display")
showLevels = input.bool(true, "Show core OR/edge levels", group="07 Alerts/Display")
showDistributionLevels = input.bool(false, "Show dist upper/lower levels", group="07 Alerts/Display")
showVwapEma = input.bool(true, "Show VWAP and EMA20", group="07 Alerts/Display")
showEventLabels = input.bool(true, "Show event labels", group="07 Alerts/Display")
showStateLabels = input.bool(true, "Show WATCH/RANGE state labels", group="07 Alerts/Display")
showDebugTable = input.bool(true, "Show state table", group="07 Alerts/Display")
showDiagnostics = input.bool(false, "Show blocked setup labels", group="07 Alerts/Display")

enableDebugLogs = input.bool(true, "Enable Pine debug logs", group="08 Debug Logs")
debugLogHistoricalBars = input.bool(false, "Log historical bars too", group="08 Debug Logs")
debugLogGate = input.bool(true, "Log no-entry gate reasons", group="08 Debug Logs")
debugLogStateChanges = input.bool(true, "Log compact state changes", group="08 Debug Logs")
debugLogSetups = input.bool(true, "Log setup/confirm reasons", group="08 Debug Logs")
debugLogOrders = input.bool(true, "Log order lifecycle reasons", group="08 Debug Logs")
debugHeartbeatBars = input.int(6, "No-entry heartbeat every N bars", minval=1, maxval=100, group="08 Debug Logs")

// -----------------------------------------------------------------------------
// Formatting and helpers
// -----------------------------------------------------------------------------
fmt(series float value) =>
    na(value) ? "--" : str.tostring(value, "#.##")

fmtFull(series float value) =>
    na(value) ? "null" : str.tostring(value, "#.########")

fmtPrice(series float value) =>
    na(value) ? "--" : str.tostring(value, format.mintick)

qtyText(series float value) =>
    na(value) ? "--" : str.tostring(value, "#")

jsonStr(series string key, series string value) =>
    "\"" + key + "\":\"" + str.replace_all(value, "\"", "'") + "\""

jsonNum(series string key, series float value) =>
    "\"" + key + "\":" + (na(value) ? "null" : fmtFull(value))

jsonInt(series string key, series int value) =>
    "\"" + key + "\":" + (na(value) ? "null" : str.tostring(value))

jsonBool(series string key, series bool value) =>
    "\"" + key + "\":" + (value ? "true" : "false")

cleanTicker(series string ticker) =>
    str.upper(str.replace_all(ticker, " ", ""))

isRecommendedEtf() =>
    string t = cleanTicker(syminfo.ticker)
    t == "QQQ" or t == "SPY" or t == "IWM" or t == "SMH" or t == "XLK"

dirText(series int direction) =>
    direction == 1 ? "long" : direction == -1 ? "short" : "neutral"

orderIdForDirection(series int direction) =>
    direction == 1 ? LONG_ID : SHORT_ID

eventId(series string eventType) =>
    cleanTicker(syminfo.ticker) + "_" + eventType + "_" + str.tostring(time) + "_" + timeframe.period

drawEventLabel(series string textValue, series string tooltipValue, series float priceValue, series bool above, series color bgColor, series color txtColor) =>
    if showEventLabels
        label.new(bar_index, priceValue, textValue, style=above ? label.style_label_down : label.style_label_up, color=bgColor, textcolor=txtColor, size=size.small, tooltip=tooltipValue)

drawStateLabel(series string textValue, series string tooltipValue, series float priceValue, series bool above, series color bgColor, series color txtColor) =>
    if showStateLabels
        label.new(bar_index, priceValue, textValue, style=above ? label.style_label_down : label.style_label_up, color=bgColor, textcolor=txtColor, size=size.small, tooltip=tooltipValue)

debugEtStamp() =>
    str.tostring(hour(time, TZ)) + ":" + str.tostring(minute(time, TZ))

debugCategoryEnabled(string category) =>
    enableDebugLogs and (category == "gate" ? debugLogGate : category == "setup" ? debugLogSetups : debugLogOrders)

debugShouldWrite() =>
    debugLogHistoricalBars or barstate.isrealtime or barstate.islastconfirmedhistory

debugLog(string category, string eventName, string detailText) =>
    if debugCategoryEnabled(category) and debugShouldWrite()
        log.warning("[" + SCRIPT_TAG + " " + STRATEGY_VERSION + "] " + syminfo.ticker + " tf=" + timeframe.period + " ET=" + debugEtStamp() + " bar=" + str.tostring(bar_index) + " " + eventName + "\n" + detailText)

inSession() =>
    not na(time(timeframe.period, rthSession))

rthOpenPrice() =>
    bool sess = inSession()
    bool wasSess = sess[1] == true
    bool start = sess and (not wasSess or timeframe.change("D"))
    var float sessionOpen = na
    if start
        sessionOpen := open
    else if not sess
        sessionOpen := na
    sessionOpen

rthVwap(series float src) =>
    bool sess = inSession()
    bool wasSess = sess[1] == true
    bool start = sess and (not wasSess or timeframe.change("D"))
    var float cumPv = na
    var float cumVol = na
    if start
        cumPv := src * volume
        cumVol := volume
    else if sess
        cumPv := nz(cumPv, 0.0) + src * volume
        cumVol := nz(cumVol, 0.0) + volume
    else
        cumPv := na
        cumVol := na
    not na(cumVol) and cumVol > 0.0 ? cumPv / cumVol : na

relative5Metrics() =>
    float sessionOpen = rthOpenPrice()
    float changePct = not na(sessionOpen) and sessionOpen > 0.0 ? (close - sessionOpen) / sessionOpen * 100.0 : na
    [changePct, close, high, low, ta.ema(close, 20)]

dailyDirectionalMetrics() =>
    int up = close[1] > close[2] ? 1 : 0
    up += up == 1 and close[2] > close[3] ? 1 : 0
    up += up == 2 and close[3] > close[4] ? 1 : 0
    up += up == 3 and close[4] > close[5] ? 1 : 0
    up += up == 4 and close[5] > close[6] ? 1 : 0
    int down = close[1] < close[2] ? 1 : 0
    down += down == 1 and close[2] < close[3] ? 1 : 0
    down += down == 2 and close[3] < close[4] ? 1 : 0
    down += down == 3 and close[4] < close[5] ? 1 : 0
    down += down == 4 and close[5] < close[6] ? 1 : 0
    float pct1 = close[2] > 0.0 ? (close[1] - close[2]) / close[2] * 100.0 : 0.0
    float pct2 = close[3] > 0.0 ? (close[2] - close[3]) / close[3] * 100.0 : 0.0
    float pct3 = close[4] > 0.0 ? (close[3] - close[4]) / close[4] * 100.0 : 0.0
    float pct4 = close[5] > 0.0 ? (close[4] - close[5]) / close[5] * 100.0 : 0.0
    float pct5 = close[6] > 0.0 ? (close[5] - close[6]) / close[6] * 100.0 : 0.0
    float upCum = (up >= 1 ? pct1 : 0.0) + (up >= 2 ? pct2 : 0.0) + (up >= 3 ? pct3 : 0.0) + (up >= 4 ? pct4 : 0.0) + (up >= 5 ? pct5 : 0.0)
    float downCum = (down >= 1 ? pct1 : 0.0) + (down >= 2 ? pct2 : 0.0) + (down >= 3 ? pct3 : 0.0) + (down >= 4 ? pct4 : 0.0) + (down >= 5 ? pct5 : 0.0)
    [up, down, upCum, downCum]

// -----------------------------------------------------------------------------
// Session, levels, daily context, and relative confirmation
// -----------------------------------------------------------------------------
bool confirmed = barstate.isconfirmed
bool is5m = timeframe.period == "5"
int etMinutes = hour(time, TZ) * 60 + minute(time, TZ)
int etCloseMinutes = hour(time_close, TZ) * 60 + minute(time_close, TZ)
bool inRth = inSession()
bool rthStarted = inRth and (not (inRth[1] == true) or timeframe.change("D"))
bool newDay = timeframe.change("D") or rthStarted
bool inOpeningRange = inRth and etMinutes >= 9 * 60 + 30 and etMinutes < 10 * 60
bool orComplete = inRth and etMinutes >= 10 * 60
int lunchStart = lunchBlockStartHour * 60 + lunchBlockStartMinute
int lunchEnd = lunchBlockEndHour * 60 + lunchBlockEndMinute
bool inLunchBlock = inRth and etMinutes >= lunchStart and etMinutes < lunchEnd
bool beforeEntryCutoff = inRth and etCloseMinutes < entryCutoffHour * 60 + entryCutoffMinute
bool forceFlatNow = inRth and etCloseMinutes >= forceFlatHour * 60 + forceFlatMinute

float atr5 = math.max(nz(ta.atr(orAtrLen), syminfo.mintick), syminfo.mintick)
float dailyAtr20 = request.security(syminfo.tickerid, "D", ta.atr(dailyAtrLen)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float safeDailyAtr20 = math.max(nz(dailyAtr20, syminfo.mintick), syminfo.mintick)
float vwap = rthVwap(hlc3)
float ema20 = ta.ema(close, 20)
float barRange = math.max(high - low, syminfo.mintick)
float upperWickRatio = (high - math.max(open, close)) / barRange
float lowerWickRatio = (math.min(open, close) - low) / barRange
float vwapCrossValue = ta.cross(close, vwap) ? 1.0 : 0.0
float vwapCrossCount12 = math.sum(vwapCrossValue, 12)

var float dayOpen = na
var float rawOrh = na
var float rawOrl = na
var float orAtrAtLock = na
var bool orLocked = false
var bool rangeActiveAlertSent = false
var bool wideOrWarningAlertSent = false
var bool watchLongAlertSent = false
var bool watchShortAlertSent = false

if confirmed and newDay
    dayOpen := inRth ? open : na
    rawOrh := na
    rawOrl := na
    orAtrAtLock := na
    orLocked := false
    rangeActiveAlertSent := false
    wideOrWarningAlertSent := false
    watchLongAlertSent := false
    watchShortAlertSent := false

if confirmed and rthStarted
    dayOpen := open

if confirmed and inOpeningRange
    rawOrh := na(rawOrh) ? high : math.max(rawOrh, high)
    rawOrl := na(rawOrl) ? low : math.min(rawOrl, low)

if confirmed and orComplete and not orLocked and not na(rawOrh) and not na(rawOrl)
    orLocked := true
    orAtrAtLock := atr5

float orm = not na(rawOrh) and not na(rawOrl) ? (rawOrh + rawOrl) / 2.0 : na
float orWidth = not na(rawOrh) and not na(rawOrl) ? rawOrh - rawOrl : na
float orWidthAtr = not na(orWidth) and not na(orAtrAtLock) and orAtrAtLock > 0.0 ? orWidth / orAtrAtLock : na
bool orTooNarrow = orLocked and not na(orWidth) and not na(orAtrAtLock) and orWidth < orAtrAtLock * minOrAtrMult
bool orWideWarning = orLocked and not na(orWidth) and not na(orAtrAtLock) and orWidth > orAtrAtLock * maxOrAtrMult
bool orTooWide = orLocked and not na(orWidth) and not na(orAtrAtLock) and orWidth > orAtrAtLock * hardMaxOrAtrMult
bool orWidthOk = orLocked and not orTooNarrow and not orTooWide
bool orJustLocked = confirmed and orLocked and not (orLocked[1] == true)
float todayMove = not na(dayOpen) ? close - dayOpen : na
float todayMoveAtr = not na(todayMove) and safeDailyAtr20 > 0.0 ? todayMove / safeDailyAtr20 : na
float distUpper = not na(dayOpen) ? dayOpen + safeDailyAtr20 * upperAtrThreshold : na
float distLower = not na(dayOpen) ? dayOpen - safeDailyAtr20 * lowerAtrThreshold : na
float shortEdge = not na(rawOrh) and not na(distUpper) ? math.min(rawOrh, distUpper) : na
float longEdge = not na(rawOrl) and not na(distLower) ? math.max(rawOrl, distLower) : na
bool edgeReady = orLocked and not na(shortEdge) and not na(longEdge) and not na(orm)
float nearEdgeDistance = safeDailyAtr20 * nearEdgeDailyAtrMult
float entryBreakBuffer = syminfo.mintick * entryBreakBufferTicks
float upperBreakLevel = not na(rawOrh) ? rawOrh * (1.0 + stopBufferPct / 100.0) : na
float lowerBreakLevel = not na(rawOrl) ? rawOrl * (1.0 - stopBufferPct / 100.0) : na
bool closeInsideOr = edgeReady and close <= rawOrh and close >= rawOrl
bool rawCloseAbove = edgeReady and close > rawOrh
bool rawCloseBelow = edgeReady and close < rawOrl

[upStreak, downStreak, upCumPct, downCumPct] = request.security(syminfo.tickerid, "D", dailyDirectionalMetrics(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[qqqChangePct, qqqClose, qqqHigh, qqqLow, qqqEma] = request.security(qqqSymbol, "5", relative5Metrics(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[smhChangePct, smhClose, smhHigh, smhLow, smhEma] = request.security(smhSymbol, "5", relative5Metrics(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[xlkChangePct, xlkClose, xlkHigh, xlkLow, xlkEma] = request.security(xlkSymbol, "5", relative5Metrics(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[nvdaChangePct, nvdaClose, nvdaHigh, nvdaLow, nvdaEma] = request.security(nvdaSymbol, "5", relative5Metrics(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[msftChangePct, msftClose, msftHigh, msftLow, msftEma] = request.security(msftSymbol, "5", relative5Metrics(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[aaplChangePct, aaplClose, aaplHigh, aaplLow, aaplEma] = request.security(aaplSymbol, "5", relative5Metrics(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

bool smhHoldingUp = not na(smhChangePct) and not na(qqqChangePct) and smhChangePct > qqqChangePct + relativeDivergencePct
bool xlkHoldingUp = not na(xlkChangePct) and not na(qqqChangePct) and xlkChangePct > qqqChangePct + relativeDivergencePct
bool longRelativeDivergence = not na(qqqChangePct) and qqqChangePct < -relativeDivergencePct and (smhHoldingUp or xlkHoldingUp)
bool smhLaggingUp = not na(smhChangePct) and not na(qqqChangePct) and smhChangePct < qqqChangePct - relativeDivergencePct
bool xlkLaggingUp = not na(xlkChangePct) and not na(qqqChangePct) and xlkChangePct < qqqChangePct - relativeDivergencePct
bool shortRelativeDivergence = not na(qqqChangePct) and qqqChangePct > relativeDivergencePct and (smhLaggingUp or xlkLaggingUp)
bool sectorSyncStrong = not na(smhChangePct) and not na(xlkChangePct) and smhChangePct >= sectorSyncStrongPct and xlkChangePct >= sectorSyncStrongPct and smhClose > smhEma and xlkClose > xlkEma
int coreStrongCount = (not na(nvdaChangePct) and nvdaChangePct >= coreSyncStrongPct and nvdaClose > nvdaEma ? 1 : 0) + (not na(msftChangePct) and msftChangePct >= coreSyncStrongPct and msftClose > msftEma ? 1 : 0) + (not na(aaplChangePct) and aaplChangePct >= coreSyncStrongPct and aaplClose > aaplEma ? 1 : 0)
bool coreSyncStrong = coreStrongCount >= coreSyncStrongCountMin

// -----------------------------------------------------------------------------
// Daily state, hard filters, and regime
// -----------------------------------------------------------------------------
var int tradesToday = 0
var int longLossesToday = 0
var int shortLossesToday = 0
var bool longDisabledToday = false
var bool shortDisabledToday = false
var bool rangeInvalidatedToday = false
var bool noTradeTrendToday = false
var bool dailyLossHaltedToday = false
var float dayStartNetProfit = na
var int aboveRawCloseCount = 0
var int belowRawCloseCount = 0
var int longEmaSideCount = 0
var int shortEmaSideCount = 0

if confirmed and newDay
    tradesToday := 0
    longLossesToday := 0
    shortLossesToday := 0
    longDisabledToday := false
    shortDisabledToday := false
    rangeInvalidatedToday := false
    noTradeTrendToday := false
    dailyLossHaltedToday := false
    dayStartNetProfit := strategy.netprofit
    aboveRawCloseCount := 0
    belowRawCloseCount := 0
    longEmaSideCount := 0
    shortEmaSideCount := 0

if confirmed
    if not inRth or not edgeReady
        aboveRawCloseCount := 0
        belowRawCloseCount := 0
    else
        aboveRawCloseCount := close > rawOrh ? aboveRawCloseCount + 1 : 0
        belowRawCloseCount := close < rawOrl ? belowRawCloseCount + 1 : 0
    if not inRth
        longEmaSideCount := 0
        shortEmaSideCount := 0
    else
        longEmaSideCount := close > ema20 ? longEmaSideCount + 1 : 0
        shortEmaSideCount := close < ema20 ? shortEmaSideCount + 1 : 0

bool rawOutsideWatch = edgeReady and (aboveRawCloseCount >= outsideRawCloseBars or belowRawCloseCount >= outsideRawCloseBars)
bool watchLongReclaim = edgeReady and rawCloseBelow and belowRawCloseCount >= outsideRawCloseBars and not rangeInvalidatedToday
bool watchShortReject = edgeReady and rawCloseAbove and aboveRawCloseCount >= outsideRawCloseBars and not rangeInvalidatedToday
int rawOutsideCount = math.max(aboveRawCloseCount, belowRawCloseCount)
bool rawOutsideStale = edgeReady and (aboveRawCloseCount > reclaimWatchMaxBars or belowRawCloseCount > reclaimWatchMaxBars)
bool longWatchStale = watchLongReclaim and belowRawCloseCount > reclaimWatchMaxBars
bool shortWatchStale = watchShortReject and aboveRawCloseCount > reclaimWatchMaxBars
string watchState = watchLongReclaim ? (longWatchStale ? "STALE_LONG_WATCH" : "WATCH_LONG_RECLAIM") : watchShortReject ? (shortWatchStale ? "STALE_SHORT_WATCH" : "WATCH_SHORT_REJECT") : "NONE"
bool priorLongWatch = edgeReady and nz(belowRawCloseCount[1]) >= outsideRawCloseBars
bool priorShortWatch = edgeReady and nz(aboveRawCloseCount[1]) >= outsideRawCloseBars
bool vwapSlopeSteep = edgeReady and not na(vwap) and not na(vwap[3]) and math.abs(vwap - vwap[3]) > safeDailyAtr20 * vwapSlopeDailyAtrMult
bool vwapStrongUp = vwapSlopeSteep and vwap > vwap[3]
bool vwapStrongDown = vwapSlopeSteep and vwap < vwap[3]
bool emaSidePush = edgeReady and not na(close[emaSideBars - 1]) and ((longEmaSideCount >= emaSideBars and close > close[emaSideBars - 1]) or (shortEmaSideCount >= emaSideBars and close < close[emaSideBars - 1]))
bool hardTrendKillNow = edgeReady and not na(todayMoveAtr) and math.abs(todayMoveAtr) > trendKillAtr
bool todayMoveTrend = hardTrendKillNow
bool trendProgression = emaSidePush and vwapSlopeSteep
bool softTrendBlockNow = edgeReady and trendProgression and rawOutsideWatch and not hardTrendKillNow
bool noTradeTrendTrigger = confirmed and not noTradeTrendToday and hardTrendKillNow
bool rangeInvalidationTrigger = false
float dayPnl = not na(dayStartNetProfit) ? strategy.netprofit - dayStartNetProfit + strategy.openprofit : strategy.openprofit
bool dailyLossTrigger = confirmed and not dailyLossHaltedToday and not na(dayPnl) and dayPnl <= -maxDailyLossDollars
bool symbolAllowed = not restrictSymbol or isRecommendedEtf()
bool bothDirectionsFailedNow = longLossesToday >= 1 and shortLossesToday >= 1
bool vwapFlatEnough = not vwapSlopeSteep
bool rangeDay = edgeReady and orWidthOk and closeInsideOr and vwapFlatEnough and vwapCrossCount12 <= maxVwapCrossesForRange and not todayMoveTrend
bool failedBreakWatch = edgeReady and rawOutsideWatch and not todayMoveTrend
bool weakTrendPullbackDay = edgeReady and orWidthOk and not todayMoveTrend and math.abs(nz(todayMoveAtr, 0.0)) < trendKillAtr
string regime = not orLocked ? "BUILDING_OR" : orTooNarrow ? "LOW_VOL_DAY" : orTooWide ? "CHAOS_DAY" : noTradeTrendToday or hardTrendKillNow ? "NO_TRADE_TREND" : softTrendBlockNow ? "TREND_WATCH" : failedBreakWatch ? (rawOutsideStale ? "STALE_BREAK_WATCH" : "FAILED_BREAK_WATCH") : orWideWarning ? "WIDE_RANGE_WATCH" : rangeDay ? "RANGE_DAY" : weakTrendPullbackDay ? "WEAK_TREND_PULLBACK" : "CHAOS_DAY"
bool regimeTradeable = regime == "RANGE_DAY" or regime == "WEAK_TREND_PULLBACK" or regime == "FAILED_BREAK_WATCH" or regime == "STALE_BREAK_WATCH" or regime == "WIDE_RANGE_WATCH" or regime == "TREND_WATCH"
bool dayStopActive = rangeInvalidatedToday or noTradeTrendToday or dailyLossHaltedToday or bothDirectionsFailedNow
bool longInsideEdgeCandidate = closeInsideOr and low <= longEdge + nearEdgeDistance and close > longEdge
bool longReclaimCandidate = priorLongWatch and close > longEdge
bool shortInsideEdgeCandidate = closeInsideOr and high >= shortEdge - nearEdgeDistance and close < shortEdge
bool shortRejectCandidate = priorShortWatch and close < shortEdge
bool lunchReclaimCandidate = longReclaimCandidate or shortRejectCandidate
bool lunchAllowsEntry = not inLunchBlock or lunchPolicy == "Allow all" or (lunchPolicy == "Reclaim only" and lunchReclaimCandidate)

// -----------------------------------------------------------------------------
// Position and setup state
// -----------------------------------------------------------------------------
var int setupDirection = 0
var int setupBarIndex = na
var float setupConfirmHigh = na
var float setupConfirmLow = na
var string setupReason = ""
var string setupTrigger = ""

var int pendingDirection = 0
var string pendingSetup = ""
var string pendingTrigger = ""
var float pendingStop = na
var float pendingTp1 = na
var float pendingTp2 = na
var float pendingQty = na
var float pendingPlannedEntry = na

var int activeDirection = 0
var string activeSetup = ""
var string activeTrigger = ""
var float activeEntry = na
var float activeStop = na
var float activeInitialStop = na
var float activeTp1 = na
var float activeTp2 = na
var float activeQty = na
var float activeInitialRisk = na
var float activeMfeR = 0.0
var bool activeBreakevenDone = false
var int activeEntryBar = na
var float activeEntryNetProfit = na

bool positionOpened = strategy.position_size != 0 and nz(strategy.position_size[1]) == 0
bool positionClosed = strategy.position_size == 0 and nz(strategy.position_size[1]) != 0
bool inPosition = strategy.position_size != 0

if confirmed and newDay
    setupDirection := 0
    setupBarIndex := na
    setupConfirmHigh := na
    setupConfirmLow := na
    setupReason := ""
    setupTrigger := ""
    pendingDirection := 0
    pendingSetup := ""
    pendingTrigger := ""
    pendingStop := na
    pendingTp1 := na
    pendingTp2 := na
    pendingQty := na
    pendingPlannedEntry := na

// -----------------------------------------------------------------------------
// Payloads, reasons, and debug state
// -----------------------------------------------------------------------------
dayStopReason() =>
    rangeInvalidatedToday ? "range_invalidated_today" : noTradeTrendToday ? "no_trade_trend_today" : dailyLossHaltedToday ? "daily_loss_halted" : bothDirectionsFailedNow ? "both_directions_failed" : "none"

lunchBlockReason() =>
    not inLunchBlock ? "outside_lunch" : lunchPolicy == "Block all" ? "lunch_block_all" : lunchPolicy == "Reclaim only" and not lunchReclaimCandidate ? "lunch_reclaim_only_waiting" : "none"

lunchStateText() =>
    not inLunchBlock ? "outside lunch" : lunchPolicy == "Block all" ? "blocked" : lunchPolicy == "Allow all" ? "allowed" : lunchReclaimCandidate ? "reclaim-only pass" : "reclaim-only wait"

entryGateBlockReason() =>
    not confirmed ? "bar_not_confirmed" : not is5m ? "not_5m_chart" : not inRth ? "outside_rth" : not orComplete ? "opening_range_not_complete" : inLunchBlock and not lunchAllowsEntry ? lunchBlockReason() : not beforeEntryCutoff ? "after_entry_cutoff" : not edgeReady ? "edge_not_ready" : not orWidthOk ? (orTooNarrow ? "low_vol_or_too_narrow" : "chaos_or_extreme_wide") : softTrendBlockNow ? "soft_trend_watch" : not regimeTradeable ? "regime_not_tradeable_" + regime : not symbolAllowed ? "symbol_restricted" : manualEventBlock ? "manual_event_block" : dayStopActive ? dayStopReason() : tradesToday >= maxTradesPerDay ? "max_trades_reached" : strategy.position_size != 0 ? "position_open" : pendingDirection != 0 ? "entry_pending" : not enableStrategyOrders ? "orders_disabled" : "gate_pass"

rangeStateText() =>
    rangeInvalidatedToday ? "range invalidated" : noTradeTrendToday ? "no trade trend" : dailyLossHaltedToday ? "daily loss halt" : softTrendBlockNow ? "soft trend watch" : not orLocked ? "building OR" : regime

watchExplanation() =>
    softTrendBlockNow ? "EMA/VWAP push with raw outside; wait cooldown" : watchLongReclaim ? (longWatchStale ? "below raw_ORL stale; still wait close > long_edge" : "below raw_ORL " + str.tostring(belowRawCloseCount) + " bars; wait close > long_edge") : watchShortReject ? (shortWatchStale ? "above raw_ORH stale; still wait close < short_edge" : "above raw_ORH " + str.tostring(aboveRawCloseCount) + " bars; wait close < short_edge") : rawOutsideStale ? "raw outside stale; reclaim can still qualify" : "no raw outside watch"

nextActionText() =>
    string gateReason = entryGateBlockReason()
    gateReason != "gate_pass" ? "blocked: " + gateReason : inLunchBlock and lunchReclaimCandidate ? "lunch reclaim candidate; wait trigger confirm" : longReclaimCandidate ? "long reclaim candidate; wait trigger confirm" : shortRejectCandidate ? "short reject candidate; wait trigger confirm" : watchLongReclaim ? "wait close > long_edge" : watchShortReject ? "wait close < short_edge" : "wait price near dynamic edge"

buildPayload(series string eventType, series int directionValue, series string reason, series float eventPrice, series float stopPrice, series float tp1Price, series float tp2Price, series float qtyValue) =>
    string result = "{"
    result := result + jsonStr("source", "tradingview")
    result := result + "," + jsonStr("event_type", eventType)
    result := result + "," + jsonStr("event_id", eventId(eventType))
    result := result + "," + jsonStr("symbol", syminfo.ticker)
    result := result + "," + jsonStr("exchange", syminfo.prefix)
    result := result + "," + jsonStr("interval", timeframe.period)
    result := result + "," + jsonStr("script_tag", SCRIPT_TAG)
    result := result + "," + jsonStr("strategy_version", STRATEGY_VERSION)
    result := result + "," + jsonStr("trade_model", TRADE_MODEL)
    result := result + "," + jsonStr("risk_model", RISK_MODEL)
    result := result + "," + jsonStr("tp_sl_model", TP_SL_MODEL)
    result := result + "," + jsonStr("direction", dirText(directionValue))
    result := result + "," + jsonStr("reason", reason)
    result := result + "," + jsonStr("regime", regime)
    result := result + "," + jsonNum("event_price", eventPrice)
    result := result + "," + jsonNum("entry", eventPrice)
    result := result + "," + jsonNum("stop_loss", stopPrice)
    result := result + "," + jsonNum("tp1", tp1Price)
    result := result + "," + jsonNum("tp2", tp2Price)
    result := result + "," + jsonNum("shares", qtyValue)
    result := result + "," + jsonNum("raw_orh", rawOrh)
    result := result + "," + jsonNum("raw_orl", rawOrl)
    result := result + "," + jsonNum("orm", orm)
    result := result + "," + jsonNum("dist_upper", distUpper)
    result := result + "," + jsonNum("dist_lower", distLower)
    result := result + "," + jsonNum("short_edge", shortEdge)
    result := result + "," + jsonNum("long_edge", longEdge)
    result := result + "," + jsonNum("day_open", dayOpen)
    result := result + "," + jsonNum("daily_atr20", dailyAtr20)
    result := result + "," + jsonNum("today_move_atr", todayMoveAtr)
    result := result + "," + jsonNum("or_width", orWidth)
    result := result + "," + jsonNum("or_atr5", orAtrAtLock)
    result := result + "," + jsonNum("or_width_atr", orWidthAtr)
    result := result + "," + jsonBool("or_width_ok", orWidthOk)
    result := result + "," + jsonBool("or_wide_warning", orWideWarning)
    result := result + "," + jsonStr("watch_state", watchState)
    result := result + "," + jsonStr("range_state", rangeStateText())
    result := result + "," + jsonInt("raw_outside_count", rawOutsideCount)
    result := result + "," + jsonBool("watch_stale", rawOutsideStale)
    result := result + "," + jsonBool("reclaim_allowed", failedBreakWatch or priorLongWatch or priorShortWatch)
    result := result + "," + jsonBool("hard_trend_kill", hardTrendKillNow)
    result := result + "," + jsonBool("soft_trend_watch", softTrendBlockNow)
    result := result + "," + jsonStr("lunch_policy", lunchPolicy)
    result := result + "," + jsonStr("lunch_state", lunchStateText())
    result := result + "," + jsonBool("lunch_allows_entry", lunchAllowsEntry)
    result := result + "," + jsonStr("next_action", nextActionText())
    result := result + "," + jsonInt("up_streak", upStreak)
    result := result + "," + jsonInt("down_streak", downStreak)
    result := result + "," + jsonNum("up_cum_pct", upCumPct)
    result := result + "," + jsonNum("down_cum_pct", downCumPct)
    result := result + "," + jsonBool("range_invalidated_today", rangeInvalidatedToday)
    result := result + "," + jsonBool("no_trade_trend_today", noTradeTrendToday)
    result := result + "," + jsonBool("sector_sync_strong", sectorSyncStrong)
    result := result + "," + jsonBool("core_sync_strong", coreSyncStrong)
    result := result + "," + jsonInt("bar_open_ms", time)
    result := result + "," + jsonInt("bar_close_ms", time_close)
    result := result + "," + jsonInt("bar_index", bar_index)
    result := result + "}"
    result

longNoSignalReason() =>
    string gateReason = entryGateBlockReason()
    gateReason != "gate_pass" ? gateReason : longDisabledToday ? "long_disabled_after_loss" : requireDailyLongEnhancement and not (downStreak >= longDownStreakMin or downCumPct <= longDownCumPctMax) ? "long_daily_filter_failed" : na(todayMoveAtr) ? "today_move_atr_missing" : todayMoveAtr >= -entryMoveAtrMin ? "today_move_atr_not_oversold" : math.abs(todayMoveAtr) >= trendKillAtr ? "today_move_atr_strong_trend" : na(longEdge) ? "long_edge_missing" : not (longInsideEdgeCandidate or longReclaimCandidate) ? "waiting_long_edge_or_reclaim" : "long_setup_ready"

shortNoSignalReason() =>
    string gateReason = entryGateBlockReason()
    gateReason != "gate_pass" ? gateReason : shortDisabledToday ? "short_disabled_after_loss" : not (upStreak >= shortUpStreakMin and upCumPct >= shortUpCumPctMin) and requireDailyShortEnhancement ? "short_daily_filter_failed" : na(todayMoveAtr) ? "today_move_atr_missing" : todayMoveAtr <= entryMoveAtrMin ? "today_move_atr_not_overbought" : math.abs(todayMoveAtr) >= trendKillAtr ? "today_move_atr_strong_trend" : vwapStrongUp ? "vwap_strong_up" : longEmaSideCount >= emaSideBars ? "ema20_upside_push" : sectorSyncStrong ? "smh_xlk_sync_strong" : coreSyncStrong ? "core_weights_sync_strong" : na(shortEdge) ? "short_edge_missing" : not (shortInsideEdgeCandidate or shortRejectCandidate) ? "waiting_short_edge_or_reject" : "short_setup_ready"

debugCommonState() =>
    string result = "regime=" + regime + " gate=" + entryGateBlockReason() + " day_stop=" + dayStopReason()
    result := result + "\nprice=" + fmtPrice(close) + " day_open=" + fmtPrice(dayOpen) + " daily_ATR20=" + fmtPrice(dailyAtr20) + " today_move_atr=" + fmt(todayMoveAtr)
    result := result + "\nraw_ORH=" + fmtPrice(rawOrh) + " raw_ORL=" + fmtPrice(rawOrl) + " ORM=" + fmtPrice(orm) + " OR_width=" + fmtPrice(orWidth) + " ATR5_lock=" + fmtPrice(orAtrAtLock)
    result := result + "\nedge S/L=" + fmtPrice(shortEdge) + "/" + fmtPrice(longEdge) + " near=" + fmtPrice(nearEdgeDistance) + " close_inside_or=" + str.tostring(closeInsideOr)
    result := result + "\nstreak up/down=" + str.tostring(upStreak) + "/" + str.tostring(downStreak) + " cum up/down=" + fmt(upCumPct) + "/" + fmt(downCumPct)
    result := result + "\ntrend: hard=" + str.tostring(hardTrendKillNow) + " soft_watch=" + str.tostring(softTrendBlockNow) + " raw_watch=" + str.tostring(rawOutsideWatch) + " watch_stale=" + str.tostring(rawOutsideStale) + " vwap_slope=" + str.tostring(vwapSlopeSteep) + " ema_push=" + str.tostring(emaSidePush)
    result := result + "\nwatch_state=" + watchState + " lunch=" + lunchStateText() + " why=" + watchExplanation() + " next=" + nextActionText()
    result := result + "\nraw_outside_count=" + str.tostring(rawOutsideCount) + " or_width_atr=" + fmt(orWidthAtr) + " wide_warning=" + str.tostring(orWideWarning)
    result := result + "\nraw_counts above/below=" + str.tostring(aboveRawCloseCount) + "/" + str.tostring(belowRawCloseCount) + " ema_counts up/down=" + str.tostring(longEmaSideCount) + "/" + str.tostring(shortEmaSideCount)
    result := result + "\nRS: qqq=" + fmt(qqqChangePct) + " smh=" + fmt(smhChangePct) + " xlk=" + fmt(xlkChangePct) + " long_div=" + str.tostring(longRelativeDivergence) + " short_div=" + str.tostring(shortRelativeDivergence)
    result := result + "\nshort_blocks sector_sync=" + str.tostring(sectorSyncStrong) + " core_sync=" + str.tostring(coreSyncStrong) + " core_count=" + str.tostring(coreStrongCount)
    result := result + "\nrisk trades=" + str.tostring(tradesToday) + "/" + str.tostring(maxTradesPerDay) + " day_pnl=" + fmt(dayPnl) + " Lfail/Sfail=" + str.tostring(longLossesToday) + "/" + str.tostring(shortLossesToday)
    result := result + "\nlong_reason=" + longNoSignalReason() + " short_reason=" + shortNoSignalReason()
    result

debugCompactState() =>
    string result = "gate=" + entryGateBlockReason() + " regime=" + regime + " watch=" + watchState + " state=" + rangeStateText()
    result := result + "\nlong=" + longNoSignalReason() + " short=" + shortNoSignalReason()
    result := result + "\nmoveATR=" + fmt(todayMoveAtr) + " rawCnt=" + str.tostring(rawOutsideCount) + " lunch=" + lunchStateText() + " softTrend=" + str.tostring(softTrendBlockNow) + " hardTrend=" + str.tostring(hardTrendKillNow)
    result := result + "\nnext=" + nextActionText()
    result

debugConfirmText(int directionValue) =>
    directionValue == 1 ? "need high > " + fmtPrice(setupConfirmHigh + entryBreakBuffer) + " actual high=" + fmtPrice(high) : "need low < " + fmtPrice(setupConfirmLow - entryBreakBuffer) + " actual low=" + fmtPrice(low)

// -----------------------------------------------------------------------------
// State alerts and forced exits
// -----------------------------------------------------------------------------
if orJustLocked
    debugLog("gate", "OR_LOCK", "raw_ORH=" + fmtPrice(rawOrh) + " raw_ORL=" + fmtPrice(rawOrl) + " ORM=" + fmtPrice(orm) + "\nOR_width=" + fmtPrice(orWidth) + " ATR5_lock=" + fmtPrice(orAtrAtLock) + " or_width_atr=" + fmt(orWidthAtr) + " width_ok=" + str.tostring(orWidthOk) + " wide_warning=" + str.tostring(orWideWarning) + " regime=" + regime)

if confirmed and orWideWarning and not wideOrWarningAlertSent
    wideOrWarningAlertSent := true
    debugLog("gate", "WIDE_OR_WARNING", "or_width_atr=" + fmt(orWidthAtr) + " warning_threshold=" + fmt(maxOrAtrMult) + " hard_threshold=" + fmt(hardMaxOrAtrMult) + "\n" + debugCommonState())
    if enableAlerts
        alert(buildPayload("WIDE_OR_WARNING", 0, "wide_or_warning", close, na, na, na, na), alert.freq_all)

if confirmed and orComplete and orWidthOk and regimeTradeable and not softTrendBlockNow and not rangeActiveAlertSent
    rangeActiveAlertSent := true
    debugLog("gate", "RANGE_ACTIVE", debugCommonState())
    if enableAlerts
        alert(buildPayload("RANGE_ACTIVE", 0, "range_active", close, na, na, na, na), alert.freq_all)

if confirmed and watchLongReclaim and not watchLongAlertSent
    watchLongAlertSent := true
    debugLog("gate", "WATCH_LONG_RECLAIM", "raw_outside_count=" + str.tostring(belowRawCloseCount) + "\n" + debugCommonState())
    if enableAlerts
        alert(buildPayload("WATCH_LONG_RECLAIM", 1, "watch_long_reclaim", close, lowerBreakLevel, orm, shortEdge, na), alert.freq_all)
    drawStateLabel("WATCH L", watchExplanation(), low, false, color.new(color.aqua, 0), color.black)

if confirmed and watchShortReject and not watchShortAlertSent
    watchShortAlertSent := true
    debugLog("gate", "WATCH_SHORT_REJECT", "raw_outside_count=" + str.tostring(aboveRawCloseCount) + "\n" + debugCommonState())
    if enableAlerts
        alert(buildPayload("WATCH_SHORT_REJECT", -1, "watch_short_reject", close, upperBreakLevel, orm, longEdge, na), alert.freq_all)
    drawStateLabel("WATCH S", watchExplanation(), high, true, color.new(color.orange, 0), color.black)

if confirmed and softTrendBlockNow and not (softTrendBlockNow[1] == true)
    debugLog("gate", "TREND_WATCH", debugCompactState())
    drawStateLabel("TREND WATCH", watchExplanation(), close, close >= open, color.new(color.orange, 0), color.black)

if noTradeTrendTrigger
    noTradeTrendToday := true
    string reason = "today_move_atr_strong_trend"
    debugLog("gate", "NO_TRADE_TREND", "reason=" + reason + "\n" + debugCommonState())
    if enableAlerts
        alert(buildPayload("NO_TRADE_TREND", 0, reason, close, na, na, na, na), alert.freq_all)
    drawStateLabel("NO TRADE", reason, close, close >= open, color.new(color.orange, 0), color.black)
    if inPosition
        strategy.close(orderIdForDirection(activeDirection), comment="STOP_OR_BREAK no_trade_trend " + fmtPrice(close))

if rangeInvalidationTrigger
    rangeInvalidatedToday := true
    string reason = "range_invalidated_guard"
    debugLog("gate", "RANGE_INVALIDATED", "reason=" + reason + "\n" + debugCommonState())
    if enableAlerts
        alert(buildPayload("RANGE_INVALIDATED", 0, reason, close, na, na, na, na), alert.freq_all)
    drawStateLabel("RANGE X", reason, close, aboveRawCloseCount >= outsideRawCloseBars, color.new(color.red, 0), color.white)
    if inPosition
        strategy.close(orderIdForDirection(activeDirection), comment="RANGE_INVALIDATED " + fmtPrice(close))

if dailyLossTrigger
    dailyLossHaltedToday := true
    debugLog("gate", "DAILY_LOSS_HALT", "day_pnl=" + fmt(dayPnl) + " max_daily_loss=" + fmt(maxDailyLossDollars))
    if inPosition
        strategy.close(orderIdForDirection(activeDirection), comment="TIME_EXIT daily_loss " + fmtPrice(close))

if confirmed and forceFlatNow and inPosition
    debugLog("order", "FORCE_FLAT", "time exit at " + fmtPrice(close))
    strategy.close(orderIdForDirection(activeDirection), comment="TIME_EXIT force_flat " + fmtPrice(close))

// -----------------------------------------------------------------------------
// Position lifecycle and management
// -----------------------------------------------------------------------------
if positionOpened
    int fillDirection = pendingDirection != 0 ? pendingDirection : strategy.position_size > 0 ? 1 : -1
    activeDirection := fillDirection
    activeSetup := pendingSetup
    activeTrigger := pendingTrigger
    activeEntry := strategy.position_avg_price
    activeStop := pendingStop
    activeInitialStop := pendingStop
    activeTp1 := pendingTp1
    activeTp2 := pendingTp2
    activeQty := math.abs(strategy.position_size)
    activeInitialRisk := math.abs(strategy.position_avg_price - pendingStop)
    activeMfeR := 0.0
    activeBreakevenDone := false
    activeEntryBar := bar_index
    activeEntryNetProfit := strategy.netprofit
    pendingDirection := 0
    pendingSetup := ""
    pendingTrigger := ""
    pendingStop := na
    pendingTp1 := na
    pendingTp2 := na
    pendingQty := na
    pendingPlannedEntry := na
    debugLog("order", "POSITION_OPENED", "side=" + dirText(fillDirection) + " fill=" + fmtPrice(strategy.position_avg_price) + " stop=" + fmtPrice(activeStop) + " tp1=" + fmtPrice(activeTp1) + " tp2=" + fmtPrice(activeTp2) + " qty=" + qtyText(activeQty))
    drawEventLabel(fillDirection == 1 ? "FILL L" : "FILL S", "Strategy position opened at " + fmtPrice(strategy.position_avg_price), strategy.position_avg_price, fillDirection == -1, color.new(color.blue, 0), color.white)

bool stopOrBreakLong = inPosition and activeDirection == 1 and edgeReady and (close < rawOrl or low < lowerBreakLevel)
bool stopOrBreakShort = inPosition and activeDirection == -1 and edgeReady and (close > rawOrh or high > upperBreakLevel)
bool stopOrBreakNow = confirmed and (stopOrBreakLong or stopOrBreakShort)
if stopOrBreakNow
    rangeInvalidatedToday := true
    debugLog("order", "STOP_OR_BREAK", "side=" + dirText(activeDirection) + " close=" + fmtPrice(close) + " raw_ORH=" + fmtPrice(rawOrh) + " raw_ORL=" + fmtPrice(rawOrl))
    strategy.close(orderIdForDirection(activeDirection), comment="STOP_OR_BREAK raw_or_death_line " + fmtPrice(close))

bool forcedExitRequestedThisBar = inPosition and (stopOrBreakNow or rangeInvalidationTrigger or noTradeTrendTrigger or dailyLossTrigger or (confirmed and forceFlatNow))
if inPosition and not forcedExitRequestedThisBar and activeDirection != 0 and activeInitialRisk > 0.0
    float favorableMove = activeDirection == 1 ? high - activeEntry : activeEntry - low
    activeMfeR := math.max(activeMfeR, favorableMove / activeInitialRisk)
    if not activeBreakevenDone and activeMfeR >= breakevenAtR
        activeStop := activeEntry
        activeBreakevenDone := true
        drawEventLabel("BE", "MFE reached " + fmt(activeMfeR) + "R; stop moved to breakeven.", activeStop, activeDirection == -1, color.new(color.yellow, 0), color.black)
    bool timeStopNow = confirmed and not forceFlatNow and bar_index - activeEntryBar >= timeStopBars and activeMfeR < timeStopMinMfeR
    if timeStopNow
        strategy.close(orderIdForDirection(activeDirection), comment="TIME_EXIT no_0_5r_in_30m " + fmtPrice(close))
    else
        if activeDirection == 1
            strategy.exit("DORH-L-TP1", from_entry=LONG_ID, qty_percent=tp1ExitPct, stop=activeStop, limit=activeTp1, comment_profit="TAKE_MID " + fmtPrice(activeTp1), comment_loss="STOP_OR_BREAK " + fmtPrice(activeStop))
            strategy.exit("DORH-L-TP2", from_entry=LONG_ID, qty_percent=100 - tp1ExitPct, stop=activeStop, limit=activeTp2, comment_profit="TAKE_EDGE " + fmtPrice(activeTp2), comment_loss="STOP_OR_BREAK " + fmtPrice(activeStop))
        else
            strategy.exit("DORH-S-TP1", from_entry=SHORT_ID, qty_percent=tp1ExitPct, stop=activeStop, limit=activeTp1, comment_profit="TAKE_MID " + fmtPrice(activeTp1), comment_loss="STOP_OR_BREAK " + fmtPrice(activeStop))
            strategy.exit("DORH-S-TP2", from_entry=SHORT_ID, qty_percent=100 - tp1ExitPct, stop=activeStop, limit=activeTp2, comment_profit="TAKE_EDGE " + fmtPrice(activeTp2), comment_loss="STOP_OR_BREAK " + fmtPrice(activeStop))

var int lastClosedTrades = 0
var int lastTerminalAlertBar = na
var string lastTerminalAlertEvent = ""

if strategy.closedtrades > lastClosedTrades
    for tradeIndex = lastClosedTrades to strategy.closedtrades - 1
        string exitComment = strategy.closedtrades.exit_comment(tradeIndex)
        string eventType = str.contains(exitComment, "TAKE_MID") ? "TAKE_MID" : str.contains(exitComment, "TAKE_EDGE") ? "TAKE_EDGE" : str.contains(exitComment, "STOP_OR_BREAK") ? "STOP_OR_BREAK" : str.contains(exitComment, "RANGE_INVALIDATED") ? "RANGE_INVALIDATED" : str.contains(exitComment, "TIME_EXIT") ? "TIME_EXIT" : ""
        if eventType != ""
            float exitPrice = strategy.closedtrades.exit_price(tradeIndex)
            bool terminalEvent = eventType != "TAKE_MID"
            bool shouldEmit = not terminalEvent or na(lastTerminalAlertBar) or bar_index != lastTerminalAlertBar or eventType != lastTerminalAlertEvent
            if shouldEmit and enableAlerts
                alert(buildPayload(eventType, activeDirection, exitComment, exitPrice, activeStop, activeTp1, activeTp2, activeQty), alert.freq_all)
            if shouldEmit
                bool isTake = eventType == "TAKE_MID" or eventType == "TAKE_EDGE"
                drawEventLabel(eventType, exitComment, exitPrice, activeDirection == -1, isTake ? color.new(color.lime, 0) : color.new(color.red, 0), isTake ? color.black : color.white)
            if terminalEvent and shouldEmit
                lastTerminalAlertBar := bar_index
                lastTerminalAlertEvent := eventType
            if eventType == "STOP_OR_BREAK" or eventType == "RANGE_INVALIDATED"
                rangeInvalidatedToday := true
    lastClosedTrades := strategy.closedtrades

if positionClosed and activeDirection != 0
    float activeNetPnl = strategy.netprofit - nz(activeEntryNetProfit, strategy.netprofit)
    debugLog("order", "POSITION_CLOSED", "side=" + dirText(activeDirection) + " net_pnl_since_entry=" + fmt(activeNetPnl) + " mfe_r=" + fmt(activeMfeR))
    if activeNetPnl < 0.0
        if activeDirection == 1
            longLossesToday += 1
            longDisabledToday := true
        else
            shortLossesToday += 1
            shortDisabledToday := true
    activeDirection := 0
    activeSetup := ""
    activeTrigger := ""
    activeEntry := na
    activeStop := na
    activeInitialStop := na
    activeTp1 := na
    activeTp2 := na
    activeQty := na
    activeInitialRisk := na
    activeMfeR := 0.0
    activeBreakevenDone := false
    activeEntryBar := na
    activeEntryNetProfit := na

// -----------------------------------------------------------------------------
// Setup detection and entry submission
// -----------------------------------------------------------------------------
bool canOpenOrTrigger = confirmed and is5m and inRth and orComplete and lunchAllowsEntry and beforeEntryCutoff and edgeReady and orWidthOk and regimeTradeable and not softTrendBlockNow and symbolAllowed and not manualEventBlock and not dayStopActive and tradesToday < maxTradesPerDay and strategy.position_size == 0 and pendingDirection == 0 and enableStrategyOrders

if confirmed and setupDirection != 0 and (not canOpenOrTrigger or bar_index > setupBarIndex + 1)
    debugLog("setup", "SETUP_CANCEL", "reason=" + (not canOpenOrTrigger ? entryGateBlockReason() : "confirm_timeout") + " setup_dir=" + dirText(setupDirection) + "\n" + debugConfirmText(setupDirection) + "\n" + debugCommonState())
    setupDirection := 0
    setupBarIndex := na
    setupConfirmHigh := na
    setupConfirmLow := na
    setupReason := ""
    setupTrigger := ""

bool longDailyQuality = downStreak >= longDownStreakMin or downCumPct <= longDownCumPctMax
bool longDailyOk = not requireDailyLongEnhancement or longDailyQuality
bool strongLongState = downStreak >= strongLongDownStreak or downCumPct <= strongLongDownCumPct
bool shortDailyOk = not requireDailyShortEnhancement or (upStreak >= shortUpStreakMin and upCumPct >= shortUpCumPctMin)
bool strongShortState = upStreak >= strongShortUpStreak and upCumPct >= strongShortUpCumPct
bool longBase = canOpenOrTrigger and setupDirection == 0 and not longDisabledToday and longDailyOk and todayMoveAtr < -entryMoveAtrMin and math.abs(todayMoveAtr) < trendKillAtr and (longInsideEdgeCandidate or longReclaimCandidate)
bool shortHardBlock = vwapStrongUp or longEmaSideCount >= emaSideBars or sectorSyncStrong or coreSyncStrong or rawCloseAbove
bool shortBase = canOpenOrTrigger and setupDirection == 0 and not shortDisabledToday and shortDailyOk and not shortHardBlock and todayMoveAtr > entryMoveAtrMin and math.abs(todayMoveAtr) < trendKillAtr and (shortInsideEdgeCandidate or shortRejectCandidate)

bool longStopCandle = close > open and lowerWickRatio >= wickReversalMin
bool longReclaimEdge = low < longEdge and close > longEdge
bool longHigherLow = not na(low[1]) and low > low[1] and low[1] <= longEdge + nearEdgeDistance
bool longTriggerOk = longStopCandle or longReclaimEdge or longHigherLow or longRelativeDivergence
string longTriggerReason = longReclaimEdge ? "reclaim_edge" : longStopCandle ? "reversal_candle" : longHigherLow ? "higher_low" : longRelativeDivergence ? "relative_divergence" : "none"

bool shortFailureCandle = close < open and upperWickRatio >= wickReversalMin
bool shortRejectEdge = high > shortEdge and close < shortEdge
bool shortLowerHigh = not na(high[1]) and high < high[1] and high[1] >= shortEdge - nearEdgeDistance
bool shortTriggerOk = shortFailureCandle or shortRejectEdge or shortLowerHigh or shortRelativeDivergence
string shortTriggerReason = shortRejectEdge ? "failed_break" : shortFailureCandle ? "reversal_candle" : shortLowerHigh ? "lower_high" : shortRelativeDivergence ? "relative_divergence" : "none"

bool longSetupBar = longBase and longTriggerOk
bool shortSetupBar = shortBase and shortTriggerOk and not longSetupBar

if longSetupBar
    setupDirection := 1
    setupBarIndex := bar_index
    setupConfirmHigh := high
    setupConfirmLow := low
    setupReason := longReclaimCandidate ? "long_reclaim_orl" : strongLongState ? "strong_long_dist_edge" : longDailyQuality ? "quality_long_dist_edge" : "long_dist_edge"
    setupTrigger := longTriggerReason
    debugLog("setup", "LONG_SETUP", "reason=" + setupReason + " trigger=" + setupTrigger + "\nnext bar confirm: high > " + fmtPrice(setupConfirmHigh + entryBreakBuffer) + "\n" + debugCommonState())
    if enableAlerts
        alert(buildPayload("LONG_SETUP", 1, setupReason + ":" + setupTrigger, close, lowerBreakLevel, orm, shortEdge, na), alert.freq_all)
    drawEventLabel("LONG SETUP", setupReason + " / " + setupTrigger, low, false, color.new(color.teal, 0), color.white)
else if shortSetupBar
    setupDirection := -1
    setupBarIndex := bar_index
    setupConfirmHigh := high
    setupConfirmLow := low
    setupReason := shortRejectCandidate ? "short_reject_orh" : strongShortState ? "strong_short_dist_edge" : "short_dist_edge"
    setupTrigger := shortTriggerReason
    debugLog("setup", "SHORT_SETUP", "reason=" + setupReason + " trigger=" + setupTrigger + "\nnext bar confirm: low < " + fmtPrice(setupConfirmLow - entryBreakBuffer) + "\n" + debugCommonState())
    if enableAlerts
        alert(buildPayload("SHORT_SETUP", -1, setupReason + ":" + setupTrigger, close, upperBreakLevel, orm, longEdge, na), alert.freq_all)
    drawEventLabel("SHORT SETUP", setupReason + " / " + setupTrigger, high, true, color.new(color.maroon, 0), color.white)

bool longEntryTrigger = canOpenOrTrigger and setupDirection == 1 and bar_index == setupBarIndex + 1 and high > setupConfirmHigh + entryBreakBuffer
bool shortEntryTrigger = canOpenOrTrigger and setupDirection == -1 and bar_index == setupBarIndex + 1 and low < setupConfirmLow - entryBreakBuffer
int selectedDirection = longEntryTrigger ? 1 : shortEntryTrigger ? -1 : 0

if selectedDirection != 0
    float plannedEntry = close
    float stopPrice = selectedDirection == 1 ? lowerBreakLevel : upperBreakLevel
    float tp1Price = orm
    float rawFallbackTp2 = selectedDirection == 1 ? rawOrh - syminfo.mintick : rawOrl + syminfo.mintick
    float edgeTp2 = selectedDirection == 1 ? shortEdge : longEdge
    float tp2Price = selectedDirection == 1 ? (not na(edgeTp2) and edgeTp2 > plannedEntry ? edgeTp2 : rawFallbackTp2) : (not na(edgeTp2) and edgeTp2 < plannedEntry ? edgeTp2 : rawFallbackTp2)
    float stopDistance = math.abs(plannedEntry - stopPrice)
    float riskQty = stopDistance > 0.0 ? math.floor(riskDollars / stopDistance) : na
    float notionalCapDollars = accountSize * maxNotionalPct / 100.0
    float notionalQty = plannedEntry > 0.0 ? math.floor(notionalCapDollars / plannedEntry) : na
    float plannedQty = math.min(nz(riskQty, 0.0), nz(notionalQty, 0.0))
    bool favorableTargets = selectedDirection == 1 ? tp1Price > plannedEntry and tp2Price > plannedEntry and stopPrice < plannedEntry : tp1Price < plannedEntry and tp2Price < plannedEntry and stopPrice > plannedEntry
    bool qtyOk = not na(plannedQty) and plannedQty >= minQty
    if qtyOk and favorableTargets
        string eventType = selectedDirection == 1 ? "LONG_TRIGGER" : "SHORT_TRIGGER"
        debugLog("order", "ENTRY_ORDER", "side=" + dirText(selectedDirection) + " setup=" + setupReason + " trigger=" + setupTrigger + "\nplanned_entry=" + fmtPrice(plannedEntry) + " stop=" + fmtPrice(stopPrice) + " tp1=" + fmtPrice(tp1Price) + " tp2=" + fmtPrice(tp2Price) + " qty=" + qtyText(plannedQty) + "\nrisk_qty=" + qtyText(riskQty) + " notional_qty=" + qtyText(notionalQty) + "\n" + debugCommonState())
        if selectedDirection == 1
            strategy.entry(LONG_ID, strategy.long, qty=plannedQty, comment="LONG_TRIGGER Q" + qtyText(plannedQty))
        else
            strategy.entry(SHORT_ID, strategy.short, qty=plannedQty, comment="SHORT_TRIGGER Q" + qtyText(plannedQty))
        pendingDirection := selectedDirection
        pendingSetup := setupReason
        pendingTrigger := setupTrigger
        pendingStop := stopPrice
        pendingTp1 := tp1Price
        pendingTp2 := tp2Price
        pendingQty := plannedQty
        pendingPlannedEntry := plannedEntry
        tradesToday += 1
        if enableAlerts
            alert(buildPayload(eventType, selectedDirection, setupReason + ":" + setupTrigger, plannedEntry, stopPrice, tp1Price, tp2Price, plannedQty), alert.freq_all)
        drawEventLabel(selectedDirection == 1 ? "BUY next" : "SELL next", eventType + "\n" + setupTrigger + "\nE " + fmtPrice(plannedEntry) + " SL " + fmtPrice(stopPrice) + " Q " + qtyText(plannedQty), plannedEntry, selectedDirection == -1, selectedDirection == 1 ? color.new(color.lime, 0) : color.new(color.red, 0), selectedDirection == 1 ? color.black : color.white)
    else
        string blockReason = not qtyOk ? "qty_too_small" : "unfavorable_target_or_stop"
        debugLog("order", "ENTRY_BLOCKED", "side=" + dirText(selectedDirection) + " reason=" + blockReason + "\nplanned_entry=" + fmtPrice(plannedEntry) + " stop=" + fmtPrice(stopPrice) + " tp1=" + fmtPrice(tp1Price) + " tp2=" + fmtPrice(tp2Price) + " qty=" + qtyText(plannedQty) + "\nrisk_qty=" + qtyText(riskQty) + " notional_qty=" + qtyText(notionalQty) + "\nfavorable_targets=" + str.tostring(favorableTargets) + " qty_ok=" + str.tostring(qtyOk) + "\n" + debugCommonState())
        if showDiagnostics
            drawEventLabel("xDORH", blockReason + "\nentry " + fmtPrice(plannedEntry) + "\nstop " + fmtPrice(stopPrice) + "\ntp1 " + fmtPrice(tp1Price) + "\ntp2 " + fmtPrice(tp2Price), close, selectedDirection == -1, color.new(color.gray, 0), color.white)
    setupDirection := 0
    setupBarIndex := na
    setupConfirmHigh := na
    setupConfirmLow := na
    setupReason := ""
    setupTrigger := ""
else if confirmed and setupDirection != 0 and bar_index == setupBarIndex + 1 and canOpenOrTrigger
    debugLog("setup", "CONFIRM_BLOCK", "side=" + dirText(setupDirection) + " reason=next_bar_confirmation_failed\n" + debugConfirmText(setupDirection) + "\n" + debugCommonState())
    setupDirection := 0
    setupBarIndex := na
    setupConfirmHigh := na
    setupConfirmLow := na
    setupReason := ""
    setupTrigger := ""

if enableDebugLogs and debugLogGate and confirmed and orComplete and strategy.position_size == 0 and pendingDirection == 0 and setupDirection == 0 and bar_index % debugHeartbeatBars == 0
    debugLog("gate", "ENTRY_GATE_BLOCKED", "blocked_stage=" + entryGateBlockReason() + "\n" + debugCompactState())

var string lastStateSignature = ""
if confirmed and newDay
    lastStateSignature := ""

if enableDebugLogs and debugLogGate and debugLogStateChanges and confirmed and orComplete
    string stateSignature = entryGateBlockReason() + "|" + regime + "|" + watchState + "|" + lunchStateText() + "|" + longNoSignalReason() + "|" + shortNoSignalReason()
    if stateSignature != lastStateSignature
        log.warning("[" + SCRIPT_TAG + " " + STRATEGY_VERSION + "] " + syminfo.ticker + " tf=" + timeframe.period + " ET=" + debugEtStamp() + " bar=" + str.tostring(bar_index) + " STATE_CHANGE\n" + debugCompactState())
        lastStateSignature := stateSignature

var int lastDebugStatusBar = na
if enableDebugLogs and debugLogGate and confirmed and (barstate.isrealtime or barstate.islastconfirmedhistory) and (na(lastDebugStatusBar) or lastDebugStatusBar != bar_index)
    debugLog("gate", "DEBUG_STATUS", "log pipeline alive. Enable full historical logs only on a short chart range.\n" + debugCompactState())
    lastDebugStatusBar := bar_index

// -----------------------------------------------------------------------------
// Display
// -----------------------------------------------------------------------------
bgcolor(rangeInvalidatedToday ? color.new(color.red, 92) : noTradeTrendToday ? color.new(color.orange, 92) : dailyLossHaltedToday ? color.new(color.gray, 90) : na)

plot(showLevels and orComplete ? rawOrh : na, "raw_ORH death line", color=color.rgb(255, 59, 48), linewidth=3, style=plot.style_linebr)
plot(showLevels and orComplete ? rawOrl : na, "raw_ORL death line", color=color.rgb(52, 199, 89), linewidth=3, style=plot.style_linebr)
plot(showLevels and edgeReady ? shortEdge : na, "short_edge entry", color=color.rgb(255, 149, 0), linewidth=2, style=plot.style_linebr)
plot(showLevels and edgeReady ? longEdge : na, "long_edge entry", color=color.rgb(0, 188, 212), linewidth=2, style=plot.style_linebr)
plot(showLevels and orComplete ? orm : na, "ORM main TP", color=color.rgb(55, 55, 55), linewidth=2, style=plot.style_linebr)
plot(showDistributionLevels and edgeReady ? distUpper : na, "dist_upper hidden", color=color.new(color.rgb(255, 149, 0), 72), linewidth=1, style=plot.style_linebr)
plot(showDistributionLevels and edgeReady ? distLower : na, "dist_lower hidden", color=color.new(color.rgb(0, 188, 212), 72), linewidth=1, style=plot.style_linebr)
plot(showVwapEma and inRth ? vwap : na, "RTH VWAP muted", color=color.new(color.yellow, 58), linewidth=1, style=plot.style_linebr)
plot(showVwapEma and inRth ? ema20 : na, "EMA20 muted", color=color.new(color.blue, 68), linewidth=1)

var label statusLabel = na
if confirmed and showDiagnostics
    label.delete(statusLabel)
    string status = "DORH v3.4"
    status := status + "\nregime=" + regime + " gate=" + entryGateBlockReason()
    status := status + "\nstate=" + rangeStateText()
    status := status + "\nlunch=" + lunchStateText()
    status := status + "\nwhy=" + watchExplanation()
    status := status + "\nnext=" + nextActionText()
    status := status + "\nlong=" + longNoSignalReason()
    status := status + "\nshort=" + shortNoSignalReason()
    status := status + "\nmoveATR=" + fmt(todayMoveAtr) + " ORok=" + str.tostring(orWidthOk)
    status := status + "\nstreak up/down=" + str.tostring(upStreak) + "/" + str.tostring(downStreak)
    statusLabel := label.new(bar_index, high, status, style=label.style_label_left, color=color.new(color.black, 10), textcolor=color.white, size=size.small)

var table stateTable = table.new(position.top_right, 1, 1, frame_color=color.new(color.gray, 40), frame_width=1)
if confirmed and showDebugTable
    string tableText = "DORH v3.4"
    tableText := tableText + "\nState: " + rangeStateText()
    tableText := tableText + "\nWhy: " + watchExplanation()
    tableText := tableText + "\nNext: " + nextActionText()
    tableText := tableText + "\nLunch: " + lunchStateText()
    tableText := tableText + "\nRegime: " + regime
    tableText := tableText + "\nWatch: " + watchState + " rawCnt " + str.tostring(rawOutsideCount) + " stale " + str.tostring(rawOutsideStale)
    tableText := tableText + "\nTrade allowed: " + str.tostring(entryGateBlockReason() == "gate_pass")
    tableText := tableText + "\nGate: " + entryGateBlockReason()
    tableText := tableText + "\nLong block: " + longNoSignalReason()
    tableText := tableText + "\nShort block: " + shortNoSignalReason()
    tableText := tableText + "\nmoveATR: " + fmt(todayMoveAtr)
    tableText := tableText + "\nup/down streak: " + str.tostring(upStreak) + "/" + str.tostring(downStreak)
    tableText := tableText + "\nup/down cum: " + fmt(upCumPct) + "% / " + fmt(downCumPct) + "%"
    tableText := tableText + "\nOR/ATR: " + fmt(orWidthAtr) + " width " + fmtPrice(orWidth) + " wideWarn " + str.tostring(orWideWarning)
    tableText := tableText + "\nEdges S/L: " + fmtPrice(shortEdge) + " / " + fmtPrice(longEdge)
    tableText := tableText + "\nDist U/L: " + fmtPrice(distUpper) + " / " + fmtPrice(distLower)
    tableText := tableText + "\nTrades: " + str.tostring(tradesToday) + "/" + str.tostring(maxTradesPerDay) + " PnL " + fmt(dayPnl)
    tableText := tableText + "\nRS q/s/x: " + fmt(qqqChangePct) + "/" + fmt(smhChangePct) + "/" + fmt(xlkChangePct)
    tableText := tableText + "\nCore strong: " + str.tostring(coreStrongCount) + " sector sync " + str.tostring(sectorSyncStrong)
    table.cell(stateTable, 0, 0, tableText, text_color=color.white, bgcolor=color.new(color.black, 10), text_size=size.small)

if confirmed and rthStarted and showSymbolWarning and (not is5m or (restrictSymbol and not isRecommendedEtf()))
    string warning = is5m ? "DORH v3.4: symbol blocked by preferred ETF filter." : "DORH v3.4 requires a 5m RTH chart for orders."
    if restrictSymbol and not isRecommendedEtf()
        warning := warning + "\nCurrent symbol is blocked by Restrict to preferred ETF list."
    label.new(bar_index, high, warning, style=label.style_label_down, color=color.new(color.black, 0), textcolor=color.white, size=size.small)
