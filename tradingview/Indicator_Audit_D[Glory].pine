//@version=6
indicator(title="Indicator Audit D[Glory]", shorttitle="IAC Audit", overlay=true, max_labels_count=20)

// Lightweight TradingView indicator audit script.
// One chart timeframe per alert. No request.security() and no trading signals.

// ------------------------- Inputs -------------------------
string groupMeta = "Audit"
alertEnabled = input.bool(true, "Send indicator_audit alert", group=groupMeta)
scriptTag = input.string("IAC_D_v1", "script_tag", group=groupMeta)
dataEnvironment = input.string("live", "environment", options=["live", "paper", "backtest"], group=groupMeta)

string groupEma = "EMA Trend Matrix"
emaSlopeLookback = input.int(12, "slope lookback", minval=1, group=groupEma)
emaMinAngle = input.float(0.01, "min slope pct", step=0.01, group=groupEma)
emaMinSpacing = input.float(0.01, "min spacing pct", step=0.01, group=groupEma)
emaTouchType = input.string("slow", "touch type", options=["fast", "slow", "both"], group=groupEma)

string groupFractal = "Fractal Pivot"
fractalPeriod = input.int(4, "fractal period", minval=2, maxval=20, group=groupFractal)
donchianPeriod = input.int(20, "donchian period", minval=1, group=groupFractal)

string groupSd = "SD Channel"
sdLength = input.int(128, "linear regression length", minval=2, group=groupSd)
sdMult1 = input.float(1.0, "mult 1", step=0.5, group=groupSd)
sdMult2 = input.float(2.0, "mult 2", step=0.5, group=groupSd)
sdMult3 = input.float(3.0, "mult 3", step=0.5, group=groupSd)
sdMult4 = input.float(4.0, "mult 4", step=0.5, group=groupSd)
sdSignalBand = input.int(3, "signal band", minval=1, maxval=4, group=groupSd)
sdFilterBand = input.int(2, "filter band", minval=1, maxval=4, group=groupSd)

string groupDtp = "DTP"
dtpSmaLength = input.int(100, "SMA length", minval=1, group=groupDtp)
dtpAtrLength = input.int(200, "ATR length", minval=1, group=groupDtp)
dtpMult1 = input.float(3.0, "mult 1", step=0.5, group=groupDtp)
dtpMult2 = input.float(6.0, "mult 2", step=0.5, group=groupDtp)
dtpMult3 = input.float(9.0, "mult 3", step=0.5, group=groupDtp)
dtpMult4 = input.float(12.0, "mult 4", step=0.5, group=groupDtp)
dtpSignalBand = input.int(4, "signal band", minval=1, maxval=4, group=groupDtp)
dtpMomentumLookback = input.int(12, "momentum lookback", minval=1, group=groupDtp)
dtpTrendThreshold = input.float(0.1, "trend threshold", step=0.05, group=groupDtp)
dtpEarlyBars = input.int(12, "early bars", minval=1, group=groupDtp)
dtpMatureBars = input.int(48, "mature bars", minval=1, group=groupDtp)

string groupAtr = "ATR / VWAP"
atrLength = input.int(10, "ATR length", minval=1, group=groupAtr)
atrSmoothing = input.string("RMA", "ATR smoothing", options=["RMA", "SMA", "EMA", "WMA"], group=groupAtr)
atrMultiplier = input.float(1.5, "ATR multiplier", step=0.1, group=groupAtr)

string groupOsc = "Oscillators"
crsiDomcycle = input.int(20, "cRSI domcycle", minval=2, group=groupOsc)
crsiVibration = input.int(6, "cRSI vibration", minval=1, group=groupOsc)
crsiLeveling = input.float(10.0, "cRSI leveling", minval=1.0, maxval=49.0, step=1.0, group=groupOsc)
obvRsiLen = input.int(10, "OBV RSI length", minval=1, group=groupOsc)

string groupDiv = "Divergence"
emitDivergence = input.bool(true, "emit divergence fields", group=groupDiv)
crsiDivLookback = input.int(4, "cRSI pivot lookback", minval=1, maxval=20, group=groupDiv)
crsiDivMaxBars = input.int(30, "cRSI max bars", minval=1, maxval=200, group=groupDiv)
obvDivLookback = input.int(4, "OBV pivot lookback", minval=1, maxval=20, group=groupDiv)
obvDivMaxBars = input.int(30, "OBV max bars", minval=1, maxval=200, group=groupDiv)
divType = input.string("both", "divergence type", options=["regular", "hidden", "both"], group=groupDiv)

// ------------------------- Helpers -------------------------
jsonFloat(float value, string pattern) =>
    na(value) ? "null" : str.tostring(value, pattern)

jsonBool(bool value) =>
    value ? "true" : "false"

bandMult(int band, float m1, float m2, float m3, float m4) =>
    band == 1 ? m1 : band == 2 ? m2 : band == 3 ? m3 : m4

arrayStdev(array<float> values, int minCount) =>
    int count = array.size(values)
    if count < minCount
        0.0
    else
        float total = 0.0
        for i = 0 to count - 1
            total += array.get(values, i)
        float mean = total / count
        float variance = 0.0
        for i = 0 to count - 1
            float diff = array.get(values, i) - mean
            variance += diff * diff
        math.sqrt(variance / count)

// ------------------------- Bar/session -------------------------
confirmed = barstate.isconfirmed
string sessionType = session.ismarket ? "regular" : session.ispremarket ? "premarket" : session.ispostmarket ? "afterhours" : "unknown"
float trValue = na(close[1]) ? high - low : math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
bool newUsDay = nz(ta.change(time("D"))) != 0

var float dClose1 = na
var float dClose2 = na
var float dClose3 = na
var float dClose4 = na
var float dClose5 = na
if newUsDay and not na(close[1])
    dClose5 := dClose4
    dClose4 := dClose3
    dClose3 := dClose2
    dClose2 := dClose1
    dClose1 := close[1]
float dayChangePct = na(dClose1) ? na : (close - dClose1) / dClose1 * 100.0
float prevCloseChangePct = na(dClose1) or na(dClose2) ? na : (dClose1 - dClose2) / dClose2 * 100.0
float change7d = na(dClose5) ? na : (close - dClose5) / dClose5 * 100.0

// ------------------------- EMA Trend Matrix -------------------------
float emaFast = ta.ema(close, 20)
float emaSlow = ta.ema(close, 50)
float emaTrend = ta.ema(close, 100)
float emaLongest = ta.ema(close, 200)
float slopeSlow = not na(emaSlow[emaSlopeLookback]) and emaSlow[emaSlopeLookback] != 0.0 ? (emaSlow - emaSlow[emaSlopeLookback]) / emaSlow[emaSlopeLookback] * 100.0 : 0.0
float slopeTrend = not na(emaTrend[emaSlopeLookback]) and emaTrend[emaSlopeLookback] != 0.0 ? (emaTrend - emaTrend[emaSlopeLookback]) / emaTrend[emaSlopeLookback] * 100.0 : 0.0
float slopeLongest = not na(emaLongest[emaSlopeLookback]) and emaLongest[emaSlopeLookback] != 0.0 ? (emaLongest - emaLongest[emaSlopeLookback]) / emaLongest[emaSlopeLookback] * 100.0 : 0.0
float spacingFastSlow = emaSlow != 0.0 ? math.abs(emaFast - emaSlow) / emaSlow * 100.0 : 0.0
float spacingSlowTrend = emaTrend != 0.0 ? math.abs(emaSlow - emaTrend) / emaTrend * 100.0 : 0.0
float spacingTrendLongest = emaLongest != 0.0 ? math.abs(emaTrend - emaLongest) / emaLongest * 100.0 : 0.0
bool spacingOk = spacingFastSlow > emaMinSpacing and spacingSlowTrend > emaMinSpacing and spacingTrendLongest > emaMinSpacing
bool emaBullishAlignOnly = emaFast > emaSlow and emaSlow > emaTrend
bool emaBearishAlignOnly = emaFast < emaSlow and emaSlow < emaTrend
bool emaBullish = emaFast > emaSlow and emaSlow > emaTrend and emaTrend > emaLongest and slopeSlow > emaMinAngle and slopeTrend > emaMinAngle and slopeLongest > emaMinAngle and spacingOk
bool emaBearish = emaFast < emaSlow and emaSlow < emaTrend and emaTrend < emaLongest and slopeSlow < -emaMinAngle and slopeTrend < -emaMinAngle and slopeLongest < -emaMinAngle and spacingOk
int trendDir = emaBullish ? 1 : emaBearish ? -1 : 0
bool bullTouchFast = emaBullishAlignOnly and spacingOk and close[1] > emaFast[1] and low <= emaFast
bool bearTouchFast = emaBearishAlignOnly and spacingOk and close[1] < emaFast[1] and high >= emaFast
bool bullTouchSlow = emaBullishAlignOnly and spacingOk and close[1] > emaSlow[1] and low <= emaSlow
bool bearTouchSlow = emaBearishAlignOnly and spacingOk and close[1] < emaSlow[1] and high >= emaSlow
bool emaBullTouch = emaTouchType == "fast" ? bullTouchFast : emaTouchType == "both" ? (bullTouchFast or bullTouchSlow) : bullTouchSlow
bool emaBearTouch = emaTouchType == "fast" ? bearTouchFast : emaTouchType == "both" ? (bearTouchFast or bearTouchSlow) : bearTouchSlow

// ------------------------- Fractal Pivot -------------------------
bool upFlagDown = true
bool upFlagUp0 = true
bool upFlagUp1 = true
bool upFlagUp2 = true
bool upFlagUp3 = true
bool upFlagUp4 = true
for i = 1 to fractalPeriod
    upFlagDown := upFlagDown and high[fractalPeriod - i] < high[fractalPeriod]
    upFlagUp0 := upFlagUp0 and high[fractalPeriod + i] < high[fractalPeriod]
    upFlagUp1 := upFlagUp1 and high[fractalPeriod + 1] <= high[fractalPeriod] and high[fractalPeriod + i + 1] < high[fractalPeriod]
    upFlagUp2 := upFlagUp2 and high[fractalPeriod + 1] <= high[fractalPeriod] and high[fractalPeriod + 2] <= high[fractalPeriod] and high[fractalPeriod + i + 2] < high[fractalPeriod]
    upFlagUp3 := upFlagUp3 and high[fractalPeriod + 1] <= high[fractalPeriod] and high[fractalPeriod + 2] <= high[fractalPeriod] and high[fractalPeriod + 3] <= high[fractalPeriod] and high[fractalPeriod + i + 3] < high[fractalPeriod]
    upFlagUp4 := upFlagUp4 and high[fractalPeriod + 1] <= high[fractalPeriod] and high[fractalPeriod + 2] <= high[fractalPeriod] and high[fractalPeriod + 3] <= high[fractalPeriod] and high[fractalPeriod + 4] <= high[fractalPeriod] and high[fractalPeriod + i + 4] < high[fractalPeriod]
bool upFractal = upFlagDown and (upFlagUp0 or upFlagUp1 or upFlagUp2 or upFlagUp3 or upFlagUp4)

bool dnFlagDown = true
bool dnFlagUp0 = true
bool dnFlagUp1 = true
bool dnFlagUp2 = true
bool dnFlagUp3 = true
bool dnFlagUp4 = true
for i = 1 to fractalPeriod
    dnFlagDown := dnFlagDown and low[fractalPeriod - i] > low[fractalPeriod]
    dnFlagUp0 := dnFlagUp0 and low[fractalPeriod + i] > low[fractalPeriod]
    dnFlagUp1 := dnFlagUp1 and low[fractalPeriod + 1] >= low[fractalPeriod] and low[fractalPeriod + i + 1] > low[fractalPeriod]
    dnFlagUp2 := dnFlagUp2 and low[fractalPeriod + 1] >= low[fractalPeriod] and low[fractalPeriod + 2] >= low[fractalPeriod] and low[fractalPeriod + i + 2] > low[fractalPeriod]
    dnFlagUp3 := dnFlagUp3 and low[fractalPeriod + 1] >= low[fractalPeriod] and low[fractalPeriod + 2] >= low[fractalPeriod] and low[fractalPeriod + 3] >= low[fractalPeriod] and low[fractalPeriod + i + 3] > low[fractalPeriod]
    dnFlagUp4 := dnFlagUp4 and low[fractalPeriod + 1] >= low[fractalPeriod] and low[fractalPeriod + 2] >= low[fractalPeriod] and low[fractalPeriod + 3] >= low[fractalPeriod] and low[fractalPeriod + 4] >= low[fractalPeriod] and low[fractalPeriod + i + 4] > low[fractalPeriod]
bool downFractal = dnFlagDown and (dnFlagUp0 or dnFlagUp1 or dnFlagUp2 or dnFlagUp3 or dnFlagUp4)
float upperDonch = ta.highest(high, donchianPeriod)
float lowerDonch = ta.lowest(low, donchianPeriod)
float baseline = (upperDonch + lowerDonch) / 2.0
bool fractalBear = upFractal and high[fractalPeriod] > baseline[fractalPeriod]
bool fractalBull = downFractal and low[fractalPeriod] < baseline[fractalPeriod]

// ------------------------- SD Channel -------------------------
float sdReg = ta.linreg(close, sdLength, 0)
float sdStdDev = ta.stdev(close, sdLength)
float sdSignalMult = bandMult(sdSignalBand, sdMult1, sdMult2, sdMult3, sdMult4)
float sdFilterMult = bandMult(sdFilterBand, sdMult1, sdMult2, sdMult3, sdMult4)
float sdSignalUpper = sdReg + sdSignalMult * sdStdDev
float sdSignalLower = sdReg - sdSignalMult * sdStdDev
bool rawSdLower = not na(sdSignalLower) and low <= sdSignalLower
bool rawSdUpper = not na(sdSignalUpper) and high >= sdSignalUpper
bool sdLower = rawSdLower and not (rawSdLower[1] == true)
bool sdUpper = rawSdUpper and not (rawSdUpper[1] == true)
float sdFilterUpper = sdReg + sdFilterMult * sdStdDev
float sdFilterLower = sdReg - sdFilterMult * sdStdDev
int sdZone = close > sdFilterUpper ? 1 : close < sdFilterLower ? -1 : 0
float rtSlope = sdReg - ta.linreg(close, sdLength, 1)
int sdTrend = rtSlope > 0.0 ? 1 : rtSlope < 0.0 ? -1 : 0

// ------------------------- DTP -------------------------
var float dtpAtrState = na
dtpAtrState := na(dtpAtrState) ? trValue : (dtpAtrState * (dtpAtrLength - 1) + trValue) / dtpAtrLength
float dtpAvg = ta.sma(close, dtpSmaLength)
float dtpBandMult = bandMult(dtpSignalBand, dtpMult1, dtpMult2, dtpMult3, dtpMult4)
bool dtpMrBull = not na(dtpAvg) and low <= dtpAvg - dtpBandMult * dtpAtrState
bool dtpMrBear = not na(dtpAvg) and high >= dtpAvg + dtpBandMult * dtpAtrState
float dtpAvgDiff = not na(dtpAvg) ? (not na(dtpAvg[dtpMomentumLookback]) ? dtpAvg - dtpAvg[dtpMomentumLookback] : 0.0) : na
float dtpDenom = ta.highest(dtpAvgDiff, 500)
float dtpNorm = not na(dtpAvgDiff) and not na(dtpDenom) and math.abs(dtpDenom) > 1e-12 ? dtpAvgDiff / dtpDenom : 0.0
var bool dtpTrend = false
var bool dtpTrendInit = false
var float dtpPrevNorm = 0.0
var int dtpPrevDir = 0
var int dtpPhaseBars = 0
int dtpDir = 0
if not na(dtpAvg)
    bool dtpCrossOver = dtpPrevNorm <= dtpTrendThreshold and dtpNorm > dtpTrendThreshold
    bool dtpCrossUnder = dtpPrevNorm >= -dtpTrendThreshold and dtpNorm < -dtpTrendThreshold
    if dtpCrossOver and not dtpTrend
        dtpTrend := true
        dtpTrendInit := true
    if dtpCrossUnder and dtpTrend
        dtpTrend := false
        dtpTrendInit := true
    dtpPrevNorm := dtpNorm
    bool dtpBullDir = dtpTrendInit and dtpTrend and close > dtpAvg
    bool dtpBearDir = dtpTrendInit and not dtpTrend and close < dtpAvg
    dtpDir := dtpBullDir ? 1 : dtpBearDir ? -1 : 0
    if dtpDir != dtpPrevDir
        dtpPhaseBars := 0
    dtpPhaseBars += 1
    dtpPrevDir := dtpDir
bool dtpSdConfirms = (dtpDir == 1 and sdTrend == 1) or (dtpDir == -1 and sdTrend == -1)
string dtpPhase = dtpDir == 0 ? "neutral" : dtpPhaseBars <= dtpEarlyBars ? "early" : dtpPhaseBars > dtpMatureBars and dtpSdConfirms ? "mature" : dtpSdConfirms ? "confirmed" : "weakening"

// ------------------------- ATR + VWAP -------------------------
var int auditBarCount = 0
var float atrRaw = na
var float atrSeedSum = 0.0
auditBarCount += 1
atrSeedSum += trValue
if auditBarCount == 1
    atrRaw := trValue
else if auditBarCount <= atrLength
    atrRaw := atrSeedSum / auditBarCount
else
    atrRaw := atrSmoothing == "SMA" ? ta.sma(trValue, atrLength) : atrSmoothing == "EMA" ? (2.0 / (atrLength + 1.0)) * trValue + (1.0 - 2.0 / (atrLength + 1.0)) * atrRaw : atrSmoothing == "WMA" ? ta.wma(trValue, atrLength) : (atrRaw * (atrLength - 1) + trValue) / atrLength
float atr = atrRaw * atrMultiplier
float atrPct = close > 0.0 ? atrRaw / close * 100.0 : 0.0

var float vwapCumPv = 0.0
var float vwapCumVol = 0.0
var bool vwapStarted = false
var array<float> vwapHlc3Values = array.new_float()
if not vwapStarted or newUsDay
    vwapCumPv := 0.0
    vwapCumVol := 0.0
    array.clear(vwapHlc3Values)
    vwapStarted := true
float hlc3Value = (high + low + close) / 3.0
vwapCumPv += hlc3Value * volume
vwapCumVol += volume
array.push(vwapHlc3Values, hlc3Value)
if array.size(vwapHlc3Values) > 20
    array.shift(vwapHlc3Values)
float vwapValue = vwapCumVol > 0.0 ? vwapCumPv / vwapCumVol : close
float vwapDev = arrayStdev(vwapHlc3Values, 20)
float vwapUpper1 = vwapValue + vwapDev
float vwapLower1 = vwapValue - vwapDev
float vwapUpper2 = vwapValue + 2.0 * vwapDev
float vwapLower2 = vwapValue - 2.0 * vwapDev
float vwapDist = vwapValue != 0.0 ? (close - vwapValue) / vwapValue * 100.0 : 0.0
bool vwapBullish = close > vwapValue

// ------------------------- cRSI -------------------------
int crsiCycleLen = math.max(1, int(crsiDomcycle / 2))
int crsiCyclicMemory = math.max(1, crsiDomcycle * 2)
float crsiTorque = 2.0 / (crsiVibration + 1.0)
int crsiPhasingLag = math.max(0, int(math.floor((crsiVibration - 1) / 2.0)))
float priceChange = na(close[1]) ? 0.0 : close - close[1]
float crsiUpVal = math.max(priceChange, 0.0)
float crsiDownVal = -math.min(priceChange, 0.0)
var float crsiRmaUp = 0.0
var float crsiRmaDown = 0.0
var float crsiUpSeed = 0.0
var float crsiDownSeed = 0.0
var int crsiSeedCount = 0
var bool crsiSeeded = false
var float crsiRaw = 0.0
var float crsi = 0.0
if na(close[1])
    crsiRaw := 0.0
    crsi := 0.0
else if not crsiSeeded
    crsiUpSeed += crsiUpVal
    crsiDownSeed += crsiDownVal
    crsiSeedCount += 1
    if crsiSeedCount >= crsiCycleLen
        crsiRmaUp := crsiUpSeed / crsiCycleLen
        crsiRmaDown := crsiDownSeed / crsiCycleLen
        crsiSeeded := true
        crsiRaw := crsiRmaDown == 0.0 ? 100.0 : crsiRmaUp == 0.0 ? 0.0 : 100.0 - 100.0 / (1.0 + crsiRmaUp / crsiRmaDown)
        float crsiLag = na(crsiRaw[crsiPhasingLag]) ? crsiRaw : crsiRaw[crsiPhasingLag]
        crsi := crsiTorque * (2.0 * crsiRaw - crsiLag) + (1.0 - crsiTorque) * nz(crsi[1], 0.0)
    else
        crsiRaw := 0.0
        crsi := 0.0
else
    crsiRmaUp := (crsiRmaUp * (crsiCycleLen - 1) + crsiUpVal) / crsiCycleLen
    crsiRmaDown := (crsiRmaDown * (crsiCycleLen - 1) + crsiDownVal) / crsiCycleLen
    crsiRaw := crsiRmaDown == 0.0 ? 100.0 : crsiRmaUp == 0.0 ? 0.0 : 100.0 - 100.0 / (1.0 + crsiRmaUp / crsiRmaDown)
    float crsiLag = na(crsiRaw[crsiPhasingLag]) ? crsiRaw : crsiRaw[crsiPhasingLag]
    crsi := crsiTorque * (2.0 * crsiRaw - crsiLag) + (1.0 - crsiTorque) * nz(crsi[1], 0.0)
float crsiUbRaw = ta.percentile_linear_interpolation(crsi, crsiCyclicMemory, 100.0 - crsiLeveling)
float crsiDbRaw = ta.percentile_linear_interpolation(crsi, crsiCyclicMemory, crsiLeveling)
float crsiUb = na(crsiUbRaw) ? 70.0 : crsiUbRaw
float crsiDb = na(crsiDbRaw) ? 30.0 : crsiDbRaw
bool crsiOb = crsi > crsiUb
bool crsiOs = crsi < crsiDb
string crsiState = crsiOb ? "overbought" : crsiOs ? "oversold" : "normal"

// ------------------------- OBV RSI -------------------------
var float obv = 0.0
if not na(close[1])
    obv += priceChange > 0.0 ? volume : priceChange < 0.0 ? -volume : 0.0
float obvChange = obv - nz(obv[1], 0.0)
float obvUpVal = math.max(obvChange, 0.0)
float obvDownVal = -math.min(obvChange, 0.0)
var float obvRmaUp = 0.0
var float obvRmaDown = 0.0
var float obvUpSeed = 0.0
var float obvDownSeed = 0.0
var int obvSeedCount = 0
var bool obvSeeded = false
float obvRsi = 50.0
if not na(close[1])
    if not obvSeeded
        obvUpSeed += obvUpVal
        obvDownSeed += obvDownVal
        obvSeedCount += 1
        if obvSeedCount >= obvRsiLen
            obvRmaUp := obvUpSeed / obvRsiLen
            obvRmaDown := obvDownSeed / obvRsiLen
            obvSeeded := true
    else
        obvRmaUp := (obvRmaUp * (obvRsiLen - 1) + obvUpVal) / obvRsiLen
        obvRmaDown := (obvRmaDown * (obvRsiLen - 1) + obvDownVal) / obvRsiLen
    if obvSeeded
        obvRsi := obvRmaDown == 0.0 ? 100.0 : obvRmaUp == 0.0 ? 0.0 : 100.0 - 100.0 / (1.0 + obvRmaUp / obvRmaDown)

// ------------------------- Divergence -------------------------
bool crsiRegBullDiv = false
bool crsiRegBearDiv = false
bool crsiRegHidBull = false
bool crsiRegHidBear = false
bool crsiWideBullDiv = false
bool crsiWideBearDiv = false
bool crsiWideHidBull = false
bool crsiWideHidBear = false
bool obvRegBullDiv = false
bool obvRegBearDiv = false
bool obvRegHidBull = false
bool obvRegHidBear = false
bool obvWideBullDiv = false
bool obvWideBearDiv = false
bool obvWideHidBull = false
bool obvWideHidBear = false

var float prevCrsiPhPrice = na
var float prevCrsiPhOsc = na
var int prevCrsiPhBar = na
var float prevCrsiPlPrice = na
var float prevCrsiPlOsc = na
var int prevCrsiPlBar = na
var float prevObvPhPrice = na
var float prevObvPhOsc = na
var int prevObvPhBar = na
var float prevObvPlPrice = na
var float prevObvPlOsc = na
var int prevObvPlBar = na

if emitDivergence
    int lb = crsiDivLookback
    int win = lb * 2 + 1
    float phPrice = ta.pivothigh(high, lb, lb)
    float plPrice = ta.pivotlow(low, lb, lb)
    float phOsc = ta.pivothigh(crsi, lb, lb)
    float plOsc = ta.pivotlow(crsi, lb, lb)
    float phOscWide = ta.highest(crsi, win)
    float plOscWide = ta.lowest(crsi, win)
    if not na(phPrice) and not na(phOsc)
        int curBar = bar_index - lb
        if not na(prevCrsiPhPrice) and not na(prevCrsiPhBar)
            int dist = curBar - prevCrsiPhBar
            if dist > 0 and dist <= crsiDivMaxBars
                crsiRegBearDiv := phPrice > prevCrsiPhPrice and phOsc < prevCrsiPhOsc
                crsiRegHidBear := phPrice < prevCrsiPhPrice and phOsc > prevCrsiPhOsc
    if not na(plPrice) and not na(plOsc)
        int curBar = bar_index - lb
        if not na(prevCrsiPlPrice) and not na(prevCrsiPlBar)
            int dist = curBar - prevCrsiPlBar
            if dist > 0 and dist <= crsiDivMaxBars
                crsiRegBullDiv := plPrice < prevCrsiPlPrice and plOsc > prevCrsiPlOsc
                crsiRegHidBull := plPrice > prevCrsiPlPrice and plOsc < prevCrsiPlOsc
    if not na(phPrice) and not na(phOscWide)
        int curBar = bar_index - lb
        if not na(prevCrsiPhPrice) and not na(prevCrsiPhBar)
            int dist = curBar - prevCrsiPhBar
            if dist > 0 and dist <= crsiDivMaxBars
                crsiWideBearDiv := phPrice > prevCrsiPhPrice and phOscWide < prevCrsiPhOsc
                crsiWideHidBear := phPrice < prevCrsiPhPrice and phOscWide > prevCrsiPhOsc
    if not na(plPrice) and not na(plOscWide)
        int curBar = bar_index - lb
        if not na(prevCrsiPlPrice) and not na(prevCrsiPlBar)
            int dist = curBar - prevCrsiPlBar
            if dist > 0 and dist <= crsiDivMaxBars
                crsiWideBullDiv := plPrice < prevCrsiPlPrice and plOscWide > prevCrsiPlOsc
                crsiWideHidBull := plPrice > prevCrsiPlPrice and plOscWide < prevCrsiPlOsc
    if not na(phPrice) and not na(phOsc)
        prevCrsiPhPrice := phPrice
        prevCrsiPhOsc := phOsc
        prevCrsiPhBar := bar_index - lb
    else if not na(phPrice) and not na(phOscWide)
        prevCrsiPhPrice := phPrice
        prevCrsiPhOsc := phOscWide
        prevCrsiPhBar := bar_index - lb
    if not na(plPrice) and not na(plOsc)
        prevCrsiPlPrice := plPrice
        prevCrsiPlOsc := plOsc
        prevCrsiPlBar := bar_index - lb
    else if not na(plPrice) and not na(plOscWide)
        prevCrsiPlPrice := plPrice
        prevCrsiPlOsc := plOscWide
        prevCrsiPlBar := bar_index - lb

    lb := obvDivLookback
    win := lb * 2 + 1
    phPrice := ta.pivothigh(high, lb, lb)
    plPrice := ta.pivotlow(low, lb, lb)
    phOsc := ta.pivothigh(obvRsi, lb, lb)
    plOsc := ta.pivotlow(obvRsi, lb, lb)
    phOscWide := ta.highest(obvRsi, win)
    plOscWide := ta.lowest(obvRsi, win)
    if not na(phPrice) and not na(phOsc)
        int curBar = bar_index - lb
        if not na(prevObvPhPrice) and not na(prevObvPhBar)
            int dist = curBar - prevObvPhBar
            if dist > 0 and dist <= obvDivMaxBars
                obvRegBearDiv := phPrice > prevObvPhPrice and phOsc < prevObvPhOsc
                obvRegHidBear := phPrice < prevObvPhPrice and phOsc > prevObvPhOsc
    if not na(plPrice) and not na(plOsc)
        int curBar = bar_index - lb
        if not na(prevObvPlPrice) and not na(prevObvPlBar)
            int dist = curBar - prevObvPlBar
            if dist > 0 and dist <= obvDivMaxBars
                obvRegBullDiv := plPrice < prevObvPlPrice and plOsc > prevObvPlOsc
                obvRegHidBull := plPrice > prevObvPlPrice and plOsc < prevObvPlOsc
    if not na(phPrice) and not na(phOscWide)
        int curBar = bar_index - lb
        if not na(prevObvPhPrice) and not na(prevObvPhBar)
            int dist = curBar - prevObvPhBar
            if dist > 0 and dist <= obvDivMaxBars
                obvWideBearDiv := phPrice > prevObvPhPrice and phOscWide < prevObvPhOsc
                obvWideHidBear := phPrice < prevObvPhPrice and phOscWide > prevObvPhOsc
    if not na(plPrice) and not na(plOscWide)
        int curBar = bar_index - lb
        if not na(prevObvPlPrice) and not na(prevObvPlBar)
            int dist = curBar - prevObvPlBar
            if dist > 0 and dist <= obvDivMaxBars
                obvWideBullDiv := plPrice < prevObvPlPrice and plOscWide > prevObvPlOsc
                obvWideHidBull := plPrice > prevObvPlPrice and plOscWide < prevObvPlOsc
    if not na(phPrice) and not na(phOsc)
        prevObvPhPrice := phPrice
        prevObvPhOsc := phOsc
        prevObvPhBar := bar_index - lb
    else if not na(phPrice) and not na(phOscWide)
        prevObvPhPrice := phPrice
        prevObvPhOsc := phOscWide
        prevObvPhBar := bar_index - lb
    if not na(plPrice) and not na(plOsc)
        prevObvPlPrice := plPrice
        prevObvPlOsc := plOsc
        prevObvPlBar := bar_index - lb
    else if not na(plPrice) and not na(plOscWide)
        prevObvPlPrice := plPrice
        prevObvPlOsc := plOscWide
        prevObvPlBar := bar_index - lb

if divType == "regular"
    crsiRegHidBull := false
    crsiRegHidBear := false
    crsiWideHidBull := false
    crsiWideHidBear := false
    obvRegHidBull := false
    obvRegHidBear := false
    obvWideHidBull := false
    obvWideHidBear := false
else if divType == "hidden"
    crsiRegBullDiv := false
    crsiRegBearDiv := false
    crsiWideBullDiv := false
    crsiWideBearDiv := false
    obvRegBullDiv := false
    obvRegBearDiv := false
    obvWideBullDiv := false
    obvWideBearDiv := false

bool crsiBullDiv = crsiRegBullDiv or crsiWideBullDiv
bool crsiBearDiv = crsiRegBearDiv or crsiWideBearDiv
bool crsiHidBull = crsiRegHidBull or crsiWideHidBull
bool crsiHidBear = crsiRegHidBear or crsiWideHidBear
bool obvBullDiv = obvRegBullDiv or obvWideBullDiv
bool obvBearDiv = obvRegBearDiv or obvWideBearDiv
bool obvHidBull = obvRegHidBull or obvWideHidBull
bool obvHidBear = obvRegHidBear or obvWideHidBear

// ------------------------- Alert payload -------------------------
if alertEnabled and confirmed
    string usTime = str.format_time(time, "yyyy-MM-dd HH:mm", "America/New_York")
    string cnTime = str.format_time(time, "yyyy-MM-dd HH:mm", "Asia/Shanghai")
    string payload = '{"type":"indicator_audit"' +
         ',"symbol":"' + syminfo.ticker + '"' +
         ',"exchange":"' + syminfo.prefix + '"' +
         ',"interval":"' + timeframe.period + '"' +
         ',"script_tag":"' + scriptTag + '"' +
         ',"environment":"' + dataEnvironment + '"' +
         ',"market_data_mode":"' + dataEnvironment + '"' +
         ',"us_time":"' + usTime + '"' +
         ',"cn_time":"' + cnTime + '"' +
         ',"bar_time_ms":' + str.tostring(time, "#") +
         ',"bar_open_ms":' + str.tostring(time, "#") +
         ',"bar_close_ms":' + (na(time_close) ? "null" : str.tostring(time_close, "#")) +
         ',"pine_eval_ms":' + (na(timenow) ? "null" : str.tostring(timenow, "#")) +
         ',"bar_index":' + str.tostring(bar_index, "#") +
         ',"extra":{' +
              '"open":' + jsonFloat(open, "#.####") +
              ',"high":' + jsonFloat(high, "#.####") +
              ',"low":' + jsonFloat(low, "#.####") +
              ',"close":' + jsonFloat(close, "#.####") +
              ',"volume":' + str.tostring(volume, "#") +
              ',"session_type":"' + sessionType + '"' +
              ',"day_change_pct":' + jsonFloat(dayChangePct, "#.####") +
              ',"prev_close_change_pct":' + jsonFloat(prevCloseChangePct, "#.####") +
              ',"change_7d":' + jsonFloat(change7d, "#.####") +
              ',"vwap":' + jsonFloat(vwapValue, "#.####") +
              ',"vwap_upper1":' + jsonFloat(vwapUpper1, "#.####") +
              ',"vwap_lower1":' + jsonFloat(vwapLower1, "#.####") +
              ',"vwap_upper2":' + jsonFloat(vwapUpper2, "#.####") +
              ',"vwap_lower2":' + jsonFloat(vwapLower2, "#.####") +
              ',"vwap_dist":' + jsonFloat(vwapDist, "#.####") +
              ',"vwap_bullish":' + jsonBool(vwapBullish) +
              ',"ema_fast":' + jsonFloat(emaFast, "#.####") +
              ',"ema_slow":' + jsonFloat(emaSlow, "#.####") +
              ',"ema_trend":' + jsonFloat(emaTrend, "#.####") +
              ',"ema_longest":' + jsonFloat(emaLongest, "#.####") +
              ',"slope_slow":' + jsonFloat(slopeSlow, "#.####") +
              ',"slope_trend":' + jsonFloat(slopeTrend, "#.####") +
              ',"slope_longest":' + jsonFloat(slopeLongest, "#.####") +
              ',"ema_bullish":' + jsonBool(emaBullish) +
              ',"ema_bearish":' + jsonBool(emaBearish) +
              ',"trend_dir":' + str.tostring(trendDir, "#") +
              ',"ema_bull_touch":' + jsonBool(emaBullTouch) +
              ',"ema_bear_touch":' + jsonBool(emaBearTouch) +
              ',"fractal_bull":' + jsonBool(fractalBull) +
              ',"fractal_bear":' + jsonBool(fractalBear) +
              ',"sd_reg":' + jsonFloat(sdReg, "#.####") +
              ',"sd_std_dev":' + jsonFloat(sdStdDev, "#.####") +
              ',"sd_upper":' + jsonBool(sdUpper) +
              ',"sd_lower":' + jsonBool(sdLower) +
              ',"sd_zone":' + str.tostring(sdZone, "#") +
              ',"sd_trend":' + str.tostring(sdTrend, "#") +
              ',"dtp_avg":' + jsonFloat(dtpAvg, "#.####") +
              ',"dtp_atr":' + jsonFloat(dtpAtrState, "#.####") +
              ',"dtp_dir":' + str.tostring(dtpDir, "#") +
              ',"dtp_phase":"' + dtpPhase + '"' +
              ',"dtp_phase_bars":' + str.tostring(dtpPhaseBars, "#") +
              ',"atr":' + jsonFloat(atr, "#.####") +
              ',"atr_raw":' + jsonFloat(atrRaw, "#.####") +
              ',"atr_pct":' + jsonFloat(atrPct, "#.####") +
              ',"crsi":' + jsonFloat(crsi, "#.####") +
              ',"crsi_ub":' + jsonFloat(crsiUb, "#.####") +
              ',"crsi_db":' + jsonFloat(crsiDb, "#.####") +
              ',"crsi_ob":' + jsonBool(crsiOb) +
              ',"crsi_os":' + jsonBool(crsiOs) +
              ',"crsi_state":"' + crsiState + '"' +
              ',"obv_rsi":' + jsonFloat(obvRsi, "#.####") +
              ',"crsi_bull_div":' + jsonBool(crsiBullDiv) +
              ',"crsi_bear_div":' + jsonBool(crsiBearDiv) +
              ',"crsi_hid_bull":' + jsonBool(crsiHidBull) +
              ',"crsi_hid_bear":' + jsonBool(crsiHidBear) +
              ',"obv_bull_div":' + jsonBool(obvBullDiv) +
              ',"obv_bear_div":' + jsonBool(obvBearDiv) +
              ',"obv_hid_bull":' + jsonBool(obvHidBull) +
              ',"obv_hid_bear":' + jsonBool(obvHidBear) +
              '}}'
    alert(payload, alert.freq_once_per_bar_close)

plot(vwapValue, title="audit_vwap_hidden", display=display.none)
