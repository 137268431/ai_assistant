if confirmed and volumeAttackUp
    lastVolumeAttackUpBar := bar_index
    lastAttackUpVolume := barVolume
if confirmed and volumeAttackDown
    lastVolumeAttackDownBar := bar_index
    lastAttackDownVolume := barVolume

if confirmed and inReferenceSession
    float prevSessionHigh = todayHigh
    float prevSessionLow = todayLow
    bool newSessionHigh = na(todayHigh) or high > todayHigh
    bool newSessionLow = na(todayLow) or low < todayLow
    if newSessionHigh
        todayHigh := high
        todayHighBar := bar_index
        lowBeforeTodayHigh := na(prevSessionLow) ? low : prevSessionLow
    if newSessionLow
        todayLow := low
        todayLowBar := bar_index
        highBeforeTodayLow := na(prevSessionHigh) ? high : prevSessionHigh
    bool sameClusterHighLift = newSessionHigh and not upperBreakAcceptedRegime and not na(todayStructHigh) and confirmed and todayHigh > todayStructHigh + tickBuffer
    if sameClusterHighLift
        float highBand = atr * structureClusterBandAtr
        float oldStructHigh = todayStructHigh
        bool highFarEnough = math.abs(todayHigh - oldStructHigh) >= atr * minStructureSeparationAtr
        bool highMiddleSwingOk = not na(lowSinceStructHigh) and oldStructHigh - lowSinceStructHigh >= atr * minMiddleSwingAtr
        bool highIndependent = highFarEnough and highMiddleSwingOk
        breakoutHighZoneHigh := na(breakoutHighZoneHigh) ? todayStructHighZoneHigh : breakoutHighZoneHigh
        if highIndependent
            prevStructHigh := oldStructHigh
            breakoutHighZoneHigh := todayHigh + highBand
            topBreakAcceptStreak := 0
            upperBreakAcceptedRegime := false
            lastTopSweepBar := na
            lastTopSweepPrice := na
            lastTopSweepVolumeAttack := false
            lastWeakNewHighBar := na
            lastWeakNewHighLow := na
            lastWeakNewHighHigh := na
            lastTopVolumeClimaxBar := na
            lastTopVolumeClimaxHigh := na
            lastTopVolumeClimaxLow := na
            lastTopVolumeClimaxBase := na
            lastTopVolumeClimaxVolumeRatio := na
            lastTopVolumeClimaxClose := na
        todayStructHigh := todayHigh
        todayStructHighBar := todayHighBar
        todayStructHighZoneLow := todayHigh - highBand
        todayStructHighZoneHigh := todayHigh + highBand
        lowBeforeStructHigh := highIndependent or na(lowBeforeStructHigh) ? (na(lowBeforeTodayHigh) ? low : lowBeforeTodayHigh) : lowBeforeStructHigh
        lowSinceStructHigh := low
        lowSinceStructHighBar := bar_index
        topExhaustionUsed := false
        topDecayStreak := 0
        lastTopFailureWatchBar := bar_index
        lastTopFailureWatchHigh := high
        lastTopFailureWatchLow := low
        lastTopFailureWatchBase := todayStructHigh
        lastTopFailureWatchBodyMid := (open + close) * 0.5
        lastTopFailureWatchClose := close
        lastTopFailureWatchVolumeProbe := volumeAttackUp or (volumeRatio >= highAttackVolumeMult and close >= open)
        topNoDemandStreak := 0
        lastTopNoDemandBar := na
        lastTopNoDemandHigh := na
        lastTopNoDemandLow := na
        lastProcessedHighCandidateBar := todayHighBar
    bool sameClusterLowLift = newSessionLow and not lowerBreakAcceptedRegime and not na(todayStructLow) and confirmed and todayLow < todayStructLow - tickBuffer
    if sameClusterLowLift
        float lowBand = atr * structureClusterBandAtr
        float oldStructLow = todayStructLow
        bool lowFarEnough = math.abs(todayLow - oldStructLow) >= atr * minStructureSeparationAtr
        bool lowMiddleSwingOk = not na(highSinceStructLow) and highSinceStructLow - oldStructLow >= atr * minMiddleSwingAtr
        bool lowIndependent = lowFarEnough and lowMiddleSwingOk
        breakoutLowZoneLow := na(breakoutLowZoneLow) ? todayStructLowZoneLow : breakoutLowZoneLow
        if lowIndependent
            prevStructLow := oldStructLow
            breakoutLowZoneLow := todayLow - lowBand
            bottomBreakAcceptStreak := 0
            lowerBreakAcceptedRegime := false
            lastBottomSweepBar := na
            lastBottomSweepPrice := na
            lastBottomSweepVolumeAttack := false
            lastWeakNewLowBar := na
            lastWeakNewLowHigh := na
            lastWeakNewLowLow := na
        todayStructLow := todayLow
        todayStructLowBar := todayLowBar
        todayStructLowZoneLow := todayLow - lowBand
        todayStructLowZoneHigh := todayLow + lowBand
        highBeforeStructLow := lowIndependent or na(highBeforeStructLow) ? (na(highBeforeTodayLow) ? high : highBeforeTodayLow) : highBeforeStructLow
        highSinceStructLow := high
        highSinceStructLowBar := bar_index
        bottomExhaustionUsed := false
        bottomDecayStreak := 0
        lastBottomFailureWatchBar := bar_index
        lastBottomFailureWatchHigh := high
        lastBottomFailureWatchLow := low
        lastBottomFailureWatchBase := todayStructLow
        lastBottomFailureWatchBodyMid := (open + close) * 0.5
        lastBottomFailureWatchClose := close
        lastBottomFailureWatchVolumeProbe := volumeAttackDown or (volumeRatio >= highAttackVolumeMult and close <= open)
        bottomNoSupplyStreak := 0
        lastBottomNoSupplyBar := na
        lastBottomNoSupplyHigh := na
        lastBottomNoSupplyLow := na
        lastProcessedLowCandidateBar := todayLowBar
    bool highConfirmed = not na(todayHighBar) and bar_index - todayHighBar >= dayStructConfirmBars and todayHigh - low >= atr * dayStructMinReversalAtr
    if highConfirmed and (na(lastProcessedHighCandidateBar) or todayHighBar != lastProcessedHighCandidateBar)
        float highBand = atr * structureClusterBandAtr
        bool highHasAnchor = not na(todayStructHigh)
        bool highFarEnough = not highHasAnchor or math.abs(todayHigh - todayStructHigh) >= atr * minStructureSeparationAtr
        bool highMiddleSwingOk = not highHasAnchor or not na(lowSinceStructHigh) and todayStructHigh - lowSinceStructHigh >= atr * minMiddleSwingAtr
        bool highMovesAnchor = not highHasAnchor or confirmed and todayHigh > todayStructHigh + tickBuffer
        bool highIndependent = not highHasAnchor or highFarEnough and highMiddleSwingOk
        if highMovesAnchor and highIndependent
            prevStructHigh := todayStructHigh
            todayStructHigh := todayHigh
            todayStructHighBar := todayHighBar
            todayStructHighZoneLow := todayHigh - highBand
            todayStructHighZoneHigh := todayHigh + highBand
            breakoutHighZoneHigh := todayStructHighZoneHigh
            lowBeforeStructHigh := na(lowBeforeTodayHigh) ? low : lowBeforeTodayHigh
            lowSinceStructHigh := low
            lowSinceStructHighBar := bar_index
            topExhaustionUsed := false
            topBreakAcceptStreak := 0
            topDecayStreak := 0
            upperBreakAcceptedRegime := false
            lastTopSweepBar := na
            lastTopSweepPrice := na
            lastTopSweepVolumeAttack := false
            lastWeakNewHighBar := na
            lastWeakNewHighLow := na
            lastWeakNewHighHigh := na
            lastTopVolumeClimaxBar := na
            lastTopVolumeClimaxHigh := na
            lastTopVolumeClimaxLow := na
            lastTopVolumeClimaxBase := na
            lastTopVolumeClimaxVolumeRatio := na
            lastTopVolumeClimaxClose := na
            lastTopFailureWatchBar := na
            lastTopFailureWatchClose := na
            lastTopFailureWatchVolumeProbe := false
            topProbeCycleActive := false
            topProbeCycleConsumed := false
            topProbeCycleTouchBar := na
            topPullbackArmed := false
            topPullbackArmedBar := na
            topNoDemandStreak := 0
            lastTopNoDemandBar := na
            lastTopNoDemandHigh := na
            lastTopNoDemandLow := na
        else if highMovesAnchor
            breakoutHighZoneHigh := na(breakoutHighZoneHigh) ? todayStructHighZoneHigh : breakoutHighZoneHigh
            todayStructHigh := todayHigh
            todayStructHighBar := todayHighBar
            todayStructHighZoneLow := todayHigh - highBand
            todayStructHighZoneHigh := todayHigh + highBand
            lowBeforeStructHigh := na(lowBeforeStructHigh) ? (na(lowBeforeTodayHigh) ? low : lowBeforeTodayHigh) : lowBeforeStructHigh
            lowSinceStructHigh := low
            lowSinceStructHighBar := bar_index
            topExhaustionUsed := false
            topDecayStreak := 0
        lastProcessedHighCandidateBar := todayHighBar
    bool lowConfirmed = not na(todayLowBar) and bar_index - todayLowBar >= dayStructConfirmBars and high - todayLow >= atr * dayStructMinReversalAtr
    if lowConfirmed and (na(lastProcessedLowCandidateBar) or todayLowBar != lastProcessedLowCandidateBar)
        float lowBand = atr * structureClusterBandAtr
        bool lowHasAnchor = not na(todayStructLow)
        bool lowFarEnough = not lowHasAnchor or math.abs(todayLow - todayStructLow) >= atr * minStructureSeparationAtr
        bool lowMiddleSwingOk = not lowHasAnchor or not na(highSinceStructLow) and highSinceStructLow - todayStructLow >= atr * minMiddleSwingAtr
        bool lowMovesAnchor = not lowHasAnchor or confirmed and todayLow < todayStructLow - tickBuffer
        bool lowIndependent = not lowHasAnchor or lowFarEnough and lowMiddleSwingOk
        if lowMovesAnchor and lowIndependent
            prevStructLow := todayStructLow
            todayStructLow := todayLow
            todayStructLowBar := todayLowBar
            todayStructLowZoneLow := todayLow - lowBand
            todayStructLowZoneHigh := todayLow + lowBand
            breakoutLowZoneLow := todayStructLowZoneLow
            highBeforeStructLow := na(highBeforeTodayLow) ? high : highBeforeTodayLow
            highSinceStructLow := high
            highSinceStructLowBar := bar_index
            bottomExhaustionUsed := false
            bottomBreakAcceptStreak := 0
            bottomDecayStreak := 0
            lowerBreakAcceptedRegime := false
            lastBottomSweepBar := na
            lastBottomSweepPrice := na
            lastBottomSweepVolumeAttack := false
            lastWeakNewLowBar := na
            lastWeakNewLowHigh := na
            lastWeakNewLowLow := na
            lastBottomFailureWatchBar := na
            lastBottomFailureWatchClose := na
            lastBottomFailureWatchVolumeProbe := false
            bottomProbeCycleActive := false
            bottomProbeCycleConsumed := false
            bottomProbeCycleTouchBar := na
            bottomPullbackArmed := false
            bottomPullbackArmedBar := na
            bottomNoSupplyStreak := 0
            lastBottomNoSupplyBar := na
            lastBottomNoSupplyHigh := na
            lastBottomNoSupplyLow := na
        else if lowMovesAnchor
            breakoutLowZoneLow := na(breakoutLowZoneLow) ? todayStructLowZoneLow : breakoutLowZoneLow
            todayStructLow := todayLow
            todayStructLowBar := todayLowBar
            todayStructLowZoneLow := todayLow - lowBand
            todayStructLowZoneHigh := todayLow + lowBand
            highBeforeStructLow := na(highBeforeStructLow) ? (na(highBeforeTodayLow) ? high : highBeforeTodayLow) : highBeforeStructLow
            highSinceStructLow := high
            highSinceStructLowBar := bar_index
            bottomExhaustionUsed := false
            bottomDecayStreak := 0
        lastProcessedLowCandidateBar := todayLowBar
    bool upperBreakAccepting = not na(breakoutHighZoneHigh) and not na(todayStructLow) and close > breakoutHighZoneHigh + atr * structureBreakAcceptCloseAtr
    topBreakAcceptStreak := upperBreakAccepting ? topBreakAcceptStreak + 1 : 0
    if topBreakAcceptStreak >= structureBreakAcceptBars and not na(todayHigh)
        float highBand = atr * structureClusterBandAtr
        prevStructHigh := todayStructHigh
        todayStructHigh := todayHigh
        todayStructHighBar := todayHighBar
        todayStructHighZoneLow := todayHigh - highBand
        todayStructHighZoneHigh := todayHigh + highBand
        breakoutHighZoneHigh := todayStructHighZoneHigh
        lowBeforeStructHigh := na(lowSinceStructHigh) ? (na(lowBeforeTodayHigh) ? low : lowBeforeTodayHigh) : lowSinceStructHigh
        lowSinceStructHigh := low
        lowSinceStructHighBar := bar_index
        topExhaustionUsed := false
        topBreakAcceptStreak := 0
        topDecayStreak := 0
        lastProcessedHighCandidateBar := todayHighBar
        lastVolumeAttackUpBar := na
        upperBreakAcceptedRegime := true
        lowerBreakAcceptedRegime := false
        lastTopSweepBar := na
        lastTopSweepPrice := na
        lastTopSweepVolumeAttack := false
        lastWeakNewHighBar := na
        lastWeakNewHighLow := na
        lastWeakNewHighHigh := na
        lastTopVolumeClimaxBar := na
        lastTopVolumeClimaxHigh := na
        lastTopVolumeClimaxLow := na
        lastTopVolumeClimaxBase := na
        lastTopVolumeClimaxVolumeRatio := na
        lastTopVolumeClimaxClose := na
        lastTopFailureWatchBar := na
        lastTopFailureWatchClose := na
        lastTopFailureWatchVolumeProbe := false
        topProbeCycleActive := false
        topProbeCycleConsumed := false
        topProbeCycleTouchBar := na
        topPullbackArmed := false
        topPullbackArmedBar := na
        topNoDemandStreak := 0
        lastTopNoDemandBar := na
        lastTopNoDemandHigh := na
        lastTopNoDemandLow := na
        upperStructureBreakAccepted := true
    bool lowerBreakAccepting = not na(breakoutLowZoneLow) and not na(todayStructHigh) and close < breakoutLowZoneLow - atr * structureBreakAcceptCloseAtr
    bottomBreakAcceptStreak := lowerBreakAccepting ? bottomBreakAcceptStreak + 1 : 0
    if bottomBreakAcceptStreak >= structureBreakAcceptBars and not na(todayLow)
        float lowBand = atr * structureClusterBandAtr
        prevStructLow := todayStructLow
        todayStructLow := todayLow
        todayStructLowBar := todayLowBar
        todayStructLowZoneLow := todayLow - lowBand
        todayStructLowZoneHigh := todayLow + lowBand
        breakoutLowZoneLow := todayStructLowZoneLow
        highBeforeStructLow := na(highSinceStructLow) ? (na(highBeforeTodayLow) ? high : highBeforeTodayLow) : highSinceStructLow
        highSinceStructLow := high
        highSinceStructLowBar := bar_index
        bottomExhaustionUsed := false
        bottomBreakAcceptStreak := 0
        bottomDecayStreak := 0
        lastProcessedLowCandidateBar := todayLowBar
        lastVolumeAttackDownBar := na
        lowerBreakAcceptedRegime := true
        upperBreakAcceptedRegime := false
        lastBottomSweepBar := na
        lastBottomSweepPrice := na
        lastBottomSweepVolumeAttack := false
        lastWeakNewLowBar := na
        lastWeakNewLowHigh := na
        lastWeakNewLowLow := na
        lastBottomFailureWatchBar := na
        lastBottomFailureWatchClose := na
        lastBottomFailureWatchVolumeProbe := false
        bottomProbeCycleActive := false
        bottomProbeCycleConsumed := false
        bottomProbeCycleTouchBar := na
        bottomPullbackArmed := false
        bottomPullbackArmedBar := na
        bottomNoSupplyStreak := 0
        lastBottomNoSupplyBar := na
        lastBottomNoSupplyHigh := na
        lastBottomNoSupplyLow := na
        lowerStructureBreakAccepted := true
    bool upperBreakExt = upperBreakAcceptedRegime and not na(todayStructHigh) and not na(todayHigh) and todayHigh > todayStructHigh and todayHighBar != todayStructHighBar
    if upperBreakExt
        float highBand = atr * structureClusterBandAtr
        todayStructHigh := todayHigh
        todayStructHighBar := todayHighBar
        todayStructHighZoneLow := todayHigh - highBand
        todayStructHighZoneHigh := todayHigh + highBand
        breakoutHighZoneHigh := todayStructHighZoneHigh
        lowSinceStructHigh := low
        lowSinceStructHighBar := bar_index
        topExhaustionUsed := false
        topDecayStreak := 0
        lastProcessedHighCandidateBar := todayHighBar
        lastTopSweepBar := na
        lastTopSweepPrice := na
        lastTopSweepVolumeAttack := false
        lastWeakNewHighBar := na
        lastWeakNewHighLow := na
        lastWeakNewHighHigh := na
        lastTopVolumeClimaxBar := na
        lastTopVolumeClimaxHigh := na
        lastTopVolumeClimaxLow := na
        lastTopVolumeClimaxBase := na
        lastTopVolumeClimaxVolumeRatio := na
        lastTopVolumeClimaxClose := na
    bool lowerBreakExt = lowerBreakAcceptedRegime and not na(todayStructLow) and not na(todayLow) and todayLow < todayStructLow and todayLowBar != todayStructLowBar
    if lowerBreakExt
        float lowBand = atr * structureClusterBandAtr
        todayStructLow := todayLow
        todayStructLowBar := todayLowBar
        todayStructLowZoneLow := todayLow - lowBand
        todayStructLowZoneHigh := todayLow + lowBand
        breakoutLowZoneLow := todayStructLowZoneLow
        highSinceStructLow := high
        highSinceStructLowBar := bar_index
        bottomExhaustionUsed := false
        bottomDecayStreak := 0
        lastProcessedLowCandidateBar := todayLowBar
        lastBottomSweepBar := na
        lastBottomSweepPrice := na
        lastBottomSweepVolumeAttack := false
        lastWeakNewLowBar := na
        lastWeakNewLowHigh := na
        lastWeakNewLowLow := na
    if not na(todayStructHigh) and (na(lowSinceStructHigh) or low < lowSinceStructHigh)
        lowSinceStructHigh := low
        lowSinceStructHighBar := bar_index
    if not na(todayStructLow) and (na(highSinceStructLow) or high > highSinceStructLow)
        highSinceStructLow := high
        highSinceStructLowBar := bar_index

float barsSinceAttackUp = not na(lastVolumeAttackUpBar) ? (bar_index - lastVolumeAttackUpBar) * 1.0 : na
float barsSinceAttackDown = not na(lastVolumeAttackDownBar) ? (bar_index - lastVolumeAttackDownBar) * 1.0 : na
bool attackUpCooling = not na(barsSinceAttackUp) and barsSinceAttackUp <= attackVolumeCooldownBars
bool attackDownCooling = not na(barsSinceAttackDown) and barsSinceAttackDown <= attackVolumeCooldownBars

bool trendHasHH = not na(todayStructHigh) and not na(prevStructHigh) and todayStructHigh > prevStructHigh + atr * trendMinSwingMoveAtr
bool trendHasHL = not na(todayStructLow) and not na(prevStructLow) and todayStructLow > prevStructLow + atr * trendMinSwingMoveAtr
bool trendHasLL = not na(todayStructLow) and not na(prevStructLow) and todayStructLow < prevStructLow - atr * trendMinSwingMoveAtr
bool trendHasLH = not na(todayStructHigh) and not na(prevStructHigh) and todayStructHigh < prevStructHigh - atr * trendMinSwingMoveAtr
bool dayRangeFormed = not na(todayStructHigh) and not na(todayStructLow)
float dayRangeAtr = dayRangeFormed and atr > 0.0 ? math.abs(todayStructHigh - todayStructLow) / atr : na
float dayRangeMid = dayRangeFormed ? (todayStructHigh + todayStructLow) / 2.0 : na
bool dayRangeClear = dayRangeFormed and dayRangeAtr >= minClearDayRangeAtr
bool strongStructTrendLong = dtpBull and emaFast > emaMid and emaMid > emaSlow and close >= sdMid and trendHasHH and trendHasHL
bool strongStructTrendShort = dtpBear and emaFast < emaMid and emaMid < emaSlow and close <= sdMid and trendHasLL and trendHasLH
bool dominantTrendLong = dayRangeClear and dtpBull and close >= sdMid and close >= dayRangeMid and (na(todayStructLowZoneLow) or close > todayStructLowZoneLow)
bool dominantTrendShort = dayRangeClear and dtpBear and close <= sdMid and close <= dayRangeMid and (na(todayStructHighZoneHigh) or close < todayStructHighZoneHigh)
bool trendLongContext = strongStructTrendLong or dominantTrendLong
bool trendShortContext = strongStructTrendShort or dominantTrendShort
string marketRegime = modellib.marketRegime(dominantTrendLong, strongStructTrendLong, dominantTrendShort, strongStructTrendShort, dayRangeClear)
bool trendBullPriority = enableRegimePriority and marketRegime == "trend_bull"
bool trendBearPriority = enableRegimePriority and marketRegime == "trend_bear"
bool topCounterTrendAllowed = not (enableRegimePriority ? trendBullPriority : dominantTrendLong)
bool bottomCounterTrendAllowed = not (enableRegimePriority ? trendBearPriority : dominantTrendShort)
string trendRegime = dominantTrendLong ? "dominant_bull" : dominantTrendShort ? "dominant_bear" : strongStructTrendLong ? "strong_bull" : strongStructTrendShort ? "strong_bear" : "range"
string dominantTrendSide = dominantTrendLong ? "long" : dominantTrendShort ? "short" : "none"
float tolerance = atr * confluenceZoneAtr
float trendPullbackBand = atr * trendPullbackBandAtr
float trendClusterTolerance = math.max(tolerance, trendPullbackBand)

// Support cluster.
float supportBasis = levellib.nearestBelow(close, emaFast, emaMid, emaSlow, dtpAvg, sdMid, sdLower, recentLow, lastPivotLow)
int supportCount = 0
supportCount := levellib.addNearCount(supportCount, emaFast, supportBasis, tolerance)
supportCount := levellib.addNearCount(supportCount, emaMid, supportBasis, tolerance)
supportCount := levellib.addNearCount(supportCount, emaSlow, supportBasis, tolerance)
supportCount := levellib.addNearCount(supportCount, dtpAvg, supportBasis, tolerance)
supportCount := levellib.addNearCount(supportCount, sdMid, supportBasis, tolerance)
supportCount := levellib.addNearCount(supportCount, sdLower, supportBasis, tolerance)
supportCount := levellib.addNearCount(supportCount, recentLow, supportBasis, tolerance)
supportCount := levellib.addNearCount(supportCount, lastPivotLow, supportBasis, tolerance)
float supportZoneLow = na
supportZoneLow := levellib.minNear(supportZoneLow, emaFast, supportBasis, tolerance)
supportZoneLow := levellib.minNear(supportZoneLow, emaMid, supportBasis, tolerance)
supportZoneLow := levellib.minNear(supportZoneLow, emaSlow, supportBasis, tolerance)
supportZoneLow := levellib.minNear(supportZoneLow, dtpAvg, supportBasis, tolerance)
supportZoneLow := levellib.minNear(supportZoneLow, sdMid, supportBasis, tolerance)
supportZoneLow := levellib.minNear(supportZoneLow, sdLower, supportBasis, tolerance)
supportZoneLow := levellib.minNear(supportZoneLow, recentLow, supportBasis, tolerance)
supportZoneLow := levellib.minNear(supportZoneLow, lastPivotLow, supportBasis, tolerance)
float supportZoneHigh = na
supportZoneHigh := levellib.maxNear(supportZoneHigh, emaFast, supportBasis, tolerance)
supportZoneHigh := levellib.maxNear(supportZoneHigh, emaMid, supportBasis, tolerance)
supportZoneHigh := levellib.maxNear(supportZoneHigh, emaSlow, supportBasis, tolerance)
supportZoneHigh := levellib.maxNear(supportZoneHigh, dtpAvg, supportBasis, tolerance)
supportZoneHigh := levellib.maxNear(supportZoneHigh, sdMid, supportBasis, tolerance)
supportZoneHigh := levellib.maxNear(supportZoneHigh, sdLower, supportBasis, tolerance)
supportZoneHigh := levellib.maxNear(supportZoneHigh, recentLow, supportBasis, tolerance)
supportZoneHigh := levellib.maxNear(supportZoneHigh, lastPivotLow, supportBasis, tolerance)
string supportSources = ""
supportSources := levellib.appendNearSource(supportSources, emaFast, supportBasis, tolerance, "ema20")
supportSources := levellib.appendNearSource(supportSources, emaMid, supportBasis, tolerance, "ema50")
supportSources := levellib.appendNearSource(supportSources, emaSlow, supportBasis, tolerance, "ema100")
supportSources := levellib.appendNearSource(supportSources, dtpAvg, supportBasis, tolerance, "dtp_avg")
supportSources := levellib.appendNearSource(supportSources, sdMid, supportBasis, tolerance, "sd_mid")
supportSources := levellib.appendNearSource(supportSources, sdLower, supportBasis, tolerance, "sd_lower")
supportSources := levellib.appendNearSource(supportSources, recentLow, supportBasis, tolerance, "recent_low")
supportSources := levellib.appendNearSource(supportSources, lastPivotLow, supportBasis, tolerance, "pivot_low")
bool strongSupport = supportCount >= minConfluenceCount and not na(supportZoneLow) and not na(supportZoneHigh)

// Resistance cluster.
float resistanceBasis = levellib.nearestAbove(close, emaFast, emaMid, emaSlow, dtpAvg, sdMid, sdUpper, recentHigh, lastPivotHigh)
int resistanceCount = 0
resistanceCount := levellib.addNearCount(resistanceCount, emaFast, resistanceBasis, tolerance)
resistanceCount := levellib.addNearCount(resistanceCount, emaMid, resistanceBasis, tolerance)
resistanceCount := levellib.addNearCount(resistanceCount, emaSlow, resistanceBasis, tolerance)
resistanceCount := levellib.addNearCount(resistanceCount, dtpAvg, resistanceBasis, tolerance)
resistanceCount := levellib.addNearCount(resistanceCount, sdMid, resistanceBasis, tolerance)
resistanceCount := levellib.addNearCount(resistanceCount, sdUpper, resistanceBasis, tolerance)
resistanceCount := levellib.addNearCount(resistanceCount, recentHigh, resistanceBasis, tolerance)
resistanceCount := levellib.addNearCount(resistanceCount, lastPivotHigh, resistanceBasis, tolerance)
float resistanceZoneLow = na
resistanceZoneLow := levellib.minNear(resistanceZoneLow, emaFast, resistanceBasis, tolerance)
resistanceZoneLow := levellib.minNear(resistanceZoneLow, emaMid, resistanceBasis, tolerance)
resistanceZoneLow := levellib.minNear(resistanceZoneLow, emaSlow, resistanceBasis, tolerance)
resistanceZoneLow := levellib.minNear(resistanceZoneLow, dtpAvg, resistanceBasis, tolerance)
resistanceZoneLow := levellib.minNear(resistanceZoneLow, sdMid, resistanceBasis, tolerance)
resistanceZoneLow := levellib.minNear(resistanceZoneLow, sdUpper, resistanceBasis, tolerance)
resistanceZoneLow := levellib.minNear(resistanceZoneLow, recentHigh, resistanceBasis, tolerance)
resistanceZoneLow := levellib.minNear(resistanceZoneLow, lastPivotHigh, resistanceBasis, tolerance)
float resistanceZoneHigh = na
resistanceZoneHigh := levellib.maxNear(resistanceZoneHigh, emaFast, resistanceBasis, tolerance)
resistanceZoneHigh := levellib.maxNear(resistanceZoneHigh, emaMid, resistanceBasis, tolerance)
resistanceZoneHigh := levellib.maxNear(resistanceZoneHigh, emaSlow, resistanceBasis, tolerance)
resistanceZoneHigh := levellib.maxNear(resistanceZoneHigh, dtpAvg, resistanceBasis, tolerance)
resistanceZoneHigh := levellib.maxNear(resistanceZoneHigh, sdMid, resistanceBasis, tolerance)
resistanceZoneHigh := levellib.maxNear(resistanceZoneHigh, sdUpper, resistanceBasis, tolerance)
resistanceZoneHigh := levellib.maxNear(resistanceZoneHigh, recentHigh, resistanceBasis, tolerance)
resistanceZoneHigh := levellib.maxNear(resistanceZoneHigh, lastPivotHigh, resistanceBasis, tolerance)
string resistanceSources = ""
resistanceSources := levellib.appendNearSource(resistanceSources, emaFast, resistanceBasis, tolerance, "ema20")
resistanceSources := levellib.appendNearSource(resistanceSources, emaMid, resistanceBasis, tolerance, "ema50")
resistanceSources := levellib.appendNearSource(resistanceSources, emaSlow, resistanceBasis, tolerance, "ema100")
resistanceSources := levellib.appendNearSource(resistanceSources, dtpAvg, resistanceBasis, tolerance, "dtp_avg")
resistanceSources := levellib.appendNearSource(resistanceSources, sdMid, resistanceBasis, tolerance, "sd_mid")
resistanceSources := levellib.appendNearSource(resistanceSources, sdUpper, resistanceBasis, tolerance, "sd_upper")
resistanceSources := levellib.appendNearSource(resistanceSources, recentHigh, resistanceBasis, tolerance, "recent_high")
resistanceSources := levellib.appendNearSource(resistanceSources, lastPivotHigh, resistanceBasis, tolerance, "pivot_high")
bool strongResistance = resistanceCount >= minConfluenceCount and not na(resistanceZoneLow) and not na(resistanceZoneHigh)

// -----------------------------------------------------------------------------
// Candidate plan generation
// -----------------------------------------------------------------------------
// Trend trades can use either the latest intraday structure or an EMA/DTP/SD pullback in the dominant direction.
float trendSupportStructureBasis = trendLongContext ? todayStructLow : na
float trendSupportPullbackBasis = trendLongContext ? levellib.nearestBelow(close + trendPullbackBand, emaFast, emaMid, dtpAvg, sdMid, emaSlow, sdLower, recentLow, lastPivotLow) : na
bool trendSupportPullbackTouch = trendLongContext and not na(trendSupportPullbackBasis) and low <= trendSupportPullbackBasis + trendPullbackBand and high >= trendSupportPullbackBasis - trendPullbackBand
bool trendSupportPullbackReject = trendSupportPullbackTouch and close >= trendSupportPullbackBasis and closePosition >= trendRejectClosePosLongMin
bool trendSupportUsesPullback = trendSupportPullbackReject
float trendSupportBasis = trendSupportUsesPullback ? trendSupportPullbackBasis : trendSupportStructureBasis
string trendSupportEntrySource = trendSupportUsesPullback ? (levellib.levelNear(emaFast, trendSupportBasis, trendClusterTolerance) ? "ema20" : levellib.levelNear(emaMid, trendSupportBasis, trendClusterTolerance) ? "ema50" : levellib.levelNear(dtpAvg, trendSupportBasis, trendClusterTolerance) ? "dtp" : levellib.levelNear(sdMid, trendSupportBasis, trendClusterTolerance) ? "sd_mid" : levellib.levelNear(emaSlow, trendSupportBasis, trendClusterTolerance) ? "ema100" : "pullback_cluster") : "structure_low"
int trendSupportCount = not na(trendSupportBasis) ? 1 : 0
trendSupportCount := levellib.addNearCount(trendSupportCount, emaFast, trendSupportBasis, trendClusterTolerance)
trendSupportCount := levellib.addNearCount(trendSupportCount, emaMid, trendSupportBasis, trendClusterTolerance)
trendSupportCount := levellib.addNearCount(trendSupportCount, emaSlow, trendSupportBasis, trendClusterTolerance)
trendSupportCount := levellib.addNearCount(trendSupportCount, dtpAvg, trendSupportBasis, trendClusterTolerance)
trendSupportCount := levellib.addNearCount(trendSupportCount, sdMid, trendSupportBasis, trendClusterTolerance)
trendSupportCount := levellib.addNearCount(trendSupportCount, sdLower, trendSupportBasis, trendClusterTolerance)
float trendSupportZoneLow = trendSupportBasis
trendSupportZoneLow := levellib.minNear(trendSupportZoneLow, emaFast, trendSupportBasis, trendClusterTolerance)
trendSupportZoneLow := levellib.minNear(trendSupportZoneLow, emaMid, trendSupportBasis, trendClusterTolerance)
trendSupportZoneLow := levellib.minNear(trendSupportZoneLow, emaSlow, trendSupportBasis, trendClusterTolerance)
trendSupportZoneLow := levellib.minNear(trendSupportZoneLow, dtpAvg, trendSupportBasis, trendClusterTolerance)
trendSupportZoneLow := levellib.minNear(trendSupportZoneLow, sdMid, trendSupportBasis, trendClusterTolerance)
trendSupportZoneLow := levellib.minNear(trendSupportZoneLow, sdLower, trendSupportBasis, trendClusterTolerance)
float trendSupportZoneHigh = trendSupportBasis
trendSupportZoneHigh := levellib.maxNear(trendSupportZoneHigh, emaFast, trendSupportBasis, trendClusterTolerance)
trendSupportZoneHigh := levellib.maxNear(trendSupportZoneHigh, emaMid, trendSupportBasis, trendClusterTolerance)
trendSupportZoneHigh := levellib.maxNear(trendSupportZoneHigh, emaSlow, trendSupportBasis, trendClusterTolerance)
trendSupportZoneHigh := levellib.maxNear(trendSupportZoneHigh, dtpAvg, trendSupportBasis, trendClusterTolerance)
trendSupportZoneHigh := levellib.maxNear(trendSupportZoneHigh, sdMid, trendSupportBasis, trendClusterTolerance)
trendSupportZoneHigh := levellib.maxNear(trendSupportZoneHigh, sdLower, trendSupportBasis, trendClusterTolerance)
string trendSupportSources = trendSupportUsesPullback ? trendSupportEntrySource : not na(trendSupportBasis) ? "today_HL" : ""
trendSupportSources := levellib.appendNearSource(trendSupportSources, emaFast, trendSupportBasis, trendClusterTolerance, "ema20")
trendSupportSources := levellib.appendNearSource(trendSupportSources, emaMid, trendSupportBasis, trendClusterTolerance, "ema50")
trendSupportSources := levellib.appendNearSource(trendSupportSources, emaSlow, trendSupportBasis, trendClusterTolerance, "ema100")
trendSupportSources := levellib.appendNearSource(trendSupportSources, dtpAvg, trendSupportBasis, trendClusterTolerance, "dtp_avg")
trendSupportSources := levellib.appendNearSource(trendSupportSources, sdMid, trendSupportBasis, trendClusterTolerance, "sd_mid")
trendSupportSources := levellib.appendNearSource(trendSupportSources, sdLower, trendSupportBasis, trendClusterTolerance, "sd_lower")
int trendSupportAgeBars = trendSupportUsesPullback ? minTrendSupportAgeBars : not na(todayStructLowBar) ? bar_index - todayStructLowBar : 0
bool strongTrendSupport = trendLongContext and dayRangeClear and trendSupportAgeBars >= minTrendSupportAgeBars and not na(trendSupportZoneLow) and not na(trendSupportZoneHigh)

float trendResistanceStructureBasis = trendShortContext ? todayStructHigh : na
float trendResistancePullbackBasis = trendShortContext ? levellib.nearestAbove(close - trendPullbackBand, emaFast, emaMid, dtpAvg, sdMid, emaSlow, sdUpper, recentHigh, lastPivotHigh) : na
bool trendResistancePullbackTouch = trendShortContext and not na(trendResistancePullbackBasis) and high >= trendResistancePullbackBasis - trendPullbackBand and low <= trendResistancePullbackBasis + trendPullbackBand
bool trendResistancePullbackReject = trendResistancePullbackTouch and close <= trendResistancePullbackBasis and closePosition <= trendRejectClosePosShortMax
bool trendResistanceUsesPullback = trendResistancePullbackReject
float trendResistanceBasis = trendResistanceUsesPullback ? trendResistancePullbackBasis : trendResistanceStructureBasis
string trendResistanceEntrySource = trendResistanceUsesPullback ? (levellib.levelNear(emaFast, trendResistanceBasis, trendClusterTolerance) ? "ema20" : levellib.levelNear(emaMid, trendResistanceBasis, trendClusterTolerance) ? "ema50" : levellib.levelNear(dtpAvg, trendResistanceBasis, trendClusterTolerance) ? "dtp" : levellib.levelNear(sdMid, trendResistanceBasis, trendClusterTolerance) ? "sd_mid" : levellib.levelNear(emaSlow, trendResistanceBasis, trendClusterTolerance) ? "ema100" : "pullback_cluster") : "structure_high"
int trendResistanceCount = not na(trendResistanceBasis) ? 1 : 0
trendResistanceCount := levellib.addNearCount(trendResistanceCount, emaFast, trendResistanceBasis, trendClusterTolerance)
trendResistanceCount := levellib.addNearCount(trendResistanceCount, emaMid, trendResistanceBasis, trendClusterTolerance)
trendResistanceCount := levellib.addNearCount(trendResistanceCount, emaSlow, trendResistanceBasis, trendClusterTolerance)
trendResistanceCount := levellib.addNearCount(trendResistanceCount, dtpAvg, trendResistanceBasis, trendClusterTolerance)
trendResistanceCount := levellib.addNearCount(trendResistanceCount, sdMid, trendResistanceBasis, trendClusterTolerance)
trendResistanceCount := levellib.addNearCount(trendResistanceCount, sdUpper, trendResistanceBasis, trendClusterTolerance)
float trendResistanceZoneLow = trendResistanceBasis
trendResistanceZoneLow := levellib.minNear(trendResistanceZoneLow, emaFast, trendResistanceBasis, trendClusterTolerance)
trendResistanceZoneLow := levellib.minNear(trendResistanceZoneLow, emaMid, trendResistanceBasis, trendClusterTolerance)
trendResistanceZoneLow := levellib.minNear(trendResistanceZoneLow, emaSlow, trendResistanceBasis, trendClusterTolerance)
trendResistanceZoneLow := levellib.minNear(trendResistanceZoneLow, dtpAvg, trendResistanceBasis, trendClusterTolerance)
trendResistanceZoneLow := levellib.minNear(trendResistanceZoneLow, sdMid, trendResistanceBasis, trendClusterTolerance)
trendResistanceZoneLow := levellib.minNear(trendResistanceZoneLow, sdUpper, trendResistanceBasis, trendClusterTolerance)
float trendResistanceZoneHigh = trendResistanceBasis
trendResistanceZoneHigh := levellib.maxNear(trendResistanceZoneHigh, emaFast, trendResistanceBasis, trendClusterTolerance)
trendResistanceZoneHigh := levellib.maxNear(trendResistanceZoneHigh, emaMid, trendResistanceBasis, trendClusterTolerance)
trendResistanceZoneHigh := levellib.maxNear(trendResistanceZoneHigh, emaSlow, trendResistanceBasis, trendClusterTolerance)
trendResistanceZoneHigh := levellib.maxNear(trendResistanceZoneHigh, dtpAvg, trendResistanceBasis, trendClusterTolerance)
trendResistanceZoneHigh := levellib.maxNear(trendResistanceZoneHigh, sdMid, trendResistanceBasis, trendClusterTolerance)
trendResistanceZoneHigh := levellib.maxNear(trendResistanceZoneHigh, sdUpper, trendResistanceBasis, trendClusterTolerance)
string trendResistanceSources = trendResistanceUsesPullback ? trendResistanceEntrySource : not na(trendResistanceBasis) ? "today_LH" : ""
trendResistanceSources := levellib.appendNearSource(trendResistanceSources, emaFast, trendResistanceBasis, trendClusterTolerance, "ema20")
trendResistanceSources := levellib.appendNearSource(trendResistanceSources, emaMid, trendResistanceBasis, trendClusterTolerance, "ema50")
trendResistanceSources := levellib.appendNearSource(trendResistanceSources, emaSlow, trendResistanceBasis, trendClusterTolerance, "ema100")
trendResistanceSources := levellib.appendNearSource(trendResistanceSources, dtpAvg, trendResistanceBasis, trendClusterTolerance, "dtp_avg")
trendResistanceSources := levellib.appendNearSource(trendResistanceSources, sdMid, trendResistanceBasis, trendClusterTolerance, "sd_mid")
trendResistanceSources := levellib.appendNearSource(trendResistanceSources, sdUpper, trendResistanceBasis, trendClusterTolerance, "sd_upper")
int trendResistanceAgeBars = trendResistanceUsesPullback ? minTrendSupportAgeBars : not na(todayStructHighBar) ? bar_index - todayStructHighBar : 0
bool strongTrendResistance = trendShortContext and dayRangeClear and trendResistanceAgeBars >= minTrendSupportAgeBars and not na(trendResistanceZoneLow) and not na(trendResistanceZoneHigh)

float trendLongPredictStop = strongTrendSupport ? trendSupportZoneLow - invalidationBuffer : na
float trendLongPredictEntry = strongTrendSupport ? stopBoundedEntry(1, trendSupportZoneLow + atr * predictiveEntryOffsetAtr, trendLongPredictStop, atr, predictiveMaxStopAtr, predictiveMaxStopBps) : na
float trendLongConfirmStop = strongTrendSupport ? math.min(low, trendSupportZoneLow) - invalidationBuffer : na
float trendLongConfirmEntryRaw = strongTrendSupport ? math.min(close, trendSupportZoneHigh) : na
float trendLongConfirmEntry = strongTrendSupport ? stopBoundedEntry(1, scalpLimitEntry(1, close, trendSupportBasis, trendLongConfirmEntryRaw, atr, scalpLimitOffsetAtr), trendLongConfirmStop, atr, confirmedMaxStopAtr, confirmedMaxStopBps) : na
bool trendLongPredictContext = trendLongContext and strongTrendSupport and trendLongPredictEntry <= close and close - trendSupportZoneHigh <= atr * predictionArmDistanceAtr
bool trendLongConfirmContext = trendLongContext and strongTrendSupport and low <= trendSupportZoneHigh + trendPullbackBand and close > trendSupportBasis and closePosition >= trendRejectClosePosLongMin
float trendLongPredictQty = calcTrialQty(trendLongPredictEntry, trendLongPredictStop, predictiveMaxRiskDollars)
float trendLongConfirmQty = calcTrialQty(trendLongConfirmEntry, trendLongConfirmStop, confirmedMaxRiskDollars)
bool trendLongPredictAllowed = trendLongPredictContext and risklib.smallStopTrialAllowed(1, trendLongPredictEntry, trendLongPredictStop, atr, predictiveMaxRiskDollars, predictiveMaxStopAtr, predictiveMaxStopBps) and trendLongPredictQty >= 1.0
bool trendLongConfirmAllowed = trendLongConfirmContext and risklib.smallStopTrialAllowed(1, trendLongConfirmEntry, trendLongConfirmStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps) and trendLongConfirmQty >= 1.0

float trendShortPredictStop = strongTrendResistance ? trendResistanceZoneHigh + invalidationBuffer : na
float trendShortPredictEntry = strongTrendResistance ? stopBoundedEntry(-1, trendResistanceZoneHigh - atr * predictiveEntryOffsetAtr, trendShortPredictStop, atr, predictiveMaxStopAtr, predictiveMaxStopBps) : na
float trendShortConfirmStop = strongTrendResistance ? math.max(high, trendResistanceZoneHigh) + invalidationBuffer : na
float trendShortConfirmEntryRaw = strongTrendResistance ? math.max(close, trendResistanceZoneLow) : na
float trendShortConfirmEntry = strongTrendResistance ? stopBoundedEntry(-1, scalpLimitEntry(-1, close, trendResistanceBasis, trendShortConfirmEntryRaw, atr, scalpLimitOffsetAtr), trendShortConfirmStop, atr, confirmedMaxStopAtr, confirmedMaxStopBps) : na
bool trendShortPredictContext = trendShortContext and strongTrendResistance and trendShortPredictEntry >= close and trendResistanceZoneLow - close <= atr * predictionArmDistanceAtr
bool trendShortConfirmContext = trendShortContext and strongTrendResistance and high >= trendResistanceZoneLow - trendPullbackBand and close < trendResistanceBasis and closePosition <= trendRejectClosePosShortMax
float trendShortPredictQty = calcTrialQty(trendShortPredictEntry, trendShortPredictStop, predictiveMaxRiskDollars)
float trendShortConfirmQty = calcTrialQty(trendShortConfirmEntry, trendShortConfirmStop, confirmedMaxRiskDollars)
bool trendShortPredictAllowed = trendShortPredictContext and risklib.smallStopTrialAllowed(-1, trendShortPredictEntry, trendShortPredictStop, atr, predictiveMaxRiskDollars, predictiveMaxStopAtr, predictiveMaxStopBps) and trendShortPredictQty >= 1.0
bool trendShortConfirmAllowed = trendShortConfirmContext and risklib.smallStopTrialAllowed(-1, trendShortConfirmEntry, trendShortConfirmStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps) and trendShortConfirmQty >= 1.0

float topBasis = todayStructHigh
float topZoneLow = na(todayStructHighZoneLow) ? todayStructHigh : todayStructHighZoneLow
float topZoneHigh = na(todayStructHighZoneHigh) ? todayStructHigh : todayStructHighZoneHigh
float topStructuralRetestLevel = upperBreakAcceptedRegime and not na(prevStructHigh) ? prevStructHigh : topBasis
bool topStrictRetestTouch = not na(topStructuralRetestLevel) and high >= topStructuralRetestLevel - strictRetestTolerance
if confirmed and topProbeCycleActive and topProbeCycleConsumed and not topStrictRetestTouch
    topProbeCycleActive := false
    topProbeCycleTouchBar := na
    lastTopFailureWatchBar := na
    lastTopFailureWatchClose := na
    lastTopFailureWatchVolumeProbe := false
    topNoDemandStreak := 0
    lastTopNoDemandBar := na
    lastTopNoDemandHigh := na
    lastTopNoDemandLow := na
int topCount = not na(todayStructHigh) ? 1 : 0
topCount := levellib.addNearCount(topCount, sdUpper, topBasis, tolerance)
topCount := levellib.addNearCount(topCount, resistanceZoneHigh, topBasis, tolerance)
topCount := levellib.addNearCount(topCount, emaFast, topBasis, tolerance)
topCount := levellib.addNearCount(topCount, emaMid, topBasis, tolerance)
topCount := levellib.addNearCount(topCount, emaSlow, topBasis, tolerance)
topCount := levellib.addNearCount(topCount, dtpAvg, topBasis, tolerance)
topZoneLow := levellib.minNear(topZoneLow, sdUpper, topBasis, tolerance)
topZoneLow := levellib.minNear(topZoneLow, resistanceZoneHigh, topBasis, tolerance)
topZoneLow := levellib.minNear(topZoneLow, emaFast, topBasis, tolerance)
topZoneLow := levellib.minNear(topZoneLow, emaMid, topBasis, tolerance)
topZoneLow := levellib.minNear(topZoneLow, emaSlow, topBasis, tolerance)
topZoneLow := levellib.minNear(topZoneLow, dtpAvg, topBasis, tolerance)
topZoneHigh := levellib.maxNear(topZoneHigh, sdUpper, topBasis, tolerance)
topZoneHigh := levellib.maxNear(topZoneHigh, resistanceZoneHigh, topBasis, tolerance)
topZoneHigh := levellib.maxNear(topZoneHigh, emaFast, topBasis, tolerance)
topZoneHigh := levellib.maxNear(topZoneHigh, emaMid, topBasis, tolerance)
topZoneHigh := levellib.maxNear(topZoneHigh, emaSlow, topBasis, tolerance)
topZoneHigh := levellib.maxNear(topZoneHigh, dtpAvg, topBasis, tolerance)
string topSources = not na(todayStructHigh) ? "today_struct_high" : ""
topSources := levellib.appendNearSource(topSources, sdUpper, topBasis, tolerance, "sd_upper")
topSources := levellib.appendNearSource(topSources, resistanceZoneHigh, topBasis, tolerance, "resistance_cluster")
topSources := levellib.appendNearSource(topSources, emaFast, topBasis, tolerance, "ema20")
topSources := levellib.appendNearSource(topSources, emaMid, topBasis, tolerance, "ema50")
topSources := levellib.appendNearSource(topSources, emaSlow, topBasis, tolerance, "ema100")
topSources := levellib.appendNearSource(topSources, dtpAvg, topBasis, tolerance, "dtp_avg")
bool strongTopProbeZone = not na(todayStructHigh) and not na(topZoneLow) and not na(topZoneHigh)
int topAnchorAgeBars = not na(todayStructHighBar) ? bar_index - todayStructHighBar : 0
float topPullbackAtr = not na(todayStructHigh) and not na(lowSinceStructHigh) ? (todayStructHigh - lowSinceStructHigh) / atr : na
float topLeftLeg = not na(todayStructHigh) and not na(lowBeforeStructHigh) ? todayStructHigh - lowBeforeStructHigh : na
float topLocalLeftLeg = not na(todayStructHigh) and not na(localProbeLow) ? todayStructHigh - localProbeLow : na
float topMiddleLeg = not na(todayStructHigh) and not na(lowSinceStructHigh) ? todayStructHigh - lowSinceStructHigh : na
float topRightLeg = not na(lowSinceStructHigh) ? high - lowSinceStructHigh : na
float topLeftLegBps = risklib.visualLegBps(topLeftLeg, todayStructHigh)
float topLocalLeftLegBps = risklib.visualLegBps(topLocalLeftLeg, todayStructHigh)
float topGlobalMiddleRetraceRatio = risklib.visualLegRatio(topMiddleLeg, topLeftLeg)
float topLocalMiddleRetraceRatio = risklib.visualLegRatio(topMiddleLeg, topLocalLeftLeg)
float topMiddleRetraceRatio = not na(topLocalMiddleRetraceRatio) ? topLocalMiddleRetraceRatio : topGlobalMiddleRetraceRatio
float topRightRetestRatio = risklib.visualLegRatio(topRightLeg, topMiddleLeg)
float topMiddleBars = not na(lowSinceStructHighBar) and not na(todayStructHighBar) ? math.max((lowSinceStructHighBar - todayStructHighBar) * 1.0, 1.0) : na
float topRightBars = not na(lowSinceStructHighBar) ? math.max((bar_index - lowSinceStructHighBar) * 1.0, 1.0) : na
float topMiddleSpeed = not na(topMiddleLeg) and not na(topMiddleBars) ? topMiddleLeg / topMiddleBars : na
float topRightSpeed = not na(topRightLeg) and not na(topRightBars) ? topRightLeg / topRightBars : na
float topMomentumDecayRatio = not na(topMiddleSpeed) and topMiddleSpeed > 0.0 ? topRightSpeed / topMiddleSpeed : na
bool topMomentumDecayed = not na(topMomentumDecayRatio) and topMomentumDecayRatio <= momentumDecayMaxRatio
float topPriorLevelDistanceAtr = not na(todayStructHigh) and atr > 0.0 ? math.abs(high - todayStructHigh) / atr : na
bool topVisualLeftOk = (not na(topLeftLegBps) and topLeftLegBps >= minVisualLegBps) or (not na(topLocalLeftLegBps) and topLocalLeftLegBps >= minVisualLegBps)
bool topLargePullbackReady = not na(topMiddleLeg) and topMiddleLeg >= atr * minMiddleSwingAtr and topMiddleRetraceRatio >= minVisualMiddleRetraceRatio
bool topPullbackArmedEvent = confirmed and dayRangeClear and strongTopProbeZone and topVisualLeftOk and topLargePullbackReady and not topPullbackArmed
if topPullbackArmedEvent
    topPullbackArmed := true
    topPullbackArmedBar := na(topPullbackArmedBar) ? bar_index : topPullbackArmedBar
bool topMiddleSwingReady = not na(lowSinceStructHighBar) and topVisualLeftOk and topMiddleRetraceRatio >= minVisualMiddleRetraceRatio
bool topRightRetestReady = topMiddleSwingReady and topRightRetestRatio >= minVisualRightRetestRatio
bool topRetestFastEnough = topRightRetestReady and bar_index > lowSinceStructHighBar and bar_index - lowSinceStructHighBar <= maxRetestAfterMiddleSwingBars
bool topAnchorReady = dayRangeClear and topAnchorAgeBars >= probeMinAnchorAgeBars and topPullbackArmed
bool topRetestBand = not na(topZoneLow) and not na(topZoneHigh) and high >= topZoneLow - atr * probeRetestBandAtr and low <= topZoneHigh + atr * probeRetestBandAtr
bool topImmediatePullbackShort = topPullbackArmedEvent and topRetestBand and topStrictRetestTouch and close < open and (closePosition <= distributionDropClosePosMax or close < topZoneLow)
if topImmediatePullbackShort
    lastTopFailureWatchBar := bar_index
    lastTopFailureWatchHigh := high
    lastTopFailureWatchLow := low
    lastTopFailureWatchBase := topZoneHigh
    lastTopFailureWatchBodyMid := (open + close) * 0.5
    lastTopFailureWatchClose := close
    lastTopFailureWatchVolumeProbe := volumeAttackUp or (volumeRatio >= highAttackVolumeMult and close >= open)
bool topFirstExhaustion = strongTopProbeZone and not topExhaustionUsed and topAnchorReady and topRetestBand and close < topZoneLow
bool topRightShoulder = strongTopProbeZone and topAnchorReady and topRetestBand
string topProbePattern = topRightShoulder ? "retest_2b_top" : topFirstExhaustion ? "extension_exhaustion_top" : "none"
float topWeakBase = topStructuralRetestLevel
float topWeakExtensionAtr = not na(topWeakBase) and atr > 0.0 ? (high - topWeakBase) / atr : na
float topPriorHighStop = math.max(nz(topStructuralRetestLevel, high), nz(topZoneHigh, high)) + invalidationBuffer
float topPredictStop = strongTopProbeZone ? topPriorHighStop : na
float topPredictEntry = strongTopProbeZone ? stopBoundedEntry(-1, topZoneHigh - atr * predictiveEntryOffsetAtr, topPredictStop, atr, predictiveMaxStopAtr, predictiveMaxStopBps) : na
float topSignalDistanceAtr = not na(lastTopProbeSignalPrice) and atr > 0.0 ? math.abs(topPredictEntry - lastTopProbeSignalPrice) / atr : na
bool topSignalBarsOk = na(lastTopProbeSignalBar) or bar_index - lastTopProbeSignalBar >= probeMinSignalGapBars
