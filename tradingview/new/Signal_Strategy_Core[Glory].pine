//@version=6
strategy(title="Signal Strategy Core[Glory]", overlay=true, pyramiding=0, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, process_orders_on_close=true, calc_on_every_tick=false)
import o8431/SSC_Lib_Format_Glory/1 as fmtlib
import o8431/SSC_Lib_Risk_Glory/1 as risklib
import o8431/SSC_Lib_Levels_Glory/1 as levellib
import o8431/SSC_Lib_Model_Glory/1 as modellib

// TV-primary strategy v4.
// Quick EMA scalp model: structure first, RSI turn confirms momentum, limit orders only at good prices.

string STRATEGY_VERSION = "SSC_v4_20260618_quick_ema_scalp"
string SCRIPT_TAG = "Signal_Strategy_Core[Glory]"
string ENTRY_WINDOW_MODEL = "quick_ema_scalp_v1"
string TP_SL_MODEL = "quick_ema20_scalp_tp_v1"
string RISK_MODEL = "small_stop_75dollar_scalp_v1"
string TRADE_MODEL = "quick_ema_scalp_v1"

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
emaFastLen = input.int(20, "EMA fast", minval=1, group="01 Structure")
emaMidLen = input.int(50, "EMA mid", minval=1, group="01 Structure")
emaSlowLen = input.int(100, "EMA slow", minval=1, group="01 Structure")
structureLookbackBars = input.int(60, "Structure lookback bars", minval=10, maxval=300, group="01 Structure")
fractalPeriod = input.int(4, "Pivot period", minval=2, maxval=20, group="01 Structure")
minConfluenceCount = input.int(2, "Minimum structure confluence", minval=1, maxval=5, group="01 Structure")
confluenceZoneAtr = input.float(0.25, "Confluence zone (x ATR)", step=0.05, minval=0.05, maxval=2.0, group="01 Structure")
predictionArmDistanceAtr = input.float(1.20, "Max distance to predictive zone (x ATR)", step=0.10, minval=0.10, maxval=5.0, group="01 Structure")
predictiveEntryOffsetAtr = input.float(0.05, "Predictive entry offset (x ATR)", step=0.01, minval=0.0, maxval=0.50, group="01 Structure")
stopBufferAtr = input.float(0.08, "Invalidation buffer (x ATR)", step=0.01, minval=0.0, maxval=1.0, group="01 Structure")
referenceSession = input.session("0930-1600", "Reference day structure session", group="01 Structure")
dayStructConfirmBars = input.int(2, "Day structure confirm bars", minval=1, maxval=10, group="01 Structure")
dayStructMinReversalAtr = input.float(0.60, "Day structure reversal (x ATR)", step=0.05, minval=0.10, maxval=5.0, group="01 Structure")
trendMinSwingMoveAtr = input.float(0.70, "Trend swing min move (x ATR)", step=0.05, minval=0.10, maxval=5.0, group="01 Structure")
probeMinAnchorAgeBars = input.int(6, "Probe min anchor age bars", minval=1, maxval=60, group="01 Structure")
probeMinPullbackAtr = input.float(0.80, "Probe min pullback (x ATR)", step=0.05, minval=0.10, maxval=5.0, group="01 Structure")
probeRetestBandAtr = input.float(0.35, "Probe retest band (x ATR)", step=0.05, minval=0.05, maxval=3.0, group="01 Structure")
probeStrictTouchToleranceAtr = input.float(0.05, "Probe strict touch tolerance (x ATR)", step=0.01, minval=0.0, maxval=0.50, group="01 Structure")
probeMinSignalGapBars = input.int(6, "Probe min signal gap bars", minval=1, maxval=60, group="01 Structure")
probeMinSignalGapAtr = input.float(0.60, "Probe min signal gap (x ATR)", step=0.05, minval=0.10, maxval=5.0, group="01 Structure")
structureClusterBandAtr = input.float(0.40, "Structure cluster band (x ATR)", step=0.05, minval=0.05, maxval=3.0, group="01 Structure")
minStructureSeparationAtr = input.float(1.00, "Independent structure separation (x ATR)", step=0.05, minval=0.10, maxval=5.0, group="01 Structure")
minMiddleSwingAtr = input.float(1.00, "Middle swing for second test (x ATR)", step=0.05, minval=0.10, maxval=5.0, group="01 Structure")
maxRetestAfterMiddleSwingBars = input.int(12, "Max bars after middle swing retest", minval=1, maxval=60, group="01 Structure")
probeLocalLegLookbackBars = input.int(30, "Local M leg lookback bars", minval=5, maxval=120, group="01 Structure")
minVisualMiddleRetraceRatio = input.float(0.35, "Visual middle retrace ratio", step=0.05, minval=0.05, maxval=0.95, group="01 Structure")
minVisualRightRetestRatio = input.float(0.65, "Visual right retest ratio", step=0.05, minval=0.10, maxval=1.50, group="01 Structure")
minVisualLegBps = input.float(12.0, "Visual min leg (bps)", step=1.0, minval=1.0, maxval=500.0, group="01 Structure")
minClearDayRangeAtr = input.float(2.20, "Clear day range (x ATR)", step=0.10, minval=0.10, maxval=20.0, group="01 Structure")
minTrendSupportAgeBars = input.int(4, "Trend support min age bars", minval=1, maxval=60, group="01 Structure")
exhaustionVolumeMaxRatio = input.float(1.05, "Exhaustion max volume (x MA)", step=0.05, minval=0.10, maxval=5.0, group="01 Structure")
momentumDecayMaxRatio = input.float(0.65, "Momentum decay max ratio", step=0.05, minval=0.05, maxval=2.0, group="01 Structure")
exhaustionDecayConfirmBars = input.int(2, "Momentum decay confirm bars", minval=1, maxval=5, group="01 Structure")
exhaustionClosePosShortMax = input.float(0.45, "Short exhaustion close position max", step=0.05, minval=0.05, maxval=0.95, group="01 Structure")
exhaustionClosePosLongMin = input.float(0.55, "Long exhaustion close position min", step=0.05, minval=0.05, maxval=0.95, group="01 Structure")
minAnyPlanGapBars = input.int(4, "Any-plan min gap bars", minval=1, maxval=60, group="01 Structure")
minAnyPlanDistanceAtr = input.float(0.80, "Any-plan min distance (x ATR)", step=0.05, minval=0.10, maxval=8.0, group="01 Structure")
volumeMaLen = input.int(20, "Volume MA length", minval=1, maxval=200, group="01 Structure")
highAttackVolumeMult = input.float(1.35, "High attack volume (x MA)", step=0.05, minval=0.50, maxval=5.0, group="01 Structure")
lowRetestVolumeMult = input.float(0.95, "Low retest volume (x MA)", step=0.05, minval=0.10, maxval=2.0, group="01 Structure")
attackClosePosThreshold = input.float(0.65, "Attack close position", step=0.05, minval=0.50, maxval=0.95, group="01 Structure")
attackVolumeCooldownBars = input.int(4, "Attack volume cooldown bars", minval=0, maxval=20, group="01 Structure")
minSameSideSignalSeparationAtr = input.float(1.20, "Same-side signal separation (x ATR)", step=0.05, minval=0.10, maxval=8.0, group="01 Structure")
failedBreakCloseBackAtr = input.float(0.10, "Failed break close-back (x ATR)", step=0.05, minval=0.0, maxval=2.0, group="01 Structure")
failedBreakConfirmBars = input.int(3, "Failed break confirm bars", minval=1, maxval=8, group="01 Structure")
weakNewExtremeMaxExtendAtr = input.float(0.60, "Weak new extreme max extension (x ATR)", step=0.05, minval=0.05, maxval=3.0, group="01 Structure")
weakNewExtremeMaxVolumeRatio = input.float(1.05, "Weak new extreme max volume (x MA)", step=0.05, minval=0.10, maxval=3.0, group="01 Structure")
weakNewExtremeVolumeDropRatio = input.float(0.75, "Weak new extreme volume drop vs attack", step=0.05, minval=0.10, maxval=1.50, group="01 Structure")
weakNewExtremeCloseBackAtr = input.float(0.10, "Weak new extreme close back (x ATR)", step=0.05, minval=0.0, maxval=2.0, group="01 Structure")
weakNewExtremeConfirmBars = input.int(3, "Weak new extreme confirm bars", minval=1, maxval=8, group="01 Structure")
distributionDropVolumeMult = input.float(1.20, "Distribution/accumulation volume (x MA)", step=0.05, minval=0.50, maxval=5.0, group="01 Structure")
distributionDropClosePosMax = input.float(0.45, "Distribution close position max", step=0.05, minval=0.05, maxval=0.95, group="01 Structure")
distributionDropMaxDistanceAtr = input.float(0.80, "Distribution max distance (x ATR)", step=0.05, minval=0.05, maxval=5.0, group="01 Structure")
structureBreakAcceptBars = input.int(3, "Structure break accept bars", minval=1, maxval=10, group="01 Structure")
structureBreakAcceptCloseAtr = input.float(0.15, "Structure break accept close (x ATR)", step=0.05, minval=0.0, maxval=2.0, group="01 Structure")
planReplaceMinMoveAtr = input.float(0.60, "Plan replace min move (x ATR)", step=0.05, minval=0.05, maxval=5.0, group="01 Structure")
enableRegimePriority = input.bool(true, "Enable regime priority", group="01 Structure")
countertrendRequiresReclaim = input.bool(true, "Countertrend requires reclaim", group="01 Structure")
countertrendReclaimCloseBars = input.int(2, "Countertrend reclaim close bars", minval=1, maxval=5, group="01 Structure")
countertrendReclaimAtr = input.float(0.20, "Countertrend reclaim buffer (x ATR)", step=0.05, minval=0.0, maxval=2.0, group="01 Structure")
trendPullbackBandAtr = input.float(0.35, "Trend pullback band (x ATR)", step=0.05, minval=0.05, maxval=3.0, group="01 Structure")
trendRejectClosePosShortMax = input.float(0.45, "Trend short reject close position max", step=0.05, minval=0.05, maxval=0.95, group="01 Structure")
trendRejectClosePosLongMin = input.float(0.55, "Trend long reject close position min", step=0.05, minval=0.05, maxval=0.95, group="01 Structure")
freshExtremeBlockAtr = input.float(0.20, "Fresh extreme continuation block (x ATR)", step=0.05, minval=0.0, maxval=2.0, group="01 Structure")
shockDayRangeAtr = input.float(5.00, "Shock day range block (x ATR)", step=0.25, minval=1.0, maxval=20.0, group="01 Structure")

sdLength = input.int(128, "Regression length", minval=20, group="02 SD / DTP")
sdBandMult = input.float(2.0, "SD band multiplier", step=0.25, minval=0.25, maxval=5.0, group="02 SD / DTP")
dtpSmaLength = input.int(100, "DTP SMA length", minval=5, group="02 SD / DTP")
dtpAtrLength = input.int(200, "DTP ATR length", minval=5, group="02 SD / DTP")
dtpMomentumLookback = input.int(12, "DTP momentum lookback", minval=1, group="02 SD / DTP")
dtpTrendThreshold = input.float(0.10, "DTP trend threshold (ATR units)", step=0.05, group="02 SD / DTP")
dtpEarlyBars = input.int(12, "DTP early bars", minval=1, maxval=48, group="02 SD / DTP")

atrLength = input.int(10, "ATR length", minval=1, group="03 Small Stop Risk")
positionAmount = input.float(5000, "Notional cap per trade ($)", step=500, minval=100, group="03 Small Stop Risk")
predictiveMaxRiskDollars = input.float(37.5, "Predictive max trial risk ($)", step=2.5, minval=1.0, group="03 Small Stop Risk")
confirmedMaxRiskDollars = input.float(75.0, "Confirmed max trial risk ($)", step=5.0, minval=1.0, group="03 Small Stop Risk")
riskQtySafetyPct = input.float(0.95, "Risk qty safety pct", step=0.01, minval=0.50, maxval=1.0, group="03 Small Stop Risk")
riskQtyBufferAtr = input.float(0.03, "Risk qty safety buffer (x ATR)", step=0.01, minval=0.0, maxval=1.0, group="03 Small Stop Risk")
useNotionalCap = input.bool(false, "Apply notional cap after risk qty", group="03 Small Stop Risk")
predictiveMaxStopAtr = input.float(0.70, "Predictive max stop distance (x ATR)", step=0.05, minval=0.05, maxval=5.0, group="03 Small Stop Risk")
confirmedMaxStopAtr = input.float(0.90, "Confirmed max stop distance (x ATR)", step=0.05, minval=0.05, maxval=5.0, group="03 Small Stop Risk")
predictiveMaxStopBps = input.float(60.0, "Predictive max stop distance (bps)", step=5.0, minval=1.0, maxval=1000.0, group="03 Small Stop Risk")
confirmedMaxStopBps = input.float(80.0, "Confirmed max stop distance (bps)", step=5.0, minval=1.0, maxval=1000.0, group="03 Small Stop Risk")
breakevenOffsetR = input.float(0.05, "Breakeven offset (R)", step=0.01, minval=0.0, maxval=1.0, group="03 Small Stop Risk")
runnerTrailAtrMult = input.float(2.0, "Runner trail (x ATR)", step=0.25, minval=0.25, maxval=12.0, group="03 Small Stop Risk")
noFollowThroughBars = input.int(8, "No-follow-through bars", minval=1, maxval=50, group="03 Small Stop Risk")
noFollowThroughMinMfeR = input.float(0.60, "No-follow-through min MFE (R)", step=0.05, minval=0.0, maxval=5.0, group="03 Small Stop Risk")
noFollowThroughCompressedStopR = input.float(0.35, "No-follow-through compressed stop (R)", step=0.05, minval=0.05, maxval=1.0, group="03 Small Stop Risk")
exhaustionProtectMinMfeR = input.float(1.20, "Exhaustion protect min MFE (R)", step=0.05, minval=0.0, maxval=10.0, group="03 Small Stop Risk")
exhaustionProtectTrailAtr = input.float(0.60, "Exhaustion protect trail (x ATR)", step=0.05, minval=0.05, maxval=5.0, group="03 Small Stop Risk")
scalpLimitOffsetAtr = input.float(0.10, "Scalp limit offset (x ATR)", step=0.01, minval=0.0, maxval=1.0, group="03 Small Stop Risk")
scalpMaxEntryAwayAtr = input.float(0.35, "Scalp max entry distance from anchor (x ATR)", step=0.05, minval=0.05, maxval=3.0, group="03 Small Stop Risk")
scalpMinExpectedR = input.float(1.50, "Scalp minimum expected reward (R)", step=0.10, minval=0.10, maxval=10.0, group="03 Small Stop Risk")
minEmaProfitAtr = input.float(0.80, "Minimum EMA target room (x ATR)", step=0.05, minval=0.05, maxval=10.0, group="03 Small Stop Risk")
emaTargetOffsetAtr = input.float(0.10, "EMA target offset (x ATR)", step=0.01, minval=0.0, maxval=2.0, group="03 Small Stop Risk")
scalpBreakevenR = input.float(1.00, "Scalp breakeven trigger (R)", step=0.05, minval=0.10, maxval=5.0, group="03 Small Stop Risk")
minTpRunnerGapR = input.float(0.50, "Minimum TP-runner gap (R)", step=0.05, minval=0.0, maxval=10.0, group="03 Small Stop Risk")
allowSameBarRunnerAfterFill = input.bool(false, "Allow same-bar runner after fill", group="03 Small Stop Risk")
scalpNoFollowBars = input.int(4, "Scalp no-follow bars", minval=1, maxval=20, group="03 Small Stop Risk")
rsiLen = input.int(14, "Scalp RSI length", minval=2, maxval=100, group="03 Small Stop Risk")
rsiSmoothLen = input.int(7, "Scalp RSI smooth length", minval=1, maxval=100, group="03 Small Stop Risk")
rsiShortMin = input.float(55.0, "Short RSI high zone", step=1.0, minval=1.0, maxval=99.0, group="03 Small Stop Risk")
rsiLongMax = input.float(45.0, "Long RSI low zone", step=1.0, minval=1.0, maxval=99.0, group="03 Small Stop Risk")
rsiTurnLookback = input.int(3, "RSI turn lookback bars", minval=1, maxval=20, group="03 Small Stop Risk")
rsiFastDivLookback = input.int(12, "Fast RSI divergence lookback bars", minval=2, maxval=60, group="03 Small Stop Risk")
maxDailySameSideTrades = input.int(3, "Max same-side trades per day", minval=1, maxval=20, group="03 Small Stop Risk")
maxDailyTotalTrades = input.int(6, "Max total trades per day", minval=1, maxval=50, group="03 Small Stop Risk")
maxSameSideLosses = input.int(2, "Max same-side losses per day", minval=1, maxval=10, group="03 Small Stop Risk")
maxDailyLossDollars = input.float(150.0, "Max daily planned loss stop ($)", step=10.0, minval=1.0, group="03 Small Stop Risk")

tradingSession = input.session("0940-1530", "Trading session", group="04 TV Primary Events")
entrySession = input.session("0940-1530", "Entry window", group="04 TV Primary Events")
useIntradayEntryWindow = input.bool(true, "Use entry window", group="04 TV Primary Events")
entryOrderTtlBars = input.int(3, "Entry order TTL bars", minval=1, maxval=20, group="04 TV Primary Events")
enableAlerts = input.bool(true, "Emit TV-primary alert() payloads", group="04 TV Primary Events")
enableFillConfirmAlerts = input.bool(false, "Alert on TV strategy fill confirmation", group="04 TV Primary Events")
enableEodForceClose = input.bool(true, "Mirror EOD force close", group="04 TV Primary Events")
eodCloseHour = input.int(15, "EOD force close hour ET", minval=0, maxval=23, group="04 TV Primary Events")
eodCloseMinute = input.int(55, "EOD force close minute ET", minval=0, maxval=59, group="04 TV Primary Events")

// -----------------------------------------------------------------------------
// Utility helpers
// -----------------------------------------------------------------------------
confirmed = barstate.isconfirmed
float atrRaw = ta.atr(atrLength)
float atr = math.max(nz(atrRaw, syminfo.mintick), syminfo.mintick)
float tickBuffer = syminfo.mintick * 2.0
float invalidationBuffer = math.max(tickBuffer, atr * stopBufferAtr)
float strictRetestTolerance = math.max(tickBuffer, atr * probeStrictTouchToleranceAtr)
float barRange = math.max(high - low, syminfo.mintick)
float closePosition = (close - low) / barRange
float volumeMa = ta.sma(volume, volumeMaLen)
float barVolume = na(volume) ? nz(volumeMa, 0.0) : volume
float volumeRatio = not na(volumeMa) and volumeMa > 0.0 ? barVolume / volumeMa : 1.0
bool volumeExpanded = volumeRatio >= highAttackVolumeMult
bool volumeQuietRetest = volumeRatio <= lowRetestVolumeMult
bool volumeAttackUp = volumeExpanded and close > open and closePosition >= attackClosePosThreshold
bool volumeAttackDown = volumeExpanded and close < open and closePosition <= 1.0 - attackClosePosThreshold
float scalpRsi = ta.rsi(close, rsiLen)
float scalpRsiSmooth = ta.ema(scalpRsi, rsiSmoothLen)
float scalpRsiSpread = scalpRsi - scalpRsiSmooth
float scalpRsiSpreadHigh = ta.highest(scalpRsiSpread, rsiTurnLookback)
float scalpRsiHigh = ta.highest(scalpRsi, rsiTurnLookback)
float scalpRsiSpreadLow = ta.lowest(scalpRsiSpread, rsiTurnLookback)
float scalpRsiLow = ta.lowest(scalpRsi, rsiTurnLookback)
float scalpRsiDivPriceHigh = ta.highest(high[1], rsiFastDivLookback)
float scalpRsiDivPriceLow = ta.lowest(low[1], rsiFastDivLookback)
float scalpRsiDivHigh = ta.highest(scalpRsi[1], rsiFastDivLookback)
float scalpRsiDivLow = ta.lowest(scalpRsi[1], rsiFastDivLookback)
bool scalpRsiCrossUnderSmooth = ta.crossunder(scalpRsi, scalpRsiSmooth)
bool scalpRsiCrossOverSmooth = ta.crossover(scalpRsi, scalpRsiSmooth)
bool scalpRsiWasHigh = scalpRsiSpreadHigh > 0.0 and scalpRsiHigh >= rsiShortMin
bool scalpRsiWasLow = scalpRsiSpreadLow < 0.0 and scalpRsiLow <= rsiLongMax
bool scalpRsiWeakening = scalpRsi <= scalpRsi[1] or scalpRsiSpread < scalpRsiSpread[1] or scalpRsiCrossUnderSmooth
bool scalpRsiStrengthening = scalpRsi >= scalpRsi[1] or scalpRsiSpread > scalpRsiSpread[1] or scalpRsiCrossOverSmooth
bool scalpFastBearDiv = scalpRsiWasHigh and not na(scalpRsiDivPriceHigh) and not na(scalpRsiDivHigh) and high >= scalpRsiDivPriceHigh - atr * probeRetestBandAtr and scalpRsi < scalpRsiDivHigh
bool scalpFastBullDiv = scalpRsiWasLow and not na(scalpRsiDivPriceLow) and not na(scalpRsiDivLow) and low <= scalpRsiDivPriceLow + atr * probeRetestBandAtr and scalpRsi > scalpRsiDivLow
bool scalpRsiShortOk = scalpRsiWasHigh and (scalpRsiWeakening or scalpFastBearDiv)
bool scalpRsiLongOk = scalpRsiWasLow and (scalpRsiStrengthening or scalpFastBullDiv)

jsonStr(string key, string value) =>
    '"' + key + '":"' + str.replace_all(value, '"', "'") + '"'

jsonNum(string key, float value) =>
    '"' + key + '":' + (na(value) ? "null" : fmtlib.fmtFull(value))

jsonInt(string key, int value) =>
    '"' + key + '":' + str.tostring(value)

jsonBool(string key, bool value) =>
    '"' + key + '":' + (value ? "true" : "false")

jsonRequestedSides(string requestedSides) =>
    '"requested_sides":' + (requestedSides == "stop_loss" ? '["stop_loss"]' : requestedSides == "take_profit" ? '["take_profit"]' : requestedSides == "stop_loss,take_profit" ? '["stop_loss","take_profit"]' : '[]')

symbolKey() =>
    str.replace_all(syminfo.ticker, " ", "_")

dirText(int direction) =>
    direction == 1 ? "long" : direction == -1 ? "short" : "neutral"

orderIdForDirection(int direction) =>
    direction == 1 ? "TV-L" : "TV-S"

riskSafetyBuffer(float atrValue) =>
    risklib.riskSafetyBuffer(atrValue, riskQtyBufferAtr, syminfo.mintick)

stopBoundedEntry(int direction, float proposedEntry, float stopPrice, float atrValue, float maxAtrMultiple, float maxBps) =>
    risklib.stopBoundedEntry(direction, proposedEntry, stopPrice, atrValue, maxAtrMultiple, maxBps, syminfo.mintick)

calcTrialQty(float entryPrice, float stopPrice, float maxRiskDollars) =>
    risklib.calcTrialQty(entryPrice, stopPrice, maxRiskDollars, atr, riskQtyBufferAtr, riskQtySafetyPct, useNotionalCap, positionAmount, syminfo.mintick)

scalpLimitEntry(int direction, float currentClose, float anchorPrice, float fallbackEntry, float atrValue, float offsetAtr) =>
    risklib.scalpLimitEntry(direction, currentClose, anchorPrice, fallbackEntry, atrValue, offsetAtr, syminfo.mintick)

priceChanged(float oldPrice, float newPrice) =>
    risklib.priceChanged(oldPrice, newPrice, syminfo.mintick)

// -----------------------------------------------------------------------------
// Market structure
// -----------------------------------------------------------------------------
float emaFast = ta.ema(close, emaFastLen)
float emaMid = ta.ema(close, emaMidLen)
float emaSlow = ta.ema(close, emaSlowLen)
float dtpAvg = ta.sma(close, dtpSmaLength)
float dtpAtr = ta.atr(dtpAtrLength)
float dtpMomentum = dtpAvg - dtpAvg[dtpMomentumLookback]
float dtpNorm = dtpAtr > 0.0 ? dtpMomentum / dtpAtr : 0.0
bool dtpBullTurn = ta.crossover(dtpNorm, dtpTrendThreshold)
bool dtpBearTurn = ta.crossunder(dtpNorm, -dtpTrendThreshold)
var int dtpDir = 0
var int dtpStartBar = na
if confirmed
    if dtpBullTurn or dtpNorm > dtpTrendThreshold and close > dtpAvg and dtpDir != 1
        dtpDir := 1
        dtpStartBar := bar_index
    if dtpBearTurn or dtpNorm < -dtpTrendThreshold and close < dtpAvg and dtpDir != -1
        dtpDir := -1
        dtpStartBar := bar_index
int dtpPhaseBars = na(dtpStartBar) ? 0 : bar_index - dtpStartBar + 1
bool dtpBull = dtpDir == 1 and close >= dtpAvg
bool dtpBear = dtpDir == -1 and close <= dtpAvg
bool dtpEarly = dtpPhaseBars > 0 and dtpPhaseBars <= dtpEarlyBars

float sdMid = ta.linreg(close, sdLength, 0)
float sdDev = ta.stdev(close, sdLength)
float sdUpper = sdMid + sdDev * sdBandMult
float sdLower = sdMid - sdDev * sdBandMult
float recentHigh = ta.highest(high[1], structureLookbackBars)
float recentLow = ta.lowest(low[1], structureLookbackBars)
float localProbeHigh = ta.highest(high[1], probeLocalLegLookbackBars)
float localProbeLow = ta.lowest(low[1], probeLocalLegLookbackBars)
float pivotHigh = ta.pivothigh(high, fractalPeriod, fractalPeriod)
float pivotLow = ta.pivotlow(low, fractalPeriod, fractalPeriod)
var float lastPivotHigh = na
var float lastPivotLow = na
if confirmed and not na(pivotHigh)
    lastPivotHigh := pivotHigh
if confirmed and not na(pivotLow)
    lastPivotLow := pivotLow

bool inReferenceSession = not na(time(timeframe.period, referenceSession))
bool referenceSessionStarted = inReferenceSession and not inReferenceSession[1]
bool referenceDayReset = timeframe.change("D") or referenceSessionStarted
var float todayHigh = na
var float todayLow = na
var int todayHighBar = na
var int todayLowBar = na
var float lowBeforeTodayHigh = na
var float highBeforeTodayLow = na
var float todayStructHigh = na
var float todayStructLow = na
var float todayStructHighZoneLow = na
var float todayStructHighZoneHigh = na
var float todayStructLowZoneLow = na
var float todayStructLowZoneHigh = na
var float breakoutHighZoneHigh = na
var float breakoutLowZoneLow = na
var int todayStructHighBar = na
var int todayStructLowBar = na
var float lowBeforeStructHigh = na
var float highBeforeStructLow = na
var int lastProcessedHighCandidateBar = na
var int lastProcessedLowCandidateBar = na
