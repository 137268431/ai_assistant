bool bottomHighVolumeRiseConfirmed = confirmed and bottomPullbackArmed and recentBottomFailureWatchWindow and lastBottomFailureWatchVolumeProbe and close > open and (closePosition >= 1.0 - distributionDropClosePosMax or not na(lastBottomFailureWatchBodyMid) and close >= lastBottomFailureWatchBodyMid) and (not na(lastBottomFailureWatchHigh) and close > lastBottomFailureWatchHigh or not na(lastBottomFailureWatchBodyMid) and close >= lastBottomFailureWatchBodyMid or not na(lastBottomFailureWatchBase) and close >= lastBottomFailureWatchBase + atr * failedBreakCloseBackAtr) and not na(bottomHighVolumeRiseDistanceAtr) and bottomHighVolumeRiseDistanceAtr <= distributionDropMaxDistanceAtr
