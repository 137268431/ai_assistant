//@version=6
// @description Static symbol metadata for Signal Strategy VWAP/OR[Glory].
library("SSVOR_Lib_SymbolMeta_Glory", overlay=true)

clean(series string symbol) =>
    str.upper(str.replace_all(symbol, " ", ""))

isAny(series string s, series string a, series string b, series string c, series string d, series string e, series string f, series string g, series string h, series string i, series string j) =>
    s == a or s == b or s == c or s == d or s == e or s == f or s == g or s == h or s == i or s == j

isAnyMore(series string s, series string a, series string b, series string c, series string d, series string e, series string f, series string g, series string h, series string i, series string j) =>
    isAny(s, a, b, c, d, e, f, g, h, i, j)

export metadataVersion() =>
    "SSVOR_META_v1_20260702"

export sectorEtf(series string symbol) =>
    string s = clean(symbol)
    string result = ""
    if isAny(s, "NVDA", "AMD", "AVGO", "TSM", "MU", "AMAT", "LRCX", "KLAC", "INTC", "QCOM") or isAnyMore(s, "ASML", "ARM", "MRVL", "ON", "NXPI", "MCHP", "ADI", "TXN", "MPWR", "TER")
        result := "SMH"
    else if isAny(s, "AAPL", "MSFT", "PLTR", "ORCL", "CRM", "ADBE", "NOW", "SNOW", "PANW", "CRWD") or isAnyMore(s, "MDB", "DDOG", "NET", "ZS", "TEAM", "SHOP", "IBM", "CSCO", "ANET", "DELL")
        result := "XLK"
    else if isAny(s, "META", "GOOGL", "GOOG", "NFLX", "DIS", "CMCSA", "TMUS", "VZ", "T", "CHTR")
        result := "XLC"
    else if isAny(s, "AMZN", "TSLA", "HD", "LOW", "NKE", "SBUX", "MCD", "BKNG", "ABNB", "RIVN") or isAnyMore(s, "F", "GM", "LULU", "CMG", "DASH", "UBER", "LYFT", "RCL", "CCL", "MAR")
        result := "XLY"
    else if isAny(s, "JPM", "BAC", "WFC", "GS", "MS", "C", "AXP", "BLK", "SCHW", "COIN")
        result := "XLF"
    else if isAny(s, "XOM", "CVX", "COP", "SLB", "EOG", "OXY", "MPC", "VLO", "HAL", "BKR")
        result := "XLE"
    else if isAny(s, "UNH", "LLY", "JNJ", "ABBV", "MRK", "PFE", "TMO", "ABT", "ISRG", "VRTX")
        result := "XLV"
    else if isAny(s, "CAT", "BA", "GE", "HON", "UPS", "RTX", "LMT", "DE", "ETN", "UBER")
        result := "XLI"
    else if isAny(s, "LIN", "APD", "SHW", "FCX", "NEM", "DOW", "DD", "ECL", "NUE", "ALB")
        result := "XLB"
    else if isAny(s, "COST", "WMT", "PG", "KO", "PEP", "PM", "MO", "CL", "MDLZ", "TGT")
        result := "XLP"
    else if isAny(s, "NEE", "SO", "DUK", "CEG", "AEP", "SRE", "D", "EXC", "XEL", "PEG")
        result := "XLU"
    else if isAny(s, "PLD", "AMT", "EQIX", "WELL", "SPG", "O", "DLR", "CCI", "PSA", "VICI")
        result := "XLRE"
    else if isAny(s, "SPY", "QQQ", "SMH", "XLK", "XLC", "XLY", "XLF", "XLE", "XLV", "XLI") or isAnyMore(s, "XLB", "XLP", "XLU", "XLRE", "IWM", "DIA", "VIX", "TQQQ", "SQQQ", "UVXY")
        result := s
    result

export sectorTvSymbol(series string symbol) =>
    string etf = sectorEtf(symbol)
    etf == "QQQ" ? "NASDAQ:QQQ" : etf == "SMH" ? "NASDAQ:SMH" : etf == "SPY" ? "AMEX:SPY" : etf == "XLK" ? "AMEX:XLK" : etf == "XLC" ? "AMEX:XLC" : etf == "XLY" ? "AMEX:XLY" : etf == "XLF" ? "AMEX:XLF" : etf == "XLE" ? "AMEX:XLE" : etf == "XLV" ? "AMEX:XLV" : etf == "XLI" ? "AMEX:XLI" : etf == "XLB" ? "AMEX:XLB" : etf == "XLP" ? "AMEX:XLP" : etf == "XLU" ? "AMEX:XLU" : etf == "XLRE" ? "AMEX:XLRE" : ""

export sectorGroup(series string symbol) =>
    string etf = sectorEtf(symbol)
    etf == "SMH" ? "semiconductor" : etf == "XLK" ? "technology" : etf == "XLC" ? "communication" : etf == "XLY" ? "consumer_discretionary" : etf == "XLF" ? "financials" : etf == "XLE" ? "energy" : etf == "XLV" ? "healthcare" : etf == "XLI" ? "industrials" : etf == "XLB" ? "materials" : etf == "XLP" ? "consumer_staples" : etf == "XLU" ? "utilities" : etf == "XLRE" ? "real_estate" : etf == "SPY" or etf == "QQQ" ? "market_monitor" : "unknown"

export industryTag(series string symbol) =>
    string s = clean(symbol)
    string etf = sectorEtf(symbol)
    isAny(s, "NVDA", "AMD", "AVGO", "TSM", "MU", "AMAT", "LRCX", "KLAC", "INTC", "QCOM") or etf == "SMH" ? "semiconductor" : isAny(s, "AAPL", "MSFT", "ORCL", "CRM", "ADBE", "NOW", "SNOW", "PANW", "CRWD", "PLTR") ? "technology_leader" : etf == "XLC" ? "communication_services" : etf == "XLY" ? "consumer_discretionary" : sectorGroup(symbol)

export relativeBenchmark(series string symbol) =>
    string s = clean(symbol)
    s == "SPY" or s == "DIA" or s == "IWM" ? "SPY" : "QQQ"

export isMarketMonitor(series string symbol) =>
    string s = clean(symbol)
    isAny(s, "SPY", "QQQ", "SMH", "XLK", "XLC", "XLY", "XLF", "XLE", "XLV", "XLI") or isAnyMore(s, "XLB", "XLP", "XLU", "XLRE", "IWM", "DIA", "VIX", "TQQQ", "SQQQ", "UVXY")

export hasMetadata(series string symbol) =>
    sectorEtf(symbol) != ""

export tradeAllowed(series string symbol) =>
    hasMetadata(symbol) and not isMarketMonitor(symbol)
