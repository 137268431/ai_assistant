//@version=6
strategy(title="Signal Strategy VWAP OR Markers[Glory]", overlay=true, pyramiding=0, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, process_orders_on_close=false, calc_on_every_tick=false, dynamic_requests=true, max_labels_count=500, max_lines_count=100)
import o8431/SSVOR_Lib_Format_Glory/2 as fmtlib
import o8431/SSVOR_Lib_SymbolMeta_Glory/2 as metalib
import o8431/SSVOR_Core_Payload_Glory/2 as payloadlib

// VWAP/OR bare-K volume strategy. VWAP/OR is the map; volume-backed price action is the trigger.
string STRATEGY_VERSION = "SSVOR_v1_20260704_2m_execution_volume"
string SCRIPT_TAG = "Signal_Strategy_VWAP_OR_Core[Glory]"
string TRADE_MODEL = "vwap_or_bare_k_volume_v1"
string RISK_MODEL = "structure_atr_buffer_risk_qty_notional_cap_v1"
string TP_SL_MODEL = "partial_1r_final_r_breakeven_v2"

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
rthSession = input.session("0930-1600", "RTH session", group="01 Time")
marketSymbol = input.symbol("NASDAQ:QQQ", "Primary market ETF", group="01 Time")
confirmMarketSymbol = input.symbol("AMEX:SPY", "Confirm market ETF", group="01 Time")
manualEventBlock = input.bool(false, "Manual event block", group="01 Time")
enableAfternoonWindow = input.bool(true, "Enable strict 14:00-15:30 window", group="01 Time")
forceFlatHour = input.int(15, "Force flat hour ET", minval=0, maxval=23, group="01 Time")
forceFlatMinute = input.int(45, "Force flat minute ET", minval=0, maxval=59, group="01 Time")

allowMetadataFallback = input.bool(false, "Allow metadata fallback ETF", group="02 Metadata")
fallbackSectorSymbol = input.symbol("NASDAQ:SMH", "Fallback sector ETF", group="02 Metadata")
fallbackSectorEtfName = input.string("SMH", "Fallback sector ETF name", group="02 Metadata")

relativeStrengthMinBps = input.float(20.0, "Relative strength min bps", step=5.0, minval=0.0, group="03 Filters")
sectorVsMarketMinBps = input.float(0.0, "Sector vs QQQ min bps", step=5.0, group="03 Filters")
requireSectorLeadership = input.bool(false, "Require sector beating QQQ as hard filter", group="03 Filters")
trendFilterMode = input.string("Balanced", "Trend filter mode", options=["Balanced", "Hard", "Off"], group="03 Filters")
balancedTrendScoreMin = input.int(2, "Balanced trend score point min", minval=0, maxval=4, group="03 Filters")
volumeMaLen = input.int(20, "RVOL MA length", minval=1, maxval=200, group="03 Filters")
rvolMin = input.float(1.30, "RVOL breakout min", step=0.05, minval=0.5, maxval=10.0, group="03 Filters")
strongRvolMin = input.float(1.50, "RVOL strong min", step=0.05, minval=0.5, maxval=10.0, group="03 Filters")
pullbackVolumeMaxImpulseRatio = input.float(0.75, "Pullback volume max vs impulse", step=0.05, minval=0.1, maxval=2.0, group="03 Filters")
pullbackVolumeMaxMaRatio = input.float(1.10, "Pullback volume max vs MA", step=0.05, minval=0.1, maxval=3.0, group="03 Filters")
l3DeadRvolMin = input.float(0.75, "L3 dead RVOL floor", step=0.05, minval=0.0, maxval=5.0, group="03 Filters")
l3RecoveryRvolMin = input.float(1.00, "L3 recovery RVOL min", step=0.05, minval=0.0, maxval=5.0, group="03 Filters")
l3VolumeVsL2Min = input.float(1.20, "L3 volume vs L2 min", step=0.05, minval=0.1, maxval=5.0, group="03 Filters")
l3VolumeVsPrevMin = input.float(1.10, "L3 volume vs prev min", step=0.05, minval=0.1, maxval=5.0, group="03 Filters")
l3CloseLocationMin = input.float(0.50, "L3 close location min", step=0.05, minval=0.1, maxval=0.9, group="03 Filters")
maxMapDistanceAtr = input.float(1.20, "Max distance to VWAP/OR (ATR)", step=0.05, minval=0.05, maxval=5.0, group="03 Filters")
maxReconfirmDistanceAtr = input.float(2.20, "Max L3 confirm distance to VWAP/OR (ATR)", step=0.05, minval=0.05, maxval=6.0, group="03 Filters")
vwapChopAtr = input.float(0.12, "VWAP chop band (ATR)", step=0.01, minval=0.01, maxval=1.0, group="03 Filters")
maxBadWickRatio = input.float(0.45, "Max wrong-side wick ratio", step=0.05, minval=0.1, maxval=0.9, group="03 Filters")
patternTtlBars = input.int(10, "Pattern TTL bars", minval=2, maxval=30, group="03 Filters")

atrLen = input.int(14, "ATR length", minval=1, group="04 Position/Risk")
atrBufferMult = input.float(0.15, "Stop ATR buffer", step=0.01, minval=0.0, maxval=2.0, group="04 Position/Risk")
minStopPct = input.float(0.12, "Min stop distance pct", step=0.01, minval=0.0, maxval=10.0, group="04 Position/Risk")
maxStopPct = input.float(1.20, "Max stop distance pct", step=0.05, minval=0.01, maxval=20.0, group="04 Position/Risk")
positionAmount = input.float(5000.0, "Notional cap per trade ($)", step=500.0, minval=100.0, group="04 Position/Risk")
maxRiskDollars = input.float(75.0, "Max planned risk ($)", step=5.0, minval=1.0, group="04 Position/Risk")
riskQtySafetyPct = input.float(0.95, "Risk qty safety pct", step=0.01, minval=0.5, maxval=1.0, group="04 Position/Risk")
riskQtyBufferAtr = input.float(0.03, "Risk qty safety buffer (ATR)", step=0.01, minval=0.0, maxval=1.0, group="04 Position/Risk")
useNotionalCap = input.bool(true, "Apply $5000 notional cap", group="04 Position/Risk")
minQty = input.float(1.0, "Minimum shares", step=1.0, minval=1.0, group="04 Position/Risk")
breakevenOffsetR = input.float(0.05, "Breakeven offset R", step=0.01, minval=0.0, maxval=1.0, group="04 Position/Risk")
tp1ExitPct = input.int(33, "TP1 exit pct", minval=1, maxval=99, group="04 Position/Risk")
target2RMultiple = input.float(3.0, "Final target R multiple", step=0.25, minval=1.1, maxval=10.0, group="04 Position/Risk")
timeStopBars = input.int(10, "Time stop bars", minval=1, maxval=60, group="04 Position/Risk")
timeStopMinMfeR = input.float(0.50, "Time stop min MFE R", step=0.05, minval=0.0, maxval=5.0, group="04 Position/Risk")
maxDailyTrades = input.int(5, "Max trades per day", minval=1, maxval=20, group="04 Position/Risk")
maxConsecutiveLosses = input.int(3, "Max consecutive losses", minval=1, maxval=10, group="04 Position/Risk")
reduceAfterLosses = input.int(2, "Half size after consecutive losses", minval=1, maxval=10, group="04 Position/Risk")
maxDailyLossDollars = input.float(150.0, "Max daily planned loss ($)", step=10.0, minval=1.0, group="04 Position/Risk")
enableStrategyOrders = input.bool(true, "Enable strategy orders", group="04 Position/Risk")

minMorningScore = input.int(6, "Morning min score", minval=1, maxval=7, group="05 Alerts/Display")
minAfternoonScore = input.int(6, "Afternoon min score", minval=1, maxval=7, group="05 Alerts/Display")
enableAlerts = input.bool(true, "Emit TV-primary alert payloads", group="05 Alerts/Display")
enableFillConfirmAlerts = input.bool(false, "Alert on strategy fill confirmation", group="05 Alerts/Display")
displayProfile = input.string("PC", "Display profile", options=["PC", "Mobile", "Minimal"], group="05 Alerts/Display")
showRthVwapLine = input.bool(true, "Show RTH VWAP line", group="05 Alerts/Display")
showMapLevelTags = input.bool(true, "Show VWAP/OR price tags", group="05 Alerts/Display")
showSessionMarkers = input.bool(true, "Show session open/close markers", group="05 Alerts/Display")
showDiagnosticEventFlow = input.bool(false, "Show gate/watch diagnostics", group="05 Alerts/Display")
showStageMarkers = input.bool(true, "Show key stage markers", group="05 Alerts/Display")
showBlockedMarkers = input.bool(false, "Show blocked candidate markers", group="05 Alerts/Display")
showOrderCaseLabels = input.bool(true, "Show order case labels", group="05 Alerts/Display")
showManagementMarkers = input.bool(true, "Show TP/SL management markers", group="05 Alerts/Display")
markerLabelSize = input.string("Auto", "Marker label size", options=["Auto", "Tiny", "Small", "Normal", "Large", "Huge"], group="05 Alerts/Display")
orderLabelSize = input.string("Auto", "Order label size", options=["Auto", "Tiny", "Small", "Normal", "Large", "Huge"], group="05 Alerts/Display")
enableDebugLogs = input.bool(false, "Enable Pine debug logs", group="06 Debug Logs")
debugLogSessions = input.bool(true, "Log session/gate events", group="06 Debug Logs")
debugLogStages = input.bool(true, "Log stage pass/block events", group="06 Debug Logs")
debugLogExtendedSkips = input.bool(true, "Log extended skip events", group="06 Debug Logs")
debugLogOrders = input.bool(true, "Log order lifecycle events", group="06 Debug Logs")

isMobileProfile() =>
    displayProfile == "Mobile"

isMinimalProfile() =>
    displayProfile == "Minimal"

sizeFromInput(string sizeInput, string autoSize) =>
    string resolved = sizeInput == "Auto" ? autoSize : sizeInput
    resolved == "Huge" ? size.huge : resolved == "Large" ? size.large : resolved == "Normal" ? size.normal : resolved == "Small" ? size.small : size.tiny

markerSize() =>
    sizeFromInput(markerLabelSize, isMobileProfile() ? "Large" : isMinimalProfile() ? "Small" : "Normal")

orderMarkerSize() =>
    sizeFromInput(orderLabelSize, isMobileProfile() ? "Huge" : "Normal")

dollarText(series float value) =>
    na(value) ? "$--" : "$" + str.tostring(value, "#.##")

reasonText(series string reason) =>
    reason == "orders_disabled" ? "orders disabled" : reason == "indicator_warmup" ? "indicator warmup" : reason == "reconfirm_too_far_from_map" ? "L3 confirm too far from VWAP/OR" : reason == "pm_not_continuation" ? "PM not OR continuation" : reason == "trend_not_aligned" ? "trend not aligned" : reason == "l3_volume_dead" ? "L3 dead volume" : reason == "l3_volume_not_recovered" ? "L3 volume not recovered" : reason == "l3_weak_close" ? "L3 weak close" : reason == "take_profit_final" ? "final target" : fmtlib.reasonCn(reason)

blockedMarkerTooltip(int direction, string reason, float entryPrice, float stopPrice, float qty, float stopPct, int score) =>
    string side = direction == 1 ? "long" : "short"
    "blocked " + side + " candidate" + "\nreason: " + reason + " / " + reasonText(reason) + "\nentry: " + fmtlib.fmtPrice(entryPrice) + "\nstop: " + fmtlib.fmtPrice(stopPrice) + "\nrisk/share: " + fmtlib.fmtPrice(math.abs(entryPrice - stopPrice)) + "\nstop pct: " + fmtlib.fmt(stopPct) + "%\nqty: " + fmtlib.qtyText(qty) + "\nscore: " + str.tostring(score) + "/7"

orderCaseText(int direction, float entryPrice, float stopPrice, float target2, float qty) =>
    string side = direction == 1 ? "BUY next" : "SELL next"
    isMinimalProfile() ? side + "\nQ " + fmtlib.qtyText(qty) : side + (isMobileProfile() ? "" : " (L3)") + "\nE " + fmtlib.fmtPrice(entryPrice) + "\nSL " + fmtlib.fmtPrice(stopPrice) + "\nQ " + fmtlib.qtyText(qty) + "\nTP2 " + fmtlib.fmtPrice(target2)

orderCaseTooltip(int direction, float entryPrice, float stopPrice, float target1, float target2, float qty, float riskQty, float notionalQty, int score) =>
    string side = direction == 1 ? "long" : "short"
    float riskPerShare = math.abs(entryPrice - stopPrice)
    float notional = entryPrice * qty
    float actualRiskDollars = riskPerShare * qty
    bool notionalCapBinds = useNotionalCap and not na(notionalQty) and notionalQty <= riskQty
    "real strategy order: " + side + "\nentry intent: market_next_bar" + "\nentry: " + fmtlib.fmtPrice(entryPrice) + "\nstop: " + fmtlib.fmtPrice(stopPrice) + "\nrisk/share: " + fmtlib.fmtPrice(riskPerShare) + "\nqty: " + fmtlib.qtyText(qty) + "\nnotional: " + dollarText(notional) + "\nrisk qty: " + fmtlib.qtyText(riskQty) + "\nnotional qty cap: " + fmtlib.qtyText(notionalQty) + "\nactual risk: " + dollarText(actualRiskDollars) + "\n1R/final dollars: " + dollarText(actualRiskDollars) + " / " + dollarText(actualRiskDollars * target2RMultiple) + "\nnotional cap binds: " + str.tostring(notionalCapBinds) + "\nTP1: " + fmtlib.fmtPrice(target1) + " / " + str.tostring(tp1ExitPct) + "%\nTP2: " + fmtlib.fmtPrice(target2) + " / " + fmtlib.fmt(target2RMultiple) + "R\nscore: " + str.tostring(score) + "/7"

fillMarkerText(int direction, float fillPrice, float qty) =>
    string code = direction == 1 ? "FILL L" : "FILL S"
    isMinimalProfile() ? code : code + "\n" + fmtlib.fmtPrice(fillPrice) + " Q" + fmtlib.qtyText(qty)

managementMarkerText(string code, string reason, float priceValue, float pnlR) =>
    isMinimalProfile() ? code : isMobileProfile() ? code + "\n" + fmtlib.fmtPrice(priceValue) : code + "\n" + reasonText(reason) + "\n" + fmtlib.fmtPrice(priceValue) + "\n" + fmtlib.fmt(pnlR) + "R"

// -----------------------------------------------------------------------------
// Session helpers
// -----------------------------------------------------------------------------
confirmed = barstate.isconfirmed
is2m = timeframe.period == "2"
etMinutes = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
etCloseMinutes = hour(time_close, "America/New_York") * 60 + minute(time_close, "America/New_York")
inRth = not na(time(timeframe.period, rthSession))
rthStarted = inRth and (not (inRth[1] == true) or timeframe.change("D"))
newDay = timeframe.change("D") or rthStarted
inOpeningRange = inRth and etMinutes >= 9 * 60 + 30 and etMinutes < 9 * 60 + 45
orComplete = inRth and etMinutes >= 9 * 60 + 45
inMorningEntry = inRth and etMinutes >= 9 * 60 + 45 and etMinutes < 11 * 60 + 30
inAfternoonEntry = enableAfternoonWindow and inRth and etMinutes >= 14 * 60 and etMinutes < 15 * 60 + 30
entryWindowOpen = inMorningEntry or inAfternoonEntry
manageOnly = inRth and etMinutes >= 15 * 60 + 30 and etMinutes < 15 * 60 + 45
forceFlatNow = inRth and etCloseMinutes >= forceFlatHour * 60 + forceFlatMinute

rthVwap(series float src) =>
    bool sess = not na(time(timeframe.period, rthSession))
    bool wasSess = sess[1] == true
    bool start = sess and (not wasSess or timeframe.change("D"))
    var float cumPv = na
    var float cumVol = na
    if start
        cumPv := src * volume
        cumVol := volume
    else if sess
        cumPv := nz(cumPv, 0.0) + src * volume
        cumVol := nz(cumVol, 0.0) + volume
    else
        cumPv := na
        cumVol := na
    not na(cumVol) and cumVol > 0.0 ? cumPv / cumVol : na

rthOpenPrice() =>
    bool sess = not na(time(timeframe.period, rthSession))
    bool wasSess = sess[1] == true
    bool start = sess and (not wasSess or timeframe.change("D"))
    var float sessionOpen = na
    if start
        sessionOpen := open
    else if not sess
        sessionOpen := na
    sessionOpen

rthChangeBps() =>
    float sessionOpen = rthOpenPrice()
    not na(sessionOpen) and sessionOpen > 0.0 ? (close - sessionOpen) / sessionOpen * 10000.0 : na

trendDir() =>
    float e = ta.ema(close, 20)
    close >= e and e >= e[1] ? 1 : close <= e and e <= e[1] ? -1 : 0

// -----------------------------------------------------------------------------
// Market data and map levels
// -----------------------------------------------------------------------------
float atrRaw = ta.atr(atrLen)
float atr = math.max(nz(atrRaw, syminfo.mintick), syminfo.mintick)
float vwap = rthVwap(hlc3)
float volumeMa = ta.sma(volume, volumeMaLen)
float barVolume = na(volume) ? nz(volumeMa, 0.0) : volume
float rvol = not na(volumeMa) and volumeMa > 0.0 ? barVolume / volumeMa : 0.0
bool volumeExpanded = rvol >= rvolMin
bool volumeStrong = rvol >= strongRvolMin
float barRange = math.max(high - low, syminfo.mintick)
float upperWickRatio = (high - math.max(open, close)) / barRange
float lowerWickRatio = (math.min(open, close) - low) / barRange
bool badLongWick = upperWickRatio > maxBadWickRatio
bool badShortWick = lowerWickRatio > maxBadWickRatio

var float orHigh = na
var float orLow = na
if confirmed and newDay
    orHigh := na
    orLow := na
if confirmed and inOpeningRange
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow := na(orLow) ? low : math.min(orLow, low)

string rawSectorEtf = metalib.sectorEtf(syminfo.ticker)
string rawSectorTvSymbol = metalib.sectorTvSymbol(syminfo.ticker)
bool rawMetadataOk = metalib.hasMetadata(syminfo.ticker)
bool metadataFallbackActive = not rawMetadataOk and allowMetadataFallback
string sectorEtf = rawMetadataOk ? rawSectorEtf : metadataFallbackActive ? fallbackSectorEtfName : ""
string sectorTvSymbol = rawMetadataOk ? rawSectorTvSymbol : metadataFallbackActive ? fallbackSectorSymbol : marketSymbol
string sectorGroup = rawMetadataOk ? metalib.sectorGroup(syminfo.ticker) : metadataFallbackActive ? "fallback" : "unknown"
string industryTag = rawMetadataOk ? metalib.industryTag(syminfo.ticker) : metadataFallbackActive ? "fallback" : "unknown"
bool metadataOk = rawMetadataOk or metadataFallbackActive
bool tradeAllowedByMeta = metadataFallbackActive ? true : metalib.tradeAllowed(syminfo.ticker)

float qqqClose = request.security(marketSymbol, timeframe.period, close)
float qqqVwap = request.security(marketSymbol, timeframe.period, rthVwap(hlc3))
float qqqChangeBps = request.security(marketSymbol, timeframe.period, rthChangeBps())
int qqqTrend15 = request.security(marketSymbol, "15", trendDir())
int qqqTrend30 = request.security(marketSymbol, "30", trendDir())
float spyClose = request.security(confirmMarketSymbol, timeframe.period, close)
float spyVwap = request.security(confirmMarketSymbol, timeframe.period, rthVwap(hlc3))
float spyChangeBps = request.security(confirmMarketSymbol, timeframe.period, rthChangeBps())
float sectorClose = request.security(sectorTvSymbol, timeframe.period, close)
float sectorVwap = request.security(sectorTvSymbol, timeframe.period, rthVwap(hlc3))
float sectorChangeBps = request.security(sectorTvSymbol, timeframe.period, rthChangeBps())
int sectorTrend15 = request.security(sectorTvSymbol, "15", trendDir())
int sectorTrend30 = request.security(sectorTvSymbol, "30", trendDir())
int stockTrend15 = request.security(syminfo.tickerid, "15", trendDir())
int stockTrend30 = request.security(syminfo.tickerid, "30", trendDir())
float stockChangeBps = rthChangeBps()
bool indicatorReady = inRth and not na(atrRaw) and not na(vwap) and not na(volumeMa) and volumeMa > 0.0 and not na(qqqClose) and not na(qqqVwap) and not na(qqqChangeBps) and not na(qqqTrend15) and not na(qqqTrend30) and not na(spyClose) and not na(spyVwap) and not na(sectorClose) and not na(sectorVwap) and not na(sectorChangeBps) and not na(sectorTrend15) and not na(sectorTrend30) and not na(stockTrend15) and not na(stockTrend30) and not na(stockChangeBps)

float stockVsMarketBps = stockChangeBps - qqqChangeBps
float stockVsSectorBps = stockChangeBps - sectorChangeBps
float sectorVsMarketBps = sectorChangeBps - qqqChangeBps

bool qqqLong = qqqClose > qqqVwap and qqqTrend15 >= 0
bool qqqShort = qqqClose < qqqVwap and qqqTrend15 <= 0
bool spyLongOk = spyClose >= spyVwap or spyChangeBps >= 0.0
bool spyShortOk = spyClose <= spyVwap or spyChangeBps <= 0.0
bool marketLongOk = qqqLong and spyLongOk
bool marketShortOk = qqqShort and spyShortOk
bool hardTrendLongOk = qqqTrend15 == 1 and qqqTrend30 == 1 and sectorTrend15 == 1 and sectorTrend30 == 1 and stockTrend15 == 1 and stockTrend30 == 1
bool hardTrendShortOk = qqqTrend15 == -1 and qqqTrend30 == -1 and sectorTrend15 == -1 and sectorTrend30 == -1 and stockTrend15 == -1 and stockTrend30 == -1
bool marketTrendLongOk = qqqTrend30 == 1 and qqqTrend15 >= 0
bool marketTrendShortOk = qqqTrend30 == -1 and qqqTrend15 <= 0
int contextTrendLongScore = (sectorTrend15 == 1 ? 1 : 0) + (sectorTrend30 == 1 ? 1 : 0) + (stockTrend15 == 1 ? 1 : 0) + (stockTrend30 == 1 ? 1 : 0)
int contextTrendShortScore = (sectorTrend15 == -1 ? 1 : 0) + (sectorTrend30 == -1 ? 1 : 0) + (stockTrend15 == -1 ? 1 : 0) + (stockTrend30 == -1 ? 1 : 0)
bool trendGateLongOk = trendFilterMode == "Off" ? true : trendFilterMode == "Hard" ? hardTrendLongOk : marketTrendLongOk
bool trendGateShortOk = trendFilterMode == "Off" ? true : trendFilterMode == "Hard" ? hardTrendShortOk : marketTrendShortOk
bool trendScoreLongOk = trendFilterMode == "Off" ? true : trendFilterMode == "Hard" ? hardTrendLongOk : contextTrendLongScore >= balancedTrendScoreMin
bool trendScoreShortOk = trendFilterMode == "Off" ? true : trendFilterMode == "Hard" ? hardTrendShortOk : contextTrendShortScore >= balancedTrendScoreMin
bool sectorTrendLongOk = metadataOk and sectorClose >= sectorVwap
bool sectorTrendShortOk = metadataOk and sectorClose <= sectorVwap
bool sectorLeadershipLongOk = sectorVsMarketBps >= sectorVsMarketMinBps
bool sectorLeadershipShortOk = sectorVsMarketBps <= -sectorVsMarketMinBps
bool sectorLongOk = sectorTrendLongOk and (not requireSectorLeadership or sectorLeadershipLongOk)
bool sectorShortOk = sectorTrendShortOk and (not requireSectorLeadership or sectorLeadershipShortOk)
bool relativeLongOk = stockVsMarketBps >= relativeStrengthMinBps and stockVsSectorBps >= relativeStrengthMinBps
bool relativeShortOk = stockVsMarketBps <= -relativeStrengthMinBps and stockVsSectorBps <= -relativeStrengthMinBps

bool vwapCross0 = ta.cross(close, vwap)
bool vwapCross1 = ta.cross(close[1], vwap[1])
bool vwapCross2 = ta.cross(close[2], vwap[2])
bool vwapCross3 = ta.cross(close[3], vwap[3])
bool vwapCross4 = ta.cross(close[4], vwap[4])
int vwapCrossCount = (vwapCross0 ? 1 : 0) + (vwapCross1 ? 1 : 0) + (vwapCross2 ? 1 : 0) + (vwapCross3 ? 1 : 0) + (vwapCross4 ? 1 : 0)
bool nearVwapChopBand = math.abs(close - vwap) <= atr * vwapChopAtr
bool vwapChoppy = vwapCrossCount >= 3 and nearVwapChopBand
float longMapDistanceAtr = indicatorReady and atr > 0.0 ? math.min(math.abs(close - vwap), not na(orHigh) ? math.abs(close - orHigh) : math.abs(close - vwap)) / atr : na
float shortMapDistanceAtr = indicatorReady and atr > 0.0 ? math.min(math.abs(close - vwap), not na(orLow) ? math.abs(close - orLow) : math.abs(close - vwap)) / atr : na
bool longMapNear = indicatorReady and not na(longMapDistanceAtr) and longMapDistanceAtr <= maxMapDistanceAtr
bool shortMapNear = indicatorReady and not na(shortMapDistanceAtr) and shortMapDistanceAtr <= maxMapDistanceAtr
bool longReconfirmMapNear = indicatorReady and not na(longMapDistanceAtr) and longMapDistanceAtr <= maxReconfirmDistanceAtr
bool shortReconfirmMapNear = indicatorReady and not na(shortMapDistanceAtr) and shortMapDistanceAtr <= maxReconfirmDistanceAtr
bool priceLongSide = close > vwap
bool priceShortSide = close < vwap
bool pmLongContinuationOk = inAfternoonEntry and not na(orHigh) and close > orHigh and close > vwap
bool pmShortContinuationOk = inAfternoonEntry and not na(orLow) and close < orLow and close < vwap

// -----------------------------------------------------------------------------
// Daily state and scoring
// -----------------------------------------------------------------------------
var int dailyTrades = 0
var int consecutiveLosses = 0
var float dayStartNetprofit = 0.0
if confirmed and newDay
    dailyTrades := 0
    consecutiveLosses := 0
    dayStartNetprofit := strategy.netprofit
float dailyPnl = strategy.netprofit - dayStartNetprofit
bool dailyRiskOk = dailyTrades < maxDailyTrades and consecutiveLosses < maxConsecutiveLosses and dailyPnl > -maxDailyLossDollars
bool halfSizeNext = consecutiveLosses >= reduceAfterLosses

scoreFor(bool marketOk, bool sectorOk, bool relativeOk, bool priceSideOk, bool mapNearOk, bool volumeOk, bool trendOk) =>
    (marketOk ? 1 : 0) + (sectorOk ? 1 : 0) + (relativeOk ? 1 : 0) + (priceSideOk ? 1 : 0) + (mapNearOk ? 1 : 0) + (volumeOk ? 1 : 0) + (trendOk ? 1 : 0)

baseBlockReason(int direction) =>
    string reason = "passed"
    if not is2m
        reason := "wrong_timeframe"
    else if manualEventBlock
        reason := "manual_event_block"
    else if not metadataOk
        reason := "metadata_missing"
    else if not tradeAllowedByMeta
        reason := "trade_not_allowed_symbol"
    else if not entryWindowOpen
        reason := "outside_entry_session"
    else if not dailyRiskOk
        reason := "daily_risk_stop"
    else if not indicatorReady
        reason := "indicator_warmup"
    else if inAfternoonEntry and ((direction == 1 and not pmLongContinuationOk) or (direction == -1 and not pmShortContinuationOk))
        reason := "pm_not_continuation"
    else if (direction == 1 and not trendGateLongOk) or (direction == -1 and not trendGateShortOk)
        reason := "trend_not_aligned"
    else if (direction == 1 and not marketLongOk) or (direction == -1 and not marketShortOk)
        reason := "market_not_aligned"
    else if (direction == 1 and not sectorLongOk) or (direction == -1 and not sectorShortOk)
        reason := "sector_not_aligned"
    else if (direction == 1 and not relativeLongOk) or (direction == -1 and not relativeShortOk)
        reason := "relative_strength_missing"
    else if (direction == 1 and not priceLongSide) or (direction == -1 and not priceShortSide)
        reason := "price_wrong_side_vwap"
    else if vwapChoppy
        reason := "vwap_choppy"
    else if (direction == 1 and not longMapNear) or (direction == -1 and not shortMapNear)
        reason := "too_far_from_map"
    reason

reconfirmBaseBlockReason(int direction) =>
    string reason = baseBlockReason(direction)
    if reason == "too_far_from_map"
        bool reconfirmMapOk = direction == 1 ? longReconfirmMapNear : shortReconfirmMapNear
        reason := reconfirmMapOk ? "passed" : "reconfirm_too_far_from_map"
    reason

dirName(int direction) =>
    direction == 1 ? "LONG" : direction == -1 ? "SHORT" : "FLAT"

trendText(int trend) =>
    trend == 1 ? "up" : trend == -1 ? "down" : "neutral"

priceVsText(float priceValue, float refValue) =>
    na(priceValue) or na(refValue) ? "na" : priceValue > refValue ? "above" : priceValue < refValue ? "below" : "at"

marketDataMissing() =>
    na(qqqClose) or na(qqqVwap) or na(qqqTrend15) or na(qqqTrend30) or na(spyClose) or na(spyVwap)

marketGateTag() =>
    marketDataMissing() ? "MKT DATA?" : marketLongOk and not marketShortOk ? "MKT L" : marketShortOk and not marketLongOk ? "MKT S" : "MKT MIX"

marketBlockCode(int direction) =>
    string code = "MIX"
    if marketDataMissing()
        code := "DATA?"
    else if direction == 1
        code := qqqClose <= qqqVwap ? "Q<VWAP" : qqqTrend15 < 0 ? "Q15Dn" : not spyLongOk ? "SPY" : "MIX"
    else
        code := qqqClose >= qqqVwap ? "Q>VWAP" : qqqTrend15 > 0 ? "Q15Up" : not spyShortOk ? "SPY" : "MIX"
    code

marketBlockSummary(int direction) =>
    string code = marketBlockCode(direction)
    code == "DATA?" ? "market data missing" : code == "Q<VWAP" ? "QQQ is not above VWAP for long" : code == "Q>VWAP" ? "QQQ is not below VWAP for short" : code == "Q15Dn" ? "QQQ 15m trend is down" : code == "Q15Up" ? "QQQ 15m trend is up" : code == "SPY" ? "SPY opposes QQQ direction" : "mixed market state"

marketBlockDetail(int direction) =>
    string side = direction == 1 ? "Long" : "Short"
    bool pass = direction == 1 ? marketLongOk : marketShortOk
    bool spyOk = direction == 1 ? spyLongOk : spyShortOk
    string result = side + " market: " + (pass ? "PASS" : marketBlockCode(direction) + " / " + marketBlockSummary(direction))
    result := result + "\nQQQ close/VWAP: " + fmtlib.fmtPrice(qqqClose) + " / " + fmtlib.fmtPrice(qqqVwap) + " / " + priceVsText(qqqClose, qqqVwap)
    result := result + "\nQQQ 15m trend: " + trendText(qqqTrend15) + " / raw " + str.tostring(qqqTrend15)
    result := result + "\nSPY close/VWAP: " + fmtlib.fmtPrice(spyClose) + " / " + fmtlib.fmtPrice(spyVwap) + " / " + priceVsText(spyClose, spyVwap)
    result := result + "\nSPY ok: " + str.tostring(spyOk) + " / RTH change " + fmtlib.bpsText(spyChangeBps)
    result

marketGateDetail() =>
    string result = "Market/trend gate filter"
    result := result + "\nGate tag: " + marketGateTag()
    result := result + "\nIndicator ready: " + str.tostring(indicatorReady)
    result := result + "\nLong OK: " + str.tostring(marketLongOk) + " / QQQ long " + str.tostring(qqqLong) + " / SPY ok " + str.tostring(spyLongOk)
    result := result + "\nShort OK: " + str.tostring(marketShortOk) + " / QQQ short " + str.tostring(qqqShort) + " / SPY ok " + str.tostring(spyShortOk)
    result := result + "\nTrend mode: " + trendFilterMode + " / gate L/S " + str.tostring(trendGateLongOk) + " / " + str.tostring(trendGateShortOk)
    result := result + "\nMarket trend L/S: " + str.tostring(marketTrendLongOk) + " / " + str.tostring(marketTrendShortOk)
    result := result + "\nContext trend score L/S: " + str.tostring(contextTrendLongScore) + " / " + str.tostring(contextTrendShortScore) + " min " + str.tostring(balancedTrendScoreMin)
    result := result + "\nHard trend L/S: " + str.tostring(hardTrendLongOk) + " / " + str.tostring(hardTrendShortOk)
    result := result + "\nLong detail: " + (marketLongOk ? "PASS" : marketBlockCode(1) + " / " + marketBlockSummary(1))
    result := result + "\nShort detail: " + (marketShortOk ? "PASS" : marketBlockCode(-1) + " / " + marketBlockSummary(-1))
    result := result + "\nQQQ close/VWAP: " + fmtlib.fmtPrice(qqqClose) + " / " + fmtlib.fmtPrice(qqqVwap) + " / " + priceVsText(qqqClose, qqqVwap)
    result := result + "\nTrend q/s/st 15/30: " + trendText(qqqTrend15) + "/" + trendText(qqqTrend30) + " " + trendText(sectorTrend15) + "/" + trendText(sectorTrend30) + " " + trendText(stockTrend15) + "/" + trendText(stockTrend30)
    result := result + "\nQQQ 15m trend: " + trendText(qqqTrend15) + " / raw " + str.tostring(qqqTrend15)
    result := result + "\nQQQ RTH change: " + fmtlib.bpsText(qqqChangeBps)
    result := result + "\nSPY close/VWAP: " + fmtlib.fmtPrice(spyClose) + " / " + fmtlib.fmtPrice(spyVwap) + " / " + priceVsText(spyClose, spyVwap)
    result := result + "\nSPY RTH change: " + fmtlib.bpsText(spyChangeBps)
    result := result + "\n" + marketBlockDetail(1)
    result := result + "\n" + marketBlockDetail(-1)
    result := result + "\nRule: market/VWAP must agree; Balanced trend needs QQQ 30m with 15m not opposing, while sector/stock trend contributes the score point."
    result

debugEtStamp() =>
    str.tostring(hour(time, "America/New_York")) + ":" + str.tostring(minute(time, "America/New_York"))

debugCategoryEnabled(string category) =>
    enableDebugLogs and (category == "session" ? debugLogSessions : category == "order" ? debugLogOrders : category == "extended" ? debugLogExtendedSkips : debugLogStages)

debugScoreText(int direction) =>
    direction == 1 ? str.tostring(scoreFor(marketLongOk, sectorLongOk, relativeLongOk, priceLongSide, longMapNear, volumeExpanded, trendScoreLongOk)) + "/7" : direction == -1 ? str.tostring(scoreFor(marketShortOk, sectorShortOk, relativeShortOk, priceShortSide, shortMapNear, volumeExpanded, trendScoreShortOk)) + "/7" : "--"

debugCommonState(int direction, string reason) =>
    string result = "side=" + dirName(direction) + " reason=" + reason + " / " + reasonText(reason)
    if reason == "market_not_aligned" and direction != 0
        result := result + " market_code=" + marketBlockCode(direction) + " / " + marketBlockSummary(direction)
    result := result + "\nindicator_ready=" + str.tostring(indicatorReady)
    result := result + "\ntrend_mode=" + trendFilterMode + " trend_gate L/S=" + str.tostring(trendGateLongOk) + "/" + str.tostring(trendGateShortOk) + " trend_score_point L/S=" + str.tostring(trendScoreLongOk) + "/" + str.tostring(trendScoreShortOk)
    result := result + "\ntrend_context_score L/S=" + str.tostring(contextTrendLongScore) + "/" + str.tostring(contextTrendShortScore) + " min=" + str.tostring(balancedTrendScoreMin) + " trend_market L/S=" + str.tostring(marketTrendLongOk) + "/" + str.tostring(marketTrendShortOk)
    result := result + "\ntrend_hard L/S=" + str.tostring(hardTrendLongOk) + "/" + str.tostring(hardTrendShortOk)
    result := result + "\ntrend qqq15/30 sector15/30 stock15/30=" + trendText(qqqTrend15) + "/" + trendText(qqqTrend30) + " " + trendText(sectorTrend15) + "/" + trendText(sectorTrend30) + " " + trendText(stockTrend15) + "/" + trendText(stockTrend30)
    result := result + "\nprice=" + fmtlib.fmtPrice(close) + " vwap=" + fmtlib.fmtPrice(vwap) + " ORH=" + fmtlib.fmtPrice(orHigh) + " ORL=" + fmtlib.fmtPrice(orLow)
    result := result + "\nrvol=" + fmtlib.fmt(rvol) + " vol_expanded=" + str.tostring(volumeExpanded) + " score=" + debugScoreText(direction)
    result := result + "\nmap_dist L/S=" + fmtlib.fmt(longMapDistanceAtr) + "/" + fmtlib.fmt(shortMapDistanceAtr) + " price_side L/S=" + str.tostring(priceLongSide) + "/" + str.tostring(priceShortSide)
    result := result + "\nmap_max L1/L2=" + fmtlib.fmt(maxMapDistanceAtr) + "ATR L3=" + fmtlib.fmt(maxReconfirmDistanceAtr) + "ATR"
    result := result + "\npm_cont L/S=" + str.tostring(pmLongContinuationOk) + "/" + str.tostring(pmShortContinuationOk) + " pm_rule=long_above_ORH short_below_ORL"
    result := result + "\nl3_map_ok L/S=" + str.tostring(longReconfirmMapNear) + "/" + str.tostring(shortReconfirmMapNear) + " l3_base_score_prevol L/S=" + str.tostring(scoreFor(marketLongOk, sectorLongOk, relativeLongOk, priceLongSide, longReconfirmMapNear, volumeExpanded, trendScoreLongOk)) + "/" + str.tostring(scoreFor(marketShortOk, sectorShortOk, relativeShortOk, priceShortSide, shortReconfirmMapNear, volumeExpanded, trendScoreShortOk))
    result := result + "\nmarket=" + marketGateTag() + " qqq=" + fmtlib.fmtPrice(qqqClose) + "/" + fmtlib.fmtPrice(qqqVwap) + " q15=" + trendText(qqqTrend15) + " spy=" + fmtlib.fmtPrice(spyClose) + "/" + fmtlib.fmtPrice(spyVwap)
    result := result + "\nrs stock-market/sector=" + fmtlib.bpsText(stockVsMarketBps) + "/" + fmtlib.bpsText(stockVsSectorBps) + " sector-vs-market=" + fmtlib.bpsText(sectorVsMarketBps) + " sector=" + sectorEtf
    result := result + "\nsector_close/vwap=" + fmtlib.fmtPrice(sectorClose) + "/" + fmtlib.fmtPrice(sectorVwap) + " sector_side L/S=" + str.tostring(sectorTrendLongOk) + "/" + str.tostring(sectorTrendShortOk) + " sector_lead L/S=" + str.tostring(sectorLeadershipLongOk) + "/" + str.tostring(sectorLeadershipShortOk) + " hard_lead=" + str.tostring(requireSectorLeadership) + " sector_ok L/S=" + str.tostring(sectorLongOk) + "/" + str.tostring(sectorShortOk)
    result

debugLog(string category, string eventName, string detailText) =>
    if debugCategoryEnabled(category)
        log.info("[" + SCRIPT_TAG + " " + STRATEGY_VERSION + "] " + syminfo.ticker + " tf=" + timeframe.period + " ET=" + debugEtStamp() + " bar=" + str.tostring(bar_index) + " " + eventName + "\n" + detailText)

debugStageEvent(int direction, string stageName, string triggerText, string reason) =>
    debugLog("stage", stageName + " " + dirName(direction), "trigger=" + triggerText + "\n" + debugCommonState(direction, reason))

debugOrderState(string eventName, int direction, string reason, float entryPrice, float stopPrice, float target1, float target2, float qtyValue, int scoreValue) =>
    float riskPerShare = math.abs(entryPrice - stopPrice)
    float actualRiskDollars = riskPerShare * qtyValue
    float riskQtyNoBuffer = riskPerShare > 0.0 ? math.floor(maxRiskDollars * riskQtySafetyPct / riskPerShare) : na
    float notionalQtyAtEntry = useNotionalCap and entryPrice > 0.0 ? math.floor(positionAmount / entryPrice) : na
    bool notionalCapBinds = useNotionalCap and not na(riskQtyNoBuffer) and not na(notionalQtyAtEntry) and notionalQtyAtEntry <= riskQtyNoBuffer
    string scoreOut = scoreValue >= 0 ? str.tostring(scoreValue) + "/7" : "--"
    string detail = "side=" + dirName(direction) + " reason=" + reason + " / " + reasonText(reason)
    detail := detail + "\nentry=" + fmtlib.fmtPrice(entryPrice) + " stop=" + fmtlib.fmtPrice(stopPrice) + " risk/share=" + fmtlib.fmtPrice(riskPerShare)
    detail := detail + "\nqty=" + fmtlib.qtyText(qtyValue) + " notional=" + dollarText(entryPrice * qtyValue) + " TP1=" + fmtlib.fmtPrice(target1) + " TP2=" + fmtlib.fmtPrice(target2) + " score=" + scoreOut
    detail := detail + "\nactual_risk_dollars=" + dollarText(actualRiskDollars) + " expected_1R_dollars=" + dollarText(actualRiskDollars) + " expected_final_dollars=" + dollarText(actualRiskDollars * target2RMultiple) + " final_target_r=" + fmtlib.fmt(target2RMultiple) + " notional_cap_binds=" + str.tostring(notionalCapBinds)
    detail := detail + "\n" + debugCommonState(direction, reason)
    debugLog("order", eventName, detail)

debugExtendedSkip(int direction, string activeBase) =>
    float distAtr = direction == 1 ? longMapDistanceAtr : shortMapDistanceAtr
    string detail = "active_side=" + dirName(direction) + " active_base=" + activeBase
    detail := detail + "\nreason=too_far_from_map dist=" + fmtlib.fmt(distAtr) + "ATR max=" + fmtlib.fmt(maxMapDistanceAtr) + "ATR"
    detail := detail + "\nrvol=" + fmtlib.fmt(rvol) + " min=" + fmtlib.fmt(rvolMin) + " expanded=" + str.tostring(volumeExpanded)
    detail := detail + "\n" + debugCommonState(direction, "too_far_from_map")
    debugLog("extended", "EXTENDED_SKIP " + dirName(direction), detail)

eventMarkerColor(string markerKind, int direction) =>
    markerKind == "confirmed" ? color.new(direction == 1 ? color.lime : color.red, 0) : markerKind == "stage" ? color.new(color.aqua, 0) : markerKind == "blocked" ? color.new(color.purple, 0) : markerKind == "watch" ? color.new(direction == 1 ? color.lime : color.red, 0) : color.new(color.orange, 0)

eventMarkerLane(string markerKind) =>
    markerKind == "confirmed" ? 0.52 : markerKind == "blocked" ? 0.64 : markerKind == "stage" ? 0.30 : markerKind == "watch" ? 0.42 : 0.20

eventMarkerY(int direction, string markerKind, float offsetAtr) =>
    float distance = math.max(offsetAtr + eventMarkerLane(markerKind), 0.20)
    direction == 1 ? low - atr * distance : high + atr * distance

eventMarkerSize(string markerKind) =>
    markerLabelSize == "Auto" ? (isMobileProfile() ? size.large : isMinimalProfile() ? size.small : (markerKind == "confirmed" or markerKind == "watch") ? size.normal : size.small) : markerSize()

drawEventMarker(int direction, string markerKind, string markerText, string detailText, float offsetAtr) =>
    bool boxed = markerKind == "stage" or markerKind == "blocked" or markerKind == "confirmed"
    labelStyle = boxed ? (direction == 1 ? label.style_label_up : label.style_label_down) : label.style_none
    color bgColor = boxed ? eventMarkerColor(markerKind, direction) : color.new(color.white, 100)
    color fgColor = markerKind == "stage" ? color.black : boxed ? color.white : eventMarkerColor(markerKind, direction)
    label.new(bar_index, eventMarkerY(direction, markerKind, offsetAtr), markerText, style=labelStyle, color=bgColor, textcolor=fgColor, size=eventMarkerSize(markerKind), tooltip=detailText)

drawSessionMarker(int direction, string markerText, string detailText, color markerColor, color markerTextColor, float offsetAtr) =>
    if showSessionMarkers
        label.new(bar_index, eventMarkerY(direction, "watch", offsetAtr), markerText, style=direction == 1 ? label.style_label_up : label.style_label_down, color=markerColor, textcolor=markerTextColor, size=markerSize(), tooltip=detailText)

blockMarkerText(string baseText, int direction, string reason) =>
    reason == "market_not_aligned" ? baseText + "\n" + marketBlockCode(direction) : baseText

gateDetail(int direction, string stageText, string triggerText, string reason) =>
    bool marketOk = direction == 1 ? marketLongOk : marketShortOk
    bool sectorOk = direction == 1 ? sectorLongOk : sectorShortOk
    bool relativeOk = direction == 1 ? relativeLongOk : relativeShortOk
    bool priceSideOk = direction == 1 ? priceLongSide : priceShortSide
    bool mapNearOk = direction == 1 ? longMapNear : shortMapNear
    float mapDistance = direction == 1 ? longMapDistanceAtr : shortMapDistanceAtr
    int score = direction == 1 ? scoreFor(marketLongOk, sectorLongOk, relativeLongOk, priceLongSide, longMapNear, volumeExpanded, trendScoreLongOk) : scoreFor(marketShortOk, sectorShortOk, relativeShortOk, priceShortSide, shortMapNear, volumeExpanded, trendScoreShortOk)
    string result = stageText + " " + dirName(direction) + " / " + triggerText
    result := result + "\nreason: " + reasonText(reason) + " / " + reason
    if reason == "market_not_aligned"
        result := result + "\nmarket block: " + marketBlockCode(direction) + " / " + marketBlockSummary(direction)
    result := result + "\nscore now: " + str.tostring(score) + "/7"
    result := result + "\nmarket/sector/RS: " + str.tostring(marketOk) + " / " + str.tostring(sectorOk) + " / " + str.tostring(relativeOk)
    result := result + "\nprice side/map near: " + str.tostring(priceSideOk) + " / " + str.tostring(mapNearOk) + " / dist " + fmtlib.fmt(mapDistance) + " ATR"
    result := result + "\nRVOL: " + fmtlib.fmt(rvol) + " / min " + fmtlib.fmt(rvolMin) + " / expanded " + str.tostring(volumeExpanded)
    result := result + "\nVWAP " + fmtlib.fmtPrice(vwap) + " / ORH " + fmtlib.fmtPrice(orHigh) + " / ORL " + fmtlib.fmtPrice(orLow)
    result := result + "\nRS stock-market/sector: " + fmtlib.bpsText(stockVsMarketBps) + " / " + fmtlib.bpsText(stockVsSectorBps)
    result := result + "\nsector vs market: " + fmtlib.bpsText(sectorVsMarketBps) + " / ETF " + sectorEtf
    result := result + "\n" + marketGateDetail()
    result

// -----------------------------------------------------------------------------
// Three-stage bare-K/volume pattern
// -----------------------------------------------------------------------------
var int longStage = 0
var int shortStage = 0
var int longStageBar = na
var int shortStageBar = na
var float longMapLevel = na
var float shortMapLevel = na
var float longImpulseVolume = na
var float shortImpulseVolume = na
var float longPullbackVolume = na
var float shortRetestVolume = na
var float longPullbackLow = na
var float shortRetestHigh = na
var float longReconfirmLevel = na
var float shortReconfirmLevel = na
var string longPatternReason = "none"
var string shortPatternReason = "none"

if confirmed and (newDay or forceFlatNow)
    longStage := 0
    shortStage := 0
    longStageBar := na
    shortStageBar := na
    longMapLevel := na
    shortMapLevel := na
    longImpulseVolume := na
    shortImpulseVolume := na
    longPullbackVolume := na
    shortRetestVolume := na
    longPullbackLow := na
    shortRetestHigh := na
    longReconfirmLevel := na
    shortReconfirmLevel := na
    longPatternReason := "none"
    shortPatternReason := "none"

bool hasPosition = strategy.position_size != 0
var bool pendingEntry = false
bool slotOpen = not hasPosition and not pendingEntry
string longBaseBlock = baseBlockReason(1)
string shortBaseBlock = baseBlockReason(-1)
bool longBaseOk = longBaseBlock == "passed"
bool shortBaseOk = shortBaseBlock == "passed"
int activeGateDirection = marketLongOk and not marketShortOk ? 1 : marketShortOk and not marketLongOk ? -1 : 0
string activeGateSide = activeGateDirection == 0 ? "NONE" : dirName(activeGateDirection)
string activeGateBase = activeGateDirection == 1 ? longBaseBlock : activeGateDirection == -1 ? shortBaseBlock : "no_active_market_side"
string oppositeGateSide = activeGateDirection == 1 ? "SHORT" : activeGateDirection == -1 ? "LONG" : "BOTH"
string oppositeGateBase = activeGateDirection == 1 ? shortBaseBlock : activeGateDirection == -1 ? longBaseBlock : "long=" + longBaseBlock + " short=" + shortBaseBlock
string activeGateLine = "active_side=" + activeGateSide + " active_base=" + activeGateBase + "\nopposite_side=" + oppositeGateSide + " opposite_base=" + oppositeGateBase
bool openingRangeStartedNow = confirmed and inOpeningRange and not (inOpeningRange[1] == true)
bool morningEntryOpenedNow = confirmed and inMorningEntry and not (inMorningEntry[1] == true)
bool morningEntryClosedNow = confirmed and not inMorningEntry and (inMorningEntry[1] == true)
bool afternoonEntryOpenedNow = confirmed and inAfternoonEntry and not (inAfternoonEntry[1] == true)
bool manageOnlyStartedNow = confirmed and manageOnly and not (manageOnly[1] == true)
bool forceFlatStartedNow = confirmed and forceFlatNow and not (forceFlatNow[1] == true)
bool entryWindowOpenedNow = morningEntryOpenedNow or afternoonEntryOpenedNow

if openingRangeStartedNow
    string orderStateText = enableStrategyOrders ? "ORDER ON" : "ORDER OFF"
    string orMarkerText = isMinimalProfile() ? (enableStrategyOrders ? "OR/ON" : "OR/OFF") : "OR\n09:30\n" + orderStateText
    string orMarkerTooltip = "09:30-09:45 New York time: build opening range only. No new entries.\n" + (enableStrategyOrders ? "Strategy orders are enabled. A valid L3 signal can call strategy.entry()." : "Strategy orders are disabled. The script keeps diagnostics only and will not call strategy.entry().")
    drawSessionMarker(1, orMarkerText, orMarkerTooltip, color.new(enableStrategyOrders ? color.gray : color.red, 0), color.white, 0.92)
    debugLog("session", "OR_START", "orders_enabled=" + str.tostring(enableStrategyOrders) + "\n" + debugCommonState(0, "session_open"))

if morningEntryOpenedNow
    drawSessionMarker(1, isMinimalProfile() ? "AM ON" : "AM ON\n09:45", "09:45-11:30 New York time: primary entry window is open after ORH/ORL are known.", color.new(color.lime, 0), color.black, 1.05)
    debugLog("session", "AM_ENTRY_ON", "primary entry window opened\n" + debugCommonState(0, "session_open"))

if morningEntryClosedNow
    drawSessionMarker(-1, isMinimalProfile() ? "AM OFF" : "AM OFF\n11:30", "11:30 New York time: primary entry window is closed. Midday no-trade period starts.", color.new(color.orange, 0), color.black, 1.05)
    debugLog("session", "AM_ENTRY_OFF", "primary entry window closed\n" + debugCommonState(0, "outside_entry_session"))

if afternoonEntryOpenedNow
    drawSessionMarker(1, isMinimalProfile() ? "PM ON" : "PM ON\n14:00", "14:00-15:30 New York time: strict continuation entry window is open.", color.new(color.teal, 0), color.white, 1.05)
    debugLog("session", "PM_ENTRY_ON", "strict continuation entry window opened\n" + debugCommonState(0, "session_open"))

if manageOnlyStartedNow
    drawSessionMarker(-1, isMinimalProfile() ? "MANAGE" : "MANAGE\n15:30", "15:30 New York time: no new entries. Manage open positions only.", color.new(color.blue, 0), color.white, 1.05)
    debugLog("session", "MANAGE_ONLY", "no new entries; manage open positions only\n" + debugCommonState(0, "outside_entry_session"))

if forceFlatStartedNow
    drawSessionMarker(-1, isMinimalProfile() ? "FLAT" : "FLAT\n15:45", "15:45 New York time: force flat window. Intraday strategy should not hold overnight.", color.new(color.red, 0), color.white, 1.18)
    debugLog("session", "FORCE_FLAT_START", "force flat window active\n" + debugCommonState(0, "force_flat_eod"))

if entryWindowOpenedNow
    string detail = "GATE state: entry window + market/trend filters"
    detail := detail + "\nOrders: " + (enableStrategyOrders ? "ON - strategy.entry allowed" : "OFF - diagnostics only")
    detail := detail + "\n" + activeGateLine
    detail := detail + "\nLong base: " + reasonText(longBaseBlock) + " / " + longBaseBlock + " / score " + str.tostring(scoreFor(marketLongOk, sectorLongOk, relativeLongOk, priceLongSide, longMapNear, volumeExpanded, trendScoreLongOk)) + "/7"
    detail := detail + "\nShort base: " + reasonText(shortBaseBlock) + " / " + shortBaseBlock + " / score " + str.tostring(scoreFor(marketShortOk, sectorShortOk, relativeShortOk, priceShortSide, shortMapNear, volumeExpanded, trendScoreShortOk)) + "/7"
    detail := detail + "\nVWAP " + fmtlib.fmtPrice(vwap) + " / ORH " + fmtlib.fmtPrice(orHigh) + " / ORL " + fmtlib.fmtPrice(orLow)
    detail := detail + "\nRVOL " + fmtlib.fmt(rvol) + " / RS " + fmtlib.bpsText(stockVsMarketBps) + " / " + fmtlib.bpsText(stockVsSectorBps)
    detail := detail + "\n" + marketGateDetail()
    detail := detail + "\nIf no L1/L2/L3 follows, no valid VWAP/OR price-action sequence formed."
    if showDiagnosticEventFlow
        drawEventMarker(priceLongSide ? 1 : -1, "watch", "GATE\n" + marketGateTag(), detail, 0.10)
    debugLog("session", "GATE " + marketGateTag(), activeGateLine + "\norders_enabled=" + str.tostring(enableStrategyOrders) + "\nlong_base=" + longBaseBlock + " short_base=" + shortBaseBlock + "\n" + debugCommonState(0, "gate"))
bool breakOrh = not na(orHigh) and close > orHigh and close[1] <= orHigh
bool reclaimVwap = close > vwap and close[1] <= vwap
bool breakOrl = not na(orLow) and close < orLow and close[1] >= orLow
bool rejectVwap = close < vwap and close[1] >= vwap
bool pmLongContinuationImpulse = pmLongContinuationOk and (breakOrh or (close > high[1] and close > open))
bool pmShortContinuationImpulse = pmShortContinuationOk and (breakOrl or (close < low[1] and close < open))
bool longMorningImpulseSource = inMorningEntry and (breakOrh or reclaimVwap)
bool shortMorningImpulseSource = inMorningEntry and (breakOrl or rejectVwap)
bool longImpulseAttempt = confirmed and slotOpen and orComplete and (longMorningImpulseSource or pmLongContinuationImpulse)
bool shortImpulseAttempt = confirmed and slotOpen and orComplete and (shortMorningImpulseSource or pmShortContinuationImpulse)
string longImpulseBlock = not longBaseOk ? longBaseBlock : not volumeExpanded ? "volume_missing" : badLongWick ? "bad_wick" : "passed"
string shortImpulseBlock = not shortBaseOk ? shortBaseBlock : not volumeExpanded ? "volume_missing" : badShortWick ? "bad_wick" : "passed"
bool longImpulse = longImpulseAttempt and longImpulseBlock == "passed"
bool shortImpulse = shortImpulseAttempt and shortImpulseBlock == "passed"
bool longExtendedSkip = confirmed and slotOpen and longBaseBlock == "too_far_from_map"
bool shortExtendedSkip = confirmed and slotOpen and shortBaseBlock == "too_far_from_map"
bool longExtendedSkipNow = longExtendedSkip and not (longExtendedSkip[1] == true)
bool shortExtendedSkipNow = shortExtendedSkip and not (shortExtendedSkip[1] == true)

if longExtendedSkipNow
    debugExtendedSkip(1, longBaseBlock)

if shortExtendedSkipNow
    debugExtendedSkip(-1, shortBaseBlock)

if longImpulseAttempt and longImpulseBlock != "passed"
    string trigger = breakOrh ? "ORH breakout attempt" : pmLongContinuationImpulse and not longMorningImpulseSource ? "PM ORH continuation attempt" : "VWAP reclaim attempt"
    debugStageEvent(1, "L1_BLOCK", trigger, longImpulseBlock)

if shortImpulseAttempt and shortImpulseBlock != "passed"
    string trigger = breakOrl ? "ORL breakdown attempt" : pmShortContinuationImpulse and not shortMorningImpulseSource ? "PM ORL continuation attempt" : "VWAP reject attempt"
    debugStageEvent(-1, "S1_BLOCK", trigger, shortImpulseBlock)

if showBlockedMarkers and longImpulseAttempt and longImpulseBlock != "passed"
    string trigger = breakOrh ? "ORH breakout attempt" : pmLongContinuationImpulse and not longMorningImpulseSource ? "PM ORH continuation attempt" : "VWAP reclaim attempt"
    drawEventMarker(1, "blocked", blockMarkerText("xL1", 1, longImpulseBlock), gateDetail(1, "L1 blocked", trigger, longImpulseBlock), 0.36)

if showBlockedMarkers and shortImpulseAttempt and shortImpulseBlock != "passed"
    string trigger = breakOrl ? "ORL breakdown attempt" : pmShortContinuationImpulse and not shortMorningImpulseSource ? "PM ORL continuation attempt" : "VWAP reject attempt"
    drawEventMarker(-1, "blocked", blockMarkerText("xS1", -1, shortImpulseBlock), gateDetail(-1, "S1 blocked", trigger, shortImpulseBlock), 0.36)

if longImpulse
    longStage := 1
    longStageBar := bar_index
    bool longUseOrMap = breakOrh or (pmLongContinuationImpulse and not longMorningImpulseSource)
    longMapLevel := longUseOrMap ? orHigh : vwap
    longImpulseVolume := barVolume
    longPullbackVolume := na
    longPatternReason := breakOrh ? "impulse_breakout_orh" : pmLongContinuationImpulse and not longMorningImpulseSource ? "pm_orh_continuation" : "impulse_reclaim_vwap"
    shortStage := 0
    shortRetestVolume := na
    debugStageEvent(1, "L1_PASS", longPatternReason, "passed")
    if showStageMarkers and not isMinimalProfile()
        drawEventMarker(1, "stage", "L1", gateDetail(1, "L1 passed", longPatternReason, "passed"), 0.12)

if shortImpulse
    shortStage := 1
    shortStageBar := bar_index
    bool shortUseOrMap = breakOrl or (pmShortContinuationImpulse and not shortMorningImpulseSource)
    shortMapLevel := shortUseOrMap ? orLow : vwap
    shortImpulseVolume := barVolume
    shortRetestVolume := na
    shortPatternReason := breakOrl ? "impulse_breakdown_orl" : pmShortContinuationImpulse and not shortMorningImpulseSource ? "pm_orl_continuation" : "impulse_reject_vwap"
    longStage := 0
    longPullbackVolume := na
    debugStageEvent(-1, "S1_PASS", shortPatternReason, "passed")
    if showStageMarkers and not isMinimalProfile()
        drawEventMarker(-1, "stage", "S1", gateDetail(-1, "S1 passed", shortPatternReason, "passed"), 0.12)

bool longStageExpired = longStage > 0 and not na(longStageBar) and bar_index - longStageBar > patternTtlBars
bool shortStageExpired = shortStage > 0 and not na(shortStageBar) and bar_index - shortStageBar > patternTtlBars
if confirmed and longStageExpired
    debugStageEvent(1, "LONG_PATTERN_EXPIRE", "pattern TTL bars exceeded", "pattern_expired")
    longStage := 0
    longPullbackVolume := na
    longPatternReason := "pattern_expired"
if confirmed and shortStageExpired
    debugStageEvent(-1, "SHORT_PATTERN_EXPIRE", "pattern TTL bars exceeded", "pattern_expired")
    shortStage := 0
    shortRetestVolume := na
    shortPatternReason := "pattern_expired"

bool longCanEvaluateL2 = longStage == 1 and not na(longStageBar) and bar_index > longStageBar
bool shortCanEvaluateL2 = shortStage == 1 and not na(shortStageBar) and bar_index > shortStageBar
bool longPullbackVolumeDry = longCanEvaluateL2 and barVolume <= nz(longImpulseVolume, barVolume) * pullbackVolumeMaxImpulseRatio and (na(volumeMa) or barVolume <= volumeMa * pullbackVolumeMaxMaRatio)
bool longPullbackHolds = longCanEvaluateL2 and not na(longMapLevel) and low >= longMapLevel - atr * 0.05 and close >= longMapLevel
bool longPullback = confirmed and slotOpen and longBaseOk and longPullbackVolumeDry and longPullbackHolds
bool shortRetestVolumeDry = shortCanEvaluateL2 and barVolume <= nz(shortImpulseVolume, barVolume) * pullbackVolumeMaxImpulseRatio and (na(volumeMa) or barVolume <= volumeMa * pullbackVolumeMaxMaRatio)
bool shortRetestHolds = shortCanEvaluateL2 and not na(shortMapLevel) and high <= shortMapLevel + atr * 0.05 and close <= shortMapLevel
bool shortRetest = confirmed and slotOpen and shortBaseOk and shortRetestVolumeDry and shortRetestHolds
bool longPullbackAttempt = confirmed and slotOpen and longCanEvaluateL2 and not na(longMapLevel) and (low <= longMapLevel + atr * 0.25 or close < longMapLevel - atr * 0.05)
bool shortRetestAttempt = confirmed and slotOpen and shortCanEvaluateL2 and not na(shortMapLevel) and (high >= shortMapLevel - atr * 0.25 or close > shortMapLevel + atr * 0.05)
string longPullbackBlock = not longBaseOk ? longBaseBlock : not longPullbackVolumeDry ? "pullback_volume_not_dry" : not longPullbackHolds ? "pullback_broke_map" : "passed"
string shortRetestBlock = not shortBaseOk ? shortBaseBlock : not shortRetestVolumeDry ? "pullback_volume_not_dry" : not shortRetestHolds ? "retest_broke_map" : "passed"

if longPullbackAttempt and not longPullback and longPullbackBlock != "passed"
    debugStageEvent(1, "L2_BLOCK", "pullback near VWAP/OR", longPullbackBlock)

if shortRetestAttempt and not shortRetest and shortRetestBlock != "passed"
    debugStageEvent(-1, "S2_BLOCK", "retest near VWAP/OR", shortRetestBlock)

if showBlockedMarkers and longPullbackAttempt and not longPullback and longPullbackBlock != "passed"
    drawEventMarker(1, "blocked", blockMarkerText("xL2", 1, longPullbackBlock), gateDetail(1, "L2 blocked", "pullback near VWAP/OR", longPullbackBlock), 0.38)

if showBlockedMarkers and shortRetestAttempt and not shortRetest and shortRetestBlock != "passed"
    drawEventMarker(-1, "blocked", blockMarkerText("xS2", -1, shortRetestBlock), gateDetail(-1, "S2 blocked", "retest near VWAP/OR", shortRetestBlock), 0.38)

if longStage == 1 and confirmed and close < nz(longMapLevel, close) - atr * 0.05
    debugStageEvent(1, "L2_RESET", "pullback broke VWAP/OR map", "pullback_broke_map")
    longStage := 0
    longPullbackVolume := na
    longPatternReason := "pullback_broke_map"
if shortStage == 1 and confirmed and close > nz(shortMapLevel, close) + atr * 0.05
    debugStageEvent(-1, "S2_RESET", "retest broke VWAP/OR map", "retest_broke_map")
    shortStage := 0
    shortRetestVolume := na
    shortPatternReason := "retest_broke_map"

if longPullback
    longStage := 2
    longStageBar := bar_index
    longPullbackLow := low
    longPullbackVolume := barVolume
    longReconfirmLevel := high
    longPatternReason := "low_volume_pullback_hold"
    debugStageEvent(1, "L2_PASS", longPatternReason, "passed")
    if showStageMarkers and not isMinimalProfile()
        drawEventMarker(1, "stage", "L2", gateDetail(1, "L2 passed", longPatternReason, "passed"), 0.18)

if shortRetest
    shortStage := 2
    shortStageBar := bar_index
    shortRetestHigh := high
    shortRetestVolume := barVolume
    shortReconfirmLevel := low
    shortPatternReason := "low_volume_retest_hold"
    debugStageEvent(-1, "S2_PASS", shortPatternReason, "passed")
    if showStageMarkers and not isMinimalProfile()
        drawEventMarker(-1, "stage", "S2", gateDetail(-1, "S2 passed", shortPatternReason, "passed"), 0.18)

// -----------------------------------------------------------------------------
// Candidate build, validation, and order submission
// -----------------------------------------------------------------------------
riskSafetyBuffer() =>
    riskQtyBufferAtr > 0.0 ? math.max(syminfo.mintick, atr * riskQtyBufferAtr) : 0.0

calcRiskQty(float entryPrice, float stopPrice) =>
    float perShareRiskWithBuffer = math.abs(entryPrice - stopPrice) + riskSafetyBuffer()
    float riskQty = perShareRiskWithBuffer > 0.0 ? math.floor(maxRiskDollars * riskQtySafetyPct / perShareRiskWithBuffer) : 0.0
    float notionalQty = useNotionalCap and entryPrice > 0.0 ? math.floor(positionAmount / entryPrice) : riskQty
    math.max(0.0, math.min(riskQty, notionalQty))

calcRiskQtyRaw(float entryPrice, float stopPrice) =>
    float perShareRiskWithBuffer = math.abs(entryPrice - stopPrice) + riskSafetyBuffer()
    perShareRiskWithBuffer > 0.0 ? math.floor(maxRiskDollars * riskQtySafetyPct / perShareRiskWithBuffer) : 0.0

calcNotionalQty(float entryPrice) =>
    useNotionalCap and entryPrice > 0.0 ? math.floor(positionAmount / entryPrice) : na

stopDistancePct(float entryPrice, float stopPrice) =>
    entryPrice > 0.0 ? math.abs(entryPrice - stopPrice) / entryPrice * 100.0 : na

basePayload(string eventType, string eventIdValue, string positionIdValue) =>
    payloadlib.basePayload(eventType, eventIdValue, syminfo.ticker, syminfo.prefix, timeframe.period, SCRIPT_TAG, STRATEGY_VERSION, positionIdValue, time, time_close, timenow, time, bar_index)

planId(string directionText, string setup, string intent) =>
    payloadlib.planId(syminfo.ticker, directionText, time, timeframe.period, setup, intent)

dirText(int direction) =>
    payloadlib.dirText(direction)

orderIdForDirection(int direction) =>
    payloadlib.orderIdForDirection(direction)

string selectedSetup = "none"
int selectedDirection = 0
float selectedEntry = na
float selectedStop = na
float selectedRisk = na
float selectedTarget1 = na
float selectedTarget2 = na
float selectedQty = 0.0
float selectedRiskQty = 0.0
float selectedNotionalQty = 0.0
float selectedStopPct = na
string selectedBlockReason = "no_candidate"
string selectedPatternStage = "none"
string selectedPatternReason = "none"
int selectedScore = 0

bool longCanEvaluateL3 = longStage == 2 and not na(longStageBar) and bar_index > longStageBar
bool shortCanEvaluateL3 = shortStage == 2 and not na(shortStageBar) and bar_index > shortStageBar
bool longReconfirmAttempt = confirmed and slotOpen and longCanEvaluateL3 and close > nz(longReconfirmLevel, high)
bool shortReconfirmAttempt = confirmed and slotOpen and shortCanEvaluateL3 and close < nz(shortReconfirmLevel, low)
string longReconfirmBaseBlock = reconfirmBaseBlockReason(1)
string shortReconfirmBaseBlock = reconfirmBaseBlockReason(-1)
bool longReconfirmBaseOk = longReconfirmBaseBlock == "passed"
bool shortReconfirmBaseOk = shortReconfirmBaseBlock == "passed"
float l3VsPrevVolume = not na(barVolume[1]) and barVolume[1] > 0.0 ? barVolume / barVolume[1] : na
float longL3VsL2Volume = not na(longPullbackVolume) and longPullbackVolume > 0.0 ? barVolume / longPullbackVolume : na
float shortL3VsL2Volume = not na(shortRetestVolume) and shortRetestVolume > 0.0 ? barVolume / shortRetestVolume : na
float longL3CloseLocation = barRange > 0.0 ? (close - low) / barRange : 0.0
float shortL3CloseLocation = barRange > 0.0 ? (high - close) / barRange : 0.0
bool longL3CloseStrong = longL3CloseLocation >= l3CloseLocationMin
bool shortL3CloseStrong = shortL3CloseLocation >= l3CloseLocationMin
bool l3VolumeAlive = rvol >= l3DeadRvolMin
bool longL3VolumeRecovered = rvol >= l3RecoveryRvolMin or (not na(longL3VsL2Volume) and longL3VsL2Volume >= l3VolumeVsL2Min) or (not na(l3VsPrevVolume) and l3VsPrevVolume >= l3VolumeVsPrevMin)
bool shortL3VolumeRecovered = rvol >= l3RecoveryRvolMin or (not na(shortL3VsL2Volume) and shortL3VsL2Volume >= l3VolumeVsL2Min) or (not na(l3VsPrevVolume) and l3VsPrevVolume >= l3VolumeVsPrevMin)
bool longL3VolumeOk = l3VolumeAlive and longL3VolumeRecovered
bool shortL3VolumeOk = l3VolumeAlive and shortL3VolumeRecovered
string longL3VolumeReason = not l3VolumeAlive ? "l3_volume_dead" : not longL3VolumeRecovered ? "l3_volume_not_recovered" : "passed"
string shortL3VolumeReason = not l3VolumeAlive ? "l3_volume_dead" : not shortL3VolumeRecovered ? "l3_volume_not_recovered" : "passed"
string longReconfirmBlock = not longReconfirmBaseOk ? longReconfirmBaseBlock : not longL3CloseStrong ? "l3_weak_close" : longL3VolumeReason != "passed" ? longL3VolumeReason : badLongWick ? "bad_wick" : "passed"
string shortReconfirmBlock = not shortReconfirmBaseOk ? shortReconfirmBaseBlock : not shortL3CloseStrong ? "l3_weak_close" : shortL3VolumeReason != "passed" ? shortL3VolumeReason : badShortWick ? "bad_wick" : "passed"
bool longReconfirmRaw = longReconfirmAttempt and longReconfirmBlock == "passed"
bool shortReconfirmRaw = shortReconfirmAttempt and shortReconfirmBlock == "passed"
l3VolumeDetail(int direction) =>
    float vsL2 = direction == 1 ? longL3VsL2Volume : shortL3VsL2Volume
    float closeLocation = direction == 1 ? longL3CloseLocation : shortL3CloseLocation
    bool volumeOk = direction == 1 ? longL3VolumeOk : shortL3VolumeOk
    string volumeReason = direction == 1 ? longL3VolumeReason : shortL3VolumeReason
    bool closeStrong = direction == 1 ? longL3CloseStrong : shortL3CloseStrong
    "l3_rvol=" + fmtlib.fmt(rvol) + " l3_vs_l2=" + fmtlib.fmt(vsL2) + " l3_vs_prev=" + fmtlib.fmt(l3VsPrevVolume) + " l3_volume_ok=" + str.tostring(volumeOk) + " l3_volume_reason=" + volumeReason + " l3_close_loc=" + fmtlib.fmt(closeLocation) + " l3_close_ok=" + str.tostring(closeStrong)

int longReconfirmScore = scoreFor(marketLongOk, sectorLongOk, relativeLongOk, priceLongSide, longReconfirmMapNear, longL3VolumeOk, trendScoreLongOk)
int shortReconfirmScore = scoreFor(marketShortOk, sectorShortOk, relativeShortOk, priceShortSide, shortReconfirmMapNear, shortL3VolumeOk, trendScoreShortOk)
int minScoreNow = inAfternoonEntry ? minAfternoonScore : minMorningScore
bool longScoreOk = longReconfirmScore >= minScoreNow
bool shortScoreOk = shortReconfirmScore >= minScoreNow

if longReconfirmAttempt and not longReconfirmRaw and longReconfirmBlock != "passed"
    debugStageEvent(1, "L3_BLOCK", "2m reconfirm breakout\n" + l3VolumeDetail(1), longReconfirmBlock)

if shortReconfirmAttempt and not shortReconfirmRaw and shortReconfirmBlock != "passed"
    debugStageEvent(-1, "S3_BLOCK", "2m reconfirm breakdown\n" + l3VolumeDetail(-1), shortReconfirmBlock)

if showBlockedMarkers and longReconfirmAttempt and not longReconfirmRaw and longReconfirmBlock != "passed"
    drawEventMarker(1, "blocked", blockMarkerText("xL3", 1, longReconfirmBlock), gateDetail(1, "L3 blocked", "2m reconfirm breakout\n" + l3VolumeDetail(1), longReconfirmBlock), 0.40)

if showBlockedMarkers and shortReconfirmAttempt and not shortReconfirmRaw and shortReconfirmBlock != "passed"
    drawEventMarker(-1, "blocked", blockMarkerText("xS3", -1, shortReconfirmBlock), gateDetail(-1, "S3 blocked", "2m reconfirm breakdown\n" + l3VolumeDetail(-1), shortReconfirmBlock), 0.40)

if longReconfirmRaw
    selectedSetup := "vwap_or_volume_retest_long"
    selectedDirection := 1
    selectedEntry := close
    selectedStop := longPullbackLow - atr * atrBufferMult
    selectedRisk := math.abs(selectedEntry - selectedStop)
    selectedTarget1 := selectedEntry + selectedRisk
    selectedTarget2 := selectedEntry + selectedRisk * target2RMultiple
    selectedRiskQty := calcRiskQtyRaw(selectedEntry, selectedStop)
    selectedNotionalQty := calcNotionalQty(selectedEntry)
    selectedQty := calcRiskQty(selectedEntry, selectedStop)
    selectedQty := halfSizeNext ? math.floor(selectedQty * 0.5) : selectedQty
    selectedStopPct := stopDistancePct(selectedEntry, selectedStop)
    selectedScore := longReconfirmScore
    selectedPatternStage := "reconfirm_breakout_long"
    selectedPatternReason := longPatternReason
    bool longStopStructureOk = not na(longPullbackLow) and selectedStop < longPullbackLow and selectedStop < selectedEntry
    selectedBlockReason := not longScoreOk ? "score_too_low" : not longStopStructureOk ? "invalid_stop_structure" : selectedStopPct < minStopPct ? "stop_too_tight" : selectedStopPct > maxStopPct ? "stop_too_wide" : selectedQty < minQty ? "qty_too_small" : "passed"
    debugStageEvent(1, selectedBlockReason == "passed" ? "L3_PASS" : "L3_CANDIDATE_BLOCK", selectedPatternReason + "\n" + l3VolumeDetail(1), selectedBlockReason)
else if shortReconfirmRaw
    selectedSetup := "vwap_or_volume_retest_short"
    selectedDirection := -1
    selectedEntry := close
    selectedStop := shortRetestHigh + atr * atrBufferMult
    selectedRisk := math.abs(selectedEntry - selectedStop)
    selectedTarget1 := selectedEntry - selectedRisk
    selectedTarget2 := selectedEntry - selectedRisk * target2RMultiple
    selectedRiskQty := calcRiskQtyRaw(selectedEntry, selectedStop)
    selectedNotionalQty := calcNotionalQty(selectedEntry)
    selectedQty := calcRiskQty(selectedEntry, selectedStop)
    selectedQty := halfSizeNext ? math.floor(selectedQty * 0.5) : selectedQty
    selectedStopPct := stopDistancePct(selectedEntry, selectedStop)
    selectedScore := shortReconfirmScore
    selectedPatternStage := "reconfirm_breakdown_short"
    selectedPatternReason := shortPatternReason
    bool shortStopStructureOk = not na(shortRetestHigh) and selectedStop > shortRetestHigh and selectedStop > selectedEntry
    selectedBlockReason := not shortScoreOk ? "score_too_low" : not shortStopStructureOk ? "invalid_stop_structure" : selectedStopPct < minStopPct ? "stop_too_tight" : selectedStopPct > maxStopPct ? "stop_too_wide" : selectedQty < minQty ? "qty_too_small" : "passed"
    debugStageEvent(-1, selectedBlockReason == "passed" ? "S3_PASS" : "S3_CANDIDATE_BLOCK", selectedPatternReason + "\n" + l3VolumeDetail(-1), selectedBlockReason)
else
    selectedBlockReason := longBaseBlock != "passed" ? longBaseBlock : shortBaseBlock != "passed" ? shortBaseBlock : "no_candidate"

if selectedDirection != 0 and selectedBlockReason == "passed" and not enableStrategyOrders
    selectedBlockReason := "orders_disabled"

bool blockedCandidateEvent = confirmed and selectedDirection != 0 and selectedBlockReason != "passed" and (longReconfirmRaw or shortReconfirmRaw)
if blockedCandidateEvent
    debugOrderState("ORDER_BLOCK", selectedDirection, selectedBlockReason, selectedEntry, selectedStop, selectedTarget1, selectedTarget2, selectedQty, selectedScore)

bool blockedCandidate = showBlockedMarkers and blockedCandidateEvent
if blockedCandidate
    drawEventMarker(selectedDirection, "blocked", blockMarkerText(selectedDirection == 1 ? "xL3" : "xS3", selectedDirection, selectedBlockReason), blockedMarkerTooltip(selectedDirection, selectedBlockReason, selectedEntry, selectedStop, selectedQty, selectedStopPct, selectedScore), 0.44)

// -----------------------------------------------------------------------------
// Order state shared by payload builders and lifecycle.
// -----------------------------------------------------------------------------
var bool activePosition = false
var int activeDirection = 0
var string activeSetup = ""
var string activeSignalId = ""
var string activeTradeGroupId = ""
var string activePositionId = ""
var float activeEntry = na
var float activeStop = na
var float activeTarget1 = na
var float activeTarget2 = na
var float activeQty = na
var float activeInitialRisk = na
var int activeSignalBar = na
var int activeEntryBar = na
var bool activeBreakevenDone = false
var float activeMfeR = 0.0
var int activeRiskUpdateSeq = 0
var string activeManualExitReason = ""

// -----------------------------------------------------------------------------
// Payload builders
// -----------------------------------------------------------------------------
commonDiagnostics() =>
    string result = "," + payloadlib.jsonStr("risk_model", RISK_MODEL) + "," + payloadlib.jsonStr("tp_sl_model", TP_SL_MODEL) + "," + payloadlib.jsonStr("trade_model", TRADE_MODEL)
    result := result + "," + payloadlib.jsonStr("sector_etf", sectorEtf) + "," + payloadlib.jsonStr("sector_group", sectorGroup) + "," + payloadlib.jsonStr("industry_tag", industryTag)
    result := result + "," + payloadlib.jsonStr("relative_benchmark", metalib.relativeBenchmark(syminfo.ticker)) + "," + payloadlib.jsonStr("metadata_version", metalib.metadataVersion()) + "," + payloadlib.jsonStr("metadata_source", "pine_lib_static")
    result := result + "," + payloadlib.jsonStr("trend_mode", trendFilterMode) + "," + payloadlib.jsonInt("context_trend_score_long", contextTrendLongScore) + "," + payloadlib.jsonInt("context_trend_score_short", contextTrendShortScore)
    result := result + "," + payloadlib.jsonBool("market_trend_long_ok", marketTrendLongOk) + "," + payloadlib.jsonBool("market_trend_short_ok", marketTrendShortOk) + "," + payloadlib.jsonBool("trend_gate_long_ok", trendGateLongOk) + "," + payloadlib.jsonBool("trend_gate_short_ok", trendGateShortOk)
    result := result + "," + payloadlib.jsonNum("orh", orHigh) + "," + payloadlib.jsonNum("orl", orLow) + "," + payloadlib.jsonNum("vwap", vwap) + "," + payloadlib.jsonNum("rvol", rvol) + "," + payloadlib.jsonNum("volume_ma", volumeMa)
    result := result + "," + payloadlib.jsonNum("l3_vs_l2_long", longL3VsL2Volume) + "," + payloadlib.jsonNum("l3_vs_l2_short", shortL3VsL2Volume) + "," + payloadlib.jsonNum("l3_vs_prev", l3VsPrevVolume) + "," + payloadlib.jsonBool("l3_volume_long_ok", longL3VolumeOk) + "," + payloadlib.jsonBool("l3_volume_short_ok", shortL3VolumeOk)
    result := result + "," + payloadlib.jsonNum("stock_change_bps", stockChangeBps) + "," + payloadlib.jsonNum("relative_strength_bps", stockVsMarketBps) + "," + payloadlib.jsonNum("sector_relative_strength_bps", stockVsSectorBps) + "," + payloadlib.jsonNum("sector_vs_market_bps", sectorVsMarketBps)
    result := result + "," + payloadlib.jsonNum("atr", atr) + "," + payloadlib.jsonNum("atr_stop_buffer", atr * atrBufferMult) + "," + payloadlib.jsonNum("position_amount", positionAmount) + "," + payloadlib.jsonNum("max_risk_dollars", maxRiskDollars)
    result

buildEntryPayload(string eventIdValue, string signalIdValue, string tradeGroupIdValue, string positionIdValue) =>
    basePayload("entry", eventIdValue, positionIdValue) + "," + payloadlib.jsonStr("signal_id", signalIdValue) + "," + payloadlib.jsonStr("origin_signal_id", signalIdValue) + "," + payloadlib.jsonStr("trade_group_id", tradeGroupIdValue) + "," + payloadlib.jsonStr("direction", dirText(selectedDirection)) + "," + payloadlib.jsonStr("position_side", dirText(selectedDirection)) + "," + payloadlib.jsonStr("setup", selectedSetup) + "," + payloadlib.jsonStr("entry_setup", selectedSetup) + "," + payloadlib.jsonStr("signal", selectedSetup) + "," + payloadlib.jsonStr("reason", "entry_signal") + "," + payloadlib.jsonNum("entry", selectedEntry) + "," + payloadlib.jsonNum("entry_price", selectedEntry) + "," + payloadlib.jsonNum("planned_entry_price", selectedEntry) + "," + payloadlib.jsonNum("submitted_entry_limit_price", selectedEntry) + "," + payloadlib.jsonNum("stop_loss", selectedStop) + "," + payloadlib.jsonNum("take_profit", selectedTarget2) + "," + payloadlib.jsonNum("safety_take_profit", selectedTarget2) + "," + payloadlib.jsonNum("target_checkpoint", selectedTarget1) + "," + payloadlib.jsonNum("runner_activation_price", selectedTarget1) + "," + payloadlib.jsonNum("runner_activation_r", 1.0) + "," + payloadlib.jsonNum("shares", selectedQty) + "," + payloadlib.jsonStr("entry_intent", "market_next_bar") + "," + payloadlib.jsonStr("trial_risk_mode", "full") + "," + payloadlib.jsonStr("pattern_stage", selectedPatternStage) + "," + payloadlib.jsonStr("pattern_reason", selectedPatternReason) + "," + payloadlib.jsonInt("score", selectedScore) + "," + payloadlib.jsonStr("block_reason", selectedBlockReason) + "," + payloadlib.jsonNum("initial_risk", selectedRisk) + "," + payloadlib.jsonNum("target_1r", selectedTarget1) + "," + payloadlib.jsonNum("target_2r", selectedTarget2) + "," + payloadlib.jsonNum("target_final", selectedTarget2) + "," + payloadlib.jsonNum("target_final_r", target2RMultiple) + "," + payloadlib.jsonNum("risk_qty", selectedRiskQty) + "," + payloadlib.jsonNum("notional_qty", selectedNotionalQty) + "," + payloadlib.jsonNum("actual_risk_dollars", selectedRisk * selectedQty) + "," + payloadlib.jsonNum("expected_1r_dollars", selectedRisk * selectedQty) + "," + payloadlib.jsonNum("expected_2r_dollars", selectedRisk * selectedQty * 2.0) + "," + payloadlib.jsonNum("expected_final_dollars", selectedRisk * selectedQty * target2RMultiple) + "," + payloadlib.jsonBool("notional_cap_binds", useNotionalCap and not na(selectedNotionalQty) and selectedNotionalQty <= selectedRiskQty) + commonDiagnostics() + "}"

buildEntryFillPayload(string eventIdValue, string positionIdValue, float actualFillPrice) =>
    basePayload("entry_fill", eventIdValue, positionIdValue) + "," + payloadlib.jsonStr("signal_id", activeSignalId) + "," + payloadlib.jsonStr("origin_signal_id", activeSignalId) + "," + payloadlib.jsonStr("trade_group_id", activeTradeGroupId) + "," + payloadlib.jsonStr("direction", dirText(activeDirection)) + "," + payloadlib.jsonStr("setup", activeSetup) + "," + payloadlib.jsonNum("entry", actualFillPrice) + "," + payloadlib.jsonNum("planned_entry_price", activeEntry) + "," + payloadlib.jsonNum("stop_loss", activeStop) + "," + payloadlib.jsonNum("take_profit", activeTarget2) + "," + payloadlib.jsonNum("shares", activeQty) + "," + payloadlib.jsonStr("entry_intent", "market_next_bar") + commonDiagnostics() + "}"

buildRiskUpdatePayload(string eventIdValue, string positionIdValue, string reason, float previousStop, float newStop) =>
    basePayload("risk_update", eventIdValue, positionIdValue) + "," + payloadlib.jsonStr("signal_id", activeSignalId) + "," + payloadlib.jsonStr("origin_signal_id", activeSignalId) + "," + payloadlib.jsonStr("trade_group_id", activeTradeGroupId) + "," + payloadlib.jsonStr("direction", dirText(activeDirection)) + "," + payloadlib.jsonStr("setup", activeSetup) + "," + payloadlib.jsonStr("reason", reason) + "," + payloadlib.jsonStr("risk_update_reason", reason) + "," + payloadlib.jsonInt("risk_update_seq", activeRiskUpdateSeq) + "," + payloadlib.jsonRequestedSides("stop_loss") + "," + payloadlib.jsonNum("previous_stop_loss", previousStop) + "," + payloadlib.jsonNum("new_stop_loss", newStop) + "," + payloadlib.jsonNum("stop_loss", newStop) + "," + payloadlib.jsonNum("take_profit", activeTarget2) + "," + payloadlib.jsonNum("safety_take_profit", activeTarget2) + "," + payloadlib.jsonNum("runner_activation_price", activeTarget1) + "," + payloadlib.jsonNum("runner_activation_r", 1.0) + "," + payloadlib.jsonBool("runner_enabled", true) + "," + payloadlib.jsonBool("runner_active", activeBreakevenDone) + commonDiagnostics() + "}"

buildExitPayload(string eventIdValue, string positionIdValue, string reason, float exitPrice, float pnlPerShare) =>
    basePayload("exit", eventIdValue, positionIdValue) + "," + payloadlib.jsonStr("signal_id", activeSignalId) + "," + payloadlib.jsonStr("origin_signal_id", activeSignalId) + "," + payloadlib.jsonStr("trade_group_id", activeTradeGroupId) + "," + payloadlib.jsonStr("direction", dirText(activeDirection)) + "," + payloadlib.jsonStr("setup", activeSetup) + "," + payloadlib.jsonStr("reason", reason) + "," + payloadlib.jsonStr("exit_reason", reason) + "," + payloadlib.jsonNum("exit_price", exitPrice) + "," + payloadlib.jsonNum("entry", activeEntry) + "," + payloadlib.jsonNum("stop_loss", activeStop) + "," + payloadlib.jsonNum("take_profit", activeTarget2) + "," + payloadlib.jsonNum("shares", activeQty) + "," + payloadlib.jsonNum("pnl", pnlPerShare * activeQty) + "," + payloadlib.jsonNum("pnl_per_share", pnlPerShare) + "," + payloadlib.jsonNum("pnl_r", activeInitialRisk > 0.0 ? pnlPerShare / activeInitialRisk : na) + "," + payloadlib.jsonBool("runner_active", activeBreakevenDone) + commonDiagnostics() + "}"

buildCancelPayload(string eventIdValue, string positionIdValue, string reason) =>
    basePayload("cancel", eventIdValue, positionIdValue) + "," + payloadlib.jsonStr("signal_id", activeSignalId) + "," + payloadlib.jsonStr("origin_signal_id", activeSignalId) + "," + payloadlib.jsonStr("trade_group_id", activeTradeGroupId) + "," + payloadlib.jsonStr("direction", dirText(activeDirection)) + "," + payloadlib.jsonStr("setup", activeSetup) + "," + payloadlib.jsonStr("reason", reason) + "," + payloadlib.jsonStr("cancel_reason", reason) + "," + payloadlib.jsonStr("cancel_scope", "unfilled_entry") + commonDiagnostics() + "}"

// -----------------------------------------------------------------------------
// Order lifecycle
// -----------------------------------------------------------------------------
bool submitNewPlan = confirmed and enableStrategyOrders and selectedBlockReason == "passed" and selectedDirection != 0 and selectedQty >= minQty and slotOpen
if submitNewPlan
    string directionText = dirText(selectedDirection)
    string eventPlanId = planId(directionText, selectedSetup, "market_next_bar")
    string signalId = eventPlanId + "_signal"
    string tradeGroupId = eventPlanId + "_group"
    string positionId = eventPlanId + "_pos"
    strategy.entry(orderIdForDirection(selectedDirection), selectedDirection == 1 ? strategy.long : strategy.short, qty=selectedQty, comment=(selectedDirection == 1 ? "L " : "S ") + fmtlib.fmtPrice(selectedEntry) + " Q" + fmtlib.qtyText(selectedQty))
    pendingEntry := true
    activePosition := false
    activeDirection := selectedDirection
    activeSetup := selectedSetup
    activeSignalId := signalId
    activeTradeGroupId := tradeGroupId
    activePositionId := positionId
    activeEntry := selectedEntry
    activeStop := selectedStop
    activeTarget1 := selectedTarget1
    activeTarget2 := selectedTarget2
    activeQty := selectedQty
    activeInitialRisk := selectedRisk
    activeSignalBar := bar_index
    activeEntryBar := na
    activeBreakevenDone := false
    activeMfeR := 0.0
    activeRiskUpdateSeq := 0
    activeManualExitReason := ""
    dailyTrades += 1
    longStage := 0
    shortStage := 0
    debugOrderState("ORDER_SUBMIT", selectedDirection, "entry_signal", selectedEntry, selectedStop, selectedTarget1, selectedTarget2, selectedQty, selectedScore)
    if enableAlerts
        alert(buildEntryPayload(eventPlanId, signalId, tradeGroupId, positionId), alert.freq_all)
    if showOrderCaseLabels
        label.new(bar_index, selectedDirection == 1 ? low - atr : high + atr, orderCaseText(selectedDirection, selectedEntry, selectedStop, selectedTarget2, selectedQty), style=selectedDirection == 1 ? label.style_label_up : label.style_label_down, color=color.new(selectedDirection == 1 ? color.lime : color.red, 0), textcolor=selectedDirection == 1 ? color.black : color.white, size=orderMarkerSize(), tooltip=orderCaseTooltip(selectedDirection, selectedEntry, selectedStop, selectedTarget1, selectedTarget2, selectedQty, selectedRiskQty, selectedNotionalQty, selectedScore))

bool positionOpenedNow = pendingEntry and strategy.position_size != 0 and strategy.position_size[1] == 0
if confirmed and positionOpenedNow
    pendingEntry := false
    activePosition := true
    activeEntryBar := bar_index
    activeEntry := strategy.position_avg_price
    activeInitialRisk := math.abs(activeEntry - activeStop)
    activeTarget1 := activeEntry + activeInitialRisk * activeDirection
    activeTarget2 := activeEntry + activeInitialRisk * activeDirection * target2RMultiple
    debugOrderState("ENTRY_FILL", activeDirection, "entry_fill", strategy.position_avg_price, activeStop, activeTarget1, activeTarget2, activeQty, -1)
    if enableFillConfirmAlerts and enableAlerts
        alert(buildEntryFillPayload(planId("entry_fill", activeSetup, "market_next_bar"), activePositionId, strategy.position_avg_price), alert.freq_all)
    if showOrderCaseLabels
        label.new(bar_index, activeDirection == 1 ? low - atr * 0.5 : high + atr * 0.5, fillMarkerText(activeDirection, strategy.position_avg_price, activeQty), style=activeDirection == 1 ? label.style_label_up : label.style_label_down, color=color.new(color.blue, 0), textcolor=color.white, size=markerSize(), tooltip="actual strategy fill\nentry: " + fmtlib.fmtPrice(strategy.position_avg_price) + "\nqty: " + fmtlib.qtyText(activeQty))

bool pendingEntryStale = confirmed and pendingEntry and not hasPosition and not na(activeSignalBar) and bar_index > activeSignalBar + 2
if pendingEntryStale
    debugOrderState("ENTRY_CANCEL", activeDirection, "entry_not_filled", activeEntry, activeStop, activeTarget1, activeTarget2, activeQty, -1)
    strategy.cancel(orderIdForDirection(activeDirection))
    if enableAlerts
        alert(buildCancelPayload(planId("cancel", activeSetup, "market_next_bar"), activePositionId, "entry_not_filled"), alert.freq_all)
    pendingEntry := false
    activeDirection := 0

if confirmed and activePosition and hasPosition
    int barsInTrade = na(activeEntryBar) ? 0 : bar_index - activeEntryBar
    float mfeNow = activeInitialRisk > 0.0 ? (activeDirection == 1 ? (high - activeEntry) / activeInitialRisk : (activeEntry - low) / activeInitialRisk) : 0.0
    activeMfeR := math.max(nz(activeMfeR, 0.0), mfeNow)
    bool target1Touched = activeDirection == 1 ? high >= activeTarget1 : low <= activeTarget1
    if target1Touched and not activeBreakevenDone
        float previousStop = activeStop
        float breakevenStop = activeEntry + activeInitialRisk * breakevenOffsetR * activeDirection
        activeStop := activeDirection == 1 ? math.max(activeStop, breakevenStop) : math.min(activeStop, breakevenStop)
        activeBreakevenDone := true
        activeRiskUpdateSeq += 1
        debugOrderState("TP1_BREAKEVEN", activeDirection, "runner_activation", activeEntry, activeStop, activeTarget1, activeTarget2, activeQty, -1)
        if enableAlerts
            alert(buildRiskUpdatePayload(planId("risk_update", activeSetup, "market_next_bar"), activePositionId, "runner_activation", previousStop, activeStop), alert.freq_all)
        if showManagementMarkers
            label.new(bar_index, activeTarget1, managementMarkerText("TP1/BE", "runner_activation", activeTarget1, 1.0), style=activeDirection == 1 ? label.style_label_down : label.style_label_up, color=color.new(color.blue, 0), textcolor=color.white, size=markerSize(), tooltip="1R touched; stop moved from " + fmtlib.fmtPrice(previousStop) + " to " + fmtlib.fmtPrice(activeStop))
    bool timeStopNow = not activeBreakevenDone and barsInTrade >= timeStopBars and activeMfeR < timeStopMinMfeR
    if timeStopNow and activeManualExitReason == ""
        activeManualExitReason := "time_stop"
        debugOrderState("CLOSE_REQUEST", activeDirection, "time_stop", activeEntry, activeStop, activeTarget1, activeTarget2, activeQty, -1)
        strategy.close(orderIdForDirection(activeDirection), comment="TIME " + fmtlib.moneyText((close - activeEntry) * activeDirection * activeQty) + " X" + fmtlib.fmtPrice(close))
    else if forceFlatNow and activeManualExitReason == ""
        activeManualExitReason := "force_flat_eod"
        debugOrderState("CLOSE_REQUEST", activeDirection, "force_flat_eod", activeEntry, activeStop, activeTarget1, activeTarget2, activeQty, -1)
        strategy.close(orderIdForDirection(activeDirection), comment="EOD " + fmtlib.moneyText((close - activeEntry) * activeDirection * activeQty) + " X" + fmtlib.fmtPrice(close))
    else
        if activeDirection == 1
            strategy.exit("VOR-L-TP1", from_entry="TV-VOR-L", qty_percent=tp1ExitPct, stop=activeStop, limit=activeTarget1, comment_profit="TP1 " + fmtlib.fmtPrice(activeTarget1), comment_loss="SL " + fmtlib.fmtPrice(activeStop))
            strategy.exit("VOR-L-TP2", from_entry="TV-VOR-L", qty_percent=100 - tp1ExitPct, stop=activeStop, limit=activeTarget2, comment_profit="TP2 " + fmtlib.fmtPrice(activeTarget2), comment_loss=(activeBreakevenDone ? "BE " : "SL ") + fmtlib.fmtPrice(activeStop))
        if activeDirection == -1
            strategy.exit("VOR-S-TP1", from_entry="TV-VOR-S", qty_percent=tp1ExitPct, stop=activeStop, limit=activeTarget1, comment_profit="TP1 " + fmtlib.fmtPrice(activeTarget1), comment_loss="SL " + fmtlib.fmtPrice(activeStop))
            strategy.exit("VOR-S-TP2", from_entry="TV-VOR-S", qty_percent=100 - tp1ExitPct, stop=activeStop, limit=activeTarget2, comment_profit="TP2 " + fmtlib.fmtPrice(activeTarget2), comment_loss=(activeBreakevenDone ? "BE " : "SL ") + fmtlib.fmtPrice(activeStop))

bool positionClosedNow = activePosition and strategy.position_size == 0 and strategy.position_size[1] != 0
if confirmed and positionClosedNow
    int closedTradeIndex = strategy.closedtrades - 1
    float exitPrice = close
    string closedTradeComment = ""
    if strategy.closedtrades > 0
        exitPrice := strategy.closedtrades.exit_price(closedTradeIndex)
        closedTradeComment := strategy.closedtrades.exit_comment(closedTradeIndex)
    bool stopped = activeDirection == 1 ? low <= activeStop : high >= activeStop
    bool target2Hit = activeDirection == 1 ? high >= activeTarget2 : low <= activeTarget2
    string exitReason = activeManualExitReason != "" ? activeManualExitReason : str.contains(closedTradeComment, "TP2") or target2Hit ? "take_profit_final" : str.contains(closedTradeComment, "BE") ? "breakeven_stop" : stopped ? "stop_loss" : forceFlatNow ? "force_flat_eod" : "strategy_closed"
    float pnlPerShare = (exitPrice - activeEntry) * activeDirection
    debugLog("order", "POSITION_CLOSED", "side=" + dirName(activeDirection) + " reason=" + exitReason + " / " + reasonText(exitReason) + "\nentry=" + fmtlib.fmtPrice(activeEntry) + " exit=" + fmtlib.fmtPrice(exitPrice) + " qty=" + fmtlib.qtyText(activeQty) + "\npnl/share=" + fmtlib.fmtPrice(pnlPerShare) + " pnl=" + fmtlib.moneyText(pnlPerShare * activeQty) + " pnlR=" + fmtlib.fmt(activeInitialRisk > 0.0 ? pnlPerShare / activeInitialRisk : na) + "\nclosed_comment=" + closedTradeComment)
    if pnlPerShare < 0.0
        consecutiveLosses += 1
    else
        consecutiveLosses := 0
    if enableAlerts
        alert(buildExitPayload(planId("exit", activeSetup, "market_next_bar"), activePositionId, exitReason, exitPrice, pnlPerShare), alert.freq_all)
    float pnlR = activeInitialRisk > 0.0 ? pnlPerShare / activeInitialRisk : na
    string exitCode = exitReason == "take_profit_final" ? "TP2" : exitReason == "take_profit_2r" ? "TP2" : exitReason == "stop_loss" ? "SL" : exitReason == "breakeven_stop" ? "BE" : exitReason == "time_stop" ? "TIME" : exitReason == "force_flat_eod" ? "EOD" : "EXIT"
    color exitColor = exitReason == "take_profit_final" or exitReason == "take_profit_2r" ? color.lime : exitReason == "stop_loss" ? color.red : exitReason == "breakeven_stop" ? color.gray : color.orange
    if showManagementMarkers
        label.new(bar_index, exitPrice, managementMarkerText(exitCode, exitReason, exitPrice, pnlR), style=activeDirection == 1 ? label.style_label_down : label.style_label_up, color=color.new(exitColor, 0), textcolor=exitReason == "take_profit_final" or exitReason == "take_profit_2r" ? color.black : color.white, size=markerSize(), tooltip="exit reason: " + exitReason + "\nexit: " + fmtlib.fmtPrice(exitPrice) + "\npnl/share: " + fmtlib.fmtPrice(pnlPerShare) + "\npnl R: " + fmtlib.fmt(pnlR))
    activePosition := false
    activeDirection := 0
    activeSetup := ""
    activeSignalId := ""
    activeTradeGroupId := ""
    activePositionId := ""
    activeEntry := na
    activeStop := na
    activeTarget1 := na
    activeTarget2 := na
    activeQty := na
    activeInitialRisk := na
    activeSignalBar := na
    activeEntryBar := na
    activeBreakevenDone := false
    activeMfeR := 0.0
    activeRiskUpdateSeq := 0
    activeManualExitReason := ""

// -----------------------------------------------------------------------------
// Visuals
// -----------------------------------------------------------------------------
plot(showRthVwapLine ? vwap : na, "RTH VWAP", color=color.new(color.yellow, 0), linewidth=3, style=plot.style_linebr)
plot(orComplete ? orHigh : na, "ORH", color=color.new(color.lime, 0), linewidth=2, style=plot.style_linebr)
plot(orComplete ? orLow : na, "ORL", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(activePosition ? activeStop : na, "Active Stop", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(activePosition ? activeTarget1 : na, "1R", color=color.new(color.blue, 0), linewidth=1, style=plot.style_linebr)
plot(activePosition ? activeTarget2 : na, "Final Target", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
plotshape(submitNewPlan and selectedDirection == 1, title="VOR long entry", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), size=size.small, text="BUY")
plotshape(submitNewPlan and selectedDirection == -1, title="VOR short entry", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small, text="SELL")
plotshape(blockedCandidate and selectedDirection == 1, title="VOR long blocked", style=shape.xcross, location=location.abovebar, color=color.new(color.orange, 0), size=size.tiny, text="NO")
plotshape(blockedCandidate and selectedDirection == -1, title="VOR short blocked", style=shape.xcross, location=location.belowbar, color=color.new(color.orange, 0), size=size.tiny, text="NO")

var label vwapTag = na
var label orhTag = na
var label orlTag = na

if confirmed and newDay
    if not na(vwapTag)
        label.delete(vwapTag)
        vwapTag := na
    if not na(orhTag)
        label.delete(orhTag)
        orhTag := na
    if not na(orlTag)
        label.delete(orlTag)
        orlTag := na

if confirmed and showMapLevelTags and inRth and not na(vwap)
    if not na(vwapTag)
        label.delete(vwapTag)
    vwapTag := label.new(bar_index, vwap, "VWAP " + fmtlib.fmtPrice(vwap), style=label.style_label_left, color=color.new(color.yellow, 0), textcolor=color.black, size=markerSize(), tooltip="RTH-only VWAP. It resets at 09:30 New York time and does not use extended-hours data.")

if confirmed and showMapLevelTags and orComplete and not na(orHigh) and not na(orLow)
    if not na(orhTag)
        label.delete(orhTag)
    if not na(orlTag)
        label.delete(orlTag)
    orhTag := label.new(bar_index, orHigh, "ORH " + fmtlib.fmtPrice(orHigh), style=label.style_label_left, color=color.new(color.lime, 0), textcolor=color.black, size=markerSize(), tooltip="Opening range high from 09:30-09:45 New York time.")
    orlTag := label.new(bar_index, orLow, "ORL " + fmtlib.fmtPrice(orLow), style=label.style_label_left, color=color.new(color.red, 0), textcolor=color.white, size=markerSize(), tooltip="Opening range low from 09:30-09:45 New York time.")
