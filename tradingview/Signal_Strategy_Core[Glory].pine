//@version=6
strategy(title="Signal Strategy Core[Glory]", overlay=true, max_labels_count=500, pyramiding=0, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, process_orders_on_close=true, calc_on_every_tick=false)

// TV-primary strategy v1.
// Derived from Signal Alert Core[Glory]: EMA trend/touch, SD mean-reversion windows,
// DTP direction, fractal pivots, cRSI/OBV divergence, ATR risk sizing.

string STRATEGY_VERSION = "SSC_v1_20260601"
string SCRIPT_TAG = "Signal_Strategy_Core[Glory]"

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
emaSlopeLookback = input.int(12, "Slope lookback", minval=1, group="01 EMA Trend Matrix")
emaMinAngle = input.float(0.01, "Minimum slope (%)", step=0.01, group="01 EMA Trend Matrix")
emaMinSpacing = input.float(0.01, "Minimum EMA spacing (%)", step=0.01, group="01 EMA Trend Matrix")
emaTouchType = input.string("slow", "EMA touch type", options=["fast", "slow", "both"], group="01 EMA Trend Matrix")

fractalPeriod = input.int(4, "Fractal pivot period", minval=2, maxval=20, group="02 Fractal Pivot")
donchianPeriod = input.int(20, "Donchian period", minval=1, group="02 Fractal Pivot")

sdLength = input.int(128, "Regression length", minval=20, group="03 SD Channel")
sdMult1 = input.float(1.0, "Band multiplier 1", step=0.5, group="03 SD Channel")
sdMult2 = input.float(2.0, "Band multiplier 2", step=0.5, group="03 SD Channel")
sdMult3 = input.float(3.0, "Band multiplier 3", step=0.5, group="03 SD Channel")
sdMult4 = input.float(4.0, "Band multiplier 4", step=0.5, group="03 SD Channel")
sdSignalBand = input.int(3, "MR trigger band", minval=1, maxval=4, group="03 SD Channel")
sdFilterBand = input.int(2, "Zone filter band", minval=1, maxval=4, group="03 SD Channel")
mrWindowBars = input.int(48, "MR window bars", minval=2, maxval=200, group="03 SD Channel")

dtpSmaLength = input.int(100, "DTP SMA length", minval=5, group="04 DTP")
dtpAtrLength = input.int(200, "DTP ATR length", minval=5, group="04 DTP")
dtpMomentumLookback = input.int(12, "DTP momentum lookback", minval=1, group="04 DTP")
dtpTrendThreshold = input.float(0.10, "DTP trend threshold (ATR units)", step=0.05, group="04 DTP")
dtpEarlyBars = input.int(12, "DTP early bars", minval=1, maxval=48, group="04 DTP")
dtpMatureBars = input.int(48, "DTP mature bars", minval=12, maxval=200, group="04 DTP")

atrLength = input.int(10, "ATR length", minval=1, group="05 Risk")
atrSmoothing = input.string("RMA", "ATR smoothing", options=["RMA", "SMA", "EMA", "WMA"], group="05 Risk")
atrMultiplier = input.float(1.5, "ATR multiplier", step=0.1, group="05 Risk")
positionAmount = input.float(5000, "Notional per trade ($)", step=500, minval=100, group="05 Risk")
maxLossPerTrade = input.float(150, "Max loss per trade ($)", step=10, minval=10, group="05 Risk")
slAtrMult = input.float(2.0, "Stop loss (x ATR)", step=0.25, minval=0.25, maxval=12.0, group="05 Risk")
rrRatio = input.float(1.5, "Reward/risk", step=0.1, minval=0.5, maxval=10.0, group="05 Risk")
enableBreakeven = input.bool(true, "Trail stop to breakeven", group="05 Risk")
enableTpCheckpointRunner = input.bool(true, "Enable runner mode", group="05 Risk")
runnerOnlyTrendSetups = input.bool(true, "Runner only trend setups", group="05 Risk")
runnerActivationR = input.float(1.0, "Runner activation (R)", step=0.25, minval=0.25, maxval=10.0, group="05 Risk")
tpCheckpointLockR = input.float(0.20, "Runner activation lock (R)", step=0.05, minval=0.0, maxval=3.0, group="05 Risk")
runnerTrailAtrMult = input.float(2.5, "Runner trail (x ATR)", step=0.25, minval=0.25, maxval=12.0, group="05 Risk")
runnerSafetyR = input.float(4.0, "Runner safety TP (R)", step=0.5, minval=1.0, maxval=20.0, group="05 Risk")
breakevenAtR = input.float(1.0, "Breakeven trigger (R)", step=0.25, minval=0.25, group="05 Risk")
breakevenOffsetR = input.float(0.05, "Breakeven offset (R)", step=0.01, minval=0.0, maxval=1.0, group="05 Risk")
useVolatilityFilter = input.bool(true, "Block low-volatility entries", group="05 Risk")
minAtrPctForEntry = input.float(0.08, "Minimum ATR% for entry", step=0.01, minval=0.0, group="05 Risk")

crsiDomcycle = input.int(20, "cRSI dominant cycle", minval=10, group="06 Oscillators")
crsiVibration = input.int(6, "cRSI vibration", minval=1, group="06 Oscillators")
crsiLeveling = input.float(10.0, "cRSI dynamic band percentile", minval=1, maxval=49, step=1, group="06 Oscillators")
divLookback = input.int(4, "Divergence pivot lookback", minval=1, maxval=20, group="06 Oscillators")
divMaxBars = input.int(30, "Divergence max age", minval=10, maxval=200, group="06 Oscillators")
divType = input.string("both", "Divergence type", options=["hidden", "regular", "both"], group="06 Oscillators")
obvRsiLen = input.int(10, "OBV RSI length", minval=1, group="06 Oscillators")

tradingSession = input.session("0945-1530", "Trading session", group="07 TV Primary Events")
enableAlerts = input.bool(true, "Emit TV-primary alert() payloads", group="07 TV Primary Events")
preAlertThreshold = input.int(65, "Pre-alert activity score", minval=1, maxval=99, group="07 TV Primary Events")
enableEodForceClose = input.bool(true, "Mirror system EOD force close", group="07 TV Primary Events")
eodCloseHour = input.int(15, "EOD force close hour ET", minval=0, maxval=23, group="07 TV Primary Events")
eodCloseMinute = input.int(55, "EOD force close minute ET", minval=0, maxval=59, group="07 TV Primary Events")
allowLong = input.bool(true, "Allow long entries", group="07 TV Primary Events")
allowShort = input.bool(true, "Allow short entries", group="07 TV Primary Events")
useDtpFilter = input.bool(true, "Filter MR entries against DTP", group="07 TV Primary Events")
dtpMrFilterMode = input.string("平衡：只挡初期", "DTP MR filter mode", options=["严格：挡初期+确认", "平衡：只挡初期", "关闭：不挡MR"], group="07 TV Primary Events")
useEmaWeakFilter = input.bool(true, "Filter trend entries when EMA is weak", group="07 TV Primary Events")
enableMtf = input.bool(true, "Enable MTF confirmation", group="07 TV Primary Events")
mtfMode = input.string("shadow_soft", "MTF mode", options=["shadow_soft", "display_only"], group="07 TV Primary Events")
mtfConfirmTf1 = input.timeframe("5", "MTF confirm TF 1", group="07 TV Primary Events")
mtfConfirmTf2 = input.timeframe("15", "MTF confirm TF 2", group="07 TV Primary Events")
mtfConfirmTf3 = input.timeframe("60", "MTF confirm TF 3", group="07 TV Primary Events")
string MTF_CONFIRM_TFS = mtfConfirmTf1 + "," + mtfConfirmTf2 + "," + mtfConfirmTf3
string TIMEFRAME_STACK = enableMtf ? "entry=" + timeframe.period + ";confirm=" + MTF_CONFIRM_TFS + ";mode=" + mtfMode : "entry=" + timeframe.period + ";confirm=none;mode=off"

displayPreset = input.string("核心交易流程", "Display preset", options=["核心交易流程", "指标辅助", "调试全量"], group="08 Display")
showFlowLabels = input.bool(true, "Show activation/prep/entry labels", group="08 Display")
flowLabelTransparency = input.int(30, "Flow label background transparency", minval=0, maxval=100, group="08 Display")
showStatusPanel = input.bool(true, "Show status panel", group="08 Display")
showBands = input.bool(true, "Show SD bands", group="08 Display")
showSdHelperLines = input.bool(false, "Show SD regression/filter lines", group="08 Display")
showDtpLine = input.bool(true, "Show DTP trend line", group="08 Display")
showEma = input.bool(true, "Show EMA fast/slow", group="08 Display")
showDebugComponents = input.bool(false, "Show SD/F/D component markers", group="08 Display")
showFractalMarkers = input.bool(true, "Show fractal markers", group="08 Display")
showEmaCrossMarkers = input.bool(true, "Show EMA20/50 cross markers", group="08 Display")

bool displayIndicatorMode = displayPreset == "指标辅助"
bool displayDebugMode = displayPreset == "调试全量"
bool showEmaFastSlowLines = showEma or displayIndicatorMode or displayDebugMode
bool showEmaContextLines = displayIndicatorMode or displayDebugMode
bool showBandLines = showBands or displayIndicatorMode or displayDebugMode
bool showSdHelperBandLines = showSdHelperLines or displayIndicatorMode or displayDebugMode
bool showDtpTrendLine = showDtpLine or displayIndicatorMode or displayDebugMode
bool showComponentMarkers = showDebugComponents or displayDebugMode

bool confirmed = barstate.isconfirmed
bool inSession = not na(time(timeframe.period, tradingSession, syminfo.timezone))
bool canTrade = confirmed and inSession
int dailyTime = time("D")
bool isNewTradingDay = not na(dailyTime[1]) and dailyTime != dailyTime[1]

// -----------------------------------------------------------------------------
// Helpers
// -----------------------------------------------------------------------------
fmtNum(float value) =>
    na(value) ? "null" : str.tostring(value, "#.####")

boolText(bool value) =>
    value ? "true" : "false"

jsonStr(string key, string value) =>
    ',"' + key + '":"' + value + '"'

jsonNum(string key, float value) =>
    ',"' + key + '":' + fmtNum(value)

jsonInt(string key, int value) =>
    ',"' + key + '":' + str.tostring(value, "#")

jsonIntNullable(string key, int value) =>
    ',"' + key + '":' + (na(value) ? "null" : str.tostring(value, "#"))

jsonBool(string key, bool value) =>
    ',"' + key + '":' + boolText(value)

jsonRequestedSides(string requestedSides) =>
    ',"requested_sides":' + (requestedSides == "stop_loss" ? '["stop_loss"]' : requestedSides == "take_profit" ? '["take_profit"]' : requestedSides == "stop_loss,take_profit" ? '["stop_loss","take_profit"]' : '[]')

symbolKey() =>
    str.replace_all(syminfo.tickerid, ":", "_")

eventId(string eventType, string suffix) =>
    symbolKey() + "_" + eventType + "_" + str.tostring(time, "#") + "_" + str.tostring(bar_index, "#") + "_" + suffix

positionId(string direction) =>
    symbolKey() + "_" + direction + "_" + str.format_time(time, "yyyyMMdd_HHmm", "America/New_York") + "_" + str.tostring(bar_index, "#")

basePayload(string eventType, string eventIdValue, string positionIdValue) =>
    '{"source":"tv"' +
     jsonStr("event_type", eventType) +
     jsonStr("event_id", eventIdValue) +
     jsonStr("position_id", positionIdValue) +
     jsonStr("strategy_version", STRATEGY_VERSION) +
     jsonStr("script_tag", SCRIPT_TAG) +
     jsonStr("timeframe_stack", TIMEFRAME_STACK) +
     jsonStr("interval", timeframe.period) +
     ',"bar_time_ms":' + str.tostring(time, "#") +
     jsonIntNullable("bar_open_ms", time) +
     jsonIntNullable("bar_close_ms", time_close) +
     jsonIntNullable("pine_eval_ms", timenow) +
     jsonStr("symbol", syminfo.ticker) +
     jsonStr("tickerid", syminfo.tickerid) +
     jsonStr("exchange", syminfo.prefix) +
     jsonStr("currency", syminfo.currency) +
     jsonStr("session", tradingSession)

appendSource(string existing, string nextValue) =>
    existing == "" ? nextValue : existing + "+" + nextValue

maFunc(float source, int len) =>
    switch atrSmoothing
        "SMA" => ta.sma(source, len)
        "EMA" => ta.ema(source, len)
        "WMA" => ta.wma(source, len)
        => ta.rma(source, len)

calcSlope(float source, int len) =>
    not na(source[len]) and source[len] != 0.0 ? (source - source[len]) / source[len] * 100.0 : 0.0

priceChanged(float oldValue, float newValue) =>
    na(oldValue) or na(newValue) ? true : math.abs(oldValue - newValue) >= syminfo.mintick

setupDisplayName(string setup) =>
    setup == "trend_sdUpper" ? "SD上轨顺势多" : setup == "mr_sdLower" ? "SD下轨回归多" : setup == "mr_sdUpper" ? "SD上轨回归空" : setup == "trend_sdLower" ? "SD下轨顺势空" : setup

directionDisplayName(string direction) =>
    direction == "short" ? "做空" : "做多"

exitReasonDisplayName(string reason) =>
    reason == "take_profit" ? "TP止盈" : reason == "runner_stop" ? "跟踪止盈" : reason == "stop_loss" ? "SL止损" : reason == "force_flat_eod" or reason == "eod" ? "EOD强平" : reason == "strategy_closed" ? "策略退出" : reason

fmtSignedMoney(float value) =>
    na(value) ? "--" : (value >= 0.0 ? "+$" : "-$") + str.tostring(math.abs(value), "#.##")

fmtSignedPct(float value) =>
    na(value) ? "--" : (value >= 0.0 ? "+" : "-") + str.tostring(math.abs(value), "#.##") + "%"

exitPnlLabelText(string reason, string timeText, float price, float pnl, float pnlPct) =>
    exitReasonDisplayName(reason) + "\n" + syminfo.ticker + " · " + timeText + " ET @ " + str.tostring(price, "#.##") + "\nPnL " + fmtSignedMoney(pnl) + " (" + fmtSignedPct(pnlPct) + ")"

exitPnlLabelColor(float pnl) =>
    na(pnl) ? color.new(color.gray, flowLabelTransparency) : pnl > 0.0 ? color.new(color.green, flowLabelTransparency) : pnl < 0.0 ? color.new(color.red, flowLabelTransparency) : color.new(color.gray, flowLabelTransparency)

entryComment(string direction, string setup) =>
    direction == "short" ? "SELL 空 · " + setup : "BUY 多 · " + setup

setupUsesUpperWindow(string setup) =>
    setup == "trend_sdUpper" or setup == "mr_sdUpper"

setupUsesBullSide(string setup) =>
    setup == "trend_sdUpper" or setup == "mr_sdLower"

setupUsesRunner(string setup) =>
    enableTpCheckpointRunner and (not runnerOnlyTrendSetups or setup == "trend_sdUpper" or setup == "trend_sdLower")

calcTargetAtR(float entryPrice, float stopPrice, int direction, float rMultiple) =>
    float risk = direction == 1 ? entryPrice - stopPrice : stopPrice - entryPrice
    direction == 1 ? entryPrice + risk * rMultiple : entryPrice - risk * rMultiple

calcRunnerActivationTarget(float entryPrice, float stopPrice, int direction) =>
    calcTargetAtR(entryPrice, stopPrice, direction, runnerActivationR)

calcRunnerSafetyTarget(float entryPrice, float stopPrice, int direction) =>
    float safetyR = math.max(math.max(rrRatio, runnerSafetyR), runnerActivationR)
    calcTargetAtR(entryPrice, stopPrice, direction, safetyR)

exitTouchesTarget(int direction, float exitPrice, float targetPrice) =>
    not na(targetPrice) and (math.abs(exitPrice - targetPrice) <= syminfo.mintick * 2.0 or (direction == 1 ? exitPrice >= targetPrice : exitPrice <= targetPrice))

exitTouchesStop(int direction, float exitPrice, float stopPrice) =>
    not na(stopPrice) and (math.abs(exitPrice - stopPrice) <= syminfo.mintick * 2.0 or (direction == 1 ? exitPrice <= stopPrice : exitPrice >= stopPrice))

setupUsesEmaTouch(string setup) =>
    setup == "trend_sdUpper" or setup == "trend_sdLower"

componentStateText(bool ready, string label) =>
    (ready ? "有" : "缺") + label

directionComponentCount(bool fractalReady, bool divReady, bool emaCrossReady) =>
    (fractalReady ? 1 : 0) + (divReady ? 1 : 0) + (emaCrossReady ? 1 : 0)

directionComponentsReady(bool fractalReady, bool divReady, bool emaCrossReady) =>
    directionComponentCount(fractalReady, divReady, emaCrossReady) >= 2

componentLineText(string setup, bool windowReady, bool emaReady, bool fractalReady, bool divReady, bool emaCrossReady) =>
    string windowLabel = setupUsesUpperWindow(setup) ? "上轨窗" : "下轨窗"
    string emaLabel = setup == "trend_sdUpper" ? "多EMA触碰" : setup == "trend_sdLower" ? "空EMA触碰" : ""
    string fractalLabel = setupUsesBullSide(setup) ? "多分形" : "空分形"
    string divLabel = setupUsesBullSide(setup) ? "多背离" : "空背离"
    string emaCrossLabel = setupUsesBullSide(setup) ? "金叉" : "死叉"
    string parts = componentStateText(windowReady, windowLabel)
    parts := setupUsesEmaTouch(setup) ? parts + " " + componentStateText(emaReady, emaLabel) : parts
    parts + " 方向" + str.tostring(directionComponentCount(fractalReady, divReady, emaCrossReady), "#") + "/3(" + componentStateText(fractalReady, fractalLabel) + " " + componentStateText(divReady, divLabel) + " " + componentStateText(emaCrossReady, emaCrossLabel) + ")"

componentReadyCount(string setup, bool windowReady, bool emaReady, bool fractalReady, bool divReady, bool emaCrossReady) =>
    int count = windowReady ? 1 : 0
    count := count + (setupUsesEmaTouch(setup) and emaReady ? 1 : 0)
    count := count + (directionComponentsReady(fractalReady, divReady, emaCrossReady) ? 1 : 0)
    count

componentTotalCount(string setup) =>
    setupUsesEmaTouch(setup) ? 3 : 2

componentSummaryText(string setup, bool windowReady, bool emaReady, bool fractalReady, bool divReady, bool emaCrossReady) =>
    str.tostring(componentReadyCount(setup, windowReady, emaReady, fractalReady, divReady, emaCrossReady), "#") + "/" + str.tostring(componentTotalCount(setup), "#") + " · " + componentLineText(setup, windowReady, emaReady, fractalReady, divReady, emaCrossReady)

componentSummaryForSetup(string setup, bool upperWindowReady, bool lowerWindowReady, bool upperBullTouchReady, bool lowerBearTouchReady, bool upperBullFractalReady, bool lowerBullFractalReady, bool upperBearFractalReady, bool lowerBearFractalReady, bool upperBullEmaCrossReady, bool lowerBullEmaCrossReady, bool upperBearEmaCrossReady, bool lowerBearEmaCrossReady, bool bullDivReady, bool bearDivReady) =>
    bool windowReady = setupUsesUpperWindow(setup) ? upperWindowReady : lowerWindowReady
    bool emaReady = setup == "trend_sdUpper" ? upperBullTouchReady : setup == "trend_sdLower" ? lowerBearTouchReady : true
    bool fractalReady = setup == "trend_sdUpper" ? upperBullFractalReady : setup == "mr_sdLower" ? lowerBullFractalReady : setup == "mr_sdUpper" ? upperBearFractalReady : lowerBearFractalReady
    bool divReady = setupUsesBullSide(setup) ? bullDivReady : bearDivReady
    bool emaCrossReady = setup == "trend_sdUpper" ? upperBullEmaCrossReady : setup == "mr_sdLower" ? lowerBullEmaCrossReady : setup == "mr_sdUpper" ? upperBearEmaCrossReady : lowerBearEmaCrossReady
    componentSummaryText(setup, windowReady, emaReady, fractalReady, divReady, emaCrossReady)

componentProgressForSetup(string setup, bool upperWindowReady, bool lowerWindowReady, bool upperBullTouchReady, bool lowerBearTouchReady, bool upperBullFractalReady, bool lowerBullFractalReady, bool upperBearFractalReady, bool lowerBearFractalReady, bool upperBullEmaCrossReady, bool lowerBullEmaCrossReady, bool upperBearEmaCrossReady, bool lowerBearEmaCrossReady, bool bullDivReady, bool bearDivReady) =>
    bool windowReady = setupUsesUpperWindow(setup) ? upperWindowReady : lowerWindowReady
    bool emaReady = setup == "trend_sdUpper" ? upperBullTouchReady : setup == "trend_sdLower" ? lowerBearTouchReady : true
    bool fractalReady = setup == "trend_sdUpper" ? upperBullFractalReady : setup == "mr_sdLower" ? lowerBullFractalReady : setup == "mr_sdUpper" ? upperBearFractalReady : lowerBearFractalReady
    bool divReady = setupUsesBullSide(setup) ? bullDivReady : bearDivReady
    bool emaCrossReady = setup == "trend_sdUpper" ? upperBullEmaCrossReady : setup == "mr_sdLower" ? lowerBullEmaCrossReady : setup == "mr_sdUpper" ? upperBearEmaCrossReady : lowerBearEmaCrossReady
    str.tostring(componentReadyCount(setup, windowReady, emaReady, fractalReady, divReady, emaCrossReady), "#") + "/" + str.tostring(componentTotalCount(setup), "#")

compactMissingText(string value) =>
    string missingText = value == "" or value == "none" ? "齐" : value
    missingText := str.replace_all(missingText, "upper_window", "上轨窗")
    missingText := str.replace_all(missingText, "lower_window", "下轨窗")
    missingText := str.replace_all(missingText, "ema_bull_touch", "多EMA")
    missingText := str.replace_all(missingText, "ema_bear_touch", "空EMA")
    missingText := str.replace_all(missingText, "bull_fractal", "多分形")
    missingText := str.replace_all(missingText, "bear_fractal", "空分形")
    missingText := str.replace_all(missingText, "bull_divergence", "多背离")
    missingText := str.replace_all(missingText, "bear_divergence", "空背离")
    missingText := str.replace_all(missingText, "bull_ema_cross", "金叉")
    missingText := str.replace_all(missingText, "bear_ema_cross", "死叉")
    missingText := str.replace_all(missingText, "+", "/")
    missingText

waitComponentText(string value) =>
    string missingText = compactMissingText(value)
    missingText == "齐" ? "组件齐" : "等 " + missingText

filterDisplayName(string reason) =>
    reason == "dtp_bearish_early" ? "DTP偏空初期" : reason == "dtp_bullish_early" ? "DTP偏多初期" : reason == "dtp_bearish_early_or_confirmed" ? "DTP偏空" : reason == "dtp_bullish_early_or_confirmed" ? "DTP偏多" : reason == "ema_weak" ? "EMA弱" : reason == "low_volatility" ? "低波动" : reason == "mtf_5m_15m_opposite" ? "MTF反向" : reason == "long_short_conflict" ? "多空冲突" : reason == "" ? "过滤" : reason

filterActionText(string reason, string direction) =>
    reason == "dtp_bearish_early" ? "DTP偏空初期，等过初期" : reason == "dtp_bullish_early" ? "DTP偏多初期，等过初期" : reason == "dtp_bearish_early_or_confirmed" ? "DTP偏空，等转弱/中性/多" : reason == "dtp_bullish_early_or_confirmed" ? "DTP偏多，等转弱/中性/空" : reason == "ema_weak" ? "EMA偏弱，等快慢线走强" : reason == "low_volatility" ? "ATR%低于入场阈值，等波动恢复" : reason == "mtf_5m_15m_opposite" ? "5m+15m 同时反向，等MTF转中性/同向" : reason == "long_short_conflict" ? "多空冲突，等单边明确" : reason == "" ? "过滤" + directionDisplayName(direction) + "，等条件恢复" : filterDisplayName(reason)

dtpPhaseDisplayName(string phase) =>
    phase == "early" ? "初期" : phase == "confirmed" ? "确认" : phase == "mature" ? "成熟" : phase == "weakening" ? "转弱" : "中性"

dtpStateText(int direction, string phase) =>
    (direction == 1 ? "DTP偏多" : direction == -1 ? "DTP偏空" : "DTP中性") + " · " + dtpPhaseDisplayName(phase)

dtpMrBlocksPhase(string mode, string phase) =>
    mode == "关闭：不挡MR" ? false : mode == "严格：挡初期+确认" ? (phase == "early" or phase == "confirmed") : phase == "early"

dtpBlockReasonText(string direction, string mode) =>
    direction == "long" ? (mode == "严格：挡初期+确认" ? "dtp_bearish_early_or_confirmed" : "dtp_bearish_early") : (mode == "严格：挡初期+确认" ? "dtp_bullish_early_or_confirmed" : "dtp_bullish_early")

dtpEntryFilterText(string direction, int dtpDirection, string phase, string mode, bool enabled) =>
    string stateText = dtpStateText(dtpDirection, phase)
    bool adverse = direction == "long" ? dtpDirection == -1 : dtpDirection == 1
    not enabled or mode == "关闭：不挡MR" ? stateText + " · DTP不拦" : adverse and mode == "平衡：只挡初期" ? stateText + " · 已过初期放行" : adverse and phase == "weakening" ? stateText + " · 转弱放行" : stateText

dirName(int direction) =>
    direction == 1 ? "bullish" : direction == -1 ? "bearish" : "neutral"

mtfEmaDirValue() =>
    float fast = ta.ema(close, 20)
    float slow = ta.ema(close, 50)
    fast > slow ? 1 : fast < slow ? -1 : 0

mtfDtpDirValue() =>
    float avg = ta.sma(close, dtpSmaLength)
    float atr = ta.atr(dtpAtrLength)
    float momentum = avg - avg[dtpMomentumLookback]
    float normalized = atr > 0.0 ? momentum / atr : 0.0
    normalized > dtpTrendThreshold and close > avg ? 1 : normalized < -dtpTrendThreshold and close < avg ? -1 : 0

mtfStateForDirection(string direction, int emaDirection, int dtpDirection) =>
    int wanted = direction == "short" ? -1 : 1
    int opposite = -wanted
    bool failed = emaDirection == opposite and dtpDirection == opposite
    bool supported = emaDirection == wanted or dtpDirection == wanted
    failed ? "fail" : supported ? "pass" : "warn"

mtfStatePoints(string state, float weight) =>
    state == "pass" ? weight : state == "warn" ? weight * 0.5 : 0.0

mtfScoreForStates(string state1, string state2, string state3) =>
    enableMtf ? mtfStatePoints(state1, 45.0) + mtfStatePoints(state2, 35.0) + mtfStatePoints(state3, 20.0) : 0.0

mtfDisplayMark(string state) =>
    state == "pass" ? "✓" : state == "fail" ? "×" : "!"

mtfStatusForStates(string state1, string state2, string state3) =>
    enableMtf and mtfMode == "shadow_soft" and state1 == "fail" and state2 == "fail" ? "block" : enableMtf ? (state1 == "fail" or state2 == "fail" or state3 == "fail" ? "warn" : "pass") : "off"

mtfBlockReasonForStates(string state1, string state2) =>
    enableMtf and mtfMode == "shadow_soft" and state1 == "fail" and state2 == "fail" ? "mtf_5m_15m_opposite" : "none"

mtfStateJson(string tf, string state, int emaDirection, int dtpDirection, float weight, float points) =>
    '{"tf":"' + tf + '","status":"' + state + '","ema_dir":"' + dirName(emaDirection) + '","dtp_dir":"' + dirName(dtpDirection) + '","weight":' + str.tostring(weight, "#") + ',"points":' + str.tostring(points, "#.##") + '}'

flowBaseColor(string state, string direction) =>
    state == "activate_lower" or state == "activate_upper" ? color.blue : state == "blocked" ? color.gray : direction == "short" ? color.red : color.green

flowLabelColor(string state, string direction) =>
    color.new(flowBaseColor(state, direction), flowLabelTransparency)

flowStatusColor(string state, string direction) =>
    color.new(flowBaseColor(state, direction), 0)

flowLabelStyle(string direction) =>
    direction == "short" ? label.style_label_down : label.style_label_up

// -----------------------------------------------------------------------------
// Core indicators
// -----------------------------------------------------------------------------
float emaFast = ta.ema(close, 20)
float emaSlow = ta.ema(close, 50)
float emaTrend = ta.ema(close, 100)
float emaLongest = ta.ema(close, 200)

float slopeSlow = calcSlope(emaSlow, emaSlopeLookback)
float slopeTrend = calcSlope(emaTrend, emaSlopeLookback)
float slopeLongest = calcSlope(emaLongest, emaSlopeLookback)
float spacingFastSlow = emaSlow != 0.0 ? math.abs(emaFast - emaSlow) / emaSlow * 100.0 : 0.0
float spacingSlowTrend = emaTrend != 0.0 ? math.abs(emaSlow - emaTrend) / emaTrend * 100.0 : 0.0
float spacingTrendLongest = emaLongest != 0.0 ? math.abs(emaTrend - emaLongest) / emaLongest * 100.0 : 0.0
bool spacingOk = spacingFastSlow > emaMinSpacing and spacingSlowTrend > emaMinSpacing and spacingTrendLongest > emaMinSpacing
bool emaGoldenCrossRaw = ta.crossover(emaFast, emaSlow)
bool emaDeathCrossRaw = ta.crossunder(emaFast, emaSlow)
bool emaGoldenCross = confirmed and emaGoldenCrossRaw
bool emaDeathCross = confirmed and emaDeathCrossRaw

bool emaBullishAlign = emaFast > emaSlow and emaSlow > emaTrend and emaTrend > emaLongest
bool emaBearishAlign = emaFast < emaSlow and emaSlow < emaTrend and emaTrend < emaLongest
bool emaBullish = emaBullishAlign and slopeSlow > emaMinAngle and slopeTrend > emaMinAngle and slopeLongest > emaMinAngle and spacingOk
bool emaBearish = emaBearishAlign and slopeSlow < -emaMinAngle and slopeTrend < -emaMinAngle and slopeLongest < -emaMinAngle and spacingOk
int trendDir = emaBullish ? 1 : emaBearish ? -1 : 0

bool bullTouchFast = confirmed and emaBullishAlign and spacingOk and close[1] > emaFast[1] and low <= emaFast
bool bearTouchFast = confirmed and emaBearishAlign and spacingOk and close[1] < emaFast[1] and high >= emaFast
bool bullTouchSlow = confirmed and emaBullishAlign and spacingOk and close[1] > emaSlow[1] and low <= emaSlow
bool bearTouchSlow = confirmed and emaBearishAlign and spacingOk and close[1] < emaSlow[1] and high >= emaSlow
bool emaBullTouch = emaTouchType == "fast" ? bullTouchFast : emaTouchType == "slow" ? bullTouchSlow : bullTouchFast or bullTouchSlow
bool emaBearTouch = emaTouchType == "fast" ? bearTouchFast : emaTouchType == "slow" ? bearTouchSlow : bearTouchFast or bearTouchSlow
string bullTouchLine = bullTouchFast and bullTouchSlow ? "fast+slow" : bullTouchFast ? "fast" : bullTouchSlow ? "slow" : "none"
string bearTouchLine = bearTouchFast and bearTouchSlow ? "fast+slow" : bearTouchFast ? "fast" : bearTouchSlow ? "slow" : "none"

float upperDonch = ta.highest(high, donchianPeriod)
float lowerDonch = ta.lowest(low, donchianPeriod)
float donchianBase = (upperDonch + lowerDonch) / 2.0
float fractalPivotHigh = ta.pivothigh(high, fractalPeriod, fractalPeriod)
float fractalPivotLow = ta.pivotlow(low, fractalPeriod, fractalPeriod)
bool fractalBear = confirmed and not na(fractalPivotHigh) and fractalPivotHigh > donchianBase[fractalPeriod]
bool fractalBull = confirmed and not na(fractalPivotLow) and fractalPivotLow < donchianBase[fractalPeriod]

float sdReg = ta.linreg(close, sdLength, 0)
float sdStd = ta.stdev(close, sdLength)
float sdSignalMult = sdSignalBand == 1 ? sdMult1 : sdSignalBand == 2 ? sdMult2 : sdSignalBand == 3 ? sdMult3 : sdMult4
float sdFilterMult = sdFilterBand == 1 ? sdMult1 : sdFilterBand == 2 ? sdMult2 : sdFilterBand == 3 ? sdMult3 : sdMult4
float sdSignalUpper = sdReg + sdSignalMult * sdStd
float sdSignalLower = sdReg - sdSignalMult * sdStd
float sdFilterUpper = sdReg + sdFilterMult * sdStd
float sdFilterLower = sdReg - sdFilterMult * sdStd
bool sdLowerHit = confirmed and low <= sdSignalLower
bool sdUpperHit = confirmed and high >= sdSignalUpper
int sdZone = close > sdFilterUpper ? 1 : close < sdFilterLower ? -1 : 0
float sdSlope = ta.linreg(close, sdLength, 0) - ta.linreg(close, sdLength, 1)
int sdTrend = sdSlope > 0 ? 1 : sdSlope < 0 ? -1 : 0

float dtpAvg = ta.sma(close, dtpSmaLength)
float dtpAtr = ta.atr(dtpAtrLength)
float dtpMomentum = dtpAvg - dtpAvg[dtpMomentumLookback]
float dtpNorm = dtpAtr > 0.0 ? dtpMomentum / dtpAtr : 0.0
bool dtpBullTurn = ta.crossover(dtpNorm, dtpTrendThreshold)
bool dtpBearTurn = ta.crossunder(dtpNorm, -dtpTrendThreshold)
var int dtpDirState = 0
var int dtpStartBar = na
if confirmed
    if dtpDirState == 0
        if dtpNorm > dtpTrendThreshold and close > dtpAvg
            dtpDirState := 1
            dtpStartBar := bar_index
        else if dtpNorm < -dtpTrendThreshold and close < dtpAvg
            dtpDirState := -1
            dtpStartBar := bar_index
    if dtpBullTurn
        dtpDirState := 1
        dtpStartBar := bar_index
    if dtpBearTurn
        dtpDirState := -1
        dtpStartBar := bar_index
int dtpDir = dtpDirState
int dtpPhaseBars = na(dtpStartBar) ? 0 : bar_index - dtpStartBar + 1
bool dtpConfirmsSd = (dtpDir == 1 and sdTrend == 1) or (dtpDir == -1 and sdTrend == -1)
string dtpPhase = dtpDir == 0 ? "neutral" : dtpPhaseBars <= dtpEarlyBars ? "early" : dtpPhaseBars > dtpMatureBars and dtpConfirmsSd ? "mature" : dtpConfirmsSd ? "confirmed" : "weakening"

int mtfTf1EmaDir = enableMtf ? request.security(syminfo.tickerid, mtfConfirmTf1, mtfEmaDirValue(), barmerge.gaps_off, barmerge.lookahead_off) : 0
int mtfTf1DtpDir = enableMtf ? request.security(syminfo.tickerid, mtfConfirmTf1, mtfDtpDirValue(), barmerge.gaps_off, barmerge.lookahead_off) : 0
int mtfTf2EmaDir = enableMtf ? request.security(syminfo.tickerid, mtfConfirmTf2, mtfEmaDirValue(), barmerge.gaps_off, barmerge.lookahead_off) : 0
int mtfTf2DtpDir = enableMtf ? request.security(syminfo.tickerid, mtfConfirmTf2, mtfDtpDirValue(), barmerge.gaps_off, barmerge.lookahead_off) : 0
int mtfTf3EmaDir = enableMtf ? request.security(syminfo.tickerid, mtfConfirmTf3, mtfEmaDirValue(), barmerge.gaps_off, barmerge.lookahead_off) : 0
int mtfTf3DtpDir = enableMtf ? request.security(syminfo.tickerid, mtfConfirmTf3, mtfDtpDirValue(), barmerge.gaps_off, barmerge.lookahead_off) : 0

float atrVal = maFunc(ta.tr(true), atrLength) * atrMultiplier
float atrRaw = atrMultiplier != 0.0 ? atrVal / atrMultiplier : atrVal
float atrPct = close > 0.0 ? atrRaw / close * 100.0 : 0.0
bool lowVolatilityEntryBlocked = useVolatilityFilter and atrPct < minAtrPctForEntry

int crsiCycleLen = math.max(1, int(math.round(crsiDomcycle / 2.0)))
int crsiMemory = math.max(2, crsiDomcycle * 2)
float crsiTorque = 2.0 / (crsiVibration + 1.0)
int crsiLag = math.max(0, int(math.round((crsiVibration - 1.0) / 2.0)))
float closeChange = ta.change(close)
float crsiUp = ta.rma(math.max(closeChange, 0.0), crsiCycleLen)
float crsiDown = ta.rma(-math.min(closeChange, 0.0), crsiCycleLen)
float crsiRaw = crsiDown == 0.0 ? 100.0 : crsiUp == 0.0 ? 0.0 : 100.0 - 100.0 / (1.0 + crsiUp / crsiDown)
var float crsi = na
crsi := crsiTorque * (2.0 * crsiRaw - nz(crsiRaw[crsiLag], crsiRaw)) + (1.0 - crsiTorque) * nz(crsi[1], crsiRaw)
float crsiUpperBand = ta.percentile_linear_interpolation(crsi, crsiMemory, 100.0 - crsiLeveling)
float crsiLowerBand = ta.percentile_linear_interpolation(crsi, crsiMemory, crsiLeveling)
bool crsiOB = crsi > crsiUpperBand
bool crsiOS = crsi < crsiLowerBand

float obvFlow = closeChange > 0.0 ? volume : closeChange < 0.0 ? -volume : 0.0
float obv = ta.cum(obvFlow)
float obvOsc = ta.rsi(obv, obvRsiLen)

// -----------------------------------------------------------------------------
// Divergence detection using confirmed price pivots.
// -----------------------------------------------------------------------------
bool includeRegularDiv = divType == "regular" or divType == "both"
bool includeHiddenDiv = divType == "hidden" or divType == "both"

var float prevHighPriceCrsi = na
var float prevHighOscCrsi = na
var int prevHighBarCrsi = na
var float prevLowPriceCrsi = na
var float prevLowOscCrsi = na
var int prevLowBarCrsi = na
var float prevHighPriceObv = na
var float prevHighOscObv = na
var int prevHighBarObv = na
var float prevLowPriceObv = na
var float prevLowOscObv = na
var int prevLowBarObv = na

bool crsiRegBearDiv = false
bool crsiRegBullDiv = false
bool crsiHidBearDiv = false
bool crsiHidBullDiv = false
bool obvRegBearDiv = false
bool obvRegBullDiv = false
bool obvHidBearDiv = false
bool obvHidBullDiv = false

float divPivotHigh = ta.pivothigh(high, divLookback, divLookback)
float divPivotLow = ta.pivotlow(low, divLookback, divLookback)

if confirmed and not na(divPivotHigh)
    int currentPivotBar = bar_index - divLookback
    float currentCrsiHigh = crsi[divLookback]
    if not na(prevHighPriceCrsi) and not na(prevHighBarCrsi)
        int barDistance = currentPivotBar - prevHighBarCrsi
        if barDistance > 0 and barDistance <= divMaxBars
            crsiRegBearDiv := includeRegularDiv and divPivotHigh > prevHighPriceCrsi and currentCrsiHigh < prevHighOscCrsi
            crsiHidBearDiv := includeHiddenDiv and divPivotHigh < prevHighPriceCrsi and currentCrsiHigh > prevHighOscCrsi
    prevHighPriceCrsi := divPivotHigh
    prevHighOscCrsi := currentCrsiHigh
    prevHighBarCrsi := currentPivotBar

if confirmed and not na(divPivotLow)
    int currentPivotBar = bar_index - divLookback
    float currentCrsiLow = crsi[divLookback]
    if not na(prevLowPriceCrsi) and not na(prevLowBarCrsi)
        int barDistance = currentPivotBar - prevLowBarCrsi
        if barDistance > 0 and barDistance <= divMaxBars
            crsiRegBullDiv := includeRegularDiv and divPivotLow < prevLowPriceCrsi and currentCrsiLow > prevLowOscCrsi
            crsiHidBullDiv := includeHiddenDiv and divPivotLow > prevLowPriceCrsi and currentCrsiLow < prevLowOscCrsi
    prevLowPriceCrsi := divPivotLow
    prevLowOscCrsi := currentCrsiLow
    prevLowBarCrsi := currentPivotBar

if confirmed and not na(divPivotHigh)
    int currentPivotBar = bar_index - divLookback
    float currentObvHigh = obvOsc[divLookback]
    if not na(prevHighPriceObv) and not na(prevHighBarObv)
        int barDistance = currentPivotBar - prevHighBarObv
        if barDistance > 0 and barDistance <= divMaxBars
            obvRegBearDiv := includeRegularDiv and divPivotHigh > prevHighPriceObv and currentObvHigh < prevHighOscObv
            obvHidBearDiv := includeHiddenDiv and divPivotHigh < prevHighPriceObv and currentObvHigh > prevHighOscObv
    prevHighPriceObv := divPivotHigh
    prevHighOscObv := currentObvHigh
    prevHighBarObv := currentPivotBar

if confirmed and not na(divPivotLow)
    int currentPivotBar = bar_index - divLookback
    float currentObvLow = obvOsc[divLookback]
    if not na(prevLowPriceObv) and not na(prevLowBarObv)
        int barDistance = currentPivotBar - prevLowBarObv
        if barDistance > 0 and barDistance <= divMaxBars
            obvRegBullDiv := includeRegularDiv and divPivotLow < prevLowPriceObv and currentObvLow > prevLowOscObv
            obvHidBullDiv := includeHiddenDiv and divPivotLow > prevLowPriceObv and currentObvLow < prevLowOscObv
    prevLowPriceObv := divPivotLow
    prevLowOscObv := currentObvLow
    prevLowBarObv := currentPivotBar

bool crsiBullDiv = crsiRegBullDiv or crsiHidBullDiv
bool crsiBearDiv = crsiRegBearDiv or crsiHidBearDiv
bool obvBullDiv = obvRegBullDiv or obvHidBullDiv
bool obvBearDiv = obvRegBearDiv or obvHidBearDiv
bool bullDivNow = crsiBullDiv or obvBullDiv
bool bearDivNow = crsiBearDiv or obvBearDiv
string bullDivSourceNow = ""
bullDivSourceNow := crsiBullDiv ? appendSource(bullDivSourceNow, "cRSI") : bullDivSourceNow
bullDivSourceNow := obvBullDiv ? appendSource(bullDivSourceNow, "OBV") : bullDivSourceNow
string bearDivSourceNow = ""
bearDivSourceNow := crsiBearDiv ? appendSource(bearDivSourceNow, "cRSI") : bearDivSourceNow
bearDivSourceNow := obvBearDiv ? appendSource(bearDivSourceNow, "OBV") : bearDivSourceNow

// -----------------------------------------------------------------------------
// MR windows and component collection.
// -----------------------------------------------------------------------------
var bool lowerWindowActive = false
var bool upperWindowActive = false
var bool lowerWindowUsed = false
var bool upperWindowUsed = false
var int lowerWindowStart = na
var int upperWindowStart = na

var bool upperBullTouchSeen = false
var string upperBullTouchLine = ""
var bool upperBullFractalSeen = false
var bool upperBearFractalSeen = false
var bool upperBullEmaCrossSeen = false
var bool upperBearEmaCrossSeen = false
var bool lowerBullFractalSeen = false
var bool lowerBullEmaCrossSeen = false
var bool lowerBearTouchSeen = false
var string lowerBearTouchLine = ""
var bool lowerBearFractalSeen = false
var bool lowerBearEmaCrossSeen = false

var bool bullDivSeen = false
var string bullDivSource = ""
var int bullDivBar = na
var bool bearDivSeen = false
var string bearDivSource = ""
var int bearDivBar = na

if isNewTradingDay
    lowerWindowActive := false
    upperWindowActive := false
    lowerWindowUsed := false
    upperWindowUsed := false
    lowerWindowStart := na
    upperWindowStart := na
    upperBullTouchSeen := false
    upperBullTouchLine := ""
    upperBullFractalSeen := false
    upperBearFractalSeen := false
    upperBullEmaCrossSeen := false
    upperBearEmaCrossSeen := false
    lowerBullFractalSeen := false
    lowerBullEmaCrossSeen := false
    lowerBearTouchSeen := false
    lowerBearTouchLine := ""
    lowerBearFractalSeen := false
    lowerBearEmaCrossSeen := false
    bullDivSeen := false
    bullDivSource := ""
    bullDivBar := na
    bearDivSeen := false
    bearDivSource := ""
    bearDivBar := na

bool lowerActivationEvent = sdLowerHit and (not lowerWindowActive or lowerWindowUsed or na(lowerWindowStart) or bar_index - lowerWindowStart > mrWindowBars)
bool upperActivationEvent = sdUpperHit and (not upperWindowActive or upperWindowUsed or na(upperWindowStart) or bar_index - upperWindowStart > mrWindowBars)

if lowerActivationEvent
    lowerWindowActive := true
    lowerWindowUsed := false
    lowerWindowStart := bar_index
    lowerBullFractalSeen := false
    lowerBullEmaCrossSeen := false
    lowerBearTouchSeen := false
    lowerBearTouchLine := ""
    lowerBearFractalSeen := false
    lowerBearEmaCrossSeen := false

if upperActivationEvent
    upperWindowActive := true
    upperWindowUsed := false
    upperWindowStart := bar_index
    upperBullTouchSeen := false
    upperBullTouchLine := ""
    upperBullFractalSeen := false
    upperBearFractalSeen := false
    upperBullEmaCrossSeen := false
    upperBearEmaCrossSeen := false

if lowerWindowActive and not na(lowerWindowStart) and bar_index - lowerWindowStart > mrWindowBars
    lowerWindowActive := false
if upperWindowActive and not na(upperWindowStart) and bar_index - upperWindowStart > mrWindowBars
    upperWindowActive := false

bool lowerWindowValid = lowerWindowActive and not lowerWindowUsed and not na(lowerWindowStart) and bar_index > lowerWindowStart and bar_index - lowerWindowStart <= mrWindowBars
bool upperWindowValid = upperWindowActive and not upperWindowUsed and not na(upperWindowStart) and bar_index > upperWindowStart and bar_index - upperWindowStart <= mrWindowBars

if lowerWindowActive and not lowerWindowUsed
    lowerBullFractalSeen := lowerBullFractalSeen or fractalBull
    lowerBullEmaCrossSeen := lowerBullEmaCrossSeen or emaGoldenCross
    if emaBearTouch
        lowerBearTouchSeen := true
        lowerBearTouchLine := bearTouchLine
    lowerBearFractalSeen := lowerBearFractalSeen or fractalBear
    lowerBearEmaCrossSeen := lowerBearEmaCrossSeen or emaDeathCross

if upperWindowActive and not upperWindowUsed
    if emaBullTouch
        upperBullTouchSeen := true
        upperBullTouchLine := bullTouchLine
    upperBullFractalSeen := upperBullFractalSeen or fractalBull
    upperBearFractalSeen := upperBearFractalSeen or fractalBear
    upperBullEmaCrossSeen := upperBullEmaCrossSeen or emaGoldenCross
    upperBearEmaCrossSeen := upperBearEmaCrossSeen or emaDeathCross

if bullDivNow
    bullDivSeen := true
    bullDivSource := bullDivSourceNow
    bullDivBar := bar_index
if bearDivNow
    bearDivSeen := true
    bearDivSource := bearDivSourceNow
    bearDivBar := bar_index
if bullDivSeen and not na(bullDivBar) and bar_index - bullDivBar > divMaxBars
    bullDivSeen := false
    bullDivSource := ""
    bullDivBar := na
if bearDivSeen and not na(bearDivBar) and bar_index - bearDivBar > divMaxBars
    bearDivSeen := false
    bearDivSource := ""
    bearDivBar := na

// -----------------------------------------------------------------------------
// Setup assembly and filters.
// -----------------------------------------------------------------------------
int longTrendUpperDirectionComponents = directionComponentCount(upperBullFractalSeen, bullDivSeen, upperBullEmaCrossSeen)
int longMrLowerDirectionComponents = directionComponentCount(lowerBullFractalSeen, bullDivSeen, lowerBullEmaCrossSeen)
int shortMrUpperDirectionComponents = directionComponentCount(upperBearFractalSeen, bearDivSeen, upperBearEmaCrossSeen)
int shortTrendLowerDirectionComponents = directionComponentCount(lowerBearFractalSeen, bearDivSeen, lowerBearEmaCrossSeen)
bool setupLongTrendUpper = upperWindowValid and upperBullTouchSeen and longTrendUpperDirectionComponents >= 2
bool setupLongMrLower = lowerWindowValid and longMrLowerDirectionComponents >= 2
bool setupShortMrUpper = upperWindowValid and shortMrUpperDirectionComponents >= 2
bool setupShortTrendLower = lowerWindowValid and lowerBearTouchSeen and shortTrendLowerDirectionComponents >= 2

bool longRaw = allowLong and (setupLongTrendUpper or setupLongMrLower)
bool shortRaw = allowShort and (setupShortMrUpper or setupShortTrendLower)
string longSetup = setupLongTrendUpper ? "trend_sdUpper" : setupLongMrLower ? "mr_sdLower" : "none"
string shortSetup = setupShortMrUpper ? "mr_sdUpper" : setupShortTrendLower ? "trend_sdLower" : "none"
string longReason = setupLongTrendUpper ? "SD upper trend-continuation long: EMA touch + 2 of 3 bull direction components" : setupLongMrLower ? "SD lower mean-reversion long: 2 of 3 bull direction components" : "none"
string shortReason = setupShortMrUpper ? "SD upper mean-reversion short: 2 of 3 bear direction components" : setupShortTrendLower ? "SD lower trend-continuation short: EMA touch + 2 of 3 bear direction components" : "none"

string mtfTf1LongState = mtfStateForDirection("long", mtfTf1EmaDir, mtfTf1DtpDir)
string mtfTf2LongState = mtfStateForDirection("long", mtfTf2EmaDir, mtfTf2DtpDir)
string mtfTf3LongState = mtfStateForDirection("long", mtfTf3EmaDir, mtfTf3DtpDir)
string mtfTf1ShortState = mtfStateForDirection("short", mtfTf1EmaDir, mtfTf1DtpDir)
string mtfTf2ShortState = mtfStateForDirection("short", mtfTf2EmaDir, mtfTf2DtpDir)
string mtfTf3ShortState = mtfStateForDirection("short", mtfTf3EmaDir, mtfTf3DtpDir)
float mtfLongScore = mtfScoreForStates(mtfTf1LongState, mtfTf2LongState, mtfTf3LongState)
float mtfShortScore = mtfScoreForStates(mtfTf1ShortState, mtfTf2ShortState, mtfTf3ShortState)
string mtfLongStatus = mtfStatusForStates(mtfTf1LongState, mtfTf2LongState, mtfTf3LongState)
string mtfShortStatus = mtfStatusForStates(mtfTf1ShortState, mtfTf2ShortState, mtfTf3ShortState)
string mtfLongBlockReason = mtfBlockReasonForStates(mtfTf1LongState, mtfTf2LongState)
string mtfShortBlockReason = mtfBlockReasonForStates(mtfTf1ShortState, mtfTf2ShortState)
bool mtfLongBlock = mtfLongStatus == "block"
bool mtfShortBlock = mtfShortStatus == "block"

bool emaWeak = math.abs(calcSlope(emaFast, emaSlopeLookback)) < emaMinAngle or math.abs(slopeSlow) < emaMinAngle or not spacingOk
bool blockLong = false
string blockLongReason = ""
if useDtpFilter and setupLongMrLower and dtpDir == -1 and dtpMrBlocksPhase(dtpMrFilterMode, dtpPhase)
    blockLong := true
    blockLongReason := dtpBlockReasonText("long", dtpMrFilterMode)
else if mtfLongBlock and longRaw
    blockLong := true
    blockLongReason := mtfLongBlockReason
else if lowVolatilityEntryBlocked and longRaw
    blockLong := true
    blockLongReason := "low_volatility"
else if useEmaWeakFilter and setupLongTrendUpper and emaWeak
    blockLong := true
    blockLongReason := "ema_weak"

bool blockShort = false
string blockShortReason = ""
if useDtpFilter and setupShortMrUpper and dtpDir == 1 and dtpMrBlocksPhase(dtpMrFilterMode, dtpPhase)
    blockShort := true
    blockShortReason := dtpBlockReasonText("short", dtpMrFilterMode)
else if mtfShortBlock and shortRaw
    blockShort := true
    blockShortReason := mtfShortBlockReason
else if lowVolatilityEntryBlocked and shortRaw
    blockShort := true
    blockShortReason := "low_volatility"
else if useEmaWeakFilter and setupShortTrendLower and emaWeak
    blockShort := true
    blockShortReason := "ema_weak"

bool conflict = longRaw and shortRaw

int scoreLongTrendUpper = math.min(100, (upperWindowValid ? 25 : 0) + (upperBullTouchSeen ? 25 : 0) + (upperBullFractalSeen ? 25 : 0) + (bullDivSeen ? 25 : 0) + (upperBullEmaCrossSeen ? 25 : 0))
int scoreLongMrLower = math.min(100, (lowerWindowValid ? 34 : 0) + (lowerBullFractalSeen ? 33 : 0) + (bullDivSeen ? 33 : 0) + (lowerBullEmaCrossSeen ? 33 : 0))
int scoreShortMrUpper = math.min(100, (upperWindowValid ? 34 : 0) + (upperBearFractalSeen ? 33 : 0) + (bearDivSeen ? 33 : 0) + (upperBearEmaCrossSeen ? 33 : 0))
int scoreShortTrendLower = math.min(100, (lowerWindowValid ? 25 : 0) + (lowerBearTouchSeen ? 25 : 0) + (lowerBearFractalSeen ? 25 : 0) + (bearDivSeen ? 25 : 0) + (lowerBearEmaCrossSeen ? 25 : 0))
int activityScore = math.max(math.max(scoreLongTrendUpper, scoreLongMrLower), math.max(scoreShortMrUpper, scoreShortTrendLower))
string candidateDirection = scoreLongTrendUpper >= scoreLongMrLower and scoreLongTrendUpper >= scoreShortMrUpper and scoreLongTrendUpper >= scoreShortTrendLower ? "long" : scoreLongMrLower >= scoreShortMrUpper and scoreLongMrLower >= scoreShortTrendLower ? "long" : "short"
string candidateSetup = activityScore == scoreLongTrendUpper ? "trend_sdUpper" : activityScore == scoreLongMrLower ? "mr_sdLower" : activityScore == scoreShortMrUpper ? "mr_sdUpper" : "trend_sdLower"
string activityGrade = activityScore >= 100 ? "ready" : activityScore >= preAlertThreshold ? "pre_alert" : activityScore > 0 ? "building" : "quiet"

string missingComponents = ""
if candidateSetup == "trend_sdUpper"
    missingComponents := not upperWindowValid ? appendSource(missingComponents, "upper_window") : missingComponents
    missingComponents := not upperBullTouchSeen ? appendSource(missingComponents, "ema_bull_touch") : missingComponents
    if longTrendUpperDirectionComponents < 2
        missingComponents := not upperBullFractalSeen ? appendSource(missingComponents, "bull_fractal") : missingComponents
        missingComponents := not bullDivSeen ? appendSource(missingComponents, "bull_divergence") : missingComponents
        missingComponents := not upperBullEmaCrossSeen ? appendSource(missingComponents, "bull_ema_cross") : missingComponents
else if candidateSetup == "mr_sdLower"
    missingComponents := not lowerWindowValid ? appendSource(missingComponents, "lower_window") : missingComponents
    if longMrLowerDirectionComponents < 2
        missingComponents := not lowerBullFractalSeen ? appendSource(missingComponents, "bull_fractal") : missingComponents
        missingComponents := not bullDivSeen ? appendSource(missingComponents, "bull_divergence") : missingComponents
        missingComponents := not lowerBullEmaCrossSeen ? appendSource(missingComponents, "bull_ema_cross") : missingComponents
else if candidateSetup == "mr_sdUpper"
    missingComponents := not upperWindowValid ? appendSource(missingComponents, "upper_window") : missingComponents
    if shortMrUpperDirectionComponents < 2
        missingComponents := not upperBearFractalSeen ? appendSource(missingComponents, "bear_fractal") : missingComponents
        missingComponents := not bearDivSeen ? appendSource(missingComponents, "bear_divergence") : missingComponents
        missingComponents := not upperBearEmaCrossSeen ? appendSource(missingComponents, "bear_ema_cross") : missingComponents
else
    missingComponents := not lowerWindowValid ? appendSource(missingComponents, "lower_window") : missingComponents
    missingComponents := not lowerBearTouchSeen ? appendSource(missingComponents, "ema_bear_touch") : missingComponents
    if shortTrendLowerDirectionComponents < 2
        missingComponents := not lowerBearFractalSeen ? appendSource(missingComponents, "bear_fractal") : missingComponents
        missingComponents := not bearDivSeen ? appendSource(missingComponents, "bear_divergence") : missingComponents
        missingComponents := not lowerBearEmaCrossSeen ? appendSource(missingComponents, "bear_ema_cross") : missingComponents
missingComponents := missingComponents == "" ? "none" : missingComponents

mtfScoreForDirection(string direction) =>
    direction == "short" ? mtfShortScore : mtfLongScore

mtfStatusForDirection(string direction) =>
    direction == "short" ? mtfShortStatus : mtfLongStatus

mtfBlockReasonForDirection(string direction) =>
    direction == "short" ? mtfShortBlockReason : mtfLongBlockReason

mtfState1ForDirection(string direction) =>
    direction == "short" ? mtfTf1ShortState : mtfTf1LongState

mtfState2ForDirection(string direction) =>
    direction == "short" ? mtfTf2ShortState : mtfTf2LongState

mtfState3ForDirection(string direction) =>
    direction == "short" ? mtfTf3ShortState : mtfTf3LongState

mtfSummaryForDirection(string direction) =>
    if not enableMtf
        "off"
    else
        string s1 = mtfState1ForDirection(direction)
        string s2 = mtfState2ForDirection(direction)
        string s3 = mtfState3ForDirection(direction)
        "MTF " + mtfConfirmTf1 + mtfDisplayMark(s1) + " " + mtfConfirmTf2 + mtfDisplayMark(s2) + " " + mtfConfirmTf3 + mtfDisplayMark(s3) + " score " + str.tostring(mtfScoreForDirection(direction), "#") + " " + mtfStatusForDirection(direction)

mtfPayloadForDirection(string direction) =>
    string s1 = mtfState1ForDirection(direction)
    string s2 = mtfState2ForDirection(direction)
    string s3 = mtfState3ForDirection(direction)
    float p1 = mtfStatePoints(s1, 45.0)
    float p2 = mtfStatePoints(s2, 35.0)
    float p3 = mtfStatePoints(s3, 20.0)
    string blockReason = mtfBlockReasonForDirection(direction)
    jsonStr("entry_tf", timeframe.period) +
     jsonStr("confirm_tfs", MTF_CONFIRM_TFS) +
     jsonStr("mtf_status", mtfStatusForDirection(direction)) +
     jsonNum("mtf_score", mtfScoreForDirection(direction)) +
     jsonStr("mtf_block_reason", blockReason) +
     ',"mtf":{"enabled":' + boolText(enableMtf) +
     ',"mode":"' + mtfMode + '"' +
     ',"entry_tf":"' + timeframe.period + '"' +
     ',"confirm_tfs":"' + MTF_CONFIRM_TFS + '"' +
     ',"score":' + str.tostring(mtfScoreForDirection(direction), "#.##") +
     ',"status":"' + mtfStatusForDirection(direction) + '"' +
     ',"block_reason":"' + blockReason + '"' +
     ',"votes":{"pass":' + str.tostring((s1 == "pass" ? 1 : 0) + (s2 == "pass" ? 1 : 0) + (s3 == "pass" ? 1 : 0), "#") +
     ',"warn":' + str.tostring((s1 == "warn" ? 1 : 0) + (s2 == "warn" ? 1 : 0) + (s3 == "warn" ? 1 : 0), "#") +
     ',"fail":' + str.tostring((s1 == "fail" ? 1 : 0) + (s2 == "fail" ? 1 : 0) + (s3 == "fail" ? 1 : 0), "#") + '}' +
     ',"states":{"tf1":' + mtfStateJson(mtfConfirmTf1, s1, mtfTf1EmaDir, mtfTf1DtpDir, 45.0, p1) +
     ',"tf2":' + mtfStateJson(mtfConfirmTf2, s2, mtfTf2EmaDir, mtfTf2DtpDir, 35.0, p2) +
     ',"tf3":' + mtfStateJson(mtfConfirmTf3, s3, mtfTf3EmaDir, mtfTf3DtpDir, 20.0, p3) + '}}'

volatilityPayload() =>
    jsonBool("volatility_filter_enabled", useVolatilityFilter) +
     jsonNum("min_atr_pct_for_entry", minAtrPctForEntry) +
     jsonNum("volatility_atr_pct", atrPct) +
     jsonBool("volatility_entry_blocked", lowVolatilityEntryBlocked) +
     jsonBool("volatility_entry_allowed", not lowVolatilityEntryBlocked)

// -----------------------------------------------------------------------------
// Position/risk state.
// -----------------------------------------------------------------------------
var string activePositionId = ""
var string activeSignalId = ""
var int activeDirection = 0
var string activeSetup = ""
var float activeEntry = na
var float activeStop = na
var float activeTarget = na
var float activeRunnerActivation = na
var float activeInitialRisk = na
var float activeQty = na
var int activeEntryBar = na
var bool activeRunnerMode = false
var bool activeRunnerActive = false
var float activeRunnerExtreme = na
var bool activeBreakevenDone = false
var int activeRiskUpdateSeq = 0
var string pendingExitReason = ""
var int eodForceCloseDay = na
var string lastExitReason = ""
var string lastExitTimeText = ""
var float lastExitPrice = na
var float lastExitPnl = na
var float lastExitPnlPct = na

calcQty(float entryPrice) =>
    entryPrice > 0.0 ? math.max(1.0, math.floor(positionAmount / entryPrice)) : 0.0

calcLongStop(float entryPrice, float qty) =>
    float atrStop = entryPrice - atrVal * slAtrMult
    float riskStop = qty > 0.0 ? entryPrice - maxLossPerTrade / qty : atrStop
    math.max(atrStop, riskStop)

calcShortStop(float entryPrice, float qty) =>
    float atrStop = entryPrice + atrVal * slAtrMult
    float riskStop = qty > 0.0 ? entryPrice + maxLossPerTrade / qty : atrStop
    math.min(atrStop, riskStop)

buildEntryPayload(string eventIdValue, string positionIdValue, string direction, string setup, string reason, float qty, float entryPrice, float stopPrice, float targetPrice, float runnerActivationPrice, bool runnerMode, string divSource, string touchLine) =>
    float riskPerShare = direction == "long" ? entryPrice - stopPrice : stopPrice - entryPrice
    float targetCheckpoint = runnerMode ? runnerActivationPrice : targetPrice
    basePayload("entry", eventIdValue, positionIdValue) +
     jsonStr("signal_id", eventIdValue) +
     jsonStr("direction", direction) +
     jsonStr("position_side", direction) +
     jsonStr("setup", setup) +
     jsonStr("reason", reason) +
     jsonNum("quantity", qty) +
     jsonNum("shares", qty) +
     jsonNum("entry_price", entryPrice) +
     jsonNum("entry", entryPrice) +
     jsonNum("stop_loss", stopPrice) +
     jsonNum("take_profit", targetPrice) +
     jsonNum("target_checkpoint", targetCheckpoint) +
     jsonNum("safety_take_profit", targetPrice) +
     jsonNum("runner_activation_price", runnerActivationPrice) +
     jsonNum("runner_activation_r", runnerActivationR) +
     jsonBool("runner_enabled", runnerMode) +
     jsonBool("runner_active", false) +
     jsonBool("tp_checkpoint_runner", runnerMode) +
     jsonBool("target_is_hard", not runnerMode) +
     jsonBool("target_checkpoint_is_exit", not runnerMode) +
     jsonStr("target_role", runnerMode ? "safety_tp" : "hard_tp") +
     jsonNum("risk_per_share", riskPerShare) +
     jsonNum("reward_risk", rrRatio) +
     jsonStr("divergence_source", divSource == "" ? "none" : divSource) +
     jsonStr("ema_touch_line", touchLine) +
     jsonInt("activity_score", activityScore) +
     jsonInt("quality_score", activityScore) +
     jsonStr("activity_grade", activityGrade) +
     mtfPayloadForDirection(direction) +
     volatilityPayload() +
     jsonStr("sd_zone", sdZone == 1 ? "overbought" : sdZone == -1 ? "oversold" : "normal") +
     jsonStr("sd_trend", sdTrend == 1 ? "up" : sdTrend == -1 ? "down" : "flat") +
     jsonStr("dtp_dir", dtpDir == 1 ? "bullish" : dtpDir == -1 ? "bearish" : "neutral") +
     jsonStr("dtp_phase", dtpPhase) +
     jsonInt("dtp_phase_bars", dtpPhaseBars) +
     jsonNum("atr", atrRaw) +
     jsonNum("atr_pct", atrPct) +
     jsonNum("close", close) +
     jsonInt("bar_index", bar_index) +
     '}'

buildRiskPayload(string eventIdValue, string positionIdValue, string updateReason, string requestedSides, float previousStop, float previousTarget, float newStop, float newTarget) =>
    float effectiveStop = na(newStop) ? activeStop : newStop
    float riskPerShare = activeDirection == 1 ? activeEntry - effectiveStop : effectiveStop - activeEntry
    float targetCheckpoint = activeRunnerMode ? activeRunnerActivation : activeTarget
    basePayload("risk_update", eventIdValue, positionIdValue) +
     jsonStr("signal_id", activeSignalId) +
     jsonStr("direction", activeDirection == 1 ? "long" : "short") +
     jsonStr("position_side", activeDirection == 1 ? "long" : "short") +
     jsonStr("setup", activeSetup) +
     jsonStr("update_reason", updateReason) +
     jsonStr("risk_update_reason", updateReason) +
     jsonInt("risk_update_seq", activeRiskUpdateSeq) +
     jsonRequestedSides(requestedSides) +
     jsonNum("entry_price", activeEntry) +
     jsonNum("quantity", activeQty) +
     jsonNum("previous_stop_loss", previousStop) +
     jsonNum("previous_take_profit", previousTarget) +
     jsonNum("new_stop_loss", newStop) +
     jsonNum("new_take_profit", newTarget) +
     jsonNum("target_checkpoint", targetCheckpoint) +
     jsonNum("take_profit", activeTarget) +
     jsonNum("safety_take_profit", activeTarget) +
     jsonNum("runner_activation_price", activeRunnerActivation) +
     jsonNum("runner_activation_r", runnerActivationR) +
     jsonBool("runner_enabled", activeRunnerMode) +
     jsonBool("runner_active", activeRunnerActive) +
     jsonBool("tp_checkpoint_runner", activeRunnerMode) +
     jsonBool("target_checkpoint_hit", activeRunnerActive) +
     jsonBool("target_checkpoint_is_exit", not activeRunnerMode) +
     jsonStr("target_role", activeRunnerMode ? "safety_tp" : "hard_tp") +
     jsonNum("risk_per_share", riskPerShare) +
     jsonNum("reward_risk", rrRatio) +
     jsonNum("close", close) +
     jsonInt("bar_index", bar_index) +
     '}'

buildExitPayload(string eventIdValue, string positionIdValue, string exitReason, float exitPrice) =>
    float pnlPerShare = activeDirection == 1 ? exitPrice - activeEntry : activeEntry - exitPrice
    float targetCheckpoint = activeRunnerMode ? activeRunnerActivation : activeTarget
    basePayload("exit", eventIdValue, positionIdValue) +
     jsonStr("signal_id", activeSignalId) +
     jsonStr("direction", activeDirection == 1 ? "long" : "short") +
     jsonStr("position_side", activeDirection == 1 ? "long" : "short") +
     jsonStr("setup", activeSetup) +
     jsonStr("exit_reason", exitReason) +
     jsonNum("entry_price", activeEntry) +
     jsonNum("exit_price", exitPrice) +
     jsonNum("quantity", activeQty) +
     jsonNum("stop_loss", activeStop) +
     jsonNum("take_profit", activeTarget) +
     jsonNum("target_checkpoint", targetCheckpoint) +
     jsonNum("safety_take_profit", activeTarget) +
     jsonNum("runner_activation_price", activeRunnerActivation) +
     jsonNum("runner_activation_r", runnerActivationR) +
     jsonBool("runner_enabled", activeRunnerMode) +
     jsonBool("runner_active", activeRunnerActive) +
     jsonBool("tp_checkpoint_runner", activeRunnerMode) +
     jsonBool("target_checkpoint_hit", activeRunnerActive) +
     jsonBool("target_checkpoint_is_exit", not activeRunnerMode) +
     jsonStr("target_role", activeRunnerMode ? "safety_tp" : "hard_tp") +
     jsonNum("pnl_per_share", pnlPerShare) +
     jsonNum("pnl_estimate", pnlPerShare * activeQty) +
     jsonInt("entry_bar_index", activeEntryBar) +
     jsonInt("bar_index", bar_index) +
     '}'

buildPreAlertPayload(string eventIdValue, string pendingPositionId, string activationWindow) =>
    basePayload("pre_alert", eventIdValue, pendingPositionId) +
     jsonStr("pre_alert_stage", "window_activation") +
     jsonStr("activation_window", activationWindow) +
     jsonNum("activation_window_upper", sdSignalUpper) +
     jsonNum("activation_window_lower", sdSignalLower) +
     jsonBool("entry_decides_direction", true) +
     jsonInt("activity_score", activityScore) +
     jsonInt("quality_score", activityScore) +
     jsonBool("qualified", false) +
     jsonStr("activity_grade", activityGrade) +
     volatilityPayload() +
     jsonStr("missing_components", missingComponents) +
     jsonBool("lower_window_valid", lowerWindowValid) +
     jsonBool("upper_window_valid", upperWindowValid) +
     jsonBool("bull_div_seen", bullDivSeen) +
     jsonBool("bear_div_seen", bearDivSeen) +
     jsonBool("ema_bull_touch_seen", upperBullTouchSeen) +
     jsonBool("ema_bear_touch_seen", lowerBearTouchSeen) +
     jsonBool("bull_fractal_seen", lowerBullFractalSeen or upperBullFractalSeen) +
     jsonBool("bear_fractal_seen", lowerBearFractalSeen or upperBearFractalSeen) +
     jsonBool("bull_ema_cross_seen", lowerBullEmaCrossSeen or upperBullEmaCrossSeen) +
     jsonBool("bear_ema_cross_seen", lowerBearEmaCrossSeen or upperBearEmaCrossSeen) +
     jsonStr("bull_divergence_source", bullDivSource == "" ? "none" : bullDivSource) +
     jsonStr("bear_divergence_source", bearDivSource == "" ? "none" : bearDivSource) +
     jsonStr("sd_zone", sdZone == 1 ? "overbought" : sdZone == -1 ? "oversold" : "normal") +
     jsonStr("dtp_dir", dtpDir == 1 ? "bullish" : dtpDir == -1 ? "bearish" : "neutral") +
     jsonStr("dtp_phase", dtpPhase) +
     jsonNum("close", close) +
     jsonNum("atr", atrRaw) +
     jsonNum("atr_pct", atrPct) +
     jsonInt("bar_index", bar_index) +
     '}'

// -----------------------------------------------------------------------------
// TV-primary event flow: pre_alert -> entry -> risk_update -> exit.
// -----------------------------------------------------------------------------
bool exitedNow = confirmed and activePositionId != "" and strategy.position_size == 0 and strategy.position_size[1] != 0
if exitedNow
    float exitPrice = strategy.closedtrades > 0 ? strategy.closedtrades.exit_price(strategy.closedtrades - 1) : close
    string exitReason = pendingExitReason != "" ? pendingExitReason : "strategy_closed"
    if pendingExitReason == ""
        bool targetExit = exitTouchesTarget(activeDirection, exitPrice, activeTarget)
        bool stopExit = exitTouchesStop(activeDirection, exitPrice, activeStop)
        exitReason := targetExit ? "take_profit" : stopExit ? "stop_loss" : exitReason
    float exitPnlPerShare = activeDirection == 1 ? exitPrice - activeEntry : activeEntry - exitPrice
    if exitReason == "stop_loss" and activeRunnerActive and exitPnlPerShare > 0.0
        exitReason := "runner_stop"
    lastExitReason := exitReason
    lastExitPrice := exitPrice
    lastExitPnl := exitPnlPerShare * activeQty
    lastExitPnlPct := activeEntry > 0.0 ? exitPnlPerShare / activeEntry * 100.0 : na
    lastExitTimeText := str.format_time(time_close, "HH:mm", "America/New_York")
    if enableAlerts
        alert(buildExitPayload(eventId("exit", exitReason), activePositionId, exitReason, exitPrice), alert.freq_all)
    if showFlowLabels
        float exitY = activeDirection == -1 ? low - atrVal * 3.6 : high + atrVal * 3.6
        label.new(bar_index, exitY, exitPnlLabelText(exitReason, lastExitTimeText, exitPrice, lastExitPnl, lastExitPnlPct), style=activeDirection == -1 ? label.style_label_up : label.style_label_down, color=exitPnlLabelColor(lastExitPnl), textcolor=color.white, size=size.normal)
    pendingExitReason := ""
    activePositionId := ""
    activeSignalId := ""
    activeDirection := 0
    activeSetup := ""
    activeEntry := na
    activeStop := na
    activeTarget := na
    activeRunnerActivation := na
    activeInitialRisk := na
    activeQty := na
    activeEntryBar := na
    activeRunnerMode := false
    activeRunnerActive := false
    activeRunnerExtreme := na
    activeBreakevenDone := false
    activeRiskUpdateSeq := 0

bool flatForEntry = activePositionId == "" and strategy.position_size == 0 and not exitedNow
bool enterLong = canTrade and flatForEntry and longRaw and not shortRaw and not blockLong and not conflict
bool enterShort = canTrade and flatForEntry and shortRaw and not longRaw and not blockShort and not conflict

bool preAlertNow = canTrade and flatForEntry and not enterLong and not enterShort and activityScore >= preAlertThreshold and activityScore < 100 and not conflict
bool preAlertCross = preAlertNow and nz(activityScore[1], 0) < preAlertThreshold
var bool candidateNoticeSentToday = false
if isNewTradingDay
    candidateNoticeSentToday := false
bool lowerCandidateNotice = lowerActivationEvent and not candidateNoticeSentToday
bool upperCandidateNotice = upperActivationEvent and not candidateNoticeSentToday and not lowerCandidateNotice
if enableAlerts and lowerCandidateNotice
    string pendingLowerId = "pending_window_lower_" + str.tostring(time, "#") + "_" + str.tostring(bar_index, "#")
    alert(buildPreAlertPayload(eventId("pre_alert", "window_lower"), pendingLowerId, "lower"), alert.freq_all)
if enableAlerts and upperCandidateNotice
    string pendingUpperId = "pending_window_upper_" + str.tostring(time, "#") + "_" + str.tostring(bar_index, "#")
    alert(buildPreAlertPayload(eventId("pre_alert", "window_upper"), pendingUpperId, "upper"), alert.freq_all)
if lowerCandidateNotice or upperCandidateNotice
    candidateNoticeSentToday := true

string candidateComponentText = componentSummaryForSetup(candidateSetup, upperWindowValid, lowerWindowValid, upperBullTouchSeen, lowerBearTouchSeen, upperBullFractalSeen, lowerBullFractalSeen, upperBearFractalSeen, lowerBearFractalSeen, upperBullEmaCrossSeen, lowerBullEmaCrossSeen, upperBearEmaCrossSeen, lowerBearEmaCrossSeen, bullDivSeen, bearDivSeen)
string candidateProgressText = componentProgressForSetup(candidateSetup, upperWindowValid, lowerWindowValid, upperBullTouchSeen, lowerBearTouchSeen, upperBullFractalSeen, lowerBullFractalSeen, upperBearFractalSeen, lowerBearFractalSeen, upperBullEmaCrossSeen, lowerBullEmaCrossSeen, upperBearEmaCrossSeen, lowerBearEmaCrossSeen, bullDivSeen, bearDivSeen)
string candidateWaitText = waitComponentText(missingComponents)
var string lastPrepareVisualKey = ""
var string lastBlockVisualKey = ""
if isNewTradingDay
    lastPrepareVisualKey := ""
    lastBlockVisualKey := ""
    eodForceCloseDay := na

if showFlowLabels and lowerCandidateNotice
    label.new(bar_index, low - atrVal * 1.4, "已入选候选池\n" + syminfo.ticker + " · SD窗口开启\nSD下轨候选\n非开仓点，等组件", style=label.style_label_up, color=flowLabelColor("activate_lower", "long"), textcolor=color.white, size=size.small)

if showFlowLabels and upperCandidateNotice
    label.new(bar_index, high + atrVal * 1.4, "已入选候选池\n" + syminfo.ticker + " · SD窗口开启\nSD上轨候选\n非开仓点，等组件", style=label.style_label_down, color=flowLabelColor("activate_upper", "short"), textcolor=color.white, size=size.small)

bool observeNow = preAlertNow
bool prepareVisualNow = showFlowLabels and observeNow
string prepareVisualKey = activityGrade + ":" + candidateDirection + ":" + candidateSetup + ":" + missingComponents + ":" + str.tostring(activityScore, "#")
if prepareVisualNow and prepareVisualKey != lastPrepareVisualKey
    float prepareY = candidateDirection == "short" ? high + atrVal * 2.4 : low - atrVal * 2.4
    string prepareText = "观察" + directionDisplayName(candidateDirection) + "\n" + setupDisplayName(candidateSetup) + "\n组件: " + candidateComponentText + "\nMTF: " + mtfSummaryForDirection(candidateDirection) + "\n下一步: " + candidateWaitText
    label.new(bar_index, prepareY, prepareText, style=flowLabelStyle(candidateDirection), color=color.new(color.orange, flowLabelTransparency), textcolor=color.white, size=size.normal)
    lastPrepareVisualKey := prepareVisualKey
if not prepareVisualNow and activityScore == 0
    lastPrepareVisualKey := ""

bool blockedNow = canTrade and flatForEntry and ((longRaw and (blockLong or conflict)) or (shortRaw and (blockShort or conflict)))
bool blockedVisualNow = showFlowLabels and blockedNow
string blockedDirection = longRaw and (blockLong or candidateDirection == "long") ? "long" : "short"
string blockedSetup = blockedDirection == "long" ? longSetup : shortSetup
string blockedReason = conflict ? "long_short_conflict" : blockedDirection == "long" ? blockLongReason : blockShortReason
string blockedVisualKey = blockedDirection + ":" + blockedSetup + ":" + blockedReason
if blockedVisualNow and blockedVisualKey != lastBlockVisualKey
    float blockedY = blockedDirection == "short" ? high + atrVal * 4.0 : low - atrVal * 4.0
    string blockedText = "过滤" + directionDisplayName(blockedDirection) + "\n" + setupDisplayName(blockedSetup) + "\n组件齐，未开仓\n" + mtfSummaryForDirection(blockedDirection) + "\n" + filterActionText(blockedReason, blockedDirection)
    label.new(bar_index, blockedY, blockedText, style=flowLabelStyle(blockedDirection), color=flowLabelColor("blocked", blockedDirection), textcolor=color.white, size=size.small)
    lastBlockVisualKey := blockedVisualKey
if not blockedNow and not longRaw and not shortRaw
    lastBlockVisualKey := ""

if enterLong
    float entryPrice = close
    float qty = calcQty(entryPrice)
    if qty > 0.0
        float stopPrice = calcLongStop(entryPrice, qty)
        bool runnerMode = setupUsesRunner(longSetup)
        float hardTargetPrice = calcTargetAtR(entryPrice, stopPrice, 1, rrRatio)
        float runnerActivationPrice = runnerMode ? calcRunnerActivationTarget(entryPrice, stopPrice, 1) : na
        float targetPrice = runnerMode ? calcRunnerSafetyTarget(entryPrice, stopPrice, 1) : hardTargetPrice
        string posId = positionId("long")
        string entryEventId = eventId("entry", longSetup)
        activePositionId := posId
        activeSignalId := entryEventId
        activeDirection := 1
        activeSetup := longSetup
        activeEntry := entryPrice
        activeStop := stopPrice
        activeTarget := targetPrice
        activeRunnerActivation := runnerActivationPrice
        activeInitialRisk := entryPrice - stopPrice
        activeQty := qty
        activeEntryBar := bar_index
        activeRunnerMode := runnerMode
        activeRunnerActive := false
        activeRunnerExtreme := high
        activeBreakevenDone := false
        activeRiskUpdateSeq := 0
        string divSourceForEntry = bullDivSource == "" ? bullDivSourceNow : bullDivSource
        strategy.entry("TV-L", strategy.long, qty=qty, comment=entryComment("long", longSetup))
        strategy.exit("TV-L-RISK", from_entry="TV-L", stop=activeStop, limit=activeTarget, comment="平多 · TP/SL", comment_profit="平多 · TP止盈", comment_loss="平多 · SL止损")
        if showFlowLabels
            label.new(bar_index, low - atrVal * 3.1, "买入做多\n" + setupDisplayName(longSetup) + "\n组件齐 + 过滤通过\n" + mtfSummaryForDirection("long") + "\n" + dtpEntryFilterText("long", dtpDir, dtpPhase, dtpMrFilterMode, useDtpFilter) + "\nentry " + str.tostring(entryPrice, "#.##"), style=label.style_label_up, color=flowLabelColor("entry", "long"), textcolor=color.white, size=size.normal)
        lowerWindowUsed := setupLongMrLower ? true : lowerWindowUsed
        upperWindowUsed := setupLongTrendUpper ? true : upperWindowUsed
        bullDivSeen := false
        bullDivSource := ""
        bullDivBar := na
        if enableAlerts
            string touchLine = setupLongTrendUpper ? upperBullTouchLine : "none"
            alert(buildEntryPayload(entryEventId, posId, "long", longSetup, longReason, qty, entryPrice, stopPrice, targetPrice, runnerActivationPrice, runnerMode, divSourceForEntry, touchLine), alert.freq_all)
            activeRiskUpdateSeq := activeRiskUpdateSeq + 1
            alert(buildRiskPayload(eventId("risk_update", "initial"), posId, "initial_protection", "stop_loss,take_profit", na, na, stopPrice, targetPrice), alert.freq_all)

if enterShort
    float entryPrice = close
    float qty = calcQty(entryPrice)
    if qty > 0.0
        float stopPrice = calcShortStop(entryPrice, qty)
        bool runnerMode = setupUsesRunner(shortSetup)
        float hardTargetPrice = calcTargetAtR(entryPrice, stopPrice, -1, rrRatio)
        float runnerActivationPrice = runnerMode ? calcRunnerActivationTarget(entryPrice, stopPrice, -1) : na
        float targetPrice = runnerMode ? calcRunnerSafetyTarget(entryPrice, stopPrice, -1) : hardTargetPrice
        string posId = positionId("short")
        string entryEventId = eventId("entry", shortSetup)
        activePositionId := posId
        activeSignalId := entryEventId
        activeDirection := -1
        activeSetup := shortSetup
        activeEntry := entryPrice
        activeStop := stopPrice
        activeTarget := targetPrice
        activeRunnerActivation := runnerActivationPrice
        activeInitialRisk := stopPrice - entryPrice
        activeQty := qty
        activeEntryBar := bar_index
        activeRunnerMode := runnerMode
        activeRunnerActive := false
        activeRunnerExtreme := low
        activeBreakevenDone := false
        activeRiskUpdateSeq := 0
        string divSourceForEntry = bearDivSource == "" ? bearDivSourceNow : bearDivSource
        strategy.entry("TV-S", strategy.short, qty=qty, comment=entryComment("short", shortSetup))
        strategy.exit("TV-S-RISK", from_entry="TV-S", stop=activeStop, limit=activeTarget, comment="平空 · TP/SL", comment_profit="平空 · TP止盈", comment_loss="平空 · SL止损")
        if showFlowLabels
            label.new(bar_index, high + atrVal * 3.1, "卖出做空\n" + setupDisplayName(shortSetup) + "\n组件齐 + 过滤通过\n" + mtfSummaryForDirection("short") + "\n" + dtpEntryFilterText("short", dtpDir, dtpPhase, dtpMrFilterMode, useDtpFilter) + "\nentry " + str.tostring(entryPrice, "#.##"), style=label.style_label_down, color=flowLabelColor("entry", "short"), textcolor=color.white, size=size.normal)
        upperWindowUsed := setupShortMrUpper ? true : upperWindowUsed
        lowerWindowUsed := setupShortTrendLower ? true : lowerWindowUsed
        bearDivSeen := false
        bearDivSource := ""
        bearDivBar := na
        if enableAlerts
            string touchLine = setupShortTrendLower ? lowerBearTouchLine : "none"
            alert(buildEntryPayload(entryEventId, posId, "short", shortSetup, shortReason, qty, entryPrice, stopPrice, targetPrice, runnerActivationPrice, runnerMode, divSourceForEntry, touchLine), alert.freq_all)
            activeRiskUpdateSeq := activeRiskUpdateSeq + 1
            alert(buildRiskPayload(eventId("risk_update", "initial"), posId, "initial_protection", "stop_loss,take_profit", na, na, stopPrice, targetPrice), alert.freq_all)

if confirmed and activePositionId != "" and strategy.position_size != 0
    float previousStop = activeStop
    float previousTarget = activeTarget
    string riskUpdateReason = ""
    bool runnerStateChanged = false
    float initialRisk = activeInitialRisk > 0.0 ? activeInitialRisk : activeDirection == 1 ? activeEntry - activeStop : activeStop - activeEntry
    if activeRunnerMode
        activeRunnerExtreme := activeDirection == 1 ? math.max(nz(activeRunnerExtreme, high), high) : math.min(nz(activeRunnerExtreme, low), low)
    if enableBreakeven and not activeBreakevenDone
        if initialRisk > 0.0 and activeDirection == 1 and close >= activeEntry + initialRisk * breakevenAtR
            activeStop := math.max(activeStop, activeEntry + initialRisk * breakevenOffsetR)
            activeBreakevenDone := priceChanged(previousStop, activeStop)
        if initialRisk > 0.0 and activeDirection == -1 and close <= activeEntry - initialRisk * breakevenAtR
            activeStop := math.min(activeStop, activeEntry - initialRisk * breakevenOffsetR)
            activeBreakevenDone := priceChanged(previousStop, activeStop)
        if activeBreakevenDone
            riskUpdateReason := "breakeven_trail"
    if activeRunnerMode and not activeRunnerActive and not na(activeRunnerActivation)
        bool activationTouched = activeDirection == 1 ? high >= activeRunnerActivation : low <= activeRunnerActivation
        if activationTouched
            activeRunnerActive := true
            runnerStateChanged := true
            float lockStop = activeDirection == 1 ? activeEntry + initialRisk * tpCheckpointLockR : activeEntry - initialRisk * tpCheckpointLockR
            lockStop := activeDirection == 1 ? math.min(lockStop, close - syminfo.mintick) : math.max(lockStop, close + syminfo.mintick)
            float lockedStop = activeDirection == 1 ? math.max(activeStop, lockStop) : math.min(activeStop, lockStop)
            riskUpdateReason := "runner_activation"
            if priceChanged(activeStop, lockedStop)
                activeStop := lockedStop
                riskUpdateReason := "runner_activation"
    if activeRunnerMode and activeRunnerActive
        float trailStop = activeDirection == 1 ? activeRunnerExtreme - atrVal * runnerTrailAtrMult : activeRunnerExtreme + atrVal * runnerTrailAtrMult
        trailStop := activeDirection == 1 ? math.min(trailStop, close - syminfo.mintick) : math.max(trailStop, close + syminfo.mintick)
        bool trailImproved = activeDirection == 1 ? trailStop > activeStop : trailStop < activeStop
        if trailImproved
            activeStop := trailStop
            riskUpdateReason := riskUpdateReason == "" ? "runner_trail_stop" : riskUpdateReason
    bool stopChanged = priceChanged(previousStop, activeStop)
    bool targetChanged = priceChanged(previousTarget, activeTarget)
    bool riskChanged = stopChanged or targetChanged or runnerStateChanged
    if riskChanged and enableAlerts
        string reasonForEvent = riskUpdateReason == "" ? "risk_update" : riskUpdateReason
        string requestedSides = stopChanged and targetChanged ? "stop_loss,take_profit" : stopChanged ? "stop_loss" : targetChanged ? "take_profit" : ""
        float eventNewStop = stopChanged ? activeStop : na
        float eventNewTarget = targetChanged ? activeTarget : na
        activeRiskUpdateSeq := activeRiskUpdateSeq + 1
        alert(buildRiskPayload(eventId("risk_update", reasonForEvent), activePositionId, reasonForEvent, requestedSides, previousStop, previousTarget, eventNewStop, eventNewTarget), alert.freq_all)

int eodCloseHourNow = hour(time_close, "America/New_York")
int eodCloseMinuteNow = minute(time_close, "America/New_York")
bool eodCloseTimeReached = eodCloseHourNow > eodCloseHour or (eodCloseHourNow == eodCloseHour and eodCloseMinuteNow >= eodCloseMinute)
bool eodCloseNow = confirmed and enableEodForceClose and activePositionId != "" and strategy.position_size != 0 and eodCloseTimeReached and (na(eodForceCloseDay) or eodForceCloseDay != dailyTime)
if eodCloseNow
    float eodExitPrice = close
    float eodPnlPerShare = activeDirection == 1 ? eodExitPrice - activeEntry : activeEntry - eodExitPrice
    string eodPositionId = activePositionId
    int eodDirection = activeDirection
    float eodEntry = activeEntry
    float eodQty = activeQty
    pendingExitReason := "force_flat_eod"
    eodForceCloseDay := dailyTime
    strategy.cancel_all()
    strategy.close_all(comment="EOD 强制平仓")
    lastExitReason := "force_flat_eod"
    lastExitPrice := eodExitPrice
    lastExitPnl := eodPnlPerShare * eodQty
    lastExitPnlPct := eodEntry > 0.0 ? eodPnlPerShare / eodEntry * 100.0 : na
    lastExitTimeText := str.format_time(time_close, "HH:mm", "America/New_York")
    if enableAlerts
        alert(buildExitPayload(eventId("exit", "force_flat_eod"), eodPositionId, "force_flat_eod", eodExitPrice), alert.freq_all)
    if showFlowLabels
        float eodY = eodDirection == -1 ? low - atrVal * 3.6 : high + atrVal * 3.6
        label.new(bar_index, eodY, exitPnlLabelText("force_flat_eod", lastExitTimeText, eodExitPrice, lastExitPnl, lastExitPnlPct), style=eodDirection == -1 ? label.style_label_up : label.style_label_down, color=exitPnlLabelColor(lastExitPnl), textcolor=color.white, size=size.normal)
    pendingExitReason := ""
    activePositionId := ""
    activeSignalId := ""
    activeDirection := 0
    activeSetup := ""
    activeEntry := na
    activeStop := na
    activeTarget := na
    activeRunnerActivation := na
    activeInitialRisk := na
    activeQty := na
    activeEntryBar := na
    activeRunnerMode := false
    activeRunnerActive := false
    activeRunnerExtreme := na
    activeBreakevenDone := false
    activeRiskUpdateSeq := 0

if activePositionId != "" and not eodCloseNow
    if activeDirection == 1
        strategy.exit("TV-L-RISK", from_entry="TV-L", stop=activeStop, limit=activeTarget, comment="平多 · TP/SL", comment_profit="平多 · TP止盈", comment_loss="平多 · SL止损")
    if activeDirection == -1
        strategy.exit("TV-S-RISK", from_entry="TV-S", stop=activeStop, limit=activeTarget, comment="平空 · TP/SL", comment_profit="平空 · TP止盈", comment_loss="平空 · SL止损")

// -----------------------------------------------------------------------------
// Visuals
// -----------------------------------------------------------------------------
color dtpLineColor = dtpDir == 1 ? color.new(color.aqua, 0) : dtpDir == -1 ? color.new(color.red, 0) : color.new(color.gray, 25)
plot(showEmaFastSlowLines ? emaFast : na, "EMA 20 快线", color=color.new(color.teal, 0))
plot(showEmaFastSlowLines ? emaSlow : na, "EMA 50 慢线", color=color.new(color.orange, 0))
plot(showEmaContextLines ? emaTrend : na, "EMA 100 趋势", color=color.new(color.blue, 35))
plot(showEmaContextLines ? emaLongest : na, "EMA 200 长线", color=color.new(color.gray, 35))
plot(showDtpTrendLine ? dtpAvg : na, "DTP 趋势线", color=dtpLineColor, linewidth=2)
plot(showSdHelperBandLines ? sdReg : na, "SD regression", color=color.new(color.white, 25))
plot(showBandLines ? sdSignalUpper : na, "SD signal upper", color=color.new(color.red, 30))
plot(showBandLines ? sdSignalLower : na, "SD signal lower", color=color.new(color.green, 30))
plot(showSdHelperBandLines ? sdFilterUpper : na, "SD filter upper", color=color.new(color.red, 75))
plot(showSdHelperBandLines ? sdFilterLower : na, "SD filter lower", color=color.new(color.green, 75))

bool showAnyFractalMarkers = showComponentMarkers or showFractalMarkers
plotshape(showComponentMarkers and sdLowerHit, "SD lower hit", location=location.belowbar, style=shape.triangleup, color=color.new(color.green, 0), size=size.tiny, text="SD-L")
plotshape(showComponentMarkers and sdUpperHit, "SD upper hit", location=location.abovebar, style=shape.triangledown, color=color.new(color.orange, 0), size=size.tiny, text="SD-U")
plotshape(showAnyFractalMarkers and fractalBull, "Fractal bull", location=location.belowbar, style=shape.circle, color=color.new(color.aqua, 0), size=size.tiny, text="F+", offset=-fractalPeriod)
plotshape(showAnyFractalMarkers and fractalBear, "Fractal bear", location=location.abovebar, style=shape.circle, color=color.new(color.fuchsia, 0), size=size.tiny, text="F-", offset=-fractalPeriod)
plotshape(showEmaCrossMarkers and emaGoldenCross, "EMA20/50 golden cross", location=location.belowbar, style=shape.triangleup, color=color.new(color.lime, 0), size=size.small, text="20/50金叉")
plotshape(showEmaCrossMarkers and emaDeathCross, "EMA20/50 death cross", location=location.abovebar, style=shape.triangledown, color=color.new(color.red, 0), size=size.small, text="20/50死叉")
plotshape(showComponentMarkers and bullDivNow, "Bull divergence", location=location.belowbar, style=shape.diamond, color=color.new(color.lime, 0), size=size.tiny, text="D+")
plotshape(showComponentMarkers and bearDivNow, "Bear divergence", location=location.abovebar, style=shape.diamond, color=color.new(color.red, 0), size=size.tiny, text="D-")

float visibleHardTarget = activePositionId != "" and not activeRunnerMode ? activeTarget : na
float visibleSafetyTarget = activePositionId != "" and activeRunnerMode ? activeTarget : na
float visibleRunnerActivation = activePositionId != "" and activeRunnerMode and not activeRunnerActive ? activeRunnerActivation : na
plot(activePositionId != "" ? activeStop : na, "SL / Trailing SL", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)
plot(visibleHardTarget, "TP 真实止盈", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)
plot(visibleSafetyTarget, "Safety TP 真实止盈", color=color.new(color.lime, 0), style=plot.style_linebr, linewidth=2)
plot(visibleRunnerActivation, "Runner Activation", color=color.new(color.blue, 0), style=plot.style_linebr, linewidth=2)

var table flowStatus = table.new(position.top_right, 2, 8, border_width=1)
string statusDirection = activeDirection == -1 ? "做空" : activeDirection == 1 ? "做多" : blockedNow ? directionDisplayName(blockedDirection) : activityScore > 0 ? directionDisplayName(candidateDirection) : "--"
string statusText = activePositionId != "" ? "持仓 " + statusDirection : enterLong ? "买入做多" : enterShort ? "卖出做空" : blockedNow ? "过滤" + directionDisplayName(blockedDirection) : observeNow ? "观察" + directionDisplayName(candidateDirection) : lowerWindowValid or upperWindowValid ? "窗口激活" : "等待"
color statusColor = activePositionId != "" ? flowStatusColor("entry", activeDirection == -1 ? "short" : "long") : blockedNow ? flowStatusColor("blocked", blockedDirection) : observeNow ? color.new(color.orange, 0) : lowerWindowValid ? flowStatusColor("activate_lower", "long") : upperWindowValid ? flowStatusColor("activate_upper", "short") : color.new(color.gray, 20)
string statusSetup = activePositionId != "" ? setupDisplayName(activeSetup) : blockedNow ? setupDisplayName(blockedSetup) : activityScore > 0 ? setupDisplayName(candidateSetup) : "--"
string statusComponents = activePositionId != "" ? "组件齐 + 过滤通过" : blockedNow ? candidateComponentText + " · " + filterActionText(blockedReason, blockedDirection) : activityScore > 0 ? candidateComponentText + " · " + candidateWaitText : "--"
string statusDtp = dtpStateText(dtpDir, dtpPhase)
string statusMtf = activeDirection == -1 ? mtfSummaryForDirection("short") : activeDirection == 1 ? mtfSummaryForDirection("long") : blockedNow ? mtfSummaryForDirection(blockedDirection) : activityScore > 0 ? mtfSummaryForDirection(candidateDirection) : enableMtf ? "MTF 等待信号" : "off"
string lastExitText = lastExitReason != "" ? exitReasonDisplayName(lastExitReason) + " " + lastExitTimeText + " @ " + str.tostring(lastExitPrice, "#.##") + " · PnL " + fmtSignedMoney(lastExitPnl) + " (" + fmtSignedPct(lastExitPnlPct) + ")" : "--"
string runnerRiskText = activeRunnerActive ? "Runner ON / Safety TP " + str.tostring(activeTarget, "#.##") + " / Trail SL " + str.tostring(activeStop, "#.##") : "Runner " + str.tostring(runnerActivationR, "#.##") + "R " + str.tostring(activeRunnerActivation, "#.##") + " / Safety TP " + str.tostring(activeTarget, "#.##") + " / SL " + str.tostring(activeStop, "#.##")
string statusRisk = activePositionId != "" ? (activeRunnerMode ? runnerRiskText : "TP " + str.tostring(activeTarget, "#.##") + " / SL " + str.tostring(activeStop, "#.##")) : lastExitText
if confirmed
    if showStatusPanel
        table.cell(flowStatus, 0, 0, "流程", bgcolor=statusColor, text_color=color.white)
        table.cell(flowStatus, 1, 0, statusText, bgcolor=color.new(color.black, 0), text_color=color.white)
        table.cell(flowStatus, 0, 1, "标的", bgcolor=color.new(color.black, 15), text_color=color.white)
        table.cell(flowStatus, 1, 1, syminfo.ticker + " · " + timeframe.period, bgcolor=color.new(color.black, 15), text_color=color.white)
        table.cell(flowStatus, 0, 2, "方向", bgcolor=color.new(color.black, 15), text_color=color.white)
        table.cell(flowStatus, 1, 2, statusDirection, bgcolor=color.new(color.black, 15), text_color=color.white)
        table.cell(flowStatus, 0, 3, "Setup", bgcolor=color.new(color.black, 15), text_color=color.white)
        table.cell(flowStatus, 1, 3, statusSetup, bgcolor=color.new(color.black, 15), text_color=color.white)
        table.cell(flowStatus, 0, 4, "组件", bgcolor=color.new(color.black, 15), text_color=color.white)
        table.cell(flowStatus, 1, 4, statusComponents, bgcolor=color.new(color.black, 15), text_color=color.white)
        table.cell(flowStatus, 0, 5, "DTP", bgcolor=color.new(color.black, 15), text_color=color.white)
        table.cell(flowStatus, 1, 5, statusDtp, bgcolor=color.new(color.black, 15), text_color=color.white)
        table.cell(flowStatus, 0, 6, "MTF", bgcolor=color.new(color.black, 15), text_color=color.white)
        table.cell(flowStatus, 1, 6, statusMtf, bgcolor=color.new(color.black, 15), text_color=color.white)
        table.cell(flowStatus, 0, 7, "退出", bgcolor=color.new(color.black, 15), text_color=color.white)
        table.cell(flowStatus, 1, 7, statusRisk, bgcolor=color.new(color.black, 15), text_color=color.white)
    else
        table.cell(flowStatus, 0, 0, "", bgcolor=color.new(color.black, 100), text_color=color.new(color.white, 100))
        table.cell(flowStatus, 1, 0, "", bgcolor=color.new(color.black, 100), text_color=color.new(color.white, 100))
        table.cell(flowStatus, 0, 1, "", bgcolor=color.new(color.black, 100), text_color=color.new(color.white, 100))
        table.cell(flowStatus, 1, 1, "", bgcolor=color.new(color.black, 100), text_color=color.new(color.white, 100))
        table.cell(flowStatus, 0, 2, "", bgcolor=color.new(color.black, 100), text_color=color.new(color.white, 100))
        table.cell(flowStatus, 1, 2, "", bgcolor=color.new(color.black, 100), text_color=color.new(color.white, 100))
        table.cell(flowStatus, 0, 3, "", bgcolor=color.new(color.black, 100), text_color=color.new(color.white, 100))
        table.cell(flowStatus, 1, 3, "", bgcolor=color.new(color.black, 100), text_color=color.new(color.white, 100))
        table.cell(flowStatus, 0, 4, "", bgcolor=color.new(color.black, 100), text_color=color.new(color.white, 100))
        table.cell(flowStatus, 1, 4, "", bgcolor=color.new(color.black, 100), text_color=color.new(color.white, 100))
        table.cell(flowStatus, 0, 5, "", bgcolor=color.new(color.black, 100), text_color=color.new(color.white, 100))
        table.cell(flowStatus, 1, 5, "", bgcolor=color.new(color.black, 100), text_color=color.new(color.white, 100))
        table.cell(flowStatus, 0, 6, "", bgcolor=color.new(color.black, 100), text_color=color.new(color.white, 100))
        table.cell(flowStatus, 1, 6, "", bgcolor=color.new(color.black, 100), text_color=color.new(color.white, 100))
        table.cell(flowStatus, 0, 7, "", bgcolor=color.new(color.black, 100), text_color=color.new(color.white, 100))
        table.cell(flowStatus, 1, 7, "", bgcolor=color.new(color.black, 100), text_color=color.new(color.white, 100))
