buildRiskPayload(string eventIdValue, string positionIdValue, string updateReason, string requestedSides, float previousStop, float previousTarget, float newStop, float newTarget) =>
    float effectiveStop = na(newStop) ? activeStop : newStop
    float effectiveTarget = na(newTarget) ? activeTarget : newTarget
    float riskPerShare = structureRiskPerShare(activeDirection, activeEntry, effectiveStop)
    float rewardPerShare = structureRewardPerShare(activeDirection, activeEntry, effectiveTarget)
    float structureRewardRiskValue = rewardRiskMultiple(rewardPerShare, riskPerShare)
    float targetCheckpoint = activeRunnerMode ? activeRunnerActivation : effectiveTarget
    int barsInTradePayload = na(activeEntryBar) ? 0 : bar_index - activeEntryBar
    basePayload("risk_update", eventIdValue, positionIdValue) +
     jsonStr("signal_id", activeSignalId) +
     jsonStr("origin_signal_id", activeSignalId) +
     jsonStr("trade_group_id", activeTradeGroupId) +
     jsonStr("bracket_group", activeTradeGroupId) +
