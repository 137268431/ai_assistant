float selectedProbeMiddleRatio = selectedTopProbe ? topMiddleRetraceRatio : selectedBottomProbe ? bottomMiddleRetraceRatio : na
float selectedProbeRightRatio = selectedTopProbe ? topRightRetestRatio : selectedBottomProbe ? bottomRightRetestRatio : na
string selectedVolumeReason = selectedTopProbe ? topVolumeReason : selectedBottomProbe ? bottomVolumeReason : "none"
float selectedVolumeRatio = selectedTopProbe or selectedBottomProbe ? volumeRatio : na
float selectedClosePosition = selectedTopProbe or selectedBottomProbe ? closePosition : na
float selectedMomentumDecayRatio = selectedTopProbe ? topMomentumDecayRatio : selectedBottomProbe ? bottomMomentumDecayRatio : na
float selectedPriorLevelDistanceAtr = selectedTopProbe ? topPriorLevelDistanceAtr : selectedBottomProbe ? bottomPriorLevelDistanceAtr : na
float selectedMomentumDecayStreak = selectedTopProbe ? topDecayStreak * 1.0 : selectedBottomProbe ? bottomDecayStreak * 1.0 : na
float selectedMomentumDecayConfirmBars = selectedTopProbe or selectedBottomProbe ? exhaustionDecayConfirmBars * 1.0 : na
bool selectedAttackVolumeCooling = selectedTopProbe ? attackUpCooling : selectedBottomProbe ? attackDownCooling : selectedDirection == -1 ? attackUpCooling : selectedDirection == 1 ? attackDownCooling : false
float selectedAttackVolumeCooldownBars = selectedDirection != 0 ? attackVolumeCooldownBars * 1.0 : na
bool selectedStructureBreakAccepted = selectedTopProbe ? upperStructureBreakAccepted : selectedBottomProbe ? lowerStructureBreakAccepted : false
float selectedStructureBreakAcceptBars = selectedTopProbe or selectedBottomProbe ? structureBreakAcceptBars * 1.0 : na
string selectedExhaustionSide = selectedTopProbe ? "upper" : selectedBottomProbe ? "lower" : "none"
bool selectedExhaustionConfirmed = selectedTopProbe ? upperExhaustionConfirmedShort : selectedBottomProbe ? lowerExhaustionConfirmedLong : false
string selectedExhaustionReason = selectedTopProbe ? topExhaustionReason : selectedBottomProbe ? bottomExhaustionReason : "none"
string selectedLevelRole = selectedTrendSupport ? "trend_pullback_support" : selectedTrendResistance ? "trend_pullback_resistance" : selectedTopProbe and upperExhaustionZone ? "prior_high_second_test_exhaustion" : selectedBottomProbe and lowerExhaustionZone ? "prior_low_second_test_exhaustion" : "structure_probe"
float selectedProbeAnchorPrice = selectedTopProbe ? todayStructHigh : selectedBottomProbe ? todayStructLow : na
string trendStructDir = strongStructTrendLong ? "bull_HH_HL" : strongStructTrendShort ? "bear_LL_LH" : dominantTrendLong ? "dominant_bull" : dominantTrendShort ? "dominant_bear" : "none"
string selectedTrendStructPattern = selectedTrendSupport ? "HH_HL" : selectedTrendResistance ? "LL_LH" : "none"
string selectedTrendSources = selectedTrendSupport ? trendSupportSources : selectedTrendResistance ? trendResistanceSources : "none"
string selectedMainReason = selectedTrendSupport ? "clear_bull_pullback_to_support" : selectedTrendResistance ? "clear_bear_rebound_to_resistance" : selectedTopProbe ? (topVolumeClimaxFailedBreakConfirmed ? "new_high_volume_climax_failed" : topHighVolumeDropConfirmed ? "naked_high_volume_reversal" : topImmediateReversalShort ? "naked_high_immediate_reversal" : topNoDemandBreakConfirmed ? "naked_high_decay_break" : topDistributionDropConfirmed ? "new_high_distribution_drop" : topWeakNewHighConfirmed ? "weak_new_high_confirmed" : upperExhaustionConfirmedShort ? "prior_high_second_test_momentum_decay" : "today_struct_high_probe_failed_breakout") : selectedBottomProbe ? (bottomHighVolumeRiseConfirmed ? "naked_low_volume_reversal" : bottomNoSupplyBreakConfirmed ? "naked_low_decay_break" : bottomAccumulationRiseConfirmed ? "new_low_accumulation_rise" : bottomWeakNewLowConfirmed ? "weak_new_low_confirmed" : lowerExhaustionConfirmedLong ? "prior_low_second_test_momentum_decay" : "today_struct_low_probe_failed_breakout") : "none"
string selectedSecondaryReason = selectedTrendSupport ? trendSupportSources : selectedTrendResistance ? trendResistanceSources : selectedTopProbe ? topSources : selectedBottomProbe ? bottomSources : "none"
float selectedAnyPlanGapBars = na(lastAnyPlanBar) ? na : (bar_index - lastAnyPlanBar) * 1.0
float selectedAnyPlanDistanceAtr = not na(lastAnyPlanPrice) and atr > 0.0 ? math.abs(selectedEntry - lastAnyPlanPrice) / atr : na

// -----------------------------------------------------------------------------
// Order state shared by payload builders and lifecycle.
// -----------------------------------------------------------------------------
var bool pendingEntry = false
var bool activePosition = false
var int activeDirection = 0
var string activeSetup = ""
var string activeSignalId = ""
var string activeTradeGroupId = ""
var string activePositionId = ""
var string activeEntryIntent = ""
var string activeTrialRiskMode = ""
var float activeEntry = na
var float activeSubmittedEntryLimit = na
var float activeStop = na
var float activeTarget = na
var float activeRunnerActivation = na
var float activeActivationR = na
var float activeQty = na
var float activeInitialRisk = na
var float activeStructureAnchor = na
var int activeSignalBar = na
var int activeEntryBar = na
var int activeExpiresBar = na
var bool activeRunnerActive = false
var bool activeBreakevenDone = false
var float activeRunnerExtreme = na
var float activeMfeR = 0.0
var int activeRiskUpdateSeq = 0
var string activeManualExitReason = ""

fmtSignedMoneyCore(float value) =>
    na(value) ? "$--" : (value >= 0.0 ? "+$" : "-$") + str.tostring(math.abs(value), "#.##")

fmtSignedRCore(float value) =>
    na(value) ? "--R" : (value >= 0.0 ? "+" : "-") + str.tostring(math.abs(value), "#.##") + "R"

exitReasonDisplayNameCore(string reason) =>
    reason == "take_profit" ? "TP" : reason == "runner_stop" ? "RUN" : reason == "exhaustion_take_profit" ? "XTP" : reason == "stop_loss" ? "SL" : reason == "force_flat_eod" ? "EOD" : reason == "strategy_closed" ? "CLS" : reason

entryOrderComment(int direction, float entryPrice, float qty, float stopPrice, float targetPrice, float runnerPrice) =>
    (direction == 1 ? "L " : "S ") + fmtPrice(entryPrice) + " Q" + str.tostring(qty, "#")

exitOrderComment(string reason, float exitPrice) =>
    float pnlPerShare = activeDirection == 1 ? exitPrice - activeEntry : activeEntry - exitPrice
    float pnlValue = pnlPerShare * activeQty
    float pnlR = activeInitialRisk > 0.0 ? pnlPerShare / activeInitialRisk : na
    exitReasonDisplayNameCore(reason) + " " + fmtSignedMoneyCore(pnlValue) + " X" + fmtPrice(exitPrice)

// -----------------------------------------------------------------------------
// Payload builders
// -----------------------------------------------------------------------------
basePayload(string eventType, string eventIdValue, string positionIdValue) =>
    "{" +
     jsonStr("source", "tradingview") + "," +
     jsonStr("event_type", eventType) + "," +
     jsonStr("event_id", eventIdValue) + "," +
     jsonStr("symbol", syminfo.ticker) + "," +
     jsonStr("exchange", syminfo.prefix) + "," +
     jsonStr("interval", timeframe.period) + "," +
     jsonStr("script_tag", SCRIPT_TAG) + "," +
     jsonStr("strategy_version", STRATEGY_VERSION) + "," +
     jsonStr("position_id", positionIdValue) + "," +
     jsonNum("bar_open_ms", time) + "," +
     jsonNum("bar_close_ms", time_close) + "," +
     jsonNum("pine_eval_ms", timenow) + "," +
     jsonNum("bar_time_ms", time) + "," +
     jsonInt("bar_index", bar_index)

planId(string direction, string setup, string intent) =>
    symbolKey() + "_" + direction + "_" + str.tostring(time) + "_" + timeframe.period + "_" + setup + "_" + intent

buildEntryPayload(string eventIdValue, string signalIdValue, string tradeGroupIdValue, string positionIdValue, int direction, string setup, string reason, float qty, float entryPrice, float stopPrice, float targetPrice, float runnerActivationPrice, float activationR, string entryIntent, string trialRiskMode, bool planReplaced, string replaceOriginSignalId, string replaceReason) =>
    string directionText = dirText(direction)
    basePayload("entry", eventIdValue, positionIdValue) + "," +
     jsonStr("signal_id", signalIdValue) + "," +
     jsonStr("origin_signal_id", signalIdValue) + "," +
     jsonStr("trade_group_id", tradeGroupIdValue) + "," +
     jsonStr("direction", directionText) + "," +
     jsonStr("position_side", directionText) + "," +
     jsonStr("setup", setup) + "," +
     jsonStr("entry_setup", setup) + "," +
     jsonStr("signal", setup) + "," +
     jsonStr("reason", reason) + "," +
     jsonNum("entry", entryPrice) + "," +
     jsonNum("entry_price", entryPrice) + "," +
     jsonNum("planned_entry_price", entryPrice) + "," +
     jsonNum("submitted_entry_limit_price", entryPrice) + "," +
     jsonNum("stop_loss", stopPrice) + "," +
     jsonNum("take_profit", targetPrice) + "," +
     jsonNum("safety_take_profit", targetPrice) + "," +
     jsonNum("target_checkpoint", runnerActivationPrice) + "," +
     jsonNum("runner_activation_price", runnerActivationPrice) + "," +
     jsonNum("runner_activation_r", activationR) + "," +
     jsonBool("runner_enabled", true) + "," +
     jsonBool("runner_active", false) + "," +
     jsonStr("target_role", "structure_safety_tp") + "," +
     jsonNum("shares", qty) + "," +
     jsonStr("entry_intent", entryIntent) + "," +
     jsonStr("trial_risk_mode", trialRiskMode) + "," +
     jsonStr("risk_model", RISK_MODEL) + "," +
     jsonStr("tp_sl_model", TP_SL_MODEL) + "," +
     jsonStr("trade_model", TRADE_MODEL) + "," +
     jsonBool("structure_clear", selectedStructureClear) + "," +
     jsonNum("structure_anchor_price", selectedStructureAnchor) + "," +
     jsonNum("expected_r", selectedExpectedR) + "," +
     jsonStr("trend_struct_dir", trendStructDir) + "," +
     jsonStr("trend_struct_pattern", selectedTrendStructPattern) + "," +
     jsonNum("trend_anchor_price", selectedTrendSupport or selectedTrendResistance ? selectedStructureAnchor : na) + "," +
     jsonStr("trend_support_sources", selectedTrendSources) + "," +
     jsonStr("trend_regime", trendRegime) + "," +
     jsonStr("dominant_trend_side", dominantTrendSide) + "," +
     jsonBool("day_range_formed", dayRangeFormed) + "," +
     jsonNum("day_range_atr", dayRangeAtr) + "," +
     jsonStr("level_role", selectedLevelRole) + "," +
     jsonStr("exhaustion_side", selectedExhaustionSide) + "," +
     jsonBool("exhaustion_confirmed", selectedExhaustionConfirmed) + "," +
     jsonStr("exhaustion_reason", selectedExhaustionReason) + "," +
     jsonNum("momentum_decay_ratio", selectedMomentumDecayRatio) + "," +
     jsonNum("momentum_decay_streak", selectedMomentumDecayStreak) + "," +
     jsonNum("momentum_decay_confirm_bars", selectedMomentumDecayConfirmBars) + "," +
     jsonBool("attack_volume_cooling", selectedAttackVolumeCooling) + "," +
     jsonNum("attack_volume_cooldown_bars", selectedAttackVolumeCooldownBars) + "," +
     jsonBool("structure_break_accepted", selectedStructureBreakAccepted) + "," +
     jsonNum("structure_break_accept_bars", selectedStructureBreakAcceptBars) + "," +
     jsonNum("prior_level_distance_atr", selectedPriorLevelDistanceAtr) + "," +
     jsonNum("middle_retrace_ratio", selectedProbeMiddleRatio) + "," +
     jsonNum("right_retest_ratio", selectedProbeRightRatio) + "," +
     jsonNum("any_plan_gap_bars", selectedAnyPlanGapBars) + "," +
     jsonNum("any_plan_distance_atr", selectedAnyPlanDistanceAtr) + "," +
     jsonStr("probe_pattern", selectedProbePattern) + "," +
     jsonStr("probe_filter_reason", selectedProbeFilterReason) + "," +
     jsonNum("probe_anchor_price", selectedProbeAnchorPrice) + "," +
     jsonNum("probe_anchor_age_bars", selectedProbeAnchorAgeBars) + "," +
     jsonNum("probe_pullback_atr", selectedProbePullbackAtr) + "," +
     jsonNum("probe_retest_gap_bars", selectedProbeRetestGapBars) + "," +
     jsonNum("visual_left_leg_bps", selectedProbeLeftLegBps) + "," +
     jsonNum("visual_middle_retrace_ratio", selectedProbeMiddleRatio) + "," +
     jsonNum("visual_right_retest_ratio", selectedProbeRightRatio) + "," +
     jsonNum("volume_ratio", selectedVolumeRatio) + "," +
     jsonStr("volume_reason", selectedVolumeReason) + "," +
     jsonNum("close_position", selectedClosePosition) + "," +
     jsonBool("volume_attack_up", volumeAttackUp) + "," +
     jsonBool("volume_attack_down", volumeAttackDown) + "," +
     jsonNum("today_struct_high", todayStructHigh) + "," +
     jsonNum("today_struct_low", todayStructLow) + "," +
     jsonBool("small_stop_gate_passed", selectedSmallStopGatePassed) + "," +
     jsonStr("small_stop_gate_reason", selectedSmallStopGateReason) + "," +
     jsonNum("stop_distance_atr", selectedStopDistanceAtr) + "," +
     jsonNum("stop_distance_bps", selectedStopDistanceBps) + "," +
     jsonNum("max_trial_risk_dollars", selectedRiskBudget) + "," +
     jsonNum("prediction_level", selectedPredictionLevel) + "," +
     jsonNum("prediction_zone_low", selectedZoneLow) + "," +
     jsonNum("prediction_zone_high", selectedZoneHigh) + "," +
     jsonNum("invalidation_price", selectedInvalidation) + "," +
     jsonStr("invalidation_source", setup == "trend_support_long" ? "support_cluster_low" : setup == "trend_resistance_short" ? "resistance_cluster_high" : setup == "probe_2b_top_short" ? "top_sweep_or_prediction_high" : "bottom_sweep_or_prediction_low") + "," +
     jsonStr("main_reason", selectedMainReason) + "," +
     jsonStr("secondary_reason", selectedSecondaryReason == "" ? "none" : selectedSecondaryReason) + "," +
     jsonBool("plan_replaced", planReplaced) + "," +
     jsonStr("replace_origin_signal_id", planReplaced ? replaceOriginSignalId : "none") + "," +
     jsonStr("plan_replace_reason", planReplaced ? replaceReason : "none") + "," +
     jsonInt("entry_order_ttl_bars", entryOrderTtlBars) + "," +
     jsonInt("entry_order_expires_bar_index", bar_index + entryOrderTtlBars) + "," +
     jsonStr("entry_window_model", ENTRY_WINDOW_MODEL) + "," +
     jsonStr("entry_window_stage", useIntradayEntryWindow ? "active" : "disabled") + "," +
     jsonStr("entry_cutoff_time", "15:30") + "}"

buildEntryFillPayload(string eventIdValue, string positionIdValue, float actualFillPrice) =>
    basePayload("entry_fill", eventIdValue, positionIdValue) + "," +
     jsonStr("signal_id", activeSignalId) + "," +
     jsonStr("origin_signal_id", activeSignalId) + "," +
     jsonStr("trade_group_id", activeTradeGroupId) + "," +
     jsonStr("direction", dirText(activeDirection)) + "," +
     jsonStr("setup", activeSetup) + "," +
     jsonNum("entry", actualFillPrice) + "," +
     jsonNum("planned_entry_price", activeEntry) + "," +
     jsonNum("submitted_entry_limit_price", activeSubmittedEntryLimit) + "," +
     jsonNum("stop_loss", activeStop) + "," +
     jsonNum("take_profit", activeTarget) + "," +
     jsonNum("shares", activeQty) + "," +
     jsonStr("entry_intent", activeEntryIntent) + "," +
     jsonStr("trial_risk_mode", activeTrialRiskMode) + "}"

buildCancelPayload(string eventIdValue, string positionIdValue, string reason) =>
    basePayload("cancel", eventIdValue, positionIdValue) + "," +
     jsonStr("signal_id", activeSignalId) + "," +
     jsonStr("origin_signal_id", activeSignalId) + "," +
     jsonStr("trade_group_id", activeTradeGroupId) + "," +
     jsonStr("direction", dirText(activeDirection)) + "," +
     jsonStr("setup", activeSetup) + "," +
     jsonStr("reason", reason) + "," +
     jsonStr("cancel_reason", reason) + "," +
     jsonStr("cancel_scope", "unfilled_entry") + "," +
     jsonNum("entry", activeEntry) + "," +
     jsonNum("stop_loss", activeStop) + "," +
     jsonNum("take_profit", activeTarget) + "," +
     jsonStr("entry_intent", activeEntryIntent) + "," +
     jsonStr("trial_risk_mode", activeTrialRiskMode) + "}"

buildRiskUpdatePayload(string eventIdValue, string positionIdValue, string reason, float previousStop, float newStop, float previousTarget, float newTarget, string requestedSides) =>
    basePayload("risk_update", eventIdValue, positionIdValue) + "," +
     jsonStr("signal_id", activeSignalId) + "," +
     jsonStr("origin_signal_id", activeSignalId) + "," +
     jsonStr("trade_group_id", activeTradeGroupId) + "," +
     jsonStr("direction", dirText(activeDirection)) + "," +
     jsonStr("setup", activeSetup) + "," +
     jsonStr("reason", reason) + "," +
     jsonStr("risk_update_reason", reason) + "," +
     jsonInt("risk_update_seq", activeRiskUpdateSeq) + "," +
     jsonRequestedSides(requestedSides) + "," +
     jsonNum("previous_stop_loss", previousStop) + "," +
     jsonNum("new_stop_loss", newStop) + "," +
     jsonNum("previous_take_profit", previousTarget) + "," +
     jsonNum("new_take_profit", newTarget) + "," +
     jsonNum("stop_loss", newStop) + "," +
     jsonNum("take_profit", newTarget) + "," +
     jsonNum("safety_take_profit", newTarget) + "," +
     jsonStr("profit_protect_reason", reason) + "," +
     jsonNum("runner_activation_price", activeRunnerActivation) + "," +
     jsonNum("runner_activation_r", activeActivationR) + "," +
     jsonBool("runner_enabled", true) + "," +
     jsonBool("runner_active", activeRunnerActive) + "}"

buildExitPayload(string eventIdValue, string positionIdValue, string reason, float exitPrice, float pnlPerShare) =>
    basePayload("exit", eventIdValue, positionIdValue) + "," +
     jsonStr("signal_id", activeSignalId) + "," +
     jsonStr("origin_signal_id", activeSignalId) + "," +
     jsonStr("trade_group_id", activeTradeGroupId) + "," +
     jsonStr("direction", dirText(activeDirection)) + "," +
     jsonStr("setup", activeSetup) + "," +
     jsonStr("reason", reason) + "," +
     jsonStr("exit_reason", reason) + "," +
     jsonNum("exit_price", exitPrice) + "," +
     jsonNum("entry", activeEntry) + "," +
     jsonNum("stop_loss", activeStop) + "," +
     jsonNum("take_profit", activeTarget) + "," +
     jsonNum("shares", activeQty) + "," +
     jsonNum("pnl", pnlPerShare * activeQty) + "," +
     jsonNum("pnl_per_share", pnlPerShare) + "," +
     jsonNum("pnl_r", activeInitialRisk > 0.0 ? pnlPerShare / activeInitialRisk : na) + "," +
     jsonStr("profit_protect_reason", reason) + "," +
     jsonBool("runner_active", activeRunnerActive) + "}"

// -----------------------------------------------------------------------------
// Order state and lifecycle
// -----------------------------------------------------------------------------

bool inTradingSession = not na(time(timeframe.period, tradingSession))
bool inEntryWindow = not useIntradayEntryWindow or not na(time(timeframe.period, entrySession))
int etCloseMinutes = hour(time_close, "America/New_York") * 60 + minute(time_close, "America/New_York")
bool eodTimeReached = enableEodForceClose and etCloseMinutes >= eodCloseHour * 60 + eodCloseMinute
bool flatByStrategy = strategy.position_size == 0
bool hasOpenStrategyPosition = strategy.position_size != 0

// Fill detection before pending cancellation.
bool positionJustFilled = pendingEntry and hasOpenStrategyPosition
if positionJustFilled
    pendingEntry := false
    activePosition := true
    activeEntryBar := bar_index
    activeRunnerExtreme := activeDirection == 1 ? high : low
    activeMfeR := 0.0
    activeRiskUpdateSeq := 0
    activeManualExitReason := ""
    if activeSetup == "probe_2b_top_short"
        lastTopProbeSignalBar := bar_index
        lastTopProbeSignalPrice := activeEntry
    if activeSetup == "probe_2b_bottom_long"
        lastBottomProbeSignalBar := bar_index
        lastBottomProbeSignalPrice := activeEntry
    if activeDirection == 1
        lastLongPlanPrice := activeEntry
    if activeDirection == -1
        lastShortPlanPrice := activeEntry
    lastAnyPlanBar := bar_index
    lastAnyPlanPrice := activeEntry
    if enableAlerts and enableFillConfirmAlerts
        alert(buildEntryFillPayload(planId("entry_fill", activeSetup, activeEntryIntent), activePositionId, strategy.position_avg_price), alert.freq_all)

bool pendingExpired = pendingEntry and not na(activeExpiresBar) and bar_index > activeExpiresBar
bool pendingWindowExpired = pendingEntry and not inEntryWindow
bool pendingEodCancel = pendingEntry and eodTimeReached
bool pendingInvalidated = pendingEntry and (activeDirection == 1 ? close < activeStop : close > activeStop)
bool pendingOppositeSelected = pendingEntry and selectedDirection != 0 and selectedDirection != activeDirection
bool pendingLostConfirmation = pendingEntry and activeEntryIntent != "confirmed_limit"
bool pendingAttackCoolingCancel = false
bool pendingStructureAcceptedCancel = pendingEntry and (activeDirection == -1 ? upperStructureBreakAccepted : activeDirection == 1 ? lowerStructureBreakAccepted : false)
string pendingCancelReason = pendingLostConfirmation ? "pending_lost_confirmation" : pendingStructureAcceptedCancel ? "structure_break_accepted_cancel" : pendingAttackCoolingCancel ? "attack_volume_cooling_cancel" : pendingEodCancel ? "pending_eod_cancel" : pendingWindowExpired ? "entry_window_expired" : pendingInvalidated ? "invalidation_price_breached" : pendingOppositeSelected ? "opposite_confirmed_structure" : pendingExpired ? "entry_ttl_expired" : ""
bool pendingCancelNow = confirmed and pendingEntry and pendingCancelReason != ""

if pendingCancelNow
    strategy.cancel(orderIdForDirection(activeDirection))
    if enableAlerts
        alert(buildCancelPayload(planId("cancel", activeSetup, activeEntryIntent), activePositionId, pendingCancelReason), alert.freq_all)
    pendingEntry := false
    activeDirection := 0
    activeSetup := ""
    activeSignalId := ""
    activeTradeGroupId := ""
    activePositionId := ""
    activeEntryIntent := ""
    activeTrialRiskMode := ""
    activeEntry := na
    activeSubmittedEntryLimit := na
    activeStop := na
    activeTarget := na
    activeRunnerActivation := na
    activeActivationR := na
    activeQty := na
    activeInitialRisk := na
    activeStructureAnchor := na
    activeSignalBar := na
    activeExpiresBar := na
    activeManualExitReason := ""

bool selectedPendingUpgrade = false
float selectedLastSameSidePlanPrice = selectedDirection == 1 ? lastLongPlanPrice : selectedDirection == -1 ? lastShortPlanPrice : na
float selectedSameSideSignalDistanceAtr = not na(selectedLastSameSidePlanPrice) and atr > 0.0 ? math.abs(selectedEntry - selectedLastSameSidePlanPrice) / atr : na
bool selectedFailureReentry = selectedTopProbe and topFailureRepeatShort
bool selectedSameSideSignalFarEnough = selectedDirection == 0 or selectedPendingUpgrade or selectedFailureReentry or na(selectedSameSideSignalDistanceAtr) or selectedSameSideSignalDistanceAtr >= minSameSideSignalSeparationAtr
bool selectedAnyPlanFarEnough = selectedDirection == 0 or selectedPendingUpgrade or selectedFailureReentry or na(selectedAnyPlanGapBars) or (selectedAnyPlanGapBars >= minAnyPlanGapBars and selectedAnyPlanDistanceAtr >= minAnyPlanDistanceAtr)
bool selectedPlanValid = selectedDirection != 0 and selectedStructureClear and selectedSmallStopGatePassed and selectedExpectedRPassed and selectedSameSideSignalFarEnough and selectedAnyPlanFarEnough and selectedQty >= 1.0 and not eodTimeReached and inTradingSession and inEntryWindow
string selectedBlockReason = selectedDirection == 0 ? "no_candidate" : not selectedStructureClear ? "no_clear_structure" : not selectedSameSideSignalFarEnough ? "micro_structure_too_close" : not selectedAnyPlanFarEnough ? "any_plan_too_close" : not selectedSmallStopGatePassed ? selectedSmallStopGateReason : not selectedExpectedRPassed ? "expected_r_too_small" : "passed"
bool meaningfulPlanMove = math.abs(nz(activeEntry, selectedEntry) - selectedEntry) >= atr * planReplaceMinMoveAtr or math.abs(nz(activeStop, selectedStop) - selectedStop) >= atr * planReplaceMinMoveAtr or math.abs(nz(activeStructureAnchor, selectedStructureAnchor) - selectedStructureAnchor) >= atr * planReplaceMinMoveAtr
bool pendingSameDirectionReplace = pendingEntry and selectedPlanValid and selectedDirection == activeDirection and (activeSetup != selectedSetup or meaningfulPlanMove)
bool submitFreshPlan = confirmed and selectedPlanValid and flatByStrategy and not pendingEntry
bool submitReplacementPlan = confirmed and selectedPlanValid and flatByStrategy and pendingSameDirectionReplace
bool submitNewPlan = submitFreshPlan or submitReplacementPlan

if submitReplacementPlan
    strategy.cancel(orderIdForDirection(activeDirection))
    if enableAlerts
        alert(buildCancelPayload(planId("cancel", activeSetup, activeEntryIntent), activePositionId, "same_direction_plan_replaced"), alert.freq_all)

if submitNewPlan
    string directionText = dirText(selectedDirection)
    string eventPlanId = planId(directionText, selectedSetup, selectedEntryIntent)
    string signalId = eventPlanId
    string tradeGroupId = eventPlanId
    string positionId = eventPlanId + "_pos"
    string replaceOriginSignalId = submitReplacementPlan ? activeSignalId : ""
    pendingEntry := true
    activePosition := false
    activeDirection := selectedDirection
    activeSetup := selectedSetup
    activeSignalId := signalId
    activeTradeGroupId := tradeGroupId
    activePositionId := positionId
    activeEntryIntent := selectedEntryIntent
    activeTrialRiskMode := selectedTrialRiskMode
    activeEntry := selectedEntry
    activeSubmittedEntryLimit := selectedEntry
    activeStop := selectedStop
    activeTarget := selectedTarget
    activeRunnerActivation := selectedRunnerActivation
    activeActivationR := selectedActivationR
    activeQty := selectedQty
    activeInitialRisk := riskPerShare(selectedEntry, selectedStop)
    activeStructureAnchor := selectedStructureAnchor
    activeSignalBar := bar_index
    activeExpiresBar := bar_index + entryOrderTtlBars
    activeEntryBar := na
    activeRunnerActive := false
    activeBreakevenDone := false
    activeRunnerExtreme := na
    activeMfeR := 0.0
    activeRiskUpdateSeq := 0
    activeManualExitReason := ""
    if selectedDirection == 1
        strategy.entry("TV-L", strategy.long, qty=selectedQty, limit=selectedEntry, comment=entryOrderComment(selectedDirection, selectedEntry, selectedQty, selectedStop, selectedTarget, selectedRunnerActivation))
        strategy.exit("TV-L-RISK", from_entry="TV-L", stop=activeStop, limit=activeTarget, comment_profit=exitOrderComment("take_profit", activeTarget), comment_loss=exitOrderComment("stop_loss", activeStop))
    if selectedDirection == -1
        strategy.entry("TV-S", strategy.short, qty=selectedQty, limit=selectedEntry, comment=entryOrderComment(selectedDirection, selectedEntry, selectedQty, selectedStop, selectedTarget, selectedRunnerActivation))
        strategy.exit("TV-S-RISK", from_entry="TV-S", stop=activeStop, limit=activeTarget, comment_profit=exitOrderComment("take_profit", activeTarget), comment_loss=exitOrderComment("stop_loss", activeStop))
    if enableAlerts
        string reason = "confirmed_small_stop_trial"
        alert(buildEntryPayload(eventPlanId, signalId, tradeGroupId, positionId, selectedDirection, selectedSetup, reason, selectedQty, selectedEntry, selectedStop, selectedTarget, selectedRunnerActivation, selectedActivationR, selectedEntryIntent, selectedTrialRiskMode, submitReplacementPlan, replaceOriginSignalId, submitReplacementPlan ? "same_direction_plan_replaced" : "none"), alert.freq_all)
    if selectedTopProbe
        topExhaustionUsed := selectedProbePattern == "extension_exhaustion_top" ? true : topExhaustionUsed
    if selectedBottomProbe
        bottomExhaustionUsed := selectedProbePattern == "extension_exhaustion_bottom" ? true : bottomExhaustionUsed

// Active position risk management.
if confirmed and activePosition and hasOpenStrategyPosition
    float previousStop = activeStop
    float previousTarget = activeTarget
    bool stopChanged = false
    bool targetChanged = false
    string riskReason = ""
    int barsInTrade = na(activeEntryBar) ? 0 : bar_index - activeEntryBar
    activeRunnerExtreme := activeDirection == 1 ? math.max(nz(activeRunnerExtreme, high), high) : math.min(nz(activeRunnerExtreme, low), low)
    float mfeRNow = activeInitialRisk > 0.0 ? (activeDirection == 1 ? (high - activeEntry) / activeInitialRisk : (activeEntry - low) / activeInitialRisk) : 0.0
    activeMfeR := math.max(nz(activeMfeR, 0.0), mfeRNow)
    bool reachedRunner = activeDirection == 1 ? high >= activeRunnerActivation : low <= activeRunnerActivation
    if not activeBreakevenDone and reachedRunner
        float breakevenStop = activeEntry + activeInitialRisk * breakevenOffsetR * activeDirection
        activeStop := activeDirection == 1 ? math.max(activeStop, breakevenStop) : math.min(activeStop, breakevenStop)
        activeBreakevenDone := true
        activeRunnerActive := true
        riskReason := "runner_activation"
    if activeRunnerActive
        float trailStop = activeDirection == 1 ? activeRunnerExtreme - atr * runnerTrailAtrMult : activeRunnerExtreme + atr * runnerTrailAtrMult
        float improvedStop = activeDirection == 1 ? math.max(activeStop, trailStop) : math.min(activeStop, trailStop)
        if priceChanged(activeStop, improvedStop)
            activeStop := improvedStop
            riskReason := riskReason == "" ? "runner_trail_stop" : riskReason
    if not activeRunnerActive and barsInTrade >= noFollowThroughBars and activeMfeR < noFollowThroughMinMfeR
        float compressedStop = activeEntry - activeInitialRisk * noFollowThroughCompressedStopR * activeDirection
        float improvedStop = activeDirection == 1 ? math.max(activeStop, compressedStop) : math.min(activeStop, compressedStop)
        if priceChanged(activeStop, improvedStop)
            activeStop := improvedStop
            riskReason := "no_follow_through_compress_stop"
    bool exhaustionProtectNow = activeMfeR >= exhaustionProtectMinMfeR and (activeDirection == 1 ? upperExhaustionZone : lowerExhaustionZone)
    bool exhaustionExitNow = activeMfeR >= exhaustionProtectMinMfeR and (activeDirection == 1 ? upperExhaustionConfirmedShort : lowerExhaustionConfirmedLong)
    if exhaustionExitNow
        activeManualExitReason := "exhaustion_take_profit"
        strategy.close(orderIdForDirection(activeDirection), comment=exitOrderComment("exhaustion_take_profit", close))
    else if exhaustionProtectNow
        float protectStop = activeDirection == 1 ? close - atr * exhaustionProtectTrailAtr : close + atr * exhaustionProtectTrailAtr
        float improvedStop = activeDirection == 1 ? math.max(activeStop, protectStop) : math.min(activeStop, protectStop)
        if priceChanged(activeStop, improvedStop)
            activeStop := improvedStop
            riskReason := activeDirection == 1 ? "upper_exhaustion_profit_protect" : "lower_exhaustion_profit_protect"
        float protectTarget = activeDirection == 1 ? math.max(close, nz(topZoneHigh, close)) : math.min(close, nz(bottomZoneLow, close))
        bool targetTightened = activeDirection == 1 ? protectTarget > activeEntry and protectTarget < activeTarget : protectTarget < activeEntry and protectTarget > activeTarget
        if targetTightened
            activeTarget := protectTarget
            riskReason := riskReason == "" ? (activeDirection == 1 ? "upper_exhaustion_profit_protect" : "lower_exhaustion_profit_protect") : riskReason
    stopChanged := priceChanged(previousStop, activeStop)
    targetChanged := priceChanged(previousTarget, activeTarget)
    if stopChanged or targetChanged
        activeRiskUpdateSeq += 1
        string requestedSides = stopChanged and targetChanged ? "stop_loss,take_profit" : stopChanged ? "stop_loss" : "take_profit"
        if enableAlerts
            alert(buildRiskUpdatePayload(planId("risk_update", activeSetup, activeEntryIntent), activePositionId, riskReason, previousStop, activeStop, previousTarget, activeTarget, requestedSides), alert.freq_all)
    if activeDirection == 1 and activeManualExitReason != "exhaustion_take_profit"
        strategy.exit("TV-L-RISK", from_entry="TV-L", stop=activeStop, limit=activeTarget, comment_profit=exitOrderComment("take_profit", activeTarget), comment_loss=exitOrderComment(activeRunnerActive and activeStop > activeEntry ? "runner_stop" : "stop_loss", activeStop))
    if activeDirection == -1 and activeManualExitReason != "exhaustion_take_profit"
        strategy.exit("TV-S-RISK", from_entry="TV-S", stop=activeStop, limit=activeTarget, comment_profit=exitOrderComment("take_profit", activeTarget), comment_loss=exitOrderComment(activeRunnerActive and activeStop < activeEntry ? "runner_stop" : "stop_loss", activeStop))

if confirmed and activePosition and eodTimeReached and hasOpenStrategyPosition
    strategy.close(orderIdForDirection(activeDirection), comment=exitOrderComment("force_flat_eod", close))

bool positionClosedNow = activePosition and flatByStrategy and not pendingEntry and not na(activeEntryBar) and bar_index > activeEntryBar
if confirmed and positionClosedNow
    bool stopTouched = activeDirection == 1 ? low <= activeStop : high >= activeStop
    bool targetTouched = activeDirection == 1 ? high >= activeTarget : low <= activeTarget
    string exitReason = activeManualExitReason != "" ? activeManualExitReason : eodTimeReached ? "force_flat_eod" : stopTouched and activeRunnerActive ? "runner_stop" : stopTouched ? "stop_loss" : targetTouched ? "take_profit" : "strategy_closed"
    float exitPrice = stopTouched ? activeStop : targetTouched ? activeTarget : close
    float pnlPerShare = (exitPrice - activeEntry) * activeDirection
    if enableAlerts
        alert(buildExitPayload(planId("exit", activeSetup, activeEntryIntent), activePositionId, exitReason, exitPrice, pnlPerShare), alert.freq_all)
    activePosition := false
    activeDirection := 0
    activeSetup := ""
    activeSignalId := ""
    activeTradeGroupId := ""
    activePositionId := ""
    activeEntryIntent := ""
    activeTrialRiskMode := ""
    activeEntry := na
    activeSubmittedEntryLimit := na
    activeStop := na
    activeTarget := na
    activeRunnerActivation := na
    activeActivationR := na
    activeQty := na
    activeInitialRisk := na
    activeStructureAnchor := na
    activeSignalBar := na
    activeEntryBar := na
    activeExpiresBar := na
    activeRunnerActive := false
    activeBreakevenDone := false
    activeRunnerExtreme := na
    activeMfeR := 0.0
    activeRiskUpdateSeq := 0
    activeManualExitReason := ""
