     jsonStr("trend_trigger_source", candidateDirection == "short" ? lowerBearTrendTriggerLine : upperBullTrendTriggerLine) +
     jsonStr("key_level_state", candidateSetup == "trend_sdUpper" and trendLongSupportLingerWait ? "support_linger_wait" : candidateSetup == "trend_sdLower" and trendShortResistanceLingerWait ? "resistance_linger_wait" : "none") +
     jsonStr("direction_decision", candidateSetup == "trend_sdUpper" and bullTrendContinuationContext ? "dtp_bull_sd_upper_trend_long" : candidateSetup == "trend_sdLower" and bearTrendContinuationContext ? "dtp_bear_sd_lower_trend_short" : "none") +
