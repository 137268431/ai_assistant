     jsonBool("runner_active", activeRunnerActive) +
     jsonBool("tp_checkpoint_runner", activeRunnerMode) +
     jsonBool("target_checkpoint_hit", activeRunnerActive) +
     jsonBool("target_checkpoint_is_exit", not activeRunnerMode) +
     jsonStr("target_role", setupIsMr(activeSetup) ? "mr_mean_tp" : activeRunnerMode ? "structure_safety_tp" : "structure_hard_tp") +
     jsonStr("mr_target_mode", setupIsMr(activeSetup) ? "mean_reversion_mixed" : "none") +
     jsonStr("tp_sl_model", TP_SL_MODEL) +
     jsonStr("rr_basis", "structure_stop_to_structure_target") +
     jsonStr("atr_role", "buffer_and_filter_only") +
     jsonNum("atr_buffer_mult", structuralSlBufferAtr) +
     jsonNum("atr_buffer_amount", atrRaw * structuralSlBufferAtr) +
     jsonNum("structure_stop_loss", effectiveStop) +
     jsonNum("structure_take_profit", effectiveTarget) +
     jsonNum("structure_reward_per_share", rewardPerShare) +
     jsonNum("structure_risk_per_share", riskPerShare) +
     jsonNum("structure_reward_risk", structureRewardRiskValue) +
     jsonNum("gross_reward_risk", structureRewardRiskValue) +
     jsonNum("risk_per_share", riskPerShare) +
