//@version=6
indicator(title="Signal Strategy Display[Glory]", overlay=true, max_labels_count=500, max_lines_count=500)

// TV-primary strategy v1.
// Derived from Signal Alert Core[Glory]: EMA trend/touch, SD mean-reversion windows,
// DTP direction, fractal pivots, cRSI/OBV divergence, ATR risk sizing.

string TP_SL_MODEL = "structure_first_atr_buffer_v1"
string ENTRY_WINDOW_MODEL = "continuous_layered_v1"
int ENTRY_PRIMARY_START_MIN = 9 * 60 + 45
int ENTRY_PRIMARY_END_MIN = 11 * 60 + 30
int ENTRY_CLOSING_START_MIN = 14 * 60
int ENTRY_CUTOFF_MIN = 15 * 60 + 15

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
emaSlopeLookback = input.int(12, "Slope lookback", minval=1, group="01 EMA Trend Matrix")
emaMinAngle = input.float(0.01, "Minimum slope (%)", step=0.01, group="01 EMA Trend Matrix")
emaMinSpacing = input.float(0.01, "Minimum EMA spacing (%)", step=0.01, group="01 EMA Trend Matrix")
emaTouchType = input.string("slow", "EMA touch type", options=["fast", "slow", "both"], group="01 EMA Trend Matrix")

fractalPeriod = input.int(4, "Fractal pivot period", minval=2, maxval=20, group="02 Fractal Pivot")
donchianPeriod = input.int(20, "Donchian period", minval=1, group="02 Fractal Pivot")

sdLength = input.int(128, "Regression length", minval=20, group="03 SD Channel")
sdMult1 = input.float(1.0, "Band multiplier 1", step=0.5, group="03 SD Channel")
sdMult2 = input.float(2.0, "Band multiplier 2", step=0.5, group="03 SD Channel")
sdMult3 = input.float(3.0, "Band multiplier 3", step=0.5, group="03 SD Channel")
sdMult4 = input.float(4.0, "Band multiplier 4", step=0.5, group="03 SD Channel")
sdSignalBand = input.int(3, "MR trigger band", minval=1, maxval=4, group="03 SD Channel")
sdFilterBand = input.int(2, "Zone filter band", minval=1, maxval=4, group="03 SD Channel")
mrWindowBars = input.int(30, "MR window bars", minval=2, maxval=200, group="03 SD Channel")
mrWindowMaxMinutes = input.int(60, "MR window max minutes", minval=1, maxval=240, group="03 SD Channel")
mrComponentFreshBars = input.int(30, "MR component freshness bars", minval=1, maxval=100, group="03 SD Channel")
mrExpireOnMeanTouch = input.bool(true, "Expire MR window after mean touch", group="03 SD Channel")
postSdReversalBars = input.int(30, "Post-SD reversal bars", minval=1, maxval=200, group="03 SD Channel")
postSdReversalMaxMinutes = input.int(60, "Post-SD reversal max minutes", minval=1, maxval=240, group="03 SD Channel")

dtpSmaLength = input.int(100, "DTP SMA length", minval=5, group="04 DTP")
dtpAtrLength = input.int(200, "DTP ATR length", minval=5, group="04 DTP")
dtpMomentumLookback = input.int(12, "DTP momentum lookback", minval=1, group="04 DTP")
dtpTrendThreshold = input.float(0.10, "DTP trend threshold (ATR units)", step=0.05, group="04 DTP")
dtpEarlyBars = input.int(12, "DTP early bars", minval=1, maxval=48, group="04 DTP")
dtpMatureBars = input.int(48, "DTP mature bars", minval=12, maxval=200, group="04 DTP")

atrLength = input.int(10, "ATR length", minval=1, group="05 Risk")
atrSmoothing = input.string("RMA", "ATR smoothing", options=["RMA", "SMA", "EMA", "WMA"], group="05 Risk")
atrMultiplier = input.float(1.5, "ATR multiplier", step=0.1, group="05 Risk")
positionAmount = input.float(5000, "Notional per trade ($)", step=500, minval=100, group="05 Risk")
maxLossPerTrade = input.float(150, "Max loss per trade ($)", step=10, minval=10, group="05 Risk")
scalePlanEnabled = input.bool(true, "Independent two-leg plan metadata", group="05 Risk")
maxLegRisk = input.float(75.0, "Max loss per independent leg ($)", step=5.0, minval=1.0, group="05 Risk")
slAtrMult = input.float(2.0, "Stop loss (x ATR)", step=0.25, minval=0.25, maxval=12.0, group="05 Risk")
rrRatio = input.float(1.5, "Reward/risk", step=0.1, minval=0.5, maxval=10.0, group="05 Risk")
enableBreakeven = input.bool(true, "Trail stop to breakeven", group="05 Risk")
enableTpCheckpointRunner = input.bool(true, "Enable runner mode", group="05 Risk")
runnerOnlyTrendSetups = input.bool(true, "Runner only trend setups", group="05 Risk")
runnerActivationR = input.float(1.0, "Runner activation (R)", step=0.25, minval=0.25, maxval=10.0, group="05 Risk")
tpCheckpointLockR = input.float(0.20, "Runner activation lock (R)", step=0.05, minval=0.0, maxval=3.0, group="05 Risk")
runnerTrailAtrMult = input.float(2.5, "Runner trail (x ATR)", step=0.25, minval=0.25, maxval=12.0, group="05 Risk")
runnerSafetyR = input.float(4.0, "Runner safety TP (R)", step=0.5, minval=1.0, maxval=20.0, group="05 Risk")
breakevenAtR = input.float(1.0, "Breakeven trigger (R)", step=0.25, minval=0.25, group="05 Risk")
breakevenOffsetR = input.float(0.05, "Breakeven offset (R)", step=0.01, minval=0.0, maxval=1.0, group="05 Risk")
useVolatilityFilter = input.bool(true, "Block low-volatility entries", group="05 Risk")
minAtrPctForEntry = input.float(0.08, "Minimum ATR% for entry", step=0.01, minval=0.0, group="05 Risk")
useProfitSpaceFilter = input.bool(true, "Block insufficient profit space", group="05 Risk")
minNetProfitForEntry = input.float(50.0, "Minimum net profit ($)", step=5.0, minval=0.0, group="05 Risk")
minNetRoiPctForEntry = input.float(1.0, "Minimum net ROI (%)", step=0.1, minval=0.0, group="05 Risk")
maxCostPctOfReward = input.float(15.0, "Maximum cost / reward (%)", step=1.0, minval=0.0, group="05 Risk")
minTargetAtrMultipleForEntry = input.float(1.0, "Minimum target distance (x ATR)", step=0.25, minval=0.0, group="05 Risk")
minStructureRewardRiskForEntry = input.float(1.5, "Minimum structure reward/risk", step=0.1, minval=0.1, group="05 Risk")
minWeakTrendRewardRiskForEntry = input.float(2.0, "Minimum weak/low-vol structure R/R", step=0.1, minval=0.1, group="05 Risk")
weakTrendAtrPctMultiplier = input.float(1.25, "Weak/low-vol ATR% threshold multiplier", step=0.05, minval=1.0, maxval=5.0, group="05 Risk")
estimatedRoundTripFee = input.float(2.10, "Estimated round-trip fixed costs ($)", step=0.05, minval=0.0, group="05 Risk")
estimatedSlippagePerSharePerSide = input.float(0.05, "Estimated slippage/share/side ($)", step=0.01, minval=0.0, group="05 Risk")
tvEntryLimitCapBps = input.float(15.0, "TV->IBKR entry limit cap (bps)", step=1.0, minval=0.0, group="05 Risk")
entryAnchorMode = input.string("setup_structural", "Entry anchor mode", options=["setup_structural", "marketable_cap"], group="05 Risk")
entryLevelLookbackBars = input.int(60, "Entry level lookback bars", minval=5, maxval=300, group="05 Risk")
entryAnchorZoneAtr = input.float(0.15, "Entry anchor zone (x ATR)", step=0.05, minval=0.0, maxval=3.0, group="05 Risk")
entryMaxAnchorAtr = input.float(0.60, "Max anchor distance (x ATR)", step=0.05, minval=0.05, maxval=5.0, group="05 Risk")
entryMaxAnchorBps = input.float(80.0, "Max anchor distance (bps)", step=5.0, minval=1.0, maxval=1000.0, group="05 Risk")
entryFallbackAtr = input.float(0.25, "Fallback entry offset (x ATR)", step=0.05, minval=0.0, maxval=3.0, group="05 Risk")
entryOrderTtlBars = input.int(1, "Entry order review bars", minval=1, maxval=20, group="05 Risk")
pendingTrendInvalidationBufferAtr = input.float(0.20, "Pending trend invalidation buffer (x ATR)", step=0.05, minval=0.0, maxval=2.0, group="05 Risk")
pendingTrendRecheckBars = input.int(2, "Pending trend soft invalid recheck bars", minval=1, maxval=10, group="05 Risk")
structuralSlBufferAtr = input.float(0.20, "Structural SL buffer (x ATR)", step=0.05, minval=0.0, maxval=3.0, group="05 Risk")
mrCheckpointR = input.float(0.60, "MR checkpoint lock trigger (R)", step=0.05, minval=0.10, maxval=5.0, group="05 Risk")
mrCheckpointLockR = input.float(0.05, "MR checkpoint lock offset (R)", step=0.01, minval=0.0, maxval=2.0, group="05 Risk")
mrTimeStopBars = input.int(10, "MR time stop bars", minval=1, maxval=100, group="05 Risk")
mrTimeStopMinMfeR = input.float(0.35, "MR time stop min MFE (R)", step=0.05, minval=0.0, maxval=5.0, group="05 Risk")
noFollowThroughBars = input.int(8, "No-follow-through bars", minval=1, maxval=50, group="05 Risk")
noFollowThroughMinMfeR = input.float(0.30, "No-follow-through min MFE (R)", step=0.05, minval=0.0, maxval=5.0, group="05 Risk")
noFollowThroughCompressedStopR = input.float(0.50, "No-follow-through compressed stop (R)", step=0.05, minval=0.05, maxval=3.0, group="05 Risk")
earlyAdverseBars = input.int(5, "Early adverse exit bars", minval=1, maxval=50, group="05 Risk")
earlyAdverseExitR = input.float(0.50, "Early adverse exit (R)", step=0.05, minval=0.05, maxval=3.0, group="05 Risk")
noFollowThroughDisableAfterMfeR = input.float(0.60, "Disable no-follow after MFE (R)", step=0.05, minval=0.0, maxval=5.0, group="05 Risk")
float profitSpaceMinNetProfitFloor = 50.0
float profitSpaceMinNetRoiPctFloor = 1.0
float effectiveMaxPlanRisk = maxLossPerTrade
float effectiveMaxLegRisk = scalePlanEnabled ? math.min(maxLegRisk, effectiveMaxPlanRisk / 2.0) : maxLossPerTrade
float effectiveMinNetProfitForEntry = math.max(minNetProfitForEntry, profitSpaceMinNetProfitFloor)
float effectiveMinNetRoiPctForEntry = math.max(minNetRoiPctForEntry, profitSpaceMinNetRoiPctFloor)

crsiDomcycle = input.int(20, "cRSI dominant cycle", minval=10, group="06 Oscillators")
crsiVibration = input.int(6, "cRSI vibration", minval=1, group="06 Oscillators")
crsiLeveling = input.float(10.0, "cRSI dynamic band percentile", minval=1, maxval=49, step=1, group="06 Oscillators")
divLookback = input.int(4, "Divergence pivot lookback", minval=1, maxval=20, group="06 Oscillators")
divMaxBars = input.int(30, "Divergence max age", minval=10, maxval=200, group="06 Oscillators")
divType = input.string("both", "Divergence type", options=["hidden", "regular", "both"], group="06 Oscillators")
obvRsiLen = input.int(10, "OBV RSI length", minval=1, group="06 Oscillators")

tradingSession = input.session("0945-1530", "Trading session", group="07 TV Primary Events")
useIntradayEntryWindows = input.bool(true, "Use intraday entry windows", group="07 TV Primary Events")
entrySession = input.session("0945-1515", "Continuous entry window", group="07 TV Primary Events")
primaryEntrySession = input.session("0945-1130", "Primary entry layer", group="07 TV Primary Events")
qualityEntrySession = input.session("1130-1400", "Quality entry layer", group="07 TV Primary Events")
closingQualityEntrySession = input.session("1400-1515", "Closing quality entry layer", group="07 TV Primary Events")
preAlertThreshold = input.int(65, "Pre-alert activity score", minval=1, maxval=99, group="07 TV Primary Events")
enableEodForceClose = input.bool(true, "Mirror system EOD force close", group="07 TV Primary Events")
eodCloseHour = input.int(15, "EOD force close hour ET", minval=0, maxval=23, group="07 TV Primary Events")
eodCloseMinute = input.int(55, "EOD force close minute ET", minval=0, maxval=59, group="07 TV Primary Events")
allowLong = input.bool(true, "Allow long entries", group="07 TV Primary Events")
allowShort = input.bool(true, "Allow short entries", group="07 TV Primary Events")
useDtpFilter = input.bool(true, "Filter MR entries against DTP", group="07 TV Primary Events")
dtpMrFilterMode = input.string("严格：只放转弱", "DTP MR filter mode", options=["严格：只放转弱", "平衡：只挡初期", "关闭：不挡MR"], group="07 TV Primary Events")
mrRangeMaxSdSlopeAtr = input.float(0.10, "MR range max SD slope (x ATR)", step=0.01, minval=0.0, maxval=5.0, group="07 TV Primary Events")
useEmaWeakFilter = input.bool(true, "Filter trend entries when EMA is weak", group="07 TV Primary Events")
trendReactionZoneAtr = input.float(0.20, "Trend reaction zone (x ATR)", step=0.05, minval=0.0, maxval=3.0, group="07 TV Primary Events")
trendQuickRejectBars = input.int(3, "Trend quick rejection bars", minval=1, maxval=20, group="07 TV Primary Events")
trendLingerBars = input.int(6, "Trend support/resistance linger bars", minval=2, maxval=50, group="07 TV Primary Events")
trendBreakBufferAtr = input.float(0.05, "Trend range break buffer (x ATR)", step=0.01, minval=0.0, maxval=1.0, group="07 TV Primary Events")
enableMtf = input.bool(true, "Enable MTF confirmation", group="07 TV Primary Events")
mtfMode = input.string("shadow_soft", "MTF mode", options=["shadow_soft", "display_only"], group="07 TV Primary Events")
mtfConfirmTf1 = input.timeframe("5", "MTF confirm TF 1", group="07 TV Primary Events")
mtfConfirmTf2 = input.timeframe("15", "MTF confirm TF 2", group="07 TV Primary Events")
mtfConfirmTf3 = input.timeframe("60", "MTF confirm TF 3", group="07 TV Primary Events")

displayPreset = input.string("核心交易流程", "Display preset", options=["核心交易流程", "指标辅助", "调试全量"], group="08 Display")
showFlowLabels = input.bool(true, "Show activation/prep/entry labels", group="08 Display")
showSignalDiagnostics = input.bool(true, "Show raw/filtered signal diagnostics", group="08 Display")
labelDetailMode = input.string("compact_tooltip", "Flow label detail mode", options=["compact_tooltip", "full_labels", "off"], group="08 Display")
flowLabelTransparency = input.int(30, "Flow label background transparency", minval=0, maxval=100, group="08 Display")
showStatusPanel = input.bool(true, "Show status panel", group="08 Display")
showPendingEntryLifecycle = input.bool(true, "Show pending entry lifecycle", group="08 Display")
showCurrentPlanLines = input.bool(true, "Show current Core plan lines", group="08 Display")
currentPlanLineForwardBars = input.int(3, "Current plan line forward bars", minval=1, maxval=20, group="08 Display")
showHistoricalPlanLines = input.bool(true, "Show historical Core plan lines", group="08 Display")
historicalPlanLineForwardBars = input.int(8, "Historical plan line forward bars", minval=1, maxval=50, group="08 Display")
maxHistoricalPlanLineSets = input.int(120, "Max historical plan line sets", minval=1, maxval=120, group="08 Display")
showBands = input.bool(true, "Show SD bands", group="08 Display")
showSdHelperLines = input.bool(false, "Show SD regression/filter lines", group="08 Display")
showDtpLine = input.bool(true, "Show DTP trend line", group="08 Display")
showEma = input.bool(true, "Show EMA fast/slow", group="08 Display")
showDebugComponents = input.bool(false, "Show SD/F/D component markers", group="08 Display")
showFractalMarkers = input.bool(true, "Show fractal markers", group="08 Display")
showEmaCrossMarkers = input.bool(true, "Show EMA20/50 cross markers", group="08 Display")

bool displayIndicatorMode = displayPreset == "指标辅助"
bool displayDebugMode = displayPreset == "调试全量"
bool flowLabelsVisible = showFlowLabels and labelDetailMode != "off"
bool compactFlowLabelMode = labelDetailMode == "compact_tooltip"
bool showEmaFastSlowLines = showEma or displayIndicatorMode or displayDebugMode
bool showEmaContextLines = displayIndicatorMode or displayDebugMode
bool showBandLines = showBands or displayIndicatorMode or displayDebugMode
bool showSdHelperBandLines = showSdHelperLines or displayIndicatorMode or displayDebugMode
bool showDtpTrendLine = showDtpLine or displayIndicatorMode or displayDebugMode
bool showComponentMarkers = showDebugComponents or displayDebugMode

bool confirmed = barstate.isconfirmed
int entryCloseEtMinutes = hour(time_close, "America/New_York") * 60 + minute(time_close, "America/New_York")
bool inContinuousEntryCloseWindow = entryCloseEtMinutes >= ENTRY_PRIMARY_START_MIN and entryCloseEtMinutes <= ENTRY_CUTOFF_MIN
bool inPrimaryEntryCloseWindow = entryCloseEtMinutes >= ENTRY_PRIMARY_START_MIN and entryCloseEtMinutes <= ENTRY_PRIMARY_END_MIN
bool inQualityEntryCloseWindow = entryCloseEtMinutes > ENTRY_PRIMARY_END_MIN and entryCloseEtMinutes < ENTRY_CLOSING_START_MIN
bool inClosingQualityEntryCloseWindow = entryCloseEtMinutes >= ENTRY_CLOSING_START_MIN and entryCloseEtMinutes <= ENTRY_CUTOFF_MIN
bool inSession = not na(time(timeframe.period, tradingSession, syminfo.timezone))
bool inContinuousEntryWindow = not na(time(timeframe.period, entrySession, syminfo.timezone)) and inContinuousEntryCloseWindow
bool inPrimaryEntryWindow = not na(time(timeframe.period, primaryEntrySession, syminfo.timezone)) and inPrimaryEntryCloseWindow
bool inQualityEntryWindow = not na(time(timeframe.period, qualityEntrySession, syminfo.timezone)) and inQualityEntryCloseWindow
bool inClosingQualityEntryWindow = not na(time(timeframe.period, closingQualityEntrySession, syminfo.timezone)) and inClosingQualityEntryCloseWindow
bool inEntryWindow = not useIntradayEntryWindows or inContinuousEntryWindow
string entryWindowStage = not useIntradayEntryWindows ? "disabled" : inPrimaryEntryWindow ? "primary" : inQualityEntryWindow ? "quality" : inClosingQualityEntryWindow ? "closing_quality" : "no_new_entry"
bool lateQualityEntryWindow = entryWindowStage == "quality" or entryWindowStage == "closing_quality"
bool canTrade = confirmed and inSession
bool canOpenEntry = canTrade and inEntryWindow
int dailyTime = time("D")
bool isNewTradingDay = not na(dailyTime[1]) and dailyTime != dailyTime[1]

// -----------------------------------------------------------------------------
// Helpers
// -----------------------------------------------------------------------------
appendSource(string existing, string nextValue) =>
    existing == "" ? nextValue : existing + "+" + nextValue

maFunc(float source, int len) =>
    switch atrSmoothing
        "SMA" => ta.sma(source, len)
        "EMA" => ta.ema(source, len)
        "WMA" => ta.wma(source, len)
        => ta.rma(source, len)

calcSlope(float source, int len) =>
    not na(source[len]) and source[len] != 0.0 ? (source - source[len]) / source[len] * 100.0 : 0.0

priceChanged(float oldValue, float newValue) =>
    na(oldValue) or na(newValue) ? true : math.abs(oldValue - newValue) >= syminfo.mintick

setupDisplayName(string setup) =>
    setup == "trend_sdUpper" ? "SD上轨顺势多" : setup == "trend_sdLowerBreakout" ? "SD下轨反转顺势多" : setup == "mr_sdLower" ? "SD下轨回归多" : setup == "trend_sdUpperBreakdown" ? "SD上轨反转顺势空" : setup == "trend_emaDeathContinuation" ? "EMA死叉顺势空" : setup == "mr_sdUpper" ? "SD上轨回归空" : setup == "trend_sdLower" ? "SD下轨顺势空" : setup

directionDisplayName(string direction) =>
    direction == "short" ? "做空" : "做多"

closeDirectionTag(int direction) =>
    direction == -1 ? "平空" : direction == 1 ? "平多" : "平仓"

exitReasonDisplayName(string reason) =>
    reason == "take_profit" ? "TP止盈" : reason == "runner_stop" ? "跟踪止盈" : reason == "stop_loss" ? "SL止损" : reason == "mr_time_stop" ? "MR超时退出" : reason == "mr_structure_invalidated" ? "MR结构失效" : reason == "adverse_early_stop" ? "早期反向止损" : reason == "opposite_structure_exit" ? "反向结构退出" : reason == "entry_ttl_expired" ? "挂单过期" : reason == "force_flat_eod" or reason == "eod" ? "EOD强平" : reason == "strategy_closed" ? "策略退出" : reason

cancelReasonDisplayName(string reason) =>
    reason == "entry_ttl_expired" ? "挂单过期" : reason == "entry_window_expired" ? "入场窗口结束" : reason == "setup_window_expired" ? "结构窗口失效" : reason == "entry_anchor_invalidated" ? "结构价失效" : reason == "trend_invalidated" ? "趋势硬裂化" : reason == "soft_trend_recheck_failed" ? "软失效复查失败" : reason == "opposite_signal_or_conflict" ? "反向/冲突信号" : reason == "pending_eod_cancel" ? "EOD撤销挂单" : reason

fmtSignedMoney(float value) =>
    na(value) ? "--" : (value >= 0.0 ? "+$" : "-$") + str.tostring(math.abs(value), "#.##")

fmtMoney(float value) =>
    na(value) ? "--" : "$" + str.tostring(value, "#.##")

fmtSignedPct(float value) =>
    na(value) ? "--" : (value >= 0.0 ? "+" : "-") + str.tostring(math.abs(value), "#.##") + "%"

exitPnlLabelText(string reason, string timeText, float price, float pnl, float pnlPct) =>
    exitReasonDisplayName(reason) + "\n" + syminfo.ticker + " · " + timeText + " ET @ " + str.tostring(price, "#.##") + "\nPnL " + fmtSignedMoney(pnl) + " (" + fmtSignedPct(pnlPct) + ")"

exitPnlLabelColor(float pnl) =>
    na(pnl) ? color.new(color.gray, flowLabelTransparency) : pnl > 0.0 ? color.new(color.green, flowLabelTransparency) : pnl < 0.0 ? color.new(color.red, flowLabelTransparency) : color.new(color.gray, flowLabelTransparency)

entryComment(string direction, string setup) =>
    direction == "short" ? "SELL 空 · " + setup : "BUY 多 · " + setup

setupUsesUpperWindow(string setup) =>
    setup == "trend_sdUpper" or setup == "mr_sdUpper" or setup == "trend_sdUpperBreakdown"

setupUsesBullSide(string setup) =>
    setup == "trend_sdUpper" or setup == "mr_sdLower" or setup == "trend_sdLowerBreakout"

setupUsesRunner(string setup) =>
    enableTpCheckpointRunner and (not runnerOnlyTrendSetups or setup == "trend_sdUpper" or setup == "trend_sdLower" or setup == "trend_sdUpperBreakdown" or setup == "trend_sdLowerBreakout" or setup == "trend_emaDeathContinuation")

setupIsMr(string setup) =>
    setup == "mr_sdUpper" or setup == "mr_sdLower"

setupIsTrend(string setup) =>
    setup == "trend_sdUpper" or setup == "trend_sdLower" or setup == "trend_sdUpperBreakdown" or setup == "trend_sdLowerBreakout" or setup == "trend_emaDeathContinuation"

setupIsPostSdReversal(string setup) =>
    setup == "trend_sdUpperBreakdown" or setup == "trend_sdLowerBreakout"

calcTargetAtR(float entryPrice, float stopPrice, int direction, float rMultiple) =>
    float risk = direction == 1 ? entryPrice - stopPrice : stopPrice - entryPrice
    direction == 1 ? entryPrice + risk * rMultiple : entryPrice - risk * rMultiple

calcRunnerActivationTarget(float entryPrice, float stopPrice, int direction) =>
    calcTargetAtR(entryPrice, stopPrice, direction, runnerActivationR)

validResistanceLevel(float referencePrice, float levelPrice) =>
    not na(levelPrice) and levelPrice > 0.0 and levelPrice > referencePrice + syminfo.mintick * 2.0 ? levelPrice : na

validSupportLevel(float referencePrice, float levelPrice) =>
    not na(levelPrice) and levelPrice > 0.0 and levelPrice < referencePrice - syminfo.mintick * 2.0 ? levelPrice : na

structureRewardPerShare(int direction, float entryPrice, float targetPrice) =>
    direction == 1 ? targetPrice - entryPrice : entryPrice - targetPrice

structureRiskPerShare(int direction, float entryPrice, float stopPrice) =>
    direction == 1 ? entryPrice - stopPrice : stopPrice - entryPrice

rewardRiskMultiple(float rewardPerShare, float riskPerShare) =>
    riskPerShare > 0.0 ? rewardPerShare / riskPerShare : na

structureContextMinRewardRisk(bool weakOrLowVolContext) =>
    weakOrLowVolContext ? minWeakTrendRewardRiskForEntry : minStructureRewardRiskForEntry

structureTargetSourceForSetup(string setup, string direction) =>
    setupIsMr(setup) ? "mr_mean_reversion_structure" : direction == "long" ? "next_resistance_structure" : "next_support_structure"

roundEntryLimitToTick(float price, int direction) =>
    float tick = math.max(syminfo.mintick, 0.00000001)
    direction == -1 ? math.floor(price / tick) * tick : math.ceil(price / tick) * tick

roundStructuralEntryLimitToTick(float price, int direction) =>
    float tick = math.max(syminfo.mintick, 0.00000001)
    direction == -1 ? math.ceil(price / tick) * tick : math.floor(price / tick) * tick

calcSubmittedEntryLimit(float referenceEntry, int direction) =>
    float cap = tvEntryLimitCapBps / 10000.0
    float rawLimit = direction == -1 ? referenceEntry * (1.0 - cap) : referenceEntry * (1.0 + cap)
    roundEntryLimitToTick(rawLimit, direction)

directionalDistanceAtr(float referencePrice, float plannedPrice, float atrValue) =>
    atrValue > 0.0 ? math.abs(plannedPrice - referencePrice) / atrValue : 0.0

directionalDistanceBps(float referencePrice, float plannedPrice) =>
    referencePrice > 0.0 ? math.abs(plannedPrice - referencePrice) / referencePrice * 10000.0 : 999999.0

entryAnchorValid(float referencePrice, float plannedPrice, float atrValue) =>
    not na(plannedPrice) and plannedPrice > 0.0 and directionalDistanceAtr(referencePrice, plannedPrice, atrValue) <= entryMaxAnchorAtr and directionalDistanceBps(referencePrice, plannedPrice) <= entryMaxAnchorBps

appendAnchorReason(string existing, string nextValue) =>
    existing == "" ? nextValue : existing + " + " + nextValue

limitByHardCap(float referencePrice, float plannedPrice, int direction) =>
    float cap = tvEntryLimitCapBps / 10000.0
    float hardCap = direction == 1 ? referencePrice * (1.0 + cap) : referencePrice * (1.0 - cap)
    direction == 1 ? math.min(plannedPrice, hardCap) : math.max(plannedPrice, hardCap)

anchorNear(float plannedPrice, float levelPrice, float atrValue) =>
    not na(plannedPrice) and not na(levelPrice) and levelPrice > 0.0 and math.abs(plannedPrice - levelPrice) <= math.max(syminfo.mintick * 2.0, atrValue * entryAnchorZoneAtr)

pullbackNearResistance(float barHigh, float barClose, float levelPrice, float atrValue) =>
    float zone = math.max(syminfo.mintick * 2.0, atrValue * trendReactionZoneAtr)
    float maxReject = math.max(zone, atrValue * 0.35)
    not na(levelPrice) and levelPrice > 0.0 and barHigh >= levelPrice - zone and barClose <= levelPrice + zone and barClose >= levelPrice - maxReject

pullbackNearSupport(float barLow, float barClose, float levelPrice, float atrValue) =>
    float zone = math.max(syminfo.mintick * 2.0, atrValue * trendReactionZoneAtr)
    float maxReject = math.max(zone, atrValue * 0.35)
    not na(levelPrice) and levelPrice > 0.0 and barLow <= levelPrice + zone and barClose >= levelPrice - zone and barClose <= levelPrice + maxReject

nearestSupportBelow(float referencePrice, float v1, float v2, float v3, float v4, float v5, float v6, float v7, float v8, float fallback) =>
    float best = na
    best := not na(v1) and v1 > 0.0 and v1 <= referencePrice and (na(best) or v1 > best) ? v1 : best
    best := not na(v2) and v2 > 0.0 and v2 <= referencePrice and (na(best) or v2 > best) ? v2 : best
    best := not na(v3) and v3 > 0.0 and v3 <= referencePrice and (na(best) or v3 > best) ? v3 : best
    best := not na(v4) and v4 > 0.0 and v4 <= referencePrice and (na(best) or v4 > best) ? v4 : best
    best := not na(v5) and v5 > 0.0 and v5 <= referencePrice and (na(best) or v5 > best) ? v5 : best
    best := not na(v6) and v6 > 0.0 and v6 <= referencePrice and (na(best) or v6 > best) ? v6 : best
    best := not na(v7) and v7 > 0.0 and v7 <= referencePrice and (na(best) or v7 > best) ? v7 : best
    best := not na(v8) and v8 > 0.0 and v8 <= referencePrice and (na(best) or v8 > best) ? v8 : best
    na(best) ? fallback : best

nearestResistanceAbove(float referencePrice, float v1, float v2, float v3, float v4, float v5, float v6, float v7, float v8, float fallback) =>
    float best = na
    best := not na(v1) and v1 > 0.0 and v1 >= referencePrice and (na(best) or v1 < best) ? v1 : best
    best := not na(v2) and v2 > 0.0 and v2 >= referencePrice and (na(best) or v2 < best) ? v2 : best
    best := not na(v3) and v3 > 0.0 and v3 >= referencePrice and (na(best) or v3 < best) ? v3 : best
    best := not na(v4) and v4 > 0.0 and v4 >= referencePrice and (na(best) or v4 < best) ? v4 : best
    best := not na(v5) and v5 > 0.0 and v5 >= referencePrice and (na(best) or v5 < best) ? v5 : best
    best := not na(v6) and v6 > 0.0 and v6 >= referencePrice and (na(best) or v6 < best) ? v6 : best
    best := not na(v7) and v7 > 0.0 and v7 >= referencePrice and (na(best) or v7 < best) ? v7 : best
    best := not na(v8) and v8 > 0.0 and v8 >= referencePrice and (na(best) or v8 < best) ? v8 : best
    na(best) ? fallback : best

componentFresh(int componentBar) =>
    not na(componentBar) and bar_index - componentBar <= mrComponentFreshBars

setupNeedsFreshMrComponents(string setup) =>
    setup == "mr_sdUpper" or setup == "mr_sdLower"

exitTouchesTarget(int direction, float exitPrice, float targetPrice) =>
    not na(targetPrice) and (math.abs(exitPrice - targetPrice) <= syminfo.mintick * 2.0 or (direction == 1 ? exitPrice >= targetPrice : exitPrice <= targetPrice))

exitTouchesStop(int direction, float exitPrice, float stopPrice) =>
    not na(stopPrice) and (math.abs(exitPrice - stopPrice) <= syminfo.mintick * 2.0 or (direction == 1 ? exitPrice <= stopPrice : exitPrice >= stopPrice))

setupUsesEmaTouch(string setup) =>
    setup == "trend_sdUpper" or setup == "trend_sdLower"

componentStateText(bool ready, string label) =>
    (ready ? "有" : "缺") + label

directionComponentCount(bool fractalReady, bool divReady, bool emaCrossReady) =>
    (fractalReady ? 1 : 0) + (divReady ? 1 : 0) + (emaCrossReady ? 1 : 0)

directionComponentsReady(bool fractalReady, bool divReady, bool emaCrossReady) =>
    directionComponentCount(fractalReady, divReady, emaCrossReady) >= 2

componentLineText(string setup, bool windowReady, bool emaReady, bool fractalReady, bool divReady, bool emaCrossReady) =>
    string windowLabel = setup == "trend_sdUpper" ? "强多背景" : setup == "trend_sdLower" ? "强空背景" : setup == "trend_sdUpperBreakdown" ? "上轨记忆" : setup == "trend_sdLowerBreakout" ? "下轨记忆" : setup == "trend_emaDeathContinuation" ? "弱势结构" : setupUsesUpperWindow(setup) ? "上轨窗" : "下轨窗"
    string emaLabel = setup == "trend_sdUpper" ? "多EMA/贴轨" : setup == "trend_sdLower" ? "空EMA/回抽" : ""
    string fractalLabel = setupUsesBullSide(setup) ? "多分形" : "空分形"
    string divLabel = setupUsesBullSide(setup) ? "多背离" : "空背离"
    string emaCrossLabel = setupUsesBullSide(setup) ? "金叉" : "死叉"
    string parts = componentStateText(windowReady, windowLabel)
    parts := setupUsesEmaTouch(setup) ? parts + " " + componentStateText(emaReady, emaLabel) : parts
    parts + " 方向" + str.tostring(directionComponentCount(fractalReady, divReady, emaCrossReady), "#") + "/3(" + componentStateText(fractalReady, fractalLabel) + " " + componentStateText(divReady, divLabel) + " " + componentStateText(emaCrossReady, emaCrossLabel) + ")"

componentReadyCount(string setup, bool windowReady, bool emaReady, bool fractalReady, bool divReady, bool emaCrossReady) =>
    int count = windowReady ? 1 : 0
    count := count + (setupUsesEmaTouch(setup) and emaReady ? 1 : 0)
    count := count + (directionComponentsReady(fractalReady, divReady, emaCrossReady) ? 1 : 0)
    count

componentTotalCount(string setup) =>
    setupUsesEmaTouch(setup) ? 3 : 2

componentSummaryText(string setup, bool windowReady, bool emaReady, bool fractalReady, bool divReady, bool emaCrossReady) =>
    str.tostring(componentReadyCount(setup, windowReady, emaReady, fractalReady, divReady, emaCrossReady), "#") + "/" + str.tostring(componentTotalCount(setup), "#") + " · " + componentLineText(setup, windowReady, emaReady, fractalReady, divReady, emaCrossReady)

componentSummaryForSetup(string setup, bool upperWindowReady, bool lowerWindowReady, bool upperBullTouchReady, bool lowerBearTouchReady, bool upperBullFractalReady, bool lowerBullFractalReady, bool upperBearFractalReady, bool lowerBearFractalReady, bool trendBearFractalReady, bool upperBullEmaCrossReady, bool lowerBullEmaCrossReady, bool upperBearEmaCrossReady, bool lowerBearEmaCrossReady, bool trendBearEmaCrossReady, bool bullDivReady, bool bearDivReady) =>
    bool windowReady = setupUsesUpperWindow(setup) ? upperWindowReady : lowerWindowReady
    bool emaReady = setup == "trend_sdUpper" ? upperBullTouchReady : setup == "trend_sdLower" ? lowerBearTouchReady : true
    bool fractalReady = setup == "trend_sdUpper" ? upperBullFractalReady : setup == "mr_sdLower" or setup == "trend_sdLowerBreakout" ? lowerBullFractalReady : setup == "trend_emaDeathContinuation" ? trendBearFractalReady : setup == "mr_sdUpper" or setup == "trend_sdUpperBreakdown" ? upperBearFractalReady : lowerBearFractalReady
    bool divReady = setupUsesBullSide(setup) ? bullDivReady : bearDivReady
    bool emaCrossReady = setup == "trend_sdUpper" ? upperBullEmaCrossReady : setup == "mr_sdLower" or setup == "trend_sdLowerBreakout" ? lowerBullEmaCrossReady : setup == "trend_emaDeathContinuation" ? trendBearEmaCrossReady : setup == "mr_sdUpper" or setup == "trend_sdUpperBreakdown" ? upperBearEmaCrossReady : lowerBearEmaCrossReady
    componentSummaryText(setup, windowReady, emaReady, fractalReady, divReady, emaCrossReady)

componentProgressForSetup(string setup, bool upperWindowReady, bool lowerWindowReady, bool upperBullTouchReady, bool lowerBearTouchReady, bool upperBullFractalReady, bool lowerBullFractalReady, bool upperBearFractalReady, bool lowerBearFractalReady, bool trendBearFractalReady, bool upperBullEmaCrossReady, bool lowerBullEmaCrossReady, bool upperBearEmaCrossReady, bool lowerBearEmaCrossReady, bool trendBearEmaCrossReady, bool bullDivReady, bool bearDivReady) =>
    bool windowReady = setupUsesUpperWindow(setup) ? upperWindowReady : lowerWindowReady
    bool emaReady = setup == "trend_sdUpper" ? upperBullTouchReady : setup == "trend_sdLower" ? lowerBearTouchReady : true
    bool fractalReady = setup == "trend_sdUpper" ? upperBullFractalReady : setup == "mr_sdLower" or setup == "trend_sdLowerBreakout" ? lowerBullFractalReady : setup == "trend_emaDeathContinuation" ? trendBearFractalReady : setup == "mr_sdUpper" or setup == "trend_sdUpperBreakdown" ? upperBearFractalReady : lowerBearFractalReady
    bool divReady = setupUsesBullSide(setup) ? bullDivReady : bearDivReady
    bool emaCrossReady = setup == "trend_sdUpper" ? upperBullEmaCrossReady : setup == "mr_sdLower" or setup == "trend_sdLowerBreakout" ? lowerBullEmaCrossReady : setup == "trend_emaDeathContinuation" ? trendBearEmaCrossReady : setup == "mr_sdUpper" or setup == "trend_sdUpperBreakdown" ? upperBearEmaCrossReady : lowerBearEmaCrossReady
    str.tostring(componentReadyCount(setup, windowReady, emaReady, fractalReady, divReady, emaCrossReady), "#") + "/" + str.tostring(componentTotalCount(setup), "#")

compactMissingText(string value) =>
    string missingText = value == "" or value == "none" ? "齐" : value
    missingText := str.replace_all(missingText, "upper_window", "上轨窗")
    missingText := str.replace_all(missingText, "lower_window", "下轨窗")
    missingText := str.replace_all(missingText, "weak_structure", "弱势结构")
    missingText := str.replace_all(missingText, "upper_sd_memory", "上轨记忆")
    missingText := str.replace_all(missingText, "lower_sd_memory", "下轨记忆")
    missingText := str.replace_all(missingText, "trend_context", "趋势背景")
    missingText := str.replace_all(missingText, "key_level_wait", "关键位突破")
    missingText := str.replace_all(missingText, "ema_bull_touch", "多EMA/贴轨")
    missingText := str.replace_all(missingText, "ema_bear_touch", "空EMA/回抽")
    missingText := str.replace_all(missingText, "bull_fractal", "多分形")
    missingText := str.replace_all(missingText, "bear_fractal", "空分形")
    missingText := str.replace_all(missingText, "bull_divergence", "多背离")
    missingText := str.replace_all(missingText, "bear_divergence", "空背离")
    missingText := str.replace_all(missingText, "bull_ema_cross", "金叉")
    missingText := str.replace_all(missingText, "bear_ema_cross", "死叉")
    missingText := str.replace_all(missingText, "+", "/")
    missingText

waitComponentText(string value) =>
    string missingText = compactMissingText(value)
    missingText == "齐" ? "组件齐" : "等 " + missingText

filterDisplayName(string reason) =>
    reason == "entry_time_blocked" ? "非连续入场窗口" : reason == "entry_anchor_unavailable" ? "无有效结构挂单价" : reason == "post_reversal_anchor_unqualified" ? "反转顺势锚点不足" : reason == "mr_dtp_phase_blocked" ? "MR逆DTP未转弱" : reason == "mr_anchor_unqualified" ? "MR锚点依据不足" : reason == "mr_reversal_confirm_missing" ? "MR缺少反转确认" : reason == "mr_target_space_too_small" ? "MR均值空间不足" : reason == "structure_tp_sl_unavailable" ? "结构止盈止损不足" : reason == "mr_ema_cross_missing" ? "MR缺少EMA反转" : reason == "mr_component_stale" ? "MR组件过期" : reason == "candidate_filtered" ? "候选未执行" : reason == "dtp_bearish_early" ? "DTP偏空初期" : reason == "dtp_bullish_early" ? "DTP偏多初期" : reason == "dtp_bearish_early_or_confirmed" ? "DTP偏空" : reason == "dtp_bullish_early_or_confirmed" ? "DTP偏多" : reason == "ema_weak" ? "EMA弱" : reason == "low_volatility" ? "低波动" : reason == "profit_space_too_small" ? "获利空间不足" : reason == "mtf_5m_15m_opposite" ? "MTF反向" : reason == "long_short_conflict" ? "多空冲突" : reason == "" ? "过滤" : reason

filterActionText(string reason, string direction) =>
    reason == "entry_time_blocked" ? "不在09:45-15:15连续入场窗口，新仓等待下一交易日/下一窗口" : reason == "entry_anchor_unavailable" ? "结构价离现价太远/无依据，放弃追价" : reason == "post_reversal_anchor_unqualified" ? "死叉/金叉后只接受EMA/前高低/日内结构锚点" : reason == "mr_dtp_phase_blocked" ? "MR逆DTP强趋势，等DTP转弱/中性再做回归" : reason == "mr_anchor_unqualified" ? "MR只接受SD外轨/前高低/EMA结构锚点" : reason == "mr_reversal_confirm_missing" ? "逆趋势转弱MR需要EMA反转交叉 + 分形/背离" : reason == "mr_target_space_too_small" ? "均值目标不可用或获利空间不足" : reason == "structure_tp_sl_unavailable" ? "没有真实结构TP/SL，不用ATR硬凑目标" : reason == "mr_ema_cross_missing" ? "MR缺少EMA20/50反转确认，等金叉/死叉" : reason == "mr_component_stale" ? "MR组件过期，等新分形/背离/交叉" : reason == "candidate_filtered" ? "候选未进入下单分支，检查窗口/方向/数量条件" : reason == "dtp_bearish_early" ? "DTP偏空初期，等过初期" : reason == "dtp_bullish_early" ? "DTP偏多初期，等过初期" : reason == "dtp_bearish_early_or_confirmed" ? "DTP偏空，等转弱/中性/多" : reason == "dtp_bullish_early_or_confirmed" ? "DTP偏多，等转弱/中性/空" : reason == "ema_weak" ? "EMA偏弱，等快慢线走强" : reason == "low_volatility" ? "ATR%低于入场阈值，等波动恢复" : reason == "profit_space_too_small" ? "等更大空间" : reason == "mtf_5m_15m_opposite" ? "5m+15m 同时反向，等MTF转中性/同向" : reason == "long_short_conflict" ? "多空冲突，等单边明确" : reason == "" ? "过滤" + directionDisplayName(direction) + "，等条件恢复" : filterDisplayName(reason)

dtpPhaseDisplayName(string phase) =>
    phase == "early" ? "初期" : phase == "confirmed" ? "确认" : phase == "mature" ? "成熟" : phase == "weakening" ? "转弱" : "中性"

dtpStateText(int direction, string phase) =>
    (direction == 1 ? "DTP偏多" : direction == -1 ? "DTP偏空" : "DTP中性") + " · " + dtpPhaseDisplayName(phase)

dtpMrBlocksPhase(string mode, string phase) =>
    mode == "关闭：不挡MR" ? false : mode == "严格：只放转弱" ? phase != "weakening" : phase == "early"

dtpBlockReasonText(string direction, string mode) =>
    direction == "long" ? (mode == "严格：只放转弱" ? "dtp_bearish_early_or_confirmed" : "dtp_bearish_early") : (mode == "严格：只放转弱" ? "dtp_bullish_early_or_confirmed" : "dtp_bullish_early")

mrDtpAdverse(string direction, int dtpDirection) =>
    direction == "long" ? dtpDirection == -1 : dtpDirection == 1

mrDtpSameDirection(string direction, int dtpDirection) =>
    direction == "long" ? dtpDirection == 1 : dtpDirection == -1

mrDtpBlocked(string direction, int dtpDirection, string phase, string mode, bool enabled) =>
    enabled and mrDtpAdverse(direction, dtpDirection) and dtpMrBlocksPhase(mode, phase)

mrRegimeText(string direction, int dtpDirection, string phase, string mode, bool enabled, float sdSlopeAtrValue) =>
    bool adverse = mrDtpAdverse(direction, dtpDirection)
    bool blocked = mrDtpBlocked(direction, dtpDirection, phase, mode, enabled)
    bool rangeLike = dtpDirection == 0 or sdSlopeAtrValue <= mrRangeMaxSdSlopeAtr
    blocked ? "countertrend_blocked" : adverse and phase == "weakening" ? "trend_weakening" : adverse ? "countertrend_allowed" : rangeLike ? "range" : mrDtpSameDirection(direction, dtpDirection) ? "same_direction_pullback" : "range"

mrRegimeDisplayName(string regime) =>
    regime == "range" ? "震荡" : regime == "trend_weakening" ? "趋势转弱" : regime == "same_direction_pullback" ? "顺势回撤" : regime == "countertrend_allowed" ? "逆势放行" : regime == "countertrend_blocked" ? "强趋势过滤" : "none"

dtpEntryFilterText(string direction, int dtpDirection, string phase, string mode, bool enabled) =>
    string stateText = dtpStateText(dtpDirection, phase)
    bool adverse = direction == "long" ? dtpDirection == -1 : dtpDirection == 1
    not enabled or mode == "关闭：不挡MR" ? stateText + " · DTP不拦" : adverse and mrDtpBlocked(direction, dtpDirection, phase, mode, enabled) ? stateText + " · MR等待转弱" : adverse and phase == "weakening" ? stateText + " · 转弱放行" : stateText

mtfEmaDirValue() =>
    float fast = ta.ema(close, 20)
    float slow = ta.ema(close, 50)
    fast > slow ? 1 : fast < slow ? -1 : 0

mtfDtpDirValue() =>
    float avg = ta.sma(close, dtpSmaLength)
    float atr = ta.atr(dtpAtrLength)
    float momentum = avg - avg[dtpMomentumLookback]
    float normalized = atr > 0.0 ? momentum / atr : 0.0
    normalized > dtpTrendThreshold and close > avg ? 1 : normalized < -dtpTrendThreshold and close < avg ? -1 : 0

mtfStateForDirection(string direction, int emaDirection, int dtpDirection) =>
    int wanted = direction == "short" ? -1 : 1
    int opposite = -wanted
    bool failed = emaDirection == opposite and dtpDirection == opposite
    bool supported = emaDirection == wanted or dtpDirection == wanted
    failed ? "fail" : supported ? "pass" : "warn"

mtfStatePoints(string state, float weight) =>
    state == "pass" ? weight : state == "warn" ? weight * 0.5 : 0.0

mtfScoreForStates(string state1, string state2, string state3) =>
    enableMtf ? mtfStatePoints(state1, 45.0) + mtfStatePoints(state2, 35.0) + mtfStatePoints(state3, 20.0) : 0.0

mtfDisplayMark(string state) =>
    state == "pass" ? "✓" : state == "fail" ? "×" : "!"

mtfStatusForStates(string state1, string state2, string state3) =>
    enableMtf and mtfMode == "shadow_soft" and state1 == "fail" and state2 == "fail" ? "block" : enableMtf ? (state1 == "fail" or state2 == "fail" or state3 == "fail" ? "warn" : "pass") : "off"

mtfBlockReasonForStates(string state1, string state2) =>
    enableMtf and mtfMode == "shadow_soft" and state1 == "fail" and state2 == "fail" ? "mtf_5m_15m_opposite" : "none"

flowBaseColor(string state, string direction) =>
    state == "activate_lower" or state == "activate_upper" ? color.blue : state == "blocked" ? color.gray : direction == "short" ? color.red : color.green

flowLabelColor(string state, string direction) =>
    color.new(flowBaseColor(state, direction), flowLabelTransparency)

flowStatusColor(string state, string direction) =>
    color.new(flowBaseColor(state, direction), 0)

flowLabelStyle(string direction) =>
    direction == "short" ? label.style_label_down : label.style_label_up

flowLabelText(string compactText, string detailText) =>
    compactFlowLabelMode ? compactText : detailText

flowLabelTooltip(string detailText) =>
    compactFlowLabelMode ? detailText : ""

// -----------------------------------------------------------------------------
// Core indicators
// -----------------------------------------------------------------------------
float emaFast = ta.ema(close, 20)
float emaSlow = ta.ema(close, 50)
float emaTrend = ta.ema(close, 100)
float emaLongest = ta.ema(close, 200)

float slopeSlow = calcSlope(emaSlow, emaSlopeLookback)
float slopeTrend = calcSlope(emaTrend, emaSlopeLookback)
float slopeLongest = calcSlope(emaLongest, emaSlopeLookback)
float spacingFastSlow = emaSlow != 0.0 ? math.abs(emaFast - emaSlow) / emaSlow * 100.0 : 0.0
float spacingSlowTrend = emaTrend != 0.0 ? math.abs(emaSlow - emaTrend) / emaTrend * 100.0 : 0.0
float spacingTrendLongest = emaLongest != 0.0 ? math.abs(emaTrend - emaLongest) / emaLongest * 100.0 : 0.0
bool spacingOk = spacingFastSlow > emaMinSpacing and spacingSlowTrend > emaMinSpacing and spacingTrendLongest > emaMinSpacing
bool emaGoldenCrossRaw = ta.crossover(emaFast, emaSlow)
bool emaDeathCrossRaw = ta.crossunder(emaFast, emaSlow)
bool emaGoldenCross = confirmed and emaGoldenCrossRaw
bool emaDeathCross = confirmed and emaDeathCrossRaw

bool emaBullishAlign = emaFast > emaSlow and emaSlow > emaTrend and emaTrend > emaLongest
bool emaBearishAlign = emaFast < emaSlow and emaSlow < emaTrend and emaTrend < emaLongest
bool emaBullish = emaBullishAlign and slopeSlow > emaMinAngle and slopeTrend > emaMinAngle and slopeLongest > emaMinAngle and spacingOk
bool emaBearish = emaBearishAlign and slopeSlow < -emaMinAngle and slopeTrend < -emaMinAngle and slopeLongest < -emaMinAngle and spacingOk
int trendDir = emaBullish ? 1 : emaBearish ? -1 : 0

bool bullTouchFast = confirmed and emaBullishAlign and spacingOk and close[1] > emaFast[1] and low <= emaFast
bool bearTouchFast = confirmed and emaBearishAlign and spacingOk and close[1] < emaFast[1] and high >= emaFast
bool bullTouchSlow = confirmed and emaBullishAlign and spacingOk and close[1] > emaSlow[1] and low <= emaSlow
bool bearTouchSlow = confirmed and emaBearishAlign and spacingOk and close[1] < emaSlow[1] and high >= emaSlow
bool emaBullTouch = emaTouchType == "fast" ? bullTouchFast : emaTouchType == "slow" ? bullTouchSlow : bullTouchFast or bullTouchSlow
bool emaBearTouch = emaTouchType == "fast" ? bearTouchFast : emaTouchType == "slow" ? bearTouchSlow : bearTouchFast or bearTouchSlow
string bullTouchLine = bullTouchFast and bullTouchSlow ? "fast+slow" : bullTouchFast ? "fast" : bullTouchSlow ? "slow" : "none"
string bearTouchLine = bearTouchFast and bearTouchSlow ? "fast+slow" : bearTouchFast ? "fast" : bearTouchSlow ? "slow" : "none"

float upperDonch = ta.highest(high, donchianPeriod)
float lowerDonch = ta.lowest(low, donchianPeriod)
float donchianBase = (upperDonch + lowerDonch) / 2.0
float fractalPivotHigh = ta.pivothigh(high, fractalPeriod, fractalPeriod)
float fractalPivotLow = ta.pivotlow(low, fractalPeriod, fractalPeriod)
bool fractalBear = confirmed and not na(fractalPivotHigh) and fractalPivotHigh > donchianBase[fractalPeriod]
bool fractalBull = confirmed and not na(fractalPivotLow) and fractalPivotLow < donchianBase[fractalPeriod]
var float lastPivotHigh = na
var float lastPivotLow = na
var int lastPivotHighBar = na
var int lastPivotLowBar = na
if isNewTradingDay
    lastPivotHigh := na
    lastPivotLow := na
    lastPivotHighBar := na
    lastPivotLowBar := na
if confirmed and not na(fractalPivotHigh)
    lastPivotHigh := fractalPivotHigh
    lastPivotHighBar := bar_index - fractalPeriod
if confirmed and not na(fractalPivotLow)
    lastPivotLow := fractalPivotLow
    lastPivotLowBar := bar_index - fractalPeriod

var float sessionHigh = na
var float sessionLow = na
if isNewTradingDay or na(sessionHigh) or na(sessionLow)
    sessionHigh := high
    sessionLow := low
else if confirmed
    sessionHigh := math.max(sessionHigh, high)
    sessionLow := math.min(sessionLow, low)

float recentHigh = ta.highest(high[1], entryLevelLookbackBars)
float recentLow = ta.lowest(low[1], entryLevelLookbackBars)
float signalMid = (high + low) / 2.0
float noLevel = na

float sdReg = ta.linreg(close, sdLength, 0)
float sdStd = ta.stdev(close, sdLength)
float sdSignalMult = sdSignalBand == 1 ? sdMult1 : sdSignalBand == 2 ? sdMult2 : sdSignalBand == 3 ? sdMult3 : sdMult4
float sdFilterMult = sdFilterBand == 1 ? sdMult1 : sdFilterBand == 2 ? sdMult2 : sdFilterBand == 3 ? sdMult3 : sdMult4
float sdSignalUpper = sdReg + sdSignalMult * sdStd
float sdSignalLower = sdReg - sdSignalMult * sdStd
float sdFilterUpper = sdReg + sdFilterMult * sdStd
float sdFilterLower = sdReg - sdFilterMult * sdStd
bool sdLowerHit = confirmed and low <= sdSignalLower
bool sdUpperHit = confirmed and high >= sdSignalUpper
int sdZone = close > sdFilterUpper ? 1 : close < sdFilterLower ? -1 : 0
float sdSlope = ta.linreg(close, sdLength, 0) - ta.linreg(close, sdLength, 1)
int sdTrend = sdSlope > 0 ? 1 : sdSlope < 0 ? -1 : 0

float dtpAvg = ta.sma(close, dtpSmaLength)
float dtpAtr = ta.atr(dtpAtrLength)
float dtpMomentum = dtpAvg - dtpAvg[dtpMomentumLookback]
float dtpNorm = dtpAtr > 0.0 ? dtpMomentum / dtpAtr : 0.0
bool dtpBullTurn = ta.crossover(dtpNorm, dtpTrendThreshold)
bool dtpBearTurn = ta.crossunder(dtpNorm, -dtpTrendThreshold)
var int dtpDirState = 0
var int dtpStartBar = na
if confirmed
    if dtpDirState == 0
        if dtpNorm > dtpTrendThreshold and close > dtpAvg
            dtpDirState := 1
            dtpStartBar := bar_index
        else if dtpNorm < -dtpTrendThreshold and close < dtpAvg
            dtpDirState := -1
            dtpStartBar := bar_index
    if dtpBullTurn
        dtpDirState := 1
        dtpStartBar := bar_index
    if dtpBearTurn
        dtpDirState := -1
        dtpStartBar := bar_index
int dtpDir = dtpDirState
int dtpPhaseBars = na(dtpStartBar) ? 0 : bar_index - dtpStartBar + 1
bool dtpConfirmsSd = (dtpDir == 1 and sdTrend == 1) or (dtpDir == -1 and sdTrend == -1)
string dtpPhase = dtpDir == 0 ? "neutral" : dtpPhaseBars <= dtpEarlyBars ? "early" : dtpPhaseBars > dtpMatureBars and dtpConfirmsSd ? "mature" : dtpConfirmsSd ? "confirmed" : "weakening"

int mtfTf1EmaDir = enableMtf ? request.security(syminfo.tickerid, mtfConfirmTf1, mtfEmaDirValue(), barmerge.gaps_off, barmerge.lookahead_off) : 0
int mtfTf1DtpDir = enableMtf ? request.security(syminfo.tickerid, mtfConfirmTf1, mtfDtpDirValue(), barmerge.gaps_off, barmerge.lookahead_off) : 0
int mtfTf2EmaDir = enableMtf ? request.security(syminfo.tickerid, mtfConfirmTf2, mtfEmaDirValue(), barmerge.gaps_off, barmerge.lookahead_off) : 0
int mtfTf2DtpDir = enableMtf ? request.security(syminfo.tickerid, mtfConfirmTf2, mtfDtpDirValue(), barmerge.gaps_off, barmerge.lookahead_off) : 0
int mtfTf3EmaDir = enableMtf ? request.security(syminfo.tickerid, mtfConfirmTf3, mtfEmaDirValue(), barmerge.gaps_off, barmerge.lookahead_off) : 0
int mtfTf3DtpDir = enableMtf ? request.security(syminfo.tickerid, mtfConfirmTf3, mtfDtpDirValue(), barmerge.gaps_off, barmerge.lookahead_off) : 0
string mtfTf1LongState = mtfStateForDirection("long", mtfTf1EmaDir, mtfTf1DtpDir)
string mtfTf2LongState = mtfStateForDirection("long", mtfTf2EmaDir, mtfTf2DtpDir)
string mtfTf3LongState = mtfStateForDirection("long", mtfTf3EmaDir, mtfTf3DtpDir)
string mtfTf1ShortState = mtfStateForDirection("short", mtfTf1EmaDir, mtfTf1DtpDir)
string mtfTf2ShortState = mtfStateForDirection("short", mtfTf2EmaDir, mtfTf2DtpDir)
string mtfTf3ShortState = mtfStateForDirection("short", mtfTf3EmaDir, mtfTf3DtpDir)
float mtfLongScore = mtfScoreForStates(mtfTf1LongState, mtfTf2LongState, mtfTf3LongState)
float mtfShortScore = mtfScoreForStates(mtfTf1ShortState, mtfTf2ShortState, mtfTf3ShortState)
string mtfLongStatus = mtfStatusForStates(mtfTf1LongState, mtfTf2LongState, mtfTf3LongState)
string mtfShortStatus = mtfStatusForStates(mtfTf1ShortState, mtfTf2ShortState, mtfTf3ShortState)
string mtfLongBlockReason = mtfBlockReasonForStates(mtfTf1LongState, mtfTf2LongState)
string mtfShortBlockReason = mtfBlockReasonForStates(mtfTf1ShortState, mtfTf2ShortState)
bool mtfLongBlock = mtfLongStatus == "block"
bool mtfShortBlock = mtfShortStatus == "block"
bool dtpBullDominant = dtpDir == 1 and (dtpPhase == "early" or dtpPhase == "confirmed" or dtpPhase == "mature")
bool dtpBearDominant = dtpDir == -1 and (dtpPhase == "early" or dtpPhase == "confirmed" or dtpPhase == "mature")
bool dtpWeakeningOrNeutral = dtpPhase == "weakening" or dtpDir == 0

float atrVal = maFunc(ta.tr(true), atrLength) * atrMultiplier
float atrRaw = atrMultiplier != 0.0 ? atrVal / atrMultiplier : atrVal
float atrPct = close > 0.0 ? atrRaw / close * 100.0 : 0.0
float sdSlopeAtr = atrRaw > 0.0 ? math.abs(sdSlope) / atrRaw : 999999.0
bool lowVolatilityEntryBlocked = useVolatilityFilter and atrPct < minAtrPctForEntry

profitSpaceEntryNotional(float entryPrice, float qty) =>
    entryPrice > 0.0 and qty > 0.0 ? entryPrice * qty : 0.0

profitSpaceRoundTripCost(float qty) =>
    estimatedRoundTripFee + math.max(qty, 0.0) * estimatedSlippagePerSharePerSide * 2.0

profitSpaceGrossProfit(int direction, float entryPrice, float targetPrice, float qty) =>
    float profitPerShare = direction == 1 ? targetPrice - entryPrice : entryPrice - targetPrice
    profitPerShare * qty

profitSpaceNetRoiPct(float netProfit, float entryNotional) =>
    entryNotional > 0.0 ? netProfit / entryNotional * 100.0 : -9999.0

profitSpaceCostPct(float estimatedCost, float grossProfit) =>
    grossProfit > 0.0 ? estimatedCost / grossProfit * 100.0 : 9999.0

profitSpaceTargetAtrMultiple(float entryPrice, float targetPrice) =>
    atrRaw > 0.0 ? math.abs(targetPrice - entryPrice) / atrRaw : 0.0

profitSpaceFailureReason(float netProfit, float netRoiPct, float costPct, float targetAtrMultiple, float rewardRisk, bool structureStopAvailable, bool structureTargetAvailable, float minRewardRisk) =>
    not useProfitSpaceFilter ? "disabled" : not structureStopAvailable ? "structure_stop_unavailable" : not structureTargetAvailable ? "structure_target_unavailable" : netProfit < effectiveMinNetProfitForEntry ? "net_profit_below_min" : netRoiPct < effectiveMinNetRoiPctForEntry ? "net_roi_below_min" : costPct > maxCostPctOfReward ? "cost_pct_above_max" : na(rewardRisk) or rewardRisk < minRewardRisk ? "reward_risk_below_min" : targetAtrMultiple < minTargetAtrMultipleForEntry ? "target_atr_below_min" : "pass"

profitSpaceEntryAllowed(float netProfit, float netRoiPct, float costPct, float targetAtrMultiple, float rewardRisk, bool structureStopAvailable, bool structureTargetAvailable, float minRewardRisk) =>
    not useProfitSpaceFilter or profitSpaceFailureReason(netProfit, netRoiPct, costPct, targetAtrMultiple, rewardRisk, structureStopAvailable, structureTargetAvailable, minRewardRisk) == "pass"

profitSpaceSummaryText(float netProfit, float netRoiPct, float costPct, float targetAtrMultiple, float rewardRisk) =>
    "结构TP口径 预计净利 " + fmtSignedMoney(netProfit) + " / 占用ROI " + fmtSignedPct(netRoiPct) + " / 成本/毛利 " + str.tostring(costPct, "#.#") + "% / R " + str.tostring(rewardRisk, "#.##") + " / TP " + str.tostring(targetAtrMultiple, "#.#") + "ATR"

profitSpaceCheckpointText(bool runnerMode, float netProfit, float costPct, float targetAtrMultiple) =>
    runnerMode ? "\nRunner检查 净利 " + fmtSignedMoney(netProfit) + " / 成本/毛利 " + str.tostring(costPct, "#.#") + "% / 距离 " + str.tostring(targetAtrMultiple, "#.#") + "ATR" : ""

entryWindowDiagnosticsText() =>
    "窗口: " + entryWindowStage + " / " + ENTRY_WINDOW_MODEL

profitSpaceThresholdText(float minRewardRisk) =>
    "门槛 净利 >= " + fmtMoney(effectiveMinNetProfitForEntry) + " / 占用ROI >= " + str.tostring(effectiveMinNetRoiPctForEntry, "#.##") + "% / 成本/毛利 <= " + str.tostring(maxCostPctOfReward, "#.#") + "% / R >= " + str.tostring(minRewardRisk, "#.##") + " / TP >= " + str.tostring(minTargetAtrMultipleForEntry, "#.#") + "ATR"

profitSpaceNetProfitCompareText(float netProfit) =>
    string operatorText = netProfit >= effectiveMinNetProfitForEntry ? " >= " : " < "
    string gapText = netProfit < effectiveMinNetProfitForEntry ? "，差 " + fmtMoney(effectiveMinNetProfitForEntry - netProfit) : ""
    "净利 " + fmtSignedMoney(netProfit) + operatorText + fmtMoney(effectiveMinNetProfitForEntry) + gapText

profitSpaceNetRoiCompareText(float netRoiPct) =>
    string operatorText = netRoiPct >= effectiveMinNetRoiPctForEntry ? " >= " : " < "
    string gapText = netRoiPct < effectiveMinNetRoiPctForEntry ? "，差 " + str.tostring(effectiveMinNetRoiPctForEntry - netRoiPct, "#.##") + "%" : ""
    "占用ROI " + fmtSignedPct(netRoiPct) + operatorText + str.tostring(effectiveMinNetRoiPctForEntry, "#.##") + "%" + gapText

profitSpaceCostCompareText(float costPct) =>
    string operatorText = costPct <= maxCostPctOfReward ? " <= " : " > "
    string gapText = costPct > maxCostPctOfReward ? "，超 " + str.tostring(costPct - maxCostPctOfReward, "#.#") + "%" : ""
    "成本/毛利 " + str.tostring(costPct, "#.#") + "%" + operatorText + str.tostring(maxCostPctOfReward, "#.#") + "%" + gapText

profitSpaceRewardRiskCompareText(float rewardRisk, float minRewardRisk) =>
    string operatorText = rewardRisk >= minRewardRisk ? " >= " : " < "
    string gapText = rewardRisk < minRewardRisk ? "，差 " + str.tostring(minRewardRisk - rewardRisk, "#.##") + "R" : ""
    "结构R " + str.tostring(rewardRisk, "#.##") + operatorText + str.tostring(minRewardRisk, "#.##") + gapText

profitSpaceTargetAtrCompareText(float targetAtrMultiple) =>
    string operatorText = targetAtrMultiple >= minTargetAtrMultipleForEntry ? " >= " : " < "
    string gapText = targetAtrMultiple < minTargetAtrMultipleForEntry ? "，差 " + str.tostring(minTargetAtrMultipleForEntry - targetAtrMultiple, "#.#") + "ATR" : ""
    "TP " + str.tostring(targetAtrMultiple, "#.#") + "ATR" + operatorText + str.tostring(minTargetAtrMultipleForEntry, "#.#") + "ATR" + gapText

profitSpaceBlockedText(float netProfit, float netRoiPct, float costPct, float targetAtrMultiple, float rewardRisk, float minRewardRisk) =>
    "\n获利空间不足\n" + profitSpaceNetProfitCompareText(netProfit) + "\n" + profitSpaceNetRoiCompareText(netRoiPct) + "\n" + profitSpaceCostCompareText(costPct) + "\n" + profitSpaceRewardRiskCompareText(rewardRisk, minRewardRisk) + "\n" + profitSpaceTargetAtrCompareText(targetAtrMultiple) + "\n" + profitSpaceThresholdText(minRewardRisk)

profitSpaceBlockedStatusText(float netProfit, float netRoiPct, float costPct, float targetAtrMultiple, float rewardRisk, float minRewardRisk) =>
    "获利空间不足: " + profitSpaceNetProfitCompareText(netProfit) + " / " + profitSpaceNetRoiCompareText(netRoiPct) + " / " + profitSpaceCostCompareText(costPct) + " / " + profitSpaceRewardRiskCompareText(rewardRisk, minRewardRisk) + " / " + profitSpaceTargetAtrCompareText(targetAtrMultiple)

decisionDirectionTag(string direction) =>
    direction == "short" ? "空" : "多"

decisionSetupTag(string setup) =>
    setup == "trend_sdUpper" ? "SD↑顺势" : setup == "trend_sdLowerBreakout" ? "SD↓突破" : setup == "mr_sdLower" ? "SD↓回归" : setup == "trend_sdUpperBreakdown" ? "SD↑跌破" : setup == "trend_emaDeathContinuation" ? "EMA死叉" : setup == "mr_sdUpper" ? "SD↑回归" : setup == "trend_sdLower" ? "SD↓顺势" : setup

decisionRText(float rewardRisk) =>
    na(rewardRisk) ? "R--" : "R" + str.tostring(rewardRisk, "#.##")

decisionTargetAtrText(float targetAtrMultiple) =>
    na(targetAtrMultiple) or targetAtrMultiple <= 0.0 ? "TP--" : "TP" + str.tostring(targetAtrMultiple, "#.#") + "ATR"

decisionStopPctText(float entryPrice, float stopPrice) =>
    not na(entryPrice) and entryPrice > 0.0 and not na(stopPrice) and stopPrice > 0.0 ? "SL" + str.tostring(math.abs(entryPrice - stopPrice) / entryPrice * 100.0, "#.##") + "%" : "SL--"

decisionProfitMetricLine(float rewardRisk, float targetAtrMultiple) =>
    decisionRText(rewardRisk) + " " + decisionTargetAtrText(targetAtrMultiple)

decisionRiskLine(float entryPrice, float stopPrice, float targetPrice, float rewardRisk, float targetAtrMultiple) =>
    na(stopPrice) or stopPrice <= 0.0 ? "无结构SL" : na(targetPrice) or targetPrice <= 0.0 ? "无结构TP" : decisionProfitMetricLine(rewardRisk, targetAtrMultiple) + " " + decisionStopPctText(entryPrice, stopPrice)

profitFailureDisplayName(string profitFailureReason) =>
    profitFailureReason == "structure_stop_unavailable" ? "无结构SL" : profitFailureReason == "structure_target_unavailable" ? "无结构TP" : profitFailureReason == "net_profit_below_min" ? "净利不足" : profitFailureReason == "net_roi_below_min" ? "ROI不足" : profitFailureReason == "cost_pct_above_max" ? "成本过高" : profitFailureReason == "reward_risk_below_min" ? "R不足" : profitFailureReason == "target_atr_below_min" ? "TP太近" : ""

decisionBlockReason(string reason, string profitFailureReason) =>
    string profitReasonText = profitFailureDisplayName(profitFailureReason)
    bool profitIsPrimary = reason == "profit_space_too_small" or reason == "mr_target_space_too_small"
    profitIsPrimary and profitReasonText != "" and profitFailureReason != "pass" and profitFailureReason != "disabled" and profitFailureReason != "none" ? profitReasonText : filterDisplayName(reason)

decisionComponentLine(string progressText, string waitText) =>
    progressText + " " + waitText

decisionExitRText(float rValue) =>
    na(rValue) ? "" : " " + decisionRText(rValue)

int crsiCycleLen = math.max(1, int(math.round(crsiDomcycle / 2.0)))
int crsiMemory = math.max(2, crsiDomcycle * 2)
float crsiTorque = 2.0 / (crsiVibration + 1.0)
int crsiLag = math.max(0, int(math.round((crsiVibration - 1.0) / 2.0)))
float closeChange = ta.change(close)
float crsiUp = ta.rma(math.max(closeChange, 0.0), crsiCycleLen)
float crsiDown = ta.rma(-math.min(closeChange, 0.0), crsiCycleLen)
float crsiRaw = crsiDown == 0.0 ? 100.0 : crsiUp == 0.0 ? 0.0 : 100.0 - 100.0 / (1.0 + crsiUp / crsiDown)
var float crsi = na
crsi := crsiTorque * (2.0 * crsiRaw - nz(crsiRaw[crsiLag], crsiRaw)) + (1.0 - crsiTorque) * nz(crsi[1], crsiRaw)
float crsiUpperBand = ta.percentile_linear_interpolation(crsi, crsiMemory, 100.0 - crsiLeveling)
float crsiLowerBand = ta.percentile_linear_interpolation(crsi, crsiMemory, crsiLeveling)
bool crsiOB = crsi > crsiUpperBand
bool crsiOS = crsi < crsiLowerBand

float obvFlow = closeChange > 0.0 ? volume : closeChange < 0.0 ? -volume : 0.0
float obv = ta.cum(obvFlow)
float obvOsc = ta.rsi(obv, obvRsiLen)

// -----------------------------------------------------------------------------
// Divergence detection using confirmed price pivots.
// -----------------------------------------------------------------------------
bool includeRegularDiv = divType == "regular" or divType == "both"
bool includeHiddenDiv = divType == "hidden" or divType == "both"

var float prevHighPriceCrsi = na
var float prevHighOscCrsi = na
var int prevHighBarCrsi = na
var float prevLowPriceCrsi = na
var float prevLowOscCrsi = na
var int prevLowBarCrsi = na
var float prevHighPriceObv = na
var float prevHighOscObv = na
var int prevHighBarObv = na
var float prevLowPriceObv = na
var float prevLowOscObv = na
var int prevLowBarObv = na

bool crsiRegBearDiv = false
bool crsiRegBullDiv = false
bool crsiHidBearDiv = false
bool crsiHidBullDiv = false
bool obvRegBearDiv = false
bool obvRegBullDiv = false
bool obvHidBearDiv = false
bool obvHidBullDiv = false

float divPivotHigh = ta.pivothigh(high, divLookback, divLookback)
float divPivotLow = ta.pivotlow(low, divLookback, divLookback)

if confirmed and not na(divPivotHigh)
    int currentPivotBar = bar_index - divLookback
    float currentCrsiHigh = crsi[divLookback]
    if not na(prevHighPriceCrsi) and not na(prevHighBarCrsi)
        int barDistance = currentPivotBar - prevHighBarCrsi
        if barDistance > 0 and barDistance <= divMaxBars
            crsiRegBearDiv := includeRegularDiv and divPivotHigh > prevHighPriceCrsi and currentCrsiHigh < prevHighOscCrsi
            crsiHidBearDiv := includeHiddenDiv and divPivotHigh < prevHighPriceCrsi and currentCrsiHigh > prevHighOscCrsi
    prevHighPriceCrsi := divPivotHigh
    prevHighOscCrsi := currentCrsiHigh
    prevHighBarCrsi := currentPivotBar

if confirmed and not na(divPivotLow)
    int currentPivotBar = bar_index - divLookback
    float currentCrsiLow = crsi[divLookback]
    if not na(prevLowPriceCrsi) and not na(prevLowBarCrsi)
        int barDistance = currentPivotBar - prevLowBarCrsi
        if barDistance > 0 and barDistance <= divMaxBars
            crsiRegBullDiv := includeRegularDiv and divPivotLow < prevLowPriceCrsi and currentCrsiLow > prevLowOscCrsi
            crsiHidBullDiv := includeHiddenDiv and divPivotLow > prevLowPriceCrsi and currentCrsiLow < prevLowOscCrsi
    prevLowPriceCrsi := divPivotLow
    prevLowOscCrsi := currentCrsiLow
    prevLowBarCrsi := currentPivotBar

if confirmed and not na(divPivotHigh)
    int currentPivotBar = bar_index - divLookback
    float currentObvHigh = obvOsc[divLookback]
    if not na(prevHighPriceObv) and not na(prevHighBarObv)
        int barDistance = currentPivotBar - prevHighBarObv
        if barDistance > 0 and barDistance <= divMaxBars
            obvRegBearDiv := includeRegularDiv and divPivotHigh > prevHighPriceObv and currentObvHigh < prevHighOscObv
            obvHidBearDiv := includeHiddenDiv and divPivotHigh < prevHighPriceObv and currentObvHigh > prevHighOscObv
    prevHighPriceObv := divPivotHigh
    prevHighOscObv := currentObvHigh
    prevHighBarObv := currentPivotBar

if confirmed and not na(divPivotLow)
    int currentPivotBar = bar_index - divLookback
    float currentObvLow = obvOsc[divLookback]
    if not na(prevLowPriceObv) and not na(prevLowBarObv)
        int barDistance = currentPivotBar - prevLowBarObv
        if barDistance > 0 and barDistance <= divMaxBars
            obvRegBullDiv := includeRegularDiv and divPivotLow < prevLowPriceObv and currentObvLow > prevLowOscObv
            obvHidBullDiv := includeHiddenDiv and divPivotLow > prevLowPriceObv and currentObvLow < prevLowOscObv
    prevLowPriceObv := divPivotLow
    prevLowOscObv := currentObvLow
    prevLowBarObv := currentPivotBar

bool crsiBullDiv = crsiRegBullDiv or crsiHidBullDiv
bool crsiBearDiv = crsiRegBearDiv or crsiHidBearDiv
bool obvBullDiv = obvRegBullDiv or obvHidBullDiv
bool obvBearDiv = obvRegBearDiv or obvHidBearDiv
bool bullDivNow = crsiBullDiv or obvBullDiv
bool bearDivNow = crsiBearDiv or obvBearDiv
string bullDivSourceNow = ""
bullDivSourceNow := crsiBullDiv ? appendSource(bullDivSourceNow, "cRSI") : bullDivSourceNow
bullDivSourceNow := obvBullDiv ? appendSource(bullDivSourceNow, "OBV") : bullDivSourceNow
string bearDivSourceNow = ""
bearDivSourceNow := crsiBearDiv ? appendSource(bearDivSourceNow, "cRSI") : bearDivSourceNow
bearDivSourceNow := obvBearDiv ? appendSource(bearDivSourceNow, "OBV") : bearDivSourceNow

// -----------------------------------------------------------------------------
// MR windows and component collection.
// -----------------------------------------------------------------------------
var bool lowerWindowActive = false
var bool upperWindowActive = false
var bool lowerWindowUsed = false
var bool upperWindowUsed = false
var bool lowerWindowMeanExpired = false
var bool upperWindowMeanExpired = false
var int lowerWindowStart = na
var int upperWindowStart = na
var int lowerWindowStartTime = na
var int upperWindowStartTime = na
var int upperSdExtremeBar = na
var int lowerSdExtremeBar = na
var int upperSdExtremeTime = na
var int lowerSdExtremeTime = na
var float upperSdExtremePrice = na
var float lowerSdExtremePrice = na
var bool upperPostReversalUsed = false
var bool lowerPostReversalUsed = false

var bool upperBullTouchSeen = false
var string upperBullTouchLine = ""
var int upperBullTouchBar = na
var bool upperBullContinuationSeen = false
var string upperBullContinuationLine = ""
var int upperBullContinuationBar = na
var bool upperBullFractalSeen = false
var int upperBullFractalBar = na
var bool upperBearFractalSeen = false
var int upperBearFractalBar = na
var bool upperBullEmaCrossSeen = false
var int upperBullEmaCrossBar = na
var bool upperBearEmaCrossSeen = false
var int upperBearEmaCrossBar = na
var bool lowerBullFractalSeen = false
var int lowerBullFractalBar = na
var bool lowerBullEmaCrossSeen = false
var int lowerBullEmaCrossBar = na
var bool lowerBearTouchSeen = false
var string lowerBearTouchLine = ""
var int lowerBearTouchBar = na
var bool lowerBearPullbackSeen = false
var string lowerBearPullbackLine = ""
var int lowerBearPullbackBar = na
var bool lowerBearContinuationSeen = false
var string lowerBearContinuationLine = ""
var int lowerBearContinuationBar = na
var bool lowerBearFractalSeen = false
var int lowerBearFractalBar = na
var bool lowerBearEmaCrossSeen = false
var int lowerBearEmaCrossBar = na
var bool trendBullFractalSeen = false
var int trendBullFractalBar = na
var bool trendBullEmaCrossSeen = false
var int trendBullEmaCrossBar = na
var bool trendBearFractalSeen = false
var int trendBearFractalBar = na
var bool trendBearEmaCrossSeen = false
var int trendBearEmaCrossBar = na
var bool emaDeathContinuationShortUsed = false
var int trendLongSupportTouchStart = na
var float trendLongSupportRangeHigh = na
var float trendLongSupportRangeLow = na
var int trendShortResistanceTouchStart = na
var float trendShortResistanceRangeHigh = na
var float trendShortResistanceRangeLow = na

var bool bullDivSeen = false
var string bullDivSource = ""
var int bullDivBar = na
var bool bearDivSeen = false
var string bearDivSource = ""
var int bearDivBar = na

if isNewTradingDay
    lowerWindowActive := false
    upperWindowActive := false
    lowerWindowUsed := false
    upperWindowUsed := false
    lowerWindowMeanExpired := false
    upperWindowMeanExpired := false
    lowerWindowStart := na
    upperWindowStart := na
    lowerWindowStartTime := na
    upperWindowStartTime := na
    upperSdExtremeBar := na
    lowerSdExtremeBar := na
    upperSdExtremeTime := na
    lowerSdExtremeTime := na
    upperSdExtremePrice := na
    lowerSdExtremePrice := na
    upperPostReversalUsed := false
    lowerPostReversalUsed := false
    upperBullTouchSeen := false
    upperBullTouchLine := ""
    upperBullTouchBar := na
    upperBullContinuationSeen := false
    upperBullContinuationLine := ""
    upperBullContinuationBar := na
    upperBullFractalSeen := false
    upperBullFractalBar := na
    upperBearFractalSeen := false
    upperBearFractalBar := na
    upperBullEmaCrossSeen := false
    upperBullEmaCrossBar := na
    upperBearEmaCrossSeen := false
    upperBearEmaCrossBar := na
    lowerBullFractalSeen := false
    lowerBullFractalBar := na
    lowerBullEmaCrossSeen := false
    lowerBullEmaCrossBar := na
    lowerBearTouchSeen := false
    lowerBearTouchLine := ""
    lowerBearTouchBar := na
    lowerBearPullbackSeen := false
    lowerBearPullbackLine := ""
    lowerBearPullbackBar := na
    lowerBearContinuationSeen := false
    lowerBearContinuationLine := ""
    lowerBearContinuationBar := na
    lowerBearFractalSeen := false
    lowerBearFractalBar := na
    lowerBearEmaCrossSeen := false
    lowerBearEmaCrossBar := na
    trendBullFractalSeen := false
    trendBullFractalBar := na
    trendBullEmaCrossSeen := false
    trendBullEmaCrossBar := na
    trendBearFractalSeen := false
    trendBearFractalBar := na
    trendBearEmaCrossSeen := false
    trendBearEmaCrossBar := na
    emaDeathContinuationShortUsed := false
    trendLongSupportTouchStart := na
    trendLongSupportRangeHigh := na
    trendLongSupportRangeLow := na
    trendShortResistanceTouchStart := na
    trendShortResistanceRangeHigh := na
    trendShortResistanceRangeLow := na
    bullDivSeen := false
    bullDivSource := ""
    bullDivBar := na
    bearDivSeen := false
    bearDivSource := ""
    bearDivBar := na

if canOpenEntry and sdUpperHit
    upperSdExtremeBar := bar_index
    upperSdExtremeTime := time
    upperSdExtremePrice := high
    upperPostReversalUsed := false
if canOpenEntry and sdLowerHit
    lowerSdExtremeBar := bar_index
    lowerSdExtremeTime := time
    lowerSdExtremePrice := low
    lowerPostReversalUsed := false

int mrWindowMaxMs = mrWindowMaxMinutes * 60000
int postSdReversalMaxMs = postSdReversalMaxMinutes * 60000
bool lowerWindowBarExpired = lowerWindowActive and not na(lowerWindowStart) and bar_index - lowerWindowStart > mrWindowBars
bool upperWindowBarExpired = upperWindowActive and not na(upperWindowStart) and bar_index - upperWindowStart > mrWindowBars
bool lowerWindowTimeExpired = lowerWindowActive and not na(lowerWindowStartTime) and time - lowerWindowStartTime > mrWindowMaxMs
bool upperWindowTimeExpired = upperWindowActive and not na(upperWindowStartTime) and time - upperWindowStartTime > mrWindowMaxMs
bool upperSdExtremeFresh = not na(upperSdExtremeBar) and not na(upperSdExtremeTime) and bar_index - upperSdExtremeBar <= postSdReversalBars and time - upperSdExtremeTime <= postSdReversalMaxMs
bool lowerSdExtremeFresh = not na(lowerSdExtremeBar) and not na(lowerSdExtremeTime) and bar_index - lowerSdExtremeBar <= postSdReversalBars and time - lowerSdExtremeTime <= postSdReversalMaxMs
bool lowerWindowMeanTouched = lowerWindowActive and mrExpireOnMeanTouch and not na(lowerWindowStart) and bar_index > lowerWindowStart and (high >= sdReg or high >= emaFast or high >= emaSlow)
bool upperWindowMeanTouched = upperWindowActive and mrExpireOnMeanTouch and not na(upperWindowStart) and bar_index > upperWindowStart and (low <= sdReg or low <= emaFast or low <= emaSlow)
bool lowerWindowHardExpired = lowerWindowBarExpired or lowerWindowTimeExpired
bool upperWindowHardExpired = upperWindowBarExpired or upperWindowTimeExpired
bool lowerWindowExpired = lowerWindowHardExpired or lowerWindowMeanExpired or lowerWindowMeanTouched
bool upperWindowExpired = upperWindowHardExpired or upperWindowMeanExpired or upperWindowMeanTouched

bool lowerActivationEvent = canOpenEntry and sdLowerHit and (not lowerWindowActive or lowerWindowUsed or lowerWindowExpired or na(lowerWindowStart))
bool upperActivationEvent = canOpenEntry and sdUpperHit and (not upperWindowActive or upperWindowUsed or upperWindowExpired or na(upperWindowStart))

if lowerActivationEvent
    lowerWindowActive := true
    upperWindowActive := false
    lowerWindowUsed := false
    lowerWindowMeanExpired := false
    lowerWindowStart := bar_index
    lowerWindowStartTime := time
    lowerBullFractalSeen := false
    lowerBullFractalBar := na
    lowerBullEmaCrossSeen := false
    lowerBullEmaCrossBar := na
    lowerBearTouchSeen := false
    lowerBearTouchLine := ""
    lowerBearTouchBar := na
    lowerBearPullbackSeen := false
    lowerBearPullbackLine := ""
    lowerBearPullbackBar := na
    lowerBearContinuationSeen := false
    lowerBearContinuationLine := ""
    lowerBearContinuationBar := na
    lowerBearFractalSeen := false
    lowerBearFractalBar := na
    lowerBearEmaCrossSeen := false
    lowerBearEmaCrossBar := na

if upperActivationEvent
    upperWindowActive := true
    lowerWindowActive := false
    upperWindowUsed := false
    upperWindowMeanExpired := false
    upperWindowStart := bar_index
    upperWindowStartTime := time
    upperBullTouchSeen := false
    upperBullTouchLine := ""
    upperBullTouchBar := na
    upperBullContinuationSeen := false
    upperBullContinuationLine := ""
    upperBullContinuationBar := na
    upperBullFractalSeen := false
    upperBullFractalBar := na
    upperBearFractalSeen := false
    upperBearFractalBar := na
    upperBullEmaCrossSeen := false
    upperBullEmaCrossBar := na
    upperBearEmaCrossSeen := false
    upperBearEmaCrossBar := na

if lowerWindowHardExpired and not lowerActivationEvent
    lowerWindowActive := false
if upperWindowHardExpired and not upperActivationEvent
    upperWindowActive := false

bool lowerWindowValid = lowerWindowActive and not lowerWindowUsed and not na(lowerWindowStart) and not lowerWindowHardExpired and bar_index > lowerWindowStart and bar_index - lowerWindowStart <= mrWindowBars
bool upperWindowValid = upperWindowActive and not upperWindowUsed and not na(upperWindowStart) and not upperWindowHardExpired and bar_index > upperWindowStart and bar_index - upperWindowStart <= mrWindowBars
bool lowerMrWindowValid = lowerWindowValid and not lowerWindowMeanExpired and not lowerWindowMeanTouched
bool upperMrWindowValid = upperWindowValid and not upperWindowMeanExpired and not upperWindowMeanTouched
bool bullTrendContinuationContext = dtpBullDominant and emaFast >= emaSlow and close >= emaSlow and close >= sdReg and not mtfLongBlock
bool bearTrendContinuationContext = dtpBearDominant and emaFast <= emaSlow and close <= emaSlow and close <= sdReg and not mtfShortBlock
bool bearishReversalContext = dtpWeakeningOrNeutral or dtpBearDominant or (close < emaSlow and (emaFast < emaSlow or close < sdReg or mtfLongBlock))

string upperBullPullbackLineNow = ""
upperBullPullbackLineNow := pullbackNearSupport(low, close, emaFast, atrRaw) ? appendSource(upperBullPullbackLineNow, "pullback_ema20") : upperBullPullbackLineNow
upperBullPullbackLineNow := pullbackNearSupport(low, close, emaSlow, atrRaw) ? appendSource(upperBullPullbackLineNow, "pullback_ema50") : upperBullPullbackLineNow
upperBullPullbackLineNow := pullbackNearSupport(low, close, recentLow, atrRaw) ? appendSource(upperBullPullbackLineNow, "pullback_recent_low") : upperBullPullbackLineNow
upperBullPullbackLineNow := pullbackNearSupport(low, close, lastPivotLow, atrRaw) ? appendSource(upperBullPullbackLineNow, "pullback_pivot_low") : upperBullPullbackLineNow
upperBullPullbackLineNow := pullbackNearSupport(low, close, sdReg, atrRaw) ? appendSource(upperBullPullbackLineNow, "pullback_sd_mid") : upperBullPullbackLineNow
bool trendLongSupportTouchNow = confirmed and bullTrendContinuationContext and upperBullPullbackLineNow != ""
if not bullTrendContinuationContext
    trendLongSupportTouchStart := na
    trendLongSupportRangeHigh := na
    trendLongSupportRangeLow := na
else if trendLongSupportTouchNow
    trendLongSupportTouchStart := na(trendLongSupportTouchStart) ? bar_index : trendLongSupportTouchStart
    trendLongSupportRangeHigh := na(trendLongSupportRangeHigh) ? high : math.max(trendLongSupportRangeHigh, high)
    trendLongSupportRangeLow := na(trendLongSupportRangeLow) ? low : math.min(trendLongSupportRangeLow, low)
int trendLongSupportTouchBars = na(trendLongSupportTouchStart) ? 0 : bar_index - trendLongSupportTouchStart + 1
bool trendLongRangeBreakoutNow = confirmed and bullTrendContinuationContext and not na(trendLongSupportRangeHigh) and close > trendLongSupportRangeHigh + atrRaw * trendBreakBufferAtr
bool trendLongSupportLingerWait = bullTrendContinuationContext and not na(trendLongSupportTouchStart) and trendLongSupportTouchBars >= trendLingerBars and not trendLongRangeBreakoutNow
bool trendLongQuickRejectNow = trendLongSupportTouchNow and trendLongSupportTouchBars <= trendQuickRejectBars and close > open
bool trendLongSdContinuationNow = bullTrendContinuationContext and (high >= sdSignalUpper or close >= sdSignalUpper - atrRaw * trendReactionZoneAtr)
string upperBullContinuationLineNow = trendLongRangeBreakoutNow ? "break_support_range_high" : trendLongQuickRejectNow ? upperBullPullbackLineNow : trendLongSdContinuationNow ? "sd_upper_continuation" : ""
bool upperBullContinuationNow = confirmed and bullTrendContinuationContext and not trendLongSupportLingerWait and upperBullContinuationLineNow != ""
bool longTrendContextReady = (upperWindowValid or bullTrendContinuationContext) and not trendLongSupportLingerWait

string lowerBearPullbackLineNow = ""
lowerBearPullbackLineNow := pullbackNearResistance(high, close, emaFast, atrRaw) ? appendSource(lowerBearPullbackLineNow, "pullback_ema20") : lowerBearPullbackLineNow
lowerBearPullbackLineNow := pullbackNearResistance(high, close, emaSlow, atrRaw) ? appendSource(lowerBearPullbackLineNow, "pullback_ema50") : lowerBearPullbackLineNow
lowerBearPullbackLineNow := pullbackNearResistance(high, close, recentHigh, atrRaw) ? appendSource(lowerBearPullbackLineNow, "pullback_recent_high") : lowerBearPullbackLineNow
lowerBearPullbackLineNow := pullbackNearResistance(high, close, lastPivotHigh, atrRaw) ? appendSource(lowerBearPullbackLineNow, "pullback_pivot_high") : lowerBearPullbackLineNow
lowerBearPullbackLineNow := pullbackNearResistance(high, close, sdReg, atrRaw) ? appendSource(lowerBearPullbackLineNow, "pullback_sd_mid") : lowerBearPullbackLineNow
bool trendShortResistanceTouchNow = confirmed and bearTrendContinuationContext and lowerBearPullbackLineNow != ""
if not bearTrendContinuationContext
    trendShortResistanceTouchStart := na
    trendShortResistanceRangeHigh := na
    trendShortResistanceRangeLow := na
else if trendShortResistanceTouchNow
    trendShortResistanceTouchStart := na(trendShortResistanceTouchStart) ? bar_index : trendShortResistanceTouchStart
    trendShortResistanceRangeHigh := na(trendShortResistanceRangeHigh) ? high : math.max(trendShortResistanceRangeHigh, high)
    trendShortResistanceRangeLow := na(trendShortResistanceRangeLow) ? low : math.min(trendShortResistanceRangeLow, low)
int trendShortResistanceTouchBars = na(trendShortResistanceTouchStart) ? 0 : bar_index - trendShortResistanceTouchStart + 1
bool trendShortRangeBreakdownNow = confirmed and bearTrendContinuationContext and not na(trendShortResistanceRangeLow) and close < trendShortResistanceRangeLow - atrRaw * trendBreakBufferAtr
bool trendShortResistanceLingerWait = bearTrendContinuationContext and not na(trendShortResistanceTouchStart) and trendShortResistanceTouchBars >= trendLingerBars and not trendShortRangeBreakdownNow
bool trendShortQuickRejectNow = trendShortResistanceTouchNow and trendShortResistanceTouchBars <= trendQuickRejectBars and close < open
bool trendShortSdContinuationNow = bearTrendContinuationContext and (low <= sdSignalLower or close <= sdSignalLower + atrRaw * trendReactionZoneAtr)
string lowerBearContinuationLineNow = trendShortRangeBreakdownNow ? "break_resistance_range_low" : trendShortQuickRejectNow ? lowerBearPullbackLineNow : trendShortSdContinuationNow ? "sd_lower_continuation" : ""
bool lowerBearContinuationNow = confirmed and bearTrendContinuationContext and not trendShortResistanceLingerWait and lowerBearContinuationLineNow != ""
bool shortTrendContextReady = (lowerWindowValid or bearTrendContinuationContext) and not trendShortResistanceLingerWait
bool lowerBearPullbackNow = confirmed and (lowerWindowValid or bearTrendContinuationContext) and lowerBearPullbackLineNow != ""

if bullTrendContinuationContext and emaBullTouch
    upperBullTouchSeen := true
    upperBullTouchLine := bullTouchLine
    upperBullTouchBar := bar_index
if bearTrendContinuationContext and emaBearTouch
    lowerBearTouchSeen := true
    lowerBearTouchLine := bearTouchLine
    lowerBearTouchBar := bar_index
if upperBullContinuationNow
    upperBullContinuationSeen := true
    upperBullContinuationLine := upperBullContinuationLineNow
    upperBullContinuationBar := bar_index
if lowerBearContinuationNow
    lowerBearContinuationSeen := true
    lowerBearContinuationLine := lowerBearContinuationLineNow
    lowerBearContinuationBar := bar_index

if lowerWindowActive and not lowerWindowUsed
    if fractalBull
        lowerBullFractalSeen := true
        lowerBullFractalBar := bar_index
    if emaGoldenCross
        lowerBullEmaCrossSeen := true
        lowerBullEmaCrossBar := bar_index
    if emaBearTouch
        lowerBearTouchSeen := true
        lowerBearTouchLine := bearTouchLine
        lowerBearTouchBar := bar_index
    if lowerBearPullbackNow
        lowerBearPullbackSeen := true
        lowerBearPullbackLine := lowerBearPullbackLineNow
        lowerBearPullbackBar := bar_index
    if fractalBear
        lowerBearFractalSeen := true
        lowerBearFractalBar := bar_index
    if emaDeathCross
        lowerBearEmaCrossSeen := true
        lowerBearEmaCrossBar := bar_index

if upperWindowActive and not upperWindowUsed
    if emaBullTouch
        upperBullTouchSeen := true
        upperBullTouchLine := bullTouchLine
        upperBullTouchBar := bar_index
    if upperBullContinuationNow
        upperBullContinuationSeen := true
        upperBullContinuationLine := upperBullContinuationLineNow
        upperBullContinuationBar := bar_index
    if fractalBull
        upperBullFractalSeen := true
        upperBullFractalBar := bar_index
    if fractalBear
        upperBearFractalSeen := true
        upperBearFractalBar := bar_index
    if emaGoldenCross
        upperBullEmaCrossSeen := true
        upperBullEmaCrossBar := bar_index
    if emaDeathCross
        upperBearEmaCrossSeen := true
        upperBearEmaCrossBar := bar_index

if fractalBull
    trendBullFractalSeen := true
    trendBullFractalBar := bar_index
if emaGoldenCross
    trendBullEmaCrossSeen := true
    trendBullEmaCrossBar := bar_index
if fractalBear
    trendBearFractalSeen := true
    trendBearFractalBar := bar_index
if emaDeathCross
    trendBearEmaCrossSeen := true
    trendBearEmaCrossBar := bar_index
    emaDeathContinuationShortUsed := false

if lowerWindowMeanTouched and not lowerActivationEvent
    lowerWindowMeanExpired := true
if upperWindowMeanTouched and not upperActivationEvent
    upperWindowMeanExpired := true

if bullDivNow
    bullDivSeen := true
    bullDivSource := bullDivSourceNow
    bullDivBar := bar_index
if bearDivNow
    bearDivSeen := true
    bearDivSource := bearDivSourceNow
    bearDivBar := bar_index
if bullDivSeen and not na(bullDivBar) and bar_index - bullDivBar > divMaxBars
    bullDivSeen := false
    bullDivSource := ""
    bullDivBar := na
if bearDivSeen and not na(bearDivBar) and bar_index - bearDivBar > divMaxBars
    bearDivSeen := false
    bearDivSource := ""
    bearDivBar := na

bool upperBullTouchFresh = upperBullTouchSeen and componentFresh(upperBullTouchBar)
bool upperBullContinuationFresh = upperBullContinuationSeen and componentFresh(upperBullContinuationBar)
bool lowerBearTouchFresh = lowerBearTouchSeen and componentFresh(lowerBearTouchBar)
bool lowerBearContinuationFresh = lowerBearContinuationSeen and componentFresh(lowerBearContinuationBar)
bool upperBullFractalFresh = upperBullFractalSeen and componentFresh(upperBullFractalBar)
bool lowerBullFractalFresh = lowerBullFractalSeen and componentFresh(lowerBullFractalBar)
bool upperBearFractalFresh = upperBearFractalSeen and componentFresh(upperBearFractalBar)
bool lowerBearFractalFresh = lowerBearFractalSeen and componentFresh(lowerBearFractalBar)
bool trendBullFractalFresh = trendBullFractalSeen and componentFresh(trendBullFractalBar)
bool trendBearFractalFresh = trendBearFractalSeen and componentFresh(trendBearFractalBar)
bool upperBullEmaCrossFresh = upperBullEmaCrossSeen and componentFresh(upperBullEmaCrossBar)
bool lowerBullEmaCrossFresh = lowerBullEmaCrossSeen and componentFresh(lowerBullEmaCrossBar)
bool upperBearEmaCrossFresh = upperBearEmaCrossSeen and componentFresh(upperBearEmaCrossBar)
bool lowerBearEmaCrossFresh = lowerBearEmaCrossSeen and componentFresh(lowerBearEmaCrossBar)
bool trendBullEmaCrossFresh = trendBullEmaCrossSeen and componentFresh(trendBullEmaCrossBar)
bool trendBearEmaCrossFresh = trendBearEmaCrossSeen and componentFresh(trendBearEmaCrossBar)
bool bullDivFresh = bullDivSeen and componentFresh(bullDivBar)
bool bearDivFresh = bearDivSeen and componentFresh(bearDivBar)
bool lowerBearPullbackFresh = lowerBearPullbackSeen and componentFresh(lowerBearPullbackBar)
bool upperBullTrendTriggerFresh = upperBullTouchFresh or upperBullContinuationFresh
bool upperBullTrendTriggerSeen = upperBullTouchSeen or upperBullContinuationSeen
string upperBullTrendTriggerLine = upperBullContinuationFresh ? upperBullContinuationLine : upperBullTouchFresh ? upperBullTouchLine : upperBullContinuationSeen ? upperBullContinuationLine : upperBullTouchLine
upperBullTrendTriggerLine := upperBullTrendTriggerLine == "" ? "none" : upperBullTrendTriggerLine
bool lowerBearTrendTriggerFresh = lowerBearTouchFresh or lowerBearPullbackFresh or lowerBearContinuationFresh
bool lowerBearTrendTriggerSeen = lowerBearTouchSeen or lowerBearPullbackSeen or lowerBearContinuationSeen
string lowerBearTrendTriggerLine = lowerBearContinuationFresh ? lowerBearContinuationLine : lowerBearPullbackFresh ? lowerBearPullbackLine : lowerBearTouchFresh ? lowerBearTouchLine : lowerBearContinuationSeen ? lowerBearContinuationLine : lowerBearPullbackSeen ? lowerBearPullbackLine : lowerBearTouchLine
lowerBearTrendTriggerLine := lowerBearTrendTriggerLine == "" ? "none" : lowerBearTrendTriggerLine

// -----------------------------------------------------------------------------
// Setup assembly and filters.
// -----------------------------------------------------------------------------
int longTrendUpperDirectionComponents = directionComponentCount(trendBullFractalFresh, bullDivFresh, trendBullEmaCrossFresh)
int longMrLowerRawDirectionComponents = directionComponentCount(lowerBullFractalSeen, bullDivSeen, lowerBullEmaCrossSeen)
int longMrLowerDirectionComponents = directionComponentCount(lowerBullFractalFresh, bullDivFresh, lowerBullEmaCrossFresh)
int longPostLowerBreakoutDirectionComponents = directionComponentCount(lowerBullFractalFresh, bullDivFresh, lowerBullEmaCrossFresh)
int shortMrUpperRawDirectionComponents = directionComponentCount(upperBearFractalSeen, bearDivSeen, upperBearEmaCrossSeen)
int shortMrUpperDirectionComponents = directionComponentCount(upperBearFractalFresh, bearDivFresh, upperBearEmaCrossFresh)
int shortPostUpperBreakdownDirectionComponents = directionComponentCount(upperBearFractalFresh, bearDivFresh, upperBearEmaCrossFresh)
int shortTrendLowerDirectionComponents = directionComponentCount(trendBearFractalFresh, bearDivFresh, trendBearEmaCrossFresh)
int shortEmaDeathContinuationDirectionComponents = directionComponentCount(trendBearFractalFresh, bearDivFresh, trendBearEmaCrossFresh)
bool longTrendUpperStructureOk = emaFast >= emaSlow and close >= sdReg and close >= emaSlow
bool shortTrendLowerStructureOk = emaFast <= emaSlow and close <= sdReg and close <= emaSlow
bool shortEmaDeathContinuationStructureOk = emaFast < emaSlow and close < emaSlow and close < sdReg
bool setupLongTrendUpper = longTrendContextReady and upperBullTrendTriggerFresh and longTrendUpperDirectionComponents >= 2 and longTrendUpperStructureOk
bool setupLongMrLower = lowerMrWindowValid and longMrLowerDirectionComponents >= 2
bool setupLongPostLowerBreakout = lowerSdExtremeFresh and not lowerPostReversalUsed and emaFast > emaSlow and close > emaSlow and lowerBullEmaCrossFresh and (lowerBullFractalFresh or bullDivFresh) and longPostLowerBreakoutDirectionComponents >= 2
bool setupShortMrUpper = upperMrWindowValid and shortMrUpperDirectionComponents >= 2 and (not dtpBullDominant or bearishReversalContext)
bool setupShortPostUpperBreakdown = upperSdExtremeFresh and not upperPostReversalUsed and emaFast < emaSlow and close < emaSlow and upperBearEmaCrossFresh and (upperBearFractalFresh or bearDivFresh) and shortPostUpperBreakdownDirectionComponents >= 2
bool setupShortEmaDeathContinuation = not emaDeathContinuationShortUsed and not setupShortPostUpperBreakdown and shortEmaDeathContinuationStructureOk and (not dtpBullDominant or bearishReversalContext) and trendBearEmaCrossFresh and (trendBearFractalFresh or bearDivFresh) and shortEmaDeathContinuationDirectionComponents >= 2
bool setupShortTrendLowerTouch = shortTrendContextReady and lowerBearTouchFresh and shortTrendLowerDirectionComponents >= 2 and shortTrendLowerStructureOk
bool setupShortTrendLowerPullback = shortTrendContextReady and lowerBearPullbackFresh and shortTrendLowerDirectionComponents >= 2 and shortTrendLowerStructureOk
bool setupShortTrendLowerContinuation = bearTrendContinuationContext and not trendShortResistanceLingerWait and lowerBearContinuationFresh and shortTrendLowerDirectionComponents >= 2 and shortTrendLowerStructureOk
bool setupShortTrendLower = setupShortTrendLowerTouch or setupShortTrendLowerPullback or setupShortTrendLowerContinuation
bool longMrLowerComponentStale = lowerMrWindowValid and longMrLowerRawDirectionComponents >= 2 and longMrLowerDirectionComponents < 2
bool shortMrUpperComponentStale = upperMrWindowValid and shortMrUpperRawDirectionComponents >= 2 and shortMrUpperDirectionComponents < 2

bool longSignalCandidate = setupLongPostLowerBreakout or setupLongTrendUpper or setupLongMrLower
bool shortSignalCandidate = setupShortPostUpperBreakdown or setupShortEmaDeathContinuation or setupShortMrUpper or setupShortTrendLower
bool longStaleCandidate = longMrLowerComponentStale
bool shortStaleCandidate = shortMrUpperComponentStale
bool longRaw = allowLong and (longSignalCandidate or longStaleCandidate)
bool shortRaw = allowShort and (shortSignalCandidate or shortStaleCandidate)
string longSetup = setupLongPostLowerBreakout ? "trend_sdLowerBreakout" : setupLongTrendUpper ? "trend_sdUpper" : setupLongMrLower or longStaleCandidate ? "mr_sdLower" : "none"
string shortSetup = setupShortPostUpperBreakdown ? "trend_sdUpperBreakdown" : setupShortEmaDeathContinuation ? "trend_emaDeathContinuation" : setupShortMrUpper or shortStaleCandidate ? "mr_sdUpper" : setupShortTrendLower ? "trend_sdLower" : "none"
string longReason = setupLongPostLowerBreakout ? "SD lower breakout long: prior lower SD + EMA golden cross + 2 of 3 bull direction components" : setupLongTrendUpper ? "SD upper trend-continuation long: EMA touch/upper-band continuation + 2 of 3 bull direction components" : setupLongMrLower ? "SD lower mean-reversion long: fresh 2 of 3 bull direction components" : longStaleCandidate ? "SD lower mean-reversion long blocked: stale MR components" : "none"
string shortReason = setupShortPostUpperBreakdown ? "SD upper breakdown short: prior upper SD + EMA death cross + 2 of 3 bear direction components" : setupShortEmaDeathContinuation ? "EMA death continuation short: weak structure + EMA death cross + bear fractal/divergence" : setupShortMrUpper ? "SD upper mean-reversion short: fresh 2 of 3 bear direction components" : shortStaleCandidate ? "SD upper mean-reversion short blocked: stale MR components" : setupShortTrendLowerContinuation ? "DTP bearish trend-continuation short: resistance rejection/range break + 2 of 3 bear direction components" : setupShortTrendLowerPullback ? "SD lower trend-continuation short: pullback resistance + 2 of 3 bear direction components" : setupShortTrendLowerTouch ? "SD lower trend-continuation short: EMA touch + 2 of 3 bear direction components" : "none"
string longMrRegime = mrRegimeText("long", dtpDir, dtpPhase, dtpMrFilterMode, useDtpFilter, sdSlopeAtr)
string shortMrRegime = mrRegimeText("short", dtpDir, dtpPhase, dtpMrFilterMode, useDtpFilter, sdSlopeAtr)
bool longMrDtpBlocked = mrDtpBlocked("long", dtpDir, dtpPhase, dtpMrFilterMode, useDtpFilter)
bool shortMrDtpBlocked = mrDtpBlocked("short", dtpDir, dtpPhase, dtpMrFilterMode, useDtpFilter)
bool longMrWeakeningReversalOk = longMrRegime != "trend_weakening" or (lowerBullEmaCrossFresh and (lowerBullFractalFresh or bullDivFresh))
bool shortMrWeakeningReversalOk = shortMrRegime != "trend_weakening" or (upperBearEmaCrossFresh and (upperBearFractalFresh or bearDivFresh))

bool structuralAnchorMode = entryAnchorMode == "setup_structural"
float longReferenceEntry = close
float shortReferenceEntry = close
float longFallbackEntry = close - atrRaw * entryFallbackAtr
float shortFallbackEntry = close + atrRaw * entryFallbackAtr
float longSupportEmaFast = emaFast <= longReferenceEntry ? emaFast : na
float longSupportEmaSlow = emaSlow <= longReferenceEntry ? emaSlow : na
float longSupportMid = signalMid <= longReferenceEntry ? signalMid : na
float longSupportSd = setupLongMrLower ? sdSignalLower : na
float shortResistanceEmaFast = emaFast >= shortReferenceEntry ? emaFast : na
float shortResistanceEmaSlow = emaSlow >= shortReferenceEntry ? emaSlow : na
float shortResistanceMid = signalMid >= shortReferenceEntry ? signalMid : na
float shortResistanceSd = setupShortMrUpper ? sdSignalUpper : na
float longStructuralAnchorLevel = nearestSupportBelow(longReferenceEntry, lastPivotLow, recentLow, sessionLow, longSupportEmaFast, longSupportEmaSlow, longSupportSd, noLevel, noLevel, longFallbackEntry)
float shortStructuralAnchorLevel = nearestResistanceAbove(shortReferenceEntry, lastPivotHigh, recentHigh, sessionHigh, shortResistanceEmaFast, shortResistanceEmaSlow, shortResistanceSd, noLevel, noLevel, shortFallbackEntry)
float longStructuralEntryRaw = math.min(longReferenceEntry, longStructuralAnchorLevel + atrRaw * entryAnchorZoneAtr)
float shortStructuralEntryRaw = math.max(shortReferenceEntry, shortStructuralAnchorLevel - atrRaw * entryAnchorZoneAtr)
float longPlannedEntryRaw = structuralAnchorMode ? longStructuralEntryRaw : longReferenceEntry
float shortPlannedEntryRaw = structuralAnchorMode ? shortStructuralEntryRaw : shortReferenceEntry
float longEntryCandidate = structuralAnchorMode ? roundStructuralEntryLimitToTick(limitByHardCap(longReferenceEntry, longPlannedEntryRaw, 1), 1) : longReferenceEntry
float shortEntryCandidate = structuralAnchorMode ? roundStructuralEntryLimitToTick(limitByHardCap(shortReferenceEntry, shortPlannedEntryRaw, -1), -1) : shortReferenceEntry
bool longEntryAnchorTouched = structuralAnchorMode and not na(longEntryCandidate) and low <= longEntryCandidate
bool shortEntryAnchorTouched = structuralAnchorMode and not na(shortEntryCandidate) and high >= shortEntryCandidate
string longEntryAnchorReason = ""
longEntryAnchorReason := structuralAnchorMode and anchorNear(longEntryCandidate, lastPivotLow, atrRaw) ? appendAnchorReason(longEntryAnchorReason, "前低支撑") : longEntryAnchorReason
longEntryAnchorReason := structuralAnchorMode and anchorNear(longEntryCandidate, recentLow, atrRaw) ? appendAnchorReason(longEntryAnchorReason, "近期低点") : longEntryAnchorReason
longEntryAnchorReason := structuralAnchorMode and anchorNear(longEntryCandidate, sessionLow, atrRaw) ? appendAnchorReason(longEntryAnchorReason, "日内低点") : longEntryAnchorReason
longEntryAnchorReason := structuralAnchorMode and anchorNear(longEntryCandidate, longSupportEmaFast, atrRaw) ? appendAnchorReason(longEntryAnchorReason, "EMA20支撑") : longEntryAnchorReason
longEntryAnchorReason := structuralAnchorMode and anchorNear(longEntryCandidate, longSupportEmaSlow, atrRaw) ? appendAnchorReason(longEntryAnchorReason, "EMA50支撑") : longEntryAnchorReason
longEntryAnchorReason := structuralAnchorMode and anchorNear(longEntryCandidate, low, atrRaw) ? appendAnchorReason(longEntryAnchorReason, "信号K低点") : longEntryAnchorReason
longEntryAnchorReason := structuralAnchorMode and anchorNear(longEntryCandidate, longSupportMid, atrRaw) ? appendAnchorReason(longEntryAnchorReason, "信号K中点") : longEntryAnchorReason
longEntryAnchorReason := structuralAnchorMode and anchorNear(longEntryCandidate, longSupportSd, atrRaw) ? appendAnchorReason(longEntryAnchorReason, "SD下轨接近") : longEntryAnchorReason
longEntryAnchorReason := structuralAnchorMode and longEntryAnchorReason == "" and anchorNear(longEntryCandidate, longFallbackEntry, atrRaw) ? "ATR回撤备选" : longEntryAnchorReason
longEntryAnchorReason := longEntryAnchorTouched ? appendAnchorReason(longEntryAnchorReason, "锚点已触及") : longEntryAnchorReason
string shortEntryAnchorReason = ""
shortEntryAnchorReason := structuralAnchorMode and anchorNear(shortEntryCandidate, lastPivotHigh, atrRaw) ? appendAnchorReason(shortEntryAnchorReason, "前高压力") : shortEntryAnchorReason
shortEntryAnchorReason := structuralAnchorMode and anchorNear(shortEntryCandidate, recentHigh, atrRaw) ? appendAnchorReason(shortEntryAnchorReason, "近期高点") : shortEntryAnchorReason
shortEntryAnchorReason := structuralAnchorMode and anchorNear(shortEntryCandidate, sessionHigh, atrRaw) ? appendAnchorReason(shortEntryAnchorReason, "日内高点") : shortEntryAnchorReason
shortEntryAnchorReason := structuralAnchorMode and anchorNear(shortEntryCandidate, shortResistanceEmaFast, atrRaw) ? appendAnchorReason(shortEntryAnchorReason, "EMA20压力") : shortEntryAnchorReason
shortEntryAnchorReason := structuralAnchorMode and anchorNear(shortEntryCandidate, shortResistanceEmaSlow, atrRaw) ? appendAnchorReason(shortEntryAnchorReason, "EMA50压力") : shortEntryAnchorReason
shortEntryAnchorReason := structuralAnchorMode and anchorNear(shortEntryCandidate, high, atrRaw) ? appendAnchorReason(shortEntryAnchorReason, "信号K高点") : shortEntryAnchorReason
shortEntryAnchorReason := structuralAnchorMode and anchorNear(shortEntryCandidate, shortResistanceMid, atrRaw) ? appendAnchorReason(shortEntryAnchorReason, "信号K中点") : shortEntryAnchorReason
shortEntryAnchorReason := structuralAnchorMode and anchorNear(shortEntryCandidate, shortResistanceSd, atrRaw) ? appendAnchorReason(shortEntryAnchorReason, "SD上轨接近") : shortEntryAnchorReason
shortEntryAnchorReason := structuralAnchorMode and shortEntryAnchorReason == "" and anchorNear(shortEntryCandidate, shortFallbackEntry, atrRaw) ? "ATR反抽备选" : shortEntryAnchorReason
shortEntryAnchorReason := shortEntryAnchorTouched ? appendAnchorReason(shortEntryAnchorReason, "锚点已触及") : shortEntryAnchorReason
string longEntryAnchorSource = structuralAnchorMode ? "support_anchor" : "marketable_cap"
string shortEntryAnchorSource = structuralAnchorMode ? "resistance_anchor" : "marketable_cap"
bool longEntryAnchorAllowed = not structuralAnchorMode or ((longEntryAnchorTouched or entryAnchorValid(longReferenceEntry, longEntryCandidate, atrRaw)) and longEntryCandidate <= longReferenceEntry)
bool shortEntryAnchorAllowed = not structuralAnchorMode or ((shortEntryAnchorTouched or entryAnchorValid(shortReferenceEntry, shortEntryCandidate, atrRaw)) and shortEntryCandidate >= shortReferenceEntry)
bool longMrStructuralAnchorQualified = not structuralAnchorMode or anchorNear(longEntryCandidate, lastPivotLow, atrRaw) or anchorNear(longEntryCandidate, recentLow, atrRaw) or anchorNear(longEntryCandidate, sessionLow, atrRaw) or anchorNear(longEntryCandidate, longSupportEmaFast, atrRaw) or anchorNear(longEntryCandidate, longSupportEmaSlow, atrRaw) or anchorNear(longEntryCandidate, sdSignalLower, atrRaw)
bool shortMrStructuralAnchorQualified = not structuralAnchorMode or anchorNear(shortEntryCandidate, lastPivotHigh, atrRaw) or anchorNear(shortEntryCandidate, recentHigh, atrRaw) or anchorNear(shortEntryCandidate, sessionHigh, atrRaw) or anchorNear(shortEntryCandidate, shortResistanceEmaFast, atrRaw) or anchorNear(shortEntryCandidate, shortResistanceEmaSlow, atrRaw) or anchorNear(shortEntryCandidate, sdSignalUpper, atrRaw)
bool longPostReversalStructuralAnchorQualified = not structuralAnchorMode or anchorNear(longEntryCandidate, lastPivotLow, atrRaw) or anchorNear(longEntryCandidate, recentLow, atrRaw) or anchorNear(longEntryCandidate, sessionLow, atrRaw) or anchorNear(longEntryCandidate, longSupportEmaFast, atrRaw) or anchorNear(longEntryCandidate, longSupportEmaSlow, atrRaw) or anchorNear(longEntryCandidate, low, atrRaw) or anchorNear(longEntryCandidate, longSupportMid, atrRaw)
bool shortPostReversalStructuralAnchorQualified = not structuralAnchorMode or anchorNear(shortEntryCandidate, lastPivotHigh, atrRaw) or anchorNear(shortEntryCandidate, recentHigh, atrRaw) or anchorNear(shortEntryCandidate, sessionHigh, atrRaw) or anchorNear(shortEntryCandidate, shortResistanceEmaFast, atrRaw) or anchorNear(shortEntryCandidate, shortResistanceEmaSlow, atrRaw) or anchorNear(shortEntryCandidate, high, atrRaw) or anchorNear(shortEntryCandidate, shortResistanceMid, atrRaw)
bool longMrAnchorQualified = not setupLongMrLower or longMrStructuralAnchorQualified
bool shortMrAnchorQualified = not setupShortMrUpper or shortMrStructuralAnchorQualified
bool longPostReversalAnchorQualified = not setupLongPostLowerBreakout or longPostReversalStructuralAnchorQualified
bool shortPostReversalAnchorQualified = not setupShortPostUpperBreakdown or shortPostReversalStructuralAnchorQualified
bool emaWeak = math.abs(calcSlope(emaFast, emaSlopeLookback)) < emaMinAngle or math.abs(slopeSlow) < emaMinAngle or not spacingOk
bool weakTrendOrLowVolContext = (useVolatilityFilter and atrPct < minAtrPctForEntry * weakTrendAtrPctMultiplier) or emaWeak
float effectiveMinStructureRewardRiskForEntry = math.max(structureContextMinRewardRisk(weakTrendOrLowVolContext), lateQualityEntryWindow ? minWeakTrendRewardRiskForEntry : minStructureRewardRiskForEntry)
float longQtyCandidate = longEntryCandidate > 0.0 ? math.max(1.0, math.floor(positionAmount / longEntryCandidate)) : 0.0
float longAtrStopCandidate = longEntryCandidate - atrVal * slAtrMult
float longRiskStopCandidate = longQtyCandidate > 0.0 ? longEntryCandidate - effectiveMaxLegRisk / longQtyCandidate : longAtrStopCandidate
float longStopSupportBase = nearestSupportBelow(longEntryCandidate, lastPivotLow, recentLow, sessionLow, longSupportEmaFast, longSupportEmaSlow, low, signalMid <= longEntryCandidate ? signalMid : noLevel, longSupportSd, noLevel)
bool longStructureStopAvailable = not na(longStopSupportBase)
float longStructureStopCandidate = longStructureStopAvailable ? longStopSupportBase - atrRaw * structuralSlBufferAtr : longAtrStopCandidate
float longStopCandidate = math.max(longStructureStopCandidate, longRiskStopCandidate)
bool longRiskCapStopApplied = longStructureStopAvailable and longRiskStopCandidate > longStructureStopCandidate
string longStopSource = longStructureStopAvailable ? longRiskCapStopApplied ? "support_with_atr_buffer_risk_capped" : "support_with_atr_buffer" : "atr_fallback_no_structure"
float longRunnerActivationRaw = setupUsesRunner(longSetup) and not setupIsMr(longSetup) ? calcRunnerActivationTarget(longEntryCandidate, longStopCandidate, 1) : na
float longMrMeanTargetRaw = nearestResistanceAbove(longEntryCandidate, validResistanceLevel(longEntryCandidate, sdReg), validResistanceLevel(longEntryCandidate, emaFast), validResistanceLevel(longEntryCandidate, emaSlow), noLevel, noLevel, noLevel, noLevel, noLevel, noLevel)
bool longMrMeanTargetAvailable = not na(longMrMeanTargetRaw)
float longTrendStructureTargetRaw = nearestResistanceAbove(longEntryCandidate, validResistanceLevel(longEntryCandidate, lastPivotHigh), validResistanceLevel(longEntryCandidate, recentHigh), validResistanceLevel(longEntryCandidate, sessionHigh), validResistanceLevel(longEntryCandidate, sdSignalUpper), validResistanceLevel(longEntryCandidate, sdFilterUpper), validResistanceLevel(longEntryCandidate, sdReg), noLevel, noLevel, noLevel)
float longStructureTargetRaw = setupIsMr(longSetup) and longMrMeanTargetAvailable ? longMrMeanTargetRaw : longTrendStructureTargetRaw
bool longStructureTargetAvailable = not na(longStructureTargetRaw)
bool longRunnerCandidate = setupUsesRunner(longSetup) and not setupIsMr(longSetup) and longStructureTargetAvailable and not na(longRunnerActivationRaw) and longStructureTargetRaw > longRunnerActivationRaw and rewardRiskMultiple(structureRewardPerShare(1, longEntryCandidate, longStructureTargetRaw), structureRiskPerShare(1, longEntryCandidate, longStopCandidate)) >= runnerSafetyR
float longRunnerActivationCandidate = longRunnerCandidate ? longRunnerActivationRaw : na
float longTargetCandidate = longStructureTargetRaw
bool longMrTargetQualified = not setupIsMr(longSetup) or longMrMeanTargetAvailable
bool longStructureTpSlQualified = longStructureStopAvailable and longStructureTargetAvailable
float longStructureRewardPerShare = structureRewardPerShare(1, longEntryCandidate, longTargetCandidate)
float longStructureRiskPerShare = structureRiskPerShare(1, longEntryCandidate, longStopCandidate)
float longStructureRewardRisk = rewardRiskMultiple(longStructureRewardPerShare, longStructureRiskPerShare)
float longProfitCheckpoint = longRunnerCandidate ? longRunnerActivationCandidate : longTargetCandidate
float longEntryNotional = profitSpaceEntryNotional(longEntryCandidate, longQtyCandidate)
float longEstimatedCost = profitSpaceRoundTripCost(longQtyCandidate)
float longExpectedGrossProfit = profitSpaceGrossProfit(1, longEntryCandidate, longTargetCandidate, longQtyCandidate)
float longExpectedNetProfit = longExpectedGrossProfit - longEstimatedCost
float longExpectedNetRoiPct = profitSpaceNetRoiPct(longExpectedNetProfit, longEntryNotional)
float longCostPctOfReward = profitSpaceCostPct(longEstimatedCost, longExpectedGrossProfit)
float longTargetDistanceAtr = profitSpaceTargetAtrMultiple(longEntryCandidate, longTargetCandidate)
float longCheckpointGrossProfit = profitSpaceGrossProfit(1, longEntryCandidate, longProfitCheckpoint, longQtyCandidate)
float longCheckpointNetProfit = longCheckpointGrossProfit - longEstimatedCost
float longCheckpointNetRoiPct = profitSpaceNetRoiPct(longCheckpointNetProfit, longEntryNotional)
float longCheckpointCostPctOfReward = profitSpaceCostPct(longEstimatedCost, longCheckpointGrossProfit)
float longCheckpointTargetDistanceAtr = profitSpaceTargetAtrMultiple(longEntryCandidate, longProfitCheckpoint)
bool longProfitSpaceAllowed = profitSpaceEntryAllowed(longExpectedNetProfit, longExpectedNetRoiPct, longCostPctOfReward, longTargetDistanceAtr, longStructureRewardRisk, longStructureStopAvailable, longStructureTargetAvailable, effectiveMinStructureRewardRiskForEntry)
bool longProfitSpaceEntryBlocked = useProfitSpaceFilter and longRaw and not longProfitSpaceAllowed

float shortQtyCandidate = shortEntryCandidate > 0.0 ? math.max(1.0, math.floor(positionAmount / shortEntryCandidate)) : 0.0
float shortAtrStopCandidate = shortEntryCandidate + atrVal * slAtrMult
float shortRiskStopCandidate = shortQtyCandidate > 0.0 ? shortEntryCandidate + effectiveMaxLegRisk / shortQtyCandidate : shortAtrStopCandidate
float shortStopResistanceBase = nearestResistanceAbove(shortEntryCandidate, lastPivotHigh, recentHigh, sessionHigh, shortResistanceEmaFast, shortResistanceEmaSlow, high, signalMid >= shortEntryCandidate ? signalMid : noLevel, shortResistanceSd, noLevel)
bool shortStructureStopAvailable = not na(shortStopResistanceBase)
float shortStructureStopCandidate = shortStructureStopAvailable ? shortStopResistanceBase + atrRaw * structuralSlBufferAtr : shortAtrStopCandidate
float shortStopCandidate = math.min(shortStructureStopCandidate, shortRiskStopCandidate)
bool shortRiskCapStopApplied = shortStructureStopAvailable and shortRiskStopCandidate < shortStructureStopCandidate
string shortStopSource = shortStructureStopAvailable ? shortRiskCapStopApplied ? "resistance_with_atr_buffer_risk_capped" : "resistance_with_atr_buffer" : "atr_fallback_no_structure"
float shortRunnerActivationRaw = setupUsesRunner(shortSetup) and not setupIsMr(shortSetup) ? calcRunnerActivationTarget(shortEntryCandidate, shortStopCandidate, -1) : na
float shortMrMeanTargetRaw = nearestSupportBelow(shortEntryCandidate, validSupportLevel(shortEntryCandidate, sdReg), validSupportLevel(shortEntryCandidate, emaFast), validSupportLevel(shortEntryCandidate, emaSlow), noLevel, noLevel, noLevel, noLevel, noLevel, noLevel)
bool shortMrMeanTargetAvailable = not na(shortMrMeanTargetRaw)
float shortTrendStructureTargetRaw = nearestSupportBelow(shortEntryCandidate, validSupportLevel(shortEntryCandidate, lastPivotLow), validSupportLevel(shortEntryCandidate, recentLow), validSupportLevel(shortEntryCandidate, sessionLow), validSupportLevel(shortEntryCandidate, sdSignalLower), validSupportLevel(shortEntryCandidate, sdFilterLower), validSupportLevel(shortEntryCandidate, sdReg), noLevel, noLevel, noLevel)
float shortStructureTargetRaw = setupIsMr(shortSetup) and shortMrMeanTargetAvailable ? shortMrMeanTargetRaw : shortTrendStructureTargetRaw
bool shortStructureTargetAvailable = not na(shortStructureTargetRaw)
bool shortRunnerCandidate = setupUsesRunner(shortSetup) and not setupIsMr(shortSetup) and shortStructureTargetAvailable and not na(shortRunnerActivationRaw) and shortStructureTargetRaw < shortRunnerActivationRaw and rewardRiskMultiple(structureRewardPerShare(-1, shortEntryCandidate, shortStructureTargetRaw), structureRiskPerShare(-1, shortEntryCandidate, shortStopCandidate)) >= runnerSafetyR
float shortRunnerActivationCandidate = shortRunnerCandidate ? shortRunnerActivationRaw : na
float shortTargetCandidate = shortStructureTargetRaw
bool shortMrTargetQualified = not setupIsMr(shortSetup) or shortMrMeanTargetAvailable
bool shortStructureTpSlQualified = shortStructureStopAvailable and shortStructureTargetAvailable
float shortStructureRewardPerShare = structureRewardPerShare(-1, shortEntryCandidate, shortTargetCandidate)
float shortStructureRiskPerShare = structureRiskPerShare(-1, shortEntryCandidate, shortStopCandidate)
float shortStructureRewardRisk = rewardRiskMultiple(shortStructureRewardPerShare, shortStructureRiskPerShare)
float shortProfitCheckpoint = shortRunnerCandidate ? shortRunnerActivationCandidate : shortTargetCandidate
float shortEntryNotional = profitSpaceEntryNotional(shortEntryCandidate, shortQtyCandidate)
float shortEstimatedCost = profitSpaceRoundTripCost(shortQtyCandidate)
float shortExpectedGrossProfit = profitSpaceGrossProfit(-1, shortEntryCandidate, shortTargetCandidate, shortQtyCandidate)
float shortExpectedNetProfit = shortExpectedGrossProfit - shortEstimatedCost
float shortExpectedNetRoiPct = profitSpaceNetRoiPct(shortExpectedNetProfit, shortEntryNotional)
float shortCostPctOfReward = profitSpaceCostPct(shortEstimatedCost, shortExpectedGrossProfit)
float shortTargetDistanceAtr = profitSpaceTargetAtrMultiple(shortEntryCandidate, shortTargetCandidate)
float shortCheckpointGrossProfit = profitSpaceGrossProfit(-1, shortEntryCandidate, shortProfitCheckpoint, shortQtyCandidate)
float shortCheckpointNetProfit = shortCheckpointGrossProfit - shortEstimatedCost
float shortCheckpointNetRoiPct = profitSpaceNetRoiPct(shortCheckpointNetProfit, shortEntryNotional)
float shortCheckpointCostPctOfReward = profitSpaceCostPct(shortEstimatedCost, shortCheckpointGrossProfit)
float shortCheckpointTargetDistanceAtr = profitSpaceTargetAtrMultiple(shortEntryCandidate, shortProfitCheckpoint)
bool shortProfitSpaceAllowed = profitSpaceEntryAllowed(shortExpectedNetProfit, shortExpectedNetRoiPct, shortCostPctOfReward, shortTargetDistanceAtr, shortStructureRewardRisk, shortStructureStopAvailable, shortStructureTargetAvailable, effectiveMinStructureRewardRiskForEntry)
bool shortProfitSpaceEntryBlocked = useProfitSpaceFilter and shortRaw and not shortProfitSpaceAllowed

bool blockLong = false
string blockLongReason = ""
if longStaleCandidate
    blockLong := true
    blockLongReason := "mr_component_stale"
else if longRaw and not inEntryWindow
    blockLong := true
    blockLongReason := "entry_time_blocked"
else if longSetup == "mr_sdLower" and longMrDtpBlocked
    blockLong := true
    blockLongReason := "mr_dtp_phase_blocked"
else if longSetup == "mr_sdLower" and not longMrWeakeningReversalOk
    blockLong := true
    blockLongReason := "mr_reversal_confirm_missing"
else if longSetup == "mr_sdLower" and emaFast < emaSlow and not lowerBullEmaCrossFresh
    blockLong := true
    blockLongReason := "mr_ema_cross_missing"
else if longSetup == "mr_sdLower" and not longMrAnchorQualified
    blockLong := true
    blockLongReason := "mr_anchor_unqualified"
else if setupLongPostLowerBreakout and not longPostReversalAnchorQualified
    blockLong := true
    blockLongReason := "post_reversal_anchor_unqualified"
else if longRaw and not longEntryAnchorAllowed
    blockLong := true
    blockLongReason := "entry_anchor_unavailable"
else if mtfLongBlock and longRaw
    blockLong := true
    blockLongReason := mtfLongBlockReason
else if lowVolatilityEntryBlocked and longRaw
    blockLong := true
    blockLongReason := "low_volatility"
else if longSetup == "mr_sdLower" and (not longMrTargetQualified or longProfitSpaceEntryBlocked)
    blockLong := true
    blockLongReason := "mr_target_space_too_small"
else if longRaw and not longStructureTpSlQualified
    blockLong := true
    blockLongReason := "structure_tp_sl_unavailable"
else if longProfitSpaceEntryBlocked
    blockLong := true
    blockLongReason := "profit_space_too_small"
else if useEmaWeakFilter and (setupLongTrendUpper or setupLongPostLowerBreakout) and emaWeak
    blockLong := true
    blockLongReason := "ema_weak"

bool blockShort = false
string blockShortReason = ""
if shortStaleCandidate
    blockShort := true
    blockShortReason := "mr_component_stale"
else if shortRaw and not inEntryWindow
    blockShort := true
    blockShortReason := "entry_time_blocked"
else if shortSetup == "mr_sdUpper" and shortMrDtpBlocked
    blockShort := true
    blockShortReason := "mr_dtp_phase_blocked"
else if shortSetup == "mr_sdUpper" and not shortMrWeakeningReversalOk
    blockShort := true
    blockShortReason := "mr_reversal_confirm_missing"
else if shortSetup == "mr_sdUpper" and emaFast > emaSlow and not upperBearEmaCrossFresh
    blockShort := true
    blockShortReason := "mr_ema_cross_missing"
else if shortSetup == "mr_sdUpper" and not shortMrAnchorQualified
    blockShort := true
    blockShortReason := "mr_anchor_unqualified"
else if setupShortPostUpperBreakdown and not shortPostReversalAnchorQualified
    blockShort := true
    blockShortReason := "post_reversal_anchor_unqualified"
else if shortRaw and not shortEntryAnchorAllowed
    blockShort := true
    blockShortReason := "entry_anchor_unavailable"
else if mtfShortBlock and shortRaw
    blockShort := true
    blockShortReason := mtfShortBlockReason
else if lowVolatilityEntryBlocked and shortRaw
    blockShort := true
    blockShortReason := "low_volatility"
else if shortSetup == "mr_sdUpper" and (not shortMrTargetQualified or shortProfitSpaceEntryBlocked)
    blockShort := true
    blockShortReason := "mr_target_space_too_small"
else if shortRaw and not shortStructureTpSlQualified
    blockShort := true
    blockShortReason := "structure_tp_sl_unavailable"
else if shortProfitSpaceEntryBlocked
    blockShort := true
    blockShortReason := "profit_space_too_small"
else if useEmaWeakFilter and (setupShortTrendLower or setupShortPostUpperBreakdown or setupShortEmaDeathContinuation) and emaWeak
    blockShort := true
    blockShortReason := "ema_weak"

bool conflict = longRaw and shortRaw
bool longActionable = longSignalCandidate and not blockLong
bool shortActionable = shortSignalCandidate and not blockShort

int scoreLongTrendUpper = math.min(100, (longTrendContextReady ? 20 : 0) + (upperBullTrendTriggerSeen ? 30 : 0) + (trendBullFractalSeen ? 25 : 0) + (bullDivSeen ? 25 : 0) + (trendBullEmaCrossSeen ? 25 : 0))
int scoreLongPostLowerBreakout = math.min(100, (lowerSdExtremeFresh ? 34 : 0) + (lowerBullFractalSeen ? 33 : 0) + (bullDivSeen ? 33 : 0) + (lowerBullEmaCrossSeen ? 33 : 0))
int scoreLongMrLower = math.min(100, (lowerMrWindowValid ? 34 : 0) + (lowerBullFractalSeen ? 33 : 0) + (bullDivSeen ? 33 : 0) + (lowerBullEmaCrossSeen ? 33 : 0))
int scoreShortPostUpperBreakdown = dtpBullDominant and not bearishReversalContext ? 0 : math.min(100, (upperSdExtremeFresh ? 34 : 0) + (upperBearFractalSeen ? 33 : 0) + (bearDivSeen ? 33 : 0) + (upperBearEmaCrossSeen ? 33 : 0))
int scoreShortEmaDeathContinuation = shortEmaDeathContinuationStructureOk and (not dtpBullDominant or bearishReversalContext) ? math.min(100, 34 + (trendBearFractalSeen ? 33 : 0) + (bearDivSeen ? 33 : 0) + (trendBearEmaCrossSeen ? 33 : 0)) : 0
int scoreShortMrUpper = dtpBullDominant and not bearishReversalContext ? 0 : math.min(100, (upperMrWindowValid ? 34 : 0) + (upperBearFractalSeen ? 33 : 0) + (bearDivSeen ? 33 : 0) + (upperBearEmaCrossSeen ? 33 : 0))
int scoreShortTrendLower = math.min(100, (shortTrendContextReady ? 25 : 0) + (lowerBearTrendTriggerSeen ? 25 : 0) + (trendBearFractalSeen ? 25 : 0) + (bearDivSeen ? 25 : 0) + (trendBearEmaCrossSeen ? 25 : 0))
int activityScore = math.max(math.max(math.max(scoreLongTrendUpper, scoreLongPostLowerBreakout), scoreLongMrLower), math.max(math.max(math.max(scoreShortPostUpperBreakdown, scoreShortEmaDeathContinuation), scoreShortMrUpper), scoreShortTrendLower))
string candidateSetup = activityScore == 0 ? "none" : activityScore == scoreLongPostLowerBreakout ? "trend_sdLowerBreakout" : activityScore == scoreLongTrendUpper ? "trend_sdUpper" : activityScore == scoreLongMrLower ? "mr_sdLower" : activityScore == scoreShortPostUpperBreakdown ? "trend_sdUpperBreakdown" : activityScore == scoreShortEmaDeathContinuation ? "trend_emaDeathContinuation" : activityScore == scoreShortMrUpper ? "mr_sdUpper" : "trend_sdLower"
string candidateDirection = setupUsesBullSide(candidateSetup) ? "long" : "short"
string activityGrade = activityScore >= 100 ? "ready" : activityScore >= preAlertThreshold ? "pre_alert" : activityScore > 0 ? "building" : "quiet"

string missingComponents = ""
if candidateSetup == "trend_sdUpper"
    missingComponents := trendLongSupportLingerWait ? appendSource(missingComponents, "key_level_wait") : missingComponents
    missingComponents := not longTrendContextReady and not trendLongSupportLingerWait ? appendSource(missingComponents, "trend_context") : missingComponents
    missingComponents := not upperBullTrendTriggerSeen ? appendSource(missingComponents, "ema_bull_touch") : missingComponents
    if longTrendUpperDirectionComponents < 2
        missingComponents := not trendBullFractalSeen ? appendSource(missingComponents, "bull_fractal") : missingComponents
        missingComponents := not bullDivSeen ? appendSource(missingComponents, "bull_divergence") : missingComponents
        missingComponents := not trendBullEmaCrossSeen ? appendSource(missingComponents, "bull_ema_cross") : missingComponents
else if candidateSetup == "trend_sdLowerBreakout"
    missingComponents := not lowerSdExtremeFresh ? appendSource(missingComponents, "lower_sd_memory") : missingComponents
    missingComponents := not lowerBullEmaCrossSeen ? appendSource(missingComponents, "bull_ema_cross") : missingComponents
    if not (lowerBullFractalSeen or bullDivSeen)
        missingComponents := not lowerBullFractalSeen ? appendSource(missingComponents, "bull_fractal") : missingComponents
        missingComponents := not bullDivSeen ? appendSource(missingComponents, "bull_divergence") : missingComponents
else if candidateSetup == "mr_sdLower"
    missingComponents := not lowerMrWindowValid ? appendSource(missingComponents, "lower_window") : missingComponents
    if longMrLowerDirectionComponents < 2
        missingComponents := not lowerBullFractalSeen ? appendSource(missingComponents, "bull_fractal") : missingComponents
        missingComponents := not bullDivSeen ? appendSource(missingComponents, "bull_divergence") : missingComponents
        missingComponents := not lowerBullEmaCrossSeen ? appendSource(missingComponents, "bull_ema_cross") : missingComponents
else if candidateSetup == "trend_sdUpperBreakdown"
    missingComponents := not upperSdExtremeFresh ? appendSource(missingComponents, "upper_sd_memory") : missingComponents
    missingComponents := not upperBearEmaCrossSeen ? appendSource(missingComponents, "bear_ema_cross") : missingComponents
    if not (upperBearFractalSeen or bearDivSeen)
        missingComponents := not upperBearFractalSeen ? appendSource(missingComponents, "bear_fractal") : missingComponents
        missingComponents := not bearDivSeen ? appendSource(missingComponents, "bear_divergence") : missingComponents
else if candidateSetup == "trend_emaDeathContinuation"
    missingComponents := not shortEmaDeathContinuationStructureOk ? appendSource(missingComponents, "weak_structure") : missingComponents
    missingComponents := not trendBearEmaCrossSeen ? appendSource(missingComponents, "bear_ema_cross") : missingComponents
    if not (trendBearFractalSeen or bearDivSeen)
        missingComponents := not trendBearFractalSeen ? appendSource(missingComponents, "bear_fractal") : missingComponents
        missingComponents := not bearDivSeen ? appendSource(missingComponents, "bear_divergence") : missingComponents
else if candidateSetup == "mr_sdUpper"
    missingComponents := not upperMrWindowValid ? appendSource(missingComponents, "upper_window") : missingComponents
    if shortMrUpperDirectionComponents < 2
        missingComponents := not upperBearFractalSeen ? appendSource(missingComponents, "bear_fractal") : missingComponents
        missingComponents := not bearDivSeen ? appendSource(missingComponents, "bear_divergence") : missingComponents
        missingComponents := not upperBearEmaCrossSeen ? appendSource(missingComponents, "bear_ema_cross") : missingComponents
else
    missingComponents := trendShortResistanceLingerWait ? appendSource(missingComponents, "key_level_wait") : missingComponents
    missingComponents := not shortTrendContextReady and not trendShortResistanceLingerWait ? appendSource(missingComponents, "trend_context") : missingComponents
    missingComponents := not lowerBearTrendTriggerSeen ? appendSource(missingComponents, "ema_bear_touch") : missingComponents
    if shortTrendLowerDirectionComponents < 2
        missingComponents := not trendBearFractalSeen ? appendSource(missingComponents, "bear_fractal") : missingComponents
        missingComponents := not bearDivSeen ? appendSource(missingComponents, "bear_divergence") : missingComponents
        missingComponents := not trendBearEmaCrossSeen ? appendSource(missingComponents, "bear_ema_cross") : missingComponents
missingComponents := missingComponents == "" ? "none" : missingComponents

mtfScoreForDirection(string direction) =>
    direction == "short" ? mtfShortScore : mtfLongScore

mtfStatusForDirection(string direction) =>
    direction == "short" ? mtfShortStatus : mtfLongStatus

mtfBlockReasonForDirection(string direction) =>
    direction == "short" ? mtfShortBlockReason : mtfLongBlockReason

mtfState1ForDirection(string direction) =>
    direction == "short" ? mtfTf1ShortState : mtfTf1LongState

mtfState2ForDirection(string direction) =>
    direction == "short" ? mtfTf2ShortState : mtfTf2LongState

mtfState3ForDirection(string direction) =>
    direction == "short" ? mtfTf3ShortState : mtfTf3LongState

mtfSummaryForDirection(string direction) =>
    if not enableMtf
        "off"
    else
        string s1 = mtfState1ForDirection(direction)
        string s2 = mtfState2ForDirection(direction)
        string s3 = mtfState3ForDirection(direction)
        "MTF " + mtfConfirmTf1 + mtfDisplayMark(s1) + " " + mtfConfirmTf2 + mtfDisplayMark(s2) + " " + mtfConfirmTf3 + mtfDisplayMark(s3) + " score " + str.tostring(mtfScoreForDirection(direction), "#") + " " + mtfStatusForDirection(direction)




// -----------------------------------------------------------------------------
// Display-only event flow. This script is visual-only: no strategy orders and no alerts.
// -----------------------------------------------------------------------------
var bool displayShadowPendingEntry = false
var bool displayShadowEntryTouched = false
var bool displayShadowEntryExpired = false
var int displayShadowDirection = 0
var string displayShadowSetup = ""
var float displayShadowEntry = na
var float displayShadowStop = na
var float displayShadowTarget = na
var float displayShadowRunnerActivation = na
var int displayShadowSignalBar = na
var int displayShadowExpiresBar = na
var string displayShadowCancelReason = ""
var int displayEodForceCloseDay = na
if isNewTradingDay
    displayShadowPendingEntry := false
    displayShadowEntryTouched := false
    displayShadowEntryExpired := false
    displayShadowDirection := 0
    displayShadowSetup := ""
    displayShadowEntry := na
    displayShadowStop := na
    displayShadowTarget := na
    displayShadowRunnerActivation := na
    displayShadowSignalBar := na
    displayShadowExpiresBar := na
    displayShadowCancelReason := ""
    displayEodForceCloseDay := na

int displayEodCloseHourNow = hour(time_close, "America/New_York")
int displayEodCloseMinuteNow = minute(time_close, "America/New_York")
bool displayEodCloseTimeReached = displayEodCloseHourNow > eodCloseHour or (displayEodCloseHourNow == eodCloseHour and displayEodCloseMinuteNow >= eodCloseMinute)
bool displayPendingLongTouchedNow = confirmed and showPendingEntryLifecycle and displayShadowPendingEntry and displayShadowDirection == 1 and bar_index > displayShadowSignalBar and low <= displayShadowEntry
bool displayPendingShortTouchedNow = confirmed and showPendingEntryLifecycle and displayShadowPendingEntry and displayShadowDirection == -1 and bar_index > displayShadowSignalBar and high >= displayShadowEntry
bool displayPendingEntryTouchedNow = displayPendingLongTouchedNow or displayPendingShortTouchedNow
if displayPendingEntryTouchedNow
    displayShadowEntryTouched := true
    displayShadowEntryExpired := false
    displayShadowCancelReason := ""
    displayShadowPendingEntry := false

bool displayPendingEntryExpiredNow = confirmed and showPendingEntryLifecycle and displayShadowPendingEntry and not na(displayShadowExpiresBar) and bar_index > displayShadowExpiresBar
bool displayPendingEntryWindowExpired = confirmed and showPendingEntryLifecycle and displayShadowPendingEntry and not inEntryWindow
bool displayPendingAnchorInvalidated = confirmed and showPendingEntryLifecycle and displayShadowPendingEntry and structuralAnchorMode and (displayShadowDirection == 1 ? close < displayShadowEntry - atrRaw * structuralSlBufferAtr : close > displayShadowEntry + atrRaw * structuralSlBufferAtr)
bool displayPendingOppositeLongActionable = confirmed and showPendingEntryLifecycle and displayShadowPendingEntry and displayShadowDirection == -1 and longActionable
bool displayPendingOppositeShortActionable = confirmed and showPendingEntryLifecycle and displayShadowPendingEntry and displayShadowDirection == 1 and shortActionable
bool displayPendingActionableConflict = confirmed and showPendingEntryLifecycle and displayShadowPendingEntry and longActionable and shortActionable
bool displayPendingOppositeOrConflict = displayPendingActionableConflict or displayPendingOppositeLongActionable or displayPendingOppositeShortActionable
bool displayPendingEodCancel = confirmed and showPendingEntryLifecycle and enableEodForceClose and displayShadowPendingEntry and displayEodCloseTimeReached and (na(displayEodForceCloseDay) or displayEodForceCloseDay != dailyTime)
bool displayPendingSameDirectionContinuation = confirmed and showPendingEntryLifecycle and displayShadowPendingEntry and (displayShadowDirection == 1 ? longRaw : displayShadowDirection == -1 ? shortRaw : false)
float displayPendingTrendInvalidationBuffer = atrRaw * pendingTrendInvalidationBufferAtr
bool displayPendingLongEmaSoftReversed = emaFast < emaSlow or close < emaSlow
bool displayPendingShortEmaSoftReversed = emaFast > emaSlow or close > emaSlow
bool displayPendingLongEmaBufferBroken = emaFast < emaSlow and close < emaSlow - displayPendingTrendInvalidationBuffer
bool displayPendingShortEmaBufferBroken = emaFast > emaSlow and close > emaSlow + displayPendingTrendInvalidationBuffer
bool displayPendingLongTrendSupportFailed = dtpDir == -1 or mtfLongStatus == "block"
bool displayPendingShortTrendSupportFailed = dtpDir == 1 or mtfShortStatus == "block"
bool displayPendingLongSoftInvalidated = displayPendingLongTrendSupportFailed or displayPendingLongEmaSoftReversed
bool displayPendingShortSoftInvalidated = displayPendingShortTrendSupportFailed or displayPendingShortEmaSoftReversed
bool displayPendingLongHardInvalidated = displayPendingLongEmaBufferBroken and displayPendingLongTrendSupportFailed
bool displayPendingShortHardInvalidated = displayPendingShortEmaBufferBroken and displayPendingShortTrendSupportFailed
bool displayPendingHardInvalidated = confirmed and showPendingEntryLifecycle and displayShadowPendingEntry and (displayShadowDirection == 1 ? displayPendingLongHardInvalidated : displayShadowDirection == -1 ? displayPendingShortHardInvalidated : true)
bool displayPendingSoftInvalidated = confirmed and showPendingEntryLifecycle and displayShadowPendingEntry and not displayPendingHardInvalidated and (displayShadowDirection == 1 ? displayPendingLongSoftInvalidated : displayShadowDirection == -1 ? displayPendingShortSoftInvalidated : false)
bool displayPendingSoftRecheckFailed = displayPendingEntryExpiredNow and displayPendingSoftInvalidated and not displayPendingSameDirectionContinuation
bool displayPendingTrendInvalidated = displayPendingHardInvalidated
bool displayPendingTrendStillValid = confirmed and showPendingEntryLifecycle and displayShadowPendingEntry and not displayPendingTrendInvalidated
bool displayPendingEntryRenewNow = displayPendingEntryExpiredNow and displayPendingTrendStillValid and not displayPendingSoftRecheckFailed and not displayPendingEodCancel and not displayPendingEntryWindowExpired and not displayPendingAnchorInvalidated and not displayPendingOppositeOrConflict
if displayPendingEntryRenewNow
    int displayPendingRenewBars = displayPendingSoftInvalidated ? pendingTrendRecheckBars : entryOrderTtlBars
    displayShadowExpiresBar := bar_index + displayPendingRenewBars
string displayPendingCancelReason = displayPendingEodCancel ? "pending_eod_cancel" : displayPendingOppositeOrConflict ? "opposite_signal_or_conflict" : displayPendingEntryWindowExpired ? "entry_window_expired" : displayPendingAnchorInvalidated ? "entry_anchor_invalidated" : displayPendingTrendInvalidated ? "trend_invalidated" : displayPendingSoftRecheckFailed ? "soft_trend_recheck_failed" : displayPendingEntryExpiredNow and not displayPendingEntryRenewNow ? "entry_ttl_expired" : ""
bool displayPendingCancelNow = showPendingEntryLifecycle and displayPendingCancelReason != ""
if displayPendingCancelNow
    displayShadowEntryTouched := false
    displayShadowEntryExpired := displayPendingEntryExpiredNow
    displayShadowCancelReason := displayPendingCancelReason
    displayShadowPendingEntry := false

int displayLifecycleDirection = displayShadowDirection
string displayLifecycleSetup = displayShadowSetup
float displayLifecycleEntry = displayShadowEntry
float displayLifecycleStop = displayShadowStop
float displayLifecycleTarget = displayShadowTarget
float displayLifecycleRunnerActivation = displayShadowRunnerActivation
int displayLifecycleSignalBar = displayShadowSignalBar
int displayLifecycleExpiresBar = displayShadowExpiresBar

bool displayFlatForEntry = not displayShadowPendingEntry and not displayPendingEntryTouchedNow
bool displayEnterLong = canOpenEntry and displayFlatForEntry and allowLong and longSignalCandidate and not shortSignalCandidate and not blockLong and not conflict
bool displayEnterShort = canOpenEntry and displayFlatForEntry and allowShort and shortSignalCandidate and not longSignalCandidate and not blockShort and not conflict
if showPendingEntryLifecycle and displayEnterLong
    displayShadowPendingEntry := true
    displayShadowEntryTouched := false
    displayShadowEntryExpired := false
    displayShadowDirection := 1
    displayShadowSetup := longSetup
    displayShadowEntry := longEntryCandidate
    displayShadowStop := longStopCandidate
    displayShadowTarget := longTargetCandidate
    displayShadowRunnerActivation := longRunnerActivationCandidate
    displayShadowSignalBar := bar_index
    displayShadowExpiresBar := bar_index + entryOrderTtlBars
    displayShadowCancelReason := ""
if showPendingEntryLifecycle and displayEnterShort
    displayShadowPendingEntry := true
    displayShadowEntryTouched := false
    displayShadowEntryExpired := false
    displayShadowDirection := -1
    displayShadowSetup := shortSetup
    displayShadowEntry := shortEntryCandidate
    displayShadowStop := shortStopCandidate
    displayShadowTarget := shortTargetCandidate
    displayShadowRunnerActivation := shortRunnerActivationCandidate
    displayShadowSignalBar := bar_index
    displayShadowExpiresBar := bar_index + entryOrderTtlBars
    displayShadowCancelReason := ""
bool displayPreAlertNow = canOpenEntry and displayFlatForEntry and not displayEnterLong and not displayEnterShort and activityScore >= preAlertThreshold and activityScore < 100 and not conflict
bool displayObserveNow = displayPreAlertNow
bool pendingDisplayWaiting = showPendingEntryLifecycle and displayShadowPendingEntry
bool pendingDisplayLifecycleVisible = pendingDisplayWaiting or displayPendingEntryTouchedNow or displayPendingCancelNow

bool candidateUpperWindowReady = candidateSetup == "trend_sdUpper" ? longTrendContextReady : candidateSetup == "trend_sdUpperBreakdown" ? upperSdExtremeFresh : candidateSetup == "mr_sdUpper" ? upperMrWindowValid : upperWindowValid
bool candidateLowerWindowReady = candidateSetup == "trend_sdLower" ? shortTrendContextReady : candidateSetup == "trend_sdLowerBreakout" ? lowerSdExtremeFresh : candidateSetup == "trend_emaDeathContinuation" ? shortEmaDeathContinuationStructureOk : candidateSetup == "mr_sdLower" ? lowerMrWindowValid : lowerWindowValid
string candidateComponentText = componentSummaryForSetup(candidateSetup, candidateUpperWindowReady, candidateLowerWindowReady, upperBullTrendTriggerSeen, lowerBearTrendTriggerSeen, trendBullFractalSeen, lowerBullFractalSeen, upperBearFractalSeen, trendBearFractalSeen, trendBearFractalSeen, trendBullEmaCrossSeen, lowerBullEmaCrossSeen, upperBearEmaCrossSeen, trendBearEmaCrossSeen, trendBearEmaCrossSeen, bullDivSeen, bearDivSeen)
string candidateProgressText = componentProgressForSetup(candidateSetup, candidateUpperWindowReady, candidateLowerWindowReady, upperBullTrendTriggerSeen, lowerBearTrendTriggerSeen, trendBullFractalSeen, lowerBullFractalSeen, upperBearFractalSeen, trendBearFractalSeen, trendBearFractalSeen, trendBullEmaCrossSeen, lowerBullEmaCrossSeen, upperBearEmaCrossSeen, trendBearEmaCrossSeen, trendBearEmaCrossSeen, bullDivSeen, bearDivSeen)
string candidateWaitText = waitComponentText(missingComponents)

if flowLabelsVisible and lowerActivationEvent
    string lowerActivateDecisionText = dtpBearDominant ? "\n方向裁决: DTP强空，SD下轨优先顺势空" : ""
    string lowerActivateDetailText = "已入选候选池\n" + syminfo.ticker + " · SD窗口开启\nSD下轨候选\n非开仓点，等组件" + lowerActivateDecisionText
    string lowerActivateCompactText = dtpBearDominant ? "候选 空·SD↓\n顺势优先" : "候选 多·SD↓\n等组件"
    label.new(bar_index, low - atrVal * 1.4, flowLabelText(lowerActivateCompactText, lowerActivateDetailText), style=label.style_label_up, color=flowLabelColor("activate_lower", dtpBearDominant ? "short" : "long"), textcolor=color.white, size=size.small, tooltip=flowLabelTooltip(lowerActivateDetailText))

if flowLabelsVisible and upperActivationEvent
    string upperActivateDecisionText = dtpBullDominant ? "\n方向裁决: DTP强多，SD上轨优先顺势多" : ""
    string upperActivateDetailText = "已入选候选池\n" + syminfo.ticker + " · SD窗口开启\nSD上轨候选\n非开仓点，等组件" + upperActivateDecisionText
    string upperActivateCompactText = dtpBullDominant ? "候选 多·SD↑\n顺势优先" : "候选 空·SD↑\n等组件"
    label.new(bar_index, high + atrVal * 1.4, flowLabelText(upperActivateCompactText, upperActivateDetailText), style=label.style_label_down, color=flowLabelColor("activate_upper", dtpBullDominant ? "long" : "short"), textcolor=color.white, size=size.small, tooltip=flowLabelTooltip(upperActivateDetailText))

var string lastPrepareVisualKey = ""
if isNewTradingDay
    lastPrepareVisualKey := ""
string prepareVisualKey = activityGrade + ":" + candidateDirection + ":" + candidateSetup + ":" + missingComponents + ":" + str.tostring(activityScore, "#")
if flowLabelsVisible and displayObserveNow and prepareVisualKey != lastPrepareVisualKey
    float prepareY = candidateDirection == "short" ? high + atrVal * 2.4 : low - atrVal * 2.4
    string candidateDirectionDecisionText = bullTrendContinuationContext and candidateSetup == "trend_sdUpper" ? "\n方向裁决: DTP强多，SD上轨优先顺势多" : bearTrendContinuationContext and candidateSetup == "trend_sdLower" ? "\n方向裁决: DTP强空，SD下轨优先顺势空" : ""
    string prepareDetailText = "观察" + directionDisplayName(candidateDirection) + "\n" + setupDisplayName(candidateSetup) + candidateDirectionDecisionText + "\n组件: " + candidateComponentText + "\nMTF: " + mtfSummaryForDirection(candidateDirection) + "\n下一步: " + candidateWaitText
    string prepareCompactText = "观察 " + decisionDirectionTag(candidateDirection) + "·" + decisionSetupTag(candidateSetup) + "\n" + decisionComponentLine(candidateProgressText, candidateWaitText)
    label.new(bar_index, prepareY, flowLabelText(prepareCompactText, prepareDetailText), style=flowLabelStyle(candidateDirection), color=color.new(color.orange, flowLabelTransparency), textcolor=color.white, size=size.normal, tooltip=flowLabelTooltip(prepareDetailText))
    lastPrepareVisualKey := prepareVisualKey
if not displayObserveNow and activityScore == 0
    lastPrepareVisualKey := ""

bool diagnosticLongCandidate = canTrade and allowLong and longRaw and not displayEnterLong
bool diagnosticShortCandidate = canTrade and allowShort and shortRaw and not displayEnterShort
bool blockedNow = diagnosticLongCandidate or diagnosticShortCandidate
string blockedDirection = diagnosticLongCandidate and (not diagnosticShortCandidate or candidateDirection == "long") ? "long" : "short"
string blockedSetup = blockedDirection == "long" ? longSetup : shortSetup
string blockedReasonRaw = conflict ? "long_short_conflict" : blockedDirection == "long" ? blockLongReason : blockShortReason
string blockedReason = blockedReasonRaw == "" ? "candidate_filtered" : blockedReasonRaw
bool blockedProfitSpaceEntryBlocked = blockedDirection == "long" ? longProfitSpaceEntryBlocked : shortProfitSpaceEntryBlocked
string blockedProfitSpaceFailureReason = blockedDirection == "long" ? profitSpaceFailureReason(longExpectedNetProfit, longExpectedNetRoiPct, longCostPctOfReward, longTargetDistanceAtr, longStructureRewardRisk, longStructureStopAvailable, longStructureTargetAvailable, effectiveMinStructureRewardRiskForEntry) : profitSpaceFailureReason(shortExpectedNetProfit, shortExpectedNetRoiPct, shortCostPctOfReward, shortTargetDistanceAtr, shortStructureRewardRisk, shortStructureStopAvailable, shortStructureTargetAvailable, effectiveMinStructureRewardRiskForEntry)
bool blockedUpperWindowReady = blockedSetup == "trend_sdUpper" ? longTrendContextReady : blockedSetup == "trend_sdUpperBreakdown" ? upperSdExtremeFresh : blockedSetup == "mr_sdUpper" ? upperMrWindowValid : upperWindowValid
bool blockedLowerWindowReady = blockedSetup == "trend_sdLower" ? shortTrendContextReady : blockedSetup == "trend_sdLowerBreakout" ? lowerSdExtremeFresh : blockedSetup == "trend_emaDeathContinuation" ? shortEmaDeathContinuationStructureOk : blockedSetup == "mr_sdLower" ? lowerMrWindowValid : lowerWindowValid
string blockedComponentText = componentSummaryForSetup(blockedSetup, blockedUpperWindowReady, blockedLowerWindowReady, upperBullTrendTriggerSeen, lowerBearTrendTriggerSeen, trendBullFractalSeen, lowerBullFractalSeen, upperBearFractalSeen, trendBearFractalSeen, trendBearFractalSeen, trendBullEmaCrossSeen, lowerBullEmaCrossSeen, upperBearEmaCrossSeen, trendBearEmaCrossSeen, trendBearEmaCrossSeen, bullDivSeen, bearDivSeen)
float blockedStructureRewardRisk = blockedDirection == "long" ? longStructureRewardRisk : shortStructureRewardRisk
float blockedTargetDistanceAtr = blockedDirection == "long" ? longTargetDistanceAtr : shortTargetDistanceAtr
string blockedProfitSecondaryReason = blockedProfitSpaceEntryBlocked ? profitFailureDisplayName(blockedProfitSpaceFailureReason) : ""
string blockedSecondaryText = blockedProfitSecondaryReason != "" and blockedReason != "profit_space_too_small" and blockedReason != "mr_target_space_too_small" ? "\n次因: " + blockedProfitSecondaryReason : ""
var string lastBlockVisualKey = ""
if isNewTradingDay
    lastBlockVisualKey := ""
string blockedVisualKey = blockedDirection + ":" + blockedSetup + ":" + blockedReason + ":" + blockedComponentText + ":" + mtfStatusForDirection(blockedDirection) + ":" + mtfBlockReasonForDirection(blockedDirection) + ":" + str.tostring(dtpDir, "#") + ":" + dtpPhase + ":" + (blockedProfitSpaceEntryBlocked ? blockedProfitSpaceFailureReason : "none")
if flowLabelsVisible and showSignalDiagnostics and not pendingDisplayWaiting and blockedNow and blockedVisualKey != lastBlockVisualKey
    float blockedY = blockedDirection == "short" ? high + atrVal * 4.0 : low - atrVal * 4.0
    string blockedProfitText = blockedDirection == "long" ? profitSpaceSummaryText(longExpectedNetProfit, longExpectedNetRoiPct, longCostPctOfReward, longTargetDistanceAtr, longStructureRewardRisk) : profitSpaceSummaryText(shortExpectedNetProfit, shortExpectedNetRoiPct, shortCostPctOfReward, shortTargetDistanceAtr, shortStructureRewardRisk)
    string blockedDetailText = "信号过滤\n" + directionDisplayName(blockedDirection) + " · " + setupDisplayName(blockedSetup) + "\n" + entryWindowDiagnosticsText() + "\n组件: " + blockedComponentText + "\n主因: " + filterDisplayName(blockedReason) + blockedSecondaryText + "\n" + filterActionText(blockedReason, blockedDirection) + "\n" + mtfSummaryForDirection(blockedDirection) + "\n" + dtpEntryFilterText(blockedDirection, dtpDir, dtpPhase, dtpMrFilterMode, useDtpFilter) + "\n" + blockedProfitText
    string blockedCompactReasonText = decisionBlockReason(blockedReason, blockedProfitSpaceEntryBlocked ? blockedProfitSpaceFailureReason : "none")
    string blockedCompactMetricText = blockedProfitSpaceEntryBlocked ? " / " + decisionProfitMetricLine(blockedStructureRewardRisk, blockedTargetDistanceAtr) : ""
    string blockedCompactText = "过滤 " + decisionDirectionTag(blockedDirection) + "·" + decisionSetupTag(blockedSetup) + "\n" + blockedCompactReasonText + blockedCompactMetricText
    label.new(bar_index, blockedY, flowLabelText(blockedCompactText, blockedDetailText), style=flowLabelStyle(blockedDirection), color=flowLabelColor("blocked", blockedDirection), textcolor=color.white, size=size.small, tooltip=flowLabelTooltip(blockedDetailText))
    lastBlockVisualKey := blockedVisualKey
if not blockedNow and not longRaw and not shortRaw
    lastBlockVisualKey := ""

if flowLabelsVisible and displayEnterLong
    string directionDecisionLine = longSetup == "trend_sdUpper" and bullTrendContinuationContext ? "\n方向裁决: DTP强多，SD上轨优先顺势多" : ""
    string longEntryDetailText = "信号满足\nCore计划挂多\n" + setupDisplayName(longSetup) + directionDecisionLine + "\n" + entryWindowDiagnosticsText() + "\n组件齐 + 过滤通过\n" + mtfSummaryForDirection("long") + "\n" + dtpEntryFilterText("long", dtpDir, dtpPhase, dtpMrFilterMode, useDtpFilter) + "\nref " + str.tostring(longReferenceEntry, "#.##") + " / plan " + str.tostring(longEntryCandidate, "#.##")
    string longEntryCompactText = "待触及 多·" + decisionSetupTag(longSetup) + " " + str.tostring(longEntryCandidate, "#.##") + "\n" + decisionRiskLine(longEntryCandidate, longStopCandidate, longTargetCandidate, longStructureRewardRisk, longTargetDistanceAtr)
    label.new(bar_index, low - atrVal * 3.1, flowLabelText(longEntryCompactText, longEntryDetailText), style=label.style_label_up, color=flowLabelColor("entry", "long"), textcolor=color.white, size=size.normal, tooltip=flowLabelTooltip(longEntryDetailText))

if flowLabelsVisible and displayEnterShort
    string directionDecisionLine = shortSetup == "trend_sdLower" and bearTrendContinuationContext ? "\n方向裁决: DTP强空，SD下轨优先顺势空" : ""
    string shortEntryDetailText = "信号满足\nCore计划挂空\n" + setupDisplayName(shortSetup) + directionDecisionLine + "\n" + entryWindowDiagnosticsText() + "\n组件齐 + 过滤通过\n" + mtfSummaryForDirection("short") + "\n" + dtpEntryFilterText("short", dtpDir, dtpPhase, dtpMrFilterMode, useDtpFilter) + "\nref " + str.tostring(shortReferenceEntry, "#.##") + " / plan " + str.tostring(shortEntryCandidate, "#.##")
    string shortEntryCompactText = "待触及 空·" + decisionSetupTag(shortSetup) + " " + str.tostring(shortEntryCandidate, "#.##") + "\n" + decisionRiskLine(shortEntryCandidate, shortStopCandidate, shortTargetCandidate, shortStructureRewardRisk, shortTargetDistanceAtr)
    label.new(bar_index, high + atrVal * 3.1, flowLabelText(shortEntryCompactText, shortEntryDetailText), style=label.style_label_down, color=flowLabelColor("entry", "short"), textcolor=color.white, size=size.normal, tooltip=flowLabelTooltip(shortEntryDetailText))

if flowLabelsVisible and showPendingEntryLifecycle and displayPendingEntryTouchedNow
    string pendingDirectionText = displayLifecycleDirection == 1 ? "多" : "空"
    string pendingTouchPriceText = displayLifecycleDirection == 1 ? "low " + str.tostring(low, "#.##") : "high " + str.tostring(high, "#.##")
    string pendingTouchDetailText = "Core模拟触及\n" + directionDisplayName(displayLifecycleDirection == 1 ? "long" : "short") + " · " + setupDisplayName(displayLifecycleSetup) + "\nplan " + str.tostring(displayLifecycleEntry, "#.##") + " / " + pendingTouchPriceText + "\nsignal bar " + str.tostring(displayLifecycleSignalBar, "#") + " / touch bar " + str.tostring(bar_index, "#") + " / TTL " + str.tostring(entryOrderTtlBars, "#") + "\nDisplay shadow，不代表 TV strategy 已成交；真实成交看 Core Strategy Tester / Core entry_fill / 券商订单"
    string pendingTouchCompactText = "Core模拟触及 " + pendingDirectionText + " " + str.tostring(displayLifecycleEntry, "#.##")
    float pendingTouchY = displayLifecycleDirection == 1 ? low - atrVal * 2.0 : high + atrVal * 2.0
    label.new(bar_index, pendingTouchY, flowLabelText(pendingTouchCompactText, pendingTouchDetailText), style=flowLabelStyle(displayLifecycleDirection == 1 ? "long" : "short"), color=flowLabelColor("entry", displayLifecycleDirection == 1 ? "long" : "short"), textcolor=color.white, size=size.small, tooltip=flowLabelTooltip(pendingTouchDetailText))

if flowLabelsVisible and showPendingEntryLifecycle and displayPendingCancelNow
    string pendingDirectionText = displayLifecycleDirection == 1 ? "多" : "空"
    string pendingCancelDetailText = "撤销挂单\n" + directionDisplayName(displayLifecycleDirection == 1 ? "long" : "short") + " · " + setupDisplayName(displayLifecycleSetup) + "\nCore模拟撤销: " + displayPendingCancelReason + "\n原因: " + cancelReasonDisplayName(displayPendingCancelReason) + "\nplan " + str.tostring(displayLifecycleEntry, "#.##") + "\nsignal bar " + str.tostring(displayLifecycleSignalBar, "#") + " / expires bar " + str.tostring(displayLifecycleExpiresBar, "#") + "\nDisplay shadow，仅复刻 Core 挂单生命周期；真实撤单看 Core cancel alert / Strategy Tester / 券商订单"
    string pendingCancelCompactText = "撤销挂单 " + pendingDirectionText + " " + cancelReasonDisplayName(displayPendingCancelReason)
    float pendingCancelY = displayLifecycleDirection == 1 ? low - atrVal * 2.0 : high + atrVal * 2.0
    color displayCancelColor = color.new(displayLifecycleDirection == 1 ? color.orange : color.red, flowLabelTransparency)
    label.new(bar_index, pendingCancelY, flowLabelText(pendingCancelCompactText, pendingCancelDetailText), style=flowLabelStyle(displayLifecycleDirection == 1 ? "long" : "short"), color=displayCancelColor, textcolor=color.white, size=size.small, tooltip=flowLabelTooltip(pendingCancelDetailText))

// -----------------------------------------------------------------------------
// Visuals
// -----------------------------------------------------------------------------
color dtpLineColor = dtpDir == 1 ? color.new(color.aqua, 0) : dtpDir == -1 ? color.new(color.red, 0) : color.new(color.gray, 25)
plot(showEmaFastSlowLines ? emaFast : na, "EMA 20 快线", color=color.new(color.teal, 0))
plot(showEmaFastSlowLines ? emaSlow : na, "EMA 50 慢线", color=color.new(color.orange, 0))
plot(showEmaContextLines ? emaTrend : na, "EMA 100 趋势", color=color.new(color.blue, 35))
plot(showEmaContextLines ? emaLongest : na, "EMA 200 长线", color=color.new(color.gray, 35))
plot(showDtpTrendLine ? dtpAvg : na, "DTP 趋势线", color=dtpLineColor, linewidth=2)
plot(showSdHelperBandLines ? sdReg : na, "SD regression", color=color.new(color.white, 25))
plot(showBandLines ? sdSignalUpper : na, "SD signal upper", color=color.new(color.red, 30))
plot(showBandLines ? sdSignalLower : na, "SD signal lower", color=color.new(color.green, 30))
plot(showSdHelperBandLines ? sdFilterUpper : na, "SD filter upper", color=color.new(color.red, 75))
plot(showSdHelperBandLines ? sdFilterLower : na, "SD filter lower", color=color.new(color.green, 75))

bool showAnyFractalMarkers = showComponentMarkers or showFractalMarkers
plotshape(showComponentMarkers and sdLowerHit, "SD lower hit", location=location.belowbar, style=shape.triangleup, color=color.new(color.green, 0), size=size.tiny, text="SD-L")
plotshape(showComponentMarkers and sdUpperHit, "SD upper hit", location=location.abovebar, style=shape.triangledown, color=color.new(color.orange, 0), size=size.tiny, text="SD-U")
plotshape(showAnyFractalMarkers and fractalBull, "Fractal bull", location=location.belowbar, style=shape.circle, color=color.new(color.aqua, 0), size=size.tiny, text="F+", offset=-fractalPeriod)
plotshape(showAnyFractalMarkers and fractalBear, "Fractal bear", location=location.abovebar, style=shape.circle, color=color.new(color.fuchsia, 0), size=size.tiny, text="F-", offset=-fractalPeriod)
plotshape(showEmaCrossMarkers and emaGoldenCross, "EMA20/50 golden cross", location=location.belowbar, style=shape.triangleup, color=color.new(color.lime, 0), size=size.small, text="20/50金叉")
plotshape(showEmaCrossMarkers and emaDeathCross, "EMA20/50 death cross", location=location.abovebar, style=shape.triangledown, color=color.new(color.red, 0), size=size.small, text="20/50死叉")
plotshape(showComponentMarkers and bullDivNow, "Bull divergence", location=location.belowbar, style=shape.diamond, color=color.new(color.lime, 0), size=size.tiny, text="D+")
plotshape(showComponentMarkers and bearDivNow, "Bear divergence", location=location.abovebar, style=shape.diamond, color=color.new(color.red, 0), size=size.tiny, text="D-")

float displaySignalEntryPlan = displayEnterLong ? longEntryCandidate : displayEnterShort ? shortEntryCandidate : na
float displaySignalStopPlan = displayEnterLong ? longStopCandidate : displayEnterShort ? shortStopCandidate : na
float displaySignalTargetPlan = displayEnterLong ? longTargetCandidate : displayEnterShort ? shortTargetCandidate : na
float displaySignalRunnerActivation = displayEnterLong ? longRunnerActivationCandidate : displayEnterShort ? shortRunnerActivationCandidate : na
float displayEntryPlan = not na(displaySignalEntryPlan) ? displaySignalEntryPlan : pendingDisplayWaiting ? displayLifecycleEntry : na
float displayStopPlan = not na(displaySignalStopPlan) ? displaySignalStopPlan : pendingDisplayWaiting ? displayLifecycleStop : na
float displayTargetPlan = not na(displaySignalTargetPlan) ? displaySignalTargetPlan : pendingDisplayWaiting ? displayLifecycleTarget : na
float displayRunnerActivation = not na(displaySignalRunnerActivation) ? displaySignalRunnerActivation : pendingDisplayWaiting ? displayLifecycleRunnerActivation : na
bool displayPlanLinesActive = showCurrentPlanLines and not na(displayEntryPlan) and not displayPendingEntryTouchedNow and not displayPendingCancelNow
int displayPlanLineStartBar = displayEnterLong or displayEnterShort ? bar_index : displayLifecycleSignalBar
bool historicalPlanSnapshotNow = showHistoricalPlanLines and (displayEnterLong or displayEnterShort) and not na(displaySignalEntryPlan)
var array<line> historicalPlanLines = array.new_line()
var array<int> historicalPlanLineSetSizes = array.new_int()
if historicalPlanSnapshotNow
    int historicalStartBar = bar_index
    int historicalEndBar = bar_index + historicalPlanLineForwardBars
    int historicalLineCount = 0
    line historicalEntryLine = line.new(historicalStartBar, displaySignalEntryPlan, historicalEndBar, displaySignalEntryPlan, color=color.new(color.yellow, 45), width=2)
    array.push(historicalPlanLines, historicalEntryLine)
    historicalLineCount += 1
    if not na(displaySignalStopPlan)
        line historicalStopLine = line.new(historicalStartBar, displaySignalStopPlan, historicalEndBar, displaySignalStopPlan, color=color.new(color.red, 45), width=2)
        array.push(historicalPlanLines, historicalStopLine)
        historicalLineCount += 1
    if not na(displaySignalTargetPlan)
        line historicalTargetLine = line.new(historicalStartBar, displaySignalTargetPlan, historicalEndBar, displaySignalTargetPlan, color=color.new(color.green, 45), width=2)
        array.push(historicalPlanLines, historicalTargetLine)
        historicalLineCount += 1
    if not na(displaySignalRunnerActivation)
        line historicalRunnerLine = line.new(historicalStartBar, displaySignalRunnerActivation, historicalEndBar, displaySignalRunnerActivation, color=color.new(color.blue, 45), width=2)
        array.push(historicalPlanLines, historicalRunnerLine)
        historicalLineCount += 1
    if historicalLineCount > 0
        array.push(historicalPlanLineSetSizes, historicalLineCount)
while array.size(historicalPlanLineSetSizes) > maxHistoricalPlanLineSets
    int oldestLineCount = array.shift(historicalPlanLineSetSizes)
    if oldestLineCount > 0
        for deleteIndex = 0 to oldestLineCount - 1
            if array.size(historicalPlanLines) > 0
                line oldestLine = array.shift(historicalPlanLines)
                line.delete(oldestLine)
var line displayEntryLine = na
var line displayStopLine = na
var line displayTargetLine = na
var line displayRunnerLine = na
if not displayPlanLinesActive
    if not na(displayEntryLine)
        line.delete(displayEntryLine)
        displayEntryLine := na
    if not na(displayStopLine)
        line.delete(displayStopLine)
        displayStopLine := na
    if not na(displayTargetLine)
        line.delete(displayTargetLine)
        displayTargetLine := na
    if not na(displayRunnerLine)
        line.delete(displayRunnerLine)
        displayRunnerLine := na
else
    int planLineStartBar = na(displayPlanLineStartBar) ? bar_index : displayPlanLineStartBar
    int planLineEndBar = bar_index + currentPlanLineForwardBars
    if na(displayEntryLine)
        displayEntryLine := line.new(planLineStartBar, displayEntryPlan, planLineEndBar, displayEntryPlan, color=color.new(color.yellow, 0), width=3)
    else
        line.set_xy1(displayEntryLine, planLineStartBar, displayEntryPlan)
        line.set_xy2(displayEntryLine, planLineEndBar, displayEntryPlan)
        line.set_color(displayEntryLine, color.new(color.yellow, 0))
    if na(displayStopLine)
        displayStopLine := line.new(planLineStartBar, displayStopPlan, planLineEndBar, displayStopPlan, color=color.new(color.red, 0), width=3)
    else
        line.set_xy1(displayStopLine, planLineStartBar, displayStopPlan)
        line.set_xy2(displayStopLine, planLineEndBar, displayStopPlan)
        line.set_color(displayStopLine, color.new(color.red, 0))
    if na(displayTargetLine)
        displayTargetLine := line.new(planLineStartBar, displayTargetPlan, planLineEndBar, displayTargetPlan, color=color.new(color.green, 0), width=3)
    else
        line.set_xy1(displayTargetLine, planLineStartBar, displayTargetPlan)
        line.set_xy2(displayTargetLine, planLineEndBar, displayTargetPlan)
        line.set_color(displayTargetLine, color.new(color.green, 0))
    if na(displayRunnerActivation)
        if not na(displayRunnerLine)
            line.delete(displayRunnerLine)
            displayRunnerLine := na
    else if na(displayRunnerLine)
        displayRunnerLine := line.new(planLineStartBar, displayRunnerActivation, planLineEndBar, displayRunnerActivation, color=color.new(color.blue, 0), width=3)
    else
        line.set_xy1(displayRunnerLine, planLineStartBar, displayRunnerActivation)
        line.set_xy2(displayRunnerLine, planLineEndBar, displayRunnerActivation)
        line.set_color(displayRunnerLine, color.new(color.blue, 0))

var table flowStatus = table.new(position.top_right, 2, 7, border_width=1)
string pendingDisplayStatus = displayPendingEntryTouchedNow ? "Core模拟触及" : displayPendingCancelNow ? "撤销挂单" : pendingDisplayWaiting ? "Core挂单中" : ""
string pendingDisplayDirectionName = displayLifecycleDirection == 1 ? "做多" : displayLifecycleDirection == -1 ? "做空" : "--"
string pendingDisplayDirectionKey = displayLifecycleDirection == 1 ? "long" : displayLifecycleDirection == -1 ? "short" : ""
string statusDirection = displayEnterShort ? "做空" : displayEnterLong ? "做多" : pendingDisplayStatus != "" ? pendingDisplayDirectionName : blockedNow ? directionDisplayName(blockedDirection) : activityScore > 0 ? directionDisplayName(candidateDirection) : "--"
string statusText = displayEnterLong or displayEnterShort ? "Core挂单中" : pendingDisplayStatus != "" ? pendingDisplayStatus : blockedNow ? "过滤" + directionDisplayName(blockedDirection) : displayObserveNow ? "观察" + directionDisplayName(candidateDirection) : lowerWindowValid or upperWindowValid ? "窗口激活" : "等待"
color statusColor = displayEnterLong ? flowStatusColor("entry", "long") : displayEnterShort ? flowStatusColor("entry", "short") : pendingDisplayStatus != "" and displayPendingCancelNow ? flowStatusColor("blocked", pendingDisplayDirectionKey) : pendingDisplayStatus != "" ? flowStatusColor("entry", pendingDisplayDirectionKey) : blockedNow ? flowStatusColor("blocked", blockedDirection) : displayObserveNow ? color.new(color.orange, 0) : lowerWindowValid ? flowStatusColor("activate_lower", dtpBearDominant ? "short" : "long") : upperWindowValid ? flowStatusColor("activate_upper", dtpBullDominant ? "long" : "short") : color.new(color.gray, 20)
string statusSetup = pendingDisplayStatus != "" ? setupDisplayName(displayLifecycleSetup) : blockedNow ? setupDisplayName(blockedSetup) : activityScore > 0 ? setupDisplayName(candidateSetup) : "--"
string statusComponents = pendingDisplayStatus != "" ? displayPendingCancelNow ? "撤销挂单: " + cancelReasonDisplayName(displayPendingCancelReason) : "成交确认看 Core" : blockedNow ? blockedComponentText + " · " + filterActionText(blockedReason, blockedDirection) : activityScore > 0 ? candidateComponentText + " · " + candidateWaitText : "--"
string statusDtp = dtpStateText(dtpDir, dtpPhase)
string statusMtf = pendingDisplayStatus != "" ? "Display shadow / Core entry_fill" : blockedNow ? mtfSummaryForDirection(blockedDirection) : activityScore > 0 ? mtfSummaryForDirection(candidateDirection) : enableMtf ? "MTF 等待信号" : "off"
string planLineLegend = showCurrentPlanLines or showHistoricalPlanLines ? " / 黄Plan 红SL 绿TP 蓝Runner" : ""
string statusRiskBase = displayEnterLong ? "plan " + str.tostring(longEntryCandidate, "#.##") + " / TP " + str.tostring(longTargetCandidate, "#.##") + " / SL " + str.tostring(longStopCandidate, "#.##") : displayEnterShort ? "plan " + str.tostring(shortEntryCandidate, "#.##") + " / TP " + str.tostring(shortTargetCandidate, "#.##") + " / SL " + str.tostring(shortStopCandidate, "#.##") : pendingDisplayStatus != "" ? "plan " + str.tostring(displayLifecycleEntry, "#.##") + " / TP " + str.tostring(displayLifecycleTarget, "#.##") + " / SL " + str.tostring(displayLifecycleStop, "#.##") : "--"
string statusRisk = statusRiskBase == "--" ? statusRiskBase : statusRiskBase + planLineLegend
if confirmed and showStatusPanel
    table.cell(flowStatus, 0, 0, "流程", bgcolor=statusColor, text_color=color.white)
    table.cell(flowStatus, 1, 0, statusText, bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(flowStatus, 0, 1, "标的", bgcolor=color.new(color.black, 15), text_color=color.white)
    table.cell(flowStatus, 1, 1, syminfo.ticker + " · " + timeframe.period, bgcolor=color.new(color.black, 15), text_color=color.white)
    table.cell(flowStatus, 0, 2, "方向", bgcolor=color.new(color.black, 15), text_color=color.white)
    table.cell(flowStatus, 1, 2, statusDirection, bgcolor=color.new(color.black, 15), text_color=color.white)
    table.cell(flowStatus, 0, 3, "Setup", bgcolor=color.new(color.black, 15), text_color=color.white)
    table.cell(flowStatus, 1, 3, statusSetup, bgcolor=color.new(color.black, 15), text_color=color.white)
    table.cell(flowStatus, 0, 4, "组件", bgcolor=color.new(color.black, 15), text_color=color.white)
    table.cell(flowStatus, 1, 4, statusComponents, bgcolor=color.new(color.black, 15), text_color=color.white)
    table.cell(flowStatus, 0, 5, "DTP/MTF", bgcolor=color.new(color.black, 15), text_color=color.white)
    table.cell(flowStatus, 1, 5, statusDtp + " / " + statusMtf, bgcolor=color.new(color.black, 15), text_color=color.white)
    table.cell(flowStatus, 0, 6, "计划", bgcolor=color.new(color.black, 15), text_color=color.white)
    table.cell(flowStatus, 1, 6, statusRisk, bgcolor=color.new(color.black, 15), text_color=color.white)
