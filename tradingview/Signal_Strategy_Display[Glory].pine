    lastBottomFailureWatchLow := low
    lastBottomFailureWatchBase := bottomZoneLow
    lastBottomFailureWatchBodyMid := (open + close) * 0.5
    lastBottomFailureWatchVolumeProbe := volumeAttackDown or (volumeRatio >= highAttackVolumeMult and close <= open)
    bottomNoSupplyStreak := 0
    lastBottomNoSupplyBar := na
    lastBottomNoSupplyHigh := na
    lastBottomNoSupplyLow := na
bool bottomNakedTouchEvent = confirmed and dayRangeClear and strongBottomProbeZone and bottomAnchorReady and bottomRetestBand and (na(lastBottomFailureWatchBar) or bar_index - lastBottomFailureWatchBar > failedBreakConfirmBars)
if bottomNakedTouchEvent
    lastBottomFailureWatchBar := bar_index
    lastBottomFailureWatchHigh := high
    lastBottomFailureWatchLow := low
    lastBottomFailureWatchBase := bottomWeakBase
    lastBottomFailureWatchBodyMid := (open + close) * 0.5
    lastBottomFailureWatchVolumeProbe := volumeAttackDown or (volumeRatio >= highAttackVolumeMult and close <= open)
    bottomNoSupplyStreak := 0
    lastBottomNoSupplyBar := na
    lastBottomNoSupplyHigh := na
    lastBottomNoSupplyLow := na
float barsSinceBottomSweep = not na(lastBottomSweepBar) ? (bar_index - lastBottomSweepBar) * 1.0 : na
bool recentBottomSweepWindow = not na(barsSinceBottomSweep) and barsSinceBottomSweep <= failedBreakConfirmBars
bool lowerStrongClose = closePosition >= exhaustionClosePosLongMin or close > open
bool bottomWeakStructureReady = strongBottomProbeZone and bottomAnchorReady and bottomRetestBand
bool bottomWeakNewLowEvent = confirmed and dayRangeClear and bottomWeakStructureReady and not na(bottomWeakBase) and low < bottomWeakBase - tickBuffer and not na(bottomWeakExtensionAtr) and bottomWeakExtensionAtr <= weakNewExtremeMaxExtendAtr
if bottomWeakNewLowEvent
    lastWeakNewLowBar := bar_index
    lastWeakNewLowHigh := high
    lastWeakNewLowLow := low
float barsSinceWeakNewLow = not na(lastWeakNewLowBar) ? (bar_index - lastWeakNewLowBar) * 1.0 : na
bool recentWeakNewLowWindow = not na(barsSinceWeakNewLow) and barsSinceWeakNewLow <= weakNewExtremeConfirmBars
bool bottomWeakVolumeQuiet = volumeRatio <= weakNewExtremeMaxVolumeRatio
bool bottomWeakVolumeDropped = na(lastAttackDownVolume) ? bottomWeakVolumeQuiet : barVolume <= lastAttackDownVolume * weakNewExtremeVolumeDropRatio
bool bottomWeakNewLowWatch = bottomWeakNewLowEvent and bottomWeakVolumeQuiet and bottomWeakVolumeDropped and bottomMomentumDecayed
bool bottomWeakCloseBack = not na(bottomWeakBase) and close >= bottomWeakBase - atr * weakNewExtremeCloseBackAtr
float bottomAccumulationDistanceAtr = not na(bottomWeakBase) and atr > 0.0 ? math.abs(close - bottomWeakBase) / atr : na
bool bottomWeakNewLowConfirmed = bottomWeakNewLowWatch and (bottomWeakCloseBack or lowerStrongClose)
bool bottomAccumulationRiseConfirmed = confirmed and recentWeakNewLowWindow and volumeRatio >= distributionDropVolumeMult and close > open and closePosition >= 1.0 - distributionDropClosePosMax and (bottomWeakCloseBack or not na(lastWeakNewLowHigh) and close > lastWeakNewLowHigh) and not na(bottomAccumulationDistanceAtr) and bottomAccumulationDistanceAtr <= distributionDropMaxDistanceAtr
float barsSinceBottomFailureWatch = not na(lastBottomFailureWatchBar) ? (bar_index - lastBottomFailureWatchBar) * 1.0 : na
bool recentBottomFailureWatchWindow = not na(barsSinceBottomFailureWatch) and barsSinceBottomFailureWatch > 0.0 and barsSinceBottomFailureWatch <= failedBreakConfirmBars
bool bottomHighVolumeRiseCloseBack = not na(lastBottomFailureWatchBase) and close >= lastBottomFailureWatchBase + atr * failedBreakCloseBackAtr
bool bottomHighVolumeRiseBreakHigh = not na(lastBottomFailureWatchHigh) and close > lastBottomFailureWatchHigh
float bottomHighVolumeRiseDistanceAtr = not na(lastBottomFailureWatchBase) and atr > 0.0 ? math.abs(close - lastBottomFailureWatchBase) / atr : na
bool bottomHighVolumeRiseConfirmed = confirmed and bottomPullbackArmed and recentBottomFailureWatchWindow and lastBottomFailureWatchVolumeProbe and close > open and (closePosition >= 1.0 - distributionDropClosePosMax or not na(lastBottomFailureWatchBodyMid) and close >= lastBottomFailureWatchBodyMid) and (bottomHighVolumeRiseCloseBack or bottomHighVolumeRiseBreakHigh or not na(lastBottomFailureWatchBodyMid) and close >= lastBottomFailureWatchBodyMid) and not na(bottomHighVolumeRiseDistanceAtr) and bottomHighVolumeRiseDistanceAtr <= distributionDropMaxDistanceAtr
bool bottomHighVolumeProbeWatch = confirmed and bottomPullbackArmed and recentBottomFailureWatchWindow and not bottomHighVolumeRiseConfirmed and volumeRatio >= highAttackVolumeMult and close <= open and not na(lastBottomFailureWatchBase) and low <= lastBottomFailureWatchBase + atr * probeRetestBandAtr
if bottomHighVolumeProbeWatch
    lastBottomFailureWatchBar := bar_index
    lastBottomFailureWatchHigh := high
    lastBottomFailureWatchLow := low
    lastBottomFailureWatchBodyMid := (open + close) * 0.5
    lastBottomFailureWatchVolumeProbe := true
    bottomNoSupplyStreak := 0
    lastBottomNoSupplyBar := na
    lastBottomNoSupplyHigh := na
    lastBottomNoSupplyLow := na
float bottomPressureWick = math.min(open, close) - low
float bottomPressureBody = math.abs(close - open)
bool bottomPressureWeak = close > open or closePosition >= 0.45 or bottomPressureWick >= bottomPressureBody
bool bottomNoSupplyWatch = confirmed and bottomPullbackArmed and recentBottomFailureWatchWindow and not bottomHighVolumeRiseConfirmed and volumeRatio < distributionDropVolumeMult and not na(lastBottomFailureWatchBase) and low <= lastBottomFailureWatchBase + atr * probeRetestBandAtr and bottomPressureWeak
if bottomNoSupplyWatch
    bottomNoSupplyStreak := bottomNoSupplyStreak + 1
    lastBottomNoSupplyBar := bar_index
    lastBottomNoSupplyHigh := na(lastBottomNoSupplyHigh) ? high : math.max(lastBottomNoSupplyHigh, high)
    lastBottomNoSupplyLow := na(lastBottomNoSupplyLow) ? low : math.min(lastBottomNoSupplyLow, low)
else if confirmed and not na(lastBottomNoSupplyBar) and bar_index - lastBottomNoSupplyBar > failedBreakConfirmBars
    bottomNoSupplyStreak := 0
    lastBottomNoSupplyBar := na
    lastBottomNoSupplyHigh := na
    lastBottomNoSupplyLow := na
float barsSinceBottomNoSupply = not na(lastBottomNoSupplyBar) ? (bar_index - lastBottomNoSupplyBar) * 1.0 : na
bool recentBottomNoSupplyWindow = not na(barsSinceBottomNoSupply) and barsSinceBottomNoSupply > 0.0 and barsSinceBottomNoSupply <= failedBreakConfirmBars
float bottomNoSupplyDistanceAtr = not na(lastBottomFailureWatchBase) and atr > 0.0 ? math.abs(close - lastBottomFailureWatchBase) / atr : na
bool bottomNoSupplyBreakConfirmed = confirmed and bottomPullbackArmed and recentBottomNoSupplyWindow and bottomNoSupplyStreak >= 2 and close > open and not na(lastBottomNoSupplyHigh) and close > lastBottomNoSupplyHigh and not na(bottomNoSupplyDistanceAtr) and bottomNoSupplyDistanceAtr <= distributionDropMaxDistanceAtr
bool bottomDirectSweepFailed = confirmed and bottomSweptStructure and close > bottomZoneLow + atr * failedBreakCloseBackAtr
bool bottomRecentSweepFailed = confirmed and not bottomDirectSweepFailed and recentBottomSweepWindow and close > bottomZoneLow + atr * failedBreakCloseBackAtr and lowerStrongClose
bool bottomSweepFailed = bottomDirectSweepFailed or bottomRecentSweepFailed
bool bottomHighVolumeFailedBreak = bottomSweepFailed and (volumeExpanded or lastBottomSweepVolumeAttack)
bool lowerNoVolumeExpansion = volumeRatio <= exhaustionVolumeMaxRatio
if confirmed
    bottomDecayStreak := bottomRightShoulder and bottomRetestBand and lowerNoVolumeExpansion and bottomMomentumDecayed ? bottomDecayStreak + 1 : 0
bool bottomMomentumDecayReady = bottomDecayStreak >= exhaustionDecayConfirmBars
bool lowerExhaustionZone = dayRangeClear and bottomRightShoulder and bottomRetestBand and lowerNoVolumeExpansion and bottomMomentumDecayReady
bool lowerExhaustionConfirmedLong = confirmed and lowerExhaustionZone and lowerStrongClose
string bottomExhaustionReason = not dayRangeFormed ? "day_range_not_formed" : not dayRangeClear ? "day_range_too_small" : not bottomMiddleSwingReady ? "middle_pullback_not_enough" : not bottomRightRetestReady ? "right_retest_too_small" : not bottomRetestBand ? "retest_not_near_prior_low" : not lowerNoVolumeExpansion ? "volume_not_exhausted" : not bottomMomentumDecayed ? "momentum_not_decayed" : not bottomMomentumDecayReady ? "momentum_decay_not_continuous" : not lowerStrongClose ? "no_strong_close_confirm" : "lower_exhaustion_confirmed"
bool bottomConfirmedLong = bottomSweepFailed or lowerExhaustionConfirmedLong or bottomWeakNewLowConfirmed or bottomAccumulationRiseConfirmed or bottomHighVolumeRiseConfirmed or bottomNoSupplyBreakConfirmed
bottomProbePattern := bottomHighVolumeRiseConfirmed ? "naked_low_volume_reversal_long" : bottomNoSupplyBreakConfirmed ? "naked_low_decay_break_long" : bottomAccumulationRiseConfirmed ? "accumulation_rise_long" : bottomWeakNewLowConfirmed ? "weak_new_low_long" : bottomNoSupplyWatch ? "naked_low_decay_watch" : bottomHighVolumeProbeWatch ? "naked_low_volume_watch" : bottomNakedTouchEvent ? "naked_low_watch" : bottomWeakNewLowWatch ? "weak_new_low_watch" : bottomProbePattern
bool bottomPredictVolumeOk = true
bool bottomConfirmVolumeOk = bottomSweepFailed or bottomHighVolumeRiseConfirmed or bottomNoSupplyBreakConfirmed or bottomHighVolumeFailedBreak or lowerExhaustionConfirmedLong or bottomWeakNewLowConfirmed or bottomAccumulationRiseConfirmed
string bottomVolumeReason = bottomHighVolumeRiseConfirmed ? "naked_low_volume_reversal_confirmed" : bottomNoSupplyBreakConfirmed ? "naked_low_decay_break_confirmed" : bottomAccumulationRiseConfirmed ? "accumulation_rise_confirmed" : bottomWeakNewLowConfirmed ? "weak_new_low_confirmed" : bottomRecentSweepFailed ? "recent_failed_break" : bottomHighVolumeFailedBreak ? "high_volume_failed_break_ok" : lowerExhaustionConfirmedLong ? "low_volume_momentum_decay_ok" : volumeQuietRetest ? "low_volume_retest_ok" : "normal_volume_retest_ok"
float bottomConfirmEntry = bottomConfirmedLong ? math.min(close, bottomZoneHigh + atr * predictiveEntryOffsetAtr) : na
float bottomFailureWatchStop = math.min(nz(lastBottomFailureWatchLow, low), low) - invalidationBuffer
float bottomNoSupplyStop = math.min(nz(lastBottomNoSupplyLow, low), low) - invalidationBuffer
float bottomConfirmStop = bottomConfirmedLong ? (bottomNoSupplyBreakConfirmed ? bottomNoSupplyStop : bottomHighVolumeRiseConfirmed ? bottomFailureWatchStop : math.min(low, bottomZoneLow) - invalidationBuffer) : na
bool bottomPredictContext = (bottomFirstExhaustion or bottomRightShoulder) and bottomCounterTrendAllowed and bottomPredictEntry <= close and close - bottomPredictEntry <= atr * predictionArmDistanceAtr and bottomSignalGapOk and bottomPredictVolumeOk
bool bottomConfirmContext = bottomConfirmedLong and (bottomCounterTrendAllowed or lowerExhaustionConfirmedLong or bottomWeakNewLowConfirmed or bottomAccumulationRiseConfirmed or bottomHighVolumeRiseConfirmed or bottomNoSupplyBreakConfirmed) and bottomSignalGapOk and bottomConfirmVolumeOk
float bottomPredictQty = calcTrialQty(bottomPredictEntry, bottomPredictStop, predictiveMaxRiskDollars)
float bottomConfirmQty = calcTrialQty(bottomConfirmEntry, bottomConfirmStop, confirmedMaxRiskDollars)
bool bottomPredictAllowed = bottomPredictContext and smallStopTrialAllowed(bottomPredictEntry, bottomPredictStop, atr, predictiveMaxRiskDollars, predictiveMaxStopAtr, predictiveMaxStopBps) and bottomPredictQty >= 1.0
bool bottomConfirmAllowed = bottomConfirmContext and smallStopTrialAllowed(bottomConfirmEntry, bottomConfirmStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps) and bottomConfirmQty >= 1.0
string bottomProbeFilterReason = na(todayStructLow) ? "no_today_struct_low" : not dayRangeFormed ? "day_range_not_formed" : not dayRangeClear ? "day_range_too_small" : not strongBottomProbeZone ? "no_clear_structure" : bottomAnchorAgeBars < probeMinAnchorAgeBars ? "anchor_too_fresh" : not bottomVisualLeftOk ? "left_leg_too_small" : not bottomMiddleSwingReady ? "middle_leg_too_small" : not bottomPullbackArmed ? "pullback_not_enough" : not bottomRetestBand ? "not_retest_zone" : dominantTrendShort and not lowerExhaustionConfirmedLong and not bottomHighVolumeRiseConfirmed and not bottomNoSupplyBreakConfirmed ? "blocked_by_dominant_bear_trend" : not bottomSignalBarsOk ? "signal_bars_too_close" : not bottomSignalPriceGapOk ? "micro_structure_too_close" : "passed"

bool trendLongConfirmNow = trendLongConfirmAllowed and not upperExhaustionZone
bool trendLongPredictNow = false
bool trendShortConfirmNow = trendShortConfirmAllowed and not lowerExhaustionZone
bool trendShortPredictNow = false
bool longActionable = trendLongConfirmNow or bottomConfirmAllowed
bool shortActionable = trendShortConfirmNow or topConfirmAllowed
bool bottomWeakLongAllowed = bottomConfirmAllowed and (bottomWeakNewLowConfirmed or bottomAccumulationRiseConfirmed or bottomHighVolumeRiseConfirmed or bottomNoSupplyBreakConfirmed)
bool topWeakShortAllowed = topConfirmAllowed and (topWeakNewHighConfirmed or topDistributionDropConfirmed or topFailureRepeatShort)
int longScore = trendLongConfirmNow ? 160 + trendSupportCount : bottomConfirmAllowed ? (bottomWeakLongAllowed ? 145 : 140) + bottomCount : 0
int shortScore = trendShortConfirmNow ? 160 + trendResistanceCount : topConfirmAllowed ? (topWeakShortAllowed ? 145 : 140) + topCount : 0
bool conflict = longActionable and shortActionable and longScore == shortScore
bool selectedLong = longActionable and not conflict and (not shortActionable or longScore > shortScore)
bool selectedShort = shortActionable and not conflict and (not longActionable or shortScore > longScore)
int selectedDirection = selectedLong ? 1 : selectedShort ? -1 : 0
string selectedSetup = selectedLong ? (trendLongConfirmNow ? "trend_support_long" : "probe_2b_bottom_long") : selectedShort ? (trendShortConfirmNow ? "trend_resistance_short" : "probe_2b_top_short") : "none"
bool selectedTrendSupport = selectedSetup == "trend_support_long"
bool selectedTrendResistance = selectedSetup == "trend_resistance_short"
bool selectedTopProbe = selectedSetup == "probe_2b_top_short"
bool selectedBottomProbe = selectedSetup == "probe_2b_bottom_long"
string selectedEntryIntent = selectedDirection != 0 ? "confirmed_limit" : "none"
string selectedTrialRiskMode = selectedDirection != 0 ? "full" : "none"
float selectedEntry = selectedLong ? (trendLongConfirmNow ? trendLongConfirmEntry : bottomConfirmEntry) : selectedShort ? (trendShortConfirmNow ? trendShortConfirmEntry : topConfirmEntry) : na
float selectedStop = selectedLong ? (trendLongConfirmNow ? trendLongConfirmStop : bottomConfirmStop) : selectedShort ? (trendShortConfirmNow ? trendShortConfirmStop : topConfirmStop) : na
float selectedQty = selectedLong ? (trendLongConfirmNow ? trendLongConfirmQty : bottomConfirmQty) : selectedShort ? (trendShortConfirmNow ? trendShortConfirmQty : topConfirmQty) : 0.0
float selectedZoneLow = selectedLong ? (selectedTrendSupport ? trendSupportZoneLow : bottomZoneLow) : selectedShort ? (selectedTrendResistance ? trendResistanceZoneLow : topZoneLow) : na
float selectedZoneHigh = selectedLong ? (selectedTrendSupport ? trendSupportZoneHigh : bottomZoneHigh) : selectedShort ? (selectedTrendResistance ? trendResistanceZoneHigh : topZoneHigh) : na
float selectedPredictionLevel = selectedDirection == 1 ? selectedZoneLow : selectedZoneHigh
float selectedInvalidation = selectedStop
float selectedRiskBudget = selectedDirection != 0 ? confirmedMaxRiskDollars : na
float selectedMaxStopAtr = selectedDirection != 0 ? confirmedMaxStopAtr : na
float selectedMaxStopBps = selectedDirection != 0 ? confirmedMaxStopBps : na
float selectedActivationR = selectedDirection != 0 ? confirmedRunnerActivationR : na
float selectedRunnerActivation = selectedDirection != 0 ? calcTargetAtR(selectedEntry, selectedStop, selectedDirection, selectedActivationR) : na
float selectedTargetByR = selectedDirection != 0 ? calcTargetAtR(selectedEntry, selectedStop, selectedDirection, runnerSafetyR) : na
float topProbeTargetBase = na(lowSinceStructHigh[1]) ? lowSinceStructHigh : lowSinceStructHigh[1]
float bottomProbeTargetBase = na(highSinceStructLow[1]) ? highSinceStructLow : highSinceStructLow[1]
float selectedStructureTargetBase = selectedLong ? (selectedTrendSupport ? todayStructHigh : bottomProbeTargetBase) : selectedShort ? (selectedTrendResistance ? todayStructLow : topProbeTargetBase) : na
float selectedTarget = selectedDirection != 0 ? structureSafetyTarget(selectedEntry, selectedTargetByR, selectedDirection, selectedStructureTargetBase, invalidationBuffer) : na
float selectedStopDistanceAtr = stopDistanceAtr(selectedEntry, selectedStop, atr)
float selectedStopDistanceBps = stopDistanceBps(selectedEntry, selectedStop)
float selectedExpectedR = selectedDirection != 0 and riskPerShare(selectedEntry, selectedStop) > 0.0 ? math.abs(selectedTarget - selectedEntry) / riskPerShare(selectedEntry, selectedStop) : na
bool selectedExpectedRPassed = selectedDirection != 0 and selectedExpectedR >= minExpectedR
bool selectedSmallStopGatePassed = selectedDirection != 0 and smallStopTrialAllowed(selectedEntry, selectedStop, atr, selectedRiskBudget, selectedMaxStopAtr, selectedMaxStopBps)
string selectedSmallStopGateReason = selectedDirection == 0 ? "no_candidate" : smallStopGateReason(selectedEntry, selectedStop, atr, selectedRiskBudget, selectedMaxStopAtr, selectedMaxStopBps)
float selectedStructureAnchor = selectedTrendSupport ? trendSupportBasis : selectedTrendResistance ? trendResistanceBasis : selectedTopProbe ? todayStructHigh : selectedBottomProbe ? todayStructLow : na
bool selectedStructureClear = selectedTrendSupport ? trendLongContext and strongTrendSupport : selectedTrendResistance ? trendShortContext and strongTrendResistance : selectedTopProbe ? strongTopProbeZone and topConfirmedShort : selectedBottomProbe ? strongBottomProbeZone and bottomConfirmedLong : false
string selectedProbePattern = selectedTopProbe ? topProbePattern : selectedBottomProbe ? bottomProbePattern : "none"
string selectedProbeFilterReason = selectedTopProbe ? topProbeFilterReason : selectedBottomProbe ? bottomProbeFilterReason : "none"
float selectedProbeAnchorAgeBars = selectedTopProbe ? topAnchorAgeBars * 1.0 : selectedBottomProbe ? bottomAnchorAgeBars * 1.0 : na
float selectedProbePullbackAtr = selectedTopProbe ? topPullbackAtr : selectedBottomProbe ? bottomPullbackAtr : na
bool selectedProbePullbackArmed = selectedTopProbe ? topPullbackArmed : selectedBottomProbe ? bottomPullbackArmed : false
float selectedProbeRetestGapBars = selectedTopProbe and not na(lowSinceStructHighBar) ? (bar_index - lowSinceStructHighBar) * 1.0 : selectedBottomProbe and not na(highSinceStructLowBar) ? (bar_index - highSinceStructLowBar) * 1.0 : na
float selectedProbeLeftLegBps = selectedTopProbe ? topLeftLegBps : selectedBottomProbe ? bottomLeftLegBps : na
float selectedProbeMiddleRatio = selectedTopProbe ? topMiddleRetraceRatio : selectedBottomProbe ? bottomMiddleRetraceRatio : na
float selectedProbeRightRatio = selectedTopProbe ? topRightRetestRatio : selectedBottomProbe ? bottomRightRetestRatio : na
string selectedVolumeReason = selectedTopProbe ? topVolumeReason : selectedBottomProbe ? bottomVolumeReason : "none"
float selectedVolumeRatio = selectedTopProbe or selectedBottomProbe ? volumeRatio : na
float selectedClosePosition = selectedTopProbe or selectedBottomProbe ? closePosition : na
float selectedMomentumDecayRatio = selectedTopProbe ? topMomentumDecayRatio : selectedBottomProbe ? bottomMomentumDecayRatio : na
float selectedPriorLevelDistanceAtr = selectedTopProbe ? topPriorLevelDistanceAtr : selectedBottomProbe ? bottomPriorLevelDistanceAtr : na
float selectedMomentumDecayStreak = selectedTopProbe ? topDecayStreak * 1.0 : selectedBottomProbe ? bottomDecayStreak * 1.0 : na
float selectedMomentumDecayConfirmBars = selectedTopProbe or selectedBottomProbe ? exhaustionDecayConfirmBars * 1.0 : na
bool selectedAttackVolumeCooling = selectedTopProbe ? attackUpCooling : selectedBottomProbe ? attackDownCooling : selectedDirection == -1 ? attackUpCooling : selectedDirection == 1 ? attackDownCooling : false
float selectedAttackVolumeCooldownBars = selectedDirection != 0 ? attackVolumeCooldownBars * 1.0 : na
bool selectedStructureBreakAccepted = selectedTopProbe ? upperStructureBreakAccepted : selectedBottomProbe ? lowerStructureBreakAccepted : false
float selectedStructureBreakAcceptBars = selectedTopProbe or selectedBottomProbe ? structureBreakAcceptBars * 1.0 : na
string selectedExhaustionSide = selectedTopProbe ? "upper" : selectedBottomProbe ? "lower" : "none"
bool selectedExhaustionConfirmed = selectedTopProbe ? upperExhaustionConfirmedShort : selectedBottomProbe ? lowerExhaustionConfirmedLong : false
string selectedExhaustionReason = selectedTopProbe ? topExhaustionReason : selectedBottomProbe ? bottomExhaustionReason : "none"
string selectedLevelRole = selectedTrendSupport ? "trend_pullback_support" : selectedTrendResistance ? "trend_pullback_resistance" : selectedTopProbe and upperExhaustionZone ? "prior_high_second_test_exhaustion" : selectedBottomProbe and lowerExhaustionZone ? "prior_low_second_test_exhaustion" : "structure_probe"
float selectedProbeAnchorPrice = selectedTopProbe ? todayStructHigh : selectedBottomProbe ? todayStructLow : na
string trendStructDir = strongStructTrendLong ? "bull_HH_HL" : strongStructTrendShort ? "bear_LL_LH" : dominantTrendLong ? "dominant_bull" : dominantTrendShort ? "dominant_bear" : "none"
string selectedTrendStructPattern = selectedTrendSupport ? "HH_HL" : selectedTrendResistance ? "LL_LH" : "none"
string selectedTrendSources = selectedTrendSupport ? trendSupportSources : selectedTrendResistance ? trendResistanceSources : "none"
string selectedMainReason = selectedTrendSupport ? "clear_bull_pullback_to_support" : selectedTrendResistance ? "clear_bear_rebound_to_resistance" : selectedTopProbe ? (topVolumeClimaxFailedBreakConfirmed ? "new_high_volume_climax_failed" : topHighVolumeDropConfirmed ? "naked_high_volume_reversal" : topImmediateReversalShort ? "naked_high_immediate_reversal" : topNoDemandBreakConfirmed ? "naked_high_decay_break" : topDistributionDropConfirmed ? "new_high_distribution_drop" : topWeakNewHighConfirmed ? "weak_new_high_confirmed" : upperExhaustionConfirmedShort ? "prior_high_second_test_momentum_decay" : "today_struct_high_probe_failed_breakout") : selectedBottomProbe ? (bottomHighVolumeRiseConfirmed ? "naked_low_volume_reversal" : bottomNoSupplyBreakConfirmed ? "naked_low_decay_break" : bottomAccumulationRiseConfirmed ? "new_low_accumulation_rise" : bottomWeakNewLowConfirmed ? "weak_new_low_confirmed" : lowerExhaustionConfirmedLong ? "prior_low_second_test_momentum_decay" : "today_struct_low_probe_failed_breakout") : "none"
string selectedSecondaryReason = selectedTrendSupport ? trendSupportSources : selectedTrendResistance ? trendResistanceSources : selectedTopProbe ? topSources : selectedBottomProbe ? bottomSources : "none"

bool inEntryWindow = not useIntradayEntryWindow or not na(time(timeframe.period, entrySession))
float selectedLastSameSidePlanPrice = selectedDirection == 1 ? lastLongPlanPrice : selectedDirection == -1 ? lastShortPlanPrice : na
float selectedSameSideSignalDistanceAtr = not na(selectedLastSameSidePlanPrice) and atr > 0.0 ? math.abs(selectedEntry - selectedLastSameSidePlanPrice) / atr : na
bool selectedFailureReentry = selectedTopProbe and topFailureRepeatShort
bool selectedSameSideSignalFarEnough = selectedDirection == 0 or selectedFailureReentry or na(selectedSameSideSignalDistanceAtr) or selectedSameSideSignalDistanceAtr >= minSameSideSignalSeparationAtr
float selectedAnyPlanGapBars = na(lastAnyPlanBar) ? na : (bar_index - lastAnyPlanBar) * 1.0
float selectedAnyPlanDistanceAtr = not na(lastAnyPlanPrice) and atr > 0.0 ? math.abs(selectedEntry - lastAnyPlanPrice) / atr : na
bool selectedAnyPlanFarEnough = selectedDirection == 0 or selectedFailureReentry or na(selectedAnyPlanGapBars) or (selectedAnyPlanGapBars >= minAnyPlanGapBars and selectedAnyPlanDistanceAtr >= minAnyPlanDistanceAtr)
bool selectedPlanValid = selectedDirection != 0 and selectedStructureClear and selectedSmallStopGatePassed and selectedExpectedRPassed and selectedSameSideSignalFarEnough and selectedAnyPlanFarEnough and selectedQty >= 1.0 and inEntryWindow
string selectedBlockReason = selectedDirection == 0 ? "no_candidate" : not selectedStructureClear ? "no_clear_structure" : not selectedSameSideSignalFarEnough ? "micro_structure_too_close" : not selectedAnyPlanFarEnough ? "any_plan_too_close" : not selectedSmallStopGatePassed ? selectedSmallStopGateReason : not selectedExpectedRPassed ? "expected_r_too_small" : "passed"

// -----------------------------------------------------------------------------
// Visual lifecycle shadow.
// -----------------------------------------------------------------------------
var bool shadowPending = false
var bool shadowOpen = false
var int shadowDirection = 0
var string shadowSetup = ""
var string shadowIntent = ""
var string shadowTrialRiskMode = ""
var float shadowEntry = na
var float shadowStop = na
var float shadowTarget = na
var float shadowRunner = na
var float shadowQty = na
var int shadowSignalBar = na
var int shadowExpiresBar = na
var int shadowEntryBar = na
var float shadowInitialRisk = na
var bool shadowRunnerActive = false
var float shadowRunnerExtreme = na
var float shadowMfeR = 0.0
var int flowId = 0
var line currentEntryLine = na
var line currentStopLine = na
var line currentRunnerLine = na
var line currentTargetLine = na

newPlanNow = confirmed and showSignalEventFlow and selectedPlanValid and not shadowPending and not shadowOpen
if newPlanNow
    if selectedTopProbe and activeTopDecisionSeq == 0
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if selectedBottomProbe and activeBottomDecisionSeq == 0
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    flowId += 1
    string decisionRef = selectedTopProbe ? "T" + str.tostring(activeTopDecisionSeq) : selectedBottomProbe ? "B" + str.tostring(activeBottomDecisionSeq) : "--"
    shadowPending := true
    shadowOpen := false
    shadowDirection := selectedDirection
    shadowSetup := selectedSetup
    shadowIntent := selectedEntryIntent
    shadowTrialRiskMode := selectedTrialRiskMode
    shadowEntry := selectedEntry
    shadowStop := selectedStop
    shadowTarget := selectedTarget
    shadowRunner := selectedRunnerActivation
    shadowQty := selectedQty
    shadowSignalBar := bar_index
    shadowExpiresBar := bar_index + entryOrderTtlBars
    shadowEntryBar := na
    shadowInitialRisk := riskPerShare(selectedEntry, selectedStop)
    shadowRunnerActive := false
    shadowRunnerExtreme := na
    shadowMfeR := 0.0
    if selectedTopProbe
        topExhaustionUsed := selectedProbePattern == "extension_exhaustion_top" ? true : topExhaustionUsed
    if selectedBottomProbe
        bottomExhaustionUsed := selectedProbePattern == "extension_exhaustion_bottom" ? true : bottomExhaustionUsed
    string detail = "F" + str.tostring(flowId) + " ②" + intentName(selectedEntryIntent) + " " + dirName(selectedDirection) + "\n关联流: " + decisionRef + " -> F" + str.tostring(flowId) + "\n" + setupDisplayName(selectedSetup) + "\n主因: " + selectedMainReason + "\n次因: " + (selectedSecondaryReason == "" ? "none" : selectedSecondaryReason) + "\n结构锚点 " + fmt(selectedStructureAnchor) + " / expected " + fmt(selectedExpectedR) + "R\n结构区 " + fmt(selectedZoneLow) + " - " + fmt(selectedZoneHigh) + "\n三段结构 L" + fmt(selectedProbeLeftLegBps) + "bps / M" + fmt(selectedProbeMiddleRatio) + " / R" + fmt(selectedProbeRightRatio) + " / 回测 " + fmt(selectedProbeRetestGapBars) + "/" + str.tostring(maxRetestAfterMiddleSwingBars) + " bars\n大回落已成立 " + str.tostring(selectedProbePullbackArmed) + " / 回落 " + fmt(selectedProbePullbackAtr) + "ATR / min " + fmt(minMiddleSwingAtr) + "\n量能 vol/MA " + fmt(selectedVolumeRatio) + " / closePos " + fmt(selectedClosePosition) + " / " + selectedVolumeReason + "\n成交量判断: " + volumeJudge + "\n位置角色 " + selectedLevelRole + " / trend " + trendRegime + "\n日内高低 " + (dayRangeFormed ? "formed" : "waiting") + " / " + fmt(dayRangeAtr) + "ATR\n衰竭 " + selectedExhaustionSide + " / " + selectedExhaustionReason + " / MDecay " + fmt(selectedMomentumDecayRatio) + " / 连续 " + fmt(selectedMomentumDecayStreak) + "/" + fmt(selectedMomentumDecayConfirmBars) + "\n量能攻击状态 " + str.tostring(selectedAttackVolumeCooling) + " / 不拦截\n同向距离 " + fmt(selectedSameSideSignalDistanceAtr) + "ATR / min " + fmt(minSameSideSignalSeparationAtr) + "\nplan " + fmt(selectedEntry) + " / qty " + qtyText(selectedQty) + "\n红SL " + fmt(selectedStop) + " " + moneyText(pnlDollars(selectedEntry, selectedStop, selectedDirection, selectedQty)) + "\n蓝Runner " + fmt(selectedRunnerActivation) + " " + moneyText(pnlDollars(selectedEntry, selectedRunnerActivation, selectedDirection, selectedQty)) + "\n绿SafetyTP " + fmt(selectedTarget) + " " + moneyText(pnlDollars(selectedEntry, selectedTarget, selectedDirection, selectedQty)) + "\n小止损: " + selectedSmallStopGateReason + " / " + fmt(selectedStopDistanceAtr) + "ATR / " + fmt(selectedStopDistanceBps) + "bps\nprobe: " + selectedProbePattern + " / filter " + selectedProbeFilterReason + "\n风险模式: " + selectedTrialRiskMode + " $" + fmt(selectedRiskBudget) + " / TTL " + str.tostring(entryOrderTtlBars)
    string compact = "F" + str.tostring(flowId) + " " + dirName(selectedDirection) + " plan " + fmt(selectedEntry)
    if flowLabelsVisible
        label.new(bar_index, selectedDirection == 1 ? low - atr * 1.5 : high + atr * 1.5, flowLabelText(compact, detail), style=flowStyle(selectedDirection), color=flowColor(selectedEntryIntent == "predictive_limit" ? "predictive" : "confirmed", selectedDirection), textcolor=labelTextColor(selectedEntryIntent == "predictive_limit" ? "predictive" : "confirmed", selectedDirection), size=flowLabelSize(), tooltip=flowLabelTooltip(detail))
    int lineEnd = bar_index + entryOrderTtlBars
    currentEntryLine := line.new(bar_index, shadowEntry, lineEnd, shadowEntry, color=color.new(color.yellow, 0), width=2)
    currentStopLine := line.new(bar_index, shadowStop, lineEnd, shadowStop, color=color.new(color.red, 0), width=2)
    currentRunnerLine := line.new(bar_index, shadowRunner, lineEnd, shadowRunner, color=color.new(color.blue, 0), width=2)
    currentTargetLine := line.new(bar_index, shadowTarget, lineEnd, shadowTarget, color=color.new(color.green, 0), width=2)

if showHistoricalPlanLines and (shadowPending or shadowOpen) and not na(shadowSignalBar)
    int lineEnd = math.max(bar_index, shadowSignalBar + 1)
    if not na(currentEntryLine)
        line.set_x2(currentEntryLine, lineEnd)
    if not na(currentStopLine)
        line.set_x2(currentStopLine, lineEnd)
        line.set_y2(currentStopLine, shadowStop)
    if not na(currentRunnerLine)
        line.set_x2(currentRunnerLine, lineEnd)
    if not na(currentTargetLine)
        line.set_x2(currentTargetLine, lineEnd)

bool pendingTouched = confirmed and shadowPending and bar_index > shadowSignalBar and (shadowDirection == 1 ? low <= shadowEntry : high >= shadowEntry)
bool pendingExpired = confirmed and shadowPending and bar_index > shadowExpiresBar
bool pendingInvalidated = confirmed and shadowPending and (shadowDirection == 1 ? close < shadowStop : close > shadowStop)
if pendingTouched
    shadowPending := false
    shadowOpen := true
    shadowEntryBar := bar_index
    shadowRunnerExtreme := shadowDirection == 1 ? high : low
    if shadowSetup == "probe_2b_top_short"
        lastTopProbeSignalBar := bar_index
        lastTopProbeSignalPrice := shadowEntry
    if shadowSetup == "probe_2b_bottom_long"
        lastBottomProbeSignalBar := bar_index
        lastBottomProbeSignalPrice := shadowEntry
    if shadowDirection == 1
        lastLongPlanPrice := shadowEntry
    if shadowDirection == -1
        lastShortPlanPrice := shadowEntry
    lastAnyPlanBar := bar_index
    lastAnyPlanPrice := shadowEntry
    string detail = "F" + str.tostring(flowId) + " ④触及 " + dirName(shadowDirection) + "\nplan " + fmt(shadowEntry) + " 已触及\nDisplay shadow，不代表 TV strategy 已成交；真实成交看 Core Strategy Tester / Core entry_fill / 券商订单"
    string compact = "F" + str.tostring(flowId) + " 触及 " + fmt(shadowEntry)
    if flowLabelsVisible
        label.new(bar_index, shadowDirection == 1 ? low - atr * 1.8 : high + atr * 1.8, flowLabelText(compact, detail), style=flowStyle(shadowDirection), color=flowColor("confirmed", shadowDirection), textcolor=labelTextColor("confirmed", shadowDirection), size=flowLabelSize(), tooltip=flowLabelTooltip(detail))
if pendingExpired or pendingInvalidated
    string reason = pendingInvalidated ? "结构失效/打穿止损" : "挂单TTL过期"
    string detail = "F" + str.tostring(flowId) + " ④撤销 " + dirName(shadowDirection) + "\n原因: " + reason + "\nplan " + fmt(shadowEntry) + " / SL " + fmt(shadowStop) + "\n信号bar " + str.tostring(shadowSignalBar) + " / expires " + str.tostring(shadowExpiresBar)
    string compact = "F" + str.tostring(flowId) + " 撤销"
    if flowLabelsVisible
        label.new(bar_index, shadowDirection == 1 ? low - atr * 1.8 : high + atr * 1.8, flowLabelText(compact, detail), style=flowStyle(shadowDirection), color=flowColor("blocked", shadowDirection), textcolor=labelTextColor("blocked", shadowDirection), size=flowLabelSize(), tooltip=flowLabelTooltip(detail))
    shadowPending := false

bool shadowExitNow = false
string shadowExitReason = ""
float shadowExitPrice = na
if confirmed and shadowOpen
    int barsInTrade = na(shadowEntryBar) ? 0 : bar_index - shadowEntryBar
    shadowRunnerExtreme := shadowDirection == 1 ? math.max(nz(shadowRunnerExtreme, high), high) : math.min(nz(shadowRunnerExtreme, low), low)
    float mfeNow = shadowInitialRisk > 0.0 ? (shadowDirection == 1 ? (high - shadowEntry) / shadowInitialRisk : (shadowEntry - low) / shadowInitialRisk) : 0.0
    shadowMfeR := math.max(nz(shadowMfeR, 0.0), mfeNow)
    bool runnerReached = shadowDirection == 1 ? high >= shadowRunner : low <= shadowRunner
    if not shadowRunnerActive and runnerReached
        shadowRunnerActive := true
        float beStop = shadowEntry + shadowInitialRisk * breakevenOffsetR * shadowDirection
        shadowStop := shadowDirection == 1 ? math.max(shadowStop, beStop) : math.min(shadowStop, beStop)
        string detail = "F" + str.tostring(flowId) + " ⑤保本/Runner\n到达蓝线 " + fmt(shadowRunner) + "\nSL -> " + fmt(shadowStop)
        string compact = "F" + str.tostring(flowId) + " RUN"
        if flowLabelsVisible
            label.new(bar_index, shadowDirection == 1 ? high + atr * 1.4 : low - atr * 1.4, flowLabelText(compact, detail), style=shadowDirection == 1 ? label.style_label_down : label.style_label_up, color=color.new(color.blue, flowLabelTransparency), textcolor=labelTextColor("runner", shadowDirection), size=flowLabelSize(), tooltip=flowLabelTooltip(detail))
    if shadowRunnerActive
        float rawTrailStop = shadowDirection == 1 ? shadowRunnerExtreme - atr * runnerTrailAtrMult : shadowRunnerExtreme + atr * runnerTrailAtrMult
        float structureTrailStop = floatingStructureStop(shadowDirection, shadowStop, lastPivotLow, lastPivotHigh, close, invalidationBuffer)
        float trailStop = looserStop(rawTrailStop, structureTrailStop, shadowDirection)
        shadowStop := shadowDirection == 1 ? math.max(shadowStop, trailStop) : math.min(shadowStop, trailStop)
    if not shadowRunnerActive and barsInTrade >= noFollowThroughBars and shadowMfeR < noFollowThroughMinMfeR
        float structureCompressStop = floatingStructureStop(shadowDirection, shadowStop, lastPivotLow, lastPivotHigh, close, invalidationBuffer)
        if not na(structureCompressStop)
            float rawCompressedStop = shadowEntry - shadowInitialRisk * noFollowThroughCompressedStopR * shadowDirection
            float compressedStop = looserStop(rawCompressedStop, structureCompressStop, shadowDirection)
            shadowStop := shadowDirection == 1 ? math.max(shadowStop, compressedStop) : math.min(shadowStop, compressedStop)
    bool shadowExhaustProtect = shadowMfeR >= exhaustionProtectMinMfeR and (shadowDirection == 1 ? upperExhaustionZone : lowerExhaustionZone)
    bool shadowExhaustExit = shadowMfeR >= exhaustionProtectMinMfeR and (shadowDirection == 1 ? upperExhaustionConfirmedShort : lowerExhaustionConfirmedLong)
    if shadowExhaustProtect and not shadowExhaustExit
        float protectStop = shadowDirection == 1 ? close - atr * exhaustionProtectTrailAtr : close + atr * exhaustionProtectTrailAtr
        shadowStop := shadowDirection == 1 ? math.max(shadowStop, protectStop) : math.min(shadowStop, protectStop)
        float protectTarget = shadowDirection == 1 ? math.max(close, nz(topZoneHigh, close)) : math.min(close, nz(bottomZoneLow, close))
        bool targetTightened = shadowDirection == 1 ? protectTarget > shadowEntry and protectTarget < shadowTarget : protectTarget < shadowEntry and protectTarget > shadowTarget
        shadowTarget := targetTightened ? protectTarget : shadowTarget
        string detail = "F" + str.tostring(flowId) + " ⑤衰竭保护 " + dirName(shadowDirection) + "\n" + (shadowDirection == 1 ? "前高二测，保护多单利润" : "前低二测，保护空单利润") + "\nSL -> " + fmt(shadowStop) + " / TP -> " + fmt(shadowTarget)
        string compact = "F" + str.tostring(flowId) + " 保护"
        if flowLabelsVisible
            label.new(bar_index, shadowDirection == 1 ? high + atr * 1.4 : low - atr * 1.4, flowLabelText(compact, detail), style=shadowDirection == 1 ? label.style_label_down : label.style_label_up, color=color.new(color.orange, flowLabelTransparency), textcolor=labelTextColor("runner", shadowDirection), size=flowLabelSize(), tooltip=flowLabelTooltip(detail))
    bool stopHit = shadowDirection == 1 ? low <= shadowStop : high >= shadowStop
    bool targetHit = shadowDirection == 1 ? high >= shadowTarget : low <= shadowTarget
    shadowExitNow := shadowExhaustExit or stopHit or targetHit
    shadowExitReason := shadowExhaustExit ? "衰竭止盈" : stopHit and shadowRunnerActive ? "跟踪止盈" : stopHit ? "小止损" : targetHit ? "安全TP" : ""
    shadowExitPrice := shadowExhaustExit ? close : stopHit ? shadowStop : targetHit ? shadowTarget : na
if shadowExitNow
    float pnl = (shadowExitPrice - shadowEntry) * shadowDirection * shadowQty
    float pnlR = shadowInitialRisk > 0.0 ? (shadowExitPrice - shadowEntry) * shadowDirection / shadowInitialRisk : na
    string detail = "F" + str.tostring(flowId) + " ⑤退出 " + dirName(shadowDirection) + "\n原因: " + shadowExitReason + "\n价格 " + fmt(shadowExitPrice) + "\nPnL $" + fmt(pnl) + " / " + fmt(pnlR) + "R"
    string compact = "F" + str.tostring(flowId) + " EXIT $" + fmt(pnl)
    if flowLabelsVisible
        label.new(bar_index, shadowDirection == 1 ? high + atr * 1.8 : low - atr * 1.8, flowLabelText(compact, detail), style=shadowDirection == 1 ? label.style_label_down : label.style_label_up, color=flowColor("exit", shadowDirection), textcolor=labelTextColor("exit", shadowDirection), size=flowLabelSize(), tooltip=flowLabelTooltip(detail))
    shadowOpen := false

bool structureBreakAcceptedEvent = confirmed and showDiagnosticEventFlow and (upperStructureBreakAccepted or lowerStructureBreakAccepted)
if structureBreakAcceptedEvent
    int acceptedDirection = upperStructureBreakAccepted ? -1 : 1
    string acceptedDetail = (upperStructureBreakAccepted ? "站稳前高：更新今日结构高" : "跌破站稳：更新今日结构低") + "\n旧结构不再当作反向入场位\n确认 " + str.tostring(structureBreakAcceptBars) + " bars / close阈值 " + fmt(structureBreakAcceptCloseAtr) + "ATR\n后续等待重新回落，再二次测试并连续动能衰减"
    string acceptedCompact = (upperStructureBreakAccepted ? "前高站稳" : "前低跌破") + "\n结构已更新"
    if eventMarkersVisible
        eventMarker(acceptedDirection, "structure", " ", acceptedDetail, 0.28)
    if diagnosticLabelsVisible
        label.new(bar_index, acceptedDirection == 1 ? low - atr * 1.2 : high + atr * 1.2, flowLabelText(acceptedCompact, acceptedDetail), style=flowStyle(acceptedDirection), color=flowColor("blocked", acceptedDirection), textcolor=labelTextColor("blocked", acceptedDirection), size=flowLabelSize(), tooltip=flowLabelTooltip(acceptedDetail))

bool structureBreakExtendedEvent = confirmed and showDiagnosticEventFlow and (upperStructureBreakExtended or lowerStructureBreakExtended)
if structureBreakExtendedEvent
    int extendedDirection = upperStructureBreakExtended ? -1 : 1
    string extendedDetail = (upperStructureBreakExtended ? "前高延伸：结构高跟随最新日内高点" : "前低延伸：结构低跟随最新日内低点") + "\n这是趋势延续后的锚点刷新，不是反向挂单\n后续仍要等回落/反弹形成中段，再二次测试并动能衰减"
    string extendedCompact = upperStructureBreakExtended ? "前高延伸\n结构跟随新高" : "前低延伸\n结构跟随新低"
    if eventMarkersVisible
        eventMarker(extendedDirection, "structure", " ", extendedDetail, 0.28)
    if diagnosticLabelsVisible
        label.new(bar_index, extendedDirection == 1 ? low - atr * 1.2 : high + atr * 1.2, flowLabelText(extendedCompact, extendedDetail), style=flowStyle(extendedDirection), color=flowColor("blocked", extendedDirection), textcolor=labelTextColor("blocked", extendedDirection), size=flowLabelSize(), tooltip=flowLabelTooltip(extendedDetail))

bool liveHighStateEvent = confirmed and showDiagnosticEventFlow and not upperStructureBreakAccepted and not upperStructureBreakExtended and structureHighRaised
bool liveLowStateEvent = confirmed and showDiagnosticEventFlow and not lowerStructureBreakAccepted and not lowerStructureBreakExtended and structureLowRaised
bool candidateHighWaitEvent = confirmed and showDiagnosticEventFlow and intradayHighUpdated and not structureHighRaised and not na(todayStructHigh) and todayHigh > todayStructHigh + tickBuffer
bool candidateLowWaitEvent = confirmed and showDiagnosticEventFlow and intradayLowUpdated and not structureLowRaised and not na(todayStructLow) and todayLow < todayStructLow - tickBuffer
if liveHighStateEvent or liveLowStateEvent or candidateHighWaitEvent or candidateLowWaitEvent
    bool highSideEvent = liveHighStateEvent or candidateHighWaitEvent
    int liveDirection = highSideEvent ? -1 : 1
    bool raisedEvent = liveHighStateEvent or liveLowStateEvent
    bool independentEvent = highSideEvent ? structureHighIndependent : structureLowIndependent
    string stateTitle = raisedEvent ? (highSideEvent ? "结构高抬高" : "结构低下移") : (highSideEvent ? "候选结构高" : "候选结构低")
    string clusterText = raisedEvent ? (independentEvent ? (highSideEvent ? "结构高刷新：独立新结构" : "结构低刷新：独立新结构") : (highSideEvent ? "同一结构簇新高" : "同一结构簇新低")) : (highSideEvent ? "等待回落确认" : "等待反弹确认")
    string liveDetail = stateTitle + "\n" + clusterText + "\n旧高低 " + fmt(highSideEvent ? structureHighOld : structureLowOld) + " -> 新高低 " + fmt(highSideEvent ? todayStructHigh : todayStructLow) + "\n盘中极值 " + fmt(highSideEvent ? todayHigh : todayLow) + "\n独立结构: " + str.tostring(independentEvent) + "\n冻结突破基准 " + fmt(highSideEvent ? breakoutHighZoneHigh : breakoutLowZoneLow) + "\n说明: 同一结构簇也会更新可交易锚点，SL/前高前低跟随最新极值"
    string liveCompact = raisedEvent ? stateTitle + "\n" + clusterText : (highSideEvent ? "候选结构高\n等待回落确认" : "候选结构低\n等待反弹确认")
    if eventMarkersVisible
        eventMarker(liveDirection, "structure", " ", liveDetail, 0.24)
    if diagnosticLabelsVisible
        label.new(bar_index, liveDirection == 1 ? low - atr * 1.05 : high + atr * 1.05, flowLabelText(liveCompact, liveDetail), style=flowStyle(liveDirection), color=flowColor("blocked", liveDirection), textcolor=labelTextColor("blocked", liveDirection), size=flowLabelSize(), tooltip=flowLabelTooltip(liveDetail))

bool blockedCandidate = confirmed and showDiagnosticEventFlow and selectedDirection != 0 and (selectedBlockReason != "passed" or not inEntryWindow)
if blockedCandidate
    if selectedTopProbe and activeTopDecisionSeq == 0
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if selectedBottomProbe and activeBottomDecisionSeq == 0
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    string blockKey = selectedTopProbe ? "T" + str.tostring(activeTopDecisionSeq) : selectedBottomProbe ? "B" + str.tostring(activeBottomDecisionSeq) : ""
    string blockPrefix = blockKey == "" ? "" : blockKey + " ④"
    string displayBlockReason = not inEntryWindow ? "outside_entry_session" : selectedBlockReason
    string detail = blockPrefix + "确认但过滤 " + dirName(selectedDirection) + "\n主因: " + selectedMainReason + "\n次因: " + (selectedSecondaryReason == "" ? "none" : selectedSecondaryReason) + "\n原因: " + reasonCn(displayBlockReason) + " / " + displayBlockReason + "\n结构 " + fmt(selectedStructureAnchor) + " / expected " + fmt(selectedExpectedR) + "R\n同向距离 " + fmt(selectedSameSideSignalDistanceAtr) + "ATR / min " + fmt(minSameSideSignalSeparationAtr) + "\n结构区 " + fmt(selectedZoneLow) + " - " + fmt(selectedZoneHigh) + "\n三段结构 L" + fmt(selectedProbeLeftLegBps) + "bps / M" + fmt(selectedProbeMiddleRatio) + " / R" + fmt(selectedProbeRightRatio) + " / 回测 " + fmt(selectedProbeRetestGapBars) + "/" + str.tostring(maxRetestAfterMiddleSwingBars) + " bars\n大回落已成立 " + str.tostring(selectedProbePullbackArmed) + " / 回落 " + fmt(selectedProbePullbackAtr) + "ATR / min " + fmt(minMiddleSwingAtr) + "\n量能 vol/MA " + fmt(selectedVolumeRatio) + " / closePos " + fmt(selectedClosePosition) + " / " + selectedVolumeReason + "\n成交量判断: " + volumeJudge + "\n位置角色 " + selectedLevelRole + " / trend " + trendRegime + "\n日内高低 " + (dayRangeFormed ? "formed" : "waiting") + " / " + fmt(dayRangeAtr) + "ATR\n衰竭 " + selectedExhaustionSide + " / " + selectedExhaustionReason + " / MDecay " + fmt(selectedMomentumDecayRatio) + " / 连续 " + fmt(selectedMomentumDecayStreak) + "/" + fmt(selectedMomentumDecayConfirmBars) + "\n量能攻击状态 " + str.tostring(selectedAttackVolumeCooling) + " / 不拦截\n距离 " + fmt(selectedStopDistanceAtr) + "ATR / " + fmt(selectedStopDistanceBps) + "bps"
    string compact = blockPrefix + "确认但过滤 " + dirName(selectedDirection) + "\n" + reasonCn(displayBlockReason)
    if eventMarkersVisible
        eventMarker(selectedDirection, "blocked", " ", detail, 0.34)
    if diagnosticLabelsVisible
        label.new(bar_index, selectedDirection == 1 ? low - atr * 1.2 : high + atr * 1.2, flowLabelText(compact, detail), style=flowStyle(selectedDirection), color=flowColor("blocked", selectedDirection), textcolor=labelTextColor("blocked", selectedDirection), size=flowLabelSize(), tooltip=flowLabelTooltip(detail))

bool pullbackArmedFlowEvent = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and (topPullbackArmedEvent or bottomPullbackArmedEvent)
if pullbackArmedFlowEvent
    int armedDirection = topPullbackArmedEvent ? -1 : 1
    if topPullbackArmedEvent
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if bottomPullbackArmedEvent
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    string armedKey = armedDirection == -1 ? "T" + str.tostring(activeTopDecisionSeq) : "B" + str.tostring(activeBottomDecisionSeq)
    string armedDetail = armedKey + (armedDirection == -1 ? " ①冲高后大回落已成立 空\n" : " ①下探后大反弹已成立 多\n") + "不挂单，等待接近/触达/突破结构位\n主因: pullback_armed\n次因: 回落/反弹达到最小幅度，后续裸K失败才确认\n回落 " + fmt(armedDirection == -1 ? topPullbackAtr : bottomPullbackAtr) + "ATR / min " + fmt(minMiddleSwingAtr) + "\n比例 " + fmt(armedDirection == -1 ? topMiddleRetraceRatio : bottomMiddleRetraceRatio) + " / min " + fmt(minVisualMiddleRetraceRatio)
    string armedCompact = armedKey + (armedDirection == -1 ? " ①大回落成立 空" : " ①大反弹成立 多") + "\n等回结构位"
    if eventMarkersVisible
        eventMarker(armedDirection, "observe", " ", armedDetail, 0.24)
    if diagnosticLabelsVisible
        label.new(bar_index, armedDirection == 1 ? low - atr * 1.1 : high + atr * 1.1, flowLabelText(armedCompact, armedDetail), style=flowStyle(armedDirection), color=flowColor("blocked", armedDirection), textcolor=labelTextColor("blocked", armedDirection), size=flowLabelSize(), tooltip=flowLabelTooltip(armedDetail))

bool volumeClimaxTopWatchEvent = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and topVolumeClimaxAttackEvent
if volumeClimaxTopWatchEvent
    topDecisionSeq += 1
    activeTopDecisionSeq := topDecisionSeq
    string topKey = "T" + str.tostring(activeTopDecisionSeq)
    string climaxWatchDetail = topKey + " ①裸K放量上攻观察 空\n不挂单，等放量失败或衰弱破位\n主因: naked_high_volume_watch\n次因: 高位放量K是攻击锚点，不再用冷却期拦截\n成交量判断: " + volumeJudge + "\nbase " + fmt(lastTopVolumeClimaxBase) + "\nattack H/L " + fmt(lastTopVolumeClimaxHigh) + " / " + fmt(lastTopVolumeClimaxLow) + "\nvol/MA " + fmt(lastTopVolumeClimaxVolumeRatio) + "\n确认窗口 " + str.tostring(failedBreakConfirmBars) + " bars"
    string climaxWatchCompact = topKey + " ①裸K放量上攻观察 空\n等失败确认"
    if eventMarkersVisible
        eventMarker(-1, "watch", " ", climaxWatchDetail, 0.28)
    if diagnosticLabelsVisible
        label.new(bar_index, high + atr * 1.25, flowLabelText(climaxWatchCompact, climaxWatchDetail), style=flowStyle(-1), color=flowColor("blocked", -1), textcolor=labelTextColor("blocked", -1), size=flowLabelSize(), tooltip=flowLabelTooltip(climaxWatchDetail))

bool volumeClimaxTopConfirmRaw = confirmed and showDiagnosticEventFlow and topVolumeClimaxFailedBreakConfirmed
bool volumeClimaxTopConfirmEvent = volumeClimaxTopConfirmRaw and not volumeClimaxTopConfirmRaw[1]
if volumeClimaxTopConfirmEvent
    if activeTopDecisionSeq == 0
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    string topKey = "T" + str.tostring(activeTopDecisionSeq)
    string climaxFailKind = topVolumeClimaxCloseBack ? "红K收回前高" : "红K跌破攻击K低点"
    string rawClimaxFilterReason = topConfirmAllowed ? "passed" : not topSignalGapOk ? "micro_structure_too_close" : not smallStopTrialAllowed(topConfirmEntry, topConfirmStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps) ? smallStopGateReason(topConfirmEntry, topConfirmStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps) : topConfirmQty < 1.0 ? "qty_too_small" : "main_flow_filter"
    string climaxFilterReason = topConfirmAllowed ? "可挂单" : "确认但过滤\n过滤原因: " + reasonCn(rawClimaxFilterReason) + " / " + rawClimaxFilterReason
    string climaxConfirmDetail = topKey + " ③放量失败确认 空\n候选确认 空\n" + climaxFailKind + "\n" + climaxFilterReason + "\nSL 前高+buffer " + fmt(topConfirmStop) + "\nbase " + fmt(lastTopVolumeClimaxBase) + "\nattack H/L " + fmt(lastTopVolumeClimaxHigh) + " / " + fmt(lastTopVolumeClimaxLow) + "\n等待 " + fmt(barsSinceTopVolumeClimax) + "/" + str.tostring(failedBreakConfirmBars) + " bars\n成交量判断: " + volumeJudge + "\nvol/MA " + fmt(volumeRatio) + " / closePos " + fmt(closePosition) + "\ndistance " + fmt(topVolumeClimaxDistanceAtr) + "ATR"
    string climaxConfirmCompact = topKey + " 候选确认 空\n" + (topConfirmAllowed ? "可挂单" : "确认但过滤")
    if eventMarkersVisible
        eventMarker(-1, topConfirmAllowed ? "candidate" : "blocked", " ", climaxConfirmDetail, 0.34)
    if diagnosticLabelsVisible
        label.new(bar_index, high + atr * 1.35, flowLabelText(climaxConfirmCompact, climaxConfirmDetail), style=flowStyle(-1), color=flowColor("confirmed", -1), textcolor=labelTextColor("confirmed", -1), size=flowLabelSize(), tooltip=flowLabelTooltip(climaxConfirmDetail))

bool nakedTouchEvent = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and (topNakedTouchEvent or bottomNakedTouchEvent)
if nakedTouchEvent
    int touchDirection = topNakedTouchEvent ? -1 : 1
    if topNakedTouchEvent and activeTopDecisionSeq == 0
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if bottomNakedTouchEvent and activeBottomDecisionSeq == 0
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    string touchKey = touchDirection == -1 ? "T" + str.tostring(activeTopDecisionSeq) : "B" + str.tostring(activeBottomDecisionSeq)
    string touchDetail = touchKey + (touchDirection == -1 ? " ①新高/前高观察 空\n" : " ①新低/前低观察 多\n") + "不挂单，等待放量失败或连续衰弱破簇\n主因: " + (touchDirection == -1 ? "naked_high_watch" : "naked_low_watch") + "\n次因: 触达结构位即进入裸K观察，不要求先放量\n成交量判断: " + volumeJudge + "\n大回落已成立: " + str.tostring(touchDirection == -1 ? topPullbackArmed : bottomPullbackArmed) + " / 回落 " + fmt(touchDirection == -1 ? topPullbackAtr : bottomPullbackAtr) + "ATR\nbase " + fmt(touchDirection == -1 ? lastTopFailureWatchBase : lastBottomFailureWatchBase) + "\nwatch H/L " + fmt(touchDirection == -1 ? lastTopFailureWatchHigh : lastBottomFailureWatchHigh) + " / " + fmt(touchDirection == -1 ? lastTopFailureWatchLow : lastBottomFailureWatchLow) + "\nvol/MA " + fmt(volumeRatio) + " / closePos " + fmt(closePosition)
    string touchCompact = touchKey + (touchDirection == -1 ? " ①新高/前高观察 空" : " ①新低/前低观察 多") + "\n等确认"
    if eventMarkersVisible
        eventMarker(touchDirection, "observe", " ", touchDetail, 0.24)
    if diagnosticLabelsVisible
        label.new(bar_index, touchDirection == 1 ? low - atr * 1.15 : high + atr * 1.15, flowLabelText(touchCompact, touchDetail), style=flowStyle(touchDirection), color=flowColor("blocked", touchDirection), textcolor=labelTextColor("blocked", touchDirection), size=flowLabelSize(), tooltip=flowLabelTooltip(touchDetail))

bool nakedVolumeProbeEvent = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and (topHighVolumeProbeWatch or bottomHighVolumeProbeWatch) and not volumeClimaxTopWatchEvent
if nakedVolumeProbeEvent
    int attackDirection = topHighVolumeProbeWatch ? -1 : 1
    if topHighVolumeProbeWatch and activeTopDecisionSeq == 0
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if bottomHighVolumeProbeWatch and activeBottomDecisionSeq == 0
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    string attackKey = attackDirection == -1 ? "T" + str.tostring(activeTopDecisionSeq) : "B" + str.tostring(activeBottomDecisionSeq)
    string attackDetail = attackKey + (attackDirection == -1 ? " ②放量失败观察 空\n" : " ②放量失败观察 多\n") + "不挂单，等反向K收回实体中位或破观察位\n主因: " + (attackDirection == -1 ? "naked_high_volume_watch" : "naked_low_volume_watch") + "\n次因: 放量K只作为攻击锚点，不触发冷却拦截\n成交量判断: " + volumeJudge + "\nattack H/L " + fmt(attackDirection == -1 ? lastTopFailureWatchHigh : lastBottomFailureWatchHigh) + " / " + fmt(attackDirection == -1 ? lastTopFailureWatchLow : lastBottomFailureWatchLow) + "\nbodyMid " + fmt(attackDirection == -1 ? lastTopFailureWatchBodyMid : lastBottomFailureWatchBodyMid) + "\nvol/MA " + fmt(volumeRatio) + " / closePos " + fmt(closePosition)
    string attackCompact = attackKey + (attackDirection == -1 ? " ②放量失败观察 空" : " ②放量失败观察 多") + "\n等反向确认"
    if eventMarkersVisible
        eventMarker(attackDirection, "watch", " ", attackDetail, 0.28)
    if diagnosticLabelsVisible
        label.new(bar_index, attackDirection == 1 ? low - atr * 1.25 : high + atr * 1.25, flowLabelText(attackCompact, attackDetail), style=flowStyle(attackDirection), color=flowColor("blocked", attackDirection), textcolor=labelTextColor("blocked", attackDirection), size=flowLabelSize(), tooltip=flowLabelTooltip(attackDetail))

bool nakedQuietWatchEvent = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and (topNoDemandWatch or bottomNoSupplyWatch)
if nakedQuietWatchEvent
    int quietDirection = topNoDemandWatch ? -1 : 1
    if topNoDemandWatch and activeTopDecisionSeq == 0
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if bottomNoSupplyWatch and activeBottomDecisionSeq == 0
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    string quietKey = quietDirection == -1 ? "T" + str.tostring(activeTopDecisionSeq) : "B" + str.tostring(activeBottomDecisionSeq)
    string quietStep = quietDirection == -1 ? (topNoDemandStreak <= 1 ? "②连续衰弱观察 空" : "②高位衰弱/打压观察 空") : (bottomNoSupplyStreak <= 1 ? "②连续衰弱观察 多" : "②低位衰弱/打压观察 多")
    string quietMain = quietDirection == -1 ? "naked_high_decay_watch" : "naked_low_decay_watch"
    string quietSecondary = quietDirection == -1 ? "等待红K跌破观察簇低点" : "等待绿K突破观察簇高点"
    string quietDetail = quietKey + " " + quietStep + "\n不挂单，等破位确认\n主因: " + quietMain + "\n次因: " + quietSecondary + "\n成交量判断: " + volumeJudge + "\n大回落已成立: " + str.tostring(quietDirection == -1 ? topPullbackArmed : bottomPullbackArmed) + " / 回落 " + fmt(quietDirection == -1 ? topPullbackAtr : bottomPullbackAtr) + "ATR\nbase " + fmt(quietDirection == -1 ? lastTopFailureWatchBase : lastBottomFailureWatchBase) + "\nwatch H/L " + fmt(quietDirection == -1 ? lastTopNoDemandHigh : lastBottomNoSupplyHigh) + " / " + fmt(quietDirection == -1 ? lastTopNoDemandLow : lastBottomNoSupplyLow) + "\n连续 " + str.tostring(quietDirection == -1 ? topNoDemandStreak : bottomNoSupplyStreak) + "\nvol/MA " + fmt(volumeRatio) + " / closePos " + fmt(closePosition)
    string quietCompact = quietKey + " " + quietStep + "\n等破位确认"
    if eventMarkersVisible
        eventMarker(quietDirection, "watch", " ", quietDetail, 0.30)
    if diagnosticLabelsVisible
        label.new(bar_index, quietDirection == 1 ? low - atr * 1.25 : high + atr * 1.25, flowLabelText(quietCompact, quietDetail), style=flowStyle(quietDirection), color=flowColor("blocked", quietDirection), textcolor=labelTextColor("blocked", quietDirection), size=flowLabelSize(), tooltip=flowLabelTooltip(quietDetail))

bool weakNewTopWatchEvent = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and topWeakNewHighWatch and not topWeakNewHighConfirmed and not topDistributionDropConfirmed and not topHighVolumeDropConfirmed and not topNoDemandWatch and not topNoDemandBreakConfirmed
bool weakNewBottomWatchEvent = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and bottomWeakNewLowWatch and not bottomWeakNewLowConfirmed and not bottomAccumulationRiseConfirmed and not bottomHighVolumeRiseConfirmed and not bottomNoSupplyWatch and not bottomNoSupplyBreakConfirmed
if weakNewTopWatchEvent or weakNewBottomWatchEvent
    int weakWatchDirection = weakNewTopWatchEvent ? -1 : 1
    if weakNewTopWatchEvent
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if weakNewBottomWatchEvent
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    string weakKey = weakWatchDirection == -1 ? "T" + str.tostring(activeTopDecisionSeq) : "B" + str.tostring(activeBottomDecisionSeq)
    string weakWatchDetail = weakKey + " ①" + (weakNewTopWatchEvent ? "弱新高观察 空\n新高缩量\n等待弱收确认" : "弱新低观察 多\n新低缩量\n等待强收确认") + "\n不挂单\n成交量判断: " + volumeJudge + "\nbase " + fmt(weakNewTopWatchEvent ? topWeakBase : bottomWeakBase) + "\next " + fmt(weakNewTopWatchEvent ? topWeakExtensionAtr : bottomWeakExtensionAtr) + "ATR\nvol/MA " + fmt(volumeRatio)
    string weakWatchCompact = weakNewTopWatchEvent ? weakKey + " ①弱新高观察 空\n等待弱收确认" : weakKey + " ①弱新低观察 多\n等待强收确认"
    if eventMarkersVisible
        eventMarker(weakWatchDirection, "observe", " ", weakWatchDetail, 0.26)
    if diagnosticLabelsVisible
        label.new(bar_index, weakWatchDirection == 1 ? low - atr * 1.2 : high + atr * 1.2, flowLabelText(weakWatchCompact, weakWatchDetail), style=flowStyle(weakWatchDirection), color=flowColor("blocked", weakWatchDirection), textcolor=labelTextColor("blocked", weakWatchDirection), size=flowLabelSize(), tooltip=flowLabelTooltip(weakWatchDetail))

bool topDistributionOrDropConfirmed = topDistributionDropConfirmed or topImmediateReversalShort or (topHighVolumeDropConfirmed and not topVolumeClimaxFailedBreakConfirmed) or topNoDemandBreakConfirmed
bool bottomAccumulationOrRiseConfirmed = bottomAccumulationRiseConfirmed or bottomHighVolumeRiseConfirmed or bottomNoSupplyBreakConfirmed
bool distributionConfirmRaw = confirmed and showDiagnosticEventFlow and (topDistributionOrDropConfirmed or bottomAccumulationOrRiseConfirmed)
bool distributionConfirmEvent = distributionConfirmRaw and not distributionConfirmRaw[1]
if distributionConfirmEvent
    int distributionDirection = topDistributionOrDropConfirmed ? -1 : 1
    if topDistributionOrDropConfirmed and activeTopDecisionSeq == 0
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if bottomAccumulationOrRiseConfirmed and activeBottomDecisionSeq == 0
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    string distributionKey = distributionDirection == -1 ? "T" + str.tostring(activeTopDecisionSeq) : "B" + str.tostring(activeBottomDecisionSeq)
    bool distributionAllowed = distributionDirection == -1 ? topConfirmAllowed : bottomConfirmAllowed
    string rawDistributionFilterReason = distributionAllowed ? "passed" : distributionDirection == -1 ? (not topSignalGapOk ? "micro_structure_too_close" : not smallStopTrialAllowed(topConfirmEntry, topConfirmStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps) ? smallStopGateReason(topConfirmEntry, topConfirmStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps) : topConfirmQty < 1.0 ? "qty_too_small" : "main_flow_filter") : (not bottomSignalGapOk ? "micro_structure_too_close" : not smallStopTrialAllowed(bottomConfirmEntry, bottomConfirmStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps) ? smallStopGateReason(bottomConfirmEntry, bottomConfirmStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps) : bottomConfirmQty < 1.0 ? "qty_too_small" : "main_flow_filter")
    string distributionFilterReason = distributionAllowed ? "可挂单" : "确认但过滤\n过滤原因: " + reasonCn(rawDistributionFilterReason) + " / " + rawDistributionFilterReason
    bool distributionQuietBreak = distributionDirection == -1 ? topNoDemandBreakConfirmed : bottomNoSupplyBreakConfirmed
    string distributionKind = distributionDirection == -1 ? (topImmediateReversalShort ? "冲高大回落/高位失败 / 回抽限价挂空" : topNoDemandBreakConfirmed ? "连续衰弱/打压 / 红K跌破观察簇低点" : topHighVolumeDropConfirmed ? "高位放量失败 / " + (topHighVolumeDropBreakLow ? "红K跌破攻击K低点" : "红K收回攻击K实体中位") : "弱新高后分歧放量下跌") : (bottomNoSupplyBreakConfirmed ? "连续衰弱/打压 / 绿K突破观察簇高点" : bottomHighVolumeRiseConfirmed ? "低位放量失败 / " + (bottomHighVolumeRiseBreakHigh ? "绿K突破攻击K高点" : "绿K收回攻击K实体中位") : "弱新低后分歧放量上涨")
    float distributionBase = distributionDirection == -1 ? (topNoDemandBreakConfirmed or topHighVolumeDropConfirmed or topImmediateReversalShort ? lastTopFailureWatchBase : topWeakBase) : (bottomNoSupplyBreakConfirmed or bottomHighVolumeRiseConfirmed ? lastBottomFailureWatchBase : bottomWeakBase)
    float distributionWatchHigh = distributionDirection == -1 ? (topNoDemandBreakConfirmed ? lastTopNoDemandHigh : lastTopFailureWatchHigh) : (bottomNoSupplyBreakConfirmed ? lastBottomNoSupplyHigh : lastBottomFailureWatchHigh)
    float distributionWatchLow = distributionDirection == -1 ? (topNoDemandBreakConfirmed ? lastTopNoDemandLow : lastTopFailureWatchLow) : (bottomNoSupplyBreakConfirmed ? lastBottomNoSupplyLow : lastBottomFailureWatchLow)
    float distributionWaitBars = distributionDirection == -1 ? (topNoDemandBreakConfirmed ? barsSinceTopNoDemand : barsSinceTopFailureWatch) : (bottomNoSupplyBreakConfirmed ? barsSinceBottomNoSupply : barsSinceBottomFailureWatch)
    float distributionDistance = distributionDirection == -1 ? (topNoDemandBreakConfirmed ? topNoDemandDistanceAtr : topHighVolumeDropConfirmed or topImmediateReversalShort ? topHighVolumeDropDistanceAtr : topDistributionDistanceAtr) : (bottomNoSupplyBreakConfirmed ? bottomNoSupplyDistanceAtr : bottomHighVolumeRiseConfirmed ? bottomHighVolumeRiseDistanceAtr : bottomAccumulationDistanceAtr)
    string distributionStep = distributionDirection == -1 ? (distributionQuietBreak ? " ③跌破观察簇确认 空\n候选确认 空\n" : " ③放量失败确认 空\n候选确认 空\n") : (distributionQuietBreak ? " ③突破观察簇确认 多\n候选确认 多\n" : " ③放量失败确认 多\n候选确认 多\n")
    string distributionDetail = distributionKey + distributionStep + (distributionQuietBreak ? "裸K连续衰弱确认\n" : "裸K放量失败确认\n") + "主因: " + (distributionDirection == -1 ? (topNoDemandBreakConfirmed ? "naked_high_decay_break" : selectedMainReason) : (bottomNoSupplyBreakConfirmed ? "naked_low_decay_break" : selectedMainReason)) + "\n次因: " + distributionKind + "\n" + distributionFilterReason + "\n回抽限价 entry " + fmt(distributionDirection == -1 ? topConfirmEntry : bottomConfirmEntry) + "\nSL " + (distributionDirection == -1 ? "前高+buffer " + fmt(topConfirmStop) : "前低-buffer " + fmt(bottomConfirmStop)) + "\nbase " + fmt(distributionBase) + "\nwatch H/L " + fmt(distributionWatchHigh) + " / " + fmt(distributionWatchLow) + "\n观察已持续 " + fmt(distributionWaitBars) + " bars / " + str.tostring(failedBreakConfirmBars) + " 仅诊断\n成交量判断: " + volumeJudge + "\nvol/MA " + fmt(volumeRatio) + " / closePos " + fmt(closePosition) + "\ndistance " + fmt(distributionDistance) + "ATR"
    string distributionCompact = distributionDirection == -1 ? distributionKey + (distributionQuietBreak ? " 候选确认 空\n跌破观察簇" : " 候选确认 空\n放量失败") : distributionKey + (distributionQuietBreak ? " 候选确认 多\n突破观察簇" : " 候选确认 多\n放量失败")
    if eventMarkersVisible
        eventMarker(distributionDirection, distributionAllowed ? "candidate" : "blocked", " ", distributionDetail, 0.34)
    if diagnosticLabelsVisible
        label.new(bar_index, distributionDirection == 1 ? low - atr * 1.35 : high + atr * 1.35, flowLabelText(distributionCompact, distributionDetail), style=flowStyle(distributionDirection), color=flowColor("confirmed", distributionDirection), textcolor=labelTextColor("confirmed", distributionDirection), size=flowLabelSize(), tooltip=flowLabelTooltip(distributionDetail))

bool exhaustionWatchTop = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and dayRangeClear and topRightShoulder and topRetestBand and upperNoVolumeExpansion and topMomentumDecayed and not upperExhaustionConfirmedShort and not topNoDemandWatch and not topNoDemandBreakConfirmed
bool exhaustionWatchBottom = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and dayRangeClear and bottomRightShoulder and bottomRetestBand and lowerNoVolumeExpansion and bottomMomentumDecayed and not lowerExhaustionConfirmedLong and not bottomNoSupplyWatch and not bottomNoSupplyBreakConfirmed
if exhaustionWatchTop or exhaustionWatchBottom
    int watchDirection = exhaustionWatchTop ? -1 : 1
    if exhaustionWatchTop and activeTopDecisionSeq == 0
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if exhaustionWatchBottom and activeBottomDecisionSeq == 0
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    string watchKey = watchDirection == -1 ? "T" + str.tostring(activeTopDecisionSeq) : "B" + str.tostring(activeBottomDecisionSeq)
    string watchReason = exhaustionWatchTop ? topExhaustionReason : bottomExhaustionReason
    string watchDetail = watchKey + " ①观察 " + dirName(watchDirection) + "\n" + (exhaustionWatchTop ? "前高二测：多单止盈区，等待确认做空" : "前低二测：空单止盈区，等待确认做多") + "\n原因: " + reasonCn(watchReason) + " / " + watchReason + "\n成交量判断: " + volumeJudge + "\nvol/MA " + fmt(volumeRatio) + " / MDecay " + fmt(exhaustionWatchTop ? topMomentumDecayRatio : bottomMomentumDecayRatio) + "\n连续衰减 " + fmt(exhaustionWatchTop ? topDecayStreak * 1.0 : bottomDecayStreak * 1.0) + "/" + str.tostring(exhaustionDecayConfirmBars) + "\n日内高低 " + fmt(dayRangeAtr) + "ATR"
    string watchCompact = watchKey + " ①" + (exhaustionWatchTop ? "前高二测" : "前低二测") + "\n等确认"
    if eventMarkersVisible
        eventMarker(watchDirection, "observe", " ", watchDetail, 0.26)
    if diagnosticLabelsVisible
        label.new(bar_index, watchDirection == 1 ? low - atr * 1.2 : high + atr * 1.2, flowLabelText(watchCompact, watchDetail), style=flowStyle(watchDirection), color=flowColor("blocked", watchDirection), textcolor=labelTextColor("blocked", watchDirection), size=flowLabelSize(), tooltip=flowLabelTooltip(watchDetail))

bool unconfirmedTopWatch = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and strongTopProbeZone and (topFirstExhaustion or topRightShoulder) and not topConfirmAllowed and not volumeClimaxTopWatchEvent and not topVolumeClimaxFailedBreakConfirmed and not topHighVolumeDropConfirmed and not topNoDemandWatch and not topNoDemandBreakConfirmed and not exhaustionWatchTop
bool unconfirmedBottomWatch = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and strongBottomProbeZone and (bottomFirstExhaustion or bottomRightShoulder) and not bottomConfirmAllowed and not bottomHighVolumeRiseConfirmed and not bottomNoSupplyWatch and not bottomNoSupplyBreakConfirmed and not exhaustionWatchBottom
if unconfirmedTopWatch or unconfirmedBottomWatch
    int waitDirection = unconfirmedTopWatch ? -1 : 1
    if unconfirmedTopWatch and activeTopDecisionSeq == 0
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if unconfirmedBottomWatch and activeBottomDecisionSeq == 0
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    string waitKey = waitDirection == -1 ? "T" + str.tostring(activeTopDecisionSeq) : "B" + str.tostring(activeBottomDecisionSeq)
    string waitReason = unconfirmedTopWatch ? topProbeFilterReason : bottomProbeFilterReason
    string waitDetail = waitKey + " ①观察 " + dirName(waitDirection) + "\n未确认，不挂单\n原因: " + reasonCn(waitReason) + " / " + waitReason + "\n只有 confirmed_limit 才会画 plan 并联动 Core/IBKR\n大回落已成立: " + str.tostring(waitDirection == -1 ? topPullbackArmed : bottomPullbackArmed) + " / 回落 " + fmt(waitDirection == -1 ? topPullbackAtr : bottomPullbackAtr) + "ATR\n成交量判断: " + volumeJudge + "\n结构区 " + fmt(unconfirmedTopWatch ? topZoneLow : bottomZoneLow) + " - " + fmt(unconfirmedTopWatch ? topZoneHigh : bottomZoneHigh)
    string waitCompact = waitKey + " ①观察 " + dirName(waitDirection) + "\n未确认，不挂单"
    if eventMarkersVisible
        eventMarker(waitDirection, "observe", " ", waitDetail, 0.24)
    if diagnosticLabelsVisible
        label.new(bar_index, waitDirection == 1 ? low - atr * 1.2 : high + atr * 1.2, flowLabelText(waitCompact, waitDetail), style=flowStyle(waitDirection), color=flowColor("blocked", waitDirection), textcolor=labelTextColor("blocked", waitDirection), size=flowLabelSize(), tooltip=flowLabelTooltip(waitDetail))

// Lightweight context plots for reading the structure; these are visual only.
color dtpLineColor = dtpDir == 1 ? color.new(color.aqua, 0) : dtpDir == -1 ? color.new(color.red, 0) : color.new(color.gray, 25)
plot(showEmaFastSlowLines ? emaFast : na, "EMA 20 快线", color=color.new(color.orange, 35), linewidth=1)
plot(showEmaFastSlowLines ? emaMid : na, "EMA 50 慢线", color=color.new(color.gray, 45), linewidth=1)
plot(showEmaContextLines ? emaSlow : na, "EMA 100 趋势", color=color.new(color.silver, 55), linewidth=1)
plot(showEmaContextLines ? emaLongest : na, "EMA 200 长线", color=color.new(color.gray, 70), linewidth=1)
plot(showDtpTrendLine ? dtpAvg : na, "DTP 趋势线", color=dtpLineColor, linewidth=2)
plot(showSdHelperBandLines ? sdMid : na, "SD regression", color=color.new(color.blue, 80), linewidth=1)
plot(showBandLines ? sdUpper : na, "SD signal upper", color=color.new(color.red, 75), linewidth=1)
plot(showBandLines ? sdLower : na, "SD signal lower", color=color.new(color.green, 75), linewidth=1)
plot(showStructureGuideLines ? todayStructHigh : na, "Today Struct High", color=color.new(color.red, 20), linewidth=2, style=plot.style_linebr)
plot(showStructureGuideLines ? todayStructLow : na, "Today Struct Low", color=color.new(color.green, 20), linewidth=2, style=plot.style_linebr)
plot(showStructureGuideLines ? todayStructHighZoneHigh : na, "Struct High Zone High", color=color.new(color.red, 65), linewidth=1, style=plot.style_linebr)
plot(showStructureGuideLines ? todayStructHighZoneLow : na, "Struct High Zone Low", color=color.new(color.red, 78), linewidth=1, style=plot.style_linebr)
plot(showStructureGuideLines ? todayStructLowZoneHigh : na, "Struct Low Zone High", color=color.new(color.green, 78), linewidth=1, style=plot.style_linebr)
plot(showStructureGuideLines ? todayStructLowZoneLow : na, "Struct Low Zone Low", color=color.new(color.green, 65), linewidth=1, style=plot.style_linebr)
plotshape(showComponentMarkers and sdLowerHit, "SD lower hit", location=location.belowbar, style=shape.triangleup, color=color.new(color.green, 0), size=size.tiny, text="SD-L")
plotshape(showComponentMarkers and sdUpperHit, "SD upper hit", location=location.abovebar, style=shape.triangledown, color=color.new(color.orange, 0), size=size.tiny, text="SD-U")
plotshape(showAnyFractalMarkers and fractalBull, "Fractal bull", location=location.belowbar, style=shape.circle, color=color.new(color.aqua, 0), size=size.tiny, text="F+", offset=-fractalPeriod)
plotshape(showAnyFractalMarkers and fractalBear, "Fractal bear", location=location.abovebar, style=shape.circle, color=color.new(color.fuchsia, 0), size=size.tiny, text="F-", offset=-fractalPeriod)
plotshape(showAnyEmaCrossMarkers and emaGoldenCross, "EMA20/50 golden cross", location=location.belowbar, style=shape.triangleup, color=color.new(color.lime, 0), size=size.small, text="20/50金叉")
plotshape(showAnyEmaCrossMarkers and emaDeathCross, "EMA20/50 death cross", location=location.abovebar, style=shape.triangledown, color=color.new(color.red, 0), size=size.small, text="20/50死叉")
plotshape(showComponentMarkers and bullDivNow, "Bull divergence", location=location.belowbar, style=shape.diamond, color=color.new(color.lime, 0), size=size.tiny, text="D+")
plotshape(showComponentMarkers and bearDivNow, "Bear divergence", location=location.abovebar, style=shape.diamond, color=color.new(color.red, 0), size=size.tiny, text="D-")
plotshape(newPlanNow and selectedDirection == 1, title="Predictive/confirmed long", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 35), size=size.tiny, text="")
plotshape(newPlanNow and selectedDirection == -1, title="Predictive/confirmed short", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 35), size=size.tiny, text="")

var table statusTable = table.new(position.top_right, 2, 9)
if showStatusTable and barstate.islast
    bool statusUsesShadowPlan = shadowPending or shadowOpen
    float statusEntryPlan = statusUsesShadowPlan ? shadowEntry : selectedEntry
    float statusStopPlan = statusUsesShadowPlan ? shadowStop : selectedStop
    float statusRunnerPlan = statusUsesShadowPlan ? shadowRunner : selectedRunnerActivation
    float statusTargetPlan = statusUsesShadowPlan ? shadowTarget : selectedTarget
    int statusDirectionPlan = statusUsesShadowPlan ? shadowDirection : selectedDirection
    float statusQtyPlan = statusUsesShadowPlan ? shadowQty : selectedQty
    table.cell(statusTable, 0, 0, "v3状态", text_color=tableTextColor(0), bgcolor=tableBgColor(0))
    table.cell(statusTable, 1, 0, shadowPending ? "预挂中" : shadowOpen ? "持仓影子" : selectedPlanValid ? "有计划" : "等待", text_color=tableTextColor(0), bgcolor=tableBgColor(0))
    table.cell(statusTable, 0, 1, "方向", text_color=tableTextColor(1), bgcolor=tableBgColor(1))
    table.cell(statusTable, 1, 1, selectedDirection != 0 ? dirName(selectedDirection) : dirName(shadowDirection), text_color=tableTextColor(1), bgcolor=tableBgColor(1))
    table.cell(statusTable, 0, 2, "模式", text_color=tableTextColor(2), bgcolor=tableBgColor(2))
    table.cell(statusTable, 1, 2, selectedEntryIntent, text_color=tableTextColor(2), bgcolor=tableBgColor(2))
    table.cell(statusTable, 0, 3, "主因", text_color=tableTextColor(3), bgcolor=tableBgColor(3))
    table.cell(statusTable, 1, 3, selectedMainReason, text_color=tableTextColor(3), bgcolor=tableBgColor(3))
    table.cell(statusTable, 0, 4, "结构/小止损", text_color=tableTextColor(4), bgcolor=tableBgColor(4))
    table.cell(statusTable, 1, 4, (selectedStructureClear ? "清晰" : "等待") + " / " + selectedBlockReason, text_color=tableTextColor(4), bgcolor=tableBgColor(4))
    table.cell(statusTable, 0, 5, "黄/红/蓝/绿", text_color=tableTextColor(5), bgcolor=tableBgColor(5))
    table.cell(statusTable, 1, 5, "Entry / SL / Runner / SafetyTP", text_color=tableTextColor(5), bgcolor=tableBgColor(5))
    table.cell(statusTable, 0, 6, "窗口", text_color=tableTextColor(6), bgcolor=tableBgColor(6))
    table.cell(statusTable, 1, 6, inEntryWindow ? "可入场" : "关闭", text_color=tableTextColor(6), bgcolor=tableBgColor(6))
    table.cell(statusTable, 0, 7, "金额", text_color=tableTextColor(7), bgcolor=tableBgColor(7))
    table.cell(statusTable, 1, 7, planMoneyText(statusEntryPlan, statusStopPlan, statusRunnerPlan, statusTargetPlan, statusDirectionPlan, statusQtyPlan), text_color=tableTextColor(7), bgcolor=tableBgColor(7))
    table.cell(statusTable, 0, 8, "模型", text_color=tableTextColor(8), bgcolor=tableBgColor(8))
    table.cell(statusTable, 1, 8, ENTRY_WINDOW_MODEL + " / 09:10-15:30", text_color=tableTextColor(8), bgcolor=tableBgColor(8))
