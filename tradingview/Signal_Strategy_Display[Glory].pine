//@version=6
indicator(title="Signal Strategy Display[Glory]", overlay=true, max_labels_count=500, max_lines_count=500)

// Visual companion for Signal Strategy Core[Glory] v3.
// Shows clear-structure small-stop trial plans only; alerts and orders remain in Core.

string STRATEGY_VERSION = "SSD_v3_20260616_clear_structure_small_stop"
string ENTRY_WINDOW_MODEL = "clear_structure_small_stop_v3"
string TP_SL_MODEL = "clear_structure_invalidation_v3"
string TRADE_MODEL = "clear_structure_small_stop_v3"

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
emaFastLen = input.int(20, "EMA fast", minval=1, group="01 Structure")
emaMidLen = input.int(50, "EMA mid", minval=1, group="01 Structure")
emaSlowLen = input.int(100, "EMA slow", minval=1, group="01 Structure")
structureLookbackBars = input.int(60, "Structure lookback bars", minval=10, maxval=300, group="01 Structure")
fractalPeriod = input.int(4, "Pivot period", minval=2, maxval=20, group="01 Structure")
minConfluenceCount = input.int(2, "Minimum structure confluence", minval=1, maxval=5, group="01 Structure")
confluenceZoneAtr = input.float(0.25, "Confluence zone (x ATR)", step=0.05, minval=0.05, maxval=2.0, group="01 Structure")
predictionArmDistanceAtr = input.float(1.20, "Max distance to predictive zone (x ATR)", step=0.10, minval=0.10, maxval=5.0, group="01 Structure")
predictiveEntryOffsetAtr = input.float(0.05, "Predictive entry offset (x ATR)", step=0.01, minval=0.0, maxval=0.50, group="01 Structure")
stopBufferAtr = input.float(0.08, "Invalidation buffer (x ATR)", step=0.01, minval=0.0, maxval=1.0, group="01 Structure")
referenceSession = input.session("0930-1600", "Reference day structure session", group="01 Structure")
dayStructConfirmBars = input.int(2, "Day structure confirm bars", minval=1, maxval=10, group="01 Structure")
dayStructMinReversalAtr = input.float(0.60, "Day structure reversal (x ATR)", step=0.05, minval=0.10, maxval=5.0, group="01 Structure")
trendMinSwingMoveAtr = input.float(0.70, "Trend swing min move (x ATR)", step=0.05, minval=0.10, maxval=5.0, group="01 Structure")
probeMinAnchorAgeBars = input.int(6, "Probe min anchor age bars", minval=1, maxval=60, group="01 Structure")
probeMinPullbackAtr = input.float(0.80, "Probe min pullback (x ATR)", step=0.05, minval=0.10, maxval=5.0, group="01 Structure")
probeRetestBandAtr = input.float(0.35, "Probe retest band (x ATR)", step=0.05, minval=0.05, maxval=3.0, group="01 Structure")
probeMinSignalGapBars = input.int(6, "Probe min signal gap bars", minval=1, maxval=60, group="01 Structure")
probeMinSignalGapAtr = input.float(0.60, "Probe min signal gap (x ATR)", step=0.05, minval=0.10, maxval=5.0, group="01 Structure")
planReplaceMinMoveAtr = input.float(0.25, "Plan replace min move (x ATR)", step=0.05, minval=0.05, maxval=5.0, group="01 Structure")

sdLength = input.int(128, "Regression length", minval=20, group="02 SD / DTP")
sdBandMult = input.float(2.0, "SD band multiplier", step=0.25, minval=0.25, maxval=5.0, group="02 SD / DTP")
dtpSmaLength = input.int(100, "DTP SMA length", minval=5, group="02 SD / DTP")
dtpAtrLength = input.int(200, "DTP ATR length", minval=5, group="02 SD / DTP")
dtpMomentumLookback = input.int(12, "DTP momentum lookback", minval=1, group="02 SD / DTP")
dtpTrendThreshold = input.float(0.10, "DTP trend threshold (ATR units)", step=0.05, group="02 SD / DTP")
dtpEarlyBars = input.int(12, "DTP early bars", minval=1, maxval=48, group="02 SD / DTP")

atrLength = input.int(10, "ATR length", minval=1, group="03 Small Stop Risk")
positionAmount = input.float(5000, "Notional cap per trade ($)", step=500, minval=100, group="03 Small Stop Risk")
predictiveMaxRiskDollars = input.float(37.5, "Predictive max trial risk ($)", step=2.5, minval=1.0, group="03 Small Stop Risk")
confirmedMaxRiskDollars = input.float(75.0, "Confirmed max trial risk ($)", step=5.0, minval=1.0, group="03 Small Stop Risk")
predictiveMaxStopAtr = input.float(0.70, "Predictive max stop distance (x ATR)", step=0.05, minval=0.05, maxval=5.0, group="03 Small Stop Risk")
confirmedMaxStopAtr = input.float(0.90, "Confirmed max stop distance (x ATR)", step=0.05, minval=0.05, maxval=5.0, group="03 Small Stop Risk")
predictiveMaxStopBps = input.float(60.0, "Predictive max stop distance (bps)", step=5.0, minval=1.0, maxval=1000.0, group="03 Small Stop Risk")
confirmedMaxStopBps = input.float(80.0, "Confirmed max stop distance (bps)", step=5.0, minval=1.0, maxval=1000.0, group="03 Small Stop Risk")
predictiveRunnerActivationR = input.float(0.60, "Predictive breakeven/runner trigger (R)", step=0.05, minval=0.10, maxval=5.0, group="03 Small Stop Risk")
confirmedRunnerActivationR = input.float(0.80, "Confirmed breakeven/runner trigger (R)", step=0.05, minval=0.10, maxval=5.0, group="03 Small Stop Risk")
breakevenOffsetR = input.float(0.05, "Breakeven offset (R)", step=0.01, minval=0.0, maxval=1.0, group="03 Small Stop Risk")
runnerTrailAtrMult = input.float(2.0, "Runner trail (x ATR)", step=0.25, minval=0.25, maxval=12.0, group="03 Small Stop Risk")
runnerSafetyR = input.float(6.0, "Safety take profit (R)", step=0.5, minval=1.0, maxval=20.0, group="03 Small Stop Risk")
noFollowThroughBars = input.int(8, "No-follow-through bars", minval=1, maxval=50, group="03 Small Stop Risk")
noFollowThroughMinMfeR = input.float(0.60, "No-follow-through min MFE (R)", step=0.05, minval=0.0, maxval=5.0, group="03 Small Stop Risk")
noFollowThroughCompressedStopR = input.float(0.35, "No-follow-through compressed stop (R)", step=0.05, minval=0.05, maxval=1.0, group="03 Small Stop Risk")
minExpectedR = input.float(2.50, "Minimum expected reward (R)", step=0.25, minval=1.0, maxval=20.0, group="03 Small Stop Risk")

entrySession = input.session("0910-1530", "Entry window", group="04 Display")
useIntradayEntryWindow = input.bool(true, "Use entry window", group="04 Display")
entryOrderTtlBars = input.int(2, "Entry order TTL bars", minval=1, maxval=20, group="04 Display")
showSignalEventFlow = input.bool(true, "Show signal event flow", group="04 Display")
showHistoricalPlanLines = input.bool(true, "Keep historical plan lines", group="04 Display")
showStatusTable = input.bool(true, "Show status table", group="04 Display")
flowLabelTransparency = input.int(12, "Flow label transparency", minval=0, maxval=90, group="04 Display")
labelTextMode = input.string("auto", "Label text color", options=["auto", "white", "black"], group="04 Display")

// -----------------------------------------------------------------------------
// Helpers
// -----------------------------------------------------------------------------
confirmed = barstate.isconfirmed
float atrRaw = ta.atr(atrLength)
float atr = math.max(nz(atrRaw, syminfo.mintick), syminfo.mintick)
float tickBuffer = syminfo.mintick * 2.0
float invalidationBuffer = math.max(tickBuffer, atr * stopBufferAtr)

fmt(float value) =>
    str.tostring(value, "#.##")

riskPerShare(float entryPrice, float stopPrice) =>
    math.abs(entryPrice - stopPrice)

stopDistanceAtr(float entryPrice, float stopPrice, float atrValue) =>
    atrValue > 0.0 ? riskPerShare(entryPrice, stopPrice) / atrValue : na

stopDistanceBps(float entryPrice, float stopPrice) =>
    entryPrice > 0.0 ? riskPerShare(entryPrice, stopPrice) / entryPrice * 10000.0 : na

smallStopTrialAllowed(float entryPrice, float stopPrice, float atrValue, float maxRiskDollars, float maxAtrMultiple, float maxBps) =>
    float rps = riskPerShare(entryPrice, stopPrice)
    float atrDistance = stopDistanceAtr(entryPrice, stopPrice, atrValue)
    float bpsDistance = stopDistanceBps(entryPrice, stopPrice)
    entryPrice > 0.0 and stopPrice > 0.0 and rps > 0.0 and rps <= maxRiskDollars and atrDistance <= maxAtrMultiple and bpsDistance <= maxBps

smallStopGateReason(float entryPrice, float stopPrice, float atrValue, float maxRiskDollars, float maxAtrMultiple, float maxBps) =>
    float rps = riskPerShare(entryPrice, stopPrice)
    float atrDistance = stopDistanceAtr(entryPrice, stopPrice, atrValue)
    float bpsDistance = stopDistanceBps(entryPrice, stopPrice)
    entryPrice <= 0.0 or stopPrice <= 0.0 ? "invalid_price" : rps <= 0.0 ? "invalid_stop" : rps > maxRiskDollars ? "one_share_risk_too_large" : atrDistance > maxAtrMultiple ? "stop_distance_atr_too_large" : bpsDistance > maxBps ? "stop_distance_bps_too_large" : "passed"

calcTrialQty(float entryPrice, float stopPrice, float maxRiskDollars) =>
    float rps = riskPerShare(entryPrice, stopPrice)
    float notionalQty = entryPrice > 0.0 ? math.floor(positionAmount / entryPrice) : 0.0
    float riskQty = rps > 0.0 ? math.floor(maxRiskDollars / rps) : 0.0
    math.max(0.0, math.min(notionalQty, riskQty))

calcTargetAtR(float entryPrice, float stopPrice, int direction, float rMultiple) =>
    entryPrice + riskPerShare(entryPrice, stopPrice) * rMultiple * direction

levelNear(float level, float basis, float tolerance) =>
    not na(level) and not na(basis) and math.abs(level - basis) <= tolerance

nearestBelow(float reference, float a, float b, float c, float d, float e, float f, float g, float h) =>
    float result = na
    result := not na(a) and a <= reference ? a : result
    result := not na(b) and b <= reference and (na(result) or b > result) ? b : result
    result := not na(c) and c <= reference and (na(result) or c > result) ? c : result
    result := not na(d) and d <= reference and (na(result) or d > result) ? d : result
    result := not na(e) and e <= reference and (na(result) or e > result) ? e : result
    result := not na(f) and f <= reference and (na(result) or f > result) ? f : result
    result := not na(g) and g <= reference and (na(result) or g > result) ? g : result
    result := not na(h) and h <= reference and (na(result) or h > result) ? h : result
    result

nearestAbove(float reference, float a, float b, float c, float d, float e, float f, float g, float h) =>
    float result = na
    result := not na(a) and a >= reference ? a : result
    result := not na(b) and b >= reference and (na(result) or b < result) ? b : result
    result := not na(c) and c >= reference and (na(result) or c < result) ? c : result
    result := not na(d) and d >= reference and (na(result) or d < result) ? d : result
    result := not na(e) and e >= reference and (na(result) or e < result) ? e : result
    result := not na(f) and f >= reference and (na(result) or f < result) ? f : result
    result := not na(g) and g >= reference and (na(result) or g < result) ? g : result
    result := not na(h) and h >= reference and (na(result) or h < result) ? h : result
    result

addNearCount(int current, float level, float basis, float tolerance) =>
    levelNear(level, basis, tolerance) ? current + 1 : current

minNear(float current, float level, float basis, float tolerance) =>
    levelNear(level, basis, tolerance) ? (na(current) ? level : math.min(current, level)) : current

maxNear(float current, float level, float basis, float tolerance) =>
    levelNear(level, basis, tolerance) ? (na(current) ? level : math.max(current, level)) : current

appendSource(string current, string source) =>
    current == "" ? source : current + "," + source

appendNearSource(string current, float level, float basis, float tolerance, string source) =>
    levelNear(level, basis, tolerance) ? appendSource(current, source) : current

setupDisplayName(string setup) =>
    setup == "trend_support_long" ? "多·强趋势回踩" : setup == "trend_resistance_short" ? "空·强趋势反弹" : setup == "probe_2b_top_short" ? "空·结构首顶/右肩" : setup == "probe_2b_bottom_long" ? "多·结构首底/右肩" : setup

dirName(int direction) =>
    direction == 1 ? "多" : direction == -1 ? "空" : "--"

intentName(string intent) =>
    intent == "predictive_limit" ? "预测挂单" : intent == "confirmed_limit" ? "确认挂单" : "无"

flowColor(string state, int direction) =>
    state == "blocked" ? color.new(color.gray, flowLabelTransparency) : state == "predictive" ? color.new(color.orange, flowLabelTransparency) : state == "confirmed" ? color.new(color.teal, flowLabelTransparency) : state == "exit" ? color.new(color.purple, flowLabelTransparency) : direction == 1 ? color.new(color.green, flowLabelTransparency) : color.new(color.red, flowLabelTransparency)

labelTextColor(string state, int direction) =>
    labelTextMode == "white" ? color.white : labelTextMode == "black" ? color.black : state == "predictive" or state == "blocked" ? color.black : color.white

flowStyle(int direction) =>
    direction == 1 ? label.style_label_up : label.style_label_down

// -----------------------------------------------------------------------------
// Market structure and candidate generation (mirrors Core).
// -----------------------------------------------------------------------------
float emaFast = ta.ema(close, emaFastLen)
float emaMid = ta.ema(close, emaMidLen)
float emaSlow = ta.ema(close, emaSlowLen)
float dtpAvg = ta.sma(close, dtpSmaLength)
float dtpAtr = ta.atr(dtpAtrLength)
float dtpMomentum = dtpAvg - dtpAvg[dtpMomentumLookback]
float dtpNorm = dtpAtr > 0.0 ? dtpMomentum / dtpAtr : 0.0
bool dtpBullTurn = ta.crossover(dtpNorm, dtpTrendThreshold)
bool dtpBearTurn = ta.crossunder(dtpNorm, -dtpTrendThreshold)
var int dtpDir = 0
var int dtpStartBar = na
if confirmed
    if dtpBullTurn or dtpNorm > dtpTrendThreshold and close > dtpAvg and dtpDir != 1
        dtpDir := 1
        dtpStartBar := bar_index
    if dtpBearTurn or dtpNorm < -dtpTrendThreshold and close < dtpAvg and dtpDir != -1
        dtpDir := -1
        dtpStartBar := bar_index
int dtpPhaseBars = na(dtpStartBar) ? 0 : bar_index - dtpStartBar + 1
bool dtpBull = dtpDir == 1 and close >= dtpAvg
bool dtpBear = dtpDir == -1 and close <= dtpAvg
bool dtpEarly = dtpPhaseBars > 0 and dtpPhaseBars <= dtpEarlyBars

float sdMid = ta.linreg(close, sdLength, 0)
float sdDev = ta.stdev(close, sdLength)
float sdUpper = sdMid + sdDev * sdBandMult
float sdLower = sdMid - sdDev * sdBandMult
float recentHigh = ta.highest(high[1], structureLookbackBars)
float recentLow = ta.lowest(low[1], structureLookbackBars)
float pivotHigh = ta.pivothigh(high, fractalPeriod, fractalPeriod)
float pivotLow = ta.pivotlow(low, fractalPeriod, fractalPeriod)
var float lastPivotHigh = na
var float lastPivotLow = na
if confirmed and not na(pivotHigh)
    lastPivotHigh := pivotHigh
if confirmed and not na(pivotLow)
    lastPivotLow := pivotLow

bool inReferenceSession = not na(time(timeframe.period, referenceSession))
bool referenceSessionStarted = inReferenceSession and not inReferenceSession[1]
bool referenceDayReset = timeframe.change("D") or referenceSessionStarted
var float todayHigh = na
var float todayLow = na
var int todayHighBar = na
var int todayLowBar = na
var float todayStructHigh = na
var float todayStructLow = na
var int todayStructHighBar = na
var int todayStructLowBar = na
var float prevStructHigh = na
var float prevStructLow = na
var float lowSinceStructHigh = na
var float highSinceStructLow = na
var bool topExhaustionUsed = false
var bool bottomExhaustionUsed = false
var int lastTopProbeSignalBar = na
var int lastBottomProbeSignalBar = na
var float lastTopProbeSignalPrice = na
var float lastBottomProbeSignalPrice = na

if confirmed and referenceDayReset
    todayHigh := na
    todayLow := na
    todayHighBar := na
    todayLowBar := na
    todayStructHigh := na
    todayStructLow := na
    todayStructHighBar := na
    todayStructLowBar := na
    prevStructHigh := na
    prevStructLow := na
    lowSinceStructHigh := na
    highSinceStructLow := na
    topExhaustionUsed := false
    bottomExhaustionUsed := false
    lastTopProbeSignalBar := na
    lastBottomProbeSignalBar := na
    lastTopProbeSignalPrice := na
    lastBottomProbeSignalPrice := na

if confirmed and inReferenceSession
    if na(todayHigh) or high > todayHigh
        todayHigh := high
        todayHighBar := bar_index
    if na(todayLow) or low < todayLow
        todayLow := low
        todayLowBar := bar_index
    bool highConfirmed = not na(todayHighBar) and bar_index - todayHighBar >= dayStructConfirmBars and todayHigh - low >= atr * dayStructMinReversalAtr
    if highConfirmed and (na(todayStructHighBar) or todayHighBar != todayStructHighBar)
        prevStructHigh := todayStructHigh
        todayStructHigh := todayHigh
        todayStructHighBar := todayHighBar
        lowSinceStructHigh := low
        topExhaustionUsed := false
    bool lowConfirmed = not na(todayLowBar) and bar_index - todayLowBar >= dayStructConfirmBars and high - todayLow >= atr * dayStructMinReversalAtr
    if lowConfirmed and (na(todayStructLowBar) or todayLowBar != todayStructLowBar)
        prevStructLow := todayStructLow
        todayStructLow := todayLow
        todayStructLowBar := todayLowBar
        highSinceStructLow := high
        bottomExhaustionUsed := false
    if not na(todayStructHigh)
        lowSinceStructHigh := na(lowSinceStructHigh) ? low : math.min(lowSinceStructHigh, low)
    if not na(todayStructLow)
        highSinceStructLow := na(highSinceStructLow) ? high : math.max(highSinceStructLow, high)

bool trendHasHH = not na(todayStructHigh) and not na(prevStructHigh) and todayStructHigh > prevStructHigh + atr * trendMinSwingMoveAtr
bool trendHasHL = not na(todayStructLow) and not na(prevStructLow) and todayStructLow > prevStructLow + atr * trendMinSwingMoveAtr
bool trendHasLL = not na(todayStructLow) and not na(prevStructLow) and todayStructLow < prevStructLow - atr * trendMinSwingMoveAtr
bool trendHasLH = not na(todayStructHigh) and not na(prevStructHigh) and todayStructHigh < prevStructHigh - atr * trendMinSwingMoveAtr
bool strongStructTrendLong = dtpBull and emaFast > emaMid and emaMid > emaSlow and close >= sdMid and trendHasHH and trendHasHL
bool strongStructTrendShort = dtpBear and emaFast < emaMid and emaMid < emaSlow and close <= sdMid and trendHasLL and trendHasLH
bool trendLongContext = strongStructTrendLong
bool trendShortContext = strongStructTrendShort
bool topCounterTrendAllowed = not strongStructTrendLong or not dtpEarly or close < emaFast or close < sdMid
bool bottomCounterTrendAllowed = not strongStructTrendShort or not dtpEarly or close > emaFast or close > sdMid
float tolerance = atr * confluenceZoneAtr

float supportBasis = nearestBelow(close, emaFast, emaMid, emaSlow, dtpAvg, sdMid, sdLower, recentLow, lastPivotLow)
int supportCount = 0
supportCount := addNearCount(supportCount, emaFast, supportBasis, tolerance)
supportCount := addNearCount(supportCount, emaMid, supportBasis, tolerance)
supportCount := addNearCount(supportCount, emaSlow, supportBasis, tolerance)
supportCount := addNearCount(supportCount, dtpAvg, supportBasis, tolerance)
supportCount := addNearCount(supportCount, sdMid, supportBasis, tolerance)
supportCount := addNearCount(supportCount, sdLower, supportBasis, tolerance)
supportCount := addNearCount(supportCount, recentLow, supportBasis, tolerance)
supportCount := addNearCount(supportCount, lastPivotLow, supportBasis, tolerance)
float supportZoneLow = na
supportZoneLow := minNear(supportZoneLow, emaFast, supportBasis, tolerance)
supportZoneLow := minNear(supportZoneLow, emaMid, supportBasis, tolerance)
supportZoneLow := minNear(supportZoneLow, emaSlow, supportBasis, tolerance)
supportZoneLow := minNear(supportZoneLow, dtpAvg, supportBasis, tolerance)
supportZoneLow := minNear(supportZoneLow, sdMid, supportBasis, tolerance)
supportZoneLow := minNear(supportZoneLow, sdLower, supportBasis, tolerance)
supportZoneLow := minNear(supportZoneLow, recentLow, supportBasis, tolerance)
supportZoneLow := minNear(supportZoneLow, lastPivotLow, supportBasis, tolerance)
float supportZoneHigh = na
supportZoneHigh := maxNear(supportZoneHigh, emaFast, supportBasis, tolerance)
supportZoneHigh := maxNear(supportZoneHigh, emaMid, supportBasis, tolerance)
supportZoneHigh := maxNear(supportZoneHigh, emaSlow, supportBasis, tolerance)
supportZoneHigh := maxNear(supportZoneHigh, dtpAvg, supportBasis, tolerance)
supportZoneHigh := maxNear(supportZoneHigh, sdMid, supportBasis, tolerance)
supportZoneHigh := maxNear(supportZoneHigh, sdLower, supportBasis, tolerance)
supportZoneHigh := maxNear(supportZoneHigh, recentLow, supportBasis, tolerance)
supportZoneHigh := maxNear(supportZoneHigh, lastPivotLow, supportBasis, tolerance)
string supportSources = ""
supportSources := appendNearSource(supportSources, emaFast, supportBasis, tolerance, "ema20")
supportSources := appendNearSource(supportSources, emaMid, supportBasis, tolerance, "ema50")
supportSources := appendNearSource(supportSources, emaSlow, supportBasis, tolerance, "ema100")
supportSources := appendNearSource(supportSources, dtpAvg, supportBasis, tolerance, "dtp_avg")
supportSources := appendNearSource(supportSources, sdMid, supportBasis, tolerance, "sd_mid")
supportSources := appendNearSource(supportSources, sdLower, supportBasis, tolerance, "sd_lower")
supportSources := appendNearSource(supportSources, recentLow, supportBasis, tolerance, "recent_low")
supportSources := appendNearSource(supportSources, lastPivotLow, supportBasis, tolerance, "pivot_low")
bool strongSupport = supportCount >= minConfluenceCount and not na(supportZoneLow) and not na(supportZoneHigh)

float resistanceBasis = nearestAbove(close, emaFast, emaMid, emaSlow, dtpAvg, sdMid, sdUpper, recentHigh, lastPivotHigh)
int resistanceCount = 0
resistanceCount := addNearCount(resistanceCount, emaFast, resistanceBasis, tolerance)
resistanceCount := addNearCount(resistanceCount, emaMid, resistanceBasis, tolerance)
resistanceCount := addNearCount(resistanceCount, emaSlow, resistanceBasis, tolerance)
resistanceCount := addNearCount(resistanceCount, dtpAvg, resistanceBasis, tolerance)
resistanceCount := addNearCount(resistanceCount, sdMid, resistanceBasis, tolerance)
resistanceCount := addNearCount(resistanceCount, sdUpper, resistanceBasis, tolerance)
resistanceCount := addNearCount(resistanceCount, recentHigh, resistanceBasis, tolerance)
resistanceCount := addNearCount(resistanceCount, lastPivotHigh, resistanceBasis, tolerance)
float resistanceZoneLow = na
resistanceZoneLow := minNear(resistanceZoneLow, emaFast, resistanceBasis, tolerance)
resistanceZoneLow := minNear(resistanceZoneLow, emaMid, resistanceBasis, tolerance)
resistanceZoneLow := minNear(resistanceZoneLow, emaSlow, resistanceBasis, tolerance)
resistanceZoneLow := minNear(resistanceZoneLow, dtpAvg, resistanceBasis, tolerance)
resistanceZoneLow := minNear(resistanceZoneLow, sdMid, resistanceBasis, tolerance)
resistanceZoneLow := minNear(resistanceZoneLow, sdUpper, resistanceBasis, tolerance)
resistanceZoneLow := minNear(resistanceZoneLow, recentHigh, resistanceBasis, tolerance)
resistanceZoneLow := minNear(resistanceZoneLow, lastPivotHigh, resistanceBasis, tolerance)
float resistanceZoneHigh = na
resistanceZoneHigh := maxNear(resistanceZoneHigh, emaFast, resistanceBasis, tolerance)
resistanceZoneHigh := maxNear(resistanceZoneHigh, emaMid, resistanceBasis, tolerance)
resistanceZoneHigh := maxNear(resistanceZoneHigh, emaSlow, resistanceBasis, tolerance)
resistanceZoneHigh := maxNear(resistanceZoneHigh, dtpAvg, resistanceBasis, tolerance)
resistanceZoneHigh := maxNear(resistanceZoneHigh, sdMid, resistanceBasis, tolerance)
resistanceZoneHigh := maxNear(resistanceZoneHigh, sdUpper, resistanceBasis, tolerance)
resistanceZoneHigh := maxNear(resistanceZoneHigh, recentHigh, resistanceBasis, tolerance)
resistanceZoneHigh := maxNear(resistanceZoneHigh, lastPivotHigh, resistanceBasis, tolerance)
string resistanceSources = ""
resistanceSources := appendNearSource(resistanceSources, emaFast, resistanceBasis, tolerance, "ema20")
resistanceSources := appendNearSource(resistanceSources, emaMid, resistanceBasis, tolerance, "ema50")
resistanceSources := appendNearSource(resistanceSources, emaSlow, resistanceBasis, tolerance, "ema100")
resistanceSources := appendNearSource(resistanceSources, dtpAvg, resistanceBasis, tolerance, "dtp_avg")
resistanceSources := appendNearSource(resistanceSources, sdMid, resistanceBasis, tolerance, "sd_mid")
resistanceSources := appendNearSource(resistanceSources, sdUpper, resistanceBasis, tolerance, "sd_upper")
resistanceSources := appendNearSource(resistanceSources, recentHigh, resistanceBasis, tolerance, "recent_high")
resistanceSources := appendNearSource(resistanceSources, lastPivotHigh, resistanceBasis, tolerance, "pivot_high")
bool strongResistance = resistanceCount >= minConfluenceCount and not na(resistanceZoneLow) and not na(resistanceZoneHigh)

// Trend trades require a formed intraday HH/HL or LL/LH, then use the latest structural HL/LH as the invalidation anchor.
float trendSupportBasis = strongStructTrendLong ? todayStructLow : na
int trendSupportCount = not na(trendSupportBasis) ? 1 : 0
trendSupportCount := addNearCount(trendSupportCount, emaFast, trendSupportBasis, tolerance)
trendSupportCount := addNearCount(trendSupportCount, emaMid, trendSupportBasis, tolerance)
trendSupportCount := addNearCount(trendSupportCount, emaSlow, trendSupportBasis, tolerance)
trendSupportCount := addNearCount(trendSupportCount, dtpAvg, trendSupportBasis, tolerance)
trendSupportCount := addNearCount(trendSupportCount, sdMid, trendSupportBasis, tolerance)
trendSupportCount := addNearCount(trendSupportCount, sdLower, trendSupportBasis, tolerance)
float trendSupportZoneLow = trendSupportBasis
trendSupportZoneLow := minNear(trendSupportZoneLow, emaFast, trendSupportBasis, tolerance)
trendSupportZoneLow := minNear(trendSupportZoneLow, emaMid, trendSupportBasis, tolerance)
trendSupportZoneLow := minNear(trendSupportZoneLow, emaSlow, trendSupportBasis, tolerance)
trendSupportZoneLow := minNear(trendSupportZoneLow, dtpAvg, trendSupportBasis, tolerance)
trendSupportZoneLow := minNear(trendSupportZoneLow, sdMid, trendSupportBasis, tolerance)
trendSupportZoneLow := minNear(trendSupportZoneLow, sdLower, trendSupportBasis, tolerance)
float trendSupportZoneHigh = trendSupportBasis
trendSupportZoneHigh := maxNear(trendSupportZoneHigh, emaFast, trendSupportBasis, tolerance)
trendSupportZoneHigh := maxNear(trendSupportZoneHigh, emaMid, trendSupportBasis, tolerance)
trendSupportZoneHigh := maxNear(trendSupportZoneHigh, emaSlow, trendSupportBasis, tolerance)
trendSupportZoneHigh := maxNear(trendSupportZoneHigh, dtpAvg, trendSupportBasis, tolerance)
trendSupportZoneHigh := maxNear(trendSupportZoneHigh, sdMid, trendSupportBasis, tolerance)
trendSupportZoneHigh := maxNear(trendSupportZoneHigh, sdLower, trendSupportBasis, tolerance)
string trendSupportSources = not na(trendSupportBasis) ? "today_HL" : ""
trendSupportSources := appendNearSource(trendSupportSources, emaFast, trendSupportBasis, tolerance, "ema20")
trendSupportSources := appendNearSource(trendSupportSources, emaMid, trendSupportBasis, tolerance, "ema50")
trendSupportSources := appendNearSource(trendSupportSources, emaSlow, trendSupportBasis, tolerance, "ema100")
trendSupportSources := appendNearSource(trendSupportSources, dtpAvg, trendSupportBasis, tolerance, "dtp_avg")
trendSupportSources := appendNearSource(trendSupportSources, sdMid, trendSupportBasis, tolerance, "sd_mid")
trendSupportSources := appendNearSource(trendSupportSources, sdLower, trendSupportBasis, tolerance, "sd_lower")
bool strongTrendSupport = strongStructTrendLong and trendSupportCount >= minConfluenceCount and not na(trendSupportZoneLow) and not na(trendSupportZoneHigh)

float trendResistanceBasis = strongStructTrendShort ? todayStructHigh : na
int trendResistanceCount = not na(trendResistanceBasis) ? 1 : 0
trendResistanceCount := addNearCount(trendResistanceCount, emaFast, trendResistanceBasis, tolerance)
trendResistanceCount := addNearCount(trendResistanceCount, emaMid, trendResistanceBasis, tolerance)
trendResistanceCount := addNearCount(trendResistanceCount, emaSlow, trendResistanceBasis, tolerance)
trendResistanceCount := addNearCount(trendResistanceCount, dtpAvg, trendResistanceBasis, tolerance)
trendResistanceCount := addNearCount(trendResistanceCount, sdMid, trendResistanceBasis, tolerance)
trendResistanceCount := addNearCount(trendResistanceCount, sdUpper, trendResistanceBasis, tolerance)
float trendResistanceZoneLow = trendResistanceBasis
trendResistanceZoneLow := minNear(trendResistanceZoneLow, emaFast, trendResistanceBasis, tolerance)
trendResistanceZoneLow := minNear(trendResistanceZoneLow, emaMid, trendResistanceBasis, tolerance)
trendResistanceZoneLow := minNear(trendResistanceZoneLow, emaSlow, trendResistanceBasis, tolerance)
trendResistanceZoneLow := minNear(trendResistanceZoneLow, dtpAvg, trendResistanceBasis, tolerance)
trendResistanceZoneLow := minNear(trendResistanceZoneLow, sdMid, trendResistanceBasis, tolerance)
trendResistanceZoneLow := minNear(trendResistanceZoneLow, sdUpper, trendResistanceBasis, tolerance)
float trendResistanceZoneHigh = trendResistanceBasis
trendResistanceZoneHigh := maxNear(trendResistanceZoneHigh, emaFast, trendResistanceBasis, tolerance)
trendResistanceZoneHigh := maxNear(trendResistanceZoneHigh, emaMid, trendResistanceBasis, tolerance)
trendResistanceZoneHigh := maxNear(trendResistanceZoneHigh, emaSlow, trendResistanceBasis, tolerance)
trendResistanceZoneHigh := maxNear(trendResistanceZoneHigh, dtpAvg, trendResistanceBasis, tolerance)
trendResistanceZoneHigh := maxNear(trendResistanceZoneHigh, sdMid, trendResistanceBasis, tolerance)
trendResistanceZoneHigh := maxNear(trendResistanceZoneHigh, sdUpper, trendResistanceBasis, tolerance)
string trendResistanceSources = not na(trendResistanceBasis) ? "today_LH" : ""
trendResistanceSources := appendNearSource(trendResistanceSources, emaFast, trendResistanceBasis, tolerance, "ema20")
trendResistanceSources := appendNearSource(trendResistanceSources, emaMid, trendResistanceBasis, tolerance, "ema50")
trendResistanceSources := appendNearSource(trendResistanceSources, emaSlow, trendResistanceBasis, tolerance, "ema100")
trendResistanceSources := appendNearSource(trendResistanceSources, dtpAvg, trendResistanceBasis, tolerance, "dtp_avg")
trendResistanceSources := appendNearSource(trendResistanceSources, sdMid, trendResistanceBasis, tolerance, "sd_mid")
trendResistanceSources := appendNearSource(trendResistanceSources, sdUpper, trendResistanceBasis, tolerance, "sd_upper")
bool strongTrendResistance = strongStructTrendShort and trendResistanceCount >= minConfluenceCount and not na(trendResistanceZoneLow) and not na(trendResistanceZoneHigh)

float trendLongPredictEntry = strongTrendSupport ? trendSupportZoneLow + atr * predictiveEntryOffsetAtr : na
float trendLongPredictStop = strongTrendSupport ? trendSupportZoneLow - invalidationBuffer : na
float trendLongConfirmEntry = strongTrendSupport ? math.min(close, trendSupportZoneHigh) : na
float trendLongConfirmStop = strongTrendSupport ? math.min(low, trendSupportZoneLow) - invalidationBuffer : na
bool trendLongPredictContext = trendLongContext and strongTrendSupport and trendLongPredictEntry <= close and close - trendSupportZoneHigh <= atr * predictionArmDistanceAtr
bool trendLongConfirmContext = trendLongContext and strongTrendSupport and low <= trendSupportZoneHigh and close > trendSupportZoneHigh and close > open
float trendLongPredictQty = calcTrialQty(trendLongPredictEntry, trendLongPredictStop, predictiveMaxRiskDollars)
float trendLongConfirmQty = calcTrialQty(trendLongConfirmEntry, trendLongConfirmStop, confirmedMaxRiskDollars)
bool trendLongPredictAllowed = trendLongPredictContext and smallStopTrialAllowed(trendLongPredictEntry, trendLongPredictStop, atr, predictiveMaxRiskDollars, predictiveMaxStopAtr, predictiveMaxStopBps) and trendLongPredictQty >= 1.0
bool trendLongConfirmAllowed = trendLongConfirmContext and smallStopTrialAllowed(trendLongConfirmEntry, trendLongConfirmStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps) and trendLongConfirmQty >= 1.0

float trendShortPredictEntry = strongTrendResistance ? trendResistanceZoneHigh - atr * predictiveEntryOffsetAtr : na
float trendShortPredictStop = strongTrendResistance ? trendResistanceZoneHigh + invalidationBuffer : na
float trendShortConfirmEntry = strongTrendResistance ? math.max(close, trendResistanceZoneLow) : na
float trendShortConfirmStop = strongTrendResistance ? math.max(high, trendResistanceZoneHigh) + invalidationBuffer : na
bool trendShortPredictContext = trendShortContext and strongTrendResistance and trendShortPredictEntry >= close and trendResistanceZoneLow - close <= atr * predictionArmDistanceAtr
bool trendShortConfirmContext = trendShortContext and strongTrendResistance and high >= trendResistanceZoneLow and close < trendResistanceZoneLow and close < open
float trendShortPredictQty = calcTrialQty(trendShortPredictEntry, trendShortPredictStop, predictiveMaxRiskDollars)
float trendShortConfirmQty = calcTrialQty(trendShortConfirmEntry, trendShortConfirmStop, confirmedMaxRiskDollars)
bool trendShortPredictAllowed = trendShortPredictContext and smallStopTrialAllowed(trendShortPredictEntry, trendShortPredictStop, atr, predictiveMaxRiskDollars, predictiveMaxStopAtr, predictiveMaxStopBps) and trendShortPredictQty >= 1.0
bool trendShortConfirmAllowed = trendShortConfirmContext and smallStopTrialAllowed(trendShortConfirmEntry, trendShortConfirmStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps) and trendShortConfirmQty >= 1.0

float topBasis = todayStructHigh
float topZoneLow = todayStructHigh
float topZoneHigh = todayStructHigh
int topCount = not na(todayStructHigh) ? 1 : 0
topCount := addNearCount(topCount, sdUpper, topBasis, tolerance)
topCount := addNearCount(topCount, resistanceZoneHigh, topBasis, tolerance)
topCount := addNearCount(topCount, emaFast, topBasis, tolerance)
topCount := addNearCount(topCount, emaMid, topBasis, tolerance)
topCount := addNearCount(topCount, emaSlow, topBasis, tolerance)
topCount := addNearCount(topCount, dtpAvg, topBasis, tolerance)
topZoneLow := minNear(topZoneLow, sdUpper, topBasis, tolerance)
topZoneLow := minNear(topZoneLow, resistanceZoneHigh, topBasis, tolerance)
topZoneLow := minNear(topZoneLow, emaFast, topBasis, tolerance)
topZoneLow := minNear(topZoneLow, emaMid, topBasis, tolerance)
topZoneLow := minNear(topZoneLow, emaSlow, topBasis, tolerance)
topZoneLow := minNear(topZoneLow, dtpAvg, topBasis, tolerance)
topZoneHigh := maxNear(topZoneHigh, sdUpper, topBasis, tolerance)
topZoneHigh := maxNear(topZoneHigh, resistanceZoneHigh, topBasis, tolerance)
topZoneHigh := maxNear(topZoneHigh, emaFast, topBasis, tolerance)
topZoneHigh := maxNear(topZoneHigh, emaMid, topBasis, tolerance)
topZoneHigh := maxNear(topZoneHigh, emaSlow, topBasis, tolerance)
topZoneHigh := maxNear(topZoneHigh, dtpAvg, topBasis, tolerance)
string topSources = not na(todayStructHigh) ? "today_struct_high" : ""
topSources := appendNearSource(topSources, sdUpper, topBasis, tolerance, "sd_upper")
topSources := appendNearSource(topSources, resistanceZoneHigh, topBasis, tolerance, "resistance_cluster")
topSources := appendNearSource(topSources, emaFast, topBasis, tolerance, "ema20")
topSources := appendNearSource(topSources, emaMid, topBasis, tolerance, "ema50")
topSources := appendNearSource(topSources, emaSlow, topBasis, tolerance, "ema100")
topSources := appendNearSource(topSources, dtpAvg, topBasis, tolerance, "dtp_avg")
bool strongTopProbeZone = topCount >= minConfluenceCount and not na(topZoneLow) and not na(topZoneHigh)
int topAnchorAgeBars = not na(todayStructHighBar) ? bar_index - todayStructHighBar : 0
float topPullbackAtr = not na(todayStructHigh) and not na(lowSinceStructHigh) ? (todayStructHigh - lowSinceStructHigh) / atr : na
bool topAnchorReady = topAnchorAgeBars >= probeMinAnchorAgeBars and topPullbackAtr >= probeMinPullbackAtr
bool topRetestBand = not na(todayStructHigh) and high >= todayStructHigh - atr * probeRetestBandAtr and low <= todayStructHigh + atr * probeRetestBandAtr
bool topFirstExhaustion = strongTopProbeZone and not topExhaustionUsed and topPullbackAtr >= dayStructMinReversalAtr and close < todayStructHigh
bool topRightShoulder = strongTopProbeZone and topAnchorReady and topRetestBand
string topProbePattern = topRightShoulder ? "retest_2b_top" : topFirstExhaustion ? "extension_exhaustion_top" : "none"
float topPredictEntry = strongTopProbeZone ? topZoneHigh - atr * predictiveEntryOffsetAtr : na
float topPredictStop = strongTopProbeZone ? topZoneHigh + invalidationBuffer : na
bool topSignalGapOk = (na(lastTopProbeSignalBar) or bar_index - lastTopProbeSignalBar >= probeMinSignalGapBars) and (na(lastTopProbeSignalPrice) or math.abs(topPredictEntry - lastTopProbeSignalPrice) >= atr * probeMinSignalGapAtr)
bool topSweepFailed = confirmed and topRightShoulder and high > todayStructHigh + tickBuffer and close < todayStructHigh
float topConfirmEntry = topSweepFailed ? math.max(close, todayStructHigh - atr * predictiveEntryOffsetAtr) : na
float topConfirmStop = topSweepFailed ? high + invalidationBuffer : na
bool topPredictContext = (topFirstExhaustion or topRightShoulder) and topCounterTrendAllowed and topPredictEntry >= close and topPredictEntry - close <= atr * predictionArmDistanceAtr and topSignalGapOk
bool topConfirmContext = topSweepFailed and topCounterTrendAllowed and topSignalGapOk
float topPredictQty = calcTrialQty(topPredictEntry, topPredictStop, predictiveMaxRiskDollars)
float topConfirmQty = calcTrialQty(topConfirmEntry, topConfirmStop, confirmedMaxRiskDollars)
bool topPredictAllowed = topPredictContext and smallStopTrialAllowed(topPredictEntry, topPredictStop, atr, predictiveMaxRiskDollars, predictiveMaxStopAtr, predictiveMaxStopBps) and topPredictQty >= 1.0
bool topConfirmAllowed = topConfirmContext and smallStopTrialAllowed(topConfirmEntry, topConfirmStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps) and topConfirmQty >= 1.0
string topProbeFilterReason = na(todayStructHigh) ? "no_today_struct_high" : not strongTopProbeZone ? "no_clear_structure" : not (topFirstExhaustion or topRightShoulder) ? (not topAnchorReady ? "anchor_too_fresh_or_no_pullback" : "not_retest_zone") : not topSignalGapOk ? "too_close" : "passed"

float bottomBasis = todayStructLow
float bottomZoneLow = todayStructLow
float bottomZoneHigh = todayStructLow
int bottomCount = not na(todayStructLow) ? 1 : 0
bottomCount := addNearCount(bottomCount, sdLower, bottomBasis, tolerance)
bottomCount := addNearCount(bottomCount, supportZoneLow, bottomBasis, tolerance)
bottomCount := addNearCount(bottomCount, emaFast, bottomBasis, tolerance)
bottomCount := addNearCount(bottomCount, emaMid, bottomBasis, tolerance)
bottomCount := addNearCount(bottomCount, emaSlow, bottomBasis, tolerance)
bottomCount := addNearCount(bottomCount, dtpAvg, bottomBasis, tolerance)
bottomZoneLow := minNear(bottomZoneLow, sdLower, bottomBasis, tolerance)
bottomZoneLow := minNear(bottomZoneLow, supportZoneLow, bottomBasis, tolerance)
bottomZoneLow := minNear(bottomZoneLow, emaFast, bottomBasis, tolerance)
bottomZoneLow := minNear(bottomZoneLow, emaMid, bottomBasis, tolerance)
bottomZoneLow := minNear(bottomZoneLow, emaSlow, bottomBasis, tolerance)
bottomZoneLow := minNear(bottomZoneLow, dtpAvg, bottomBasis, tolerance)
bottomZoneHigh := maxNear(bottomZoneHigh, sdLower, bottomBasis, tolerance)
bottomZoneHigh := maxNear(bottomZoneHigh, supportZoneLow, bottomBasis, tolerance)
bottomZoneHigh := maxNear(bottomZoneHigh, emaFast, bottomBasis, tolerance)
bottomZoneHigh := maxNear(bottomZoneHigh, emaMid, bottomBasis, tolerance)
bottomZoneHigh := maxNear(bottomZoneHigh, emaSlow, bottomBasis, tolerance)
bottomZoneHigh := maxNear(bottomZoneHigh, dtpAvg, bottomBasis, tolerance)
string bottomSources = not na(todayStructLow) ? "today_struct_low" : ""
bottomSources := appendNearSource(bottomSources, sdLower, bottomBasis, tolerance, "sd_lower")
bottomSources := appendNearSource(bottomSources, supportZoneLow, bottomBasis, tolerance, "support_cluster")
bottomSources := appendNearSource(bottomSources, emaFast, bottomBasis, tolerance, "ema20")
bottomSources := appendNearSource(bottomSources, emaMid, bottomBasis, tolerance, "ema50")
bottomSources := appendNearSource(bottomSources, emaSlow, bottomBasis, tolerance, "ema100")
bottomSources := appendNearSource(bottomSources, dtpAvg, bottomBasis, tolerance, "dtp_avg")
bool strongBottomProbeZone = bottomCount >= minConfluenceCount and not na(bottomZoneLow) and not na(bottomZoneHigh)
int bottomAnchorAgeBars = not na(todayStructLowBar) ? bar_index - todayStructLowBar : 0
float bottomPullbackAtr = not na(todayStructLow) and not na(highSinceStructLow) ? (highSinceStructLow - todayStructLow) / atr : na
bool bottomAnchorReady = bottomAnchorAgeBars >= probeMinAnchorAgeBars and bottomPullbackAtr >= probeMinPullbackAtr
bool bottomRetestBand = not na(todayStructLow) and low <= todayStructLow + atr * probeRetestBandAtr and high >= todayStructLow - atr * probeRetestBandAtr
bool bottomFirstExhaustion = strongBottomProbeZone and not bottomExhaustionUsed and bottomPullbackAtr >= dayStructMinReversalAtr and close > todayStructLow
bool bottomRightShoulder = strongBottomProbeZone and bottomAnchorReady and bottomRetestBand
string bottomProbePattern = bottomRightShoulder ? "retest_2b_bottom" : bottomFirstExhaustion ? "extension_exhaustion_bottom" : "none"
float bottomPredictEntry = strongBottomProbeZone ? bottomZoneLow + atr * predictiveEntryOffsetAtr : na
float bottomPredictStop = strongBottomProbeZone ? bottomZoneLow - invalidationBuffer : na
bool bottomSignalGapOk = (na(lastBottomProbeSignalBar) or bar_index - lastBottomProbeSignalBar >= probeMinSignalGapBars) and (na(lastBottomProbeSignalPrice) or math.abs(bottomPredictEntry - lastBottomProbeSignalPrice) >= atr * probeMinSignalGapAtr)
bool bottomSweepFailed = confirmed and bottomRightShoulder and low < todayStructLow - tickBuffer and close > todayStructLow
float bottomConfirmEntry = bottomSweepFailed ? math.min(close, todayStructLow + atr * predictiveEntryOffsetAtr) : na
float bottomConfirmStop = bottomSweepFailed ? low - invalidationBuffer : na
bool bottomPredictContext = (bottomFirstExhaustion or bottomRightShoulder) and bottomCounterTrendAllowed and bottomPredictEntry <= close and close - bottomPredictEntry <= atr * predictionArmDistanceAtr and bottomSignalGapOk
bool bottomConfirmContext = bottomSweepFailed and bottomCounterTrendAllowed and bottomSignalGapOk
float bottomPredictQty = calcTrialQty(bottomPredictEntry, bottomPredictStop, predictiveMaxRiskDollars)
float bottomConfirmQty = calcTrialQty(bottomConfirmEntry, bottomConfirmStop, confirmedMaxRiskDollars)
bool bottomPredictAllowed = bottomPredictContext and smallStopTrialAllowed(bottomPredictEntry, bottomPredictStop, atr, predictiveMaxRiskDollars, predictiveMaxStopAtr, predictiveMaxStopBps) and bottomPredictQty >= 1.0
bool bottomConfirmAllowed = bottomConfirmContext and smallStopTrialAllowed(bottomConfirmEntry, bottomConfirmStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps) and bottomConfirmQty >= 1.0
string bottomProbeFilterReason = na(todayStructLow) ? "no_today_struct_low" : not strongBottomProbeZone ? "no_clear_structure" : not (bottomFirstExhaustion or bottomRightShoulder) ? (not bottomAnchorReady ? "anchor_too_fresh_or_no_pullback" : "not_retest_zone") : not bottomSignalGapOk ? "too_close" : "passed"

bool longActionable = trendLongConfirmAllowed or bottomConfirmAllowed or trendLongPredictAllowed or bottomPredictAllowed
bool shortActionable = trendShortConfirmAllowed or topConfirmAllowed or trendShortPredictAllowed or topPredictAllowed
int longScore = trendLongConfirmAllowed ? 160 + trendSupportCount : bottomConfirmAllowed ? 140 + bottomCount : trendLongPredictAllowed ? 100 + trendSupportCount : bottomPredictAllowed ? 80 + bottomCount : 0
int shortScore = trendShortConfirmAllowed ? 160 + trendResistanceCount : topConfirmAllowed ? 140 + topCount : trendShortPredictAllowed ? 100 + trendResistanceCount : topPredictAllowed ? 80 + topCount : 0
bool conflict = longActionable and shortActionable and longScore == shortScore
bool selectedLong = longActionable and not conflict and (not shortActionable or longScore > shortScore)
bool selectedShort = shortActionable and not conflict and (not longActionable or shortScore > longScore)
int selectedDirection = selectedLong ? 1 : selectedShort ? -1 : 0
string selectedSetup = selectedLong ? (trendLongConfirmAllowed ? "trend_support_long" : bottomConfirmAllowed ? "probe_2b_bottom_long" : trendLongPredictAllowed ? "trend_support_long" : "probe_2b_bottom_long") : selectedShort ? (trendShortConfirmAllowed ? "trend_resistance_short" : topConfirmAllowed ? "probe_2b_top_short" : trendShortPredictAllowed ? "trend_resistance_short" : "probe_2b_top_short") : "none"
string selectedEntryIntent = selectedLong ? (trendLongConfirmAllowed or bottomConfirmAllowed ? "confirmed_limit" : "predictive_limit") : selectedShort ? (trendShortConfirmAllowed or topConfirmAllowed ? "confirmed_limit" : "predictive_limit") : "none"
string selectedTrialRiskMode = selectedEntryIntent == "predictive_limit" ? "half" : selectedEntryIntent == "confirmed_limit" ? "full" : "none"
float selectedEntry = selectedLong ? (trendLongConfirmAllowed ? trendLongConfirmEntry : bottomConfirmAllowed ? bottomConfirmEntry : trendLongPredictAllowed ? trendLongPredictEntry : bottomPredictEntry) : selectedShort ? (trendShortConfirmAllowed ? trendShortConfirmEntry : topConfirmAllowed ? topConfirmEntry : trendShortPredictAllowed ? trendShortPredictEntry : topPredictEntry) : na
float selectedStop = selectedLong ? (trendLongConfirmAllowed ? trendLongConfirmStop : bottomConfirmAllowed ? bottomConfirmStop : trendLongPredictAllowed ? trendLongPredictStop : bottomPredictStop) : selectedShort ? (trendShortConfirmAllowed ? trendShortConfirmStop : topConfirmAllowed ? topConfirmStop : trendShortPredictAllowed ? trendShortPredictStop : topPredictStop) : na
float selectedQty = selectedLong ? (trendLongConfirmAllowed ? trendLongConfirmQty : bottomConfirmAllowed ? bottomConfirmQty : trendLongPredictAllowed ? trendLongPredictQty : bottomPredictQty) : selectedShort ? (trendShortConfirmAllowed ? trendShortConfirmQty : topConfirmAllowed ? topConfirmQty : trendShortPredictAllowed ? trendShortPredictQty : topPredictQty) : 0.0
float selectedZoneLow = selectedLong ? (selectedSetup == "trend_support_long" ? trendSupportZoneLow : bottomZoneLow) : selectedShort ? (selectedSetup == "trend_resistance_short" ? trendResistanceZoneLow : topZoneLow) : na
float selectedZoneHigh = selectedLong ? (selectedSetup == "trend_support_long" ? trendSupportZoneHigh : bottomZoneHigh) : selectedShort ? (selectedSetup == "trend_resistance_short" ? trendResistanceZoneHigh : topZoneHigh) : na
float selectedPredictionLevel = selectedDirection == 1 ? selectedZoneLow : selectedZoneHigh
float selectedInvalidation = selectedStop
float selectedRiskBudget = selectedEntryIntent == "predictive_limit" ? predictiveMaxRiskDollars : confirmedMaxRiskDollars
float selectedMaxStopAtr = selectedEntryIntent == "predictive_limit" ? predictiveMaxStopAtr : confirmedMaxStopAtr
float selectedMaxStopBps = selectedEntryIntent == "predictive_limit" ? predictiveMaxStopBps : confirmedMaxStopBps
float selectedActivationR = selectedEntryIntent == "predictive_limit" ? predictiveRunnerActivationR : confirmedRunnerActivationR
float selectedRunnerActivation = selectedDirection != 0 ? calcTargetAtR(selectedEntry, selectedStop, selectedDirection, selectedActivationR) : na
float selectedTarget = selectedDirection != 0 ? calcTargetAtR(selectedEntry, selectedStop, selectedDirection, runnerSafetyR) : na
float selectedStopDistanceAtr = stopDistanceAtr(selectedEntry, selectedStop, atr)
float selectedStopDistanceBps = stopDistanceBps(selectedEntry, selectedStop)
float selectedExpectedR = selectedDirection != 0 and riskPerShare(selectedEntry, selectedStop) > 0.0 ? math.abs(selectedTarget - selectedEntry) / riskPerShare(selectedEntry, selectedStop) : na
bool selectedExpectedRPassed = selectedDirection != 0 and selectedExpectedR >= minExpectedR
bool selectedSmallStopGatePassed = selectedDirection != 0 and smallStopTrialAllowed(selectedEntry, selectedStop, atr, selectedRiskBudget, selectedMaxStopAtr, selectedMaxStopBps)
string selectedSmallStopGateReason = selectedDirection == 0 ? "no_candidate" : smallStopGateReason(selectedEntry, selectedStop, atr, selectedRiskBudget, selectedMaxStopAtr, selectedMaxStopBps)
float selectedStructureAnchor = selectedSetup == "trend_support_long" ? trendSupportBasis : selectedSetup == "trend_resistance_short" ? trendResistanceBasis : selectedSetup == "probe_2b_top_short" ? todayStructHigh : selectedSetup == "probe_2b_bottom_long" ? todayStructLow : na
bool selectedStructureClear = selectedSetup == "trend_support_long" ? strongStructTrendLong and strongTrendSupport : selectedSetup == "trend_resistance_short" ? strongStructTrendShort and strongTrendResistance : selectedSetup == "probe_2b_top_short" ? strongTopProbeZone and (topFirstExhaustion or topRightShoulder) : selectedSetup == "probe_2b_bottom_long" ? strongBottomProbeZone and (bottomFirstExhaustion or bottomRightShoulder) : false
string selectedProbePattern = selectedSetup == "probe_2b_top_short" ? topProbePattern : selectedSetup == "probe_2b_bottom_long" ? bottomProbePattern : "none"
string selectedProbeFilterReason = selectedSetup == "probe_2b_top_short" ? topProbeFilterReason : selectedSetup == "probe_2b_bottom_long" ? bottomProbeFilterReason : "none"
float selectedProbeAnchorAgeBars = selectedSetup == "probe_2b_top_short" ? topAnchorAgeBars * 1.0 : selectedSetup == "probe_2b_bottom_long" ? bottomAnchorAgeBars * 1.0 : na
float selectedProbePullbackAtr = selectedSetup == "probe_2b_top_short" ? topPullbackAtr : selectedSetup == "probe_2b_bottom_long" ? bottomPullbackAtr : na
float selectedProbeAnchorPrice = selectedSetup == "probe_2b_top_short" ? todayStructHigh : selectedSetup == "probe_2b_bottom_long" ? todayStructLow : na
string trendStructDir = strongStructTrendLong ? "bull_HH_HL" : strongStructTrendShort ? "bear_LL_LH" : "none"
string selectedTrendStructPattern = selectedSetup == "trend_support_long" ? "HH_HL" : selectedSetup == "trend_resistance_short" ? "LL_LH" : "none"
string selectedTrendSources = selectedSetup == "trend_support_long" ? trendSupportSources : selectedSetup == "trend_resistance_short" ? trendResistanceSources : "none"
string selectedMainReason = selectedSetup == "trend_support_long" ? "clear_bull_HH_HL_pullback_to_today_HL" : selectedSetup == "trend_resistance_short" ? "clear_bear_LL_LH_rebound_to_today_LH" : selectedSetup == "probe_2b_top_short" ? "today_struct_high_probe_failed_breakout" : selectedSetup == "probe_2b_bottom_long" ? "today_struct_low_probe_failed_breakout" : "none"
string selectedSecondaryReason = selectedSetup == "trend_support_long" ? trendSupportSources : selectedSetup == "trend_resistance_short" ? trendResistanceSources : selectedSetup == "probe_2b_top_short" ? topSources : selectedSetup == "probe_2b_bottom_long" ? bottomSources : "none"
string selectedBlockReason = selectedDirection == 0 ? "no_candidate" : not selectedStructureClear ? "no_clear_structure" : not selectedSmallStopGatePassed ? selectedSmallStopGateReason : not selectedExpectedRPassed ? "expected_r_too_small" : "passed"

bool inEntryWindow = not useIntradayEntryWindow or not na(time(timeframe.period, entrySession))
bool selectedPlanValid = selectedDirection != 0 and selectedStructureClear and selectedSmallStopGatePassed and selectedExpectedRPassed and selectedQty >= 1.0 and inEntryWindow

// -----------------------------------------------------------------------------
// Visual lifecycle shadow.
// -----------------------------------------------------------------------------
var bool shadowPending = false
var bool shadowOpen = false
var int shadowDirection = 0
var string shadowSetup = ""
var string shadowIntent = ""
var string shadowTrialRiskMode = ""
var float shadowEntry = na
var float shadowStop = na
var float shadowTarget = na
var float shadowRunner = na
var float shadowQty = na
var int shadowSignalBar = na
var int shadowExpiresBar = na
var int shadowEntryBar = na
var float shadowInitialRisk = na
var bool shadowRunnerActive = false
var float shadowRunnerExtreme = na
var float shadowMfeR = 0.0
var int flowId = 0
var line currentEntryLine = na
var line currentStopLine = na
var line currentRunnerLine = na
var line currentTargetLine = na

newPlanNow = confirmed and showSignalEventFlow and selectedPlanValid and not shadowPending and not shadowOpen
if newPlanNow
    flowId += 1
    shadowPending := true
    shadowOpen := false
    shadowDirection := selectedDirection
    shadowSetup := selectedSetup
    shadowIntent := selectedEntryIntent
    shadowTrialRiskMode := selectedTrialRiskMode
    shadowEntry := selectedEntry
    shadowStop := selectedStop
    shadowTarget := selectedTarget
    shadowRunner := selectedRunnerActivation
    shadowQty := selectedQty
    shadowSignalBar := bar_index
    shadowExpiresBar := bar_index + entryOrderTtlBars
    shadowEntryBar := na
    shadowInitialRisk := riskPerShare(selectedEntry, selectedStop)
    shadowRunnerActive := false
    shadowRunnerExtreme := na
    shadowMfeR := 0.0
    if selectedSetup == "probe_2b_top_short"
        lastTopProbeSignalBar := bar_index
        lastTopProbeSignalPrice := selectedEntry
        topExhaustionUsed := selectedProbePattern == "extension_exhaustion_top" ? true : topExhaustionUsed
    if selectedSetup == "probe_2b_bottom_long"
        lastBottomProbeSignalBar := bar_index
        lastBottomProbeSignalPrice := selectedEntry
        bottomExhaustionUsed := selectedProbePattern == "extension_exhaustion_bottom" ? true : bottomExhaustionUsed
    string detail = "F" + str.tostring(flowId) + " ②" + intentName(selectedEntryIntent) + " " + dirName(selectedDirection) + "\n" + setupDisplayName(selectedSetup) + "\n主因: " + selectedMainReason + "\n次因: " + (selectedSecondaryReason == "" ? "none" : selectedSecondaryReason) + "\n结构锚点 " + fmt(selectedStructureAnchor) + " / expected " + fmt(selectedExpectedR) + "R\nplan " + fmt(selectedEntry) + " / SL " + fmt(selectedStop) + "\n蓝Runner " + fmt(selectedRunnerActivation) + " / 绿SafetyTP " + fmt(selectedTarget) + "\n小止损: " + selectedSmallStopGateReason + " / " + fmt(selectedStopDistanceAtr) + "ATR / " + fmt(selectedStopDistanceBps) + "bps\nprobe: " + selectedProbePattern + " / filter " + selectedProbeFilterReason + "\n风险模式: " + selectedTrialRiskMode + " $" + fmt(selectedRiskBudget) + " / TTL " + str.tostring(entryOrderTtlBars)
    label.new(bar_index, selectedDirection == 1 ? low - atr * 1.5 : high + atr * 1.5, detail, style=flowStyle(selectedDirection), color=flowColor(selectedEntryIntent == "predictive_limit" ? "predictive" : "confirmed", selectedDirection), textcolor=labelTextColor(selectedEntryIntent == "predictive_limit" ? "predictive" : "confirmed", selectedDirection), size=size.small, tooltip=detail)
    int lineEnd = bar_index + entryOrderTtlBars
    currentEntryLine := line.new(bar_index, shadowEntry, lineEnd, shadowEntry, color=color.new(color.yellow, 0), width=3)
    currentStopLine := line.new(bar_index, shadowStop, lineEnd, shadowStop, color=color.new(color.red, 0), width=3)
    currentRunnerLine := line.new(bar_index, shadowRunner, lineEnd, shadowRunner, color=color.new(color.blue, 0), width=3)
    currentTargetLine := line.new(bar_index, shadowTarget, lineEnd, shadowTarget, color=color.new(color.green, 0), width=3)

if showHistoricalPlanLines and (shadowPending or shadowOpen) and not na(shadowSignalBar)
    int lineEnd = math.max(bar_index, shadowSignalBar + 1)
    if not na(currentEntryLine)
        line.set_x2(currentEntryLine, lineEnd)
    if not na(currentStopLine)
        line.set_x2(currentStopLine, lineEnd)
        line.set_y2(currentStopLine, shadowStop)
    if not na(currentRunnerLine)
        line.set_x2(currentRunnerLine, lineEnd)
    if not na(currentTargetLine)
        line.set_x2(currentTargetLine, lineEnd)

bool pendingTouched = confirmed and shadowPending and bar_index > shadowSignalBar and (shadowDirection == 1 ? low <= shadowEntry : high >= shadowEntry)
bool pendingExpired = confirmed and shadowPending and bar_index > shadowExpiresBar
bool pendingInvalidated = confirmed and shadowPending and (shadowDirection == 1 ? close < shadowStop : close > shadowStop)
if pendingTouched
    shadowPending := false
    shadowOpen := true
    shadowEntryBar := bar_index
    shadowRunnerExtreme := shadowDirection == 1 ? high : low
    string detail = "F" + str.tostring(flowId) + " ④触及 " + dirName(shadowDirection) + "\nplan " + fmt(shadowEntry) + " 已触及\nDisplay shadow，不代表 TV strategy 已成交；真实成交看 Core Strategy Tester / Core entry_fill / 券商订单"
    label.new(bar_index, shadowDirection == 1 ? low - atr * 1.8 : high + atr * 1.8, detail, style=flowStyle(shadowDirection), color=flowColor("confirmed", shadowDirection), textcolor=labelTextColor("confirmed", shadowDirection), size=size.small, tooltip=detail)
if pendingExpired or pendingInvalidated
    string reason = pendingInvalidated ? "结构失效/打穿止损" : "挂单TTL过期"
    string detail = "F" + str.tostring(flowId) + " ④撤销 " + dirName(shadowDirection) + "\n原因: " + reason + "\nplan " + fmt(shadowEntry) + " / SL " + fmt(shadowStop) + "\n信号bar " + str.tostring(shadowSignalBar) + " / expires " + str.tostring(shadowExpiresBar)
    label.new(bar_index, shadowDirection == 1 ? low - atr * 1.8 : high + atr * 1.8, detail, style=flowStyle(shadowDirection), color=flowColor("blocked", shadowDirection), textcolor=labelTextColor("blocked", shadowDirection), size=size.small, tooltip=detail)
    shadowPending := false

bool shadowExitNow = false
string shadowExitReason = ""
float shadowExitPrice = na
if confirmed and shadowOpen
    int barsInTrade = na(shadowEntryBar) ? 0 : bar_index - shadowEntryBar
    shadowRunnerExtreme := shadowDirection == 1 ? math.max(nz(shadowRunnerExtreme, high), high) : math.min(nz(shadowRunnerExtreme, low), low)
    float mfeNow = shadowInitialRisk > 0.0 ? (shadowDirection == 1 ? (high - shadowEntry) / shadowInitialRisk : (shadowEntry - low) / shadowInitialRisk) : 0.0
    shadowMfeR := math.max(nz(shadowMfeR, 0.0), mfeNow)
    bool runnerReached = shadowDirection == 1 ? high >= shadowRunner : low <= shadowRunner
    if not shadowRunnerActive and runnerReached
        shadowRunnerActive := true
        float beStop = shadowEntry + shadowInitialRisk * breakevenOffsetR * shadowDirection
        shadowStop := shadowDirection == 1 ? math.max(shadowStop, beStop) : math.min(shadowStop, beStop)
        string detail = "F" + str.tostring(flowId) + " ⑤保本/Runner\n到达蓝线 " + fmt(shadowRunner) + "\nSL -> " + fmt(shadowStop)
        label.new(bar_index, shadowDirection == 1 ? high + atr * 1.4 : low - atr * 1.4, detail, style=shadowDirection == 1 ? label.style_label_down : label.style_label_up, color=color.new(color.blue, flowLabelTransparency), textcolor=labelTextColor("runner", shadowDirection), size=size.small, tooltip=detail)
    if shadowRunnerActive
        float trailStop = shadowDirection == 1 ? shadowRunnerExtreme - atr * runnerTrailAtrMult : shadowRunnerExtreme + atr * runnerTrailAtrMult
        shadowStop := shadowDirection == 1 ? math.max(shadowStop, trailStop) : math.min(shadowStop, trailStop)
    if not shadowRunnerActive and barsInTrade >= noFollowThroughBars and shadowMfeR < noFollowThroughMinMfeR
        float compressedStop = shadowEntry - shadowInitialRisk * noFollowThroughCompressedStopR * shadowDirection
        shadowStop := shadowDirection == 1 ? math.max(shadowStop, compressedStop) : math.min(shadowStop, compressedStop)
    bool stopHit = shadowDirection == 1 ? low <= shadowStop : high >= shadowStop
    bool targetHit = shadowDirection == 1 ? high >= shadowTarget : low <= shadowTarget
    shadowExitNow := stopHit or targetHit
    shadowExitReason := stopHit and shadowRunnerActive ? "跟踪止盈" : stopHit ? "小止损" : targetHit ? "安全TP" : ""
    shadowExitPrice := stopHit ? shadowStop : targetHit ? shadowTarget : na
if shadowExitNow
    float pnl = (shadowExitPrice - shadowEntry) * shadowDirection * shadowQty
    float pnlR = shadowInitialRisk > 0.0 ? (shadowExitPrice - shadowEntry) * shadowDirection / shadowInitialRisk : na
    string detail = "F" + str.tostring(flowId) + " ⑤退出 " + dirName(shadowDirection) + "\n原因: " + shadowExitReason + "\n价格 " + fmt(shadowExitPrice) + "\nPnL $" + fmt(pnl) + " / " + fmt(pnlR) + "R"
    label.new(bar_index, shadowDirection == 1 ? high + atr * 1.8 : low - atr * 1.8, detail, style=shadowDirection == 1 ? label.style_label_down : label.style_label_up, color=flowColor("exit", shadowDirection), textcolor=labelTextColor("exit", shadowDirection), size=size.small, tooltip=detail)
    shadowOpen := false

bool blockedCandidate = confirmed and showSignalEventFlow and selectedDirection != 0 and (selectedBlockReason != "passed" or not inEntryWindow)
if blockedCandidate
    string displayBlockReason = not inEntryWindow ? "outside_entry_session" : selectedBlockReason
    string detail = "过滤 " + dirName(selectedDirection) + "\n主因: " + selectedMainReason + "\n次因: " + (selectedSecondaryReason == "" ? "none" : selectedSecondaryReason) + "\n原因: " + displayBlockReason + "\n结构 " + fmt(selectedStructureAnchor) + " / expected " + fmt(selectedExpectedR) + "R\n距离 " + fmt(selectedStopDistanceAtr) + "ATR / " + fmt(selectedStopDistanceBps) + "bps"
    label.new(bar_index, selectedDirection == 1 ? low - atr * 1.2 : high + atr * 1.2, detail, style=flowStyle(selectedDirection), color=flowColor("blocked", selectedDirection), textcolor=labelTextColor("blocked", selectedDirection), size=size.tiny, tooltip=detail)

// Lightweight context plots for reading the structure; these are visual only.
plot(emaFast, "EMA20", color=color.new(color.orange, 35))
plot(emaMid, "EMA50", color=color.new(color.gray, 45))
plot(emaSlow, "EMA100", color=color.new(color.silver, 55))
plot(sdUpper, "SD Upper", color=color.new(color.red, 75))
plot(sdMid, "SD Mid", color=color.new(color.blue, 80))
plot(sdLower, "SD Lower", color=color.new(color.green, 75))
plot(todayStructHigh, "Today Struct High", color=color.new(color.red, 20), linewidth=2, style=plot.style_linebr)
plot(todayStructLow, "Today Struct Low", color=color.new(color.green, 20), linewidth=2, style=plot.style_linebr)
plotshape(newPlanNow and selectedDirection == 1, title="Predictive/confirmed long", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny, text="多")
plotshape(newPlanNow and selectedDirection == -1, title="Predictive/confirmed short", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny, text="空")

var table statusTable = table.new(position.top_right, 2, 8)
if showStatusTable and barstate.islast
    table.cell(statusTable, 0, 0, "v3状态", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(statusTable, 1, 0, shadowPending ? "预挂中" : shadowOpen ? "持仓影子" : selectedPlanValid ? "有计划" : "等待", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(statusTable, 0, 1, "方向", text_color=color.white)
    table.cell(statusTable, 1, 1, selectedDirection != 0 ? dirName(selectedDirection) : dirName(shadowDirection), text_color=color.white)
    table.cell(statusTable, 0, 2, "模式", text_color=color.white)
    table.cell(statusTable, 1, 2, selectedEntryIntent, text_color=color.white)
    table.cell(statusTable, 0, 3, "主因", text_color=color.white)
    table.cell(statusTable, 1, 3, selectedMainReason, text_color=color.white)
    table.cell(statusTable, 0, 4, "结构/小止损", text_color=color.white)
    table.cell(statusTable, 1, 4, (selectedStructureClear ? "清晰" : "等待") + " / " + selectedSmallStopGateReason, text_color=color.white)
    table.cell(statusTable, 0, 5, "黄/红/蓝/绿", text_color=color.white)
    table.cell(statusTable, 1, 5, "Entry / SL / Runner / SafetyTP", text_color=color.white)
    table.cell(statusTable, 0, 6, "窗口", text_color=color.white)
    table.cell(statusTable, 1, 6, inEntryWindow ? "可入场" : "关闭", text_color=color.white)
    table.cell(statusTable, 0, 7, "模型", text_color=color.white)
    table.cell(statusTable, 1, 7, ENTRY_WINDOW_MODEL + " / 09:10-15:30", text_color=color.white)
