float selectedQty = selectedLong ? (trendLongConfirmNow ? trendLongConfirmQty : bottomConfirmQty) : selectedShort ? (trendShortConfirmNow ? trendShortConfirmQty : topConfirmQty) : 0.0
float selectedZoneLow = selectedLong ? (selectedTrendSupport ? trendSupportZoneLow : bottomZoneLow) : selectedShort ? (selectedTrendResistance ? trendResistanceZoneLow : topZoneLow) : na
float selectedZoneHigh = selectedLong ? (selectedTrendSupport ? trendSupportZoneHigh : bottomZoneHigh) : selectedShort ? (selectedTrendResistance ? trendResistanceZoneHigh : topZoneHigh) : na
float selectedPredictionLevel = selectedDirection == 1 ? selectedZoneLow : selectedZoneHigh
float selectedInvalidation = selectedStop
float selectedRiskBudget = selectedDirection != 0 ? confirmedMaxRiskDollars : na
float selectedMaxStopAtr = selectedDirection != 0 ? confirmedMaxStopAtr : na
float selectedMaxStopBps = selectedDirection != 0 ? confirmedMaxStopBps : na
float selectedActivationR = selectedDirection != 0 ? scalpBreakevenR : na
float selectedRunnerActivation = selectedDirection != 0 ? calcTargetAtR(selectedEntry, selectedStop, selectedDirection, selectedActivationR) : na
float selectedTarget = selectedDirection != 0 ? scalpEmaTarget(selectedDirection, emaFast, atr, emaTargetOffsetAtr) : na
float selectedStopDistanceAtr = stopDistanceAtr(selectedEntry, selectedStop, atr)
float selectedStopDistanceBps = stopDistanceBps(selectedEntry, selectedStop)
float selectedEmaProfitAtr = selectedDirection != 0 and atr > 0.0 ? math.abs(selectedTarget - selectedEntry) / atr : na
bool selectedEmaTargetInProfit = selectedDirection == 1 ? selectedTarget > selectedEntry : selectedDirection == -1 ? selectedTarget < selectedEntry : false
float selectedExpectedR = selectedDirection != 0 and riskPerShare(selectedEntry, selectedStop) > 0.0 ? math.abs(selectedTarget - selectedEntry) / riskPerShare(selectedEntry, selectedStop) : na
bool selectedExpectedRPassed = selectedDirection != 0 and selectedEmaTargetInProfit and selectedEmaProfitAtr >= minEmaProfitAtr and selectedExpectedR >= scalpMinExpectedR
bool selectedSmallStopGatePassed = selectedDirection != 0 and smallStopTrialAllowed(selectedEntry, selectedStop, atr, selectedRiskBudget, selectedMaxStopAtr, selectedMaxStopBps)
string selectedSmallStopGateReason = selectedDirection == 0 ? "no_candidate" : smallStopGateReason(selectedEntry, selectedStop, atr, selectedRiskBudget, selectedMaxStopAtr, selectedMaxStopBps)
float selectedStructureAnchor = selectedTrendSupport ? trendSupportBasis : selectedTrendResistance ? trendResistanceBasis : selectedTopProbe ? todayStructHigh : selectedBottomProbe ? todayStructLow : na
float selectedEntryAnchorDistanceAtr = selectedDirection != 0 and not na(selectedStructureAnchor) and atr > 0.0 ? math.abs(selectedEntry - selectedStructureAnchor) / atr : na
float selectedCurrentAnchorDistanceAtr = selectedDirection != 0 and not na(selectedStructureAnchor) and atr > 0.0 ? math.abs(close - selectedStructureAnchor) / atr : na
bool selectedEntryNearAnchorOnly = selectedDirection == 0 or (not na(selectedEntryAnchorDistanceAtr) and selectedEntryAnchorDistanceAtr <= scalpMaxEntryAwayAtr)
bool selectedCloseNearAnchor = selectedDirection == 0 or (not na(selectedCurrentAnchorDistanceAtr) and selectedCurrentAnchorDistanceAtr <= scalpMaxEntryAwayAtr)
bool selectedCloseFarFromAnchor = selectedDirection != 0 and selectedEntryNearAnchorOnly and not selectedCloseNearAnchor
string selectedLimitWaitMode = selectedCloseFarFromAnchor ? "close_far_wait_pullback_limit" : "normal_limit"
bool selectedRsiPassed = selectedDirection == 1 ? scalpRsiLongOk : selectedDirection == -1 ? scalpRsiShortOk : false
string selectedRsiState = selectedDirection == 1 ? (scalpRsiLongOk ? "low_turning_up" : "long_rsi_not_turning") : selectedDirection == -1 ? (scalpRsiShortOk ? "high_turning_down" : "short_rsi_not_turning") : "none"
bool selectedStructureClear = selectedTrendSupport ? trendLongContext and strongTrendSupport : selectedTrendResistance ? trendShortContext and strongTrendResistance : selectedTopProbe ? strongTopProbeZone and topConfirmedShort : selectedBottomProbe ? strongBottomProbeZone and bottomConfirmedLong : false
string selectedProbePattern = selectedTopProbe ? topProbePattern : selectedBottomProbe ? bottomProbePattern : "none"
string selectedProbeFilterReason = selectedTopProbe ? topProbeFilterReason : selectedBottomProbe ? bottomProbeFilterReason : "none"
int selectedConfluenceCount = selectedTrendSupport ? trendSupportCount : selectedTrendResistance ? trendResistanceCount : selectedTopProbe ? topCount : selectedBottomProbe ? bottomCount : 0
string selectedConfluenceSources = selectedTrendSupport ? trendSupportSources : selectedTrendResistance ? trendResistanceSources : selectedTopProbe ? topSources : selectedBottomProbe ? bottomSources : "none"
int selectedPriceConfluenceCount = selectedConfluenceCount
string selectedPriceConfluenceSources = selectedConfluenceSources
bool selectedStrongStructureZone = selectedTrendSupport ? trendLongContext and strongTrendSupport : selectedTrendResistance ? trendShortContext and strongTrendResistance : selectedTopProbe ? strongTopProbeZone : selectedBottomProbe ? strongBottomProbeZone : false
bool selectedConfirmStructureSignal = selectedTrendSupport ? trendLongConfirmNow : selectedTrendResistance ? trendShortConfirmNow : selectedTopProbe ? topConfirmedShort : selectedBottomProbe ? bottomConfirmedLong : false
string selectedStructureGateReason = "passed"
if selectedDirection == 0
    selectedStructureGateReason := "no_candidate"
else if not selectedStrongStructureZone
    selectedStructureGateReason := (selectedTopProbe or selectedBottomProbe) and selectedConfluenceCount < minConfluenceCount ? "confluence_count_too_low" : (selectedTrendSupport or selectedTrendResistance) ? "trend_context_missing" : "no_clear_structure"
else if not selectedConfirmStructureSignal
    selectedStructureGateReason := "confirm_signal_missing"
else if not selectedStructureClear
    selectedStructureGateReason := selectedProbeFilterReason != "passed" ? selectedProbeFilterReason : "no_clear_structure"
string selectedStructureGateFlags = selectedTopProbe ? "strongTopProbeZone=" + str.tostring(strongTopProbeZone) + " / topConfirmedShort=" + str.tostring(topConfirmedShort) : selectedBottomProbe ? "strongBottomProbeZone=" + str.tostring(strongBottomProbeZone) + " / bottomConfirmedLong=" + str.tostring(bottomConfirmedLong) : selectedTrendSupport ? "strongTrendSupport=" + str.tostring(strongTrendSupport) + " / trendLongConfirmNow=" + str.tostring(trendLongConfirmNow) : selectedTrendResistance ? "strongTrendResistance=" + str.tostring(strongTrendResistance) + " / trendShortConfirmNow=" + str.tostring(trendShortConfirmNow) : "none"
float selectedProbeAnchorAgeBars = selectedTopProbe ? topAnchorAgeBars * 1.0 : selectedBottomProbe ? bottomAnchorAgeBars * 1.0 : na
float selectedProbePullbackAtr = selectedTopProbe ? topPullbackAtr : selectedBottomProbe ? bottomPullbackAtr : na
bool selectedProbePullbackArmed = selectedTopProbe ? topPullbackArmed : selectedBottomProbe ? bottomPullbackArmed : false
float selectedProbeRetestGapBars = selectedTopProbe and not na(lowSinceStructHighBar) ? (bar_index - lowSinceStructHighBar) * 1.0 : selectedBottomProbe and not na(highSinceStructLowBar) ? (bar_index - highSinceStructLowBar) * 1.0 : na
float selectedProbeLeftLegBps = selectedTopProbe ? topLeftLegBps : selectedBottomProbe ? bottomLeftLegBps : na
float selectedProbeMiddleRatio = selectedTopProbe ? topMiddleRetraceRatio : selectedBottomProbe ? bottomMiddleRetraceRatio : na
float selectedProbeMiddleRatioLocal = selectedTopProbe ? topLocalMiddleRetraceRatio : selectedBottomProbe ? bottomLocalMiddleRetraceRatio : na
float selectedProbeMiddleRatioGlobal = selectedTopProbe ? topGlobalMiddleRetraceRatio : selectedBottomProbe ? bottomGlobalMiddleRetraceRatio : na
string selectedProbeMiddleRatioMode = not na(selectedProbeMiddleRatioLocal) ? "local" : not na(selectedProbeMiddleRatioGlobal) ? "global_fallback" : "none"
float selectedProbeRightRatio = selectedTopProbe ? topRightRetestRatio : selectedBottomProbe ? bottomRightRetestRatio : na
string selectedThreeLegReason = selectedTopProbe or selectedBottomProbe ? (na(selectedProbeMiddleRatio) ? "middle_leg_too_small" : selectedProbeMiddleRatio < minVisualMiddleRetraceRatio ? "middle_pullback_not_enough" : na(selectedProbeRightRatio) ? "right_retest_too_small" : selectedProbeRightRatio < minVisualRightRetestRatio ? "right_retest_too_small" : not na(selectedProbeRetestGapBars) and selectedProbeRetestGapBars > maxRetestAfterMiddleSwingBars ? "retest_too_slow" : "passed") : "none"
string selectedVolumeReason = selectedTopProbe ? topVolumeReason : selectedBottomProbe ? bottomVolumeReason : "none"
float selectedVolumeRatio = selectedTopProbe or selectedBottomProbe ? volumeRatio : na
float selectedClosePosition = selectedTopProbe or selectedBottomProbe ? closePosition : na
float selectedMomentumDecayRatio = selectedTopProbe ? topMomentumDecayRatio : selectedBottomProbe ? bottomMomentumDecayRatio : na
float selectedPriorLevelDistanceAtr = selectedTopProbe ? topPriorLevelDistanceAtr : selectedBottomProbe ? bottomPriorLevelDistanceAtr : na
float selectedMomentumDecayStreak = selectedTopProbe ? topDecayStreak * 1.0 : selectedBottomProbe ? bottomDecayStreak * 1.0 : na
float selectedMomentumDecayConfirmBars = selectedTopProbe or selectedBottomProbe ? exhaustionDecayConfirmBars * 1.0 : na
bool selectedAttackVolumeCooling = selectedTopProbe ? attackUpCooling : selectedBottomProbe ? attackDownCooling : selectedDirection == -1 ? attackUpCooling : selectedDirection == 1 ? attackDownCooling : false
float selectedAttackVolumeCooldownBars = selectedDirection != 0 ? attackVolumeCooldownBars * 1.0 : na
bool selectedStructureBreakAccepted = selectedTopProbe ? upperStructureBreakAccepted : selectedBottomProbe ? lowerStructureBreakAccepted : false
float selectedStructureBreakAcceptBars = selectedTopProbe or selectedBottomProbe ? structureBreakAcceptBars * 1.0 : na
string selectedExhaustionSide = selectedTopProbe ? "upper" : selectedBottomProbe ? "lower" : "none"
bool selectedExhaustionConfirmed = selectedTopProbe ? upperExhaustionConfirmedShort : selectedBottomProbe ? lowerExhaustionConfirmedLong : false
string selectedExhaustionReason = selectedTopProbe ? topExhaustionReason : selectedBottomProbe ? bottomExhaustionReason : "none"
string selectedLevelRole = selectedTrendSupport ? "trend_pullback_support" : selectedTrendResistance ? "trend_pullback_resistance" : selectedTopProbe and upperExhaustionZone ? "prior_high_second_test_exhaustion" : selectedBottomProbe and lowerExhaustionZone ? "prior_low_second_test_exhaustion" : "structure_probe"
float selectedProbeAnchorPrice = selectedTopProbe ? todayStructHigh : selectedBottomProbe ? todayStructLow : na
string trendStructDir = strongStructTrendLong ? "bull_HH_HL" : strongStructTrendShort ? "bear_LL_LH" : dominantTrendLong ? "dominant_bull" : dominantTrendShort ? "dominant_bear" : "none"
string selectedTrendStructPattern = selectedTrendSupport ? "HH_HL" : selectedTrendResistance ? "LL_LH" : "none"
string selectedTrendSources = selectedTrendSupport ? trendSupportSources : selectedTrendResistance ? trendResistanceSources : "none"
string selectedTopMainReason = "today_struct_high_probe_failed_breakout"
if topVolumeClimaxFailedBreakConfirmed
    selectedTopMainReason := "new_high_volume_climax_failed"
else if topHighVolumeDropConfirmed
    selectedTopMainReason := "naked_high_volume_reversal"
else if topImmediateReversalShort
    selectedTopMainReason := "naked_high_immediate_reversal"
else if topNoDemandBreakConfirmed
    selectedTopMainReason := "naked_high_decay_break"
else if topDistributionDropConfirmed
    selectedTopMainReason := "new_high_distribution_drop"
else if topWeakNewHighConfirmed
    selectedTopMainReason := "weak_new_high_confirmed"
else if upperExhaustionConfirmedShort
    selectedTopMainReason := "prior_high_second_test_momentum_decay"

string selectedBottomMainReason = "today_struct_low_probe_failed_breakout"
if bottomHighVolumeRiseConfirmed
    selectedBottomMainReason := "naked_low_volume_reversal"
else if bottomNoSupplyBreakConfirmed
    selectedBottomMainReason := "naked_low_decay_break"
else if bottomAccumulationRiseConfirmed
    selectedBottomMainReason := "new_low_accumulation_rise"
else if bottomWeakNewLowConfirmed
    selectedBottomMainReason := "weak_new_low_confirmed"
else if lowerExhaustionConfirmedLong
    selectedBottomMainReason := "prior_low_second_test_momentum_decay"

string selectedMainReason = "none"
if selectedTrendSupport
    selectedMainReason := "clear_bull_pullback_to_support"
else if selectedTrendResistance
    selectedMainReason := "clear_bear_rebound_to_resistance"
else if selectedTopProbe
    selectedMainReason := selectedTopMainReason
else if selectedBottomProbe
    selectedMainReason := selectedBottomMainReason
string selectedSecondaryReason = selectedTrendSupport ? trendSupportSources : selectedTrendResistance ? trendResistanceSources : selectedTopProbe ? topSources : selectedBottomProbe ? bottomSources : "none"
bool selectedNakedReversalCandidate = selectedMainReason == "naked_high_immediate_reversal" or selectedMainReason == "naked_high_volume_reversal" or selectedMainReason == "naked_high_decay_break" or selectedMainReason == "naked_low_volume_reversal" or selectedMainReason == "naked_low_decay_break"
bool selectedVolumeConfluence = selectedVolumeReason != "none" and selectedVolumeReason != "normal_volume_retest_ok"
bool selectedMiddleConfluence = not na(selectedProbeMiddleRatio) and selectedProbeMiddleRatio >= minVisualMiddleRetraceRatio
bool selectedRightConfluence = not na(selectedProbeRightRatio) and selectedProbeRightRatio >= minVisualRightRetestRatio
int selectedSignalConfluenceCount = signalConfluenceCount(selectedRsiPassed, selectedNakedReversalCandidate, selectedVolumeConfluence, selectedMiddleConfluence, selectedRightConfluence)
string selectedSignalConfluenceSources = signalConfluenceSources(selectedRsiPassed, selectedNakedReversalCandidate, selectedVolumeConfluence, selectedVolumeReason, selectedMiddleConfluence, selectedRightConfluence)

bool inEntryWindow = not useIntradayEntryWindow or not na(time(timeframe.period, entrySession))
float selectedLastSameSidePlanPrice = selectedDirection == 1 ? lastLongPlanPrice : selectedDirection == -1 ? lastShortPlanPrice : na
float selectedSameSideSignalDistanceAtr = not na(selectedLastSameSidePlanPrice) and atr > 0.0 ? math.abs(selectedEntry - selectedLastSameSidePlanPrice) / atr : na
bool selectedFailureReentry = selectedTopProbe and topFailureRepeatShort
bool selectedSameSideSignalFarEnough = selectedDirection == 0 or selectedFailureReentry or na(selectedSameSideSignalDistanceAtr) or selectedSameSideSignalDistanceAtr >= minSameSideSignalSeparationAtr
float selectedAnyPlanGapBars = na(lastAnyPlanBar) ? na : (bar_index - lastAnyPlanBar) * 1.0
float selectedAnyPlanDistanceAtr = not na(lastAnyPlanPrice) and atr > 0.0 ? math.abs(selectedEntry - lastAnyPlanPrice) / atr : na
string selectedScalpCycleState = selectedDirection == 0 ? "none" : (na(selectedAnyPlanDistanceAtr) or selectedAnyPlanDistanceAtr >= minAnyPlanDistanceAtr ? "ready" : "used_or_too_close")
string selectedScalpCycleId = selectedDirection == 0 ? "none" : str.replace_all(syminfo.ticker, " ", "_") + "_" + (selectedDirection == 1 ? "long" : "short") + "_" + str.tostring(math.round(nz(selectedStructureAnchor, selectedEntry) / syminfo.mintick))
bool selectedAnyPlanFarEnough = selectedDirection == 0 or selectedFailureReentry or na(selectedAnyPlanGapBars) or (selectedAnyPlanGapBars >= minAnyPlanGapBars and selectedAnyPlanDistanceAtr >= minAnyPlanDistanceAtr)
bool selectedDailyRiskOk = selectedDirection == 0 or (dailyTotalTrades < maxDailyTotalTrades and dailyPnlDollars > -maxDailyLossDollars and (selectedDirection == 1 ? dailyLongTrades < maxDailySameSideTrades and dailyLongLosses < maxSameSideLosses : dailyShortTrades < maxDailySameSideTrades and dailyShortLosses < maxSameSideLosses))
bool selectedPlanQualityOk = selectedStructureClear and selectedEntryNearAnchorOnly and selectedRsiPassed and selectedSmallStopGatePassed and selectedExpectedRPassed
bool selectedPlanSpacingOk = selectedSameSideSignalFarEnough and selectedAnyPlanFarEnough
bool selectedPlanValid = selectedDirection != 0 and selectedPlanQualityOk and selectedPlanSpacingOk and selectedDailyRiskOk and selectedQty >= 1.0 and inEntryWindow
string selectedExpectedRBlockReason = not selectedEmaTargetInProfit or selectedEmaProfitAtr < minEmaProfitAtr ? "ema_tp_too_close" : "expected_r_too_small"
string selectedBlockReason = "passed"
if selectedDirection == 0
    selectedBlockReason := "no_candidate"
else if not selectedStructureClear
    selectedBlockReason := "no_clear_structure"
else if not selectedEntryNearAnchorOnly
    selectedBlockReason := "entry_too_far_from_anchor"
else if not selectedRsiPassed
    selectedBlockReason := "rsi_not_turning"
else if not selectedSameSideSignalFarEnough
    selectedBlockReason := "micro_structure_too_close"
else if not selectedAnyPlanFarEnough
    selectedBlockReason := "any_plan_too_close"
else if not selectedDailyRiskOk
    selectedBlockReason := "daily_risk_cap_hit"
else if not selectedSmallStopGatePassed
    selectedBlockReason := selectedSmallStopGateReason
else if not selectedExpectedRPassed
    selectedBlockReason := selectedExpectedRBlockReason

selectedPlanDetail(string decisionRef, int currentFlowId) =>
    string result = "F" + str.tostring(currentFlowId) + " ②" + intentName(selectedEntryIntent) + " " + dirName(selectedDirection)
    result := result + "\n关联流: " + decisionRef + " -> F" + str.tostring(currentFlowId)
    result := result + "\n" + setupDisplayName(selectedSetup)
    result := result + "\n主因: " + selectedMainReason
    result := result + "\n次因: " + (selectedSecondaryReason == "" ? "none" : selectedSecondaryReason)
    result := result + "\n结构锚点 " + fmt(selectedStructureAnchor) + " / expected " + fmt(selectedExpectedR) + "R / EMA空间 " + fmt(selectedEmaProfitAtr) + "ATR"
    result := result + "\n距结构 entry/close " + fmt(selectedEntryAnchorDistanceAtr) + "/" + fmt(selectedCurrentAnchorDistanceAtr) + "ATR / " + selectedLimitWaitMode
    if selectedCloseFarFromAnchor
        result := result + "\nclose已走远：只挂回抽限价，不追价"
    result := result + "\nRSI " + fmt(scalpRsi) + " / smooth " + fmt(scalpRsiSmooth) + " / " + selectedRsiState
    result := result + "\n价格共振: " + str.tostring(selectedPriceConfluenceCount) + "/" + str.tostring(minConfluenceCount) + " / " + (selectedPriceConfluenceSources == "" ? "none" : selectedPriceConfluenceSources)
    result := result + "\n信号共振: " + str.tostring(selectedSignalConfluenceCount) + " / " + (selectedSignalConfluenceSources == "" ? "none" : selectedSignalConfluenceSources)
    result := result + "\n结构区 " + fmt(selectedZoneLow) + " - " + fmt(selectedZoneHigh)
    result := result + "\n三段结构 L" + fmt(selectedProbeLeftLegBps) + "bps / M" + fmt(selectedProbeMiddleRatio) + " / R" + fmt(selectedProbeRightRatio) + " / 回测 " + fmt(selectedProbeRetestGapBars) + "/" + str.tostring(maxRetestAfterMiddleSwingBars) + " bars"
    result := result + "\nM local/global " + fmt(selectedProbeMiddleRatioLocal) + "/" + fmt(selectedProbeMiddleRatioGlobal) + " / used " + selectedProbeMiddleRatioMode
    result := result + "\n大回落已成立 " + str.tostring(selectedProbePullbackArmed) + " / 回落 " + fmt(selectedProbePullbackAtr) + "ATR / min " + fmt(minMiddleSwingAtr)
    result := result + "\n量能 vol/MA " + fmt(selectedVolumeRatio) + " / closePos " + fmt(selectedClosePosition) + " / " + selectedVolumeReason
    result := result + "\n成交量判断: " + volumeJudge
    result := result + "\n位置角色 " + selectedLevelRole + " / trend " + trendRegime
    result := result + "\n日内高低 " + (dayRangeFormed ? "formed" : "waiting") + " / " + fmt(dayRangeAtr) + "ATR"
    result := result + "\n衰竭 " + selectedExhaustionSide + " / " + selectedExhaustionReason + " / MDecay " + fmt(selectedMomentumDecayRatio) + " / 连续 " + fmt(selectedMomentumDecayStreak) + "/" + fmt(selectedMomentumDecayConfirmBars)
    result := result + "\n量能攻击状态 " + str.tostring(selectedAttackVolumeCooling) + " / 不拦截"
    result := result + "\n同向距离 " + fmt(selectedSameSideSignalDistanceAtr) + "ATR / min " + fmt(minSameSideSignalSeparationAtr)
    result := result + "\nplan " + fmt(selectedEntry) + " / qty " + qtyText(selectedQty)
    result := result + "\n红SL " + fmt(selectedStop) + " " + moneyText(pnlDollars(selectedEntry, selectedStop, selectedDirection, selectedQty))
    result := result + "\n蓝0.6R " + fmt(selectedRunnerActivation) + " " + moneyText(pnlDollars(selectedEntry, selectedRunnerActivation, selectedDirection, selectedQty))
    result := result + "\n绿EMA20 TP " + fmt(selectedTarget) + " " + moneyText(pnlDollars(selectedEntry, selectedTarget, selectedDirection, selectedQty))
    result := result + "\n小止损: " + selectedSmallStopGateReason + " / " + fmt(selectedStopDistanceAtr) + "ATR / " + fmt(selectedStopDistanceBps) + "bps"
    result := result + "\nprobe: " + selectedProbePattern + " / filter " + selectedProbeFilterReason
    result := result + "\n风险模式: " + selectedTrialRiskMode + " $" + fmt(selectedRiskBudget) + " / TTL " + str.tostring(entryOrderTtlBars)
    result

blockedCandidateDetail(string blockPrefix, string displayBlockReason) =>
    string result = blockPrefix + "确认但过滤 " + dirName(selectedDirection)
    result := result + "\n主因: " + selectedMainReason
    result := result + "\n次因: " + (selectedSecondaryReason == "" ? "none" : selectedSecondaryReason)
    result := result + "\n原因: " + reasonCn(displayBlockReason) + " / " + displayBlockReason
    result := result + "\n结构清晰: " + str.tostring(selectedStructureClear) + " / 门槛: " + reasonCn(selectedStructureGateReason) + " / " + selectedStructureGateReason
    result := result + "\n强结构条件: " + selectedStructureGateFlags
    result := result + "\n共振计数: " + str.tostring(selectedConfluenceCount) + "/" + str.tostring(minConfluenceCount) + " / 来源: " + (selectedConfluenceSources == "" ? "none" : selectedConfluenceSources)
    result := result + "\n价格共振: " + str.tostring(selectedPriceConfluenceCount) + "/" + str.tostring(minConfluenceCount) + " / " + (selectedPriceConfluenceSources == "" ? "none" : selectedPriceConfluenceSources)
    result := result + "\n信号共振: " + str.tostring(selectedSignalConfluenceCount) + " / " + (selectedSignalConfluenceSources == "" ? "none" : selectedSignalConfluenceSources)
    result := result + "\n结构 " + fmt(selectedStructureAnchor) + " / expected " + fmt(selectedExpectedR) + "R / EMA空间 " + fmt(selectedEmaProfitAtr) + "ATR"
    result := result + "\nRSI " + fmt(scalpRsi) + " / smooth " + fmt(scalpRsiSmooth) + " / " + selectedRsiState
    result := result + "\n距结构 entry/close " + fmt(selectedEntryAnchorDistanceAtr) + "/" + fmt(selectedCurrentAnchorDistanceAtr) + "ATR / " + selectedLimitWaitMode
    if selectedCloseFarFromAnchor
        result := result + "\nclose已走远：只挂回抽限价，不追价"
    result := result + "\n同向距离 " + fmt(selectedSameSideSignalDistanceAtr) + "ATR / min " + fmt(minSameSideSignalSeparationAtr)
    result := result + "\n结构区 " + fmt(selectedZoneLow) + " - " + fmt(selectedZoneHigh)
    result := result + "\n三段结构 L" + fmt(selectedProbeLeftLegBps) + "bps / M" + fmt(selectedProbeMiddleRatio) + " / R" + fmt(selectedProbeRightRatio) + " / 回测 " + fmt(selectedProbeRetestGapBars) + "/" + str.tostring(maxRetestAfterMiddleSwingBars) + " bars"
    result := result + "\n三段阈值: M " + fmt(selectedProbeMiddleRatio) + "/" + fmt(minVisualMiddleRetraceRatio) + " / R " + fmt(selectedProbeRightRatio) + "/" + fmt(minVisualRightRetestRatio) + " / " + selectedThreeLegReason
    result := result + "\nM local/global " + fmt(selectedProbeMiddleRatioLocal) + "/" + fmt(selectedProbeMiddleRatioGlobal) + " / used " + selectedProbeMiddleRatioMode
    result := result + "\n大回落已成立 " + str.tostring(selectedProbePullbackArmed) + " / 回落 " + fmt(selectedProbePullbackAtr) + "ATR / min " + fmt(minMiddleSwingAtr)
    result := result + "\n量能 vol/MA " + fmt(selectedVolumeRatio) + " / closePos " + fmt(selectedClosePosition) + " / " + selectedVolumeReason
    result := result + "\n成交量判断: " + volumeJudge
    result := result + "\n位置角色 " + selectedLevelRole + " / trend " + trendRegime
    result := result + "\n日内高低 " + (dayRangeFormed ? "formed" : "waiting") + " / " + fmt(dayRangeAtr) + "ATR"
    result := result + "\n衰竭 " + selectedExhaustionSide + " / " + selectedExhaustionReason + " / MDecay " + fmt(selectedMomentumDecayRatio) + " / 连续 " + fmt(selectedMomentumDecayStreak) + "/" + fmt(selectedMomentumDecayConfirmBars)
    result := result + "\n量能攻击状态 " + str.tostring(selectedAttackVolumeCooling) + " / 不拦截"
    result := result + "\n距离 " + fmt(selectedStopDistanceAtr) + "ATR / " + fmt(selectedStopDistanceBps) + "bps"
    if displayBlockReason == "no_clear_structure" and selectedNakedReversalCandidate
        result := result + "\n说明: 裸K反转已触发候选，但强结构门槛未通过，所以不挂单"
    result


// -----------------------------------------------------------------------------
// Visual lifecycle shadow.
// -----------------------------------------------------------------------------
var bool shadowPending = false
var bool shadowOpen = false
var int shadowDirection = 0
var string shadowSetup = ""
var string shadowIntent = ""
var string shadowTrialRiskMode = ""
var float shadowEntry = na
var float shadowStop = na
var float shadowTarget = na
var float shadowRunner = na
var float shadowQty = na
var int shadowSignalBar = na
var int shadowExpiresBar = na
var int shadowEntryBar = na
var float shadowInitialRisk = na
var bool shadowRunnerActive = false
var float shadowRunnerExtreme = na
var float shadowMfeR = 0.0
var int flowId = 0
var line currentEntryLine = na
var line currentStopLine = na
var line currentRunnerLine = na
var line currentTargetLine = na

newPlanNow = confirmed and showSignalEventFlow and selectedPlanValid and not shadowPending and not shadowOpen
if newPlanNow
    if selectedTopProbe and activeTopDecisionSeq == 0
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if selectedBottomProbe and activeBottomDecisionSeq == 0
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    flowId += 1
    string decisionRef = selectedTopProbe ? "T" + str.tostring(activeTopDecisionSeq) : selectedBottomProbe ? "B" + str.tostring(activeBottomDecisionSeq) : "--"
    shadowPending := true
    shadowOpen := false
    shadowDirection := selectedDirection
    shadowSetup := selectedSetup
    shadowIntent := selectedEntryIntent
    shadowTrialRiskMode := selectedTrialRiskMode
    shadowEntry := selectedEntry
    shadowStop := selectedStop
    shadowTarget := selectedTarget
    shadowRunner := selectedRunnerActivation
    shadowQty := selectedQty
    shadowSignalBar := bar_index
    shadowExpiresBar := bar_index + entryOrderTtlBars
    shadowEntryBar := na
    shadowInitialRisk := riskPerShare(selectedEntry, selectedStop)
    shadowRunnerActive := false
    shadowRunnerExtreme := na
    shadowMfeR := 0.0
    if selectedTopProbe
        topExhaustionUsed := selectedProbePattern == "extension_exhaustion_top" ? true : topExhaustionUsed
    if selectedBottomProbe
        bottomExhaustionUsed := selectedProbePattern == "extension_exhaustion_bottom" ? true : bottomExhaustionUsed
    string detail = selectedPlanDetail(decisionRef, flowId)
    string compact = "F" + str.tostring(flowId) + " " + dirName(selectedDirection) + " plan " + fmt(selectedEntry)
    if flowLabelsVisible
        string planVisualState = selectedEntryIntent == "predictive_limit" ? "predictive" : "confirmed"
        drawFlowLabel(selectedDirection, planVisualState, planVisualState, planVisualState, 1.5, compact, detail)
    if eventMarkersVisible
        eventMarker(selectedDirection, selectedCloseFarFromAnchor ? "entry_far_limit_wait" : "confirmed", " ", detail, 0.42)
    int lineEnd = bar_index + entryOrderTtlBars
    currentEntryLine := line.new(bar_index, shadowEntry, lineEnd, shadowEntry, color=color.new(color.yellow, 0), width=2)
    currentStopLine := line.new(bar_index, shadowStop, lineEnd, shadowStop, color=color.new(color.red, 0), width=2)
    currentRunnerLine := line.new(bar_index, shadowRunner, lineEnd, shadowRunner, color=color.new(color.blue, 0), width=2)
    currentTargetLine := line.new(bar_index, shadowTarget, lineEnd, shadowTarget, color=color.new(color.green, 0), width=2)

if showHistoricalPlanLines and (shadowPending or shadowOpen) and not na(shadowSignalBar)
    int lineEnd = math.max(bar_index, shadowSignalBar + 1)
    if not na(currentEntryLine)
        line.set_x2(currentEntryLine, lineEnd)
    if not na(currentStopLine)
        line.set_x2(currentStopLine, lineEnd)
        line.set_y2(currentStopLine, shadowStop)
    if not na(currentRunnerLine)
        line.set_x2(currentRunnerLine, lineEnd)
    if not na(currentTargetLine)
        line.set_x2(currentTargetLine, lineEnd)

bool pendingTouched = confirmed and shadowPending and bar_index > shadowSignalBar and (shadowDirection == 1 ? low <= shadowEntry : high >= shadowEntry)
bool pendingExpired = confirmed and shadowPending and bar_index > shadowExpiresBar
bool pendingInvalidated = confirmed and shadowPending and (shadowDirection == 1 ? close < shadowStop : close > shadowStop)
if pendingTouched
    shadowPending := false
    shadowOpen := true
    shadowEntryBar := bar_index
    shadowRunnerExtreme := shadowDirection == 1 ? high : low
    if shadowSetup == "probe_2b_top_short"
        lastTopProbeSignalBar := bar_index
        lastTopProbeSignalPrice := shadowEntry
    if shadowSetup == "probe_2b_bottom_long"
        lastBottomProbeSignalBar := bar_index
        lastBottomProbeSignalPrice := shadowEntry
    if shadowDirection == 1
        lastLongPlanPrice := shadowEntry
    if shadowDirection == -1
        lastShortPlanPrice := shadowEntry
    lastAnyPlanBar := bar_index
    lastAnyPlanPrice := shadowEntry
    dailyTotalTrades += 1
    if shadowDirection == 1
        dailyLongTrades += 1
    if shadowDirection == -1
        dailyShortTrades += 1
    string detail = "F" + str.tostring(flowId) + " ④触及 " + dirName(shadowDirection) + "\nplan " + fmt(shadowEntry) + " 已触及\nDisplay shadow，不代表 TV strategy 已成交；真实成交看 Core Strategy Tester / Core entry_fill / 券商订单"
    string compact = "F" + str.tostring(flowId) + " 触及 " + fmt(shadowEntry)
    if flowLabelsVisible
        drawFlowLabel(shadowDirection, "confirmed", "confirmed", "confirmed", 1.8, compact, detail)
if pendingExpired or pendingInvalidated
    string reason = pendingInvalidated ? "结构失效/打穿止损" : "挂单TTL过期"
    string detail = "F" + str.tostring(flowId) + " ④撤销 " + dirName(shadowDirection) + "\n原因: " + reason + "\nplan " + fmt(shadowEntry) + " / SL " + fmt(shadowStop) + "\n信号bar " + str.tostring(shadowSignalBar) + " / expires " + str.tostring(shadowExpiresBar)
    string compact = "F" + str.tostring(flowId) + " 撤销"
    if flowLabelsVisible
        drawFlowLabel(shadowDirection, "blocked", "blocked", "blocked", 1.8, compact, detail)
    shadowPending := false

bool shadowExitNow = false
string shadowExitReason = ""
float shadowExitPrice = na
if confirmed and shadowOpen
    int barsInTrade = na(shadowEntryBar) ? 0 : bar_index - shadowEntryBar
    shadowRunnerExtreme := shadowDirection == 1 ? math.max(nz(shadowRunnerExtreme, high), high) : math.min(nz(shadowRunnerExtreme, low), low)
    float mfeNow = shadowInitialRisk > 0.0 ? (shadowDirection == 1 ? (high - shadowEntry) / shadowInitialRisk : (shadowEntry - low) / shadowInitialRisk) : 0.0
    shadowMfeR := math.max(nz(shadowMfeR, 0.0), mfeNow)
    bool runnerReached = shadowDirection == 1 ? high >= shadowRunner : low <= shadowRunner
    if not shadowRunnerActive and runnerReached
        shadowRunnerActive := true
        float beStop = shadowEntry + shadowInitialRisk * breakevenOffsetR * shadowDirection
        shadowStop := shadowDirection == 1 ? math.max(shadowStop, beStop) : math.min(shadowStop, beStop)
        string detail = "F" + str.tostring(flowId) + " ⑤保本/Runner\n到达蓝线 " + fmt(shadowRunner) + "\nSL -> " + fmt(shadowStop)
        string compact = "F" + str.tostring(flowId) + " RUN"
        if flowLabelsVisible
            drawProfitLabel(shadowDirection, "runner", 1.4, compact, detail, color.new(color.blue, flowLabelTransparency))
    if shadowRunnerActive
        float rawTrailStop = shadowDirection == 1 ? shadowRunnerExtreme - atr * runnerTrailAtrMult : shadowRunnerExtreme + atr * runnerTrailAtrMult
        float structureTrailStop = floatingStructureStop(shadowDirection, shadowStop, lastPivotLow, lastPivotHigh, close, invalidationBuffer)
        float trailStop = looserStop(rawTrailStop, structureTrailStop, shadowDirection)
        shadowStop := shadowDirection == 1 ? math.max(shadowStop, trailStop) : math.min(shadowStop, trailStop)
    bool shadowNoFollowExit = not shadowRunnerActive and barsInTrade >= scalpNoFollowBars and shadowMfeR < noFollowThroughMinMfeR
    if not shadowNoFollowExit and not shadowRunnerActive and barsInTrade >= noFollowThroughBars and shadowMfeR < noFollowThroughMinMfeR
        float structureCompressStop = floatingStructureStop(shadowDirection, shadowStop, lastPivotLow, lastPivotHigh, close, invalidationBuffer)
        if not na(structureCompressStop)
            float rawCompressedStop = shadowEntry - shadowInitialRisk * noFollowThroughCompressedStopR * shadowDirection
            float compressedStop = looserStop(rawCompressedStop, structureCompressStop, shadowDirection)
            shadowStop := shadowDirection == 1 ? math.max(shadowStop, compressedStop) : math.min(shadowStop, compressedStop)
    bool shadowExhaustProtect = shadowMfeR >= exhaustionProtectMinMfeR and (shadowDirection == 1 ? upperExhaustionZone : lowerExhaustionZone)
    bool shadowExhaustExit = shadowMfeR >= exhaustionProtectMinMfeR and (shadowDirection == 1 ? upperExhaustionConfirmedShort : lowerExhaustionConfirmedLong)
    if shadowExhaustProtect and not shadowExhaustExit
        float protectStop = shadowDirection == 1 ? close - atr * exhaustionProtectTrailAtr : close + atr * exhaustionProtectTrailAtr
        shadowStop := shadowDirection == 1 ? math.max(shadowStop, protectStop) : math.min(shadowStop, protectStop)
        float protectTarget = shadowDirection == 1 ? math.max(close, nz(topZoneHigh, close)) : math.min(close, nz(bottomZoneLow, close))
        bool targetTightened = shadowDirection == 1 ? protectTarget > shadowEntry and protectTarget < shadowTarget : protectTarget < shadowEntry and protectTarget > shadowTarget
        shadowTarget := targetTightened ? protectTarget : shadowTarget
        string detail = "F" + str.tostring(flowId) + " ⑤衰竭保护 " + dirName(shadowDirection) + "\n" + (shadowDirection == 1 ? "前高二测，保护多单利润" : "前低二测，保护空单利润") + "\nSL -> " + fmt(shadowStop) + " / TP -> " + fmt(shadowTarget)
        string compact = "F" + str.tostring(flowId) + " 保护"
        if flowLabelsVisible
            drawProfitLabel(shadowDirection, "runner", 1.4, compact, detail, color.new(color.orange, flowLabelTransparency))
    bool stopHit = shadowDirection == 1 ? low <= shadowStop : high >= shadowStop
    bool targetHit = shadowDirection == 1 ? high >= shadowTarget : low <= shadowTarget
    shadowExitNow := shadowNoFollowExit or shadowExhaustExit or stopHit or targetHit
    shadowExitReason := shadowNoFollowExit ? "无跟随快出" : shadowExhaustExit ? "衰竭止盈" : stopHit and shadowRunnerActive ? "跟踪止盈" : stopHit ? "小止损" : targetHit ? "EMA快线TP" : ""
    shadowExitPrice := shadowNoFollowExit ? close : shadowExhaustExit ? close : stopHit ? shadowStop : targetHit ? shadowTarget : na
if shadowExitNow
    float pnl = (shadowExitPrice - shadowEntry) * shadowDirection * shadowQty
    dailyPnlDollars += pnl
    if pnl < 0.0
        if shadowDirection == 1
            dailyLongLosses += 1
        if shadowDirection == -1
            dailyShortLosses += 1
    float pnlR = shadowInitialRisk > 0.0 ? (shadowExitPrice - shadowEntry) * shadowDirection / shadowInitialRisk : na
    string detail = "F" + str.tostring(flowId) + " ⑤退出 " + dirName(shadowDirection) + "\n原因: " + shadowExitReason + "\n价格 " + fmt(shadowExitPrice) + "\nPnL $" + fmt(pnl) + " / " + fmt(pnlR) + "R"
    string compact = "F" + str.tostring(flowId) + " EXIT $" + fmt(pnl)
    if flowLabelsVisible
        drawProfitLabel(shadowDirection, "exit", 1.8, compact, detail, flowColor("exit", shadowDirection))
    shadowOpen := false

bool structureBreakAcceptedEvent = confirmed and showDiagnosticEventFlow and (upperStructureBreakAccepted or lowerStructureBreakAccepted)
if structureBreakAcceptedEvent
    int acceptedDirection = upperStructureBreakAccepted ? -1 : 1
    string acceptedDetail = upperStructureBreakAccepted ? "站稳前高：更新今日结构高" : "跌破站稳：更新今日结构低"
    acceptedDetail := acceptedDetail + "\n旧结构不再当作反向入场位"
    acceptedDetail := acceptedDetail + "\n确认 " + str.tostring(structureBreakAcceptBars) + " bars / close阈值 " + fmt(structureBreakAcceptCloseAtr) + "ATR"
    acceptedDetail := acceptedDetail + "\n后续等待重新回落，再二次测试并连续动能衰减"
    string acceptedCompact = (upperStructureBreakAccepted ? "前高站稳" : "前低跌破") + "\n结构已更新"
    if eventMarkersVisible
        eventMarker(acceptedDirection, "structure", " ", acceptedDetail, 0.28)
    if diagnosticLabelsVisible
        drawFlowLabel(acceptedDirection, "structure", "blocked", "blocked", 1.2, acceptedCompact, acceptedDetail)

bool structureBreakExtendedEvent = confirmed and showDiagnosticEventFlow and (upperStructureBreakExtended or lowerStructureBreakExtended)
if structureBreakExtendedEvent
    int extendedDirection = upperStructureBreakExtended ? -1 : 1
    string extendedDetail = upperStructureBreakExtended ? "前高延伸：结构高跟随最新日内高点" : "前低延伸：结构低跟随最新日内低点"
    extendedDetail := extendedDetail + "\n这是趋势延续后的锚点刷新，不是反向挂单"
    extendedDetail := extendedDetail + "\n后续仍要等回落/反弹形成中段，再二次测试并动能衰减"
    string extendedCompact = upperStructureBreakExtended ? "前高延伸\n结构跟随新高" : "前低延伸\n结构跟随新低"
    if eventMarkersVisible
        eventMarker(extendedDirection, "structure", " ", extendedDetail, 0.28)
    if diagnosticLabelsVisible
        drawFlowLabel(extendedDirection, "structure", "blocked", "blocked", 1.2, extendedCompact, extendedDetail)

bool liveHighStateEvent = confirmed and showDiagnosticEventFlow and not upperStructureBreakAccepted and not upperStructureBreakExtended and structureHighRaised
bool liveLowStateEvent = confirmed and showDiagnosticEventFlow and not lowerStructureBreakAccepted and not lowerStructureBreakExtended and structureLowRaised
bool candidateHighWaitEvent = confirmed and showDiagnosticEventFlow and intradayHighUpdated and not structureHighRaised and not na(todayStructHigh) and todayHigh > todayStructHigh + tickBuffer
bool candidateLowWaitEvent = confirmed and showDiagnosticEventFlow and intradayLowUpdated and not structureLowRaised and not na(todayStructLow) and todayLow < todayStructLow - tickBuffer
if liveHighStateEvent or liveLowStateEvent or candidateHighWaitEvent or candidateLowWaitEvent
    bool highSideEvent = liveHighStateEvent or candidateHighWaitEvent
    int liveDirection = highSideEvent ? -1 : 1
    bool raisedEvent = liveHighStateEvent or liveLowStateEvent
    bool independentEvent = highSideEvent ? structureHighIndependent : structureLowIndependent
    float oldStructureValue = highSideEvent ? structureHighOld : structureLowOld
    float currentStructureValue = highSideEvent ? todayStructHigh : todayStructLow
    float currentExtremeValue = highSideEvent ? todayHigh : todayLow
    int sourceBar = highSideEvent ? (raisedEvent ? todayStructHighBar : todayHighBar) : (raisedEvent ? todayStructLowBar : todayLowBar)
    bool firstStructure = raisedEvent and na(oldStructureValue)
    bool sourceIsCurrentBar = not na(sourceBar) and sourceBar == bar_index
    float sourceAgeBars = not na(sourceBar) ? (bar_index - sourceBar) * 1.0 : na
    string stateTitle = raisedEvent ? (firstStructure ? (highSideEvent ? "结构高首次确认" : "结构低首次确认") : sourceIsCurrentBar ? (highSideEvent ? "结构高抬高" : "结构低下移") : (highSideEvent ? "前高确认为结构高" : "前低确认为结构低")) : (highSideEvent ? "候选结构高" : "候选结构低")
    string clusterText = raisedEvent ? (firstStructure ? "reference session 首次结构" : independentEvent ? (highSideEvent ? "结构高刷新：独立新结构" : "结构低刷新：独立新结构") : (highSideEvent ? "同一结构簇新高" : "同一结构簇新低")) : (highSideEvent ? "等待回落确认" : "等待反弹确认")
    string triggerReason = raisedEvent ? (sourceIsCurrentBar ? "当前K刷新结构" : (highSideEvent ? "前高回落确认" : "前低反弹确认")) : (highSideEvent ? "当前K候选新高，等待回落确认" : "当前K候选新低，等待反弹确认")
    string oldStructureText = na(oldStructureValue) ? "无" : fmt(oldStructureValue)
    string transitionText = raisedEvent ? "旧结构 " + oldStructureText + " -> 新结构 " + fmt(currentStructureValue) : "现结构 " + fmt(currentStructureValue) + " / 候选极值 " + fmt(currentExtremeValue)
    string liveDetail = stateTitle
    liveDetail := liveDetail + "\n" + clusterText
    liveDetail := liveDetail + "\n" + transitionText
    liveDetail := liveDetail + "\n盘中极值 " + fmt(currentExtremeValue)
    liveDetail := liveDetail + "\n触发原因: " + triggerReason
    liveDetail := liveDetail + "\n结构来源: " + fmt(sourceAgeBars) + " bars 前"
    liveDetail := liveDetail + "\n当前K是否" + (highSideEvent ? "新高" : "新低") + ": " + str.tostring(sourceIsCurrentBar)
    liveDetail := liveDetail + "\n独立结构: " + str.tostring(independentEvent)
    liveDetail := liveDetail + "\n冻结突破基准 " + fmt(highSideEvent ? breakoutHighZoneHigh : breakoutLowZoneLow)
    liveDetail := liveDetail + "\n说明: 这是结构锚点更新，不是开仓信号"
    liveDetail := liveDetail + "\n补充: 同一结构簇也会更新可交易锚点，SL/前高前低跟随最新极值"
    string liveCompact = raisedEvent ? stateTitle + "\n" + clusterText : (highSideEvent ? "候选结构高\n等待回落确认" : "候选结构低\n等待反弹确认")
    if eventMarkersVisible
        eventMarker(liveDirection, "structure", " ", liveDetail, 0.24)
    if diagnosticLabelsVisible
        drawFlowLabel(liveDirection, "structure", "blocked", "blocked", 1.05, liveCompact, liveDetail)

bool blockedCandidate = confirmed and showDiagnosticEventFlow and selectedDirection != 0 and (selectedBlockReason != "passed" or not inEntryWindow)
if blockedCandidate
    if selectedTopProbe and activeTopDecisionSeq == 0
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if selectedBottomProbe and activeBottomDecisionSeq == 0
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    string blockKey = selectedTopProbe ? "T" + str.tostring(activeTopDecisionSeq) : selectedBottomProbe ? "B" + str.tostring(activeBottomDecisionSeq) : ""
    string blockPrefix = blockKey == "" ? "" : blockKey + " ④"
    string displayBlockReason = not inEntryWindow ? "outside_entry_session" : selectedBlockReason
    string detail = blockedCandidateDetail(blockPrefix, displayBlockReason)
    string compact = blockPrefix + "确认但过滤 " + dirName(selectedDirection) + "\n" + reasonCn(displayBlockReason)
    bool weakStructureReversal = displayBlockReason == "no_clear_structure" and selectedNakedReversalCandidate and selectedRsiPassed
    bool trendBlocked = selectedProbeFilterReason == "blocked_by_dominant_bull_trend" or selectedProbeFilterReason == "blocked_by_dominant_bear_trend" or selectedStructureGateReason == "trend_context_missing"
    string blockedMarkerKind = weakStructureReversal ? "weak_structure_reversal" : trendBlocked ? "trend_blocked" : "blocked"
    if eventMarkersVisible
        eventMarker(selectedDirection, blockedMarkerKind, " ", detail, 0.34)
    if diagnosticLabelsVisible
        drawFlowLabel(selectedDirection, blockedMarkerKind, blockedMarkerKind, "blocked", 1.2, compact, detail)

bool pullbackArmedFlowEvent = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and (topPullbackArmedEvent or bottomPullbackArmedEvent)
if pullbackArmedFlowEvent
    int armedDirection = topPullbackArmedEvent ? -1 : 1
    if topPullbackArmedEvent
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if bottomPullbackArmedEvent
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    string armedKey = armedDirection == -1 ? "T" + str.tostring(activeTopDecisionSeq) : "B" + str.tostring(activeBottomDecisionSeq)
    string armedDetail = armedKey + (armedDirection == -1 ? " ①冲高后大回落已成立 空" : " ①下探后大反弹已成立 多")
    armedDetail := armedDetail + "\n不挂单，等待接近/触达/突破结构位"
    armedDetail := armedDetail + "\n主因: pullback_armed"
    armedDetail := armedDetail + "\n次因: 回落/反弹达到最小幅度，后续裸K失败才确认"
    armedDetail := armedDetail + "\n回落 " + fmt(armedDirection == -1 ? topPullbackAtr : bottomPullbackAtr) + "ATR / min " + fmt(minMiddleSwingAtr)
    armedDetail := armedDetail + "\n比例 " + fmt(armedDirection == -1 ? topMiddleRetraceRatio : bottomMiddleRetraceRatio) + " / min " + fmt(minVisualMiddleRetraceRatio)
    string armedCompact = armedKey + (armedDirection == -1 ? " ①大回落成立 空" : " ①大反弹成立 多") + "\n等回结构位"
    if eventMarkersVisible
        eventMarker(armedDirection, "armed", " ", armedDetail, 0.24)
    if diagnosticLabelsVisible
        drawFlowLabel(armedDirection, "armed", "armed", "blocked", 1.1, armedCompact, armedDetail)

bool volumeClimaxTopWatchEvent = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and topVolumeClimaxAttackEvent
if volumeClimaxTopWatchEvent
    topDecisionSeq += 1
    activeTopDecisionSeq := topDecisionSeq
    string topKey = "T" + str.tostring(activeTopDecisionSeq)
    string climaxWatchDetail = topKey + " ①裸K放量上攻观察 空"
    climaxWatchDetail := climaxWatchDetail + "\n不挂单，等放量失败或衰弱破位"
    climaxWatchDetail := climaxWatchDetail + "\n主因: naked_high_volume_watch"
    climaxWatchDetail := climaxWatchDetail + "\n次因: 高位放量K是攻击锚点，不再用冷却期拦截"
    climaxWatchDetail := climaxWatchDetail + "\n成交量判断: " + volumeJudge
    climaxWatchDetail := climaxWatchDetail + "\nbase " + fmt(lastTopVolumeClimaxBase)
    climaxWatchDetail := climaxWatchDetail + "\nattack H/L " + fmt(lastTopVolumeClimaxHigh) + " / " + fmt(lastTopVolumeClimaxLow)
    climaxWatchDetail := climaxWatchDetail + "\nvol/MA " + fmt(lastTopVolumeClimaxVolumeRatio)
    climaxWatchDetail := climaxWatchDetail + "\n确认窗口 " + str.tostring(failedBreakConfirmBars) + " bars"
    string climaxWatchCompact = topKey + " ①裸K放量上攻观察 空\n等失败确认"
    if eventMarkersVisible
        eventMarker(-1, "watch", " ", climaxWatchDetail, 0.28)
    if diagnosticLabelsVisible
        drawFlowLabel(-1, "watch", "blocked", "blocked", 1.25, climaxWatchCompact, climaxWatchDetail)

bool volumeClimaxTopConfirmRaw = confirmed and showDiagnosticEventFlow and topVolumeClimaxFailedBreakConfirmed
bool volumeClimaxTopConfirmEvent = volumeClimaxTopConfirmRaw and not volumeClimaxTopConfirmRaw[1]
if volumeClimaxTopConfirmEvent
    if activeTopDecisionSeq == 0
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    string topKey = "T" + str.tostring(activeTopDecisionSeq)
    string climaxFailKind = topVolumeClimaxCloseBack ? "红K收回前高" : "红K跌破攻击K低点"
    string rawClimaxFilterReason = "main_flow_filter"
    if topConfirmAllowed
        rawClimaxFilterReason := "passed"
    else if not topSignalGapOk
        rawClimaxFilterReason := "micro_structure_too_close"
    else if not smallStopTrialAllowed(topConfirmEntry, topConfirmStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps)
        rawClimaxFilterReason := smallStopGateReason(topConfirmEntry, topConfirmStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps)
    else if topConfirmQty < 1.0
        rawClimaxFilterReason := "qty_too_small"
    string climaxFilterReason = topConfirmAllowed ? "可挂单" : "确认但过滤\n过滤原因: " + reasonCn(rawClimaxFilterReason) + " / " + rawClimaxFilterReason
    string climaxConfirmDetail = topKey + " ③放量失败确认 空\n候选确认 空"
    climaxConfirmDetail := climaxConfirmDetail + "\n" + climaxFailKind
    climaxConfirmDetail := climaxConfirmDetail + "\n" + climaxFilterReason
    climaxConfirmDetail := climaxConfirmDetail + "\nSL 前高+buffer " + fmt(topConfirmStop)
    climaxConfirmDetail := climaxConfirmDetail + "\nbase " + fmt(lastTopVolumeClimaxBase)
    climaxConfirmDetail := climaxConfirmDetail + "\nattack H/L " + fmt(lastTopVolumeClimaxHigh) + " / " + fmt(lastTopVolumeClimaxLow)
    climaxConfirmDetail := climaxConfirmDetail + "\n等待 " + fmt(barsSinceTopVolumeClimax) + "/" + str.tostring(failedBreakConfirmBars) + " bars"
    climaxConfirmDetail := climaxConfirmDetail + "\n成交量判断: " + volumeJudge
    climaxConfirmDetail := climaxConfirmDetail + "\nvol/MA " + fmt(volumeRatio) + " / closePos " + fmt(closePosition)
    climaxConfirmDetail := climaxConfirmDetail + "\ndistance " + fmt(topVolumeClimaxDistanceAtr) + "ATR"
    string climaxConfirmCompact = topKey + " 候选确认 空\n" + (topConfirmAllowed ? "可挂单" : "确认但过滤")
    if eventMarkersVisible
        eventMarker(-1, topConfirmAllowed ? "candidate" : "blocked", " ", climaxConfirmDetail, 0.34)
    if diagnosticLabelsVisible
        drawFlowLabel(-1, topConfirmAllowed ? "candidate" : "blocked", "confirmed", "confirmed", 1.35, climaxConfirmCompact, climaxConfirmDetail)

bool nakedTouchEvent = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and (topNakedTouchEvent or bottomNakedTouchEvent)
if nakedTouchEvent
    int touchDirection = topNakedTouchEvent ? -1 : 1
    if topNakedTouchEvent and activeTopDecisionSeq == 0
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if bottomNakedTouchEvent and activeBottomDecisionSeq == 0
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    string touchKey = touchDirection == -1 ? "T" + str.tostring(activeTopDecisionSeq) : "B" + str.tostring(activeBottomDecisionSeq)
    string touchDetail = touchKey + (touchDirection == -1 ? " ①新高/前高观察 空" : " ①新低/前低观察 多")
    touchDetail := touchDetail + "\n不挂单，等待放量失败或连续衰弱破簇"
    touchDetail := touchDetail + "\n主因: " + (touchDirection == -1 ? "naked_high_watch" : "naked_low_watch")
    touchDetail := touchDetail + "\n次因: 触达结构位即进入裸K观察，不要求先放量"
    touchDetail := touchDetail + "\n成交量判断: " + volumeJudge
    touchDetail := touchDetail + "\n大回落已成立: " + str.tostring(touchDirection == -1 ? topPullbackArmed : bottomPullbackArmed) + " / 回落 " + fmt(touchDirection == -1 ? topPullbackAtr : bottomPullbackAtr) + "ATR"
    touchDetail := touchDetail + "\nbase " + fmt(touchDirection == -1 ? lastTopFailureWatchBase : lastBottomFailureWatchBase)
    touchDetail := touchDetail + "\nwatch H/L " + fmt(touchDirection == -1 ? lastTopFailureWatchHigh : lastBottomFailureWatchHigh) + " / " + fmt(touchDirection == -1 ? lastTopFailureWatchLow : lastBottomFailureWatchLow)
    touchDetail := touchDetail + "\nvol/MA " + fmt(volumeRatio) + " / closePos " + fmt(closePosition)
    string touchCompact = touchKey + (touchDirection == -1 ? " ①新高/前高观察 空" : " ①新低/前低观察 多") + "\n等确认"
    if eventMarkersVisible
        eventMarker(touchDirection, "observe", " ", touchDetail, 0.24)
    if diagnosticLabelsVisible
        drawFlowLabel(touchDirection, "observe", "blocked", "blocked", 1.15, touchCompact, touchDetail)

bool nakedVolumeProbeEvent = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and (topHighVolumeProbeWatch or bottomHighVolumeProbeWatch) and not volumeClimaxTopWatchEvent
if nakedVolumeProbeEvent
    int attackDirection = topHighVolumeProbeWatch ? -1 : 1
    if topHighVolumeProbeWatch and activeTopDecisionSeq == 0
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if bottomHighVolumeProbeWatch and activeBottomDecisionSeq == 0
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    string attackKey = attackDirection == -1 ? "T" + str.tostring(activeTopDecisionSeq) : "B" + str.tostring(activeBottomDecisionSeq)
    string attackDetail = attackKey + (attackDirection == -1 ? " ②放量失败观察 空" : " ②放量失败观察 多")
    attackDetail := attackDetail + "\n不挂单，等反向K收回实体中位或破观察位"
    attackDetail := attackDetail + "\n主因: " + (attackDirection == -1 ? "naked_high_volume_watch" : "naked_low_volume_watch")
    attackDetail := attackDetail + "\n次因: 放量K只作为攻击锚点，不触发冷却拦截"
    attackDetail := attackDetail + "\n成交量判断: " + volumeJudge
    attackDetail := attackDetail + "\nattack H/L " + fmt(attackDirection == -1 ? lastTopFailureWatchHigh : lastBottomFailureWatchHigh) + " / " + fmt(attackDirection == -1 ? lastTopFailureWatchLow : lastBottomFailureWatchLow)
    attackDetail := attackDetail + "\nbodyMid " + fmt(attackDirection == -1 ? lastTopFailureWatchBodyMid : lastBottomFailureWatchBodyMid)
    attackDetail := attackDetail + "\nvol/MA " + fmt(volumeRatio) + " / closePos " + fmt(closePosition)
    string attackCompact = attackKey + (attackDirection == -1 ? " ②放量失败观察 空" : " ②放量失败观察 多") + "\n等反向确认"
    if eventMarkersVisible
        eventMarker(attackDirection, "watch", " ", attackDetail, 0.28)
    if diagnosticLabelsVisible
        drawFlowLabel(attackDirection, "watch", "blocked", "blocked", 1.25, attackCompact, attackDetail)

bool nakedQuietWatchEvent = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and (topNoDemandWatch or bottomNoSupplyWatch)
if nakedQuietWatchEvent
    int quietDirection = topNoDemandWatch ? -1 : 1
    if topNoDemandWatch and activeTopDecisionSeq == 0
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if bottomNoSupplyWatch and activeBottomDecisionSeq == 0
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    string quietKey = quietDirection == -1 ? "T" + str.tostring(activeTopDecisionSeq) : "B" + str.tostring(activeBottomDecisionSeq)
    string quietStep = quietDirection == -1 ? (topNoDemandStreak <= 1 ? "②连续衰弱观察 空" : "②高位衰弱/打压观察 空") : (bottomNoSupplyStreak <= 1 ? "②连续衰弱观察 多" : "②低位衰弱/打压观察 多")
    string quietMain = quietDirection == -1 ? "naked_high_decay_watch" : "naked_low_decay_watch"
    string quietSecondary = quietDirection == -1 ? "等待红K跌破观察簇低点" : "等待绿K突破观察簇高点"
    string quietDetail = quietKey + " " + quietStep
    quietDetail := quietDetail + "\n不挂单，等破位确认"
    quietDetail := quietDetail + "\n主因: " + quietMain
    quietDetail := quietDetail + "\n次因: " + quietSecondary
    quietDetail := quietDetail + "\n成交量判断: " + volumeJudge
    quietDetail := quietDetail + "\n大回落已成立: " + str.tostring(quietDirection == -1 ? topPullbackArmed : bottomPullbackArmed) + " / 回落 " + fmt(quietDirection == -1 ? topPullbackAtr : bottomPullbackAtr) + "ATR"
    quietDetail := quietDetail + "\nbase " + fmt(quietDirection == -1 ? lastTopFailureWatchBase : lastBottomFailureWatchBase)
    quietDetail := quietDetail + "\nwatch H/L " + fmt(quietDirection == -1 ? lastTopNoDemandHigh : lastBottomNoSupplyHigh) + " / " + fmt(quietDirection == -1 ? lastTopNoDemandLow : lastBottomNoSupplyLow)
    quietDetail := quietDetail + "\n连续 " + str.tostring(quietDirection == -1 ? topNoDemandStreak : bottomNoSupplyStreak)
    quietDetail := quietDetail + "\nvol/MA " + fmt(volumeRatio) + " / closePos " + fmt(closePosition)
    string quietCompact = quietKey + " " + quietStep + "\n等破位确认"
    if eventMarkersVisible
        eventMarker(quietDirection, "watch", " ", quietDetail, 0.30)
    if diagnosticLabelsVisible
        drawFlowLabel(quietDirection, "watch", "blocked", "blocked", 1.25, quietCompact, quietDetail)

bool weakNewTopWatchEvent = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and topWeakNewHighWatch and not topWeakNewHighConfirmed and not topDistributionDropConfirmed and not topHighVolumeDropConfirmed and not topNoDemandWatch and not topNoDemandBreakConfirmed
bool weakNewBottomWatchEvent = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and bottomWeakNewLowWatch and not bottomWeakNewLowConfirmed and not bottomAccumulationRiseConfirmed and not bottomHighVolumeRiseConfirmed and not bottomNoSupplyWatch and not bottomNoSupplyBreakConfirmed
if weakNewTopWatchEvent or weakNewBottomWatchEvent
    int weakWatchDirection = weakNewTopWatchEvent ? -1 : 1
    if weakNewTopWatchEvent
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if weakNewBottomWatchEvent
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    string weakKey = weakWatchDirection == -1 ? "T" + str.tostring(activeTopDecisionSeq) : "B" + str.tostring(activeBottomDecisionSeq)
    string weakWatchDetail = weakKey + " ①" + (weakNewTopWatchEvent ? "弱新高观察 空\n新高缩量\n等待弱收确认" : "弱新低观察 多\n新低缩量\n等待强收确认")
    weakWatchDetail := weakWatchDetail + "\n不挂单"
    weakWatchDetail := weakWatchDetail + "\n成交量判断: " + volumeJudge
    weakWatchDetail := weakWatchDetail + "\nbase " + fmt(weakNewTopWatchEvent ? topWeakBase : bottomWeakBase)
    weakWatchDetail := weakWatchDetail + "\next " + fmt(weakNewTopWatchEvent ? topWeakExtensionAtr : bottomWeakExtensionAtr) + "ATR"
    weakWatchDetail := weakWatchDetail + "\nvol/MA " + fmt(volumeRatio)
    string weakWatchCompact = weakNewTopWatchEvent ? weakKey + " ①弱新高观察 空\n等待弱收确认" : weakKey + " ①弱新低观察 多\n等待强收确认"
    if eventMarkersVisible
        eventMarker(weakWatchDirection, "observe", " ", weakWatchDetail, 0.26)
    if diagnosticLabelsVisible
        drawFlowLabel(weakWatchDirection, "observe", "blocked", "blocked", 1.2, weakWatchCompact, weakWatchDetail)

bool topDistributionOrDropConfirmed = topDistributionDropConfirmed or topImmediateReversalShort or (topHighVolumeDropConfirmed and not topVolumeClimaxFailedBreakConfirmed) or topNoDemandBreakConfirmed
bool bottomAccumulationOrRiseConfirmed = bottomAccumulationRiseConfirmed or bottomHighVolumeRiseConfirmed or bottomNoSupplyBreakConfirmed
bool distributionConfirmRaw = confirmed and showDiagnosticEventFlow and (topDistributionOrDropConfirmed or bottomAccumulationOrRiseConfirmed)
bool distributionConfirmEvent = distributionConfirmRaw and not distributionConfirmRaw[1]
if distributionConfirmEvent
    int distributionDirection = topDistributionOrDropConfirmed ? -1 : 1
    if topDistributionOrDropConfirmed and activeTopDecisionSeq == 0
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if bottomAccumulationOrRiseConfirmed and activeBottomDecisionSeq == 0
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    string distributionKey = distributionDirection == -1 ? "T" + str.tostring(activeTopDecisionSeq) : "B" + str.tostring(activeBottomDecisionSeq)
    bool distributionAllowed = distributionDirection == -1 ? topConfirmAllowed : bottomConfirmAllowed
    bool distributionGapOk = distributionDirection == -1 ? topSignalGapOk : bottomSignalGapOk
    float distributionEntry = distributionDirection == -1 ? topConfirmEntry : bottomConfirmEntry
    float distributionStop = distributionDirection == -1 ? topConfirmStop : bottomConfirmStop
    float distributionQty = distributionDirection == -1 ? topConfirmQty : bottomConfirmQty
    bool distributionSmallStopOk = smallStopTrialAllowed(distributionEntry, distributionStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps)
    string rawDistributionFilterReason = "main_flow_filter"
    if distributionAllowed
        rawDistributionFilterReason := "passed"
    else if not distributionGapOk
        rawDistributionFilterReason := "micro_structure_too_close"
    else if not distributionSmallStopOk
        rawDistributionFilterReason := smallStopGateReason(distributionEntry, distributionStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps)
    else if distributionQty < 1.0
        rawDistributionFilterReason := "qty_too_small"
    string distributionFilterReason = distributionAllowed ? "可挂单" : "确认但过滤\n过滤原因: " + reasonCn(rawDistributionFilterReason) + " / " + rawDistributionFilterReason
    bool distributionQuietBreak = distributionDirection == -1 ? topNoDemandBreakConfirmed : bottomNoSupplyBreakConfirmed
    string distributionKind = "弱新低后分歧放量上涨"
    if distributionDirection == -1
        distributionKind := topImmediateReversalShort ? "冲高大回落/高位失败 / 回抽限价挂空" : topNoDemandBreakConfirmed ? "连续衰弱/打压 / 红K跌破观察簇低点" : topHighVolumeDropConfirmed ? "高位放量失败 / " + (topHighVolumeDropBreakLow ? "红K跌破攻击K低点" : "红K收回攻击K实体中位") : "弱新高后分歧放量下跌"
    else if bottomNoSupplyBreakConfirmed
        distributionKind := "连续衰弱/打压 / 绿K突破观察簇高点"
    else if bottomHighVolumeRiseConfirmed
        distributionKind := "低位放量失败 / " + (bottomHighVolumeRiseBreakHigh ? "绿K突破攻击K高点" : "绿K收回攻击K实体中位")
    float distributionBase = distributionDirection == -1 ? (topNoDemandBreakConfirmed or topHighVolumeDropConfirmed or topImmediateReversalShort ? lastTopFailureWatchBase : topWeakBase) : (bottomNoSupplyBreakConfirmed or bottomHighVolumeRiseConfirmed ? lastBottomFailureWatchBase : bottomWeakBase)
    float distributionWatchHigh = distributionDirection == -1 ? (topNoDemandBreakConfirmed ? lastTopNoDemandHigh : lastTopFailureWatchHigh) : (bottomNoSupplyBreakConfirmed ? lastBottomNoSupplyHigh : lastBottomFailureWatchHigh)
    float distributionWatchLow = distributionDirection == -1 ? (topNoDemandBreakConfirmed ? lastTopNoDemandLow : lastTopFailureWatchLow) : (bottomNoSupplyBreakConfirmed ? lastBottomNoSupplyLow : lastBottomFailureWatchLow)
    float distributionWaitBars = distributionDirection == -1 ? (topNoDemandBreakConfirmed ? barsSinceTopNoDemand : barsSinceTopFailureWatch) : (bottomNoSupplyBreakConfirmed ? barsSinceBottomNoSupply : barsSinceBottomFailureWatch)
    float distributionDistance = distributionDirection == -1 ? (topNoDemandBreakConfirmed ? topNoDemandDistanceAtr : topHighVolumeDropConfirmed or topImmediateReversalShort ? topHighVolumeDropDistanceAtr : topDistributionDistanceAtr) : (bottomNoSupplyBreakConfirmed ? bottomNoSupplyDistanceAtr : bottomHighVolumeRiseConfirmed ? bottomHighVolumeRiseDistanceAtr : bottomAccumulationDistanceAtr)
    string distributionStep = distributionDirection == -1 ? (distributionQuietBreak ? " ③跌破观察簇确认 空\n候选确认 空\n" : " ③放量失败确认 空\n候选确认 空\n") : (distributionQuietBreak ? " ③突破观察簇确认 多\n候选确认 多\n" : " ③放量失败确认 多\n候选确认 多\n")
    string distributionMain = distributionDirection == -1 ? (topNoDemandBreakConfirmed ? "naked_high_decay_break" : selectedMainReason) : (bottomNoSupplyBreakConfirmed ? "naked_low_decay_break" : selectedMainReason)
    string distributionSlText = distributionDirection == -1 ? "前高+buffer " + fmt(topConfirmStop) : "前低-buffer " + fmt(bottomConfirmStop)
    string distributionDetail = distributionKey + distributionStep + (distributionQuietBreak ? "裸K连续衰弱确认" : "裸K放量失败确认")
    distributionDetail := distributionDetail + "\n主因: " + distributionMain
    distributionDetail := distributionDetail + "\n次因: " + distributionKind
    distributionDetail := distributionDetail + "\n" + distributionFilterReason
    distributionDetail := distributionDetail + "\n回抽限价 entry " + fmt(distributionEntry)
    distributionDetail := distributionDetail + "\nSL " + distributionSlText
    distributionDetail := distributionDetail + "\nbase " + fmt(distributionBase)
    distributionDetail := distributionDetail + "\nwatch H/L " + fmt(distributionWatchHigh) + " / " + fmt(distributionWatchLow)
    distributionDetail := distributionDetail + "\n观察已持续 " + fmt(distributionWaitBars) + " bars / " + str.tostring(failedBreakConfirmBars) + " 仅诊断"
    distributionDetail := distributionDetail + "\n成交量判断: " + volumeJudge
    distributionDetail := distributionDetail + "\nvol/MA " + fmt(volumeRatio) + " / closePos " + fmt(closePosition)
    distributionDetail := distributionDetail + "\ndistance " + fmt(distributionDistance) + "ATR"
    string distributionCompact = distributionDirection == -1 ? distributionKey + (distributionQuietBreak ? " 候选确认 空\n跌破观察簇" : " 候选确认 空\n放量失败") : distributionKey + (distributionQuietBreak ? " 候选确认 多\n突破观察簇" : " 候选确认 多\n放量失败")
    if eventMarkersVisible
        eventMarker(distributionDirection, distributionAllowed ? "candidate" : "blocked", " ", distributionDetail, 0.34)
    if diagnosticLabelsVisible
        drawFlowLabel(distributionDirection, distributionAllowed ? "candidate" : "blocked", "confirmed", "confirmed", 1.35, distributionCompact, distributionDetail)

bool exhaustionWatchTop = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and dayRangeClear and topRightShoulder and topRetestBand and upperNoVolumeExpansion and topMomentumDecayed and not upperExhaustionConfirmedShort and not topNoDemandWatch and not topNoDemandBreakConfirmed
bool exhaustionWatchBottom = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and dayRangeClear and bottomRightShoulder and bottomRetestBand and lowerNoVolumeExpansion and bottomMomentumDecayed and not lowerExhaustionConfirmedLong and not bottomNoSupplyWatch and not bottomNoSupplyBreakConfirmed
if exhaustionWatchTop or exhaustionWatchBottom
    int watchDirection = exhaustionWatchTop ? -1 : 1
    if exhaustionWatchTop and activeTopDecisionSeq == 0
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if exhaustionWatchBottom and activeBottomDecisionSeq == 0
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    string watchKey = watchDirection == -1 ? "T" + str.tostring(activeTopDecisionSeq) : "B" + str.tostring(activeBottomDecisionSeq)
    string watchReason = exhaustionWatchTop ? topExhaustionReason : bottomExhaustionReason
    string watchDetail = watchKey + " ①观察 " + dirName(watchDirection)
    watchDetail := watchDetail + "\n" + (exhaustionWatchTop ? "前高二测：多单止盈区，等待确认做空" : "前低二测：空单止盈区，等待确认做多")
    watchDetail := watchDetail + "\n原因: " + reasonCn(watchReason) + " / " + watchReason
    watchDetail := watchDetail + "\n成交量判断: " + volumeJudge
    watchDetail := watchDetail + "\nvol/MA " + fmt(volumeRatio) + " / MDecay " + fmt(exhaustionWatchTop ? topMomentumDecayRatio : bottomMomentumDecayRatio)
    watchDetail := watchDetail + "\n连续衰减 " + fmt(exhaustionWatchTop ? topDecayStreak * 1.0 : bottomDecayStreak * 1.0) + "/" + str.tostring(exhaustionDecayConfirmBars)
    watchDetail := watchDetail + "\n日内高低 " + fmt(dayRangeAtr) + "ATR"
    string watchCompact = watchKey + " ①" + (exhaustionWatchTop ? "前高二测" : "前低二测") + "\n等确认"
    if eventMarkersVisible
        eventMarker(watchDirection, "observe", " ", watchDetail, 0.26)
    if diagnosticLabelsVisible
        drawFlowLabel(watchDirection, "observe", "blocked", "blocked", 1.2, watchCompact, watchDetail)

bool unconfirmedTopWatch = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and strongTopProbeZone and (topFirstExhaustion or topRightShoulder) and not topConfirmAllowed and not volumeClimaxTopWatchEvent and not topVolumeClimaxFailedBreakConfirmed and not topHighVolumeDropConfirmed and not topNoDemandWatch and not topNoDemandBreakConfirmed and not exhaustionWatchTop
bool unconfirmedBottomWatch = confirmed and showDiagnosticEventFlow and selectedDirection == 0 and strongBottomProbeZone and (bottomFirstExhaustion or bottomRightShoulder) and not bottomConfirmAllowed and not bottomHighVolumeRiseConfirmed and not bottomNoSupplyWatch and not bottomNoSupplyBreakConfirmed and not exhaustionWatchBottom
if unconfirmedTopWatch or unconfirmedBottomWatch
    int waitDirection = unconfirmedTopWatch ? -1 : 1
    if unconfirmedTopWatch and activeTopDecisionSeq == 0
        topDecisionSeq += 1
        activeTopDecisionSeq := topDecisionSeq
    if unconfirmedBottomWatch and activeBottomDecisionSeq == 0
        bottomDecisionSeq += 1
        activeBottomDecisionSeq := bottomDecisionSeq
    string waitKey = waitDirection == -1 ? "T" + str.tostring(activeTopDecisionSeq) : "B" + str.tostring(activeBottomDecisionSeq)
    string waitReason = unconfirmedTopWatch ? topProbeFilterReason : bottomProbeFilterReason
    string waitDetail = waitKey + " ①观察 " + dirName(waitDirection)
    waitDetail := waitDetail + "\n未确认，不挂单"
    waitDetail := waitDetail + "\n原因: " + reasonCn(waitReason) + " / " + waitReason
    waitDetail := waitDetail + "\n只有 confirmed_limit 才会画 plan 并联动 Core/IBKR"
    waitDetail := waitDetail + "\n大回落已成立: " + str.tostring(waitDirection == -1 ? topPullbackArmed : bottomPullbackArmed) + " / 回落 " + fmt(waitDirection == -1 ? topPullbackAtr : bottomPullbackAtr) + "ATR"
    waitDetail := waitDetail + "\n成交量判断: " + volumeJudge
    waitDetail := waitDetail + "\n结构区 " + fmt(unconfirmedTopWatch ? topZoneLow : bottomZoneLow) + " - " + fmt(unconfirmedTopWatch ? topZoneHigh : bottomZoneHigh)
    string waitCompact = waitKey + " ①观察 " + dirName(waitDirection) + "\n未确认，不挂单"
    if eventMarkersVisible
        eventMarker(waitDirection, "observe", " ", waitDetail, 0.24)
    if diagnosticLabelsVisible
        drawFlowLabel(waitDirection, "observe", "blocked", "blocked", 1.2, waitCompact, waitDetail)

// Lightweight context plots for reading the structure; these are visual only.
color dtpLineColor = dtpDir == 1 ? color.new(color.aqua, 0) : dtpDir == -1 ? color.new(color.red, 0) : color.new(color.gray, 25)
plot(showEmaFastSlowLines ? emaFast : na, "EMA 20 快线", color=color.new(color.orange, 35), linewidth=1)
plot(showEmaFastSlowLines ? emaMid : na, "EMA 50 慢线", color=color.new(color.gray, 45), linewidth=1)
plot(showEmaContextLines ? emaSlow : na, "EMA 100 趋势", color=color.new(color.silver, 55), linewidth=1)
plot(showEmaContextLines ? emaLongest : na, "EMA 200 长线", color=color.new(color.gray, 70), linewidth=1)
plot(showDtpTrendLine ? dtpAvg : na, "DTP 趋势线", color=dtpLineColor, linewidth=2)
plot(showSdHelperBandLines ? sdMid : na, "SD regression", color=color.new(color.blue, 80), linewidth=1)
plot(showBandLines ? sdUpper : na, "SD signal upper", color=color.new(color.red, 75), linewidth=1)
plot(showBandLines ? sdLower : na, "SD signal lower", color=color.new(color.green, 75), linewidth=1)
plot(showStructureGuideLines ? todayStructHigh : na, "Today Struct High", color=color.new(color.red, 20), linewidth=2, style=plot.style_linebr)
plot(showStructureGuideLines ? todayStructLow : na, "Today Struct Low", color=color.new(color.green, 20), linewidth=2, style=plot.style_linebr)
plot(showStructureGuideLines ? todayStructHighZoneHigh : na, "Struct High Zone High", color=color.new(color.red, 65), linewidth=1, style=plot.style_linebr)
plot(showStructureGuideLines ? todayStructHighZoneLow : na, "Struct High Zone Low", color=color.new(color.red, 78), linewidth=1, style=plot.style_linebr)
plot(showStructureGuideLines ? todayStructLowZoneHigh : na, "Struct Low Zone High", color=color.new(color.green, 78), linewidth=1, style=plot.style_linebr)
plot(showStructureGuideLines ? todayStructLowZoneLow : na, "Struct Low Zone Low", color=color.new(color.green, 65), linewidth=1, style=plot.style_linebr)
plotshape(showComponentMarkers and sdLowerHit, "SD lower hit", location=location.belowbar, style=shape.triangleup, color=color.new(color.green, 0), size=size.tiny, text="SD-L")
plotshape(showComponentMarkers and sdUpperHit, "SD upper hit", location=location.abovebar, style=shape.triangledown, color=color.new(color.orange, 0), size=size.tiny, text="SD-U")
plotshape(showAnyFractalMarkers and fractalBull, "Fractal bull", location=location.belowbar, style=shape.circle, color=color.new(color.aqua, 0), size=size.tiny, text="F+", offset=-fractalPeriod)
plotshape(showAnyFractalMarkers and fractalBear, "Fractal bear", location=location.abovebar, style=shape.circle, color=color.new(color.fuchsia, 0), size=size.tiny, text="F-", offset=-fractalPeriod)
plotshape(showAnyEmaCrossMarkers and emaGoldenCross, "EMA20/50 golden cross", location=location.belowbar, style=shape.triangleup, color=color.new(color.lime, 0), size=size.small, text="20/50金叉")
plotshape(showAnyEmaCrossMarkers and emaDeathCross, "EMA20/50 death cross", location=location.abovebar, style=shape.triangledown, color=color.new(color.red, 0), size=size.small, text="20/50死叉")
plotshape(showComponentMarkers and bullDivNow, "Bull divergence", location=location.belowbar, style=shape.diamond, color=color.new(color.lime, 0), size=size.tiny, text="D+")
plotshape(showComponentMarkers and bearDivNow, "Bear divergence", location=location.abovebar, style=shape.diamond, color=color.new(color.red, 0), size=size.tiny, text="D-")
plotshape(newPlanNow and selectedDirection == 1, title="Predictive/confirmed long", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 35), size=size.tiny, text="")
plotshape(newPlanNow and selectedDirection == -1, title="Predictive/confirmed short", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 35), size=size.tiny, text="")

bool entryWindowStartEvent = showEntryWindowMarkers and useIntradayEntryWindow and inEntryWindow and not inEntryWindow[1]
bool entryWindowEndEvent = showEntryWindowMarkers and useIntradayEntryWindow and not inEntryWindow and inEntryWindow[1]
if entryWindowStartEvent or entryWindowEndEvent
    bool entryWindowOpening = entryWindowStartEvent
    color entryWindowLineColor = entryWindowOpening ? color.new(color.teal, 10) : color.new(color.gray, 35)
    string entryWindowBoundaryText = entryWindowOpening ? "OPEN" : "CLOSED"
    string entryWindowBoundaryDetail = (entryWindowOpening ? "交易窗口 OPEN\n可挂单 " : "交易窗口 CLOSED\n仅观察 ") + entrySession
    line.new(bar_index, low - atr * 2.0, bar_index, high + atr * 2.0, xloc=xloc.bar_index, extend=extend.both, color=entryWindowLineColor, style=line.style_dashed, width=1)
    eventMarker(entryWindowOpening ? 1 : -1, "structure", entryWindowBoundaryText, entryWindowBoundaryDetail, 0.78)

var table entryWindowTable = table.new(position.bottom_right, 1, 2)
if showEntryWindowStatus and barstate.islast
    string entryWindowTitle = not useIntradayEntryWindow ? "交易窗口 FILTER OFF" : inEntryWindow ? "交易窗口 OPEN" : "交易窗口 CLOSED"
    string entryWindowDetail = not useIntradayEntryWindow ? "窗口过滤关闭 / 仅按策略条件" : (inEntryWindow ? "可挂单 " : "仅观察 ") + entrySession
    table.cell(entryWindowTable, 0, 0, entryWindowTitle, text_color=entryWindowTextColor(useIntradayEntryWindow, inEntryWindow), bgcolor=entryWindowBgColor(useIntradayEntryWindow, inEntryWindow))
    table.cell(entryWindowTable, 0, 1, entryWindowDetail, text_color=entryWindowTextColor(useIntradayEntryWindow, inEntryWindow), bgcolor=entryWindowBgColor(useIntradayEntryWindow, inEntryWindow))

var table statusTable = table.new(position.top_right, 2, 9)
if showStatusTable and barstate.islast
    bool statusUsesShadowPlan = shadowPending or shadowOpen
    float statusEntryPlan = statusUsesShadowPlan ? shadowEntry : selectedEntry
    float statusStopPlan = statusUsesShadowPlan ? shadowStop : selectedStop
    float statusRunnerPlan = statusUsesShadowPlan ? shadowRunner : selectedRunnerActivation
    float statusTargetPlan = statusUsesShadowPlan ? shadowTarget : selectedTarget
    int statusDirectionPlan = statusUsesShadowPlan ? shadowDirection : selectedDirection
    float statusQtyPlan = statusUsesShadowPlan ? shadowQty : selectedQty
    table.cell(statusTable, 0, 0, "v3状态", text_color=tableTextColor(0), bgcolor=tableBgColor(0))
    table.cell(statusTable, 1, 0, shadowPending ? "预挂中" : shadowOpen ? "持仓影子" : selectedPlanValid ? "有计划" : "等待", text_color=tableTextColor(0), bgcolor=tableBgColor(0))
    table.cell(statusTable, 0, 1, "方向", text_color=tableTextColor(1), bgcolor=tableBgColor(1))
    table.cell(statusTable, 1, 1, selectedDirection != 0 ? dirName(selectedDirection) : dirName(shadowDirection), text_color=tableTextColor(1), bgcolor=tableBgColor(1))
    table.cell(statusTable, 0, 2, "模式", text_color=tableTextColor(2), bgcolor=tableBgColor(2))
    table.cell(statusTable, 1, 2, selectedEntryIntent, text_color=tableTextColor(2), bgcolor=tableBgColor(2))
    table.cell(statusTable, 0, 3, "主因", text_color=tableTextColor(3), bgcolor=tableBgColor(3))
    table.cell(statusTable, 1, 3, selectedMainReason, text_color=tableTextColor(3), bgcolor=tableBgColor(3))
    table.cell(statusTable, 0, 4, "结构/小止损", text_color=tableTextColor(4), bgcolor=tableBgColor(4))
    table.cell(statusTable, 1, 4, (selectedStructureClear ? "清晰" : "等待") + " / " + selectedBlockReason, text_color=tableTextColor(4), bgcolor=tableBgColor(4))
    table.cell(statusTable, 0, 5, "黄/红/蓝/绿", text_color=tableTextColor(5), bgcolor=tableBgColor(5))
    table.cell(statusTable, 1, 5, "Entry / SL / 0.6R / EMA20TP", text_color=tableTextColor(5), bgcolor=tableBgColor(5))
    table.cell(statusTable, 0, 6, "窗口", text_color=tableTextColor(6), bgcolor=tableBgColor(6))
    table.cell(statusTable, 1, 6, inEntryWindow ? "可入场" : "关闭", text_color=tableTextColor(6), bgcolor=tableBgColor(6))
    table.cell(statusTable, 0, 7, "金额", text_color=tableTextColor(7), bgcolor=tableBgColor(7))
    table.cell(statusTable, 1, 7, planMoneyText(statusEntryPlan, statusStopPlan, statusRunnerPlan, statusTargetPlan, statusDirectionPlan, statusQtyPlan), text_color=tableTextColor(7), bgcolor=tableBgColor(7))
    table.cell(statusTable, 0, 8, "模型", text_color=tableTextColor(8), bgcolor=tableBgColor(8))
    table.cell(statusTable, 1, 8, ENTRY_WINDOW_MODEL + " / " + (useIntradayEntryWindow ? entrySession : "窗口过滤关闭"), text_color=tableTextColor(8), bgcolor=tableBgColor(8))
