        lastBottomNoSupplyLow := na
        structureLowOld := oldStructLow
        structureLowRaised := true
        structureLowIndependent := lowIndependent
        lastProcessedLowCandidateBar := todayLowBar
    bool highConfirmed = not na(todayHighBar) and bar_index - todayHighBar >= dayStructConfirmBars and todayHigh - low >= atr * dayStructMinReversalAtr
    if highConfirmed and (na(lastProcessedHighCandidateBar) or todayHighBar != lastProcessedHighCandidateBar)
        float highBand = atr * structureClusterBandAtr
        bool highHasAnchor = not na(todayStructHigh)
        bool highFarEnough = not highHasAnchor or math.abs(todayHigh - todayStructHigh) >= atr * minStructureSeparationAtr
        bool highMiddleSwingOk = not highHasAnchor or not na(lowSinceStructHigh) and todayStructHigh - lowSinceStructHigh >= atr * minMiddleSwingAtr
        bool highMovesAnchor = not highHasAnchor or confirmed and todayHigh > todayStructHigh + tickBuffer
        bool highIndependent = not highHasAnchor or highFarEnough and highMiddleSwingOk
        if highMovesAnchor and highIndependent
            structureHighOld := todayStructHigh
            prevStructHigh := todayStructHigh
            todayStructHigh := todayHigh
            todayStructHighBar := todayHighBar
