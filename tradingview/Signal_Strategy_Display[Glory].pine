trendResistanceZoneHigh := maxNear(trendResistanceZoneHigh, sdMid, trendResistanceBasis, tolerance)
trendResistanceZoneHigh := maxNear(trendResistanceZoneHigh, sdUpper, trendResistanceBasis, tolerance)
int trendResistanceAgeBars = not na(todayStructHighBar) ? bar_index - todayStructHighBar : 0
bool strongTrendResistance = trendShortContext and dayRangeClear and trendResistanceAgeBars >= minTrendSupportAgeBars and not na(trendResistanceZoneLow) and not na(trendResistanceZoneHigh)

float trendLongConfirmStop = strongTrendSupport ? math.min(low, trendSupportZoneLow) - invalidationBuffer : na
float trendLongConfirmEntryRaw = strongTrendSupport ? math.min(close, trendSupportZoneHigh) : na
float trendLongConfirmEntry = strongTrendSupport ? stopBoundedEntry(1, scalpLimitEntry(1, close, trendSupportBasis, trendLongConfirmEntryRaw, atr, scalpLimitOffsetAtr), trendLongConfirmStop, atr, confirmedMaxStopAtr, confirmedMaxStopBps) : na
bool trendLongConfirmContext = trendLongContext and strongTrendSupport and low <= trendSupportZoneHigh and close > trendSupportZoneHigh and close > open
float trendLongConfirmQty = calcTrialQty(trendLongConfirmEntry, trendLongConfirmStop, confirmedMaxRiskDollars)
bool trendLongConfirmAllowed = trendLongConfirmContext and smallStopTrialAllowed(1, trendLongConfirmEntry, trendLongConfirmStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps) and trendLongConfirmQty >= 1.0

float trendShortConfirmStop = strongTrendResistance ? math.max(high, trendResistanceZoneHigh) + invalidationBuffer : na
float trendShortConfirmEntryRaw = strongTrendResistance ? math.max(close, trendResistanceZoneLow) : na
float trendShortConfirmEntry = strongTrendResistance ? stopBoundedEntry(-1, scalpLimitEntry(-1, close, trendResistanceBasis, trendShortConfirmEntryRaw, atr, scalpLimitOffsetAtr), trendShortConfirmStop, atr, confirmedMaxStopAtr, confirmedMaxStopBps) : na
bool trendShortConfirmContext = trendShortContext and strongTrendResistance and high >= trendResistanceZoneLow and close < trendResistanceZoneLow and close < open
float trendShortConfirmQty = calcTrialQty(trendShortConfirmEntry, trendShortConfirmStop, confirmedMaxRiskDollars)
bool trendShortConfirmAllowed = trendShortConfirmContext and smallStopTrialAllowed(-1, trendShortConfirmEntry, trendShortConfirmStop, atr, confirmedMaxRiskDollars, confirmedMaxStopAtr, confirmedMaxStopBps) and trendShortConfirmQty >= 1.0

float topBasis = todayStructHigh
float topZoneLow = na(todayStructHighZoneLow) ? todayStructHigh : todayStructHighZoneLow
float topZoneHigh = na(todayStructHighZoneHigh) ? todayStructHigh : todayStructHighZoneHigh
float topStructuralRetestLevel = upperBreakAcceptedRegime and not na(prevStructHigh) ? prevStructHigh : topBasis
bool topStrictRetestTouch = not na(topStructuralRetestLevel) and high >= topStructuralRetestLevel - strictRetestTolerance
if confirmed and topProbeCycleActive and topProbeCycleConsumed and not topStrictRetestTouch
    topProbeCycleActive := false
    topProbeCycleTouchBar := na
    lastTopFailureWatchBar := na
    lastTopFailureWatchClose := na
    lastTopFailureWatchVolumeProbe := false
    topNoDemandStreak := 0
    lastTopNoDemandBar := na
    lastTopNoDemandHigh := na
    lastTopNoDemandLow := na
int topCount = not na(todayStructHigh) ? 1 : 0
topCount := addNearCount(topCount, sdUpper, topBasis, tolerance)
topCount := addNearCount(topCount, resistanceZoneHigh, topBasis, tolerance)
topCount := addNearCount(topCount, emaFast, topBasis, tolerance)
topCount := addNearCount(topCount, emaMid, topBasis, tolerance)
topCount := addNearCount(topCount, emaSlow, topBasis, tolerance)
topCount := addNearCount(topCount, dtpAvg, topBasis, tolerance)
topZoneLow := minNear(topZoneLow, sdUpper, topBasis, tolerance)
topZoneLow := minNear(topZoneLow, resistanceZoneHigh, topBasis, tolerance)
topZoneLow := minNear(topZoneLow, emaFast, topBasis, tolerance)
topZoneLow := minNear(topZoneLow, emaMid, topBasis, tolerance)
topZoneLow := minNear(topZoneLow, emaSlow, topBasis, tolerance)
topZoneLow := minNear(topZoneLow, dtpAvg, topBasis, tolerance)
topZoneHigh := maxNear(topZoneHigh, sdUpper, topBasis, tolerance)
topZoneHigh := maxNear(topZoneHigh, resistanceZoneHigh, topBasis, tolerance)
topZoneHigh := maxNear(topZoneHigh, emaFast, topBasis, tolerance)
topZoneHigh := maxNear(topZoneHigh, emaMid, topBasis, tolerance)
topZoneHigh := maxNear(topZoneHigh, emaSlow, topBasis, tolerance)
topZoneHigh := maxNear(topZoneHigh, dtpAvg, topBasis, tolerance)
bool strongTopProbeZone = not na(todayStructHigh) and not na(topZoneLow) and not na(topZoneHigh)
int topAnchorAgeBars = not na(todayStructHighBar) ? bar_index - todayStructHighBar : 0
float topPullbackAtr = not na(todayStructHigh) and not na(lowSinceStructHigh) ? (todayStructHigh - lowSinceStructHigh) / atr : na
float topLeftLeg = not na(todayStructHigh) and not na(lowBeforeStructHigh) ? todayStructHigh - lowBeforeStructHigh : na
float topLocalLeftLeg = not na(todayStructHigh) and not na(localProbeLow) ? todayStructHigh - localProbeLow : na
float topMiddleLeg = not na(todayStructHigh) and not na(lowSinceStructHigh) ? todayStructHigh - lowSinceStructHigh : na
float topRightLeg = not na(lowSinceStructHigh) ? high - lowSinceStructHigh : na
float topLeftLegBps = visualLegBps(topLeftLeg, todayStructHigh)
float topLocalLeftLegBps = visualLegBps(topLocalLeftLeg, todayStructHigh)
float topGlobalMiddleRetraceRatio = visualLegRatio(topMiddleLeg, topLeftLeg)
float topLocalMiddleRetraceRatio = visualLegRatio(topMiddleLeg, topLocalLeftLeg)
float topMiddleRetraceRatio = not na(topLocalMiddleRetraceRatio) ? topLocalMiddleRetraceRatio : topGlobalMiddleRetraceRatio
float topRightRetestRatio = visualLegRatio(topRightLeg, topMiddleLeg)
float topMiddleBars = not na(lowSinceStructHighBar) and not na(todayStructHighBar) ? math.max((lowSinceStructHighBar - todayStructHighBar) * 1.0, 1.0) : na
float topRightBars = not na(lowSinceStructHighBar) ? math.max((bar_index - lowSinceStructHighBar) * 1.0, 1.0) : na
float topMiddleSpeed = not na(topMiddleLeg) and not na(topMiddleBars) ? topMiddleLeg / topMiddleBars : na
float topRightSpeed = not na(topRightLeg) and not na(topRightBars) ? topRightLeg / topRightBars : na
float topMomentumDecayRatio = not na(topMiddleSpeed) and topMiddleSpeed > 0.0 ? topRightSpeed / topMiddleSpeed : na
bool topMomentumDecayed = not na(topMomentumDecayRatio) and topMomentumDecayRatio <= momentumDecayMaxRatio
bool topVisualLeftOk = (not na(topLeftLegBps) and topLeftLegBps >= minVisualLegBps) or (not na(topLocalLeftLegBps) and topLocalLeftLegBps >= minVisualLegBps)
bool topLargePullbackReady = not na(topMiddleLeg) and topMiddleLeg >= atr * minMiddleSwingAtr and topMiddleRetraceRatio >= minVisualMiddleRetraceRatio
bool topPullbackArmedEvent = confirmed and dayRangeClear and strongTopProbeZone and topVisualLeftOk and topLargePullbackReady and not topPullbackArmed
if topPullbackArmedEvent
    topPullbackArmed := true
    topPullbackArmedBar := na(topPullbackArmedBar) ? bar_index : topPullbackArmedBar
bool topMiddleSwingReady = not na(lowSinceStructHighBar) and topVisualLeftOk and topMiddleRetraceRatio >= minVisualMiddleRetraceRatio
bool topRightRetestReady = topMiddleSwingReady and topRightRetestRatio >= minVisualRightRetestRatio
bool topAnchorReady = dayRangeClear and topAnchorAgeBars >= probeMinAnchorAgeBars and topPullbackArmed
bool topRetestBand = not na(topZoneLow) and not na(topZoneHigh) and high >= topZoneLow - atr * probeRetestBandAtr and low <= topZoneHigh + atr * probeRetestBandAtr
bool topImmediatePullbackShort = topPullbackArmedEvent and topRetestBand and topStrictRetestTouch and close < open and (closePosition <= distributionDropClosePosMax or close < topZoneLow)
if topImmediatePullbackShort
    lastTopFailureWatchBar := bar_index
    lastTopFailureWatchHigh := high
    lastTopFailureWatchLow := low
    lastTopFailureWatchBase := topZoneHigh
    lastTopFailureWatchBodyMid := (open + close) * 0.5
    lastTopFailureWatchClose := close
    lastTopFailureWatchVolumeProbe := volumeAttackUp or (volumeRatio >= highAttackVolumeMult and close >= open)
bool topFirstExhaustion = strongTopProbeZone and not topExhaustionUsed and topAnchorReady and topRetestBand and close < topZoneLow
bool topRightShoulder = strongTopProbeZone and topAnchorReady and topRetestBand
string topProbePattern = topRightShoulder ? "retest_2b_top" : topFirstExhaustion ? "extension_exhaustion_top" : "none"
float topWeakBase = topStructuralRetestLevel
float topWeakExtensionAtr = not na(topWeakBase) and atr > 0.0 ? (high - topWeakBase) / atr : na
float topPriorHighStop = math.max(nz(topStructuralRetestLevel, high), nz(topZoneHigh, high)) + invalidationBuffer
float topPredictStop = strongTopProbeZone ? topPriorHighStop : na
float topPredictEntry = strongTopProbeZone ? stopBoundedEntry(-1, topZoneHigh - atr * predictiveEntryOffsetAtr, topPredictStop, atr, predictiveMaxStopAtr, predictiveMaxStopBps) : na
float topSignalDistanceAtr = not na(lastTopProbeSignalPrice) and atr > 0.0 ? math.abs(topPredictEntry - lastTopProbeSignalPrice) / atr : na
bool topSignalBarsOk = na(lastTopProbeSignalBar) or bar_index - lastTopProbeSignalBar >= probeMinSignalGapBars
bool topSignalPriceGapOk = na(topSignalDistanceAtr) or topSignalDistanceAtr >= minSameSideSignalSeparationAtr
bool topSignalGapOk = topSignalBarsOk and topSignalPriceGapOk
bool topSweptStructure = confirmed and topRightShoulder and high > topZoneHigh + tickBuffer
if topSweptStructure
    lastTopSweepBar := bar_index
    lastTopSweepPrice := high
    lastTopSweepVolumeAttack := volumeAttackUp
    lastTopFailureWatchBar := bar_index
    lastTopFailureWatchHigh := high
    lastTopFailureWatchLow := low
    lastTopFailureWatchBase := topZoneHigh
    lastTopFailureWatchBodyMid := (open + close) * 0.5
    lastTopFailureWatchClose := close
    lastTopFailureWatchVolumeProbe := volumeAttackUp or (volumeRatio >= highAttackVolumeMult and close >= open)
    topNoDemandStreak := 0
    lastTopNoDemandBar := na
    lastTopNoDemandHigh := na
    lastTopNoDemandLow := na
bool topNakedTouchEvent = confirmed and dayRangeClear and strongTopProbeZone and topAnchorReady and topRetestBand and topStrictRetestTouch and (na(lastTopFailureWatchBar) or bar_index - lastTopFailureWatchBar > failedBreakConfirmBars)
if topNakedTouchEvent
    lastTopFailureWatchBar := bar_index
    lastTopFailureWatchHigh := high
    lastTopFailureWatchLow := low
    lastTopFailureWatchBase := topWeakBase
    lastTopFailureWatchBodyMid := (open + close) * 0.5
    lastTopFailureWatchClose := close
    lastTopFailureWatchVolumeProbe := volumeAttackUp or (volumeRatio >= highAttackVolumeMult and close >= open)
    topNoDemandStreak := 0
    lastTopNoDemandBar := na
    lastTopNoDemandHigh := na
    lastTopNoDemandLow := na
float barsSinceTopSweep = not na(lastTopSweepBar) ? (bar_index - lastTopSweepBar) * 1.0 : na
bool recentTopSweepWindow = not na(barsSinceTopSweep) and barsSinceTopSweep <= failedBreakConfirmBars
bool upperWeakClose = closePosition <= exhaustionClosePosShortMax or close < open
bool topWeakStructureReady = strongTopProbeZone and topAnchorReady and topRetestBand
bool topVolumeClimaxStructureReady = strongTopProbeZone and topPullbackArmed and topRetestBand
float barsSinceTopVolumeClimax = not na(lastTopVolumeClimaxBar) ? (bar_index - lastTopVolumeClimaxBar) * 1.0 : na
bool recentTopVolumeClimaxWindow = not na(barsSinceTopVolumeClimax) and barsSinceTopVolumeClimax > 0.0 and barsSinceTopVolumeClimax <= failedBreakConfirmBars
bool topVolumeClimaxCloseBack = not na(lastTopVolumeClimaxBase) and close <= lastTopVolumeClimaxBase + atr * failedBreakCloseBackAtr
bool topVolumeClimaxBreakLow = not na(lastTopVolumeClimaxLow) and close < lastTopVolumeClimaxLow
float topVolumeClimaxDistanceAtr = not na(lastTopVolumeClimaxBase) and atr > 0.0 ? math.abs(close - lastTopVolumeClimaxBase) / atr : na
bool topVolumeClimaxRedCandle = close < open
bool topVolumeClimaxFailedBreakConfirmed = confirmed and recentTopVolumeClimaxWindow and topVolumeClimaxRedCandle and (topVolumeClimaxCloseBack or topVolumeClimaxBreakLow) and not na(topVolumeClimaxDistanceAtr) and topVolumeClimaxDistanceAtr <= distributionDropMaxDistanceAtr
bool topVolumeClimaxAttackEvent = confirmed and dayRangeClear and topVolumeClimaxStructureReady and not na(topWeakBase) and high >= topWeakBase - tickBuffer and (volumeAttackUp or volumeRatio >= highAttackVolumeMult) and not topVolumeClimaxFailedBreakConfirmed
if topVolumeClimaxAttackEvent
    lastTopVolumeClimaxBar := bar_index
    lastTopVolumeClimaxHigh := high
    lastTopVolumeClimaxLow := low
    lastTopVolumeClimaxBase := topWeakBase
    lastTopVolumeClimaxVolumeRatio := volumeRatio
    lastTopVolumeClimaxClose := close
bool topWeakNewHighEvent = confirmed and dayRangeClear and topWeakStructureReady and not na(topWeakBase) and high > topWeakBase + tickBuffer and not na(topWeakExtensionAtr) and topWeakExtensionAtr <= weakNewExtremeMaxExtendAtr
if topWeakNewHighEvent
    lastWeakNewHighBar := bar_index
    lastWeakNewHighLow := low
    lastWeakNewHighHigh := high
float barsSinceWeakNewHigh = not na(lastWeakNewHighBar) ? (bar_index - lastWeakNewHighBar) * 1.0 : na
bool recentWeakNewHighWindow = not na(barsSinceWeakNewHigh) and barsSinceWeakNewHigh <= weakNewExtremeConfirmBars
bool topWeakVolumeQuiet = volumeRatio <= weakNewExtremeMaxVolumeRatio
bool topWeakVolumeDropped = na(lastAttackUpVolume) ? topWeakVolumeQuiet : barVolume <= lastAttackUpVolume * weakNewExtremeVolumeDropRatio
bool topWeakNewHighWatch = topWeakNewHighEvent and topWeakVolumeQuiet and topWeakVolumeDropped and topMomentumDecayed
bool topWeakCloseBack = not na(topWeakBase) and close <= topWeakBase + atr * weakNewExtremeCloseBackAtr
float topDistributionDistanceAtr = not na(topWeakBase) and atr > 0.0 ? math.abs(close - topWeakBase) / atr : na
bool topWeakNewHighConfirmed = topWeakNewHighWatch and (topWeakCloseBack or upperWeakClose)
bool topDistributionDropConfirmed = confirmed and recentWeakNewHighWindow and volumeRatio >= distributionDropVolumeMult and close < open and closePosition <= distributionDropClosePosMax and (topWeakCloseBack or not na(lastWeakNewHighLow) and close < lastWeakNewHighLow) and not na(topDistributionDistanceAtr) and topDistributionDistanceAtr <= distributionDropMaxDistanceAtr
float barsSinceTopFailureWatch = not na(lastTopFailureWatchBar) ? (bar_index - lastTopFailureWatchBar) * 1.0 : na
bool topFailureWatchActive = not na(barsSinceTopFailureWatch) and barsSinceTopFailureWatch > 0.0
bool topHighVolumeDropCloseBack = not na(lastTopFailureWatchBase) and close <= lastTopFailureWatchBase - atr * failedBreakCloseBackAtr
bool topHighVolumeDropBreakLow = not na(lastTopFailureWatchLow) and close < lastTopFailureWatchLow
bool topNakedFailureShort = confirmed and topPullbackArmed and topFailureWatchActive and close < open and (topHighVolumeDropCloseBack or topHighVolumeDropBreakLow or not na(lastTopFailureWatchBodyMid) and close <= lastTopFailureWatchBodyMid)
bool topImmediateReversalShort = topImmediatePullbackShort or topNakedFailureShort
float topHighVolumeDropDistanceAtr = not na(lastTopFailureWatchBase) and atr > 0.0 ? math.abs(close - lastTopFailureWatchBase) / atr : na
bool topHighVolumeDropConfirmed = confirmed and topPullbackArmed and topFailureWatchActive and lastTopFailureWatchVolumeProbe and close < open and (closePosition <= distributionDropClosePosMax or not na(lastTopFailureWatchBodyMid) and close <= lastTopFailureWatchBodyMid) and (topHighVolumeDropCloseBack or topHighVolumeDropBreakLow or not na(lastTopFailureWatchBodyMid) and close <= lastTopFailureWatchBodyMid) and not na(topHighVolumeDropDistanceAtr) and topHighVolumeDropDistanceAtr <= distributionDropMaxDistanceAtr
bool topHighVolumeProbeWatch = confirmed and topPullbackArmed and topFailureWatchActive and not topHighVolumeDropConfirmed and volumeRatio >= highAttackVolumeMult and close >= open and topStrictRetestTouch
if topHighVolumeProbeWatch
    lastTopFailureWatchBar := bar_index
    lastTopFailureWatchHigh := high
    lastTopFailureWatchLow := low
    lastTopFailureWatchBodyMid := (open + close) * 0.5
    lastTopFailureWatchClose := close
    lastTopFailureWatchVolumeProbe := true
    topNoDemandStreak := 0
    lastTopNoDemandBar := na
    lastTopNoDemandHigh := na
    lastTopNoDemandLow := na
float topPressureWick = high - math.max(open, close)
float topPressureBody = math.abs(close - open)
bool topPressureWeak = close < open or closePosition <= 0.55 or topPressureWick >= topPressureBody
bool topRetestTouchNow = confirmed and topPullbackArmed and topFailureWatchActive and topStrictRetestTouch
bool topNoDemandWatch = topRetestTouchNow and not topHighVolumeDropConfirmed and volumeRatio < distributionDropVolumeMult and topPressureWeak
if topNoDemandWatch
    topNoDemandStreak := topNoDemandStreak + 1
    lastTopNoDemandBar := bar_index
    lastTopNoDemandHigh := na(lastTopNoDemandHigh) ? high : math.max(lastTopNoDemandHigh, high)
    lastTopNoDemandLow := na(lastTopNoDemandLow) ? low : math.min(lastTopNoDemandLow, low)
else if confirmed and not na(lastTopNoDemandBar) and bar_index - lastTopNoDemandBar > failedBreakConfirmBars
    topNoDemandStreak := 0
    lastTopNoDemandBar := na
    lastTopNoDemandHigh := na
    lastTopNoDemandLow := na
float barsSinceTopNoDemand = not na(lastTopNoDemandBar) ? (bar_index - lastTopNoDemandBar) * 1.0 : na
bool recentTopNoDemandWindow = not na(barsSinceTopNoDemand) and barsSinceTopNoDemand > 0.0 and barsSinceTopNoDemand <= failedBreakConfirmBars
float topNoDemandDistanceAtr = not na(lastTopFailureWatchBase) and atr > 0.0 ? math.abs(close - lastTopFailureWatchBase) / atr : na
bool topNoDemandRsiProof = scalpRsiShortOk or scalpFastBearDiv
bool topNoDemandWeakClose = close < open and (closePosition <= distributionDropClosePosMax or topPressureWick >= topPressureBody or not na(lastTopFailureWatchBodyMid) and close <= lastTopFailureWatchBodyMid)
bool topNoDemandBreakImmediate = topNoDemandWatch and topNoDemandRsiProof and topNoDemandWeakClose and not na(topNoDemandDistanceAtr) and topNoDemandDistanceAtr <= distributionDropMaxDistanceAtr
bool topNoDemandBreakDelayed = confirmed and topPullbackArmed and recentTopNoDemandWindow and topNoDemandStreak >= 2 and topNoDemandRsiProof and close < open and not na(lastTopNoDemandLow) and close < lastTopNoDemandLow and not na(topNoDemandDistanceAtr) and topNoDemandDistanceAtr <= distributionDropMaxDistanceAtr
bool topNoDemandBreakConfirmed = topNoDemandBreakImmediate or topNoDemandBreakDelayed
bool topFailureRepeatShort = topVolumeClimaxFailedBreakConfirmed or topHighVolumeDropConfirmed or topNoDemandBreakConfirmed or topImmediateReversalShort
bool topDirectSweepFailed = confirmed and topSweptStructure and close < topZoneHigh - atr * failedBreakCloseBackAtr
bool topRecentSweepFailed = confirmed and not topDirectSweepFailed and recentTopSweepWindow and close < topZoneHigh - atr * failedBreakCloseBackAtr and upperWeakClose
bool topSweepFailed = topDirectSweepFailed or topRecentSweepFailed
bool topHighVolumeFailedBreak = topSweepFailed and (volumeExpanded or lastTopSweepVolumeAttack)
bool upperNoVolumeExpansion = volumeRatio <= exhaustionVolumeMaxRatio
if confirmed
    topDecayStreak := topRightShoulder and topRetestBand and upperNoVolumeExpansion and topMomentumDecayed ? topDecayStreak + 1 : 0
bool topMomentumDecayReady = topDecayStreak >= exhaustionDecayConfirmBars
bool upperExhaustionZone = dayRangeClear and topRightShoulder and topRetestBand and upperNoVolumeExpansion and topMomentumDecayReady
bool upperExhaustionConfirmedShort = confirmed and upperExhaustionZone and upperWeakClose
string topExhaustionReason = "upper_exhaustion_confirmed"
if not dayRangeFormed
    topExhaustionReason := "day_range_not_formed"
else if not dayRangeClear
    topExhaustionReason := "day_range_too_small"
else if not topMiddleSwingReady
    topExhaustionReason := "middle_pullback_not_enough"
else if not topRightRetestReady
    topExhaustionReason := "right_retest_too_small"
else if not topRetestBand
    topExhaustionReason := "retest_not_near_prior_high"
else if not upperNoVolumeExpansion
    topExhaustionReason := "volume_not_exhausted"
else if not topMomentumDecayed
    topExhaustionReason := "momentum_not_decayed"
else if not topMomentumDecayReady
    topExhaustionReason := "momentum_decay_not_continuous"
else if not upperWeakClose
    topExhaustionReason := "no_weak_close_confirm"
bool topConfirmedShort = topSweepFailed or upperExhaustionConfirmedShort or topWeakNewHighConfirmed or topDistributionDropConfirmed or topVolumeClimaxFailedBreakConfirmed or topHighVolumeDropConfirmed or topNoDemandBreakConfirmed or topImmediateReversalShort
bool topProbeCycleTouchNow = topImmediatePullbackShort or topSweptStructure or topNakedTouchEvent or topVolumeClimaxAttackEvent or topWeakNewHighEvent or topHighVolumeProbeWatch or topNoDemandWatch or upperExhaustionZone
if topProbeCycleTouchNow and not topProbeCycleActive
    topProbeCycleId += 1
    topProbeCycleActive := true
    topProbeCycleConsumed := false
    topProbeCycleTouchBar := bar_index
if topVolumeClimaxFailedBreakConfirmed
    topProbePattern := "volume_climax_failed_break_short"
else if topHighVolumeDropConfirmed
    topProbePattern := "naked_high_volume_reversal_short"
else if topImmediateReversalShort
    topProbePattern := "naked_high_immediate_reversal_short"
