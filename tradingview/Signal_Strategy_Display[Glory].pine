confirmedMaxRiskDollars = input.float(75.0, "Confirmed max trial risk ($)", step=5.0, minval=1.0, group="03 Small Stop Risk")
predictiveMaxStopAtr = input.float(0.70, "Predictive max stop distance (x ATR)", step=0.05, minval=0.05, maxval=5.0, group="03 Small Stop Risk")
confirmedMaxStopAtr = input.float(0.90, "Confirmed max stop distance (x ATR)", step=0.05, minval=0.05, maxval=5.0, group="03 Small Stop Risk")
predictiveMaxStopBps = input.float(60.0, "Predictive max stop distance (bps)", step=5.0, minval=1.0, maxval=1000.0, group="03 Small Stop Risk")
confirmedMaxStopBps = input.float(80.0, "Confirmed max stop distance (bps)", step=5.0, minval=1.0, maxval=1000.0, group="03 Small Stop Risk")
breakevenOffsetR = input.float(0.05, "Breakeven offset (R)", step=0.01, minval=0.0, maxval=1.0, group="03 Small Stop Risk")
runnerTrailAtrMult = input.float(2.0, "Runner trail (x ATR)", step=0.25, minval=0.25, maxval=12.0, group="03 Small Stop Risk")
noFollowThroughBars = input.int(8, "No-follow-through bars", minval=1, maxval=50, group="03 Small Stop Risk")
noFollowThroughMinMfeR = input.float(0.60, "No-follow-through min MFE (R)", step=0.05, minval=0.0, maxval=5.0, group="03 Small Stop Risk")
noFollowThroughCompressedStopR = input.float(0.35, "No-follow-through compressed stop (R)", step=0.05, minval=0.05, maxval=1.0, group="03 Small Stop Risk")
exhaustionProtectMinMfeR = input.float(1.20, "Exhaustion protect min MFE (R)", step=0.05, minval=0.0, maxval=10.0, group="03 Small Stop Risk")
exhaustionProtectTrailAtr = input.float(0.60, "Exhaustion protect trail (x ATR)", step=0.05, minval=0.05, maxval=5.0, group="03 Small Stop Risk")
scalpLimitOffsetAtr = input.float(0.10, "Scalp limit offset (x ATR)", step=0.01, minval=0.0, maxval=1.0, group="03 Small Stop Risk")
scalpMaxEntryAwayAtr = input.float(0.35, "Scalp max entry distance from anchor (x ATR)", step=0.05, minval=0.05, maxval=3.0, group="03 Small Stop Risk")
scalpMinExpectedR = input.float(1.00, "Scalp minimum expected reward (R)", step=0.10, minval=0.10, maxval=10.0, group="03 Small Stop Risk")
minEmaProfitAtr = input.float(0.80, "Minimum EMA target room (x ATR)", step=0.05, minval=0.05, maxval=10.0, group="03 Small Stop Risk")
emaTargetOffsetAtr = input.float(0.10, "EMA target offset (x ATR)", step=0.01, minval=0.0, maxval=2.0, group="03 Small Stop Risk")
scalpBreakevenR = input.float(0.60, "Scalp breakeven trigger (R)", step=0.05, minval=0.10, maxval=5.0, group="03 Small Stop Risk")
scalpNoFollowBars = input.int(4, "Scalp no-follow bars", minval=1, maxval=20, group="03 Small Stop Risk")
rsiLen = input.int(14, "Scalp RSI length", minval=2, maxval=100, group="03 Small Stop Risk")
rsiSmoothLen = input.int(7, "Scalp RSI smooth length", minval=1, maxval=100, group="03 Small Stop Risk")
rsiShortMin = input.float(55.0, "Short RSI high zone", step=1.0, minval=1.0, maxval=99.0, group="03 Small Stop Risk")
rsiLongMax = input.float(45.0, "Long RSI low zone", step=1.0, minval=1.0, maxval=99.0, group="03 Small Stop Risk")
rsiTurnLookback = input.int(3, "RSI turn lookback bars", minval=1, maxval=20, group="03 Small Stop Risk")
maxDailySameSideTrades = input.int(3, "Max same-side trades per day", minval=1, maxval=20, group="03 Small Stop Risk")
maxDailyTotalTrades = input.int(6, "Max total trades per day", minval=1, maxval=50, group="03 Small Stop Risk")
maxSameSideLosses = input.int(2, "Max same-side losses per day", minval=1, maxval=10, group="03 Small Stop Risk")
maxDailyLossDollars = input.float(150.0, "Max daily planned loss stop ($)", step=10.0, minval=1.0, group="03 Small Stop Risk")

entrySession = input.session("0940-1530", "Entry window", group="04 Display")
useIntradayEntryWindow = input.bool(true, "Use entry window", group="04 Display")
entryOrderTtlBars = input.int(3, "Entry order TTL bars", minval=1, maxval=20, group="04 Display")
displayPreset = input.string("核心交易流程", "Display preset", options=["核心交易流程", "指标辅助", "调试全量"], group="04 Display")
showSignalEventFlow = input.bool(true, "Show signal event flow", group="04 Display")
showHistoricalPlanLines = input.bool(true, "Keep historical plan lines", group="04 Display")
showStatusTable = input.bool(false, "Show status table", group="04 Display")
showEntryWindowStatus = input.bool(true, "Show entry window status", group="04 Display")
showEntryWindowMarkers = input.bool(true, "Show entry window markers", group="04 Display")
showEma = input.bool(true, "Show EMA fast/slow", group="04 Display")
showBands = input.bool(true, "Show SD bands", group="04 Display")
showSdHelperLines = input.bool(false, "Show SD mid line", group="04 Display")
showDtpLine = input.bool(true, "Show DTP trend line", group="04 Display")
showStructureLines = input.bool(true, "Show today structure lines", group="04 Display")
showDebugComponents = input.bool(false, "Show SD/F/D component markers", group="04 Display")
showFractalMarkers = input.bool(false, "Show fractal markers", group="04 Display")
showEmaCrossMarkers = input.bool(true, "Show EMA20/50 cross markers", group="04 Display")
flowLabelTransparency = input.int(45, "Flow label transparency", minval=0, maxval=90, group="04 Display")
tipVerticalDistanceAtr = input.float(2.0, "Tip vertical distance (x ATR)", step=0.10, minval=0.50, maxval=8.0, group="04 Display")
labelDetailMode = input.string("compact_tooltip", "Flow label detail mode", options=["compact_tooltip", "full_labels", "off"], group="04 Display")
eventMarkerMode = input.string("小点tooltip", "Event marker mode", options=["小点tooltip", "大标签调试", "关闭"], group="04 Display")
labelTextMode = input.string("auto", "Label text color", options=["auto", "white", "black"], group="04 Display")

// -----------------------------------------------------------------------------
// Helpers
// -----------------------------------------------------------------------------
confirmed = barstate.isconfirmed
bool displayIndicatorMode = displayPreset == "指标辅助"
bool displayDebugMode = displayPreset == "调试全量"
bool showEmaFastSlowLines = showEma or displayIndicatorMode or displayDebugMode
bool showEmaContextLines = displayIndicatorMode or displayDebugMode
bool showBandLines = showBands or displayIndicatorMode or displayDebugMode
bool showSdHelperBandLines = showSdHelperLines or displayIndicatorMode or displayDebugMode
bool showDtpTrendLine = showDtpLine or displayIndicatorMode or displayDebugMode
bool showStructureGuideLines = showStructureLines or displayIndicatorMode or displayDebugMode
bool showComponentMarkers = showDebugComponents or displayDebugMode
bool showAnyFractalMarkers = showComponentMarkers or showFractalMarkers
bool showAnyEmaCrossMarkers = showEmaCrossMarkers or displayIndicatorMode or displayDebugMode
bool flowLabelsVisible = showSignalEventFlow and labelDetailMode != "off"
bool showDiagnosticEventFlow = showSignalEventFlow and eventMarkerMode != "关闭"
bool eventMarkersVisible = showSignalEventFlow and eventMarkerMode == "小点tooltip"
bool diagnosticLabelsVisible = flowLabelsVisible and eventMarkerMode == "大标签调试"
float atrRaw = ta.atr(atrLength)
float atr = math.max(nz(atrRaw, syminfo.mintick), syminfo.mintick)
float tickBuffer = syminfo.mintick * 2.0
float invalidationBuffer = math.max(tickBuffer, atr * stopBufferAtr)
float barRange = math.max(high - low, syminfo.mintick)
float closePosition = (close - low) / barRange
float volumeMa = ta.sma(volume, volumeMaLen)
float barVolume = na(volume) ? nz(volumeMa, 0.0) : volume
float volumeRatio = not na(volumeMa) and volumeMa > 0.0 ? barVolume / volumeMa : 1.0
bool volumeExpanded = volumeRatio >= highAttackVolumeMult
bool volumeQuietRetest = volumeRatio <= lowRetestVolumeMult
bool volumeAttackUp = volumeExpanded and close > open and closePosition >= attackClosePosThreshold
bool volumeAttackDown = volumeExpanded and close < open and closePosition <= 1.0 - attackClosePosThreshold
float scalpRsi = ta.rsi(close, rsiLen)
float scalpRsiSmooth = ta.ema(scalpRsi, rsiSmoothLen)
float scalpRsiSpread = scalpRsi - scalpRsiSmooth
float scalpRsiSpreadHigh = ta.highest(scalpRsiSpread, rsiTurnLookback)
float scalpRsiHigh = ta.highest(scalpRsi, rsiTurnLookback)
float scalpRsiSpreadLow = ta.lowest(scalpRsiSpread, rsiTurnLookback)
float scalpRsiLow = ta.lowest(scalpRsi, rsiTurnLookback)
bool scalpRsiCrossUnderSmooth = ta.crossunder(scalpRsi, scalpRsiSmooth)
bool scalpRsiCrossOverSmooth = ta.crossover(scalpRsi, scalpRsiSmooth)
bool scalpRsiWasHigh = scalpRsiSpreadHigh > 0.0 and scalpRsiHigh >= rsiShortMin
bool scalpRsiWasLow = scalpRsiSpreadLow < 0.0 and scalpRsiLow <= rsiLongMax
bool scalpRsiWeakening = scalpRsi <= scalpRsi[1] or scalpRsiSpread < scalpRsiSpread[1] or scalpRsiCrossUnderSmooth
bool scalpRsiStrengthening = scalpRsi >= scalpRsi[1] or scalpRsiSpread > scalpRsiSpread[1] or scalpRsiCrossOverSmooth
bool scalpRsiShortOk = scalpRsiWasHigh and scalpRsiWeakening
bool scalpRsiLongOk = scalpRsiWasLow and scalpRsiStrengthening
string volumeJudge = volumeAttackUp ? "放量上攻" : volumeAttackDown ? "放量下砸" : volumeQuietRetest ? "缩量/量能衰减" : volumeExpanded ? "放量但收盘不强" : "正常量"

fmt(float value) =>
    str.tostring(value, "#.##")

riskPerShare(float entryPrice, float stopPrice) =>
    math.abs(entryPrice - stopPrice)

riskDollars(float entryPrice, float stopPrice, float qty) =>
    not na(entryPrice) and not na(stopPrice) and not na(qty) and qty > 0.0 ? math.abs(entryPrice - stopPrice) * qty : na

pnlDollars(float entryPrice, float levelPrice, int direction, float qty) =>
    not na(entryPrice) and not na(levelPrice) and not na(qty) and qty > 0.0 and direction != 0 ? (levelPrice - entryPrice) * direction * qty : na

moneyText(float value) =>
    na(value) ? "$--" : (value >= 0.0 ? "+$" : "-$") + str.tostring(math.abs(value), "#.##")

qtyText(float qty) =>
    na(qty) ? "--" : str.tostring(qty, "#")

planMoneyText(float entryPrice, float stopPrice, float runnerPrice, float targetPrice, int direction, float qty) =>
    "SL " + moneyText(pnlDollars(entryPrice, stopPrice, direction, qty)) + " / Runner " + moneyText(pnlDollars(entryPrice, runnerPrice, direction, qty)) + " / TP " + moneyText(pnlDollars(entryPrice, targetPrice, direction, qty))

stopDistanceAtr(float entryPrice, float stopPrice, float atrValue) =>
    atrValue > 0.0 ? riskPerShare(entryPrice, stopPrice) / atrValue : na

stopDistanceBps(float entryPrice, float stopPrice) =>
    entryPrice > 0.0 ? riskPerShare(entryPrice, stopPrice) / entryPrice * 10000.0 : na

visualLegBps(float legValue, float basisPrice) =>
    not na(legValue) and basisPrice > 0.0 ? math.max(0.0, legValue) / basisPrice * 10000.0 : na

visualLegRatio(float numerator, float denominator) =>
    not na(numerator) and denominator > 0.0 ? math.max(0.0, numerator) / denominator : na

smallStopTrialAllowed(float entryPrice, float stopPrice, float atrValue, float maxRiskDollars, float maxAtrMultiple, float maxBps) =>
    float rps = riskPerShare(entryPrice, stopPrice)
    float atrDistance = stopDistanceAtr(entryPrice, stopPrice, atrValue)
    float bpsDistance = stopDistanceBps(entryPrice, stopPrice)
    entryPrice > 0.0 and stopPrice > 0.0 and rps > 0.0 and rps <= maxRiskDollars and atrDistance <= maxAtrMultiple and bpsDistance <= maxBps

smallStopGateReason(float entryPrice, float stopPrice, float atrValue, float maxRiskDollars, float maxAtrMultiple, float maxBps) =>
    float rps = riskPerShare(entryPrice, stopPrice)
    float atrDistance = stopDistanceAtr(entryPrice, stopPrice, atrValue)
    float bpsDistance = stopDistanceBps(entryPrice, stopPrice)
    entryPrice <= 0.0 or stopPrice <= 0.0 ? "invalid_price" : rps <= 0.0 ? "invalid_stop" : rps > maxRiskDollars ? "one_share_risk_too_large" : atrDistance > maxAtrMultiple ? "stop_distance_atr_too_large" : bpsDistance > maxBps ? "stop_distance_bps_too_large" : "passed"

calcTrialQty(float entryPrice, float stopPrice, float maxRiskDollars) =>
    float rps = riskPerShare(entryPrice, stopPrice)
    float notionalQty = entryPrice > 0.0 ? math.floor(positionAmount / entryPrice) : 0.0
    float riskQty = rps > 0.0 ? math.floor(maxRiskDollars / rps) : 0.0
    math.max(0.0, math.min(notionalQty, riskQty))

calcTargetAtR(float entryPrice, float stopPrice, int direction, float rMultiple) =>
    entryPrice + riskPerShare(entryPrice, stopPrice) * rMultiple * direction

scalpLimitEntry(int direction, float currentClose, float anchorPrice, float fallbackEntry, float atrValue, float offsetAtr) =>
    float offset = math.max(syminfo.mintick, atrValue * offsetAtr)
    direction == 1 and not na(anchorPrice) ? math.min(currentClose - syminfo.mintick, anchorPrice + offset) : direction == -1 and not na(anchorPrice) ? math.max(currentClose + syminfo.mintick, anchorPrice - offset) : fallbackEntry

scalpEmaTarget(int direction, float emaPrice, float atrValue, float offsetAtr) =>
    direction == 1 ? emaPrice - atrValue * offsetAtr : direction == -1 ? emaPrice + atrValue * offsetAtr : na

floatingStructureStop(int direction, float currentStop, float pivotLowValue, float pivotHighValue, float currentClose, float bufferValue) =>
    float candidate = direction == 1 and not na(pivotLowValue) and pivotLowValue < currentClose ? pivotLowValue - bufferValue : direction == -1 and not na(pivotHighValue) and pivotHighValue > currentClose ? pivotHighValue + bufferValue : na
    bool improves = not na(candidate) and not na(currentStop) and (direction == 1 ? candidate > currentStop : direction == -1 ? candidate < currentStop : false)
    improves ? candidate : na

looserStop(float rawStop, float structureStop, int direction) =>
    na(structureStop) ? rawStop : direction == 1 ? math.min(rawStop, structureStop) : math.max(rawStop, structureStop)

levelNear(float level, float basis, float tolerance) =>
    not na(level) and not na(basis) and math.abs(level - basis) <= tolerance

nearestBelow(float reference, float a, float b, float c, float d, float e, float f, float g, float h) =>
    float result = na
    result := not na(a) and a <= reference ? a : result
    result := not na(b) and b <= reference and (na(result) or b > result) ? b : result
    result := not na(c) and c <= reference and (na(result) or c > result) ? c : result
    result := not na(d) and d <= reference and (na(result) or d > result) ? d : result
    result := not na(e) and e <= reference and (na(result) or e > result) ? e : result
    result := not na(f) and f <= reference and (na(result) or f > result) ? f : result
    result := not na(g) and g <= reference and (na(result) or g > result) ? g : result
    result := not na(h) and h <= reference and (na(result) or h > result) ? h : result
    result

nearestAbove(float reference, float a, float b, float c, float d, float e, float f, float g, float h) =>
    float result = na
    result := not na(a) and a >= reference ? a : result
    result := not na(b) and b >= reference and (na(result) or b < result) ? b : result
    result := not na(c) and c >= reference and (na(result) or c < result) ? c : result
    result := not na(d) and d >= reference and (na(result) or d < result) ? d : result
    result := not na(e) and e >= reference and (na(result) or e < result) ? e : result
    result := not na(f) and f >= reference and (na(result) or f < result) ? f : result
    result := not na(g) and g >= reference and (na(result) or g < result) ? g : result
    result := not na(h) and h >= reference and (na(result) or h < result) ? h : result
    result

addNearCount(int current, float level, float basis, float tolerance) =>
    levelNear(level, basis, tolerance) ? current + 1 : current

minNear(float current, float level, float basis, float tolerance) =>
    levelNear(level, basis, tolerance) ? (na(current) ? level : math.min(current, level)) : current

maxNear(float current, float level, float basis, float tolerance) =>
    levelNear(level, basis, tolerance) ? (na(current) ? level : math.max(current, level)) : current

appendSource(string current, string source) =>
    current == "" ? source : current + "," + source

appendNearSource(string current, float level, float basis, float tolerance, string source) =>
    levelNear(level, basis, tolerance) ? appendSource(current, source) : current

signalConfluenceCount(bool rsiOk, bool nakedOk, bool volumeOk, bool middleOk, bool rightOk) =>
    (rsiOk ? 1 : 0) + (nakedOk ? 1 : 0) + (volumeOk ? 1 : 0) + (middleOk ? 1 : 0) + (rightOk ? 1 : 0)

signalConfluenceSources(bool rsiOk, bool nakedOk, bool volumeOk, string volumeReason, bool middleOk, bool rightOk) =>
    string result = ""
    result := rsiOk ? appendSource(result, "rsi_turn") : result
    result := nakedOk ? appendSource(result, "naked_k") : result
    result := volumeOk ? appendSource(result, volumeReason) : result
    result := middleOk ? appendSource(result, "local_m") : result
    result := rightOk ? appendSource(result, "right_retest") : result
    result

setupDisplayName(string setup) =>
    setup == "trend_support_long" ? "多·强趋势回踩" : setup == "trend_resistance_short" ? "空·强趋势反弹" : setup == "probe_2b_top_short" ? "空·结构首顶/右肩" : setup == "probe_2b_bottom_long" ? "多·结构首底/右肩" : setup

dirName(int direction) =>
    direction == 1 ? "多" : direction == -1 ? "空" : "--"

intentName(string intent) =>
    intent == "predictive_limit" ? "未确认观察" : intent == "confirmed_limit" ? "确认挂单" : "等待确认"

reasonCn(string reason) =>
    string result = reason
    if reason == "passed"
        result := "通过"
    else if reason == "no_candidate"
        result := "无候选"
    else if reason == "no_clear_structure"
        result := "结构不清晰"
    else if reason == "confluence_count_too_low"
        result := "共振数量不足"
    else if reason == "confirm_signal_missing"
        result := "确认信号不足"
    else if reason == "trend_context_missing"
        result := "趋势上下文不足"
    else if reason == "day_range_not_formed"
        result := "日内高低未形成"
    else if reason == "day_range_too_small"
        result := "日内振幅不够"
    else if reason == "anchor_too_fresh"
        result := "结构太新"
    else if reason == "left_leg_too_small"
        result := "左侧涨跌幅不够"
    else if reason == "middle_leg_too_small" or reason == "middle_pullback_not_enough" or reason == "pullback_not_enough"
        result := "大回落/反弹不足"
    else if reason == "right_retest_too_small"
        result := "二次回测不够"
    else if reason == "retest_too_slow"
        result := "二次回测太慢"
    else if reason == "not_retest_zone" or reason == "retest_not_near_prior_high"
        result := "未回到结构区"
    else if reason == "volume_not_exhausted"
        result := "量能未衰竭"
    else if reason == "momentum_not_decayed"
        result := "动能未衰减"
    else if reason == "momentum_decay_not_continuous"
        result := "动能衰减不连续"
    else if reason == "no_weak_close_confirm"
        result := "缺少弱收确认"
    else if reason == "no_strong_close_confirm"
        result := "缺少强收确认"
    else if reason == "entry_too_far_from_anchor"
        result := "离结构位太远"
    else if reason == "rsi_not_turning"
        result := "RSI未转弱/转强"
    else if reason == "micro_structure_too_close"
        result := "同向信号太近"
    else if reason == "any_plan_too_close"
        result := "距离上一计划太近"
    else if reason == "daily_risk_cap_hit"
        result := "日内风控触发"
    else if reason == "ema_tp_too_close"
        result := "EMA止盈空间不够"
    else if reason == "expected_r_too_small"
        result := "盈亏比不够"
    else if reason == "outside_entry_session"
        result := "不在入场时间"
    result

flowColor(string state, int direction) =>
    state == "blocked" or state == "trend_blocked" ? color.new(color.gray, flowLabelTransparency) : state == "armed" ? color.new(color.yellow, flowLabelTransparency) : state == "entry_far_limit_wait" ? color.new(color.orange, flowLabelTransparency) : state == "weak_structure_reversal" ? color.new(color.maroon, flowLabelTransparency) : state == "predictive" ? color.new(color.orange, flowLabelTransparency) : state == "confirmed" ? color.new(color.teal, flowLabelTransparency) : state == "exit" ? color.new(color.purple, flowLabelTransparency) : direction == 1 ? color.new(color.green, flowLabelTransparency) : color.new(color.red, flowLabelTransparency)

labelTextColor(string state, int direction) =>
    labelTextMode == "white" ? color.white : labelTextMode == "black" ? color.black : state == "predictive" or state == "blocked" ? color.black : color.white

flowLabelText(string compactText, string detailText) =>
    labelDetailMode == "compact_tooltip" ? compactText : detailText

flowLabelTooltip(string detailText) =>
    labelDetailMode == "compact_tooltip" ? detailText : ""

flowLabelSize() =>
    size.small

labelStyleForSide(bool above) =>
    above ? label.style_label_down : label.style_label_up

labelYForSide(bool above, float offsetAtr) =>
    above ? high + atr * offsetAtr : low - atr * offsetAtr

labelAboveForDirection(int direction) =>
    direction == -1

flowY(int direction, float offsetAtr) =>
    labelYForSide(labelAboveForDirection(direction), offsetAtr)

eventFlowMinOffset(string state) =>
    state == "structure" ? math.max(1.20, tipVerticalDistanceAtr * 0.70) : state == "observe" or state == "watch" ? math.max(1.40, tipVerticalDistanceAtr * 0.80) : state == "armed" or state == "candidate" or state == "confirmed" or state == "entry_far_limit_wait" or state == "weak_structure_reversal" or state == "trend_blocked" or state == "risk" ? math.max(1.60, tipVerticalDistanceAtr * 0.90) : tipVerticalDistanceAtr

eventFlowY(int direction, string state, float offsetAtr) =>
    flowY(direction, math.max(offsetAtr, eventFlowMinOffset(state)))

profitY(int direction, float offsetAtr) =>
    labelYForSide(direction == 1, offsetAtr)

profitStyle(int direction) =>
    labelStyleForSide(direction == 1)

eventMarkerText(string markerText, string detailText) =>
    markerText

eventMarkerTooltip(string detailText) =>
    detailText

eventMarkerSize(string markerKind) =>
    markerKind == "confirmed" or markerKind == "entry_far_limit_wait" or markerKind == "armed" ? size.small : size.tiny

eventMarkerGlyph(string markerKind, int direction, string markerText) =>
    markerText != "" and markerText != " " ? markerText : markerKind == "confirmed" ? (direction == 1 ? "多" : "空") : markerKind == "entry_far_limit_wait" ? "限" : markerKind == "armed" ? "待" : markerKind == "weak_structure_reversal" ? "弱" : markerKind == "trend_blocked" ? "逆" : markerKind == "candidate" ? (direction == 1 ? "^" : "v") : markerKind == "blocked" ? "x" : markerKind == "risk" ? "!" : markerKind == "watch" ? (direction == 1 ? "+" : "-") : "o"

eventMarkerColor(string markerKind, int direction) =>
    markerKind == "structure" ? color.new(color.aqua, 0) : markerKind == "armed" ? color.new(color.yellow, 0) : markerKind == "entry_far_limit_wait" ? color.new(color.orange, 0) : markerKind == "weak_structure_reversal" ? color.new(color.maroon, 0) : markerKind == "trend_blocked" ? color.new(color.gray, 0) : markerKind == "confirmed" ? color.new(direction == 1 ? color.lime : color.red, 0) : markerKind == "candidate" ? color.new(color.orange, 0) : markerKind == "blocked" ? color.new(color.purple, 0) : markerKind == "risk" ? color.new(color.blue, 0) : markerKind == "observe" ? color.new(color.gray, 0) : markerKind == "watch" ? color.new(direction == 1 ? color.lime : color.red, 0) : color.new(direction == 1 ? color.lime : color.red, 0)

eventMarkerStyle(string markerKind, int direction) =>
    label.style_none

eventMarkerLane(string markerKind) =>
    markerKind == "structure" ? 0.02 : markerKind == "observe" ? 0.14 : markerKind == "armed" ? 0.22 : markerKind == "watch" ? 0.30 : markerKind == "candidate" ? 0.42 : markerKind == "confirmed" or markerKind == "entry_far_limit_wait" ? 0.54 : markerKind == "weak_structure_reversal" or markerKind == "trend_blocked" ? 0.58 : markerKind == "blocked" ? 0.66 : markerKind == "risk" ? 0.74 : 0.20

eventMarkerY(int direction, string markerKind, float offsetAtr) =>
    float laneOffset = offsetAtr + eventMarkerLane(markerKind)
    labelYForSide(labelAboveForDirection(direction), math.max(laneOffset, eventFlowMinOffset(markerKind)))

eventMarker(int direction, string markerKind, string markerText, string detailText, float offsetAtr) =>
    label.new(bar_index, eventMarkerY(direction, markerKind, offsetAtr), eventMarkerText(eventMarkerGlyph(markerKind, direction, markerText), detailText), style=eventMarkerStyle(markerKind, direction), color=color.new(color.white, 100), textcolor=eventMarkerColor(markerKind, direction), size=eventMarkerSize(markerKind), tooltip=eventMarkerTooltip(detailText))

tableBgColor(int row) =>
    row == 0 ? color.new(color.black, 0) : row % 2 == 0 ? color.new(color.black, 8) : color.new(color.black, 18)

tableTextColor(int row) =>
    color.white

entryWindowBgColor(bool windowEnabled, bool windowOpen) =>
    not windowEnabled ? color.new(color.silver, 12) : windowOpen ? color.new(color.teal, 0) : color.new(color.black, 18)

entryWindowTextColor(bool windowEnabled, bool windowOpen) =>
    not windowEnabled ? color.black : windowOpen ? color.black : color.white

flowStyle(int direction) =>
    labelStyleForSide(labelAboveForDirection(direction))

drawFlowLabel(int direction, string offsetState, string colorState, string textState, float offsetAtr, string compactText, string detailText) =>
    label.new(bar_index, eventFlowY(direction, offsetState, offsetAtr), flowLabelText(compactText, detailText), style=flowStyle(direction), color=flowColor(colorState, direction), textcolor=labelTextColor(textState, direction), size=flowLabelSize(), tooltip=flowLabelTooltip(detailText))

drawProfitLabel(int direction, string textState, float offsetAtr, string compactText, string detailText, color labelColor) =>
    label.new(bar_index, profitY(direction, offsetAtr), flowLabelText(compactText, detailText), style=profitStyle(direction), color=labelColor, textcolor=labelTextColor(textState, direction), size=flowLabelSize(), tooltip=flowLabelTooltip(detailText))

// -----------------------------------------------------------------------------
// Market structure and candidate generation (mirrors Core).
// -----------------------------------------------------------------------------
float emaFast = ta.ema(close, emaFastLen)
float emaMid = ta.ema(close, emaMidLen)
float emaSlow = ta.ema(close, emaSlowLen)
float emaLongest = ta.ema(close, emaLongLen)
bool emaGoldenCrossRaw = ta.crossover(emaFast, emaMid)
bool emaDeathCrossRaw = ta.crossunder(emaFast, emaMid)
bool emaGoldenCross = confirmed and emaGoldenCrossRaw
bool emaDeathCross = confirmed and emaDeathCrossRaw
float dtpAvg = ta.sma(close, dtpSmaLength)
float dtpAtr = ta.atr(dtpAtrLength)
float dtpMomentum = dtpAvg - dtpAvg[dtpMomentumLookback]
float dtpNorm = dtpAtr > 0.0 ? dtpMomentum / dtpAtr : 0.0
bool dtpBullTurn = ta.crossover(dtpNorm, dtpTrendThreshold)
bool dtpBearTurn = ta.crossunder(dtpNorm, -dtpTrendThreshold)
var int dtpDir = 0
var int dtpStartBar = na
if confirmed
    if dtpBullTurn or dtpNorm > dtpTrendThreshold and close > dtpAvg and dtpDir != 1
        dtpDir := 1
        dtpStartBar := bar_index
    if dtpBearTurn or dtpNorm < -dtpTrendThreshold and close < dtpAvg and dtpDir != -1
        dtpDir := -1
        dtpStartBar := bar_index
int dtpPhaseBars = na(dtpStartBar) ? 0 : bar_index - dtpStartBar + 1
bool dtpBull = dtpDir == 1 and close >= dtpAvg
bool dtpBear = dtpDir == -1 and close <= dtpAvg
bool dtpEarly = dtpPhaseBars > 0 and dtpPhaseBars <= dtpEarlyBars

float sdMid = ta.linreg(close, sdLength, 0)
float sdDev = ta.stdev(close, sdLength)
float sdUpper = sdMid + sdDev * sdBandMult
float sdLower = sdMid - sdDev * sdBandMult
float recentHigh = ta.highest(high[1], structureLookbackBars)
float recentLow = ta.lowest(low[1], structureLookbackBars)
float localProbeHigh = ta.highest(high[1], probeLocalLegLookbackBars)
float localProbeLow = ta.lowest(low[1], probeLocalLegLookbackBars)
float pivotHigh = ta.pivothigh(high, fractalPeriod, fractalPeriod)
float pivotLow = ta.pivotlow(low, fractalPeriod, fractalPeriod)
bool fractalBear = confirmed and not na(pivotHigh)
bool fractalBull = confirmed and not na(pivotLow)
bool sdLowerHit = confirmed and low <= sdLower
bool sdUpperHit = confirmed and high >= sdUpper
var float lastPivotHigh = na
var float lastPivotLow = na
if confirmed and not na(pivotHigh)
    lastPivotHigh := pivotHigh
if confirmed and not na(pivotLow)
    lastPivotLow := pivotLow

int crsiCycleLen = math.max(1, int(math.round(crsiDomcycle / 2.0)))
float crsiTorque = 2.0 / (crsiVibration + 1.0)
int crsiLag = math.max(0, int(math.round((crsiVibration - 1.0) / 2.0)))
float closeChange = ta.change(close)
float crsiUp = ta.rma(math.max(closeChange, 0.0), crsiCycleLen)
float crsiDown = ta.rma(-math.min(closeChange, 0.0), crsiCycleLen)
float crsiRaw = crsiDown == 0.0 ? 100.0 : crsiUp == 0.0 ? 0.0 : 100.0 - 100.0 / (1.0 + crsiUp / crsiDown)
var float crsi = na
crsi := crsiTorque * (2.0 * crsiRaw - nz(crsiRaw[crsiLag], crsiRaw)) + (1.0 - crsiTorque) * nz(crsi[1], crsiRaw)
float obvFlow = closeChange > 0.0 ? volume : closeChange < 0.0 ? -volume : 0.0
float obvOsc = ta.rsi(ta.cum(obvFlow), obvRsiLen)
bool includeRegularDiv = divType == "regular" or divType == "both"
bool includeHiddenDiv = divType == "hidden" or divType == "both"
var float prevHighPriceCrsi = na
var float prevHighOscCrsi = na
var int prevHighBarCrsi = na
var float prevLowPriceCrsi = na
var float prevLowOscCrsi = na
var int prevLowBarCrsi = na
var float prevHighPriceObv = na
var float prevHighOscObv = na
var int prevHighBarObv = na
var float prevLowPriceObv = na
var float prevLowOscObv = na
var int prevLowBarObv = na
bool crsiRegBearDiv = false
bool crsiRegBullDiv = false
bool crsiHidBearDiv = false
bool crsiHidBullDiv = false
bool obvRegBearDiv = false
bool obvRegBullDiv = false
bool obvHidBearDiv = false
bool obvHidBullDiv = false
float divPivotHigh = ta.pivothigh(high, divLookback, divLookback)
float divPivotLow = ta.pivotlow(low, divLookback, divLookback)
if confirmed and not na(divPivotHigh)
    int currentPivotBar = bar_index - divLookback
    float currentCrsiHigh = crsi[divLookback]
    if not na(prevHighPriceCrsi) and not na(prevHighBarCrsi)
        int barDistance = currentPivotBar - prevHighBarCrsi
        if barDistance > 0 and barDistance <= divMaxBars
            crsiRegBearDiv := includeRegularDiv and divPivotHigh > prevHighPriceCrsi and currentCrsiHigh < prevHighOscCrsi
            crsiHidBearDiv := includeHiddenDiv and divPivotHigh < prevHighPriceCrsi and currentCrsiHigh > prevHighOscCrsi
    prevHighPriceCrsi := divPivotHigh
    prevHighOscCrsi := currentCrsiHigh
    prevHighBarCrsi := currentPivotBar
if confirmed and not na(divPivotLow)
    int currentPivotBar = bar_index - divLookback
    float currentCrsiLow = crsi[divLookback]
    if not na(prevLowPriceCrsi) and not na(prevLowBarCrsi)
        int barDistance = currentPivotBar - prevLowBarCrsi
        if barDistance > 0 and barDistance <= divMaxBars
            crsiRegBullDiv := includeRegularDiv and divPivotLow < prevLowPriceCrsi and currentCrsiLow > prevLowOscCrsi
            crsiHidBullDiv := includeHiddenDiv and divPivotLow > prevLowPriceCrsi and currentCrsiLow < prevLowOscCrsi
    prevLowPriceCrsi := divPivotLow
    prevLowOscCrsi := currentCrsiLow
    prevLowBarCrsi := currentPivotBar
if confirmed and not na(divPivotHigh)
    int currentPivotBar = bar_index - divLookback
    float currentObvHigh = obvOsc[divLookback]
    if not na(prevHighPriceObv) and not na(prevHighBarObv)
        int barDistance = currentPivotBar - prevHighBarObv
        if barDistance > 0 and barDistance <= divMaxBars
            obvRegBearDiv := includeRegularDiv and divPivotHigh > prevHighPriceObv and currentObvHigh < prevHighOscObv
            obvHidBearDiv := includeHiddenDiv and divPivotHigh < prevHighPriceObv and currentObvHigh > prevHighOscObv
    prevHighPriceObv := divPivotHigh
    prevHighOscObv := currentObvHigh
    prevHighBarObv := currentPivotBar
if confirmed and not na(divPivotLow)
    int currentPivotBar = bar_index - divLookback
    float currentObvLow = obvOsc[divLookback]
    if not na(prevLowPriceObv) and not na(prevLowBarObv)
        int barDistance = currentPivotBar - prevLowBarObv
        if barDistance > 0 and barDistance <= divMaxBars
            obvRegBullDiv := includeRegularDiv and divPivotLow < prevLowPriceObv and currentObvLow > prevLowOscObv
            obvHidBullDiv := includeHiddenDiv and divPivotLow > prevLowPriceObv and currentObvLow < prevLowOscObv
    prevLowPriceObv := divPivotLow
    prevLowOscObv := currentObvLow
    prevLowBarObv := currentPivotBar
bool bullDivNow = crsiRegBullDiv or crsiHidBullDiv or obvRegBullDiv or obvHidBullDiv
bool bearDivNow = crsiRegBearDiv or crsiHidBearDiv or obvRegBearDiv or obvHidBearDiv

bool inReferenceSession = not na(time(timeframe.period, referenceSession))
bool referenceSessionStarted = inReferenceSession and not inReferenceSession[1]
bool referenceDayReset = timeframe.change("D") or referenceSessionStarted
var float todayHigh = na
var float todayLow = na
var int todayHighBar = na
var int todayLowBar = na
var float lowBeforeTodayHigh = na
var float highBeforeTodayLow = na
var float todayStructHigh = na
var float todayStructLow = na
var float todayStructHighZoneLow = na
var float todayStructHighZoneHigh = na
var float todayStructLowZoneLow = na
var float todayStructLowZoneHigh = na
var float breakoutHighZoneHigh = na
var float breakoutLowZoneLow = na
var int todayStructHighBar = na
var int todayStructLowBar = na
var float lowBeforeStructHigh = na
var float highBeforeStructLow = na
var int lastProcessedHighCandidateBar = na
var int lastProcessedLowCandidateBar = na
var float prevStructHigh = na
var float prevStructLow = na
var float lowSinceStructHigh = na
var float highSinceStructLow = na
var int lowSinceStructHighBar = na
var int highSinceStructLowBar = na
var bool topExhaustionUsed = false
var bool bottomExhaustionUsed = false
var int lastTopProbeSignalBar = na
var int lastBottomProbeSignalBar = na
var float lastTopProbeSignalPrice = na
var float lastBottomProbeSignalPrice = na
var float lastLongPlanPrice = na
var float lastShortPlanPrice = na
var int lastAnyPlanBar = na
var float lastAnyPlanPrice = na
var float lastAttackUpVolume = na
var float lastAttackDownVolume = na
var int lastWeakNewHighBar = na
var float lastWeakNewHighLow = na
var float lastWeakNewHighHigh = na
var int lastTopVolumeClimaxBar = na
var float lastTopVolumeClimaxHigh = na
var float lastTopVolumeClimaxLow = na
var float lastTopVolumeClimaxBase = na
var float lastTopVolumeClimaxVolumeRatio = na
var int lastTopFailureWatchBar = na
var float lastTopFailureWatchHigh = na
var float lastTopFailureWatchLow = na
var float lastTopFailureWatchBase = na
var float lastTopFailureWatchBodyMid = na
var bool lastTopFailureWatchVolumeProbe = false
var bool topPullbackArmed = false
var int topPullbackArmedBar = na
var int topNoDemandStreak = 0
var int lastTopNoDemandBar = na
var float lastTopNoDemandHigh = na
var float lastTopNoDemandLow = na
var int lastWeakNewLowBar = na
var float lastWeakNewLowHigh = na
var float lastWeakNewLowLow = na
var int lastBottomFailureWatchBar = na
var float lastBottomFailureWatchHigh = na
var float lastBottomFailureWatchLow = na
var float lastBottomFailureWatchBase = na
var float lastBottomFailureWatchBodyMid = na
var bool lastBottomFailureWatchVolumeProbe = false
var bool bottomPullbackArmed = false
var int bottomPullbackArmedBar = na
var int bottomNoSupplyStreak = 0
var int lastBottomNoSupplyBar = na
var float lastBottomNoSupplyHigh = na
var float lastBottomNoSupplyLow = na
var int lastTopSweepBar = na
var float lastTopSweepPrice = na
var bool lastTopSweepVolumeAttack = false
var int lastBottomSweepBar = na
var float lastBottomSweepPrice = na
var bool lastBottomSweepVolumeAttack = false
var int lastVolumeAttackUpBar = na
var int lastVolumeAttackDownBar = na
var int topBreakAcceptStreak = 0
var int bottomBreakAcceptStreak = 0
var int topDecayStreak = 0
var int bottomDecayStreak = 0
var bool upperBreakAcceptedRegime = false
var bool lowerBreakAcceptedRegime = false
var int dailyLongTrades = 0
var int dailyShortTrades = 0
var int dailyTotalTrades = 0
var int dailyLongLosses = 0
var int dailyShortLosses = 0
var float dailyPnlDollars = 0.0
var int topDecisionSeq = 0
var int bottomDecisionSeq = 0
var int activeTopDecisionSeq = 0
var int activeBottomDecisionSeq = 0

bool upperStructureBreakAccepted = false
bool lowerStructureBreakAccepted = false
bool upperStructureBreakExtended = false
bool lowerStructureBreakExtended = false
bool structureHighRaised = false
bool structureLowRaised = false
bool structureHighIndependent = false
bool structureLowIndependent = false
float structureHighOld = na
float structureLowOld = na
bool intradayHighUpdated = false
bool intradayLowUpdated = false

if confirmed and referenceDayReset
    todayHigh := na
    todayLow := na
    todayHighBar := na
    todayLowBar := na
    lowBeforeTodayHigh := na
    highBeforeTodayLow := na
    todayStructHigh := na
    todayStructLow := na
    todayStructHighZoneLow := na
    todayStructHighZoneHigh := na
    todayStructLowZoneLow := na
    todayStructLowZoneHigh := na
    breakoutHighZoneHigh := na
    breakoutLowZoneLow := na
    todayStructHighBar := na
    todayStructLowBar := na
    lowBeforeStructHigh := na
    highBeforeStructLow := na
    lastProcessedHighCandidateBar := na
    lastProcessedLowCandidateBar := na
    prevStructHigh := na
    prevStructLow := na
    lowSinceStructHigh := na
    highSinceStructLow := na
    lowSinceStructHighBar := na
    highSinceStructLowBar := na
    topExhaustionUsed := false
    bottomExhaustionUsed := false
    lastTopProbeSignalBar := na
    lastBottomProbeSignalBar := na
    lastTopProbeSignalPrice := na
    lastBottomProbeSignalPrice := na
    lastLongPlanPrice := na
    lastShortPlanPrice := na
    lastAnyPlanBar := na
    lastAnyPlanPrice := na
    lastAttackUpVolume := na
    lastAttackDownVolume := na
    lastWeakNewHighBar := na
    lastWeakNewHighLow := na
    lastWeakNewHighHigh := na
    lastTopVolumeClimaxBar := na
    lastTopVolumeClimaxHigh := na
    lastTopVolumeClimaxLow := na
    lastTopVolumeClimaxBase := na
    lastTopVolumeClimaxVolumeRatio := na
    lastTopFailureWatchBar := na
    lastTopFailureWatchVolumeProbe := false
    topPullbackArmed := false
    topPullbackArmedBar := na
    topNoDemandStreak := 0
    lastTopNoDemandBar := na
    lastTopNoDemandHigh := na
    lastTopNoDemandLow := na
