    lastVolumeAttackDownBar := na
    topBreakAcceptStreak := 0
    bottomBreakAcceptStreak := 0
    topDecayStreak := 0
    bottomDecayStreak := 0
    upperBreakAcceptedRegime := false
    lowerBreakAcceptedRegime := false
    dailyLongTrades := 0
    dailyShortTrades := 0
    dailyTotalTrades := 0
    dailyLongLosses := 0
    dailyShortLosses := 0
    dailyPnlDollars := 0.0
    topDecisionSeq := 0
    bottomDecisionSeq := 0
    activeTopDecisionSeq := 0
    activeBottomDecisionSeq := 0

if confirmed and volumeAttackUp
    lastVolumeAttackUpBar := bar_index
    lastAttackUpVolume := barVolume
if confirmed and volumeAttackDown
    lastVolumeAttackDownBar := bar_index
    lastAttackDownVolume := barVolume

if confirmed and inReferenceSession
    float prevSessionHigh = todayHigh
    float prevSessionLow = todayLow
    bool newSessionHigh = na(todayHigh) or high > todayHigh
    bool newSessionLow = na(todayLow) or low < todayLow
    if newSessionHigh
        todayHigh := high
        todayHighBar := bar_index
        lowBeforeTodayHigh := na(prevSessionLow) ? low : prevSessionLow
        intradayHighUpdated := not na(prevSessionHigh)
    if newSessionLow
        todayLow := low
        todayLowBar := bar_index
        highBeforeTodayLow := na(prevSessionHigh) ? high : prevSessionHigh
        intradayLowUpdated := not na(prevSessionLow)
    bool sameClusterHighLift = newSessionHigh and not upperBreakAcceptedRegime and not na(todayStructHigh) and confirmed and todayHigh > todayStructHigh + tickBuffer
    if sameClusterHighLift
        float highBand = atr * structureClusterBandAtr
        float oldStructHigh = todayStructHigh
        bool highFarEnough = math.abs(todayHigh - oldStructHigh) >= atr * minStructureSeparationAtr
        bool highMiddleSwingOk = not na(lowSinceStructHigh) and oldStructHigh - lowSinceStructHigh >= atr * minMiddleSwingAtr
        bool highIndependent = highFarEnough and highMiddleSwingOk
        breakoutHighZoneHigh := na(breakoutHighZoneHigh) ? todayStructHighZoneHigh : breakoutHighZoneHigh
        if highIndependent
            prevStructHigh := oldStructHigh
            breakoutHighZoneHigh := todayHigh + highBand
            topBreakAcceptStreak := 0
            upperBreakAcceptedRegime := false
            lastTopSweepBar := na
            lastTopSweepPrice := na
            lastTopSweepVolumeAttack := false
            lastWeakNewHighBar := na
            lastWeakNewHighLow := na
            lastWeakNewHighHigh := na
            lastTopVolumeClimaxBar := na
            lastTopVolumeClimaxHigh := na
            lastTopVolumeClimaxLow := na
            lastTopVolumeClimaxBase := na
            lastTopVolumeClimaxVolumeRatio := na
        todayStructHigh := todayHigh
        todayStructHighBar := todayHighBar
        todayStructHighZoneLow := todayHigh - highBand
        todayStructHighZoneHigh := todayHigh + highBand
        lowBeforeStructHigh := highIndependent or na(lowBeforeStructHigh) ? (na(lowBeforeTodayHigh) ? low : lowBeforeTodayHigh) : lowBeforeStructHigh
        lowSinceStructHigh := low
        lowSinceStructHighBar := bar_index
        topExhaustionUsed := false
        topDecayStreak := 0
        lastTopFailureWatchBar := bar_index
        lastTopFailureWatchHigh := high
        lastTopFailureWatchLow := low
        lastTopFailureWatchBase := todayStructHigh
        lastTopFailureWatchBodyMid := (open + close) * 0.5
        lastTopFailureWatchVolumeProbe := volumeAttackUp or (volumeRatio >= highAttackVolumeMult and close >= open)
        topNoDemandStreak := 0
        lastTopNoDemandBar := na
        lastTopNoDemandHigh := na
        lastTopNoDemandLow := na
        structureHighOld := oldStructHigh
        structureHighRaised := true
        structureHighIndependent := highIndependent
        lastProcessedHighCandidateBar := todayHighBar
    bool sameClusterLowLift = newSessionLow and not lowerBreakAcceptedRegime and not na(todayStructLow) and confirmed and todayLow < todayStructLow - tickBuffer
    if sameClusterLowLift
        float lowBand = atr * structureClusterBandAtr
        float oldStructLow = todayStructLow
        bool lowFarEnough = math.abs(todayLow - oldStructLow) >= atr * minStructureSeparationAtr
        bool lowMiddleSwingOk = not na(highSinceStructLow) and highSinceStructLow - oldStructLow >= atr * minMiddleSwingAtr
        bool lowIndependent = lowFarEnough and lowMiddleSwingOk
        breakoutLowZoneLow := na(breakoutLowZoneLow) ? todayStructLowZoneLow : breakoutLowZoneLow
        if lowIndependent
            prevStructLow := oldStructLow
            breakoutLowZoneLow := todayLow - lowBand
            bottomBreakAcceptStreak := 0
            lowerBreakAcceptedRegime := false
            lastBottomSweepBar := na
            lastBottomSweepPrice := na
            lastBottomSweepVolumeAttack := false
            lastWeakNewLowBar := na
            lastWeakNewLowHigh := na
            lastWeakNewLowLow := na
        todayStructLow := todayLow
        todayStructLowBar := todayLowBar
        todayStructLowZoneLow := todayLow - lowBand
        todayStructLowZoneHigh := todayLow + lowBand
        highBeforeStructLow := lowIndependent or na(highBeforeStructLow) ? (na(highBeforeTodayLow) ? high : highBeforeTodayLow) : highBeforeStructLow
        highSinceStructLow := high
        highSinceStructLowBar := bar_index
        bottomExhaustionUsed := false
        bottomDecayStreak := 0
        lastBottomFailureWatchBar := bar_index
        lastBottomFailureWatchHigh := high
        lastBottomFailureWatchLow := low
        lastBottomFailureWatchBase := todayStructLow
        lastBottomFailureWatchBodyMid := (open + close) * 0.5
        lastBottomFailureWatchVolumeProbe := volumeAttackDown or (volumeRatio >= highAttackVolumeMult and close <= open)
        bottomNoSupplyStreak := 0
        lastBottomNoSupplyBar := na
        lastBottomNoSupplyHigh := na
        lastBottomNoSupplyLow := na
        structureLowOld := oldStructLow
        structureLowRaised := true
        structureLowIndependent := lowIndependent
        lastProcessedLowCandidateBar := todayLowBar
    bool highConfirmed = not na(todayHighBar) and bar_index - todayHighBar >= dayStructConfirmBars and todayHigh - low >= atr * dayStructMinReversalAtr
    if highConfirmed and (na(lastProcessedHighCandidateBar) or todayHighBar != lastProcessedHighCandidateBar)
        float highBand = atr * structureClusterBandAtr
        bool highHasAnchor = not na(todayStructHigh)
        bool highFarEnough = not highHasAnchor or math.abs(todayHigh - todayStructHigh) >= atr * minStructureSeparationAtr
        bool highMiddleSwingOk = not highHasAnchor or not na(lowSinceStructHigh) and todayStructHigh - lowSinceStructHigh >= atr * minMiddleSwingAtr
        bool highMovesAnchor = not highHasAnchor or confirmed and todayHigh > todayStructHigh + tickBuffer
        bool highIndependent = not highHasAnchor or highFarEnough and highMiddleSwingOk
        if highMovesAnchor and highIndependent
            structureHighOld := todayStructHigh
            prevStructHigh := todayStructHigh
            todayStructHigh := todayHigh
            todayStructHighBar := todayHighBar
            todayStructHighZoneLow := todayHigh - highBand
            todayStructHighZoneHigh := todayHigh + highBand
            breakoutHighZoneHigh := todayStructHighZoneHigh
            lowBeforeStructHigh := na(lowBeforeTodayHigh) ? low : lowBeforeTodayHigh
            lowSinceStructHigh := low
            lowSinceStructHighBar := bar_index
            topExhaustionUsed := false
            topBreakAcceptStreak := 0
            topDecayStreak := 0
            upperBreakAcceptedRegime := false
            lastTopSweepBar := na
            lastTopSweepPrice := na
            lastTopSweepVolumeAttack := false
            lastWeakNewHighBar := na
            lastWeakNewHighLow := na
            lastWeakNewHighHigh := na
            lastTopVolumeClimaxBar := na
            lastTopVolumeClimaxHigh := na
            lastTopVolumeClimaxLow := na
            lastTopVolumeClimaxBase := na
            lastTopVolumeClimaxVolumeRatio := na
            lastTopFailureWatchBar := na
            lastTopFailureWatchVolumeProbe := false
            topPullbackArmed := false
            topPullbackArmedBar := na
            topNoDemandStreak := 0
            lastTopNoDemandBar := na
            lastTopNoDemandHigh := na
            lastTopNoDemandLow := na
            structureHighRaised := true
            structureHighIndependent := true
        else if highMovesAnchor
            structureHighOld := todayStructHigh
            breakoutHighZoneHigh := na(breakoutHighZoneHigh) ? todayStructHighZoneHigh : breakoutHighZoneHigh
            todayStructHigh := todayHigh
            todayStructHighBar := todayHighBar
            todayStructHighZoneLow := todayHigh - highBand
            todayStructHighZoneHigh := todayHigh + highBand
            lowBeforeStructHigh := na(lowBeforeStructHigh) ? (na(lowBeforeTodayHigh) ? low : lowBeforeTodayHigh) : lowBeforeStructHigh
            lowSinceStructHigh := low
            lowSinceStructHighBar := bar_index
            topExhaustionUsed := false
            topDecayStreak := 0
            structureHighRaised := true
            structureHighIndependent := false
        lastProcessedHighCandidateBar := todayHighBar
    bool lowConfirmed = not na(todayLowBar) and bar_index - todayLowBar >= dayStructConfirmBars and high - todayLow >= atr * dayStructMinReversalAtr
    if lowConfirmed and (na(lastProcessedLowCandidateBar) or todayLowBar != lastProcessedLowCandidateBar)
        float lowBand = atr * structureClusterBandAtr
        bool lowHasAnchor = not na(todayStructLow)
        bool lowFarEnough = not lowHasAnchor or math.abs(todayLow - todayStructLow) >= atr * minStructureSeparationAtr
        bool lowMiddleSwingOk = not lowHasAnchor or not na(highSinceStructLow) and highSinceStructLow - todayStructLow >= atr * minMiddleSwingAtr
        bool lowMovesAnchor = not lowHasAnchor or confirmed and todayLow < todayStructLow - tickBuffer
        bool lowIndependent = not lowHasAnchor or lowFarEnough and lowMiddleSwingOk
        if lowMovesAnchor and lowIndependent
            structureLowOld := todayStructLow
            prevStructLow := todayStructLow
            todayStructLow := todayLow
            todayStructLowBar := todayLowBar
            todayStructLowZoneLow := todayLow - lowBand
            todayStructLowZoneHigh := todayLow + lowBand
            breakoutLowZoneLow := todayStructLowZoneLow
            highBeforeStructLow := na(highBeforeTodayLow) ? high : highBeforeTodayLow
            highSinceStructLow := high
            highSinceStructLowBar := bar_index
            bottomExhaustionUsed := false
            bottomBreakAcceptStreak := 0
            bottomDecayStreak := 0
            lowerBreakAcceptedRegime := false
            lastBottomSweepBar := na
            lastBottomSweepPrice := na
            lastBottomSweepVolumeAttack := false
            lastWeakNewLowBar := na
            lastWeakNewLowHigh := na
            lastWeakNewLowLow := na
            lastBottomFailureWatchBar := na
            lastBottomFailureWatchVolumeProbe := false
            bottomPullbackArmed := false
            bottomPullbackArmedBar := na
            bottomNoSupplyStreak := 0
            lastBottomNoSupplyBar := na
            lastBottomNoSupplyHigh := na
            lastBottomNoSupplyLow := na
            structureLowRaised := true
            structureLowIndependent := true
        else if lowMovesAnchor
            structureLowOld := todayStructLow
            breakoutLowZoneLow := na(breakoutLowZoneLow) ? todayStructLowZoneLow : breakoutLowZoneLow
            todayStructLow := todayLow
            todayStructLowBar := todayLowBar
            todayStructLowZoneLow := todayLow - lowBand
            todayStructLowZoneHigh := todayLow + lowBand
            highBeforeStructLow := na(highBeforeStructLow) ? (na(highBeforeTodayLow) ? high : highBeforeTodayLow) : highBeforeStructLow
            highSinceStructLow := high
            highSinceStructLowBar := bar_index
            bottomExhaustionUsed := false
            bottomDecayStreak := 0
            structureLowRaised := true
            structureLowIndependent := false
        lastProcessedLowCandidateBar := todayLowBar
    bool upperBreakAccepting = not na(breakoutHighZoneHigh) and not na(todayStructLow) and close > breakoutHighZoneHigh + atr * structureBreakAcceptCloseAtr
    topBreakAcceptStreak := upperBreakAccepting ? topBreakAcceptStreak + 1 : 0
    if topBreakAcceptStreak >= structureBreakAcceptBars and not na(todayHigh)
        float highBand = atr * structureClusterBandAtr
        prevStructHigh := todayStructHigh
        todayStructHigh := todayHigh
        todayStructHighBar := todayHighBar
        todayStructHighZoneLow := todayHigh - highBand
        todayStructHighZoneHigh := todayHigh + highBand
        breakoutHighZoneHigh := todayStructHighZoneHigh
        lowBeforeStructHigh := na(lowSinceStructHigh) ? (na(lowBeforeTodayHigh) ? low : lowBeforeTodayHigh) : lowSinceStructHigh
        lowSinceStructHigh := low
        lowSinceStructHighBar := bar_index
        topExhaustionUsed := false
        topBreakAcceptStreak := 0
        topDecayStreak := 0
        lastProcessedHighCandidateBar := todayHighBar
        lastVolumeAttackUpBar := na
        upperBreakAcceptedRegime := true
        lowerBreakAcceptedRegime := false
        lastTopSweepBar := na
        lastTopSweepPrice := na
        lastTopSweepVolumeAttack := false
        lastWeakNewHighBar := na
        lastWeakNewHighLow := na
        lastWeakNewHighHigh := na
        lastTopVolumeClimaxBar := na
        lastTopVolumeClimaxHigh := na
        lastTopVolumeClimaxLow := na
        lastTopVolumeClimaxBase := na
        lastTopVolumeClimaxVolumeRatio := na
        lastTopFailureWatchBar := na
        lastTopFailureWatchVolumeProbe := false
        topPullbackArmed := false
        topPullbackArmedBar := na
        topNoDemandStreak := 0
        lastTopNoDemandBar := na
        lastTopNoDemandHigh := na
        lastTopNoDemandLow := na
        upperStructureBreakAccepted := true
    bool lowerBreakAccepting = not na(breakoutLowZoneLow) and not na(todayStructHigh) and close < breakoutLowZoneLow - atr * structureBreakAcceptCloseAtr
    bottomBreakAcceptStreak := lowerBreakAccepting ? bottomBreakAcceptStreak + 1 : 0
    if bottomBreakAcceptStreak >= structureBreakAcceptBars and not na(todayLow)
        float lowBand = atr * structureClusterBandAtr
        prevStructLow := todayStructLow
        todayStructLow := todayLow
        todayStructLowBar := todayLowBar
        todayStructLowZoneLow := todayLow - lowBand
        todayStructLowZoneHigh := todayLow + lowBand
        breakoutLowZoneLow := todayStructLowZoneLow
        highBeforeStructLow := na(highSinceStructLow) ? (na(highBeforeTodayLow) ? high : highBeforeTodayLow) : highSinceStructLow
        highSinceStructLow := high
        highSinceStructLowBar := bar_index
        bottomExhaustionUsed := false
        bottomBreakAcceptStreak := 0
        bottomDecayStreak := 0
        lastProcessedLowCandidateBar := todayLowBar
        lastVolumeAttackDownBar := na
        lowerBreakAcceptedRegime := true
        upperBreakAcceptedRegime := false
        lastBottomSweepBar := na
        lastBottomSweepPrice := na
        lastBottomSweepVolumeAttack := false
        lastWeakNewLowBar := na
        lastWeakNewLowHigh := na
        lastWeakNewLowLow := na
        lastBottomFailureWatchBar := na
        lastBottomFailureWatchVolumeProbe := false
        bottomPullbackArmed := false
        bottomPullbackArmedBar := na
        bottomNoSupplyStreak := 0
        lastBottomNoSupplyBar := na
        lastBottomNoSupplyHigh := na
        lastBottomNoSupplyLow := na
        lowerStructureBreakAccepted := true
    bool upperBreakExt = upperBreakAcceptedRegime and not na(todayStructHigh) and not na(todayHigh) and todayHigh > todayStructHigh and todayHighBar != todayStructHighBar
    if upperBreakExt
        float highBand = atr * structureClusterBandAtr
        todayStructHigh := todayHigh
        todayStructHighBar := todayHighBar
        todayStructHighZoneLow := todayHigh - highBand
        todayStructHighZoneHigh := todayHigh + highBand
        breakoutHighZoneHigh := todayStructHighZoneHigh
        lowSinceStructHigh := low
        lowSinceStructHighBar := bar_index
        topExhaustionUsed := false
        topDecayStreak := 0
        lastProcessedHighCandidateBar := todayHighBar
        lastTopSweepBar := na
        lastTopSweepPrice := na
        lastTopSweepVolumeAttack := false
        lastWeakNewHighBar := na
        lastWeakNewHighLow := na
        lastWeakNewHighHigh := na
        lastTopVolumeClimaxBar := na
        lastTopVolumeClimaxHigh := na
        lastTopVolumeClimaxLow := na
        lastTopVolumeClimaxBase := na
        lastTopVolumeClimaxVolumeRatio := na
        upperStructureBreakExtended := true
    bool lowerBreakExt = lowerBreakAcceptedRegime and not na(todayStructLow) and not na(todayLow) and todayLow < todayStructLow and todayLowBar != todayStructLowBar
    if lowerBreakExt
        float lowBand = atr * structureClusterBandAtr
        todayStructLow := todayLow
        todayStructLowBar := todayLowBar
        todayStructLowZoneLow := todayLow - lowBand
        todayStructLowZoneHigh := todayLow + lowBand
        breakoutLowZoneLow := todayStructLowZoneLow
        highSinceStructLow := high
        highSinceStructLowBar := bar_index
        bottomExhaustionUsed := false
        bottomDecayStreak := 0
        lastProcessedLowCandidateBar := todayLowBar
        lastBottomSweepBar := na
        lastBottomSweepPrice := na
        lastBottomSweepVolumeAttack := false
        lastWeakNewLowBar := na
        lastWeakNewLowHigh := na
        lastWeakNewLowLow := na
        lowerStructureBreakExtended := true
    if not na(todayStructHigh) and (na(lowSinceStructHigh) or low < lowSinceStructHigh)
        lowSinceStructHigh := low
        lowSinceStructHighBar := bar_index
    if not na(todayStructLow) and (na(highSinceStructLow) or high > highSinceStructLow)
        highSinceStructLow := high
        highSinceStructLowBar := bar_index

float barsSinceAttackUp = not na(lastVolumeAttackUpBar) ? (bar_index - lastVolumeAttackUpBar) * 1.0 : na
float barsSinceAttackDown = not na(lastVolumeAttackDownBar) ? (bar_index - lastVolumeAttackDownBar) * 1.0 : na
bool attackUpCooling = not na(barsSinceAttackUp) and barsSinceAttackUp <= attackVolumeCooldownBars
bool attackDownCooling = not na(barsSinceAttackDown) and barsSinceAttackDown <= attackVolumeCooldownBars

bool trendHasHH = not na(todayStructHigh) and not na(prevStructHigh) and todayStructHigh > prevStructHigh + atr * trendMinSwingMoveAtr
bool trendHasHL = not na(todayStructLow) and not na(prevStructLow) and todayStructLow > prevStructLow + atr * trendMinSwingMoveAtr
bool trendHasLL = not na(todayStructLow) and not na(prevStructLow) and todayStructLow < prevStructLow - atr * trendMinSwingMoveAtr
bool trendHasLH = not na(todayStructHigh) and not na(prevStructHigh) and todayStructHigh < prevStructHigh - atr * trendMinSwingMoveAtr
bool dayRangeFormed = not na(todayStructHigh) and not na(todayStructLow)
float dayRangeAtr = dayRangeFormed and atr > 0.0 ? math.abs(todayStructHigh - todayStructLow) / atr : na
float dayRangeMid = dayRangeFormed ? (todayStructHigh + todayStructLow) / 2.0 : na
bool dayRangeClear = dayRangeFormed and dayRangeAtr >= minClearDayRangeAtr
bool strongStructTrendLong = dtpBull and emaFast > emaMid and emaMid > emaSlow and close >= sdMid and trendHasHH and trendHasHL
bool strongStructTrendShort = dtpBear and emaFast < emaMid and emaMid < emaSlow and close <= sdMid and trendHasLL and trendHasLH
bool dominantTrendLong = dayRangeClear and dtpBull and close >= sdMid and close >= dayRangeMid and (na(todayStructLowZoneLow) or close > todayStructLowZoneLow)
bool dominantTrendShort = dayRangeClear and dtpBear and close <= sdMid and close <= dayRangeMid and (na(todayStructHighZoneHigh) or close < todayStructHighZoneHigh)
bool trendLongContext = strongStructTrendLong or dominantTrendLong
bool trendShortContext = strongStructTrendShort or dominantTrendShort
bool topCounterTrendAllowed = not dominantTrendLong
bool bottomCounterTrendAllowed = not dominantTrendShort
string trendRegime = dominantTrendLong ? "dominant_bull" : dominantTrendShort ? "dominant_bear" : strongStructTrendLong ? "strong_bull" : strongStructTrendShort ? "strong_bear" : "range"
string dominantTrendSide = dominantTrendLong ? "long" : dominantTrendShort ? "short" : "none"
float tolerance = atr * confluenceZoneAtr

float supportBasis = nearestBelow(close, emaFast, emaMid, emaSlow, dtpAvg, sdMid, sdLower, recentLow, lastPivotLow)
int supportCount = 0
supportCount := addNearCount(supportCount, emaFast, supportBasis, tolerance)
supportCount := addNearCount(supportCount, emaMid, supportBasis, tolerance)
supportCount := addNearCount(supportCount, emaSlow, supportBasis, tolerance)
supportCount := addNearCount(supportCount, dtpAvg, supportBasis, tolerance)
supportCount := addNearCount(supportCount, sdMid, supportBasis, tolerance)
supportCount := addNearCount(supportCount, sdLower, supportBasis, tolerance)
supportCount := addNearCount(supportCount, recentLow, supportBasis, tolerance)
supportCount := addNearCount(supportCount, lastPivotLow, supportBasis, tolerance)
float supportZoneLow = na
supportZoneLow := minNear(supportZoneLow, emaFast, supportBasis, tolerance)
supportZoneLow := minNear(supportZoneLow, emaMid, supportBasis, tolerance)
supportZoneLow := minNear(supportZoneLow, emaSlow, supportBasis, tolerance)
supportZoneLow := minNear(supportZoneLow, dtpAvg, supportBasis, tolerance)
supportZoneLow := minNear(supportZoneLow, sdMid, supportBasis, tolerance)
supportZoneLow := minNear(supportZoneLow, sdLower, supportBasis, tolerance)
supportZoneLow := minNear(supportZoneLow, recentLow, supportBasis, tolerance)
supportZoneLow := minNear(supportZoneLow, lastPivotLow, supportBasis, tolerance)
float supportZoneHigh = na
supportZoneHigh := maxNear(supportZoneHigh, emaFast, supportBasis, tolerance)
supportZoneHigh := maxNear(supportZoneHigh, emaMid, supportBasis, tolerance)
supportZoneHigh := maxNear(supportZoneHigh, emaSlow, supportBasis, tolerance)
supportZoneHigh := maxNear(supportZoneHigh, dtpAvg, supportBasis, tolerance)
supportZoneHigh := maxNear(supportZoneHigh, sdMid, supportBasis, tolerance)
supportZoneHigh := maxNear(supportZoneHigh, sdLower, supportBasis, tolerance)
supportZoneHigh := maxNear(supportZoneHigh, recentLow, supportBasis, tolerance)
supportZoneHigh := maxNear(supportZoneHigh, lastPivotLow, supportBasis, tolerance)
string supportSources = ""
supportSources := appendNearSource(supportSources, emaFast, supportBasis, tolerance, "ema20")
supportSources := appendNearSource(supportSources, emaMid, supportBasis, tolerance, "ema50")
supportSources := appendNearSource(supportSources, emaSlow, supportBasis, tolerance, "ema100")
supportSources := appendNearSource(supportSources, dtpAvg, supportBasis, tolerance, "dtp_avg")
supportSources := appendNearSource(supportSources, sdMid, supportBasis, tolerance, "sd_mid")
supportSources := appendNearSource(supportSources, sdLower, supportBasis, tolerance, "sd_lower")
supportSources := appendNearSource(supportSources, recentLow, supportBasis, tolerance, "recent_low")
supportSources := appendNearSource(supportSources, lastPivotLow, supportBasis, tolerance, "pivot_low")
bool strongSupport = supportCount >= minConfluenceCount and not na(supportZoneLow) and not na(supportZoneHigh)

float resistanceBasis = nearestAbove(close, emaFast, emaMid, emaSlow, dtpAvg, sdMid, sdUpper, recentHigh, lastPivotHigh)
int resistanceCount = 0
resistanceCount := addNearCount(resistanceCount, emaFast, resistanceBasis, tolerance)
resistanceCount := addNearCount(resistanceCount, emaMid, resistanceBasis, tolerance)
resistanceCount := addNearCount(resistanceCount, emaSlow, resistanceBasis, tolerance)
resistanceCount := addNearCount(resistanceCount, dtpAvg, resistanceBasis, tolerance)
resistanceCount := addNearCount(resistanceCount, sdMid, resistanceBasis, tolerance)
resistanceCount := addNearCount(resistanceCount, sdUpper, resistanceBasis, tolerance)
resistanceCount := addNearCount(resistanceCount, recentHigh, resistanceBasis, tolerance)
resistanceCount := addNearCount(resistanceCount, lastPivotHigh, resistanceBasis, tolerance)
float resistanceZoneLow = na
resistanceZoneLow := minNear(resistanceZoneLow, emaFast, resistanceBasis, tolerance)
resistanceZoneLow := minNear(resistanceZoneLow, emaMid, resistanceBasis, tolerance)
resistanceZoneLow := minNear(resistanceZoneLow, emaSlow, resistanceBasis, tolerance)
resistanceZoneLow := minNear(resistanceZoneLow, dtpAvg, resistanceBasis, tolerance)
resistanceZoneLow := minNear(resistanceZoneLow, sdMid, resistanceBasis, tolerance)
resistanceZoneLow := minNear(resistanceZoneLow, sdUpper, resistanceBasis, tolerance)
resistanceZoneLow := minNear(resistanceZoneLow, recentHigh, resistanceBasis, tolerance)
resistanceZoneLow := minNear(resistanceZoneLow, lastPivotHigh, resistanceBasis, tolerance)
float resistanceZoneHigh = na
resistanceZoneHigh := maxNear(resistanceZoneHigh, emaFast, resistanceBasis, tolerance)
resistanceZoneHigh := maxNear(resistanceZoneHigh, emaMid, resistanceBasis, tolerance)
resistanceZoneHigh := maxNear(resistanceZoneHigh, emaSlow, resistanceBasis, tolerance)
resistanceZoneHigh := maxNear(resistanceZoneHigh, dtpAvg, resistanceBasis, tolerance)
resistanceZoneHigh := maxNear(resistanceZoneHigh, sdMid, resistanceBasis, tolerance)
resistanceZoneHigh := maxNear(resistanceZoneHigh, sdUpper, resistanceBasis, tolerance)
resistanceZoneHigh := maxNear(resistanceZoneHigh, recentHigh, resistanceBasis, tolerance)
resistanceZoneHigh := maxNear(resistanceZoneHigh, lastPivotHigh, resistanceBasis, tolerance)
string resistanceSources = ""
resistanceSources := appendNearSource(resistanceSources, emaFast, resistanceBasis, tolerance, "ema20")
resistanceSources := appendNearSource(resistanceSources, emaMid, resistanceBasis, tolerance, "ema50")
resistanceSources := appendNearSource(resistanceSources, emaSlow, resistanceBasis, tolerance, "ema100")
resistanceSources := appendNearSource(resistanceSources, dtpAvg, resistanceBasis, tolerance, "dtp_avg")
resistanceSources := appendNearSource(resistanceSources, sdMid, resistanceBasis, tolerance, "sd_mid")
resistanceSources := appendNearSource(resistanceSources, sdUpper, resistanceBasis, tolerance, "sd_upper")
resistanceSources := appendNearSource(resistanceSources, recentHigh, resistanceBasis, tolerance, "recent_high")
resistanceSources := appendNearSource(resistanceSources, lastPivotHigh, resistanceBasis, tolerance, "pivot_high")
bool strongResistance = resistanceCount >= minConfluenceCount and not na(resistanceZoneLow) and not na(resistanceZoneHigh)

// Trend trades require a formed intraday HH/HL or LL/LH, then use the latest structural HL/LH as the invalidation anchor.
float trendSupportBasis = trendLongContext ? todayStructLow : na
int trendSupportCount = not na(trendSupportBasis) ? 1 : 0
trendSupportCount := addNearCount(trendSupportCount, emaFast, trendSupportBasis, tolerance)
trendSupportCount := addNearCount(trendSupportCount, emaMid, trendSupportBasis, tolerance)
trendSupportCount := addNearCount(trendSupportCount, emaSlow, trendSupportBasis, tolerance)
trendSupportCount := addNearCount(trendSupportCount, dtpAvg, trendSupportBasis, tolerance)
trendSupportCount := addNearCount(trendSupportCount, sdMid, trendSupportBasis, tolerance)
trendSupportCount := addNearCount(trendSupportCount, sdLower, trendSupportBasis, tolerance)
float trendSupportZoneLow = trendSupportBasis
trendSupportZoneLow := minNear(trendSupportZoneLow, emaFast, trendSupportBasis, tolerance)
trendSupportZoneLow := minNear(trendSupportZoneLow, emaMid, trendSupportBasis, tolerance)
trendSupportZoneLow := minNear(trendSupportZoneLow, emaSlow, trendSupportBasis, tolerance)
