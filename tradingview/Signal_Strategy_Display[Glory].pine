            bottomProbeCycleActive := false
            bottomProbeCycleConsumed := false
            bottomProbeCycleTouchBar := na
            bottomPullbackArmed := false
            bottomPullbackArmedBar := na
            bottomNoSupplyStreak := 0
            lastBottomNoSupplyBar := na
            lastBottomNoSupplyHigh := na
            lastBottomNoSupplyLow := na
            structureLowRaised := true
            structureLowIndependent := true
        else if lowMovesAnchor
            structureLowOld := todayStructLow
            breakoutLowZoneLow := na(breakoutLowZoneLow) ? todayStructLowZoneLow : breakoutLowZoneLow
            todayStructLow := todayLow
            todayStructLowBar := todayLowBar
            todayStructLowZoneLow := todayLow - lowBand
            todayStructLowZoneHigh := todayLow + lowBand
            highBeforeStructLow := na(highBeforeStructLow) ? (na(highBeforeTodayLow) ? high : highBeforeTodayLow) : highBeforeStructLow
