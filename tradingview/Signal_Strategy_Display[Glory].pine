        structureHighRaised := true
        structureHighIndependent := highIndependent
        lastProcessedHighCandidateBar := todayHighBar
    bool sameClusterLowLift = newSessionLow and not lowerBreakAcceptedRegime and not na(todayStructLow) and confirmed and todayLow < todayStructLow - tickBuffer
    if sameClusterLowLift
        float lowBand = atr * structureClusterBandAtr
        float oldStructLow = todayStructLow
        bool lowFarEnough = math.abs(todayLow - oldStructLow) >= atr * minStructureSeparationAtr
        bool lowMiddleSwingOk = not na(highSinceStructLow) and highSinceStructLow - oldStructLow >= atr * minMiddleSwingAtr
        bool lowIndependent = lowFarEnough and lowMiddleSwingOk
        breakoutLowZoneLow := na(breakoutLowZoneLow) ? todayStructLowZoneLow : breakoutLowZoneLow
