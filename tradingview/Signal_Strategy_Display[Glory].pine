    bool lowConfirmed = not na(todayLowBar) and bar_index - todayLowBar >= dayStructConfirmBars and high - todayLow >= atr * dayStructMinReversalAtr
    if lowConfirmed and (na(lastProcessedLowCandidateBar) or todayLowBar != lastProcessedLowCandidateBar)
        float lowBand = atr * structureClusterBandAtr
        bool lowHasAnchor = not na(todayStructLow)
        bool lowFarEnough = not lowHasAnchor or math.abs(todayLow - todayStructLow) >= atr * minStructureSeparationAtr
        bool lowMiddleSwingOk = not lowHasAnchor or not na(highSinceStructLow) and highSinceStructLow - todayStructLow >= atr * minMiddleSwingAtr
        bool lowMovesAnchor = not lowHasAnchor or confirmed and todayLow < todayStructLow - tickBuffer
        bool lowIndependent = not lowHasAnchor or lowFarEnough and lowMiddleSwingOk
        if lowMovesAnchor and lowIndependent
