# IBKR Gateway Configuration
# Copy this file to /opt/qc_compute/.env and fill in real values
# NEVER commit the actual .env file to git

IBKR_USERNAME=your_username
IBKR_PASSWORD=your_password
IBKR_ACCOUNT_ID=your_account_id
IBKR_PAPER_ACCOUNT_ID=your_paper_account_id
IBKR_GATEWAY_URL=https://localhost:5001
IBKR_GATEWAY_DIR=/opt/ibkr/clientportal.gw
IBKR_GATEWAY_CONF=root/conf.yaml
IBKR_ENVIRONMENT=live
IBKR_LOGIN_TIMEOUT=120
IBKR_2FA_WAIT=180
IBKR_EOD_KEEP_SYMBOLS=BOXX,IBKR

# PocketBase
PB_BASE_URL=http://localhost:8090

# Service
PORT=5100
